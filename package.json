{
  "name": "cmdb-equipment-api",
  "version": "1.0.0",
  "description": "API REST para gestión de CMDB y Equipment Management",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/utilities/check-env.js && node server.js",
    "dev": "node -e \"console.error('ERROR: npm run dev esta deshabilitado en produccion. Usa: pm2 restart equipment-app'); process.exit(1)\"",
    "check-env": "node scripts/utilities/check-env.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "migrate": "node src/config/migrator.js up",
    "migrate:down": "node src/config/migrator.js down",
    "migrate:status": "node src/config/migrator.js executed",
    "seed": "node src/config/seeder.js up",
    "seed:down": "node src/config/seeder.js down"
  },
  "keywords": [
    "cmdb",
    "equipment",
    "api",
    "rest"
  ],
  "author": "Ricardo Castillo",
  "license": "ISC",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@azure/msal-node": "^5.0.5",
    "@slack/web-api": "^7.15.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "casbin": "^5.49.0",
    "compression": "^1.7.4",
    "connect-flash": "^0.1.1",
    "connect-session-sequelize": "^7.1.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "eventemitter2": "^6.4.9",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.1",
    "form-data": "^4.0.5",
    "groq-sdk": "^1.1.2",
    "helmet": "^7.1.0",
    "json-rules-engine": "^7.3.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "method-override": "^3.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.3",
    "opossum": "^9.0.0",
    "papaparse": "^5.5.3",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "umzug": "^3.8.2",
    "winston": "^3.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.0.0",
    "xlsx": "^0.18.5"
  }
}
