<%
const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
const appUrl = (process.env.APP_URL || 'http://localhost:3000').replace(/\/$/, '');
const ended = kind === 'ended';
const body = `
<div class="header">
  <h1>${ended ? 'Tu prueba terminó' : (days <= 1 ? 'Tu prueba termina mañana' : 'Te quedan ' + esc(days) + ' días de prueba')}</h1>
  <p>${esc(brand)} · ${esc(company)}</p>
</div>
<div class="body">
  <p style="margin:0 0 12px;">Hola ${esc(name)},</p>
  ${ended
    ? `<p style="margin:0 0 12px;">Tu empresa pasó al <b>plan Gratis</b>. No perdiste nada: tus tickets, usuarios y configuración siguen ahí.</p>
       <p style="margin:0 0 12px;">En Gratis tienes la mesa de ayuda completa con algunos límites (técnicos, equipos con control remoto y consultas al asistente inteligente).</p>`
    : `<p style="margin:0 0 12px;">Tu prueba con todas las funciones termina pronto. Después sigues en el <b>plan Gratis</b> sin perder datos.</p>`}
  <p style="margin:0;">Si quieres seguir con todo, o prefieres que <b>nuestro equipo se encargue del soporte</b> de tu empresa, mira los planes:</p>
  <div class="cta"><a href="${appUrl}/planes">Ver planes</a></div>
</div>`;
%>
<%- include('_base', { body }) %>
