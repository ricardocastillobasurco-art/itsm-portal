function _handleForbidden(d, el) {
  if (d.forbidden || (d.success === false && !d.msReauth)) {
    if (el) el.innerHTML = `<div style="padding:32px;text-align:center;">
      <i class="bi bi-lock-fill" style="font-size:32px;color:#d97706;display:block;margin-bottom:12px;"></i>
      <div style="font-size:13px;font-weight:700;margin-bottom:6px;">Sin permisos para esta sección</div>
      <div style="font-size:12px;color:var(--text-muted);">${d.error||'Permiso insuficiente en Azure AD.'}</div>
      <button onclick="showNoAccess('${(d.error||'').replace(/'/g,'')}')" style="margin-top:14px;padding:7px 18px;background:rgba(220,38,38,.08);color:#dc2626;border:1px solid rgba(220,38,38,.2);border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;">Ver detalle</button>
    </div>`;
    return true;
  }
  return false;
}

