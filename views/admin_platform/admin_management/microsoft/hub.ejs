window.loadBitlockerKey = async function(deviceId, deviceName) {
  showDetailModal(`🔑 BitLocker: ${deviceName}`, '<div class="ms-loading"><div class="spinner-border spinner-border-sm text-primary"></div> Consultando Azure AD…</div>');
