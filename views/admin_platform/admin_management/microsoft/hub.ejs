      <td style="font-size:11.5px;color:var(--text-muted);white-space:nowrap;">${_fmtDate(k.createdDateTime)}</td>
    </tr>`).join('');
    body.innerHTML = `<div style="margin-bottom:12px;font-size:12px;color:var(--text-muted);">${d.data.length} clave(s) registrada(s) · Haz clic en "Copiar" para copiar el ID de recuperación</div>
      <table class="ms-tbl"><thead><tr><th>ID de clave BitLocker</th><th>Registrada</th></tr></thead><tbody>${rows}</tbody></table>`;
  } catch(e) { document.getElementById('detailModalBody').innerHTML = `<div class="ms-loading" style="color:#ef4444;">${e.message}</div>`; }
};

