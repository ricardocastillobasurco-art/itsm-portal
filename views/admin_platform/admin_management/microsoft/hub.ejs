async function loadReports() {
  const el = document.getElementById('reportsContent');
  el.innerHTML = '<div class="ms-loading"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando uso de aplicaciones…</div>';
  try {
    const r = await fetch('/api/ms/reports/trends', { credentials:'include' });
    const d = await r.json();
    if (d.msReauth && _handleMsReauth(d)) return;
    if (_handleForbidden(d, el)) return;
    const services = d.services || [];
    if (!services.length) {
      el.innerHTML = `<div style="padding:48px;text-align:center;color:var(--text-muted);">
        <i class="bi bi-graph-up-arrow" style="font-size:40px;color:#0078d4;display:block;margin-bottom:12px;"></i>
        <div style="font-weight:700;margin-bottom:8px;">Sin datos de uso disponibles</div>
        <div style="font-size:12px;">Verifica el permiso <code>Reports.Read.All</code> en Azure AD.</div>
        <div style="margin-top:16px;"><button onclick="_panelLoaders.trends()" style="padding:8px 18px;background:rgba(0,120,212,.08);color:#0078d4;border:1px solid rgba(0,120,212,.2);border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;">Ver tendencias de 30 días</button></div>
      </div>`;
      return;
    }
    const cols = Object.keys(services[0]).filter(k => !k.toLowerCase().includes('date'));
    const last  = services[services.length-1] || {};
    const colors = ['#0078d4','#6264a7','#059669','#d97706','#dc2626','#7c3aed'];
    const cards = cols.slice(0,8).map((col,i) => {
      const val = parseInt(last[col])||0;
      const prev = parseInt(services[services.length-8]?.[col])||0;
      const trend = val > prev ? '↑' : val < prev ? '↓' : '→';
      const trendColor = val > prev ? '#059669' : val < prev ? '#dc2626' : '#64748b';
      return `<div class="ms-kpi"><div class="ms-kpi-icon" style="background:${colors[i%colors.length]}22;color:${colors[i%colors.length]};"><i class="bi bi-graph-up"></i></div>
        <div class="ms-kpi-val" style="color:${colors[i%colors.length]};">${val.toLocaleString()} <span style="font-size:14px;color:${trendColor};">${trend}</span></div>
        <div class="ms-kpi-label">${col.replace(/([A-Z])/g,' $1').trim()}</div>
        <div class="ms-kpi-sub">usuarios activos últimos 30d</div></div>`;
    }).join('');
    el.innerHTML = `<div style="margin-bottom:16px;font-size:12px;color:var(--text-muted);">Actividad por servicio · Período de 30 días</div>
      <div class="ms-kpi-grid" style="grid-template-columns:repeat(auto-fill,minmax(190px,1fr));margin-bottom:20px;">${cards}</div>
      <div style="text-align:center;"><button onclick="msNav('trends',document.querySelector('[onclick*=\\'trends\\']'))" style="padding:8px 18px;background:rgba(124,58,237,.08);color:#7c3aed;border:1px solid rgba(124,58,237,.2);border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;"><i class="bi bi-bar-chart-fill"></i> Ver gráficos de tendencia 30d</button></div>`;
  } catch(e) { el.innerHTML = `<div class="ms-loading" style="color:#ef4444;"><i class="bi bi-exclamation-triangle"></i> ${e.message}</div>`; }
}

