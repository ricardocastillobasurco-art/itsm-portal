<!DOCTYPE html>
<html lang="es">
<head>
<script>(function(){document.documentElement.setAttribute('data-theme',localStorage.getItem('dashboardTheme')||'light');})();</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Microsoft 365 · Panel de Administración</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<%- include('../../../shared/partials/autogestion/styles') %>
<style>
/* ── Layout ── */
.ms-shell{display:flex;min-height:calc(100vh - 120px);gap:0;background:var(--bg-main);}
.ms-sidebar{width:220px;flex-shrink:0;background:var(--bg-card);border-right:1px solid var(--border-soft);display:flex;flex-direction:column;padding:16px 0;}
.ms-sidebar-section{padding:0 12px;margin-bottom:4px;}
.ms-sidebar-label{font-size:9.5px;font-weight:800;letter-spacing:1px;color:var(--text-muted);text-transform:uppercase;padding:10px 8px 4px;}
.ms-nav-item{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:8px;font-size:12.5px;font-weight:600;color:var(--text-muted);cursor:pointer;transition:all .15s;border:none;background:none;width:100%;text-align:left;}
.ms-nav-item:hover{background:rgba(0,120,212,.06);color:#0078d4;}
.ms-nav-item.active{background:rgba(0,120,212,.1);color:#0078d4;font-weight:700;}
.ms-nav-item i{font-size:15px;width:18px;flex-shrink:0;}
.ms-content{flex:1;overflow:auto;padding:24px;}
.ms-panel{display:none;}
.ms-panel.active{display:block;}

/* ── KPI cards ── */
.ms-kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px;margin-bottom:24px;}
.ms-kpi{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:14px;padding:18px 20px;display:flex;flex-direction:column;gap:6px;}
.ms-kpi-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:4px;}
.ms-kpi-val{font-size:28px;font-weight:800;color:var(--text-main);line-height:1;}
.ms-kpi-label{font-size:11.5px;color:var(--text-muted);font-weight:600;}
.ms-kpi-sub{font-size:10.5px;color:var(--text-muted);}

/* ── Tabla ── */
.ms-table-wrap{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:14px;overflow:hidden;}
.ms-table-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--border-soft);}
.ms-table-title{font-size:13.5px;font-weight:700;color:var(--text-main);}
.ms-search{padding:7px 12px;border:1.5px solid var(--border-soft);border-radius:8px;font-size:12px;background:var(--bg-main);color:var(--text-main);outline:none;width:220px;}
.ms-search:focus{border-color:#0078d4;}
table.ms-tbl{width:100%;border-collapse:collapse;}
table.ms-tbl th{padding:9px 14px;font-size:10.5px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid var(--border-soft);text-align:left;white-space:nowrap;}
table.ms-tbl td{padding:10px 14px;font-size:12.5px;border-bottom:1px solid var(--border-soft);color:var(--text-main);vertical-align:middle;}
table.ms-tbl tr:last-child td{border-bottom:none;}
table.ms-tbl tr:hover td{background:var(--hover-row,rgba(0,120,212,.03));}

/* ── Badges ── */
.badge-on{background:rgba(16,185,129,.1);color:#059669;border-radius:20px;padding:2px 9px;font-size:10px;font-weight:700;}
.badge-off{background:rgba(239,68,68,.1);color:#dc2626;border-radius:20px;padding:2px 9px;font-size:10px;font-weight:700;}
.badge-warn{background:rgba(245,158,11,.1);color:#d97706;border-radius:20px;padding:2px 9px;font-size:10px;font-weight:700;}
.badge-neutral{background:var(--bg-main);color:var(--text-muted);border-radius:20px;padding:2px 9px;font-size:10px;font-weight:700;border:1px solid var(--border-soft);}

/* ── Licencias progress ── */
.lic-bar-wrap{width:120px;height:6px;background:var(--bg-main);border-radius:3px;overflow:hidden;}
.lic-bar{height:100%;border-radius:3px;background:linear-gradient(90deg,#0078d4,#50e6ff);}

/* ── Connect banner ── */
.ms-connect-banner{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:64px 24px;gap:16px;text-align:center;}
.ms-connect-icon{width:72px;height:72px;background:linear-gradient(135deg,#0078d4,#50e6ff);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:36px;color:#fff;margin-bottom:8px;}
.ms-connect-title{font-size:20px;font-weight:800;color:var(--text-main);}
.ms-connect-sub{font-size:13px;color:var(--text-muted);max-width:400px;line-height:1.6;}
.ms-connect-btn{display:inline-flex;align-items:center;gap:8px;padding:11px 22px;background:linear-gradient(135deg,#0078d4,#106ebe);color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;text-decoration:none;box-shadow:0 4px 16px rgba(0,120,212,.35);}
.ms-connect-btn:hover{filter:brightness(1.1);}

/* ── Pager ── */
.ms-pager{display:flex;justify-content:center;gap:6px;padding:14px;}

/* ── Spinner ── */
.ms-loading{display:flex;align-items:center;justify-content:center;padding:48px;gap:10px;color:var(--text-muted);font-size:13px;}

/* ── Back btn ── */
.back-btn{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:var(--text-muted);background:var(--bg-card);border:1px solid var(--border-soft);border-radius:20px;padding:6px 14px;text-decoration:none;transition:color .2s;}
.back-btn:hover{color:#0078d4;}

@media(max-width:700px){
  .ms-sidebar{display:none;}
  .ms-kpi-grid{grid-template-columns:repeat(2,1fr);}
  .ms-search{width:140px;}
}
.ms-sidebar{overflow-y:auto;}
table.ms-tbl tr:hover td{background:rgba(0,120,212,.03);}

/* ── KPI clicable ── */
.ms-kpi.clickable{cursor:pointer;transition:transform .15s,box-shadow .15s;}
.ms-kpi.clickable:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,120,212,.12);}

/* ── Export button ── */
.ms-export-btn{display:inline-flex;align-items:center;gap:5px;padding:6px 12px;background:rgba(5,150,105,.08);color:#059669;border:1px solid rgba(5,150,105,.2);border-radius:8px;font-size:11.5px;font-weight:700;cursor:pointer;white-space:nowrap;}
.ms-export-btn:hover{background:rgba(5,150,105,.15);}

/* ── Refresh timestamp ── */
.ms-last-refresh{font-size:10.5px;color:var(--text-muted);padding:0 4px;}

/* ── Alert cards ── */
.ms-alert{display:flex;align-items:flex-start;gap:12px;padding:14px 18px;border-radius:12px;margin-bottom:8px;border:1px solid;}
.ms-alert.critical{background:rgba(220,38,38,.05);border-color:rgba(220,38,38,.2);}
.ms-alert.warning{background:rgba(245,158,11,.05);border-color:rgba(245,158,11,.2);}
.ms-alert-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;}
.ms-alert.critical .ms-alert-icon{background:rgba(220,38,38,.1);color:#dc2626;}
.ms-alert.warning  .ms-alert-icon{background:rgba(245,158,11,.1);color:#d97706;}
.ms-alert-title{font-size:12.5px;font-weight:700;color:var(--text-main);}
.ms-alert-detail{font-size:11px;color:var(--text-muted);margin-top:2px;}
.ms-alert-date{font-size:10.5px;color:var(--text-muted);white-space:nowrap;margin-left:auto;flex-shrink:0;}
.ms-alert-nav{font-size:11px;color:#0078d4;background:none;border:none;cursor:pointer;font-weight:700;padding:0;margin-top:4px;}

/* ── Compliance donut-style bars ── */
.ms-comp-bar{height:8px;border-radius:4px;background:var(--bg-main);overflow:hidden;margin-top:6px;}
.ms-comp-fill{height:100%;border-radius:4px;transition:width .5s;}

/* ── User detail modal sections ── */
.ud-section{margin-bottom:18px;}
.ud-section-title{font-size:10.5px;font-weight:800;letter-spacing:.8px;text-transform:uppercase;color:var(--text-muted);margin-bottom:8px;}
.ud-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.ud-item label{font-size:10px;color:var(--text-muted);display:block;margin-bottom:1px;}
.ud-item span{font-size:12.5px;font-weight:600;color:var(--text-main);}

/* ── Policy cards ── */
.ms-policy-card{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:12px;padding:14px 18px;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between;gap:12px;}
.ms-policy-name{font-size:13px;font-weight:700;color:var(--text-main);}
.ms-policy-desc{font-size:11px;color:var(--text-muted);margin-top:3px;}
.ms-tab-bar{display:flex;gap:4px;margin-bottom:16px;}
.ms-tab{padding:7px 16px;border-radius:8px;font-size:12px;font-weight:700;border:1.5px solid var(--border-soft);background:var(--bg-card);color:var(--text-muted);cursor:pointer;}
.ms-tab.active{background:#0078d4;color:#fff;border-color:#0078d4;}

/* ── Copy button ── */
.copy-btn{background:rgba(0,120,212,.08);color:#0078d4;border:none;border-radius:6px;padding:3px 8px;font-size:11px;cursor:pointer;font-weight:700;}
.copy-btn:active{background:rgba(0,120,212,.2);}

/* ── Trend bars ── */
.trend-bar-wrap{display:flex;align-items:flex-end;gap:3px;height:60px;}
.trend-bar{flex:1;background:linear-gradient(0deg,#0078d4,#50e6ff);border-radius:3px 3px 0 0;min-width:4px;transition:height .3s;}
.trend-bar:hover{filter:brightness(1.15);}
.trend-label{font-size:9px;color:var(--text-muted);text-align:center;margin-top:2px;}

/* ── Row clickable ── */
table.ms-tbl tr.clickable-row:hover td{background:rgba(0,120,212,.06);cursor:pointer;}

/* ── Filter select ── */
.ms-filter-select{padding:7px 10px;border:1.5px solid var(--border-soft);border-radius:8px;font-size:12px;background:var(--bg-main);color:var(--text-main);outline:none;cursor:pointer;}
.ms-filter-select:focus{border-color:#0078d4;}

/* ── Sidebar alerts badge ── */
.sb-badge{background:#ef4444;color:#fff;font-size:9px;font-weight:800;border-radius:10px;padding:1px 6px;margin-left:auto;}

</style>
</head>
<body>

<div class="theme-toggle" onclick="toggleTheme()">
  <i id="toggleIcon" class="bi bi-moon-stars-fill toggle-icon"></i>
  <div class="toggle-track"><div class="toggle-knob"></div></div>
  <span id="toggleLabel" class="toggle-label">Oscuro</span>
</div>

<div class="home-wrapper" style="padding-bottom:0;">

  <!-- HERO -->
  <div class="hero" style="margin-bottom:0;border-radius:16px 16px 0 0;">
    <div class="hero-logo">
      <div class="hero-logo-icon" style="background:linear-gradient(135deg,#0078d4,#50e6ff);">
        <svg width="22" height="22" viewBox="0 0 23 23" fill="none"><path fill="#f25022" d="M1 1h10v10H1z"/><path fill="#7fba00" d="M12 1h10v10H12z"/><path fill="#00a4ef" d="M1 12h10v10H1z"/><path fill="#ffb900" d="M12 12h10v10H12z"/></svg>
      </div>
      <div class="hero-logo-text">MICROSOFT <span>365 + INTUNE</span></div>
    </div>
    <div class="hero-title">Usuarios · Dispositivos · Licencias · Seguridad · SharePoint · Teams</div>
    <div class="hero-chip" style="background:rgba(0,120,212,.08);color:#0078d4;border-color:rgba(0,120,212,.2);">
      <i class="bi bi-circle-fill" style="font-size:8px;color:#10b981;" id="msStatusDot"></i>
      <span id="msStatusText">Verificando conexión…</span>
    </div>
    <div style="margin-top:12px;display:flex;align-items:center;gap:10px;justify-content:center;">
      <a href="/administracion" class="back-btn"><i class="bi bi-arrow-left"></i> Administración</a>
      <button onclick="msRefreshCurrent()" style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;background:rgba(0,120,212,.08);color:#0078d4;border:1px solid rgba(0,120,212,.2);border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;">
        <i class="bi bi-arrow-clockwise" id="msRefreshIcon"></i> Actualizar
      </button>
      <span class="ms-last-refresh" id="msLastRefresh"></span>
    </div>
  </div>

  <!-- SHELL: sidebar + contenido -->
  <div class="ms-shell">

    <!-- SIDEBAR -->
    <nav class="ms-sidebar">
      <div class="ms-sidebar-section">
        <div class="ms-sidebar-label">General</div>
        <button class="ms-nav-item active" onclick="msNav('dashboard',this)"><i class="bi bi-speedometer2"></i> Dashboard</button>
        <button class="ms-nav-item" onclick="msNav('alerts',this)" id="sbAlerts"><i class="bi bi-bell-fill" style="color:#ef4444;"></i> Alertas <span class="sb-badge" id="alertsBadge" style="display:none;">0</span></button>
      </div>
      <div class="ms-sidebar-section">
        <div class="ms-sidebar-label">Identidad</div>
        <button class="ms-nav-item" onclick="msNav('users',this)"><i class="bi bi-people-fill"></i> Usuarios</button>
        <button class="ms-nav-item" onclick="msNav('groups',this)"><i class="bi bi-diagram-3-fill"></i> Grupos</button>
        <button class="ms-nav-item" onclick="msNav('security',this)"><i class="bi bi-shield-lock-fill"></i> Seguridad MFA</button>
      </div>
      <div class="ms-sidebar-section">
        <div class="ms-sidebar-label">Licencias</div>
        <button class="ms-nav-item" onclick="msNav('licenses',this)"><i class="bi bi-key-fill"></i> Licencias M365</button>
      </div>
      <div class="ms-sidebar-section">
        <div class="ms-sidebar-label">Intune</div>
        <button class="ms-nav-item" onclick="msNav('devices',this)"><i class="bi bi-laptop-fill"></i> Dispositivos</button>
        <button class="ms-nav-item" onclick="msNav('compliance',this)"><i class="bi bi-check-circle-fill" style="color:#059669;"></i> Cumplimiento</button>
      </div>
      <div class="ms-sidebar-section">
        <div class="ms-sidebar-label">Auditoría</div>
        <button class="ms-nav-item" onclick="msNav('signins',this)"><i class="bi bi-box-arrow-in-right"></i> Inicios de sesión</button>
        <button class="ms-nav-item" onclick="msNav('auditlog',this)"><i class="bi bi-journal-text"></i> Directorio</button>
      </div>
      <div class="ms-sidebar-section">
        <div class="ms-sidebar-label">Seguridad avanzada</div>
        <button class="ms-nav-item" onclick="msNav('condaccess',this)"><i class="bi bi-shield-fill-exclamation"></i> Acceso condicional</button>
        <button class="ms-nav-item" onclick="msNav('riskyusers',this)"><i class="bi bi-person-fill-exclamation"></i> Usuarios en riesgo</button>
      </div>
      <div class="ms-sidebar-section">
        <div class="ms-sidebar-label">Intune avanzado</div>
        <button class="ms-nav-item" onclick="msNav('autopilot',this)"><i class="bi bi-rocket-takeoff-fill"></i> Autopilot</button>
        <button class="ms-nav-item" onclick="msNav('policies',this)"><i class="bi bi-file-earmark-lock-fill" style="color:#7c3aed;"></i> Políticas</button>
        <button class="ms-nav-item" onclick="msNav('managedapps',this)"><i class="bi bi-box-seam-fill" style="color:#059669;"></i> Apps gestionadas</button>
        <button class="ms-nav-item" onclick="msNav('deviceapps',this)"><i class="bi bi-grid-3x3-gap-fill"></i> Apps por dispositivo</button>
        <button class="ms-nav-item" onclick="msNav('bitlocker',this)"><i class="bi bi-lock-fill"></i> BitLocker</button>
        <button class="ms-nav-item" onclick="msNav('winupdate',this)"><i class="bi bi-arrow-repeat" style="color:#0078d4;"></i> Windows Update</button>
      </div>
      <div class="ms-sidebar-section">
        <div class="ms-sidebar-label">Colaboración</div>
        <button class="ms-nav-item" onclick="msNav('teams',this)"><i class="bi bi-microsoft-teams"></i> Teams</button>
        <button class="ms-nav-item" onclick="msNav('mailboxes',this)"><i class="bi bi-envelope-fill"></i> Buzones Exchange</button>
      </div>
      <div class="ms-sidebar-section">
        <div class="ms-sidebar-label">Reportes M365</div>
        <button class="ms-nav-item" onclick="msNav('reports',this)"><i class="bi bi-graph-up-arrow"></i> Uso de aplicaciones</button>
        <button class="ms-nav-item" onclick="msNav('trends',this)"><i class="bi bi-bar-chart-fill" style="color:#7c3aed;"></i> Tendencias 30d</button>
      </div>
    </nav>

    <!-- CONTENIDO -->
    <main class="ms-content">

      <!-- ── BANNER sin token ── -->
      <div id="msPanelConnect" class="ms-panel" style="display:none;">
        <div class="ms-connect-banner">
          <div class="ms-connect-icon"><i class="bi bi-microsoft"></i></div>
          <div class="ms-connect-title">Sesión Microsoft no vinculada</div>
          <div class="ms-connect-sub">
            Tu sesión no tiene credenciales Microsoft guardadas.<br><br>
            <strong>Cierra sesión</strong> en la plataforma y vuelve a entrar usando<br>
            <strong>"Continuar con Microsoft"</strong> — el panel cargará automáticamente.
          </div>
          <a href="/logout" class="ms-connect-btn" style="background:linear-gradient(135deg,#374151,#1f2937);">
            <i class="bi bi-box-arrow-right"></i> Cerrar sesión para re-autenticar
          </a>
        </div>
      </div>

      <!-- ── DASHBOARD ── -->
      <div id="msPanelDashboard" class="ms-panel active">
        <div id="dashContent">
          <div class="ms-loading"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando datos…</div>
        </div>
      </div>

      <!-- ── USUARIOS ── -->
      <div id="msPanelUsers" class="ms-panel">
        <div class="ms-table-wrap">
          <div class="ms-table-head">
            <span class="ms-table-title"><i class="bi bi-people-fill" style="color:#0078d4;"></i> Usuarios de Entra ID</span>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
              <select id="usersStatusFilter" class="ms-filter-select" onchange="msUsersDebounce()">
                <option value="">Todos</option>
                <option value="active">Solo activos</option>
                <option value="disabled">Solo deshabilitados</option>
              </select>
              <input type="text" class="ms-search" id="usersSearch" placeholder="Buscar usuario…" oninput="msUsersDebounce()">
              <span id="usersTotalLabel" style="font-size:11px;color:var(--text-muted);white-space:nowrap;"></span>
              <button class="ms-export-btn" onclick="_exportUsersCSV()"><i class="bi bi-download"></i> CSV</button>
            </div>
          </div>
          <div id="usersTableWrap"><div class="ms-loading"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando…</div></div>
          <div id="usersPager" class="ms-pager"></div>
        </div>
      </div>

      <!-- ── GRUPOS ── -->
      <div id="msPanelGroups" class="ms-panel">
        <div class="ms-table-wrap">
          <div class="ms-table-head">
            <span class="ms-table-title"><i class="bi bi-diagram-3-fill" style="color:#0078d4;"></i> Grupos de Entra ID</span>
            <input type="text" class="ms-search" id="groupsSearch" placeholder="Buscar grupo…" oninput="msGroupsDebounce()">
          </div>
          <div id="groupsTableWrap"><div class="ms-loading"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando…</div></div>
        </div>
      </div>

      <!-- ── SEGURIDAD MFA ── -->
      <div id="msPanelSecurity" class="ms-panel">
        <div id="mfaContent"><div class="ms-loading"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando…</div></div>
      </div>

      <!-- ── LICENCIAS ── -->
      <div id="msPanelLicenses" class="ms-panel">
        <div id="licContent"><div class="ms-loading"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando…</div></div>
      </div>

      <!-- ── DISPOSITIVOS ── -->
      <div id="msPanelDevices" class="ms-panel">
        <div class="ms-table-wrap">
          <div class="ms-table-head">
            <span class="ms-table-title"><i class="bi bi-laptop-fill" style="color:#0078d4;"></i> Dispositivos Intune</span>
            <div style="display:flex;gap:8px;align-items:center;">
              <input type="text" class="ms-search" id="devicesSearch" placeholder="Buscar equipo…" oninput="msDevicesDebounce()">
              <button class="ms-export-btn" onclick="_exportDevicesCSV()"><i class="bi bi-download"></i> CSV</button>
            </div>
          </div>
          <div id="devicesTableWrap"><div class="ms-loading"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando…</div></div>
          <div id="devicesPager" class="ms-pager"></div>
        </div>
      </div>

      <!-- ── INICIOS DE SESIÓN ── -->
      <div id="msPanelSignins" class="ms-panel">
        <div class="ms-table-wrap">
          <div class="ms-table-head">
            <span class="ms-table-title"><i class="bi bi-box-arrow-in-right" style="color:#0078d4;"></i> Registros de inicio de sesión</span>
            <button onclick="loadSignins()" style="font-size:11.5px;color:#0078d4;background:none;border:none;cursor:pointer;font-weight:700;"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
          </div>
          <div id="signinsTableWrap"><div class="ms-loading"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando…</div></div>
        </div>
      </div>

      <!-- ── AUDITORÍA DIRECTORIO ── -->
      <div id="msPanelAuditlog" class="ms-panel">
        <div class="ms-table-wrap">
          <div class="ms-table-head">
            <span class="ms-table-title"><i class="bi bi-journal-text" style="color:#7c3aed;"></i> Auditoría de directorio</span>
            <button onclick="loadAuditLog()" style="font-size:11.5px;color:#7c3aed;background:none;border:none;cursor:pointer;font-weight:700;"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
          </div>
          <div id="auditlogTableWrap"><div class="ms-loading"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando…</div></div>
