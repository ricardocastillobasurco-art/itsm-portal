window.loadAppsForDevice = async function(deviceId, deviceName) {
  showDetailModal(`Apps instaladas: ${deviceName}`, '<div class="ms-loading"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando…</div>');
  try {
    const r = await fetch(`/api/ms/devices/${deviceId}/apps`, { credentials:'include' });
    const d = await r.json();
    if (d.forbidden) { document.getElementById('detailModalBody').innerHTML = `<div style="text-align:center;padding:32px;"><i class="bi bi-lock-fill" style="font-size:32px;color:#d97706;display:block;margin-bottom:12px;"></i><div style="font-size:13px;font-weight:700;margin-bottom:6px;">Sin permisos para BitLocker</div><div style="font-size:12px;color:var(--text-muted);">${d.error}</div></div>`; return; }
    const apps = (d.data||[]).sort((a,b) => (a.displayName||'').localeCompare(b.displayName||''));
    const hint = (d.hint||d._hint) ? `<div style="margin:0 0 12px;padding:12px 14px;background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.25);border-radius:10px;font-size:11px;color:#92400e;line-height:1.6;"><i class="bi bi-exclamation-triangle" style="color:#d97706;"></i> ${d.hint||d._hint}</div>` : '';

    const buildRows = (list) => list.map(app => `<tr>
      <td style="font-weight:700;font-size:12px;">${app.displayName||app.name||'—'}</td>
      <td style="font-size:11.5px;color:var(--text-muted);">${app.publisher||'—'}</td>
      <td style="font-size:11.5px;">${app.version||app.installedVersion||'—'}</td>
      <td style="font-size:11px;color:var(--text-muted);">${app.sizeInByte ? (app.sizeInByte/1048576).toFixed(1)+' MB' : '—'}</td>
    </tr>`).join('');

    document.getElementById('detailModalBody').innerHTML = `
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;gap:10px;">
        <span style="font-size:12px;color:var(--text-muted);flex-shrink:0;"><span id="appsCount">${apps.length}</span> aplicaciones detectadas</span>
        ${apps.length > 0 ? `<input id="appsFilter" type="text" placeholder="Buscar aplicación…" oninput="_filterApps(this.value)" style="flex:1;padding:6px 12px;border:1.5px solid var(--border-soft);border-radius:8px;font-size:12px;background:var(--bg-main);color:var(--text-main);outline:none;min-width:0;" autofocus>` : ''}
        ${apps.length === 0 ? `<a href="https://intune.microsoft.com/#view/Microsoft_Intune_Devices/DevicesMenu/~/mobileDevices" target="_blank" style="font-size:11px;color:#0078d4;font-weight:700;text-decoration:none;flex-shrink:0;"><i class="bi bi-box-arrow-up-right"></i> Abrir Intune</a>` : ''}
      </div>
      ${hint}
      <table class="ms-tbl" id="appsTable">
        <thead><tr><th>Nombre</th><th>Editor</th><th>Versión</th><th>Tamaño</th></tr></thead>
        <tbody id="appsBody">${buildRows(apps)||'<tr><td colspan="4" style="text-align:center;padding:28px;"><i class="bi bi-app" style="font-size:24px;display:block;margin-bottom:8px;color:var(--text-muted);"></i><div style="font-size:12.5px;font-weight:700;margin-bottom:4px;">Sin aplicaciones detectadas</div><div style="font-size:11px;color:var(--text-muted);">Intune necesita al menos un ciclo de sincronización.</div></td></tr>'}</tbody>
      </table>`;

    // Guardar lista completa para el filtro
    window._appsAll = apps;
    window._filterApps = function(q) {
      const term = q.toLowerCase().trim();
      const filtered = term ? window._appsAll.filter(a => (a.displayName||a.name||'').toLowerCase().includes(term) || (a.publisher||'').toLowerCase().includes(term)) : window._appsAll;
      document.getElementById('appsCount').textContent = filtered.length;
      document.getElementById('appsBody').innerHTML = buildRows(filtered) || `<tr><td colspan="4" style="text-align:center;padding:20px;color:var(--text-muted);">Sin resultados para "${q}"</td></tr>`;
    };
  } catch(e) { document.getElementById('detailModalBody').innerHTML = `<div class="ms-loading" style="color:#ef4444;">${e.message}</div>`; }
};

