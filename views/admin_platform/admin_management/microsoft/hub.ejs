      body.innerHTML = `<div style="text-align:center;padding:32px;"><i class="bi bi-lock-fill" style="font-size:32px;color:#d97706;display:block;margin-bottom:12px;"></i><div style="font-size:13px;font-weight:700;margin-bottom:6px;">Sin permisos para BitLocker</div><div style="font-size:12px;color:var(--text-muted);">${d.error}</div><div style="margin-top:12px;font-size:11px;color:var(--text-muted);">Necesitas el permiso <code>BitLockerKey.ReadBasic.All</code> o <code>BitLockerKey.Read.All</code> en Azure AD.</div></div>`;
      return;
    }
    if (!d.data?.length) {
      body.innerHTML = `<div style="text-align:center;padding:32px;color:var(--text-muted);"><i class="bi bi-key" style="font-size:32px;display:block;margin-bottom:12px;"></i>Sin claves BitLocker registradas para este equipo.</div>`;
