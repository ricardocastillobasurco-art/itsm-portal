    const active = d.active || [];
    if (!active.length) {
      el.innerHTML = '<div style="padding:48px;text-align:center;color:var(--text-muted);">Sin datos de tendencias disponibles. Verifica que el permiso <code>Reports.Read.All</code> esté concedido.</div>';
      return;
    }
    // Columnas numéricas (excluir reportRefreshDate)
    const cols = Object.keys(active[0]).filter(k => k.toLowerCase() !== 'reportrefreshdate' && k.toLowerCase() !== 'reportdate');
    const recent = active.slice(-14); // últimos 14 puntos
    const maxVal = Math.max(...recent.flatMap(row => cols.map(c => parseInt(row[c])||0)), 1);
    const colors = ['#0078d4','#7c3aed','#059669','#d97706','#dc2626','#6264a7'];
    const charts = cols.slice(0,6).map((col, i) => {
      const vals = recent.map(row => parseInt(row[col])||0);
      const bars = vals.map(v => `<div class="trend-bar" style="height:${Math.max(4, Math.round(v/maxVal*55))}px;background:${colors[i%colors.length]}22;border-top:2px solid ${colors[i%colors.length]};"></div>`).join('');
      const lastVal = vals[vals.length-1]||0;
      return `<div style="background:var(--bg-card);border:1px solid var(--border-soft);border-radius:14px;padding:16px 18px;">
        <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;">${col.replace(/([A-Z])/g,' $1').trim()}</div>
        <div style="font-size:24px;font-weight:800;color:${colors[i%colors.length]};">${lastVal.toLocaleString()}</div>
        <div style="font-size:10px;color:var(--text-muted);margin-bottom:8px;">usuarios activos hoy</div>
        <div class="trend-bar-wrap">${bars}</div>
        <div style="display:flex;justify-content:space-between;font-size:9px;color:var(--text-muted);margin-top:2px;"><span>14 días atrás</span><span>Hoy</span></div>
      </div>`;
    }).join('');
    el.innerHTML = `<div style="margin-bottom:12px;font-size:12px;color:var(--text-muted);">Datos de los últimos 30 días · ${active.length} puntos de datos</div><div class="ms-kpi-grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr));">${charts}</div>`;
    _markRefresh();
  } catch(e) { el.innerHTML = `<div class="ms-loading" style="color:#ef4444;"><i class="bi bi-exclamation-triangle"></i> ${e.message}</div>`; }
}

