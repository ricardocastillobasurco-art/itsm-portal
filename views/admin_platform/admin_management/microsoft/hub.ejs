<!-- ── MODAL SIN ACCESO ── -->
<div id="noAccessModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9999;display:none;align-items:center;justify-content:center;padding:20px;" onclick="if(event.target===this)closeNoAccessModal()">
  <div style="background:var(--bg-card,#fff);border-radius:20px;padding:40px 32px;max-width:440px;width:100%;box-shadow:0 24px 60px rgba(0,0,0,.25);text-align:center;position:relative;">
    <div style="width:72px;height:72px;background:linear-gradient(135deg,#fee2e2,#fecaca);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:34px;margin:0 auto 20px;">🔒</div>
    <h3 style="font-size:18px;font-weight:800;color:var(--text-main,#0f172a);margin:0 0 10px;">Sin acceso a este módulo</h3>
    <p style="font-size:13px;color:var(--text-muted,#64748b);line-height:1.7;margin:0 0 8px;">Tu cuenta de Microsoft no tiene los permisos necesarios en Azure Active Directory.</p>
    <p id="noAccessDetail" style="font-size:12px;color:#dc2626;background:#fee2e2;border-radius:10px;padding:10px 14px;margin:0 0 24px;line-height:1.6;"></p>
    <button onclick="closeNoAccessModal()" style="background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;border:none;border-radius:12px;padding:11px 32px;font-size:14px;font-weight:700;cursor:pointer;width:100%;">Entendido</button>
  </div>
</div>

<!-- ── MODAL DETALLE APPS / BITLOCKER ── -->
<div id="detailModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9998;align-items:center;justify-content:center;padding:20px;" onclick="if(event.target===this)closeDetailModal()">
  <div style="background:var(--bg-card,#fff);border-radius:20px;width:100%;max-width:700px;max-height:85vh;display:flex;flex-direction:column;box-shadow:0 24px 60px rgba(0,0,0,.25);">
    <div style="padding:20px 24px;border-bottom:1px solid var(--border-soft,#e2e8f0);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;">
      <span id="detailModalTitle" style="font-size:15px;font-weight:800;"></span>
      <button onclick="closeDetailModal()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-muted,#64748b);">✕</button>
    </div>
    <div id="detailModalBody" style="overflow-y:auto;padding:20px 24px;flex:1;"></div>
  </div>
</div>

<script>
(function(){
'use strict';

// ── estado ────────────────────────────────────────────────────────────────────
let _msConnected = false;
let _currentPanel = 'dashboard';
let _usersNextLink = null, _usersPrevLinks = [], _usersCurrentCursor = null, _usersTimer = null;
let _groupsSkip = 0, _groupsTimer = null;
let _devSkip = 0, _devTimer = null;
let _complianceSkip = 0, _complianceState = '';
let _maTimer = null;
const PAGE_SIZE = 50;
// datos cacheados para exportar CSV
let _usersData = [], _devicesData = [], _complianceData = [];

// ── init ──────────────────────────────────────────────────────────────────────
window.addEventListener('DOMContentLoaded', async () => {
  await checkMsStatus();
});

async function checkMsStatus() {
  try {
    const r = await fetch('/api/ms/status', { credentials: 'include' });
    const d = await r.json();
    console.log('[MS Panel] status response:', r.status, JSON.stringify(d));
    _msConnected = d.connected;
    const dot  = document.getElementById('msStatusDot');
    const txt  = document.getElementById('msStatusText');
    if (_msConnected) {
      dot.style.color = '#10b981';
      txt.textContent = 'Conectado a Microsoft 365';
      loadDashboard();
      // Cargar conteo de alertas en segundo plano para mostrar badge
      fetch('/api/ms/alerts', { credentials:'include' })
        .then(r => r.json())
        .then(d => { const b = document.getElementById('alertsBadge'); const n = d.data?.length||0; if (b && n) { b.textContent=n; b.style.display='inline'; } })
        .catch(() => {});
    } else {
      dot.style.color = '#f59e0b';
      txt.textContent = 'Sin sesión Microsoft';
      showConnectBanner();
    }
  } catch(e) {
    console.error('[MS Panel] status error:', e);
    document.getElementById('msStatusText').textContent = 'Error al verificar conexión';
    showConnectBanner();
  }
}

function showConnectBanner() {
  document.querySelectorAll('.ms-panel').forEach(p => p.style.display = 'none');
  document.getElementById('msPanelConnect').style.display = 'block';
}

// ── navegación ────────────────────────────────────────────────────────────────
window.msNav = function(panel, el) {
  if (!_msConnected) { showConnectBanner(); return; }
  document.querySelectorAll('.ms-nav-item').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('.ms-panel').forEach(p => { p.classList.remove('active'); p.style.display = 'none'; });
  const target = document.getElementById('msPanel' + panel.charAt(0).toUpperCase() + panel.slice(1));
  if (target) { target.classList.add('active'); target.style.display = 'block'; }
  _currentPanel = panel;
  if (panel === 'dashboard') loadDashboard();
  if (panel === 'users')    { _usersNextLink=null; _usersPrevLinks=[]; _usersCurrentCursor=null; loadUsers(); }
  if (panel === 'groups')   { _groupsSkip = 0; loadGroups(); }
  if (panel === 'security') loadMfa();
  if (panel === 'licenses') loadLicenses();
  if (panel === 'devices')  { _devSkip = 0; loadDevices(); }
};

window.msRefreshCurrent = function() {
  if (_currentPanel === 'dashboard') loadDashboard();
  if (_currentPanel === 'users')    loadUsers();
  if (_currentPanel === 'groups')   loadGroups();
  if (_currentPanel === 'security') loadMfa();
  if (_currentPanel === 'licenses') loadLicenses();
  if (_currentPanel === 'devices')  loadDevices();
};

// ── helpers ───────────────────────────────────────────────────────────────────
function _setLoading(elId) {
  const el = document.getElementById(elId);
  if (el) el.innerHTML = '<div class="ms-loading"><div class="spinner-border spinner-border-sm text-primary"></div> Cargando…</div>';
}
function _handleMsReauth(d) {
  if (d.msReauth) {
    _msConnected = false;
    const errMsg = d.error || 'Token Microsoft expirado';
    document.getElementById('msStatusText').textContent = errMsg;
    document.getElementById('msStatusDot').style.color = '#ef4444';
    console.error('[MS Panel] reauth error:', errMsg);
    // Mostrar error en el panel en lugar de solo el banner
    document.getElementById('dashContent').innerHTML =
      `<div style="padding:32px;text-align:center;color:var(--text-muted);">
        <i class="bi bi-exclamation-triangle-fill" style="font-size:32px;color:#ef4444;display:block;margin-bottom:12px;"></i>
        <div style="font-size:13px;font-weight:700;color:var(--text-main);margin-bottom:8px;">Error de token Microsoft</div>
        <div style="font-size:12px;max-width:500px;margin:0 auto;line-height:1.6;">${errMsg}</div>
        <div style="margin-top:16px;font-size:11px;color:var(--text-muted);">Revisa la consola del servidor para más detalles o visita <code>/api/ms/debug-token</code></div>
      </div>`;
    return true;
  }
  return false;
}
function _fmtDate(iso) { return iso ? new Date(iso).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}) : '—'; }
function _fmtDateTime(iso) { return iso ? new Date(iso).toLocaleString('es-PE',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '—'; }

// ── DASHBOARD ─────────────────────────────────────────────────────────────────
async function loadDashboard() {
  _setLoading('dashContent');
  try {
    const r = await fetch('/api/ms/dashboard', { credentials: 'include' });
    const d = await r.json();
    if (!d.success) { if (_handleMsReauth(d)) return; throw new Error(d.error); }
    const { users, groups, devices, licenses, org } = d.data;
    const licPct = licenses.total > 0 ? Math.round(licenses.used / licenses.total * 100) : 0;

    document.getElementById('dashContent').innerHTML = `
      <div style="margin-bottom:20px;">
        <div style="font-size:18px;font-weight:800;color:var(--text-main);">${org?.name || 'Tenant Microsoft 365'}</div>
        <div style="font-size:12px;color:var(--text-muted);">${(org?.domains || []).join(' · ')}</div>
      </div>
      <div class="ms-kpi-grid">
        <div class="ms-kpi clickable" onclick="msNav('users',document.querySelector('[onclick*=\\'users\\']'))">
          <div class="ms-kpi-icon" style="background:rgba(0,120,212,.1);color:#0078d4;"><i class="bi bi-people-fill"></i></div>
          <div class="ms-kpi-val">${(users||0).toLocaleString()}</div>
          <div class="ms-kpi-label">Usuarios activos</div>
          <div class="ms-kpi-sub">Entra ID habilitados → Ver listado</div>
        </div>
        <div class="ms-kpi clickable" onclick="msNav('groups',document.querySelector('[onclick*=\\'groups\\']'))">
          <div class="ms-kpi-icon" style="background:rgba(124,58,237,.1);color:#7c3aed;"><i class="bi bi-diagram-3-fill"></i></div>
          <div class="ms-kpi-val">${(groups||0).toLocaleString()}</div>
          <div class="ms-kpi-label">Grupos</div>
          <div class="ms-kpi-sub">Seguridad + M365 → Ver listado</div>
        </div>
        <div class="ms-kpi clickable" onclick="msNav('compliance',document.querySelector('[onclick*=\\'compliance\\']'))">
          <div class="ms-kpi-icon" style="background:rgba(5,150,105,.1);color:#059669;"><i class="bi bi-laptop-fill"></i></div>
          <div class="ms-kpi-val">${(devices||0).toLocaleString()}</div>
          <div class="ms-kpi-label">Dispositivos</div>
          <div class="ms-kpi-sub">Gestionados por Intune → Cumplimiento</div>
        </div>
        <div class="ms-kpi clickable" onclick="msNav('licenses',document.querySelector('[onclick*=\\'licenses\\']'))">
          <div class="ms-kpi-icon" style="background:rgba(245,158,11,.1);color:#d97706;"><i class="bi bi-key-fill"></i></div>
          <div class="ms-kpi-val">${licenses.used.toLocaleString()}<span style="font-size:14px;color:var(--text-muted);">/${licenses.total.toLocaleString()}</span></div>
          <div class="ms-kpi-label">Licencias usadas</div>
          <div class="ms-kpi-sub">${licenses.available} disponibles · ${licPct}% → Ver detalle</div>
        </div>
      </div>

      <!-- Tabla de licencias en dashboard -->
      <div class="ms-table-wrap">
        <div class="ms-table-head">
          <span class="ms-table-title"><i class="bi bi-key-fill" style="color:#0078d4;"></i> Resumen de suscripciones</span>
          <button onclick="msNav('licenses', document.querySelector('.ms-nav-item[onclick*=licenses]'))" style="font-size:11.5px;color:#0078d4;background:none;border:none;cursor:pointer;font-weight:700;">Ver detalle →</button>
        </div>
        <table class="ms-tbl">
          <thead><tr><th>Producto</th><th>Total</th><th>Usadas</th><th>Disponibles</th><th>Estado</th><th>Ocupación</th></tr></thead>
          <tbody>${licenses.list.map(l => {
            const pct = l.total > 0 ? Math.round(l.used/l.total*100) : 0;
            const statusCls = l.status === 'Enabled' ? 'badge-on' : l.status === 'Warning' ? 'badge-warn' : 'badge-off';
            return `<tr>
              <td style="font-weight:700;">${l.sku}</td>
              <td>${l.total.toLocaleString()}</td>
              <td>${l.used.toLocaleString()}</td>
              <td style="color:${l.available > 0 ? '#059669' : '#dc2626'};font-weight:700;">${l.available.toLocaleString()}</td>
              <td><span class="${statusCls}">${l.status}</span></td>
              <td>
                <div style="display:flex;align-items:center;gap:8px;">
                  <div class="lic-bar-wrap"><div class="lic-bar" style="width:${pct}%;background:${pct>90?'#ef4444':pct>70?'#f59e0b':'#0078d4'};"></div></div>
                  <span style="font-size:11px;color:var(--text-muted);">${pct}%</span>
                </div>
              </td>
            </tr>`;
          }).join('')}</tbody>
        </table>
      </div>`;
    _markRefresh();
  } catch(e) {
    document.getElementById('dashContent').innerHTML = `<div class="ms-loading" style="color:#ef4444;"><i class="bi bi-exclamation-triangle"></i> ${e.message}</div>`;
  }
}

// ── USUARIOS ──────────────────────────────────────────────────────────────────
window.msUsersDebounce = function() {
  clearTimeout(_usersTimer);
  _usersTimer = setTimeout(() => { _usersNextLink=null; _usersPrevLinks=[]; loadUsers(); }, 350);
};

async function loadUsers(cursorLink) {
  _usersCurrentCursor = cursorLink || null;
  _setLoading('usersTableWrap');
  const q      = document.getElementById('usersSearch')?.value || '';
  const status = document.getElementById('usersStatusFilter')?.value || '';
  try {
    let url = `/api/ms/users?top=${PAGE_SIZE}&q=${encodeURIComponent(q)}&status=${status}`;
    if (cursorLink) url += `&nextLink=${encodeURIComponent(cursorLink)}`;
    const r = await fetch(url, { credentials:'include' });
    const d = await r.json();
    if (!d.success) { if (_handleMsReauth(d)) return; throw new Error(d.error); }
    _usersData = d.data || [];
    const lbl = document.getElementById('usersTotalLabel');
    if (lbl && d.total) lbl.textContent = `${d.total.toLocaleString()} usuarios`;
    const rows = _usersData.map(u => {
      const lastLogin = u.signInActivity?.lastSignInDateTime;
      const name = (u.displayName||'').replace(/'/g,"\\'");
      const upn  = (u.userPrincipalName||'').replace(/'/g,"\\'");
      return `<tr class="clickable-row" onclick="loadUserDetail('${u.id}','${upn}','${name}')">
        <td><div style="font-weight:700;font-size:12.5px;">${u.displayName||'—'}</div><div style="font-size:10.5px;color:var(--text-muted);">${u.userPrincipalName||''}</div></td>
        <td style="font-size:12px;">${u.department||'<span style="opacity:.4">—</span>'}</td>
        <td style="font-size:12px;">${u.jobTitle||'<span style="opacity:.4">—</span>'}</td>
        <td><span class="${u.accountEnabled?'badge-on':'badge-off'}">${u.accountEnabled?'Activo':'Deshabilitado'}</span></td>
        <td style="font-size:11px;color:var(--text-muted);">${lastLogin?_fmtDateTime(lastLogin):'<span style="opacity:.4">Sin registro</span>'}</td>
        <td><span class="badge-neutral">${(u.assignedLicenses||[]).length} lic.</span></td>
      </tr>`;
    }).join('');
    document.getElementById('usersTableWrap').innerHTML = `
      <table class="ms-tbl">
        <thead><tr><th>Nombre / UPN</th><th>Departamento</th><th>Cargo</th><th>Estado</th><th>Último acceso</th><th>Licencias</th></tr></thead>
