  dashboard:    loadDashboard,
  alerts:       loadAlerts,
  users:        () => { _usersNextLink=null; _usersPrevLinks=[]; _usersCurrentCursor=null; loadUsers(); },
  groups:       () => { _groupsSkip=0; loadGroups(); },
  security:     loadMfa,
  licenses:     loadLicenses,
  devices:      () => { _devSkip=0; loadDevices(); },
  compliance:   () => { _complianceSkip=0; _complianceState=''; document.getElementById('complianceFilter').value=''; loadCompliance(); },
  signins:      loadSignins,
  auditlog:     loadAuditLog,
  condaccess:   loadCondAccess,
  riskyusers:   loadRiskyUsers,
  autopilot:    loadAutopilot,
  policies:     loadPolicies,
  managedapps:  loadManagedApps,
  deviceapps:   loadDeviceAppsList,
  bitlocker:    loadBitlockerDevices,
  winupdate:    loadWinUpdate,
  teams:        loadTeams,
  mailboxes:    loadMailboxes,
  reports:      loadReports,
  trends:       loadTrends,
};

// Sobrescribir msNav para usar el mapa centralizado
window.msNav = function(panel, el) {
  if (!_msConnected) { showConnectBanner(); return; }
  document.querySelectorAll('.ms-nav-item').forEach(b => b.classList.remove('active'));
  if (el) el.classList.add('active');
  document.querySelectorAll('.ms-panel').forEach(p => { p.classList.remove('active'); p.style.display = 'none'; });
  const panelId = 'msPanel' + panel.charAt(0).toUpperCase() + panel.slice(1);
  const target  = document.getElementById(panelId);
  if (target) { target.classList.add('active'); target.style.display = 'block'; }
  _currentPanel = panel;
  if (_panelLoaders[panel]) _panelLoaders[panel]();
};

window.msRefreshCurrent = function() {
  if (_panelLoaders[_currentPanel]) _panelLoaders[_currentPanel]();
};

})();
</script>

<%- include('../../../shared/partials/theme-toggle') %>
</body>
</html>
