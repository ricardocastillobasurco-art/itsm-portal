<script>
// ── State ──────────────────────────────────────────────────────────────────────
var _collections = [];
var _scripts     = [];
var _devices     = [];
var _selectedDevice = null;
var _selectedScript = null;
var _running = false;

// ── Init ───────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function(){
    applyThemeIcon();
    loadMeshStatus();
    loadDevices();
    loadLibrary();
});

// ── Theme ─────────────────────────────────────────────────────────────────────
function toggleTheme(){
    var t = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', t);
    localStorage.setItem('dashboardTheme', t);
    applyThemeIcon();
}
function applyThemeIcon(){
    var dark = document.documentElement.getAttribute('data-theme') === 'dark';
    var ic = document.getElementById('themeIcon');
    if(ic) ic.className = dark ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
}

// ── MeshCentral status ─────────────────────────────────────────────────────────
function loadMeshStatus(){
    fetch('/api/rmm/status').then(r=>r.json()).then(function(d){
        var dot = document.getElementById('meshDot');
        var txt = document.getElementById('meshStatusText');
        if(d.ok && d.connected){
            dot.className = 'status-dot dot-ok';
            txt.textContent = 'MeshCentral conectado';
        } else if(!d.configured){
            dot.className = 'status-dot';
            dot.style.background = 'var(--warning)';
            txt.textContent = 'Sin configurar';
        } else {
            dot.className = 'status-dot';
            dot.style.background = 'var(--danger)';
            txt.textContent = 'Desconectado';
        }
    }).catch(function(){ });
    setTimeout(loadMeshStatus, 30000);
}

// ── Devices ────────────────────────────────────────────────────────────────────
function loadDevices(){
    fetch('/api/rmm/devices').then(r=>r.json()).then(function(d){
        if(d.ok) _devices = d.devices || [];
        document.getElementById('btnRunCmd').disabled = !_selectedDevice;
    }).catch(function(){});
}

function filterDevices(q){
    var dd = document.getElementById('deviceDropdown');
    q = (q||'').toLowerCase().trim();
    var list = q ? _devices.filter(function(d){
        return (d.name||'').toLowerCase().includes(q) || (d.ip||'').toLowerCase().includes(q) || (d.os||'').toLowerCase().includes(q);
    }) : _devices.slice(0, 40);
    renderDeviceDropdown(list);
}

function renderDeviceDropdown(list){
    var dd = document.getElementById('deviceDropdown');
    if(!list.length){
        dd.innerHTML = '<div style="padding:12px;text-align:center;color:var(--muted);font-size:12px;">Sin resultados</div>';
        dd.classList.add('show');
        return;
    }
    dd.innerHTML = list.map(function(d){
        var col = d.online ? '#10b981' : '#94a3b8';
        return '<div class="device-opt" onclick="selectDevice(\''+escHtml(d.nodeId)+'\',\''+escHtml(d.name)+'\',\''+escHtml(d.os||'')+'\','+d.online+')">'+
               '<div class="device-opt-dot" style="background:'+col+'"></div>'+
               '<div class="device-opt-name">'+escHtml(d.name)+'</div>'+
               '<div class="device-opt-os">'+escHtml((d.os||'').split(' - ')[0].substring(0,30))+'</div>'+
               '</div>';
    }).join('');
    dd.classList.add('show');
}

function showDeviceDropdown(){
    if(_selectedDevice) return;
    filterDevices(document.getElementById('deviceInput').value);
}
function hideDeviceDropdown(){ document.getElementById('deviceDropdown').classList.remove('show'); }

function selectDevice(nodeId, name, os, online){
    _selectedDevice = { nodeId: nodeId, name: name, os: os, online: online };
    document.getElementById('deviceInput').style.display = 'none';
    var chip = document.getElementById('selectedDeviceChip');
    document.getElementById('selectedDeviceName').textContent = name;
    chip.style.display = 'flex';
    hideDeviceDropdown();
    document.getElementById('sbDevice').textContent = name;
    document.getElementById('btnRunCmd').disabled = false;
    updateRunButton();
    termLine('t-info', '→ Dispositivo seleccionado: '+name+' ('+(online?'ONLINE':'OFFLINE')+')');
}

function clearDevice(){
    _selectedDevice = null;
    document.getElementById('deviceInput').style.display = '';
    document.getElementById('deviceInput').value = '';
    document.getElementById('selectedDeviceChip').style.display = 'none';
    document.getElementById('sbDevice').textContent = 'Sin dispositivo';
    document.getElementById('btnRun').disabled = true;
    document.getElementById('btnRunCmd').disabled = true;
}

// ── Script Library ─────────────────────────────────────────────────────────────
var _colColors = ['#2563eb','#059669','#dc2626','#d97706','#7c3aed','#0891b2','#db2777','#64748b'];
function colColor(id){ return _colColors[(id-1) % _colColors.length]; }

function loadLibrary(){
    Promise.all([
        fetch('/api/rmm/scripts/collections').then(r=>r.json()),
        fetch('/api/rmm/scripts').then(r=>r.json())
    ]).then(function(results){
        var colRes = results[0], scriptRes = results[1];
        _collections = (colRes.ok && colRes.collections) ? colRes.collections : [];
        _scripts     = (scriptRes.ok && scriptRes.scripts) ? scriptRes.scripts : [];
        renderLibrary(_collections, _scripts);
        populateCollectionSelect();
    }).catch(function(e){
        document.getElementById('scriptLibrary').innerHTML =
            '<div style="text-align:center;padding:20px;color:var(--danger);font-size:12px;"><i class="bi bi-exclamation-triangle" style="font-size:24px;display:block;margin-bottom:8px;"></i>'+escHtml(e.message)+'</div>';
    });
}

function renderLibrary(cols, scripts, filter){
    var lib = document.getElementById('scriptLibrary');
    if(!cols.length){ lib.innerHTML='<div style="padding:20px;text-align:center;color:var(--muted);font-size:12px;">Sin colecciones. Crea una con el botón +</div>'; return; }
    lib.innerHTML = cols.map(function(c){
        var cScripts = scripts.filter(function(s){ return s.collection_id === c.id; });
        if(filter) cScripts = cScripts.filter(function(s){ return s.name.toLowerCase().includes(filter) || (s.description||'').toLowerCase().includes(filter); });
        var col = colColor(c.id);
        return '<div class="col-item open" id="col_'+c.id+'">'+
            '<div class="col-header" onclick="toggleCol('+c.id+')">'+
            '<div class="col-icon" style="background:'+col+'1a;color:'+col+'"><i class="bi '+escHtml(c.icon||'bi-collection')+'"></i></div>'+
            '<div class="col-name">'+escHtml(c.name)+'</div>'+
            '<span class="col-count">'+cScripts.length+'</span>'+
            '<i class="bi bi-chevron-right col-chevron"></i>'+
            '</div>'+
            '<div class="col-scripts">'+
            cScripts.map(function(s){ return renderScriptItem(s, col); }).join('')+
            (cScripts.length===0?'<div style="padding:6px 8px;font-size:11px;color:var(--muted);font-style:italic;">Sin scripts — usa el editor para agregar</div>':'')+
            '</div>'+
        '</div>';
    }).join('');
}

function renderScriptItem(s, col){
    return '<div class="script-item" id="si_'+s.id+'" onclick="selectScript('+s.id+')" title="'+escHtml(s.description||s.name)+'">'+
        '<i class="bi bi-file-earmark-code" style="font-size:13px;color:'+col+';flex-shrink:0;"></i>'+
        '<div class="script-item-name">'+escHtml(s.name)+'</div>'+
        '<div class="script-item-actions">'+
        '<button class="act-btn run" onclick="event.stopPropagation();selectAndRun('+s.id+')" title="Ejecutar"><i class="bi bi-play-fill"></i></button>'+
        '<button class="act-btn" onclick="event.stopPropagation();editScript('+s.id+')" title="Editar"><i class="bi bi-pencil"></i></button>'+
        '<button class="act-btn del" onclick="event.stopPropagation();deleteScript('+s.id+')" title="Eliminar"><i class="bi bi-trash3"></i></button>'+
        '</div>'+
    '</div>';
}

function toggleCol(id){
    var el = document.getElementById('col_'+id);
    if(el) el.classList.toggle('open');
}

function filterScripts(q){
    q = (q||'').toLowerCase().trim();
    renderLibrary(_collections, _scripts, q||null);
}

function selectScript(id){
    _selectedScript = _scripts.find(function(s){ return s.id === id; });
    document.querySelectorAll('.script-item').forEach(function(el){ el.classList.remove('selected'); });
    var el = document.getElementById('si_'+id);
    if(el) el.classList.add('selected');
    var bar = document.getElementById('scriptBar');
    if(_selectedScript){
        bar.innerHTML = '<i class="bi bi-file-earmark-code" style="color:var(--primary);"></i>'+
            '<span class="script-bar-name">'+escHtml(_selectedScript.name)+'</span>'+
            (_selectedScript.description ? '<span class="script-bar-desc">— '+escHtml(_selectedScript.description)+'</span>' : '');
        document.getElementById('sbScript').textContent = _selectedScript.name;
    }
    updateRunButton();
}

function selectAndRun(id){
    selectScript(id);
    if(_selectedDevice) runSelected();
    else termLine('t-warn', '⚠ Selecciona un dispositivo primero');
}

function updateRunButton(){
    var ok = !!(_selectedDevice && _selectedScript && !_running);
    document.getElementById('btnRun').disabled = !ok;
}

// ── Execution ─────────────────────────────────────────────────────────────────
function runSelected(){
    if(!_selectedDevice){ termLine('t-warn','⚠ Selecciona un dispositivo'); return; }
    if(!_selectedScript){ termLine('t-warn','⚠ Selecciona un script'); return; }
    executeScript(_selectedDevice.nodeId, null, _selectedScript.id, _selectedScript.name);
}

function runCustomCmd(){
    var cmd = document.getElementById('customCmd').value.trim();
    if(!cmd) return;
    if(!_selectedDevice){ termLine('t-warn','⚠ Selecciona un dispositivo primero'); return; }
    executeScript(_selectedDevice.nodeId, cmd, null, 'Comando personalizado');
    document.getElementById('customCmd').value = '';
}

function executeScript(nodeId, customCode, scriptId, scriptName){
    if(_running) return;
    _running = true;
    updateRunButton();
    document.getElementById('btnRun').classList.add('running');
    document.getElementById('btnRun').innerHTML = '<i class="bi bi-arrow-repeat t-spin"></i> Ejecutando...';
    document.getElementById('btnRunCmd').disabled = true;

    var sbStatus = document.getElementById('sbStatus');
    sbStatus.innerHTML = '<i class="bi bi-arrow-repeat t-spin"></i> Ejecutando...';
    sbStatus.style.color = '#d29922';

    var t0 = Date.now();
    termSep();
    termLine('t-prompt', '┌─ '+scriptName);
    termLine('t-prompt', '├─ Dispositivo: '+ (_selectedDevice ? _selectedDevice.name : nodeId));
    termLine('t-info',   '└─ Iniciando... ('+(new Date().toLocaleTimeString())+')');

    var body = { nodeId: nodeId };
    if(scriptId) body.scriptId = scriptId;
    if(customCode) body.customCode = customCode;

    var _abortCtrl = new AbortController();
    var _abortTimer = setTimeout(function(){ _abortCtrl.abort(); }, 125000);

    fetch('/api/rmm/device/run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        signal: _abortCtrl.signal
    }).then(function(r){ clearTimeout(_abortTimer); return r.json(); }).then(function(d){
        var elapsed = ((Date.now()-t0)/1000).toFixed(1)+'s';
        if(d.ok){
            termLine('t-ok', '✔ Completado en '+elapsed);
            termLine('t-separator','');
            (d.output||'(sin salida)').split('\n').forEach(function(line){
                var cls = 't-out';
                if(/error|failed|exception/i.test(line)) cls='t-err';
                else if(/warning|warn/i.test(line)) cls='t-warn';
                else if(/success|completado|ok|✓/i.test(line)) cls='t-ok';
                termLine(cls, line);
            });
            sbStatus.innerHTML = '<i class="bi bi-check-circle"></i> Completado ('+elapsed+')';
            sbStatus.style.color = '#3fb950';
        } else {
            termLine('t-err', '✖ Error: '+(d.error||'desconocido'));
            sbStatus.innerHTML = '<i class="bi bi-x-circle"></i> Error';
            sbStatus.style.color = '#f85149';
        }
        document.getElementById('sbTime').textContent = new Date().toLocaleTimeString();
    }).catch(function(e){
        clearTimeout(_abortTimer);
        var msg = (e.name === 'AbortError') ? 'Tiempo de espera agotado (>95s)' : e.message;
        termLine('t-err', '✖ '+msg);
        sbStatus.innerHTML = '<i class="bi bi-x-circle"></i> ' + (e.name === 'AbortError' ? 'Timeout' : 'Error de red');
        sbStatus.style.color = '#f85149';
    }).finally(function(){
        _running = false;
        updateRunButton();
        document.getElementById('btnRun').classList.remove('running');
        document.getElementById('btnRun').innerHTML = '<i class="bi bi-play-fill"></i> Ejecutar';
        document.getElementById('btnRunCmd').disabled = !_selectedDevice;
    });
}

// ── Terminal helpers ───────────────────────────────────────────────────────────
function termLine(cls, text){
    var t = document.getElementById('terminal');
    if(cls==='t-separator'){
        t.insertAdjacentHTML('beforeend','<hr class="t-separator">');
    } else {
        var span = document.createElement('span');
        span.className = cls;
        span.textContent = text+'\n';
        t.appendChild(span);
    }
    t.scrollTop = t.scrollHeight;
}
function termSep(){ termLine('t-separator',''); }
function clearTerminal(){
    document.getElementById('terminal').innerHTML='';
    termLine('t-info','— Terminal limpiado ('+new Date().toLocaleTimeString()+') —');
}
function copyOutput(){
    var text = document.getElementById('terminal').innerText;
    navigator.clipboard.writeText(text).then(function(){
        var btn = document.querySelector('[onclick="copyOutput()"]');
        if(btn){ var orig=btn.innerHTML; btn.innerHTML='<i class="bi bi-check"></i> Copiado'; setTimeout(function(){btn.innerHTML=orig;},1500); }
    });
}

// ── Editor ─────────────────────────────────────────────────────────────────────
function toggleEditor(){
    var p = document.getElementById('editorPanel');
    p.classList.toggle('hidden');
    var btn = document.getElementById('editorToggleBtn');
    btn.style.background = p.classList.contains('hidden') ? '' : 'var(--primary-dim)';
    btn.style.color = p.classList.contains('hidden') ? '' : 'var(--primary)';
    btn.style.borderColor = p.classList.contains('hidden') ? '' : 'var(--primary)';
}

function clearEditor(){
    document.getElementById('editScriptId').value='';
    document.getElementById('editName').value='';
    document.getElementById('editDesc').value='';
    document.getElementById('editCode').value='';
    document.getElementById('editorTitle').textContent='Nuevo Script';
}

function editScript(id){
    var s = _scripts.find(function(x){ return x.id===id; });
    if(!s) return;
    document.getElementById('editScriptId').value = s.id;
    document.getElementById('editName').value = s.name;
    document.getElementById('editDesc').value = s.description||'';
    document.getElementById('editCode').value = s.code;
    document.getElementById('editCollection').value = s.collection_id;
    document.getElementById('editorTitle').textContent = 'Editar: '+s.name;
    var p = document.getElementById('editorPanel');
    p.classList.remove('hidden');
}

function saveScript(){
    var id   = document.getElementById('editScriptId').value;
    var name = document.getElementById('editName').value.trim();
    var col  = document.getElementById('editCollection').value;
    var desc = document.getElementById('editDesc').value.trim();
    var code = document.getElementById('editCode').value.trim();
    if(!name){ alert('El nombre es requerido'); return; }
    if(!col){  alert('Selecciona una colección'); return; }
    if(!code){ alert('El código no puede estar vacío'); return; }
    var url    = id ? '/api/rmm/scripts/'+id : '/api/rmm/scripts';
    var method = id ? 'PUT' : 'POST';
    fetch(url, { method: method, headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ collection_id: parseInt(col), name: name, description: desc, code: code }) })
    .then(function(r){ return r.json(); }).then(function(d){
        if(d.ok){ loadLibrary(); clearEditor(); termLine('t-ok', '✔ Script "'+(name)+'" guardado correctamente'); }
        else alert('Error: '+(d.error||'desconocido'));
    });
}

function deleteScript(id){
    var s = _scripts.find(function(x){ return x.id===id; });
    if(!s || !confirm('¿Eliminar "'+s.name+'"?')) return;
    fetch('/api/rmm/scripts/'+id, { method:'DELETE' }).then(function(r){ return r.json(); }).then(function(d){
        if(d.ok){ if(_selectedScript && _selectedScript.id===id) _selectedScript=null; loadLibrary(); termLine('t-warn','⚠ Script "'+s.name+'" eliminado'); }
        else alert('Error: '+(d.error||'desconocido'));
    });
}

function populateCollectionSelect(){
    var sel = document.getElementById('editCollection');
    sel.innerHTML = '<option value="">— Seleccionar —</option>'+
        _collections.map(function(c){ return '<option value="'+c.id+'">'+escHtml(c.name)+'</option>'; }).join('');
}

