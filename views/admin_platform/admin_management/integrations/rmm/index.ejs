// ── Utility ───────────────────────────────────────────────────────────────────
function escHtml(t){ var d=document.createElement('div'); d.textContent=t; return d.innerHTML; }

// ── Mode toggle ────────────────────────────────────────────────────────────────
var _mode = 'terminal';
var _gridDevices = [];

function setMode(mode) {
    _mode = mode;
    var ws  = document.querySelector('.workspace');
    var dp  = document.getElementById('devicesPanel');
    var btnT = document.getElementById('btnModeTerminal');
    var btnD = document.getElementById('btnModeDevices');
    if (mode === 'devices') {
        ws.style.display = 'none';
        dp.style.display = 'block';
        btnT.classList.remove('active');
        btnD.classList.add('active');
        if (!_gridDevices.length) loadDevicesGrid(false);
    } else {
        ws.style.display  = 'flex';
        dp.style.display  = 'none';
        btnT.classList.add('active');
        btnD.classList.remove('active');
    }
}

function loadDevicesGrid(force) {
    var grid = document.getElementById('deviceGrid');
    grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:50px;color:var(--muted);font-size:13px;"><i class="bi bi-arrow-repeat t-spin" style="font-size:28px;display:block;margin-bottom:10px;"></i>Cargando...</div>';
    fetch('/api/rmm/devices'+(force?'?refresh=1':'')).then(function(r){ return r.json(); }).then(function(d){
        if (!d.ok) { grid.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--danger);font-size:13px;">Error: '+escHtml(d.error||'desconocido')+'</div>'; return; }
        _gridDevices = d.devices || [];
        _devices = _gridDevices;
        renderDeviceGrid(_gridDevices);
    }).catch(function(e){
        grid.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--danger);font-size:13px;">'+escHtml(e.message)+'</div>';
    });
}

function filterGrid(q) {
    q = (q||'').toLowerCase().trim();
    var list = q ? _gridDevices.filter(function(d){ return (d.name||'').toLowerCase().includes(q)||(d.ip||'').toLowerCase().includes(q)||(d.os||'').toLowerCase().includes(q); }) : _gridDevices;
    renderDeviceGrid(list);
}

function renderDeviceGrid(list) {
    var cnt  = document.getElementById('gridCount');
    var grid = document.getElementById('deviceGrid');
    var on   = list.filter(function(d){ return d.online; }).length;
    cnt.textContent = '— '+list.length+' equipos · '+on+' en línea';
    if (!list.length) { grid.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:50px;color:var(--muted);font-size:13px;"><i class="bi bi-laptop" style="font-size:32px;display:block;margin-bottom:10px;opacity:.3;"></i>Sin dispositivos</div>'; return; }
    grid.innerHTML = list.map(function(d){
        var oc = d.online ? '#10b981' : '#94a3b8';
        var bc = d.online ? 'var(--success)' : 'var(--border)';
        var os = (d.os||'').split(' - ')[0].substring(0,28);
        var sub = [os, d.ip].filter(Boolean).join(' · ');
        var nid = escHtml(d.nodeId), nm = escHtml(d.name), osH = escHtml(d.os||'');
        return '<div class="dcard"'+
            ' oncontextmenu="showCtxMenu(event,\''+nid+'\',\''+nm+'\','+d.online+')"'+
            ' ondblclick="dCardScript(\''+nid+'\',\''+nm+'\',\''+osH+'\','+d.online+')">'+
            '<div class="dcard-bar" style="background:'+bc+'"></div>'+
            '<div class="dcard-body">'+
            '<div class="dcard-name">'+escHtml(d.name)+'</div>'+
            '<div class="dcard-sub">'+escHtml(sub||'—')+'</div>'+
            '<div class="dcard-meta">'+
            '<div class="dcard-status"><div style="width:7px;height:7px;border-radius:50%;background:'+oc+';'+(d.online?'box-shadow:0 0 0 3px rgba(16,185,129,.15)':'')+';"></div>'+(d.online?'En línea':'Fuera de línea')+'</div>'+
            '<div class="dcard-actions">'+
            (d.online
                ?'<button class="dcard-btn" title="Escritorio remoto" onclick="event.stopPropagation();dCardRemote(\''+nid+'\')"><i class="bi bi-display"></i></button>'
                :'<button class="dcard-btn" disabled title="Fuera de línea" style="opacity:.3;cursor:default;"><i class="bi bi-display"></i></button>')+
            '<button class="dcard-btn" title="Usar en Scripts" onclick="event.stopPropagation();dCardScript(\''+nid+'\',\''+nm+'\',\''+osH+'\','+d.online+')"><i class="bi bi-terminal"></i></button>'+
            (d.online?'<button class="dcard-btn" title="Herramientas" onclick="event.stopPropagation();openToolsModal(\''+nid+'\',\''+nm+'\',\'proc\')"><i class="bi bi-tools"></i></button>':'')+
            (d.online
                ?'<button class="dcard-btn off" title="Apagar / Reiniciar" onclick="event.stopPropagation();showCtxMenu(event,\''+nid+'\',\''+nm+'\','+d.online+')"><i class="bi bi-power"></i></button>'
                :'<button class="dcard-btn" disabled title="Fuera de línea" style="opacity:.3;cursor:default;"><i class="bi bi-power"></i></button>')+
            '</div></div></div></div>';
    }).join('');
}

function dCardRemote(nodeId) {
    fetch('/api/rmm/session', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({nodeId:nodeId}) })
    .then(function(r){ return r.json(); }).then(function(d){ if(d.ok && d.url) window.open(d.url,'_blank'); else alert('Error sesión: '+(d.error||'desconocido')); })
    .catch(function(e){ alert('Error: '+e.message); });
}

function dCardScript(nodeId, name, os, online) {
    selectDevice(nodeId, name, os, online);
    setMode('terminal');
}

// ── Context menu ───────────────────────────────────────────────────────────────
var _ctxNodeId = null, _ctxName = null, _ctxOnline = false;

function showCtxMenu(e, nodeId, name, online) {
    e.preventDefault();
    e.stopPropagation();
    _ctxNodeId = nodeId; _ctxName = name; _ctxOnline = online;
    var m = document.getElementById('ctxMenu');
    ['ctxRdp','ctxTerm','ctxProc','ctxSvc','ctxSw','ctxEvt','ctxRestart','ctxSleep','ctxOff'].forEach(function(id){
        var el = document.getElementById(id);
        if (el) el.classList.toggle('ctx-disabled', !online);
    });
    m.style.display = 'block';
    var x = e.clientX, y = e.clientY;
    m.style.left = '-9999px'; m.style.top = '-9999px';
    requestAnimationFrame(function(){
        var mw = m.offsetWidth||210, mh = m.offsetHeight||260;
        if (x+mw > window.innerWidth)  x = window.innerWidth  - mw - 8;
        if (y+mh > window.innerHeight) y = window.innerHeight - mh - 8;
        m.style.left = x+'px'; m.style.top = y+'px';
    });
}

function hideCtxMenu(){ var m=document.getElementById('ctxMenu'); if(m) m.style.display='none'; }

function ctxOpenRemote(){ hideCtxMenu(); if(_ctxNodeId) dCardRemote(_ctxNodeId); }
function ctxUseInTerminal(){ hideCtxMenu(); if(_ctxNodeId) dCardScript(_ctxNodeId,_ctxName,'',_ctxOnline); }
function ctxOpenToast(){ hideCtxMenu(); if(_ctxNodeId) openToastModal(_ctxNodeId,_ctxName); }
function ctxPower(action){ hideCtxMenu(); if(_ctxNodeId) openPowerModal(_ctxNodeId,_ctxName,action); }
function ctxOpenTools(tab){ hideCtxMenu(); if(_ctxNodeId) openToolsModal(_ctxNodeId,_ctxName,tab); }

document.addEventListener('click', function(e){ if(!e.target.closest('#ctxMenu')) hideCtxMenu(); });
document.addEventListener('keydown', function(e){ if(e.key==='Escape') hideCtxMenu(); });

// ── Power modal ─────────────────────────────────────────────────────────────────
var _powerNodeId=null, _powerAction=null;
var POWER_CFG={
    reset:{title:'Reiniciar equipo',  icon:'bi-arrow-repeat',color:'var(--warning)', warn:''},
    sleep:{title:'Suspender equipo',  icon:'bi-moon-fill',   color:'var(--info)',    warn:''},
    off:  {title:'Apagar equipo',     icon:'bi-power',       color:'var(--danger)',  warn:'Atención: el equipo no podrá encenderse remotamente sin Wake-on-LAN.'}
};

function openPowerModal(nodeId, name, action){
    _powerNodeId=nodeId; _powerAction=action;
    var cfg=POWER_CFG[action]||{title:action,icon:'bi-lightning',color:'var(--warning)',warn:''};
    document.getElementById('powerModalTitle').textContent  = cfg.title;
    document.getElementById('powerDeviceName').textContent  = name;
    document.getElementById('powerModalIcon').className     = 'bi '+cfg.icon;
    document.getElementById('powerModalIcon').style.color   = cfg.color;
    document.getElementById('powerModalWarn').textContent   = cfg.warn;
    document.getElementById('powerConfirmBtn').style.background = cfg.color;
    document.getElementById('powerModal').classList.add('show');
}

function closePowerModal(){
    document.getElementById('powerModal').classList.remove('show');
    _powerNodeId=null; _powerAction=null;
}

function confirmPower(){
    if(!_powerNodeId||!_powerAction) return;
    var devName  = document.getElementById('powerDeviceName').textContent;
    var act      = _powerAction;
    var btn      = document.getElementById('powerConfirmBtn');
    btn.disabled = true; btn.innerHTML='<i class="bi bi-arrow-repeat t-spin"></i>';
    fetch('/api/rmm/device/power',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nodeId:_powerNodeId,action:act})})
    .then(function(r){ return r.json(); }).then(function(d){
        closePowerModal();
        if(d.ok){
            termLine('t-ok','✔ Acción "'+act+'" enviada a '+devName);
            if(_mode==='devices') setTimeout(function(){ loadDevicesGrid(true); },4000);
        } else { alert('Error: '+(d.error||'desconocido')); }
    }).catch(function(e){ closePowerModal(); alert('Error de red: '+e.message); })
    .finally(function(){ btn.disabled=false; btn.innerHTML='Confirmar'; });
}

// ── Tools modal (processes / services / software) ──────────────────────────────
var _toolsNodeId=null, _toolsName=null, _toolsTab='proc';
var _toolsData={proc:null,svc:null,sw:null,evt:null,met:null,tasks:null,users:null,net:null};

function openToolsModal(nodeId, name, tab) {
    _toolsNodeId=nodeId; _toolsName=name; _toolsTab=tab||'proc';
    _toolsData={proc:null,svc:null,sw:null,evt:null,met:null,tasks:null,users:null,net:null};
    document.getElementById('toolsDeviceName').textContent=name;
    document.getElementById('toolsSearch').value='';
    document.getElementById('toolsModal').classList.add('show');
    switchToolsTab(_toolsTab);
}

function closeToolsModal(){ document.getElementById('toolsModal').classList.remove('show'); _toolsNodeId=null; }

var _toolsEvtLevel = null;

function switchToolsTab(tab){
    _toolsTab=tab;
    ['proc','svc','sw','evt','met','tasks','users','net'].forEach(function(t){ document.getElementById('tab-'+t).classList.toggle('active',t===tab); });
    document.getElementById('toolsSearch').value='';
    _toolsEvtLevel=null;
    toolsLoad(tab);
}

function toolsRefresh(){ _toolsData[_toolsTab]=null; _toolsEvtLevel=null; toolsLoad(_toolsTab); }

function toolsLoad(tab){
    if(!_toolsNodeId) return;
    var content=document.getElementById('toolsContent');
    if(_toolsData[tab]!==null){ toolsRender(tab,_toolsData[tab]); return; }
    content.innerHTML='<div style="text-align:center;padding:50px;color:var(--muted);"><i class="bi bi-arrow-repeat t-spin" style="font-size:24px;display:block;margin-bottom:8px;"></i>Cargando...</div>';
    var ep=tab==='proc'  ?'/api/rmm/device/processes'
          :tab==='svc'   ?'/api/rmm/device/services'
          :tab==='evt'   ?'/api/rmm/device/eventlog'
          :tab==='met'   ?'/api/rmm/device/metrics'
          :tab==='tasks' ?'/api/rmm/device/tasks'
          :tab==='users' ?'/api/rmm/device/users'
          :tab==='net'   ?'/api/rmm/device/network'
          :'/api/rmm/device/apps';
    fetch(ep,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nodeId:_toolsNodeId})})
    .then(function(r){ return r.json(); }).then(function(d){
        if(!d.ok){ content.innerHTML='<div style="text-align:center;padding:40px;color:var(--danger);">Error: '+escHtml(d.error||'desconocido')+'</div>'; return; }
        _toolsData[tab]=tab==='proc'?d.processes:tab==='svc'?d.services:tab==='evt'?d.events:tab==='met'?d.metrics:tab==='tasks'?d.tasks:tab==='users'?d.users:tab==='net'?d.network:d.apps;
        toolsRender(tab,_toolsData[tab]||[]);
    }).catch(function(e){ content.innerHTML='<div style="text-align:center;padding:40px;color:var(--danger);">'+escHtml(e.message)+'</div>'; });
}

function toolsFilter(q){
    if(_toolsData[_toolsTab]===null||_toolsTab==='met'||_toolsTab==='net') return;
    toolsRender(_toolsTab,_toolsData[_toolsTab],q.toLowerCase().trim());
}

function setEvtLevel(level){
    _toolsEvtLevel=level;
    if(_toolsData['evt']!==null) toolsRender('evt',_toolsData['evt']);
}

function metricBar(label, value, pct, color){
    var safe=Math.min(Math.max(pct||0,0),100);
    return '<div class="metric-item">'+
        '<div class="metric-label"><span>'+escHtml(label)+'</span>'+
        '<span class="metric-label-val" style="color:'+color+';">'+safe+'% &nbsp;'+escHtml(value)+'</span></div>'+
        '<div class="metric-bar"><div class="metric-fill" style="width:'+safe+'%;background:'+color+';"></div></div>'+
        '</div>';
}

function toolsRender(tab, data, filter){
    var content=document.getElementById('toolsContent');
    var info=document.getElementById('toolsFooterInfo');

    // ── Métricas ──────────────────────────────────────────────────────────────
    if(tab==='met'){
        var m=data;
        if(!m||m.error){ content.innerHTML='<div style="text-align:center;padding:40px;color:var(--danger);">'+(m&&m.error?escHtml(m.error):'Sin datos')+'</div>'; return; }
        var cpuC=m.cpu>80?'var(--danger)':m.cpu>60?'var(--warning)':'var(--success)';
        var ramC=m.usedPct>80?'var(--danger)':m.usedPct>60?'var(--warning)':'var(--success)';
        var disksHtml=(m.disks||[]).map(function(d){
            var c=d.p>85?'var(--danger)':d.p>70?'var(--warning)':'var(--primary)';
            return metricBar('Disco '+d.d,(d.t-d.f).toFixed(1)+' / '+d.t+' GB',d.p,c);
        }).join('');
        content.innerHTML='<div class="metric-wrap">'+
            '<div style="font-size:11px;color:var(--muted);text-align:right;margin-bottom:14px;">Snapshot: '+escHtml(m.ts||'—')+'</div>'+
            metricBar('CPU',m.cpu+'%',m.cpu,cpuC)+
            metricBar('Memoria RAM',(m.usedMB/1024).toFixed(1)+' / '+(m.totalMB/1024).toFixed(1)+' GB',m.usedPct,ramC)+
            disksHtml+'</div>';
        info.textContent='Snapshot a las '+escHtml(m.ts||'—');
        return;
    }

    // ── Event Log ─────────────────────────────────────────────────────────────
    if(tab==='evt'){
        var all=data||[];
        var lf=_toolsEvtLevel;
        var list=lf?all.filter(function(e){ return e.lvl===lf; }):all;
        if(filter) list=list.filter(function(e){ return JSON.stringify(e).toLowerCase().includes(filter); });
        var levels=[{lbl:'Todos',val:null,c:'var(--muted)'},{lbl:'Critical',val:'Critical',c:'#9b1c1c'},{lbl:'Error',val:'Error',c:'var(--danger)'},{lbl:'Warning',val:'Warning',c:'var(--warning)'}];
        var fBar='<div class="evt-filter-bar">'+levels.map(function(l){
            var ac=l.val===lf;
            return '<button class="evt-filter-btn'+(ac?' active':'')+'" style="color:'+l.c+';'+(ac?'background:'+l.c+'22;border-color:'+l.c+';':'')+'" onclick="setEvtLevel('+JSON.stringify(l.val)+')">'+escHtml(l.lbl)+'</button>';
        }).join('')+'<span style="margin-left:auto;font-size:11px;color:var(--muted);">'+list.length+' eventos</span></div>';
        info.textContent=list.length+' de '+all.length+' eventos';
        if(!list.length){ content.innerHTML=fBar+'<div style="text-align:center;padding:40px;color:var(--muted);">Sin eventos para el filtro seleccionado</div>'; return; }
        content.innerHTML=fBar+'<div style="overflow-x:auto;"><table class="tools-table"><thead><tr><th style="white-space:nowrap;">Fecha/Hora</th><th>Nivel</th><th>Fuente</th><th>Mensaje</th></tr></thead><tbody>'+
            list.map(function(e){
                var lc=e.lvl==='Critical'?'#9b1c1c':e.lvl==='Error'?'var(--danger)':'var(--warning)';
                var badge='<span style="font-size:10px;padding:2px 7px;border-radius:10px;background:'+lc+'22;color:'+lc+';font-weight:700;white-space:nowrap;">'+escHtml(e.lvl)+'</span>';
                return '<tr><td style="font-size:11px;font-family:monospace;white-space:nowrap;">'+escHtml(e.t||'')+'</td>'+
                    '<td>'+badge+'</td>'+
                    '<td style="font-size:11px;color:var(--muted);white-space:nowrap;max-width:140px;overflow:hidden;text-overflow:ellipsis;">'+escHtml(e.src||'')+'</td>'+
                    '<td style="font-size:12px;max-width:380px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="'+escHtml(e.msg||'')+'">'+escHtml(e.msg||'')+'</td></tr>';
            }).join('')+'</tbody></table></div>';
        return;
    }

    // ── Procesos / Servicios / Software (tablas) ───────────────────────────────
    var list2=filter?data.filter(function(r){ return JSON.stringify(r).toLowerCase().includes(filter); }):data;

    if(tab==='proc'){
        info.textContent=list2.length+' procesos';
        if(!list2.length){ content.innerHTML='<div style="text-align:center;padding:40px;color:var(--muted);">Sin procesos</div>'; return; }
        content.innerHTML='<table class="tools-table"><thead><tr><th>Proceso</th><th class="num">PID</th><th class="num">CPU (s)</th><th class="num">RAM (MB)</th><th></th></tr></thead><tbody>'+
            list2.map(function(p){
                var cs=p.cpu>10?'color:var(--danger);font-weight:700;':p.cpu>2?'color:var(--warning);':'';
                return '<tr><td style="font-weight:600;">'+escHtml(p.name)+'</td>'+
                    '<td class="num" style="color:var(--muted);">'+p.pid+'</td>'+
                    '<td class="num" style="'+cs+'">'+p.cpu+'</td>'+
                    '<td class="num">'+p.mem+'</td>'+
                    '<td style="text-align:right;"><button class="btn-sm" style="padding:3px 8px;font-size:11px;color:var(--danger);border-color:var(--danger-dim);" onclick="killProcess('+p.pid+',\''+escHtml(p.name)+'\')"><i class="bi bi-x-circle"></i> Terminar</button></td></tr>';
            }).join('')+'</tbody></table>';
    } else if(tab==='svc'){
        info.textContent=list2.length+' servicios';
        if(!list2.length){ content.innerHTML='<div style="text-align:center;padding:40px;color:var(--muted);">Sin servicios</div>'; return; }
        content.innerHTML='<table class="tools-table"><thead><tr><th>Servicio</th><th>Estado</th><th></th></tr></thead><tbody>'+
            list2.map(function(s){
                var run=s.status==='Running',stop=s.status==='Stopped';
                var bc=run?'var(--success)':stop?'var(--danger)':'var(--warning)';
                var badge='<span style="font-size:10px;padding:2px 8px;border-radius:20px;background:'+bc+'22;color:'+bc+';font-weight:700;">'+escHtml(s.status)+'</span>';
                return '<tr><td><div style="font-weight:600;font-size:12.5px;">'+escHtml(s.display||s.name)+'</div><div style="font-size:10px;color:var(--muted);font-family:monospace;">'+escHtml(s.name)+'</div></td>'+
                    '<td>'+badge+'</td>'+
                    '<td style="text-align:right;white-space:nowrap;">'+
                    (!run?'<button class="btn-sm" style="padding:3px 8px;font-size:11px;margin-right:3px;" title="Iniciar" onclick="serviceAction(\''+escHtml(s.name)+'\',\'start\')"><i class="bi bi-play-fill" style="color:var(--success);"></i></button>':'')+
                    (run?'<button class="btn-sm" style="padding:3px 8px;font-size:11px;margin-right:3px;" title="Detener" onclick="serviceAction(\''+escHtml(s.name)+'\',\'stop\')"><i class="bi bi-stop-fill" style="color:var(--danger);"></i></button>':'')+
                    '<button class="btn-sm" style="padding:3px 8px;font-size:11px;" title="Reiniciar" onclick="serviceAction(\''+escHtml(s.name)+'\',\'restart\')"><i class="bi bi-arrow-repeat"></i></button>'+
                    '</td></tr>';
            }).join('')+'</tbody></table>';
    } else if(tab==='tasks'){
        info.textContent=list2.length+' tareas';
        if(!list2.length){ content.innerHTML='<div style="text-align:center;padding:40px;color:var(--muted);">Sin tareas encontradas</div>'; return; }
        var stateColor={'Ready':'var(--success)','Running':'var(--primary)','Disabled':'var(--muted)','Queued':'var(--warning)'};
        content.innerHTML='<table class="tools-table"><thead><tr><th>Tarea</th><th>Estado</th><th>Última ejecución</th><th>Próxima</th><th></th></tr></thead><tbody>'+
            list2.map(function(t){
                var sc=stateColor[t.state]||'var(--muted)';
                var badge='<span style="font-size:10px;padding:2px 8px;border-radius:20px;background:'+sc+'22;color:'+sc+';font-weight:700;">'+escHtml(t.state||'')+'</span>';
                var runBtn=t.state!=='Disabled'?'<button class="btn-sm" style="padding:3px 8px;font-size:11px;" title="Ejecutar ahora" onclick="taskRun(\''+escHtml(t.name)+'\')"><i class="bi bi-play-fill" style="color:var(--success);"></i></button>':'';
                return '<tr><td><div style="font-weight:600;font-size:12.5px;">'+escHtml(t.name||'')+'</div>'+
                    '<div style="font-size:10px;color:var(--muted);font-family:monospace;">'+escHtml(t.path||'')+'</div></td>'+
                    '<td>'+badge+'</td>'+
                    '<td style="font-size:11px;color:var(--muted);white-space:nowrap;">'+escHtml(t.lastRun||'—')+'</td>'+
                    '<td style="font-size:11px;color:var(--muted);white-space:nowrap;">'+escHtml(t.nextRun||'—')+'</td>'+
                    '<td style="text-align:right;">'+runBtn+'</td></tr>';
            }).join('')+'</tbody></table>';
    } else if(tab==='users'){
        info.textContent=list2.length+' usuarios';
        if(!list2.length){ content.innerHTML='<div style="text-align:center;padding:40px;color:var(--muted);">Sin usuarios encontrados</div>'; return; }
        content.innerHTML='<table class="tools-table"><thead><tr><th>Usuario</th><th>Estado</th><th>Último inicio</th><th></th></tr></thead><tbody>'+
            list2.map(function(u){
                var ec=u.enabled?'var(--success)':'var(--muted)';
                var badge='<span style="font-size:10px;padding:2px 8px;border-radius:20px;background:'+ec+'22;color:'+ec+';font-weight:700;">'+(u.enabled?'Habilitado':'Deshabilitado')+'</span>';
                var action=u.enabled?'disable':'enable';
                var actionLbl=u.enabled?'Deshabilitar':'Habilitar';
                var actionColor=u.enabled?'var(--danger)':'var(--success)';
                return '<tr><td><div style="font-weight:600;font-size:12.5px;">'+escHtml(u.name||'')+'</div>'+
                    (u.full?'<div style="font-size:10px;color:var(--muted);">'+escHtml(u.full)+'</div>':'')+
                    (u.desc?'<div style="font-size:10px;color:var(--muted);">'+escHtml(u.desc)+'</div>':'')+
                    '</td><td>'+badge+'</td>'+
                    '<td style="font-size:11px;color:var(--muted);white-space:nowrap;">'+escHtml(u.lastLogon||'—')+'</td>'+
                    '<td style="text-align:right;"><button class="btn-sm" style="padding:3px 8px;font-size:11px;color:'+actionColor+';border-color:'+actionColor+'44;" onclick="userAction(\''+escHtml(u.name)+'\',\''+action+'\')">'+actionLbl+'</button></td></tr>';
            }).join('')+'</tbody></table>';
    } else if(tab==='net'){
        var net=data;
        if(!net||net.error){ content.innerHTML='<div style="text-align:center;padding:40px;color:var(--danger);">'+(net&&net.error?escHtml(net.error):'Sin datos')+'</div>'; return; }
        var ips=Array.isArray(net.ips)?net.ips:[];
        var gws=Array.isArray(net.gateways)?net.gateways:[];
        var dnss=Array.isArray(net.dns)?net.dns:[];
        var ads=Array.isArray(net.adapters)?net.adapters:[];
        var rows=ips.map(function(ip){
            var gw=(gws.find(function(g){return g.iface===ip.iface;})||{}).gw||'—';
            var dns=(dnss.find(function(d){return d.iface===ip.iface;})||{}).servers||'—';
            var ad=(ads.find(function(a){return a.name===ip.iface;})||{});
            return '<tr>'+
                '<td style="font-weight:600;">'+escHtml(ip.iface||'')+'</td>'+
                '<td style="font-family:monospace;font-size:12px;">'+escHtml(ip.ip||'')+'<span style="color:var(--muted);">/'+ip.prefix+'</span></td>'+
                '<td style="font-family:monospace;font-size:12px;">'+escHtml(gw)+'</td>'+
                '<td style="font-size:11px;color:var(--muted);">'+escHtml(dns)+'</td>'+
                '<td style="font-size:11px;color:var(--muted);">'+escHtml(ad.mac||'')+'</td>'+
                '<td style="font-size:11px;color:var(--muted);">'+escHtml(ad.speed||'')+'</td></tr>';
        });
        info.textContent=ips.length+' interfaz(ces)';
        content.innerHTML='<table class="tools-table"><thead><tr><th>Interfaz</th><th>IP</th><th>Gateway</th><th>DNS</th><th>MAC</th><th>Velocidad</th></tr></thead><tbody>'+(rows.length?rows.join(''):'<tr><td colspan="6" style="text-align:center;color:var(--muted);">Sin interfaces activas</td></tr>')+'</tbody></table>';
    } else {
        info.textContent=list2.length+' aplicaciones';
        if(!list2.length){ content.innerHTML='<div style="text-align:center;padding:40px;color:var(--muted);">Sin software encontrado</div>'; return; }
        content.innerHTML='<table class="tools-table"><thead><tr><th>Aplicación</th><th>Versión</th><th>Publisher</th><th>Fecha</th></tr></thead><tbody>'+
            list2.map(function(a){
                return '<tr><td style="font-weight:600;">'+escHtml(a.name||'')+'</td>'+
                    '<td style="font-size:11px;font-family:monospace;color:var(--muted);">'+escHtml(a.version||'—')+'</td>'+
                    '<td style="font-size:11px;color:var(--muted);">'+escHtml(a.publisher||'—')+'</td>'+
                    '<td style="font-size:11px;color:var(--muted);">'+escHtml(a.date||'—')+'</td></tr>';
            }).join('')+'</tbody></table>';
    }
}

function killProcess(pid, name){
    if(!confirm('¿Terminar proceso "'+name+'" (PID '+pid+')?')) return;
    fetch('/api/rmm/device/process/kill',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nodeId:_toolsNodeId,pid:pid})})
    .then(function(r){ return r.json(); }).then(function(d){
        if(d.ok){ _toolsData['proc']=null; toolsLoad('proc'); termLine('t-ok','✔ Proceso '+name+' (PID '+pid+') terminado'); }
        else alert('Error: '+(d.error||'desconocido'));
    }).catch(function(e){ alert('Error: '+e.message); });
}

function serviceAction(name, action){
    var labels={start:'iniciado',stop:'detenido',restart:'reiniciado'};
    fetch('/api/rmm/device/service/action',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nodeId:_toolsNodeId,name:name,action:action})})
    .then(function(r){ return r.json(); }).then(function(d){
        if(d.ok){ termLine('t-ok','✔ Servicio '+name+' '+labels[action]); setTimeout(function(){ _toolsData['svc']=null; toolsLoad('svc'); },1500); }
        else alert('Error: '+(d.error||'desconocido'));
    }).catch(function(e){ alert('Error: '+e.message); });
}

function taskRun(name){
    if(!confirm('¿Ejecutar tarea "'+name+'" ahora?')) return;
    fetch('/api/rmm/device/task/run',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nodeId:_toolsNodeId,name:name})})
    .then(function(r){ return r.json(); }).then(function(d){
        if(d.ok){ alert('✔ Tarea "'+name+'" iniciada'); _toolsData['tasks']=null; toolsLoad('tasks'); }
        else alert('Error: '+(d.error||'desconocido'));
    }).catch(function(e){ alert('Error: '+e.message); });
}

function userAction(name, action){
    var lbl=action==='enable'?'habilitar':'deshabilitar';
    if(!confirm('¿'+lbl[0].toUpperCase()+lbl.slice(1)+' usuario "'+name+'"?')) return;
    fetch('/api/rmm/device/user/action',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nodeId:_toolsNodeId,name:name,action:action})})
    .then(function(r){ return r.json(); }).then(function(d){
        if(d.ok){ _toolsData['users']=null; toolsLoad('users'); }
        else alert('Error: '+(d.error||'desconocido'));
    }).catch(function(e){ alert('Error: '+e.message); });
}

function ctxOpenTerminal(){
    hideCtxMenu();
    if(!_ctxNodeId) return;
    fetch('/api/rmm/session',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nodeId:_ctxNodeId,viewmode:1})})
    .then(function(r){ return r.json(); }).then(function(d){
        if(d.ok && d.url) window.open(d.url,'_blank','noopener,noreferrer');
        else alert('Error al abrir terminal: '+(d.error||'desconocido'));
    }).catch(function(e){ alert('Error: '+e.message); });
}

// ── Toast notification modal ────────────────────────────────────────────────────
var _toastNodeId=null, _toastName=null;

function openToastModal(nodeId, name){
    _toastNodeId=nodeId; _toastName=name;
    document.getElementById('toastDeviceName').textContent=name;
    document.getElementById('toastTitle').value='';
    document.getElementById('toastMessage').value='';
    document.getElementById('toastModal').classList.add('show');
    setTimeout(function(){ document.getElementById('toastMessage').focus(); },120);
}

function closeToastModal(){ document.getElementById('toastModal').classList.remove('show'); _toastNodeId=null; _toastName=null; }

function confirmToast(){
    var msg   = document.getElementById('toastMessage').value.trim();
    var title = document.getElementById('toastTitle').value.trim()||'Aviso del administrador';
    if(!msg){ alert('El mensaje no puede estar vacío'); return; }
    if(!_toastNodeId) return;
    var name=_toastName;
    fetch('/api/rmm/device/toast',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nodeId:_toastNodeId,title:title,message:msg})})
    .then(function(r){ return r.json(); }).then(function(d){
        closeToastModal();
        if(d.ok) termLine('t-ok','✔ Notificación enviada a '+name);
        else alert('Error: '+(d.error||'desconocido'));
    }).catch(function(e){ alert('Error de red: '+e.message); });
}

// Close dropdowns on outside click
document.addEventListener('click', function(e){
    if(!e.target.closest('#devicePickerWrap')) hideDeviceDropdown();
    if(!e.target.closest('#colModal') && !e.target.closest('[onclick*="openAddCollection"]')) {
        // managed by show/hide
    }
});

// ── Grupos multi-tenant ────────────────────────────────────────────────────────
var _groupsMeshes  = [];
var _groupsTenants = [];
var _groupsList    = [];

function openGroupsModal() {
    document.getElementById('groupsModal').style.display = 'flex';
    Promise.all([
        fetch('/api/rmm/meshes').then(r => r.json()),
        fetch('/api/rmm/tenant-groups').then(r => r.json()),
        fetch('/api/admin/tenants').then(r => r.json()).catch(() => ({ ok: false, data: [] })),
    ]).then(function(results) {
        // Meshes
        _groupsMeshes = results[0].ok ? (results[0].meshes || []) : [];
        var meshSel = document.getElementById('grpMeshSel');
        meshSel.innerHTML = '<option value="">Seleccionar grupo…</option>'
            + _groupsMeshes.map(function(m) {
                return '<option value="' + escHtml(m.meshId) + '">' + escHtml(m.meshId.slice(0,20)) + ' (' + m.deviceCount + ' dispositivos)</option>';
            }).join('');

        // Grupos asignados
        _groupsList = results[1].ok ? (results[1].groups || []) : [];

        // Tenants — intentar vía /api/admin/tenants primero, luego fallback
        var tenantData = results[2];
        _groupsTenants = Array.isArray(tenantData?.data) ? tenantData.data
                       : Array.isArray(tenantData?.tenants) ? tenantData.tenants : [];
        var tenantSel = document.getElementById('grpTenantSel');
        tenantSel.innerHTML = '<option value="">Seleccionar tenant…</option>'
            + _groupsTenants.map(function(t) {
                return '<option value="' + t.id + '">' + escHtml(t.name || t.slug || String(t.id)) + '</option>';
            }).join('');

        renderGroupsTable();
    }).catch(function(e) {
        document.getElementById('grpTableBody').innerHTML =
            '<tr><td colspan="4" style="text-align:center;padding:20px;color:var(--danger);">Error: ' + e.message + '</td></tr>';
    });
}

function closeGroupsModal() {
    document.getElementById('groupsModal').style.display = 'none';
}

function renderGroupsTable() {
    if (!_groupsList.length) {
        document.getElementById('grpTableBody').innerHTML =
            '<tr><td colspan="4" style="text-align:center;padding:24px;color:var(--muted);font-size:13px;">Sin asignaciones. Agrega grupos para segmentar por tenant.</td></tr>';
        return;
    }
    // Enriquecer con deviceCount desde _groupsMeshes
    var meshMap = {};
    _groupsMeshes.forEach(function(m) { meshMap[m.meshId] = m.deviceCount; });

    document.getElementById('grpTableBody').innerHTML = _groupsList.map(function(g) {
        var devCount = meshMap[g.mesh_id] !== undefined ? meshMap[g.mesh_id] + ' dispositivos' : '—';
        var tenantName = g.tenant_name || ('Tenant #' + g.tenant_id);
        return '<tr>'
            + '<td style="padding:10px 14px;font-size:13px;font-weight:600;">' + escHtml(tenantName) + '</td>'
            + '<td style="padding:10px 14px;font-size:12px;font-family:monospace;color:var(--primary);">' + escHtml(g.mesh_name || g.mesh_id) + '</td>'
            + '<td style="padding:10px 14px;font-size:12px;color:var(--muted);">' + devCount + '</td>'
            + '<td style="padding:10px 14px;text-align:right;"><button onclick="removeTenantGroup(' + g.id + ')" style="background:var(--danger-dim);color:var(--danger);border:none;border-radius:7px;padding:4px 12px;cursor:pointer;font-size:12px;font-weight:600;"><i class="bi bi-trash"></i></button></td>'
            + '</tr>';
    }).join('');
}

function addTenantGroup() {
    var tenantId = document.getElementById('grpTenantSel').value;
    var meshId   = document.getElementById('grpMeshSel').value;
    if (!tenantId || !meshId) { alert('Selecciona tenant y grupo.'); return; }
    var meshObj  = _groupsMeshes.find(function(m) { return m.meshId === meshId; });
    fetch('/api/rmm/tenant-groups', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tenant_id: parseInt(tenantId), mesh_id: meshId, mesh_name: meshObj ? meshObj.meshId : meshId }),
    }).then(r => r.json()).then(function(d) {
        if (!d.ok) { alert('Error: ' + d.error); return; }
        fetch('/api/rmm/tenant-groups').then(r => r.json()).then(function(r2) {
            _groupsList = r2.ok ? (r2.groups || []) : [];
            renderGroupsTable();
        });
    });
}

function removeTenantGroup(id) {
    if (!confirm('¿Eliminar esta asignación?')) return;
    fetch('/api/rmm/tenant-groups/' + id, { method: 'DELETE' })
        .then(r => r.json()).then(function(d) {
            if (!d.ok) { alert('Error: ' + d.error); return; }
            _groupsList = _groupsList.filter(function(g) { return g.id !== id; });
            renderGroupsTable();
        });
}
</script>
</body>
</html>
