<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<script>(function(){var t=localStorage.getItem('dashboardTheme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>RMM · Gestión Remota</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<style>
:root,[data-theme="light"]{
  --bg:#f1f5f9;--surface:#fff;--sidebar:#ffffff;--border:#e2e8f0;
  --text:#0f172a;--muted:#64748b;--primary:#2563eb;--primary-dim:#dbeafe;
  --success:#059669;--success-dim:#d1fae5;--danger:#dc2626;--danger-dim:#fee2e2;
  --warning:#d97706;--warning-dim:#fef3c7;--purple:#7c3aed;--purple-dim:#ede9fe;
  --info:#0891b2;--info-dim:#cffafe;
  --term-bg:#0d1117;--term-text:#e6edf3;--term-prompt:#58a6ff;--term-success:#3fb950;--term-err:#f85149;--term-warn:#d29922;
  --sh:0 1px 3px rgba(0,0,0,.06),0 4px 12px rgba(0,0,0,.04);
  --sh-md:0 4px 16px rgba(0,0,0,.1);
  --hdr:#f8fafc;
}
[data-theme="dark"]{
  --bg:#080d1c;--surface:#111827;--sidebar:#0f1629;--border:#1e293b;
  --text:#f1f5f9;--muted:#94a3b8;--primary:#3b82f6;--primary-dim:#1e3a5f;
  --success:#10b981;--success-dim:#064e3b;--danger:#ef4444;--danger-dim:#450a0a;
  --warning:#f59e0b;--warning-dim:#451a03;--purple:#8b5cf6;--purple-dim:#2e1065;
  --info:#06b6d4;--info-dim:#083344;
  --term-bg:#010409;--term-text:#e6edf3;
  --sh:0 1px 3px rgba(0,0,0,.3);--sh-md:0 4px 16px rgba(0,0,0,.4);
  --hdr:#141d2f;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased;height:100vh;overflow:hidden;display:flex;flex-direction:column;}

/* ── Top bar ── */
.topbar{height:52px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;padding:0 20px;flex-shrink:0;box-shadow:var(--sh);}
.topbar-logo{display:flex;align-items:center;gap:10px;}
.topbar-logo-icon{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,#1e40af,#7c3aed);display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px;}
.topbar-logo-text{font-size:14px;font-weight:800;letter-spacing:-.3px;}
.topbar-logo-text span{color:var(--primary);}
.topbar-sep{width:1px;height:24px;background:var(--border);margin:0 4px;}
.topbar-title{font-size:13px;color:var(--muted);font-weight:500;}
.topbar-actions{margin-left:auto;display:flex;align-items:center;gap:8px;}
.btn-icon{width:34px;height:34px;border:1px solid var(--border);background:transparent;border-radius:8px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--muted);transition:all .15s;font-size:16px;}
.btn-icon:hover{background:var(--primary-dim);color:var(--primary);border-color:var(--primary);}
.device-status{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;padding:4px 10px;border-radius:20px;background:var(--hdr);border:1px solid var(--border);}
.status-dot{width:7px;height:7px;border-radius:50%;}
.dot-ok{background:#10b981;box-shadow:0 0 0 3px rgba(16,185,129,.2);}
.dot-none{background:var(--muted);}

/* ── Layout ── */
.workspace{display:flex;flex:1;overflow:hidden;}

/* ── Sidebar ── */
.sidebar{width:290px;background:var(--sidebar);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;overflow:hidden;}
.sidebar-head{padding:14px 16px 10px;border-bottom:1px solid var(--border);flex-shrink:0;}
.sidebar-head-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.sidebar-head-title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);}
.search-box{position:relative;}
.search-box input{width:100%;padding:6px 10px 6px 30px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text);font-size:12px;outline:none;transition:border-color .15s;}
.search-box input:focus{border-color:var(--primary);}
.search-box .si{position:absolute;left:9px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:13px;pointer-events:none;}
.sidebar-body{flex:1;overflow-y:auto;padding:8px 8px 4px;}
.sidebar-body::-webkit-scrollbar{width:4px;}
.sidebar-body::-webkit-scrollbar-track{background:transparent;}
.sidebar-body::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px;}

/* Collections */
.col-item{margin-bottom:4px;border-radius:10px;overflow:hidden;border:1px solid transparent;}
.col-item.open{border-color:var(--border);}
.col-header{display:flex;align-items:center;gap:8px;padding:8px 10px;cursor:pointer;border-radius:8px;transition:background .12s;user-select:none;}
.col-header:hover{background:var(--hdr);}
.col-icon{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;}
.col-name{flex:1;font-size:13px;font-weight:600;}
.col-count{font-size:11px;color:var(--muted);background:var(--hdr);border:1px solid var(--border);padding:1px 7px;border-radius:20px;font-weight:600;}
.col-chevron{font-size:12px;color:var(--muted);transition:transform .2s;}
.col-item.open .col-chevron{transform:rotate(90deg);}
.col-scripts{display:none;padding:4px 4px 6px 12px;}
.col-item.open .col-scripts{display:block;}

/* Script items */
.script-item{display:flex;align-items:center;gap:8px;padding:7px 8px;border-radius:8px;cursor:pointer;transition:background .12s;position:relative;}
.script-item:hover{background:var(--hdr);}
.script-item.selected{background:var(--primary-dim);color:var(--primary);}
.script-item-name{flex:1;font-size:12.5px;font-weight:500;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.script-item-actions{display:none;gap:3px;flex-shrink:0;}
.script-item:hover .script-item-actions{display:flex;}
.act-btn{width:22px;height:22px;border:none;border-radius:5px;background:transparent;cursor:pointer;color:var(--muted);font-size:12px;display:flex;align-items:center;justify-content:center;transition:all .1s;}
.act-btn:hover{background:var(--border);color:var(--text);}
.act-btn.run:hover{background:var(--success-dim);color:var(--success);}
.act-btn.del:hover{background:var(--danger-dim);color:var(--danger);}

.sidebar-footer{padding:10px 8px;border-top:1px solid var(--border);flex-shrink:0;}
.btn-add-col{width:100%;display:flex;align-items:center;justify-content:center;gap:6px;padding:8px;border:1px dashed var(--border);border-radius:9px;background:transparent;cursor:pointer;color:var(--muted);font-size:12px;font-weight:600;transition:all .15s;}
.btn-add-col:hover{border-color:var(--primary);color:var(--primary);background:var(--primary-dim);}

/* ── Main panel ── */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;}

/* Device bar */
.device-bar{padding:12px 16px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;flex-shrink:0;}
.device-selector{position:relative;flex:1;max-width:360px;}
.device-selector input{width:100%;padding:8px 12px 8px 34px;border:1.5px solid var(--border);border-radius:10px;background:var(--bg);color:var(--text);font-size:13px;outline:none;transition:border-color .15s;}
.device-selector input:focus{border-color:var(--primary);}
.device-selector .si{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:14px;pointer-events:none;}
.device-dropdown{position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--surface);border:1px solid var(--border);border-radius:10px;box-shadow:var(--sh-md);max-height:240px;overflow-y:auto;z-index:200;display:none;}
.device-dropdown.show{display:block;}
.device-opt{padding:8px 12px;cursor:pointer;font-size:13px;display:flex;align-items:center;gap:8px;transition:background .1s;}
.device-opt:hover{background:var(--hdr);}
.device-opt-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.device-opt-name{font-weight:600;flex:1;}
.device-opt-os{font-size:11px;color:var(--muted);}
.selected-device-chip{display:flex;align-items:center;gap:6px;padding:6px 12px;background:var(--primary-dim);border:1px solid var(--primary);border-radius:20px;font-size:12px;font-weight:700;color:var(--primary);white-space:nowrap;}
.selected-device-chip .close-chip{cursor:pointer;font-size:14px;opacity:.6;}
.selected-device-chip .close-chip:hover{opacity:1;}
.btn-run{display:flex;align-items:center;gap:6px;padding:8px 18px;border:none;border-radius:10px;background:var(--primary);color:#fff;font-size:13px;font-weight:700;cursor:pointer;transition:all .15s;white-space:nowrap;}
.btn-run:hover:not(:disabled){background:#1d4ed8;transform:translateY(-1px);box-shadow:0 4px 12px rgba(37,99,235,.3);}
.btn-run:disabled{opacity:.5;cursor:not-allowed;transform:none;}
.btn-run.running{background:var(--warning);}
.btn-sm{display:flex;align-items:center;gap:5px;padding:7px 13px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--muted);font-size:12px;font-weight:600;cursor:pointer;transition:all .15s;}
.btn-sm:hover{background:var(--hdr);color:var(--text);}

/* Script info bar */
.script-bar{padding:8px 16px;background:var(--hdr);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;flex-shrink:0;min-height:38px;}
.script-bar-name{font-size:13px;font-weight:700;}
.script-bar-desc{font-size:12px;color:var(--muted);}
.script-bar-empty{font-size:12px;color:var(--muted);font-style:italic;}

/* Terminal */
.terminal-wrap{flex:1;overflow:hidden;display:flex;flex-direction:column;background:var(--term-bg);}
.terminal{flex:1;overflow-y:auto;padding:16px 20px;font-family:'JetBrains Mono','Cascadia Code','Fira Code',monospace;font-size:13px;line-height:1.7;white-space:pre-wrap;word-break:break-all;}
.terminal::-webkit-scrollbar{width:5px;}
.terminal::-webkit-scrollbar-track{background:transparent;}
.terminal::-webkit-scrollbar-thumb{background:#30363d;border-radius:4px;}
.t-prompt{color:var(--term-prompt);font-weight:700;}
.t-info{color:#8b949e;}
.t-ok{color:var(--term-success);}
.t-err{color:var(--term-err);}
.t-warn{color:var(--term-warn);}
.t-out{color:var(--term-text);}
.t-spin{display:inline-block;animation:spin .8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.t-separator{border:none;border-top:1px solid #21262d;margin:8px 0;}

/* Status bar */
.status-bar{height:26px;background:#161b22;display:flex;align-items:center;gap:16px;padding:0 16px;flex-shrink:0;border-top:1px solid #21262d;}
.sb-item{display:flex;align-items:center;gap:5px;font-size:11px;color:#8b949e;font-family:monospace;}
.sb-item i{font-size:12px;}
.sb-sep{width:1px;height:12px;background:#21262d;}

/* ── Right panel (script editor) ── */
.right-panel{width:380px;background:var(--surface);border-left:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;overflow:hidden;}
.rp-head{padding:12px 16px 10px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.rp-title{font-size:13px;font-weight:700;}
.rp-body{flex:1;overflow-y:auto;padding:14px 16px;display:flex;flex-direction:column;gap:12px;}
.form-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-bottom:4px;display:block;}
.form-input{width:100%;padding:8px 11px;border:1.5px solid var(--border);border-radius:9px;background:var(--bg);color:var(--text);font-size:13px;outline:none;transition:border-color .15s;}
.form-input:focus{border-color:var(--primary);}
.form-select{width:100%;padding:8px 11px;border:1.5px solid var(--border);border-radius:9px;background:var(--bg);color:var(--text);font-size:13px;outline:none;cursor:pointer;}
.form-select:focus{border-color:var(--primary);}
textarea.form-input{resize:vertical;font-family:'JetBrains Mono','Cascadia Code',monospace;font-size:12px;min-height:200px;}
.rp-foot{padding:12px 16px;border-top:1px solid var(--border);display:flex;gap:8px;flex-shrink:0;}
.btn-primary{flex:1;padding:9px;border:none;border-radius:9px;background:var(--primary);color:#fff;font-size:13px;font-weight:700;cursor:pointer;transition:all .15s;}
.btn-primary:hover{background:#1d4ed8;}
.btn-secondary{flex:1;padding:9px;border:1.5px solid var(--border);border-radius:9px;background:transparent;color:var(--text);font-size:13px;font-weight:600;cursor:pointer;transition:all .15s;}
.btn-secondary:hover{background:var(--hdr);}
.right-panel.hidden{display:none;}

/* ── Custom cmd bar ── */
.custom-bar{padding:8px 12px;border-top:1px solid #21262d;background:#0d1117;display:flex;gap:8px;flex-shrink:0;}
.custom-bar input{flex:1;padding:6px 10px 6px 28px;background:#161b22;border:1px solid #30363d;border-radius:8px;color:#e6edf3;font-family:monospace;font-size:12px;outline:none;}
.custom-bar input:focus{border-color:var(--primary);}
.custom-bar-icon{position:absolute;left:22px;top:50%;transform:translateY(-50%);color:#58a6ff;font-size:12px;pointer-events:none;}
.custom-bar-wrap{position:relative;flex:1;}
.btn-run-cmd{padding:6px 14px;border:none;border-radius:8px;background:#1f6feb;color:#fff;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;}
.btn-run-cmd:disabled{opacity:.5;cursor:not-allowed;}

/* ── Modal ── */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);backdrop-filter:blur(3px);z-index:1000;display:none;align-items:center;justify-content:center;}
.modal-overlay.show{display:flex;}
.modal-box{background:var(--surface);border:1px solid var(--border);border-radius:16px;width:520px;max-width:95vw;box-shadow:var(--sh-md);animation:modalIn .2s ease;}
@keyframes modalIn{from{opacity:0;transform:scale(.95)}to{opacity:1;transform:scale(1)}}
.modal-head{padding:18px 20px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
.modal-title{font-size:15px;font-weight:700;}
.modal-close{width:28px;height:28px;border:none;background:transparent;cursor:pointer;color:var(--muted);font-size:18px;display:flex;align-items:center;justify-content:center;border-radius:6px;}
.modal-close:hover{background:var(--border);color:var(--text);}
.modal-body{padding:20px;display:flex;flex-direction:column;gap:14px;}
.modal-foot{padding:14px 20px;border-top:1px solid var(--border);display:flex;gap:10px;justify-content:flex-end;}
.f-group{display:flex;flex-direction:column;gap:4px;}

/* Collection color dots */
.cdot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}

/* ── Mode toggle ── */
.mode-toggle{display:flex;align-items:center;background:var(--hdr);border:1px solid var(--border);border-radius:9px;padding:3px;gap:2px;margin-right:4px;}
.mode-btn{padding:5px 11px;border:none;border-radius:7px;background:transparent;color:var(--muted);font-size:12px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:5px;transition:all .15s;white-space:nowrap;}
.mode-btn.active{background:var(--surface);color:var(--primary);box-shadow:0 1px 3px rgba(0,0,0,.1);}
.mode-btn:hover:not(.active){color:var(--text);}

/* ── Devices panel ── */
#devicesPanel{flex:1;overflow-y:auto;padding:20px;background:var(--bg);}
.devices-toolbar{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap;}
.devices-toolbar h2{font-size:14px;font-weight:700;flex:1;margin:0;}
.grid-search-wrap{position:relative;}
.grid-search-wrap i{position:absolute;left:9px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:12px;pointer-events:none;}
.grid-search{padding:7px 11px 7px 28px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text);font-size:12px;outline:none;width:190px;}
.grid-search:focus{border-color:var(--primary);}
.device-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;}
.dcard{background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden;transition:border-color .15s,box-shadow .15s;user-select:none;}
.dcard:hover{border-color:var(--primary);box-shadow:var(--sh);}
.dcard-bar{height:3px;width:100%;}
.dcard-body{padding:12px;}
.dcard-name{font-size:13px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.dcard-sub{font-size:11px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.dcard-meta{display:flex;align-items:center;gap:6px;margin-top:10px;}
.dcard-status{display:flex;align-items:center;gap:5px;font-size:11px;font-weight:600;flex:1;}
.dcard-actions{display:flex;gap:3px;}
.dcard-btn{width:24px;height:24px;border:1px solid var(--border);border-radius:5px;background:transparent;cursor:pointer;color:var(--muted);font-size:11px;display:flex;align-items:center;justify-content:center;transition:all .1s;}
.dcard-btn:hover{background:var(--primary-dim);color:var(--primary);border-color:var(--primary);}
.dcard-btn.off:hover{background:var(--danger-dim);color:var(--danger);border-color:var(--danger);}

/* ── Context menu ── */
.ctx-menu{position:fixed;z-index:9999;background:var(--surface);border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.2);min-width:200px;overflow:hidden;animation:ctxIn .1s ease;}
@keyframes ctxIn{from{opacity:0;transform:scale(.97)}to{opacity:1;transform:scale(1)}}
.ctx-group{font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);padding:7px 12px 2px;}
.ctx-item{padding:8px 12px;font-size:12.5px;display:flex;align-items:center;gap:9px;cursor:pointer;color:var(--text);transition:background .1s;}
.ctx-item:hover{background:var(--hdr);}
.ctx-item i{font-size:13px;color:var(--muted);width:14px;text-align:center;}
.ctx-item.danger{color:var(--danger);}
.ctx-item.danger i{color:var(--danger);}
.ctx-item.ctx-disabled{opacity:.4;pointer-events:none;}
.ctx-sep{height:1px;background:var(--border);margin:3px 0;}

/* ── Tools modal tabs ── */
.tools-tab{padding:9px 14px;border:none;background:transparent;color:var(--muted);font-size:12.5px;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;display:inline-flex;align-items:center;gap:6px;transition:all .15s;}
.tools-tab.active{color:var(--primary);border-bottom-color:var(--primary);}
.tools-tab:hover:not(.active){color:var(--text);}
/* ── Metric bars ── */
.metric-wrap{padding:20px 24px;}
.metric-item{margin-bottom:18px;}
.metric-label{display:flex;justify-content:space-between;font-size:12px;font-weight:600;margin-bottom:5px;}
.metric-label-val{font-variant-numeric:tabular-nums;}
.metric-bar{height:10px;border-radius:5px;background:var(--surface2);overflow:hidden;}
.metric-fill{height:100%;border-radius:5px;transition:width .6s ease;}
/* ── Event log ── */
.evt-filter-bar{display:flex;align-items:center;gap:6px;padding:8px 12px;border-bottom:1px solid var(--border);flex-shrink:0;}
.evt-filter-btn{padding:3px 10px;font-size:11px;font-weight:700;border-radius:20px;border:1px solid var(--border);background:transparent;cursor:pointer;color:var(--muted);transition:all .12s;}
.evt-filter-btn.active,.evt-filter-btn:hover{border-color:currentColor;}
/* ── Tools table ── */
.tools-table{width:100%;border-collapse:collapse;font-size:12.5px;}
.tools-table th{padding:8px 12px;text-align:left;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--surface);z-index:1;}
.tools-table td{padding:6px 12px;border-bottom:1px solid var(--border);vertical-align:middle;}
.tools-table tr:last-child td{border-bottom:none;}
.tools-table tr:hover td{background:var(--hdr);}
.tools-table .num{font-family:monospace;font-variant-numeric:tabular-nums;text-align:right;}
/* Responsive hide right panel */
@media(max-width:1200px){.right-panel{display:none;}.right-panel.forced{display:flex;position:fixed;right:0;top:52px;bottom:0;z-index:50;box-shadow:var(--sh-md);}}
</style>
</head>
<body>

<!-- TOP BAR -->
<div class="topbar">
  <div class="topbar-logo">
    <div class="topbar-logo-icon"><i class="bi bi-terminal-fill"></i></div>
    <div class="topbar-logo-text">RMM<span> · GESTIÓN REMOTA</span></div>
  </div>
  <div class="topbar-sep"></div>
  <div class="topbar-title">Script Library & Remote Execution</div>
  <div class="topbar-actions">
    <div class="mode-toggle">
      <button id="btnModeTerminal" class="mode-btn active" onclick="setMode('terminal')"><i class="bi bi-terminal-fill"></i> Scripts</button>
      <button id="btnModeDevices"  class="mode-btn"        onclick="setMode('devices')"><i class="bi bi-laptop"></i> Dispositivos</button>
    </div>
    <div class="device-status" id="meshStatus">
      <div class="status-dot dot-none" id="meshDot"></div>
      <span id="meshStatusText">Conectando...</span>
    </div>
