    _set('resAlertsVal',alTotal||0);
    _set('resAlertsSub',(al.critical||0)>0?al.critical+' crítica(s)':'Sin alertas críticas');
    _set('resDeptVal',cmdbSt.empleados??'—');

    // Update donut with real Jira data
    if(typeof drawDashDonut==='function'){
