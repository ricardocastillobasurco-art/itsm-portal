                <i class="bi bi-clipboard2-plus-fill" style="color:#2563eb;font-size:14px;"></i>
                <span class="qa-btn-label">Crear<br>Requerimiento</span>
              </button>
              <button class="qa-btn" onclick="openAdmAsigModal()">
                <i class="bi bi-pc-display-horizontal" style="color:#059669;font-size:14px;"></i>
                <span class="qa-btn-label">Nueva<br>Asignación</span>
              </button>
              <button class="qa-btn" onclick="openModal('admModalColabs')">
                <i class="bi bi-person-plus-fill" style="color:#7c3aed;font-size:14px;"></i>
                <span class="qa-btn-label">Nuevo<br>Colaborador</span>
              </button>
              <button class="qa-btn" onclick="openModal('modalTeams')">
                <i class="bi bi-microsoft-teams" style="color:#6264a7;font-size:14px;"></i>
                <span class="qa-btn-label">Mensaje<br>Teams</span>
              </button>
              <button class="qa-btn" onclick="openModal('modalCorreo')">
                <i class="bi bi-envelope-fill" style="color:#0052cc;font-size:14px;"></i>
                <span class="qa-btn-label">Correo<br>Masivo</span>
              </button>
            </div>
          </div>

        </div><!-- /new-col-tr -->

        <!-- Abajo izq: banner (misma fila que Top técnicos) -->
        <div class="banner-wrapper">
          <div class="promo-banner"<% if (_cfg.branding?.bannerLink) { %> onclick="window.open('<%- _cfg.branding.bannerLink %>','_blank')"<% } %>>
            <img id="bannerImg" src="/images/<%= _cfg.branding?.bannerImage || 'banner-promo.jpg' %>" alt="<%= _tenantName %> — IT Platform" style="width:100%;height:100%;object-fit:cover;object-position:center;">
          </div>
          <label for="bannerFileInput" class="banner-upload-btn" title="Cambiar banner del portal de autogestion">
            <i class="bi bi-camera-fill"></i> Cambiar banner
          </label>
          <input type="file" id="bannerFileInput" accept="image/jpeg,image/png,image/webp" style="display:none;">
        </div>

        <!-- Abajo der: top técnicos -->
        <div class="ch-card">
          <div class="ch-card-title" style="margin-bottom:10px">Top técnicos — hoy</div>
          <div class="tec-li" id="dashTecList">
            <div style="font-size:11px;color:var(--muted);text-align:center;padding:8px 0;">Cargando…</div>
          </div>
        </div>

      </div><!-- /new-main -->


    </div><!-- /panelInicio -->

    <!-- PANEL: CONFIGURACIÓN ITSM -->
    <div class="content-body" id="panelConfig" style="display:none;">
      <div class="sec-label"><i class="bi bi-sliders2-vertical"></i> Configuración ITSM</div>
      <% if (!_jiraEnabled) { %>
      <div style="display:flex;align-items:flex-start;gap:12px;background:#fef3c7;border:1.5px solid #f59e0b;border-radius:10px;padding:14px 18px;margin-bottom:20px;max-width:900px;">
        <i class="bi bi-plug-fill" style="color:#d97706;font-size:20px;flex-shrink:0;margin-top:2px;"></i>
        <div>
          <div style="font-size:13px;font-weight:800;color:#92400e;margin-bottom:4px;">Integración a sistema de tickets no configurada</div>
          <div style="font-size:12px;color:#b45309;line-height:1.5;">Este cliente (<strong><%= _tenantName %></strong>) no tiene una integración con Jira u otro sistema de tickets externo. La configuración de alertas y SLA aplica únicamente al sistema local de tickets (TK-).</div>
        </div>
      </div>
      <% } %>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:900px;">

        <!-- SLA por Prioridad -->
        <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px;">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
            <div style="width:32px;height:32px;background:rgba(37,99,235,.1);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;color:#2563eb;"><i class="bi bi-clock-fill"></i></div>
            <div>
              <div style="font-size:13px;font-weight:800;color:var(--text);">Umbrales SLA</div>
              <div style="font-size:11px;color:var(--muted);">Tiempo máximo de resolución por prioridad</div>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
            <span class="cfg-prio-badge" style="background:#ef444420;color:#ef4444;">P1</span>
            <span style="font-size:12px;color:var(--muted);flex:1;">Crítico</span>
            <input type="number" id="cfg-sla-p1" value="60" min="1" max="10080" class="cfg-input">
            <span style="font-size:11px;color:var(--muted);">min</span>
          </div>
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
            <span class="cfg-prio-badge" style="background:#f9731620;color:#f97316;">P2</span>
            <span style="font-size:12px;color:var(--muted);flex:1;">Alto</span>
            <input type="number" id="cfg-sla-p2" value="240" min="1" max="10080" class="cfg-input">
            <span style="font-size:11px;color:var(--muted);">min</span>
          </div>
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
            <span class="cfg-prio-badge" style="background:#3b82f620;color:#3b82f6;">P3</span>
            <span style="font-size:12px;color:var(--muted);flex:1;">Medio</span>
            <input type="number" id="cfg-sla-p3" value="480" min="1" max="10080" class="cfg-input">
            <span style="font-size:11px;color:var(--muted);">min</span>
          </div>
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
            <span class="cfg-prio-badge" style="background:#6b728020;color:#6b7280;">P4</span>
            <span style="font-size:12px;color:var(--muted);flex:1;">Bajo</span>
            <input type="number" id="cfg-sla-p4" value="1440" min="1" max="10080" class="cfg-input">
            <span style="font-size:11px;color:var(--muted);">min</span>
          </div>
        </div>

        <!-- Alertas y NOC -->
        <div style="display:flex;flex-direction:column;gap:16px;">

          <!-- Ventana de Alertas -->
          <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
              <div style="width:32px;height:32px;background:rgba(239,68,68,.1);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;color:#ef4444;"><i class="bi bi-bell-fill"></i></div>
              <div>
                <div style="font-size:13px;font-weight:800;color:var(--text);">Alertas SLA</div>
                <div style="font-size:11px;color:var(--muted);">Cuándo disparar la alerta preventiva</div>
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
              <span style="font-size:12px;color:var(--muted);flex:1;">Ventana de alerta</span>
              <input type="number" id="cfg-alert-window" value="10" min="1" max="120"
                style="width:70px;border:1.5px solid var(--border);border-radius:8px;padding:5px 8px;font-size:12px;background:var(--bg);color:var(--text);text-align:right;">
              <span style="font-size:11px;color:var(--muted);">min antes</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
              <span style="font-size:12px;color:var(--muted);flex:1;">Notif. navegador en breach</span>
              <label style="position:relative;display:inline-block;width:36px;height:20px;flex-shrink:0;">
                <input type="checkbox" id="cfg-alert-notif" checked style="opacity:0;width:0;height:0;">
                <span onclick="this.previousElementSibling.click()" style="position:absolute;inset:0;background:var(--border);border-radius:10px;cursor:pointer;transition:.3s;" id="cfg-alert-notif-track"></span>
              </label>
            </div>
          </div>

          <!-- NOC -->
          <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
              <div style="width:32px;height:32px;background:rgba(8,145,178,.1);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;color:#0891b2;"><i class="bi bi-display-fill"></i></div>
              <div>
                <div style="font-size:13px;font-weight:800;color:var(--text);">Dashboard NOC</div>
                <div style="font-size:11px;color:var(--muted);">Cola y frecuencia de actualización</div>
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
              <span style="font-size:12px;color:var(--muted);flex:1;">Cola de trabajo</span>
              <select id="cfg-noc-queue" style="border:1.5px solid var(--border);border-radius:8px;padding:5px 8px;font-size:12px;background:var(--bg);color:var(--text);">
                <option value="wp">Workplace</option>
                <option value="all">Todas las colas</option>
              </select>
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
              <span style="font-size:12px;color:var(--muted);flex:1;">Intervalo de refresh</span>
              <input type="number" id="cfg-noc-refresh" value="60" min="15" max="300"
                style="width:70px;border:1.5px solid var(--border);border-radius:8px;padding:5px 8px;font-size:12px;background:var(--bg);color:var(--text);text-align:right;">
              <span style="font-size:11px;color:var(--muted);">seg</span>
            </div>
          </div>
        </div>

        <!-- Correos de Escalación (full width) -->
        <div style="background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px;grid-column:1/-1;">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
            <div style="width:32px;height:32px;background:rgba(217,119,6,.1);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;color:#d97706;"><i class="bi bi-envelope-exclamation-fill"></i></div>
            <div>
              <div style="font-size:13px;font-weight:800;color:var(--text);">Correos de Escalación</div>
              <div style="font-size:11px;color:var(--muted);">Notificar a estos correos cuando un ticket entre en breach de SLA</div>
            </div>
            <label style="display:flex;align-items:center;gap:6px;margin-left:auto;font-size:12px;color:var(--muted);cursor:pointer;">
              <input type="checkbox" id="cfg-esc-enabled">
              Habilitado
            </label>
          </div>
          <input type="text" id="cfg-esc-emails" placeholder="supervisor@empresa.com, gerente@empresa.com"
            style="width:100%;border:1.5px solid var(--border);border-radius:8px;padding:8px 12px;font-size:12px;background:var(--bg);color:var(--text);font-family:inherit;">
          <div style="font-size:10px;color:var(--muted);margin-top:5px;">Separar múltiples correos con comas. La escalación se activa automáticamente cuando se detecta un breach.</div>
        </div>

      </div><!-- /grid -->

      <!-- Acciones -->
      <div style="display:flex;align-items:center;gap:12px;margin-top:20px;max-width:900px;">
        <button onclick="cfgSave()" style="display:flex;align-items:center;gap:7px;padding:9px 22px;background:var(--primary);color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;transition:opacity .2s;" id="cfgSaveBtn">
          <i class="bi bi-floppy-fill"></i> Guardar configuración
        </button>
        <a href="/itsm/noc" target="_blank" style="display:flex;align-items:center;gap:6px;padding:9px 16px;border:1.5px solid var(--border);border-radius:10px;font-size:12px;font-weight:600;color:var(--muted);text-decoration:none;transition:all .18s;">
          <i class="bi bi-display-fill"></i> Abrir NOC TV
        </a>
        <span id="cfgStatus" style="font-size:12px;color:var(--success);display:none;"><i class="bi bi-check-circle-fill"></i> Guardado</span>
      </div>
    </div><!-- /panelConfig -->

  </div><!-- /content-area -->

</div><!-- /app-shell -->

