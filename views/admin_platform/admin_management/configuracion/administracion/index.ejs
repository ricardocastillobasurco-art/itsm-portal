<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<script>(function(){const t=localStorage.getItem('dashboardTheme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Administración · IT Platform</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;0,9..40,900&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<style>
/* ══ VARIABLES ══════════════════════════════════════════════ */
:root,[data-theme="light"]{
  --bg:#f1f5f9;--bg-subtle:#e9eef5;--card:#ffffff;--card-hover:#fafcff;
  --border:#e2e8f0;--border-strong:#cbd5e1;
  --text:#0f172a;--text-2:#1e293b;--muted:#64748b;--muted-2:#94a3b8;
  --primary:#2563eb;--primary-dim:rgba(37,99,235,.1);--primary-glow:rgba(37,99,235,.25);
  --success:#059669;--warning:#d97706;--danger:#dc2626;--purple:#7c3aed;--info:#0891b2;
  --sh-xs:0 1px 2px rgba(0,0,0,.06);
  --sh-sm:0 1px 3px rgba(0,0,0,.08),0 4px 12px rgba(0,0,0,.04);
  --sh-md:0 4px 16px rgba(0,0,0,.1),0 16px 40px rgba(0,0,0,.07);
  --sh-lg:0 8px 30px rgba(0,0,0,.12),0 30px 60px rgba(0,0,0,.1);
  --nav-bg:rgba(255,255,255,.95);
  --radius-sm:8px;--radius:12px;--radius-lg:16px;--radius-xl:20px;
  --sidebar-w:224px;--navbar-h:44px;
  --bg-main:var(--bg);--bg-card:var(--card);--bg-surface:var(--card);
  --border-soft:var(--border);--text-main:var(--text);--text-muted:var(--muted);
  --shadow-card:var(--sh-sm);--sidebar-bg:var(--card);
}
[data-theme="dark"]{
  --bg:#080d1c;--bg-subtle:#0d1425;--card:#111827;--card-hover:#141d2f;
  --border:#1e293b;--border-strong:#2d3f55;
  --text:#f1f5f9;--text-2:#e2e8f0;--muted:#94a3b8;--muted-2:#64748b;
  --primary:#3b82f6;--primary-dim:rgba(59,130,246,.14);--primary-glow:rgba(59,130,246,.2);
  --success:#10b981;--warning:#f59e0b;--danger:#ef4444;--purple:#8b5cf6;--info:#06b6d4;
  --sh-xs:0 1px 2px rgba(0,0,0,.4);
  --sh-sm:0 1px 3px rgba(0,0,0,.4),0 4px 12px rgba(0,0,0,.3);
  --sh-md:0 4px 16px rgba(0,0,0,.4),0 16px 40px rgba(0,0,0,.3);
  --sh-lg:0 8px 30px rgba(0,0,0,.5),0 30px 60px rgba(0,0,0,.4);
  --nav-bg:rgba(8,13,28,.95);
  --bg-main:var(--bg);--bg-card:var(--card);--bg-surface:var(--card);
  --border-soft:var(--border);--text-main:var(--text);--text-muted:var(--muted);
  --shadow-card:var(--sh-sm);--sidebar-bg:var(--bg-subtle);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;overflow:hidden;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',-apple-system,'Segoe UI',sans-serif;font-size:14px;line-height:1.6;-webkit-font-smoothing:antialiased;}
a{text-decoration:none;color:inherit;}
button{font-family:inherit;cursor:pointer;border:none;background:none;}
*::-webkit-scrollbar{width:5px;height:5px;}
*::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:3px;}

/* ══ NAVBAR ═════════════════════════════════════════════════ */
.navbar{
  position:fixed;top:0;left:0;right:0;z-index:500;
  height:var(--navbar-h);display:flex;align-items:center;gap:6px;padding:0 16px;
  background:var(--nav-bg);backdrop-filter:blur(16px) saturate(160%);
  -webkit-backdrop-filter:blur(16px) saturate(160%);
  border-bottom:1px solid var(--border);
}
.nav-hamburger{width:30px;height:30px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--muted);transition:all .15s;cursor:pointer;flex-shrink:0;}
.nav-hamburger:hover{background:var(--bg-subtle);color:var(--text);}
.nav-brand{display:flex;align-items:center;gap:7px;padding:0 8px;}
.nav-logo{height:18px;width:auto;}
.nav-divider{width:1px;height:16px;background:var(--border);}
.nav-name{font-size:12px;font-weight:700;color:var(--text);}
.nav-badge{font-size:8px;font-weight:800;padding:1px 6px;border-radius:20px;background:linear-gradient(135deg,#7c3aed,#e11d48);color:#fff;letter-spacing:.5px;text-transform:uppercase;}
.nav-space{flex:1;}
.nav-icon-btn{width:30px;height:30px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--muted);transition:all .15s;}
.nav-icon-btn:hover{background:var(--bg-subtle);color:var(--text);}
.nav-user{display:flex;align-items:center;gap:5px;padding:3px 8px 3px 4px;border-radius:20px;background:var(--bg-subtle);border:1px solid var(--border);}
.nav-avatar{width:24px;height:24px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,#7c3aed,#e11d48);display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:800;}
.nav-username{font-size:11px;font-weight:600;color:var(--text-2);max-width:90px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.nav-exit{display:flex;align-items:center;gap:4px;padding:5px 10px;border-radius:5px;font-size:11px;font-weight:600;color:var(--muted);transition:all .15s;cursor:pointer;}
.nav-exit:hover{color:var(--danger);background:rgba(220,38,38,.06);}

/* ══ APP SHELL ══════════════════════════════════════════════ */
.app-shell{display:flex;position:fixed;top:var(--navbar-h);left:0;right:0;bottom:0;overflow:hidden;}

/* ══ SIDEBAR ════════════════════════════════════════════════ */
.sidebar{
  width:var(--sidebar-w);flex-shrink:0;background:var(--card);
  border-right:1px solid var(--border);display:flex;flex-direction:column;
  overflow:hidden;transition:width .22s cubic-bezier(.4,0,.2,1);
  position:relative;z-index:200;
}
.sidebar.collapsed{width:52px;}
.sb-header{display:flex;align-items:center;gap:8px;padding:0 12px;height:46px;border-bottom:1px solid var(--border);flex-shrink:0;overflow:hidden;}
.sb-logo{height:16px;width:auto;flex-shrink:0;}
.sb-brand{flex:1;min-width:0;overflow:hidden;}
.sb-brand-name{font-size:12px;font-weight:700;color:var(--text);white-space:nowrap;}
.sb-brand-badge{display:inline-block;font-size:8px;font-weight:800;padding:1px 6px;border-radius:4px;background:linear-gradient(135deg,#7c3aed,#e11d48);color:#fff;text-transform:uppercase;letter-spacing:.4px;margin-top:1px;}
.sidebar.collapsed .sb-brand{display:none;}
.sb-nav{flex:1;overflow-y:auto;overflow-x:hidden;padding:6px 0;}
.sb-nav::-webkit-scrollbar{width:3px;}
.sb-section{margin-bottom:2px;}
.sb-section-label{font-size:9px;font-weight:800;letter-spacing:1.1px;text-transform:uppercase;color:var(--muted-2);padding:10px 14px 3px;white-space:nowrap;overflow:hidden;display:block;}
.sidebar.collapsed .sb-section-label{display:none;}
.sb-item{display:flex;align-items:center;gap:10px;padding:7px 14px;cursor:pointer;font-size:12.5px;font-weight:500;color:var(--muted);transition:all .15s;white-space:nowrap;overflow:hidden;border:none;background:none;width:100%;text-align:left;position:relative;}
.sb-item:hover{background:var(--bg-subtle);color:var(--text);}
.sb-item.active{background:var(--primary-dim);color:var(--primary);font-weight:700;}
.sb-item.active::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--primary);border-radius:0 2px 2px 0;}
.sb-icon{font-size:15px;flex-shrink:0;width:18px;text-align:center;}
.sb-label{flex:1;overflow:hidden;text-overflow:ellipsis;}
.sidebar.collapsed .sb-item{justify-content:center;padding:9px 0;}
.sidebar.collapsed .sb-label{display:none;}
.sidebar.collapsed .sb-icon{font-size:17px;width:auto;}
.sb-divider{height:1px;background:var(--border);margin:6px 14px;}
.sidebar.collapsed .sb-divider{margin:6px 8px;}
.sb-sub-menu{overflow:hidden;max-height:0;transition:max-height .25s cubic-bezier(.4,0,.2,1);}
.sb-sub-menu.open{max-height:600px;}
.sidebar.collapsed .sb-sub-menu{display:none;}
.sidebar.collapsed .sb-expand-icon{display:none;}
.sb-sub-item{display:flex;align-items:center;gap:8px;padding:6px 14px 6px 38px;font-size:12px;font-weight:500;color:var(--muted);cursor:pointer;border:none;background:none;width:100%;text-align:left;transition:all .14s;white-space:nowrap;overflow:hidden;}
.sb-sub-item:hover{background:var(--bg-subtle);color:var(--text);}
.sb-sub-item.active{color:var(--primary);font-weight:700;background:var(--primary-dim);}
.sb-sub-icon{font-size:13px;flex-shrink:0;width:16px;text-align:center;}
.sb-expand-icon{margin-left:auto;font-size:10px;transition:transform .22s;flex-shrink:0;color:var(--muted-2);}
.sb-item.sb-expanded .sb-expand-icon{transform:rotate(180deg);}
.sb-footer{border-top:1px solid var(--border);padding:10px 12px;flex-shrink:0;display:flex;align-items:center;gap:8px;overflow:hidden;}
.sb-user-av{width:28px;height:28px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,#7c3aed,#e11d48);display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:800;}
.sb-user-info{flex:1;min-width:0;overflow:hidden;}
.sb-user-name{font-size:11px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.sb-user-role{font-size:10px;color:var(--muted);}
.sidebar.collapsed .sb-user-info{display:none;}
.sidebar.collapsed .sb-footer{justify-content:center;padding:10px 0;}
.sb-theme-btn{width:26px;height:26px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--muted);transition:all .15s;flex-shrink:0;}
.sb-theme-btn:hover{background:var(--bg-subtle);color:var(--text);}
.sidebar.collapsed .sb-theme-btn{display:none;}

/* ══ MOBILE SIDEBAR OVERLAY ═════════════════════════════════ */
.sb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:299;backdrop-filter:blur(2px);}
@media(max-width:768px){
  .sidebar{position:fixed;top:var(--navbar-h);bottom:0;left:0;z-index:300;transform:translateX(-100%);transition:transform .25s cubic-bezier(.4,0,.2,1);}
  .sidebar.mobile-open{transform:translateX(0);}
  .sb-overlay.visible{display:block;}
}

/* ══ CONTENT AREA ═══════════════════════════════════════════ */
.content-area{flex:1;overflow-y:auto;overflow-x:hidden;display:flex;flex-direction:column;background:var(--bg);min-width:0;}
.content-header{background:var(--card);border-bottom:1px solid var(--border);padding:12px 24px;display:flex;align-items:center;gap:14px;flex-shrink:0;position:sticky;top:0;z-index:100;}
.ch-info{display:flex;flex-direction:column;gap:1px;}
.ch-title{font-size:14px;font-weight:800;color:var(--text);white-space:nowrap;}
.ch-sub{font-size:11px;color:var(--muted);}
.ch-actions{display:flex;align-items:center;gap:8px;margin-left:auto;}
.content-body{padding:24px;flex:1;}

/* ══ BACKLOG STRIP ══════════════════════════════════════════ */
.bs-strip{display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap;}
.bs-pill{display:flex;flex-direction:column;align-items:center;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:10px 18px;flex:1;min-width:80px;box-shadow:var(--sh-xs);cursor:default;}
.bs-pill-val{font-size:22px;font-weight:800;color:var(--text);line-height:1;}
.bs-pill-lbl{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-top:3px;}

/* ══ SECTION LABEL ══════════════════════════════════════════ */
.sec-label{display:flex;align-items:center;gap:10px;font-size:10px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase;color:var(--muted-2);margin-bottom:14px;}
.sec-label::after{content:'';flex:1;height:1px;background:var(--border);}
.sec-label i{font-size:12px;opacity:.6;}

/* ══ ADMIN MODULE CARDS ══════════════════════════════════════ */
.admin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:0;}
@media(max-width:1100px){.admin-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:560px){.admin-grid{grid-template-columns:1fr;}}
.dash-modules{display:flex;flex-direction:column;gap:14px;}

/* Estas clases vienen de shared/partials/autogestion/styles.ejs */
.mod-card{
  background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);
  padding:20px;cursor:pointer;position:relative;overflow:hidden;
  box-shadow:var(--sh-xs);transition:transform .2s,box-shadow .2s,border-color .2s;
  display:flex;flex-direction:column;min-height:148px;
}
.mod-card:hover{transform:translateY(-3px);box-shadow:var(--sh-md);}
.mod-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:var(--radius-lg) var(--radius-lg) 0 0;}
.mod-icon{width:42px;height:42px;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-size:19px;margin-bottom:12px;flex-shrink:0;}
.mod-name{font-size:13px;font-weight:800;color:var(--text);margin-bottom:4px;}
.mod-desc{font-size:11.5px;color:var(--muted);line-height:1.55;flex:1;}
.mod-arrow{position:absolute;bottom:16px;right:16px;font-size:14px;color:var(--border-strong);transition:all .2s;}
.mod-card:hover .mod-arrow{transform:translateX(3px);}

/* Color variants */
.c-blue::before{background:linear-gradient(90deg,#2563eb,#60a5fa);}
.c-blue .mod-icon{background:rgba(37,99,235,.1);color:#2563eb;}
.c-blue:hover{border-color:rgba(37,99,235,.25);}
.c-purp::before{background:linear-gradient(90deg,#7c3aed,#c4b5fd);}
.c-purp .mod-icon{background:rgba(124,58,237,.1);color:#7c3aed;}
.c-purp:hover{border-color:rgba(124,58,237,.25);}
.c-amber::before{background:linear-gradient(90deg,#d97706,#fcd34d);}
.c-amber .mod-icon{background:rgba(217,119,6,.1);color:#d97706;}
.c-amber:hover{border-color:rgba(217,119,6,.25);}
.c-cyan::before{background:linear-gradient(90deg,#0891b2,#67e8f9);}
.c-cyan .mod-icon{background:rgba(8,145,178,.1);color:#0891b2;}
.c-cyan:hover{border-color:rgba(8,145,178,.25);}
.c-green::before{background:linear-gradient(90deg,#059669,#6ee7b7);}
.c-green .mod-icon{background:rgba(5,150,105,.1);color:#059669;}
.c-green:hover{border-color:rgba(5,150,105,.25);}
.c-indigo::before{background:linear-gradient(90deg,#4338ca,#a5b4fc);}
.c-indigo .mod-icon{background:rgba(67,56,202,.1);color:#4338ca;}
.c-indigo:hover{border-color:rgba(67,56,202,.25);}
.c-purple::before{background:linear-gradient(90deg,#6d28d9,#c4b5fd);}
.c-purple .mod-icon{background:rgba(109,40,217,.1);color:#6d28d9;}
.c-purple:hover{border-color:rgba(109,40,217,.25);}
.c-pink::before{background:linear-gradient(90deg,#db2777,#f9a8d4);}
.c-pink .mod-icon{background:rgba(219,39,119,.1);color:#db2777;}
.c-pink:hover{border-color:rgba(219,39,119,.25);}
.c-ora::before{background:linear-gradient(90deg,#0891b2,#6ee7b7);}
.c-ora .mod-icon{background:rgba(8,145,178,.1);color:#0891b2;}
.c-ora:hover{border-color:rgba(8,145,178,.25);}
.c-orange::before{background:linear-gradient(90deg,#ea580c,#fdba74);}
.c-orange .mod-icon{background:rgba(234,88,12,.1);color:#ea580c;}
.c-orange:hover{border-color:rgba(234,88,12,.25);}

/* sub-links */
.sub-links{display:flex;flex-wrap:wrap;gap:5px;margin-top:10px;position:relative;z-index:2;}
.sub-link{display:inline-flex;align-items:center;gap:3px;padding:4px 9px;border-radius:7px;font-size:10px;font-weight:700;
  background:rgba(37,99,235,.08);color:var(--primary);border:1px solid rgba(37,99,235,.18);
  text-decoration:none;cursor:pointer;transition:all .18s;white-space:nowrap;font-family:inherit;}
.c-purp .sub-link{background:rgba(124,58,237,.08);color:#7c3aed;border-color:rgba(124,58,237,.18);}
.c-amber .sub-link{background:rgba(217,119,6,.08);color:#d97706;border-color:rgba(217,119,6,.18);}
.c-cyan  .sub-link{background:rgba(8,145,178,.08);color:#0891b2;border-color:rgba(8,145,178,.18);}
.c-green .sub-link{background:rgba(5,150,105,.08);color:#059669;border-color:rgba(5,150,105,.18);}
.c-indigo .sub-link{background:rgba(67,56,202,.08);color:#4338ca;border-color:rgba(67,56,202,.18);}
.c-purple .sub-link{background:rgba(109,40,217,.08);color:#6d28d9;border-color:rgba(109,40,217,.18);}
.c-pink  .sub-link{background:rgba(219,39,119,.08);color:#db2777;border-color:rgba(219,39,119,.18);}
.c-orange .sub-link{background:rgba(234,88,12,.08);color:#ea580c;border-color:rgba(234,88,12,.18);}
.sub-link:hover{opacity:.8;}
.sub-link i{font-size:9px;}

/* Backlog pills en mod-card */
.bs-strip-sm{display:flex;gap:6px;margin-top:8px;margin-bottom:2px;}
.bs-pill-sm{display:flex;flex-direction:column;align-items:center;background:rgba(37,99,235,.06);border:1px solid rgba(37,99,235,.15);border-radius:8px;padding:5px 10px;flex:1;}
.bs-pill-sm .val{font-size:15px;font-weight:800;color:var(--text);line-height:1;}
.bs-pill-sm .lbl{font-size:9px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-top:2px;}

/* ══ MODALS ════════════════════════════════════════════════ */
.adm-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;display:none;align-items:center;justify-content:center;padding:16px;}
.adm-modal-overlay.open{display:flex;}
.adm-modal{background:var(--bg-card);border-radius:18px;padding:28px;width:100%;max-width:560px;box-shadow:0 24px 60px rgba(0,0,0,.25);position:relative;max-height:90vh;overflow-y:auto;}
.adm-modal h3{font-size:16px;font-weight:800;color:var(--text-main);margin:0 0 20px;display:flex;align-items:center;gap:9px;}
.adm-modal h3 i{font-size:18px;}
.adm-modal-close{position:absolute;top:14px;right:16px;background:none;border:none;font-size:18px;cursor:pointer;color:var(--text-muted);line-height:1;}
.adm-modal-close:hover{color:var(--text-main);}
.fm-row{margin-bottom:14px;}
.fm-row label{display:block;font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px;}
.fm-row input,.fm-row select,.fm-row textarea{width:100%;border:1.5px solid var(--border-soft);border-radius:10px;padding:9px 12px;font-size:13px;background:var(--bg-main);color:var(--text-main);outline:none;font-family:inherit;transition:border-color .2s;box-sizing:border-box;}
.fm-row input:focus,.fm-row select:focus,.fm-row textarea:focus{border-color:var(--primary);}
.fm-row textarea{resize:vertical;min-height:90px;}
.fm-row-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.fm-footer{display:flex;gap:10px;justify-content:flex-end;margin-top:20px;}
.btn-fm{padding:9px 22px;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;border:none;transition:opacity .2s;}
.btn-fm-cancel{background:var(--bg-main);color:var(--text-muted);border:1px solid var(--border-soft);}
.btn-fm-cancel:hover{background:var(--border-soft);}
.btn-fm-submit{color:#fff;}.btn-fm-submit:hover{opacity:.88;}
.btn-fm-submit.purp{background:linear-gradient(135deg,#7c3aed,#6d28d9);}
.btn-fm-submit.cyan{background:linear-gradient(135deg,#0891b2,#0e7490);}
.btn-fm-submit.blue{background:linear-gradient(135deg,#0052cc,#2684ff);}
.btn-fm-submit.orange{background:linear-gradient(135deg,#ea580c,#c2410c);}
.btn-fm-submit.green{background:linear-gradient(135deg,#059669,#047857);}
.dir-results{max-height:220px;overflow-y:auto;border:1.5px solid var(--border-soft);border-radius:10px;}
.dir-result-item{padding:9px 12px;border-bottom:1px solid var(--border-soft);cursor:pointer;transition:background .15s;}
.dir-result-item:last-child{border-bottom:none;}
.dir-result-item:hover{background:var(--bg-subtle);}
.asg-ac-item:hover{background:var(--bg-subtle);}
.dir-result-item strong{display:block;font-size:12px;font-weight:700;color:var(--text-main);}
.dir-result-item span{font-size:11px;color:var(--text-muted);}
.dir-edit-panel{margin-top:16px;padding-top:16px;border-top:1.5px solid var(--border-soft);display:none;}
.graph-badge{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:700;background:rgba(234,88,12,.1);color:#ea580c;border:1px solid rgba(234,88,12,.3);border-radius:6px;padding:2px 8px;margin-bottom:14px;}
.adm-toast{position:fixed;bottom:28px;right:28px;z-index:99999;display:flex;align-items:center;gap:10px;padding:13px 18px;border-radius:14px;font-size:13px;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,.2);color:#fff;transform:translateY(20px);opacity:0;transition:all .3s;pointer-events:none;}
.adm-toast.show{transform:translateY(0);opacity:1;}
.adm-toast.ok{background:#059669;}.adm-toast.err{background:#dc2626;}

/* ══ CONFIG PANEL ═══════════════════════════════════════════ */
.cfg-prio-badge{width:28px;height:20px;border-radius:5px;font-size:10px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;}
.cfg-input{width:80px;border:1.5px solid var(--border);border-radius:8px;padding:5px 8px;font-size:12px;background:var(--bg);color:var(--text);text-align:right;font-family:inherit;outline:none;}
.cfg-input:focus{border-color:var(--primary);}
.cfg-toggle-track{position:absolute;inset:0;background:var(--border);border-radius:10px;cursor:pointer;transition:.25s;}
input:checked + .cfg-toggle-track{background:var(--primary);}

/* mobile */
@media(max-width:768px){
  .content-body{padding:16px;}
  .admin-grid{grid-template-columns:1fr 1fr;}
  .nav-username{display:none;}
}
@media(max-width:480px){.admin-grid{grid-template-columns:1fr;}}
.promo-banner{border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--sh-sm);transition:transform .2s cubic-bezier(.4,0,.2,1),box-shadow .2s;display:block;line-height:0;cursor:pointer;height:160px;}
.promo-banner:hover{transform:translateY(-2px);box-shadow:var(--sh-md);}
.promo-banner img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;}
.banner-wrapper{position:relative;margin-top:20px;}
.banner-upload-btn{position:absolute;top:10px;right:10px;display:flex;align-items:center;gap:6px;padding:7px 13px;border-radius:8px;background:rgba(0,0,0,.55);backdrop-filter:blur(6px);color:#fff;font-size:12px;font-weight:700;border:1.5px solid rgba(255,255,255,.3);cursor:pointer;opacity:0;transition:opacity .2s;z-index:10;}
.banner-wrapper:hover .banner-upload-btn{opacity:1;}
.banner-preview-img{width:100%;max-height:180px;object-fit:cover;border-radius:10px;border:2px dashed var(--primary);margin-bottom:10px;display:block;}

/* ══ STATS ROW ════════════════════════════════════════════════ */
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;}
@media(max-width:1100px){.stats-row{grid-template-columns:repeat(2,1fr);}}
@media(max-width:640px){.stats-row{grid-template-columns:repeat(2,1fr);}}
.stat-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px 18px 14px;box-shadow:var(--sh-xs);display:flex;flex-direction:column;gap:4px;position:relative;overflow:hidden;transition:transform .18s,box-shadow .18s;}
.stat-card:hover{transform:translateY(-2px);box-shadow:var(--sh-sm);}
.sc-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:16px;margin-bottom:4px;}
.sc-label{font-size:10px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--muted);}
.sc-val{font-size:26px;font-weight:800;color:var(--text);line-height:1.1;font-variant-numeric:tabular-nums;}
.sc-sub{font-size:10px;color:var(--muted);display:flex;align-items:center;gap:3px;}
.sc-sub.pos{color:#059669;}
.sc-spark{position:absolute;bottom:0;left:0;right:0;height:36px;opacity:.22;}
/* ══ DASH LAYOUT ══════════════════════════════════════════════ */
.dash-layout{display:grid;grid-template-columns:1fr 300px;gap:20px;margin-bottom:24px;}
@media(max-width:1024px){.dash-layout{grid-template-columns:1fr;}}
/* ══ RESUMEN ══════════════════════════════════════════════════ */
.resumen-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px;box-shadow:var(--sh-xs);}
.resumen-title{font-size:10px;font-weight:800;letter-spacing:.6px;text-transform:uppercase;color:var(--muted);margin-bottom:14px;display:flex;align-items:center;gap:6px;}
.res-item{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);}
.res-item:last-child{border-bottom:none;}
.res-icon{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0;}
.res-text{flex:1;min-width:0;}
.res-label{font-size:12px;font-weight:600;color:var(--text);}
.res-sub{font-size:10px;color:var(--muted);}
.res-val{font-size:14px;font-weight:800;color:var(--text);font-variant-numeric:tabular-nums;flex-shrink:0;}
.res-badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;flex-shrink:0;}
.qa-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.qa-btn{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:10px;border:1px solid var(--border);background:var(--bg);cursor:pointer;font-family:inherit;transition:all .15s;font-size:12px;font-weight:600;color:var(--text);text-decoration:none;}
.qa-btn:hover{background:var(--card);border-color:var(--primary);color:var(--primary);transform:translateY(-1px);box-shadow:var(--sh-xs);}
.qa-btn i{font-size:15px;flex-shrink:0;}
.qa-btn-label{line-height:1.2;}

/* ── NEW KPI ROW ──────────────────────────────────────────── */
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:14px;}
@media(max-width:1100px){.kpi-row{grid-template-columns:repeat(2,1fr);}}
.kpi-c{background:var(--card);border:1px solid var(--border);border-left:3px solid var(--ac,var(--primary));border-radius:var(--radius);padding:13px 14px 0;box-shadow:var(--sh-xs);overflow:hidden;transition:transform .15s,box-shadow .15s;cursor:default;}
.kpi-c:hover{transform:translateY(-2px);box-shadow:var(--sh-sm);}
.kpi-c .kpi-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;}
.kpi-c .kc-ico{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:13px;}
.kc-badge{font-size:9px;font-weight:700;padding:2px 7px;border-radius:20px;letter-spacing:.1px;}
.kc-ok{background:rgba(16,185,129,.1);color:#10b981;}
.kc-nu{background:rgba(100,116,139,.1);color:#64748b;}
.kc-lbl{font-size:10.5px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:var(--muted);margin-bottom:2px;}
.kc-val{font-size:28px;font-weight:800;color:var(--text);line-height:1;font-variant-numeric:tabular-nums;letter-spacing:-1px;}
.kc-sub{font-size:11px;color:var(--muted);margin-top:2px;margin-bottom:9px;}
.kc-spark{display:block;width:100%;height:30px;}
.kc-r{--ac:#ef4444;}.kc-r .kc-ico{background:rgba(239,68,68,.1);color:#ef4444;}
.kc-g{--ac:#10b981;}.kc-g .kc-ico{background:rgba(16,185,129,.1);color:#10b981;}
.kc-b{--ac:#2563eb;}.kc-b .kc-ico{background:rgba(37,99,235,.1);color:#2563eb;}
.kc-a{--ac:#d97706;}.kc-a .kc-ico{background:rgba(217,119,6,.1);color:#d97706;}
/* ── NEW MAIN GRID ───────────────────────────────────────── */
.new-main{display:grid;grid-template-columns:1fr 292px;grid-template-rows:auto auto;gap:11px;}
@media(max-width:1024px){.new-main{grid-template-columns:1fr;grid-template-rows:auto;}}
.new-col-tl,.new-col-tr{display:flex;flex-direction:column;gap:11px;}
.new-main>.banner-wrapper{margin-top:0;display:flex;flex-direction:column;min-height:120px;}
.new-main>.banner-wrapper .promo-banner{flex:1;}
.ch-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:15px;box-shadow:var(--sh-xs);}
.ch-card-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:11px;}
.ch-card-title{font-size:13px;font-weight:700;color:var(--text);}
.ch-card-sub{font-size:11px;color:var(--muted);margin-top:1px;}
.ch-card-leg{display:flex;gap:13px;}
.chl-item{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--muted);font-weight:600;}
.chl-dot{width:8px;height:8px;border-radius:50%;}
/* ── NEW MOD CARDS ───────────────────────────────────────── */
.new-mods{display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:1fr;gap:8px;}
@media(max-width:540px){.new-mods{grid-template-columns:repeat(2,1fr);}}
.nm-card{background:var(--bg);border:1px solid var(--border);border-top:2.5px solid var(--ac,var(--primary));border-radius:var(--radius-sm);padding:11px 12px;cursor:pointer;transition:background .12s,transform .12s,box-shadow .12s;display:flex;flex-direction:column;}
.nm-card:hover{background:var(--card);transform:translateY(-1px);box-shadow:var(--sh-xs);}
.nm-ico{width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:12px;margin-bottom:5px;}
.nm-name{font-size:12.5px;font-weight:700;color:var(--text);}
.nm-desc{font-size:11px;color:var(--muted);line-height:1.4;}
.nm-b{--ac:#2563eb;}.nm-b .nm-ico{background:rgba(37,99,235,.1);color:#2563eb;}
.nm-p{--ac:#7c3aed;}.nm-p .nm-ico{background:rgba(124,58,237,.1);color:#7c3aed;}
.nm-a{--ac:#d97706;}.nm-a .nm-ico{background:rgba(217,119,6,.1);color:#d97706;}
.nm-g{--ac:#10b981;}.nm-g .nm-ico{background:rgba(16,185,129,.1);color:#10b981;}
.nm-i{--ac:#4338ca;}.nm-i .nm-ico{background:rgba(67,56,202,.1);color:#4338ca;}
.nm-c{--ac:#0891b2;}.nm-c .nm-ico{background:rgba(8,145,178,.1);color:#0891b2;}
/* ── DONUT ───────────────────────────────────────────────── */
.dnt-wrap{position:relative;display:flex;justify-content:center;margin:4px 0;}
.dnt-cnt{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;pointer-events:none;}
.dnt-n{font-size:26px;font-weight:800;color:var(--text);font-variant-numeric:tabular-nums;letter-spacing:-1px;line-height:1;}
.dnt-s{font-size:10px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.5px;}
.dnt-leg{display:flex;flex-direction:column;gap:7px;margin-top:10px;}
.dnt-li{display:flex;align-items:center;justify-content:space-between;}
.dnt-ll{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--muted);}
.dnt-sq{width:9px;height:9px;border-radius:2px;flex-shrink:0;}
.dnt-lv{font-size:13px;font-weight:700;color:var(--text);font-variant-numeric:tabular-nums;}
/* ── TECH LIST ───────────────────────────────────────────── */
.tec-li{display:flex;flex-direction:column;gap:9px;}
.tec-ri{display:flex;align-items:center;gap:8px;}
.tec-av{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;flex-shrink:0;}
.tec-if{flex:1;min-width:0;}
.tec-nm{font-size:12px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tec-br{height:3px;background:var(--border);border-radius:2px;margin-top:4px;}
.tec-bf{height:3px;border-radius:2px;}
.tec-nv{font-size:15px;font-weight:800;font-variant-numeric:tabular-nums;flex-shrink:0;}
.mod-sep{font-size:9.5px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:var(--muted-2);display:flex;align-items:center;gap:8px;margin-bottom:10px;}
.mod-sep::after{content:'';flex:1;height:1px;background:var(--border);}
</style>
</head>
<body>

<%
  const _name        = user ? (user.full_name || user.name || user.email || 'Admin') : 'Administrador';
  const _parts       = _name.trim().split(/\s+/);
  const _ini         = (_parts[0]?.[0]||'A').toUpperCase() + (_parts[1]?.[0]||'').toUpperCase();
  const _first       = (_parts[0]||'Admin');
  const _role        = user ? (user.role || 'admin') : 'admin';
  const _tenantId    = parseInt(user?.tenant_id || 1);
  // Usa config del tenant (inyectada por middleware/tenantLocals.js) — sin hardcodes
  const _cfg         = tenantCfg || {};
  const _jiraEnabled = _cfg.features?.jira   ?? false;
  const _tenantName  = _cfg.name              ?? 'Portal TI';
%>

<!-- ══ NAVBAR ══════════════════════════════════════════════ -->
<nav class="navbar">
  <button class="nav-hamburger" id="navHamburger" onclick="toggleSidebar()" title="Menú">
    <i class="bi bi-layout-sidebar"></i>
  </button>
  <div class="nav-brand">
    <img src="/images/movistar-logo.png" alt="Logo" class="nav-logo" onerror="this.style.display='none'">
    <span class="nav-divider"></span>
    <span class="nav-name"><%= _tenantName %></span>
    <span class="nav-badge">ADMIN</span>
  </div>
  <div class="nav-space"></div>
  <a href="<%= (_role === 'superadmin' && _tenantId !== 1) ? '/api/admin/tenants/' + _tenantId + '/enter?target=autogestion' : '/autogestion' %>" class="nav-icon-btn" title="Portal de usuario"><i class="bi bi-person-circle"></i></a>
  <button class="nav-icon-btn" onclick="toggleTheme()" title="Cambiar tema"><i class="bi bi-moon-stars-fill" id="navThemeIcon"></i></button>
  <div class="nav-user">
    <div class="nav-avatar" id="navAvatar"><%= _ini %></div>
    <span class="nav-username"><%= _first %></span>
  </div>
  <button class="nav-exit" onclick="location.href='/api/auth/logout'"><i class="bi bi-box-arrow-right"></i><span>Salir</span></button>
</nav>

<!-- ══ APP SHELL ════════════════════════════════════════════ -->
<div class="app-shell">

  <!-- SIDEBAR -->
  <div class="sidebar" id="sidebar">
    <nav class="sb-nav" id="sbNav" style="padding-top:10px;">

      <!-- INICIO -->
      <button class="sb-item active" id="sbInicio" onclick="sbGo('inicio', this)">
        <i class="bi bi-grid-1x2-fill sb-icon" style="color:#2563eb;"></i>
        <span class="sb-label">Inicio</span>
      </button>
      <a class="sb-item" href="/admin-dashboard">
        <i class="bi bi-bar-chart-line-fill sb-icon" style="color:#059669;"></i>
        <span class="sb-label">Dashboard</span>
      </a>

      <!-- ITSM -->
      <div class="sb-section">
        <span class="sb-section-label">ITSM</span>
        <button class="sb-item" onclick="sbToggle('subItsm', this)">
          <i class="bi bi-headset sb-icon" style="color:#0891b2;"></i>
          <span class="sb-label">ITSM</span>
          <i class="bi bi-chevron-down sb-expand-icon"></i>
        </button>
        <div class="sb-sub-menu" id="subItsm">
          <a class="sb-sub-item" href="/itsm/incidencias/gestion"><i class="bi bi-exclamation-triangle-fill sb-sub-icon" style="color:#dc2626;"></i>Incidencias</a>
          <a class="sb-sub-item" href="/itsm/requerimientos/gestion"><i class="bi bi-clipboard2-check-fill sb-sub-icon" style="color:#7c3aed;"></i>Requerimientos</a>
          <a class="sb-sub-item" href="/cambios"><i class="bi bi-arrow-repeat sb-sub-icon" style="color:#0891b2;"></i>Cambios</a>
          <a class="sb-sub-item" href="/problemas"><i class="bi bi-bug-fill sb-sub-icon" style="color:#d97706;"></i>Problemas</a>
          <a class="sb-sub-item" href="/catalogo"><i class="bi bi-grid-3x3-gap-fill sb-sub-icon" style="color:#6366f1;"></i>Catálogo</a>
        </div>
      </div>

      <!-- ACTIVOS -->
      <div class="sb-section">
        <span class="sb-section-label">Activos</span>
        <button class="sb-item" onclick="sbToggle('subActivos', this)">
          <i class="bi bi-laptop-fill sb-icon" style="color:#d97706;"></i>
          <span class="sb-label">Gestión de Activos</span>
          <i class="bi bi-chevron-down sb-expand-icon"></i>
        </button>
        <div class="sb-sub-menu" id="subActivos">
          <a class="sb-sub-item" href="/equipment"><i class="bi bi-pc-display-horizontal sb-sub-icon" style="color:#d97706;"></i>CMDB</a>
          <a class="sb-sub-item" href="/warranty"><i class="bi bi-shield-check sb-sub-icon" style="color:#059669;"></i>Garantías</a>
          <a class="sb-sub-item" href="/incidencias?tab=devoluciones"><i class="bi bi-box-arrow-in-left sb-sub-icon" style="color:#0891b2;"></i>Devoluciones</a>
          <a class="sb-sub-item" href="/sccm"><i class="bi bi-windows sb-sub-icon" style="color:#0078d4;"></i>SCCM</a>
          <a class="sb-sub-item" href="/soporte"><i class="bi bi-tools sb-sub-icon" style="color:#059669;"></i>Soporte técnico</a>
        </div>
      </div>

      <!-- CONTENIDO -->
      <div class="sb-section">
        <span class="sb-section-label">Contenido</span>
        <button class="sb-item" onclick="sbToggle('subContenido', this)">
          <i class="bi bi-journal-richtext sb-icon" style="color:#4f46e5;"></i>
          <span class="sb-label">Gestión Documental</span>
          <i class="bi bi-chevron-down sb-expand-icon"></i>
        </button>
        <div class="sb-sub-menu" id="subContenido">
          <a class="sb-sub-item" href="/knowledge-base"><i class="bi bi-book-fill sb-sub-icon" style="color:#4f46e5;"></i>Base de Conocimiento</a>
          <button class="sb-sub-item" onclick="openModal('modalKB')"><i class="bi bi-plus-circle-fill sb-sub-icon" style="color:#4f46e5;"></i>Publicar artículo</button>
          <a class="sb-sub-item" href="/preguntas-frecuentes"><i class="bi bi-patch-question-fill sb-sub-icon" style="color:#ca8a04;"></i>FAQ</a>
          <button class="sb-sub-item" onclick="openModal('modalFAQ')"><i class="bi bi-plus-circle-fill sb-sub-icon" style="color:#ca8a04;"></i>Nueva pregunta FAQ</button>
        </div>
      </div>

      <!-- USUARIOS -->
      <div class="sb-section">
        <span class="sb-section-label">Usuarios</span>
        <button class="sb-item" onclick="sbToggle('subUsuarios', this)">
          <i class="bi bi-people-fill sb-icon" style="color:#0891b2;"></i>
          <span class="sb-label">Gestión de Usuarios</span>
          <i class="bi bi-chevron-down sb-expand-icon"></i>
        </button>
        <div class="sb-sub-menu" id="subUsuarios">
          <a class="sb-sub-item" href="/colaboradores"><i class="bi bi-person-badge-fill sb-sub-icon" style="color:#0891b2;"></i>Colaboradores</a>
          <a class="sb-sub-item" href="/licencias"><i class="bi bi-key-fill sb-sub-icon" style="color:#ca8a04;"></i>Licencias</a>
          <button class="sb-sub-item" onclick="openModal('modalDirectorio')"><i class="bi bi-card-list sb-sub-icon" style="color:#6366f1;"></i>Directorio / Editar</button>
        </div>
      </div>

      <!-- REPORTERÍA -->
      <div class="sb-section">
        <span class="sb-section-label">Reportería</span>
        <button class="sb-item" onclick="sbToggle('subReportes', this)">
          <i class="bi bi-graph-up-arrow sb-icon" style="color:#059669;"></i>
          <span class="sb-label">Reportería</span>
          <i class="bi bi-chevron-down sb-expand-icon"></i>
        </button>
        <div class="sb-sub-menu" id="subReportes">
          <a class="sb-sub-item" href="/indicators"><i class="bi bi-bar-chart-line-fill sb-sub-icon" style="color:#059669;"></i>Indicadores KPI</a>
          <a class="sb-sub-item" href="/analytics"><i class="bi bi-bar-chart-fill sb-sub-icon" style="color:#059669;"></i>Reportes</a>
          <a class="sb-sub-item" href="/csi"><i class="bi bi-arrow-up-circle-fill sb-sub-icon" style="color:#0891b2;"></i>CSI</a>
          <a class="sb-sub-item" href="/itsm/incidencias/gestion?tab=portal"><i class="bi bi-people-fill sb-sub-icon" style="color:#7c3aed;"></i>Estadísticas Portal</a>
          <a class="sb-sub-item" href="/itsm/incidencias/gestion?tab=encuesta"><i class="bi bi-star-fill sb-sub-icon" style="color:#db2777;"></i>Calidad / CSAT</a>
        </div>
      </div>

      <!-- CONFIGURACIÓN -->
      <div class="sb-section">
        <span class="sb-section-label">Configuración</span>
        <button class="sb-item sb-expanded" onclick="sbToggle('subConfig', this)">
          <i class="bi bi-sliders2-vertical sb-icon" style="color:#6366f1;"></i>
          <span class="sb-label">Configuración ITSM</span>
          <i class="bi bi-chevron-down sb-expand-icon"></i>
        </button>
        <div class="sb-sub-menu open" id="subConfig">
          <button class="sb-sub-item" id="sbConfigSla" onclick="sbGo('config', this); panelGo('panelConfig')">
            <i class="bi bi-clock-history sb-sub-icon" style="color:#6366f1;"></i>SLA y alertas
          </button>
          <a class="sb-sub-item" href="/itsm/incidencias/gestion?tab=categorias">
            <i class="bi bi-tags-fill sb-sub-icon" style="color:#7c3aed;"></i>Categorías
          </a>
          <a class="sb-sub-item" href="/itsm/incidencias/gestion?tab=automaciones">
