/* ── CONFIG ITSM ────────────────────────────────────────────── */
async function cfgLoad() {
  try {
    const r = await fetch('/api/jira/config/itsm', { credentials:'include' });
    const d = await r.json();
    if (!d.success) return;
    const c = d.data;
    if (c.sla) {
      ['p1','p2','p3','p4'].forEach(p => {
        const el = document.getElementById('cfg-sla-' + p);
        if (el && c.sla[p.toUpperCase()]) el.value = c.sla[p.toUpperCase()];
      });
    }
    if (c.alerts) {
      const w = document.getElementById('cfg-alert-window');
      if (w) w.value = c.alerts.window_minutes || 10;
      const n = document.getElementById('cfg-alert-notif');
      if (n) n.checked = c.alerts.breach_notification !== false;
    }
    if (c.noc) {
      const q = document.getElementById('cfg-noc-queue');
      if (q) q.value = c.noc.queue || 'wp';
      const rf = document.getElementById('cfg-noc-refresh');
      if (rf) rf.value = c.noc.refresh_seconds || 60;
    }
    if (c.escalation) {
      const em = document.getElementById('cfg-esc-emails');
      if (em) em.value = c.escalation.emails || '';
      const en = document.getElementById('cfg-esc-enabled');
      if (en) en.checked = !!c.escalation.enabled;
    }
    _cfgSyncToggle();
  } catch(e) { console.error('[cfg]', e); }
}

function _cfgSyncToggle() {
  const n = document.getElementById('cfg-alert-notif');
  const t = document.getElementById('cfg-alert-notif-track');
  if (n && t) t.style.background = n.checked ? 'var(--primary)' : 'var(--border)';
}
document.addEventListener('change', e => {
  if (e.target.id === 'cfg-alert-notif') _cfgSyncToggle();
});

async function cfgSave() {
  const btn = document.getElementById('cfgSaveBtn');
  btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Guardando…';
  const body = {
    sla: { P1: +document.getElementById('cfg-sla-p1').value, P2: +document.getElementById('cfg-sla-p2').value, P3: +document.getElementById('cfg-sla-p3').value, P4: +document.getElementById('cfg-sla-p4').value },
    alerts: { window_minutes: +document.getElementById('cfg-alert-window').value, breach_notification: document.getElementById('cfg-alert-notif').checked },
    noc: { queue: document.getElementById('cfg-noc-queue').value, refresh_seconds: +document.getElementById('cfg-noc-refresh').value },
    escalation: { emails: document.getElementById('cfg-esc-emails').value.trim(), enabled: document.getElementById('cfg-esc-enabled').checked }
  };
  try {
    const r = await fetch('/api/jira/config/itsm', { method:'POST', credentials:'include', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const d = await r.json();
    if (d.success) {
      toast('Configuración guardada');
      const st = document.getElementById('cfgStatus');
      if (st) { st.style.display = ''; setTimeout(() => st.style.display = 'none', 3000); }
    } else { toast(d.error || 'Error al guardar', 'err'); }
  } catch(e) { toast('Error de conexión', 'err'); }
  finally { btn.disabled = false; btn.innerHTML = '<i class="bi bi-floppy-fill"></i> Guardar configuración'; }
}


/* ── BANNER UPLOAD ──────────────────────────────────────────── */
(function(){
  const inp = document.getElementById('bannerFileInput');
  if (!inp) return;
  inp.addEventListener('change', function() {
    const file = this.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
      const prev = document.getElementById('bannerPreviewImg');
      const name = document.getElementById('bannerPreviewName');
      if (prev) prev.src = e.target.result;
      if (name) name.textContent = file.name + ' (' + (file.size/1024).toFixed(0) + ' KB)';
      openModal('modalBannerPreview');
    };
    reader.readAsDataURL(file);
  });
})();

async function saveBanner() {
  const inp  = document.getElementById('bannerFileInput');
  const file = inp?.files?.[0];
  if (!file) return;
  const btn = document.getElementById('bannerSaveBtn');
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Subiendo...'; }
  try {
    const fd = new FormData();
    fd.append('banner', file);
    const resp = await fetch('/api/admin/tenants/<%= _tenantId %>/banner', { method:'POST', body: fd, credentials:'include' });
    const data = await resp.json();
    if (data.success) {
      const bannerEl = document.getElementById('bannerImg');
      if (bannerEl) bannerEl.src = '/images/' + data.bannerImage + '?t=' + Date.now();
      closeModal('modalBannerPreview');
      toast('Banner actualizado correctamente');
    } else { toast(data.error || 'Error al subir banner', 'err'); }
  } catch(e) { toast('Error de red', 'err'); }
  finally {
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-cloud-upload-fill"></i> Guardar banner'; }
    inp.value = '';
  }
}
</script>

