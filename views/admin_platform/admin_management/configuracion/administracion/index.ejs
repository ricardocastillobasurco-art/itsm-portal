<script>
/* ── THEME ──────────────────────────────────────────────────── */
(function(){
  const s = localStorage.getItem('dashboardTheme') || 'light';
  document.documentElement.setAttribute('data-theme', s);
  _syncThemeIcons(s);
})();
function toggleTheme(){
  const n = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', n);
  localStorage.setItem('dashboardTheme', n);
  _syncThemeIcons(n);
}
function _syncThemeIcons(t){
  const cls = t === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
  ['navThemeIcon','sbThemeIcon'].forEach(id => { const el = document.getElementById(id); if(el) el.className = cls; });
}

/* ── SIDEBAR ────────────────────────────────────────────────── */
(function(){
  const sb = document.getElementById('sidebar');
  const ov = document.getElementById('sbOverlay');
  let _sbCollapsed = localStorage.getItem('admin_sb_collapsed') === '1';
  if (_sbCollapsed) sb.classList.add('collapsed');

  window.toggleSidebar = function(){
    if (window.innerWidth <= 768) {
      const opening = !sb.classList.contains('mobile-open');
      sb.classList.toggle('mobile-open', opening);
      ov.classList.toggle('visible', opening);
      document.body.style.overflow = opening ? 'hidden' : '';
    } else {
      _sbCollapsed = !_sbCollapsed;
      sb.classList.toggle('collapsed', _sbCollapsed);
      localStorage.setItem('admin_sb_collapsed', _sbCollapsed ? '1' : '0');
    }
  };
  window.closeSidebarMobile = function(){
