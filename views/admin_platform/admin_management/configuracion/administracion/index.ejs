</div>

<script>
/* ── QUICK ACTIONS INLINE MODALS ─────────────────────────────── */
function openAdmFrame(url){
  document.getElementById('admIframe').src=url;
  openModal('admIframeWrap');
}
function closeAdmFrame(){
  closeModal('admIframeWrap');
  setTimeout(function(){ document.getElementById('admIframe').src=''; },300);
}
document.getElementById('admIframeWrap').addEventListener('click',function(e){ if(e.target===this) closeAdmFrame(); });
document.getElementById('admModalAsig').addEventListener('click',function(e){ if(e.target===this) closeModal('admModalAsig'); });
document.getElementById('admModalColabs').addEventListener('click',function(e){ if(e.target===this) closeModal('admModalColabs'); });

function openAdmAsigModal(){
  document.getElementById('admAsigDate').value=new Date().toISOString().split('T')[0];
  openModal('admModalAsig');
  if(!window._admAsigACInit){ window._admAsigACInit=true; _admInitAC(); }
}

/* ── AC helper ──────────────────────────────────────────────── */
var _admACTimer=null;
function _admAC(inpId,resId,url,renderFn,pickFn,min){
  min=min||2;
  var inp=document.getElementById(inpId),res=document.getElementById(resId);
  if(!inp||!res)return;
  inp.addEventListener('input',function(){
    clearTimeout(_admACTimer);
    var q=inp.value.trim();
    if(q.length<min){ res.style.display='none'; return; }
    _admACTimer=setTimeout(function(){
      fetch(url+encodeURIComponent(q))
        .then(function(r){ return r.json(); })
        .then(function(d){
          var items=(d.data||d||[]).slice(0,8);
          if(!items.length){ res.style.display='none'; return; }
          res.innerHTML=items.map(renderFn).join('');
          res.style.display='block';
          res.querySelectorAll('[data-idx]').forEach(function(el){
            el.addEventListener('mousedown',function(e){
              e.preventDefault();
              pickFn(items[+el.dataset.idx]);
              res.style.display='none';
            });
          });
        }).catch(function(){ res.style.display='none'; });
    },280);
  });
  document.addEventListener('click',function(e){ if(!inp.contains(e.target)&&!res.contains(e.target)) res.style.display='none'; });
}

function _admInitAC(){
  _admAC('admAsigEmp','admAsigEmpRes','/api/employees/search?q=',
    function(e,i){ return '<div class="asg-ac-item" style="padding:8px 12px;cursor:pointer;" data-idx="'+i+'"><div style="font-size:13px;font-weight:600;color:var(--text-main);">'+e.full_name+'</div><div style="font-size:11px;color:var(--text-muted);">CIP: '+(e.cip||'—')+'</div></div>'; },
    function(e){ document.getElementById('admAsigEmp').value=e.full_name; document.getElementById('admAsigEmpCip').value=e.cip||''; },3);
  _admAC('admAsigEq','admAsigEqRes','/api/equipment/search?term=',
    function(e,i){ return '<div class="asg-ac-item" style="padding:8px 12px;cursor:pointer;" data-idx="'+i+'"><div style="font-size:13px;font-weight:600;color:var(--text-main);">'+e.device_code+'</div><div style="font-size:11px;color:var(--text-muted);">'+(e.model||'')+' · '+(e.brand||'')+'</div></div>'; },
    function(e){ document.getElementById('admAsigEq').value=e.device_code; document.getElementById('admAsigEqCode').value=e.device_code; },2);
  _admAC('admAsigDept','admAsigDeptRes','/api/departments/search?term=',
    function(e,i){ return '<div class="asg-ac-item" style="padding:8px 12px;cursor:pointer;" data-idx="'+i+'"><div style="font-size:13px;font-weight:600;color:var(--text-main);">'+e.department_name+'</div></div>'; },
    function(e){ document.getElementById('admAsigDept').value=e.department_name; document.getElementById('admAsigDeptId').value=e.id; },3);
  _admAC('admColabDept','admColabDeptRes','/api/departments/search?term=',
    function(e,i){ return '<div class="asg-ac-item" style="padding:8px 12px;cursor:pointer;" data-idx="'+i+'"><div style="font-size:13px;font-weight:600;color:var(--text-main);">'+e.department_name+'</div></div>'; },
    function(e){ document.getElementById('admColabDept').value=e.department_name; document.getElementById('admColabDeptId').value=e.id; },3);
}

/* ── Guardar Asignación ─────────────────────────────────────── */
async function admSaveAsig(){
  var emp=document.getElementById('admAsigEmp').value.trim();
  var cip=document.getElementById('admAsigEmpCip').value.trim();
  var eq=document.getElementById('admAsigEqCode').value.trim()||document.getElementById('admAsigEq').value.trim();
  var date=document.getElementById('admAsigDate').value;
  var notes=document.getElementById('admAsigNotes').value.trim();
  var deptId=document.getElementById('admAsigDeptId').value;
  if(!emp||!eq||!date){ alert('Completa colaborador, equipo y fecha.'); return; }
  var btn=document.getElementById('admBtnSaveAsig');
  btn.disabled=true; btn.innerHTML='<i class="bi bi-hourglass-split"></i> Guardando…';
  try{
    var r=await fetch('/api/assignments',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
      employee_cip:cip||undefined, employee_id:undefined,
      equipment_code:eq, assignment_date:date,
      notes:notes||undefined, department_id:deptId||undefined
    })});
    var d=await r.json();
    if(!r.ok) throw new Error(d.message||'Error al guardar');
    closeModal('admModalAsig');
    ['admAsigEmp','admAsigEmpCip','admAsigEq','admAsigEqCode','admAsigDept','admAsigDeptId','admAsigNotes'].forEach(function(id){ var el=document.getElementById(id); if(el) el.value=''; });
    if(typeof showToast==='function') showToast('Asignación creada correctamente','success');
  } catch(err){
    alert(err.message);
  } finally{
    btn.disabled=false; btn.innerHTML='<i class="bi bi-check-lg"></i> Guardar';
  }
}

/* ── Guardar Colaborador ────────────────────────────────────── */
async function admSaveColab(){
  var name=document.getElementById('admColabName').value.trim();
  var email=document.getElementById('admColabEmail').value.trim();
  var cip=document.getElementById('admColabCip').value.trim();
  var pos=document.getElementById('admColabPos').value.trim();
  var deptId=document.getElementById('admColabDeptId').value;
  if(!name||!email){ alert('Nombre y email son obligatorios.'); return; }
  var btn=document.getElementById('admBtnSaveColab');
  btn.disabled=true; btn.innerHTML='<i class="bi bi-hourglass-split"></i> Guardando…';
  try{
    var r=await fetch('/api/employees',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
      full_name:name, email:email,
      cip:cip||undefined, position:pos||undefined,
      department_id:deptId||undefined
    })});
    var d=await r.json();
    if(!r.ok) throw new Error(d.message||'Error al guardar');
    closeModal('admModalColabs');
    ['admColabName','admColabEmail','admColabCip','admColabPos','admColabDept','admColabDeptId'].forEach(function(id){ var el=document.getElementById(id); if(el) el.value=''; });
    if(typeof showToast==='function') showToast('Colaborador creado correctamente','success');
    else alert('Colaborador creado correctamente.');
  } catch(err){
    alert(err.message);
  } finally{
    btn.disabled=false; btn.innerHTML='<i class="bi bi-check-lg"></i> Guardar';
  }
}
</script>

</body>
</html>