/* ── DASH CHARTS ─────────────────────────────────────────────── */
function _isDarkDash(){return document.documentElement.getAttribute('data-theme')==='dark';}
function _hex2rg(h,a){const r=parseInt(h.slice(1,3),16),g=parseInt(h.slice(3,5),16),b=parseInt(h.slice(5,7),16);return`rgba(${r},${g},${b},${a})`;}

function drawDashSpk(id,data,color){
  const svg=document.getElementById(id);if(!svg)return;
  const W=80,H=30,p=2,mn=Math.min(...data),mx=Math.max(...data),rg=mx-mn||1;
  const pts=data.map((v,i)=>[(i/(data.length-1))*W,H-p-((v-mn)/rg)*(H-p*2)]);
  const ln=pts.map((q,i)=>(i?'L':'M')+q[0].toFixed(1)+' '+q[1].toFixed(1)).join('');
  const fi=ln+` L${W} ${H} L0 ${H} Z`;
  const rc=parseInt(color.slice(1,3),16),gc=parseInt(color.slice(3,5),16),bc=parseInt(color.slice(5,7),16);
  svg.innerHTML=`<defs><linearGradient id="dg${id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="rgb(${rc},${gc},${bc})" stop-opacity=".2"/><stop offset="100%" stop-color="rgb(${rc},${gc},${bc})" stop-opacity="0"/></linearGradient></defs><path d="${fi}" fill="url(#dg${id})"/><path d="${ln}" fill="none" stroke="${color}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`;
}

function drawDashTrend(){
  const canvas=document.getElementById('dashTrendChart');if(!canvas)return;
  const dpr=window.devicePixelRatio||1,W=canvas.offsetWidth,H=160;
  canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);
  const dark=_isDarkDash();
  const gc=dark?'rgba(148,163,184,.07)':'rgba(0,0,0,.055)';
  const tc=dark?'#64748b':'#94a3b8';
  const labels=['Lun','Mar','Mié','Jue','Vie','Sáb','Hoy'];
  const d1=[18,25,31,22,28,15,27],d2=[16,22,28,19,26,13,27];
  const pL=34,pR=10,pT=10,pB=26,cW=W-pL-pR,cH=H-pT-pB;
  const mxv=Math.ceil(Math.max(...d1,...d2)*1.3/10)*10;
  const xP=i=>pL+(i/(labels.length-1))*cW;
  const yP=v=>pT+cH-(v/mxv)*cH;
  ctx.clearRect(0,0,W,H);
  const fnt=`10px -apple-system,'Segoe UI',system-ui,sans-serif`;
  for(let i=0;i<=4;i++){
    const y=pT+(cH/4)*i,v=Math.round(mxv-(mxv/4)*i);
    ctx.strokeStyle=gc;ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(pL,y);ctx.lineTo(pL+cW,y);ctx.stroke();
    ctx.fillStyle=tc;ctx.font=fnt;ctx.textAlign='right';ctx.fillText(v,pL-5,y+3.5);
  }
  function ser(data,color){
    const g=ctx.createLinearGradient(0,pT,0,pT+cH);
    g.addColorStop(0,_hex2rg(color,.15));g.addColorStop(1,_hex2rg(color,0));
    ctx.beginPath();data.forEach((v,i)=>i?ctx.lineTo(xP(i),yP(v)):ctx.moveTo(xP(i),yP(v)));
    ctx.lineTo(xP(data.length-1),pT+cH);ctx.lineTo(pL,pT+cH);ctx.closePath();ctx.fillStyle=g;ctx.fill();
    ctx.beginPath();data.forEach((v,i)=>i?ctx.lineTo(xP(i),yP(v)):ctx.moveTo(xP(i),yP(v)));
    ctx.strokeStyle=color;ctx.lineWidth=2;ctx.lineJoin='round';ctx.lineCap='round';ctx.stroke();
    data.forEach((v,i)=>{
      ctx.beginPath();ctx.arc(xP(i),yP(v),3.5,0,Math.PI*2);ctx.fillStyle=color;ctx.fill();
      ctx.beginPath();ctx.arc(xP(i),yP(v),1.8,0,Math.PI*2);ctx.fillStyle=dark?'#111827':'#fff';ctx.fill();
    });
    ctx.fillStyle=color;ctx.font=`bold 10px ${fnt}`;ctx.textAlign='center';
    ctx.fillText(data[data.length-1],xP(data.length-1),yP(data[data.length-1])-9);
  }
  ser(d2,'#10b981');ser(d1,'#2563eb');
  ctx.fillStyle=tc;ctx.font=fnt;ctx.textAlign='center';
  labels.forEach((l,i)=>ctx.fillText(l,xP(i),H-6));
}

function drawDashDonut(open,prog,res){
  const svg=document.getElementById('dashDonut');if(!svg)return;
  const dark=_isDarkDash(),cx=75,cy=75,R=57,sw=15;
  const total=(open||0)+(prog||0)+(res||0);
  const trk=dark?'#1e293b':'#e2e8f0';
  let h=`<circle cx="${cx}" cy="${cy}" r="${R}" fill="none" stroke="${trk}" stroke-width="${sw}"/>`;
  if(total>0){
    const segs=[{n:open||0,c:'#ef4444'},{n:prog||0,c:'#f59e0b'},{n:res||0,c:'#10b981'}].filter(s=>s.n>0);
    const gap=0.05;let st=-Math.PI/2;
    segs.forEach(seg=>{
      const sw2=seg.n/total*Math.PI*2,a0=st+gap/2,a1=st+sw2-gap/2;
      const x0=cx+R*Math.cos(a0),y0=cy+R*Math.sin(a0),x1=cx+R*Math.cos(a1),y1=cy+R*Math.sin(a1);
      h+=`<path d="M${x0.toFixed(2)} ${y0.toFixed(2)} A${R} ${R} 0 ${sw2-gap>Math.PI?1:0} 1 ${x1.toFixed(2)} ${y1.toFixed(2)}" fill="none" stroke="${seg.c}" stroke-width="${sw}" stroke-linecap="round"/>`;
      st+=sw2;
    });
  }
  svg.innerHTML=h;
  const el=document.getElementById('donutTotal');if(el)el.textContent=total||'—';
}

