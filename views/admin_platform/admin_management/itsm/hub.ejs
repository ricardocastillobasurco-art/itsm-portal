<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<script>(function(){document.documentElement.setAttribute('data-theme',localStorage.getItem('dashboardTheme')||'light');})();</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ITSM · Centro de Servicios TI</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<style>
/* ══ VARIABLES (idéntico a /administracion) ══════════════════ */
:root,[data-theme="light"]{
  --bg:#f1f5f9;--bg-subtle:#e9eef5;--card:#ffffff;
  --border:#e2e8f0;--border-strong:#cbd5e1;
  --text:#0f172a;--text-2:#1e293b;--muted:#64748b;--muted-2:#94a3b8;
  --primary:#2563eb;--primary-dim:rgba(37,99,235,.1);--primary-glow:rgba(37,99,235,.25);
  --success:#059669;--warning:#d97706;--danger:#dc2626;--purple:#7c3aed;--info:#0891b2;
  --sh-xs:0 1px 2px rgba(0,0,0,.06);
  --sh-sm:0 1px 3px rgba(0,0,0,.08),0 4px 12px rgba(0,0,0,.04);
  --sh-md:0 4px 16px rgba(0,0,0,.1),0 16px 40px rgba(0,0,0,.07);
  --nav-bg:rgba(255,255,255,.95);
  --radius-sm:8px;--radius:12px;--radius-lg:16px;
  --sidebar-w:220px;--navbar-h:44px;
  --sidebar-bg:var(--card);
}
[data-theme="dark"]{
  --bg:#080d1c;--bg-subtle:#0d1425;--card:#111827;
  --border:#1e293b;--border-strong:#2d3f55;
  --text:#f1f5f9;--text-2:#e2e8f0;--muted:#94a3b8;--muted-2:#64748b;
  --primary:#3b82f6;--primary-dim:rgba(59,130,246,.14);--primary-glow:rgba(59,130,246,.2);
  --success:#10b981;--warning:#f59e0b;--danger:#ef4444;--purple:#8b5cf6;--info:#06b6d4;
  --sh-xs:0 1px 2px rgba(0,0,0,.4);
  --sh-sm:0 1px 3px rgba(0,0,0,.4),0 4px 12px rgba(0,0,0,.3);
  --sh-md:0 4px 16px rgba(0,0,0,.4),0 16px 40px rgba(0,0,0,.3);
  --nav-bg:rgba(8,13,28,.95);
  --sidebar-bg:var(--bg-subtle);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;overflow:hidden;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',-apple-system,'Segoe UI',sans-serif;font-size:14px;line-height:1.6;-webkit-font-smoothing:antialiased;}
a{text-decoration:none;color:inherit;}
button{font-family:inherit;cursor:pointer;border:none;background:none;}
*::-webkit-scrollbar{width:5px;height:5px;}
*::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:3px;}

/* ══ NAVBAR ══════════════════════════════════════════════════ */
.navbar{position:fixed;top:0;left:0;right:0;z-index:500;height:var(--navbar-h);display:flex;align-items:center;gap:6px;padding:0 16px;background:var(--nav-bg);backdrop-filter:blur(16px) saturate(160%);-webkit-backdrop-filter:blur(16px) saturate(160%);border-bottom:1px solid var(--border);}
.nav-hamburger{width:30px;height:30px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--muted);transition:all .15s;cursor:pointer;flex-shrink:0;}
.nav-hamburger:hover{background:var(--bg-subtle);color:var(--text);}
.nav-brand{display:flex;align-items:center;gap:7px;padding:0 8px;}
.nav-logo{height:18px;width:auto;}
.nav-divider{width:1px;height:16px;background:var(--border);}
.nav-name{font-size:12px;font-weight:700;color:var(--text);}
.nav-badge{font-size:8px;font-weight:800;padding:1px 6px;border-radius:20px;background:linear-gradient(135deg,#0052cc,#2684ff);color:#fff;letter-spacing:.5px;text-transform:uppercase;}
.nav-space{flex:1;}
.nav-icon-btn{width:30px;height:30px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--muted);transition:all .15s;cursor:pointer;}
.nav-icon-btn:hover{background:var(--bg-subtle);color:var(--text);}
.nav-breadcrumb{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--muted);padding-left:2px;}
.nav-breadcrumb a{color:var(--muted);font-weight:500;transition:color .15s;}
.nav-breadcrumb a:hover{color:var(--primary);}
.nav-breadcrumb .sep{opacity:.35;}
.nav-breadcrumb .cur{color:var(--text-2);font-weight:700;}
.nav-user{display:flex;align-items:center;gap:5px;padding:3px 8px 3px 4px;border-radius:20px;background:var(--bg-subtle);border:1px solid var(--border);}
.nav-avatar{width:24px;height:24px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,#0052cc,#2684ff);display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:800;}
.nav-username{font-size:11px;font-weight:600;color:var(--text-2);max-width:90px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.nav-exit{display:flex;align-items:center;gap:4px;padding:5px 10px;border-radius:5px;font-size:11px;font-weight:600;color:var(--muted);transition:all .15s;cursor:pointer;}
.nav-exit:hover{color:var(--danger);background:rgba(220,38,38,.06);}

/* ══ APP SHELL ═══════════════════════════════════════════════ */
.app-shell{display:flex;position:fixed;top:var(--navbar-h);left:0;right:0;bottom:0;overflow:hidden;}

/* ══ SIDEBAR ═════════════════════════════════════════════════ */
.sidebar{width:var(--sidebar-w);flex-shrink:0;background:var(--sidebar-bg);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;transition:width .22s cubic-bezier(.4,0,.2,1);position:relative;z-index:200;}
.sidebar.collapsed{width:52px;}
.sb-header{display:flex;align-items:center;gap:8px;padding:0 12px;height:46px;border-bottom:1px solid var(--border);flex-shrink:0;overflow:hidden;}
.sb-icon-box{width:26px;height:26px;border-radius:7px;background:linear-gradient(135deg,#0052cc,#2684ff);display:flex;align-items:center;justify-content:center;font-size:13px;color:#fff;flex-shrink:0;}
.sb-brand{flex:1;min-width:0;overflow:hidden;}
.sb-brand-name{font-size:12px;font-weight:700;color:var(--text);white-space:nowrap;}
.sb-brand-sub{font-size:9px;color:var(--muted);font-weight:500;}
.sidebar.collapsed .sb-brand{display:none;}
.sb-nav{flex:1;overflow-y:auto;overflow-x:hidden;padding:8px 0;}
.sb-nav::-webkit-scrollbar{width:3px;}
.sb-section-label{font-size:9px;font-weight:800;letter-spacing:1.1px;text-transform:uppercase;color:var(--muted-2);padding:10px 14px 3px;white-space:nowrap;overflow:hidden;display:block;}
.sidebar.collapsed .sb-section-label{display:none;}
.sb-item{display:flex;align-items:center;gap:10px;padding:7px 14px;cursor:pointer;font-size:12.5px;font-weight:500;color:var(--muted);transition:all .15s;white-space:nowrap;overflow:hidden;border:none;background:none;width:100%;text-align:left;position:relative;}
.sb-item:hover{background:var(--bg-subtle);color:var(--text);}
.sb-item.active{background:var(--primary-dim);color:var(--primary);font-weight:700;}
.sb-item.active::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--primary);border-radius:0 2px 2px 0;}
.sb-icon{font-size:15px;flex-shrink:0;width:18px;text-align:center;}
.sb-label{flex:1;overflow:hidden;text-overflow:ellipsis;}
.sidebar.collapsed .sb-item{justify-content:center;padding:9px 0;}
.sidebar.collapsed .sb-label,.sidebar.collapsed .sb-section-label{display:none;}
.sidebar.collapsed .sb-icon{font-size:17px;width:auto;}
.sb-divider{height:1px;background:var(--border);margin:6px 14px;}
.sidebar.collapsed .sb-divider{margin:6px 8px;}
.sb-footer{border-top:1px solid var(--border);padding:10px 12px;flex-shrink:0;display:flex;align-items:center;gap:8px;overflow:hidden;}
.sb-user-av{width:28px;height:28px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,#0052cc,#2684ff);display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:800;}
.sb-user-info{flex:1;min-width:0;overflow:hidden;}
.sb-user-name{font-size:11px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.sb-user-role{font-size:10px;color:var(--muted);}
.sidebar.collapsed .sb-user-info{display:none;}
.sidebar.collapsed .sb-footer{justify-content:center;padding:10px 0;}
.sb-theme-btn{width:26px;height:26px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--muted);transition:all .15s;flex-shrink:0;}
.sb-theme-btn:hover{background:var(--bg-subtle);color:var(--text);}
.sidebar.collapsed .sb-theme-btn{display:none;}
.sb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:299;backdrop-filter:blur(2px);}
@media(max-width:768px){
  .sidebar{position:fixed;top:var(--navbar-h);bottom:0;left:0;z-index:300;transform:translateX(-100%);transition:transform .25s cubic-bezier(.4,0,.2,1);}
  .sidebar.mobile-open{transform:translateX(0);}
  .sb-overlay.visible{display:block;}
}

/* ══ CONTENT AREA ════════════════════════════════════════════ */
.content-area{flex:1;overflow-y:auto;overflow-x:hidden;display:flex;flex-direction:column;background:var(--bg);min-width:0;}
.content-header{background:var(--card);border-bottom:1px solid var(--border);padding:12px 24px;display:flex;align-items:center;gap:14px;flex-shrink:0;position:sticky;top:0;z-index:100;}
.ch-title{font-size:14px;font-weight:800;color:var(--text);}
.ch-sub{font-size:11px;color:var(--muted);}
.ch-actions{display:flex;align-items:center;gap:8px;margin-left:auto;}
.content-body{padding:24px;flex:1;}

/* ══ MODULE CARDS ════════════════════════════════════════════ */
.hub-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
@media(max-width:1100px){.hub-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:560px){.hub-grid{grid-template-columns:1fr;}}
.hub-card{background:var(--card);border:1px solid var(--border);border-top:3px solid var(--ac,var(--primary));border-radius:var(--radius);padding:20px;cursor:pointer;position:relative;overflow:hidden;box-shadow:var(--sh-xs);transition:transform .2s,box-shadow .2s,border-color .2s;display:flex;flex-direction:column;text-decoration:none;color:inherit;}
.hub-card:hover{transform:translateY(-3px);box-shadow:var(--sh-md);border-color:color-mix(in srgb,var(--ac,var(--primary)) 30%,var(--border));}
.hub-card-icon{width:40px;height:40px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:12px;flex-shrink:0;}
.hub-card-name{font-size:13px;font-weight:800;color:var(--text);margin-bottom:4px;}
.hub-card-desc{font-size:11.5px;color:var(--muted);line-height:1.55;flex:1;}
.hub-card-arrow{position:absolute;bottom:14px;right:16px;font-size:13px;color:var(--border-strong);transition:all .2s;}
.hub-card:hover .hub-card-arrow{transform:translateX(4px);color:var(--ac,var(--primary));}

/* color accents */
.hc-blue{--ac:#2563eb;}.hc-blue .hub-card-icon{background:rgba(37,99,235,.1);color:#2563eb;}
.hc-red{--ac:#dc2626;}.hc-red .hub-card-icon{background:rgba(220,38,38,.1);color:#dc2626;}
.hc-green{--ac:#059669;}.hc-green .hub-card-icon{background:rgba(5,150,105,.1);color:#059669;}
.hc-indigo{--ac:#4338ca;}.hc-indigo .hub-card-icon{background:rgba(67,56,202,.1);color:#4338ca;}
.hc-amber{--ac:#d97706;}.hc-amber .hub-card-icon{background:rgba(217,119,6,.1);color:#d97706;}
.hc-cyan{--ac:#0891b2;}.hc-cyan .hub-card-icon{background:rgba(8,145,178,.1);color:#0891b2;}
.hc-purple{--ac:#7c3aed;}.hc-purple .hub-card-icon{background:rgba(124,58,237,.1);color:#7c3aed;}

/* ══ SECTION HEADER ══════════════════════════════════════════ */
.sec-hdr{display:flex;align-items:center;gap:10px;margin-bottom:18px;}
.sec-hdr-icon{width:34px;height:34px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;}
.sec-hdr-title{font-size:15px;font-weight:800;color:var(--text);}
.sec-hdr-sub{font-size:11px;color:var(--muted);}

/* panels */
.hub-panel{display:none;}
.hub-panel.active{display:block;}

@media(max-width:768px){
  .content-body{padding:16px;}
  .nav-breadcrumb,.nav-username{display:none;}
}
</style>
</head>
<body>
<%
  const _u     = user || {};
  const _name  = _u.full_name || _u.name || _u.email || 'Usuario';
  const _parts = _name.trim().split(/\s+/);
  const _ini   = (_parts[0]?.[0]||'U').toUpperCase() + (_parts[1]?.[0]||'').toUpperCase();
  const _first = _parts[0] || 'Usuario';
  const _role  = _u.role || 'agente';
  const _cfg   = (typeof tenantCfg !== 'undefined' && tenantCfg) ? tenantCfg : {};
  const _tname = _cfg.name ?? 'Portal TI';
%>

<!-- ══ NAVBAR ══════════════════════════════════════════════ -->
<nav class="navbar">
  <button class="nav-hamburger" onclick="toggleSidebar()" title="Menú"><i class="bi bi-layout-sidebar"></i></button>
  <div class="nav-brand">
    <img src="/images/movistar-logo.png" alt="Logo" class="nav-logo" onerror="this.style.display='none'">
    <span class="nav-divider"></span>
    <span class="nav-name"><%= _tname %></span>
    <span class="nav-badge">ITSM</span>
  </div>
  <div class="nav-breadcrumb">
    <span class="sep">·</span>
    <a href="/administracion"><i class="bi bi-shield-lock-fill" style="color:#7c3aed;font-size:10px;"></i> Admin</a>
    <span class="sep">/</span>
    <span class="cur"><i class="bi bi-headset"></i> ITSM</span>
  </div>
  <div class="nav-space"></div>
  <button class="nav-icon-btn" onclick="toggleTheme()" title="Cambiar tema"><i class="bi bi-moon-stars-fill" id="navThemeIcon"></i></button>
  <div class="nav-user">
    <div class="nav-avatar"><%= _ini %></div>
    <span class="nav-username"><%= _first %></span>
  </div>
  <a href="/api/auth/logout" class="nav-exit"><i class="bi bi-box-arrow-right"></i><span>Salir</span></a>
</nav>

<!-- ══ APP SHELL ════════════════════════════════════════════ -->
<div class="app-shell">

  <!-- SIDEBAR -->
  <div class="sidebar" id="sidebar">
    <div class="sb-header">
      <div class="sb-icon-box"><i class="bi bi-headset"></i></div>
      <div class="sb-brand">
        <div class="sb-brand-name">ITSM</div>
        <div class="sb-brand-sub">Centro de Servicios TI</div>
      </div>
    </div>
    <nav class="sb-nav">

      <a class="sb-item" href="/administracion" title="Volver al panel admin">
        <i class="bi bi-arrow-left-circle sb-icon" style="color:var(--muted-2);"></i>
        <span class="sb-label">← Administración</span>
      </a>
      <div class="sb-divider"></div>

      <!-- INCIDENCIAS -->
      <span class="sb-section-label">Incidencias</span>
      <button class="sb-item active" id="sb-inc" onclick="showPanel('inc',this)" title="Incidencias">
        <i class="bi bi-exclamation-triangle-fill sb-icon" style="color:#dc2626;"></i>
        <span class="sb-label">Gestión Incidencias</span>
      </button>
      <a class="sb-item" href="/itsm/incidencias/gestion" title="Ir a gestión">
        <i class="bi bi-ticket-detailed-fill sb-icon" style="color:#dc2626;opacity:.6;"></i>
        <span class="sb-label" style="font-size:12px;">Cola de tickets</span>
      </a>
      <a class="sb-item" href="/itsm/incidencias/registrar" title="Registrar incidencia">
        <i class="bi bi-pencil-square sb-icon" style="color:#2563eb;opacity:.6;"></i>
        <span class="sb-label" style="font-size:12px;">Registrar</span>
      </a>

      <!-- REQUERIMIENTOS -->
      <div class="sb-divider"></div>
      <span class="sb-section-label">Requerimientos</span>
      <button class="sb-item" id="sb-req" onclick="showPanel('req',this)" title="Requerimientos">
        <i class="bi bi-clipboard2-check-fill sb-icon" style="color:#7c3aed;"></i>
        <span class="sb-label">Gestión Requerimientos</span>
      </button>
      <a class="sb-item" href="/itsm/requerimientos/gestion" title="Ir a gestión">
        <i class="bi bi-clipboard2-check sb-icon" style="color:#7c3aed;opacity:.6;"></i>
        <span class="sb-label" style="font-size:12px;">Cola</span>
      </a>

      <!-- OTROS MÓDULOS -->
      <div class="sb-divider"></div>
      <span class="sb-section-label">Otros módulos</span>
      <button class="sb-item" id="sb-cam" onclick="showPanel('cam',this)" title="Cambios">
        <i class="bi bi-arrow-repeat sb-icon" style="color:#0891b2;"></i>
        <span class="sb-label">Cambios</span>
      </button>
      <button class="sb-item" id="sb-pro" onclick="showPanel('pro',this)" title="Problemas">
        <i class="bi bi-bug-fill sb-icon" style="color:#d97706;"></i>
        <span class="sb-label">Problemas</span>
      </button>
      <button class="sb-item" id="sb-cat" onclick="showPanel('cat',this)" title="Catálogo">
        <i class="bi bi-list-task sb-icon" style="color:#059669;"></i>
        <span class="sb-label">Catálogo</span>
      </button>
      <button class="sb-item" id="sb-cmdb" onclick="showPanel('cmdb',this)" title="CMDB">
        <i class="bi bi-diagram-3-fill sb-icon" style="color:#4338ca;"></i>
        <span class="sb-label">CMDB</span>
      </button>

    </nav>
    <div class="sb-footer">
      <div class="sb-user-av"><%= _ini %></div>
      <div class="sb-user-info">
        <div class="sb-user-name"><%= _name %></div>
        <div class="sb-user-role"><%= _role %></div>
      </div>
      <button class="sb-theme-btn" onclick="toggleTheme()" title="Cambiar tema">
        <i class="bi bi-moon-stars-fill" id="sbThemeIcon"></i>
      </button>
    </div>
  </div>

  <div class="sb-overlay" id="sbOverlay" onclick="closeSidebarMobile()"></div>

  <!-- CONTENT AREA -->
  <div class="content-area">

    <!-- ── PANEL: INCIDENCIAS ── -->
    <div class="hub-panel active" id="panel-inc">
      <div class="content-header">
        <div><div class="ch-title">Gestión de Incidencias</div><div class="ch-sub">Cola de tickets · SLA · Escalamientos</div></div>
        <div class="ch-actions">
          <a href="/itsm/incidencias/gestion" style="display:flex;align-items:center;gap:6px;padding:6px 14px;border-radius:var(--radius-sm);background:var(--primary);color:#fff;font-size:12px;font-weight:700;cursor:pointer;">
            <i class="bi bi-box-arrow-up-right"></i> Abrir gestión
          </a>
        </div>
      </div>
      <div class="content-body">
        <div class="hub-grid">
          <a href="/itsm/incidencias/registrar" class="hub-card hc-blue">
            <div class="hub-card-icon"><i class="bi bi-pencil-square"></i></div>
            <div class="hub-card-name">Registrar Incidencia</div>
            <div class="hub-card-desc">Formulario de registro para usuario o técnico de soporte. Crea el ticket en Jira automáticamente.</div>
            <i class="bi bi-arrow-right hub-card-arrow"></i>
          </a>
          <a href="/itsm/incidencias/gestion" class="hub-card hc-red">
            <div class="hub-card-icon"><i class="bi bi-ticket-detailed-fill"></i></div>
            <div class="hub-card-name">Gestión de Incidencias</div>
            <div class="hub-card-desc">Cola de tickets activos en Jira, asignación a especialistas, seguimiento de SLA y escalamientos.</div>
            <i class="bi bi-arrow-right hub-card-arrow"></i>
          </a>
          <a href="/itsm/incidencias/gestion?view=local" class="hub-card hc-green">
            <div class="hub-card-icon"><i class="bi bi-hdd-network-fill"></i></div>
            <div class="hub-card-name">Gestión Local</div>
            <div class="hub-card-desc">Tickets gestionados directamente en la plataforma interna con cuentas propias del sistema.</div>
            <i class="bi bi-arrow-right hub-card-arrow"></i>
          </a>
          <a href="/itsm/incidencias/gestion?tab=kpis" class="hub-card hc-purple">
            <div class="hub-card-icon"><i class="bi bi-bar-chart-line-fill"></i></div>
            <div class="hub-card-name">Indicadores</div>
            <div class="hub-card-desc">KPIs de SLA, MTTR, evolución de tickets y estadísticas por técnico.</div>
            <i class="bi bi-arrow-right hub-card-arrow"></i>
          </a>
          <a href="/itsm/incidencias/gestion?tab=tecnicos" class="hub-card hc-cyan">
            <div class="hub-card-icon"><i class="bi bi-people-fill"></i></div>
            <div class="hub-card-name">Estadísticas por Técnico</div>
            <div class="hub-card-desc">Carga de trabajo, tickets activos, vencidos y tiempo de resolución por especialista.</div>
            <i class="bi bi-arrow-right hub-card-arrow"></i>
          </a>
          <a href="/itsm/noc" class="hub-card hc-amber">
            <div class="hub-card-icon"><i class="bi bi-display-fill"></i></div>
            <div class="hub-card-name">NOC · Dashboard TV</div>
            <div class="hub-card-desc">Vista en tiempo real optimizada para pantalla en sala de operaciones.</div>
            <i class="bi bi-arrow-right hub-card-arrow"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- ── PANEL: REQUERIMIENTOS ── -->
