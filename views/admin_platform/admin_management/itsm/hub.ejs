<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<script>(function(){document.documentElement.setAttribute('data-theme',localStorage.getItem('dashboardTheme')||'light');})();</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ITSM · Centro de Servicios TI</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<%- include('../../../shared/partials/autogestion/styles') %>
<style>
/* ── Admin navbar tokens (match /administracion) ── */
:root,[data-theme="light"]{
  --nav-bg:rgba(255,255,255,.95);
  --navbar-h:44px;
  --border:#e2e8f0;
  --text:#0f172a;--text-2:#1e293b;--muted:#64748b;--muted-2:#94a3b8;
  --primary:#2563eb;--bg-subtle:#e9eef5;
}
[data-theme="dark"]{
  --nav-bg:rgba(8,13,28,.95);
  --border:#1e293b;
  --text:#f1f5f9;--text-2:#e2e8f0;--muted:#94a3b8;--muted-2:#64748b;
  --primary:#3b82f6;--bg-subtle:#0d1425;
}

/* ── Navbar ── */
.adm-navbar{
  position:fixed;top:0;left:0;right:0;z-index:9000;
  height:var(--navbar-h);display:flex;align-items:center;gap:6px;padding:0 16px;
  background:var(--nav-bg);backdrop-filter:blur(16px) saturate(160%);
  -webkit-backdrop-filter:blur(16px) saturate(160%);
  border-bottom:1px solid var(--border);
  font-family:'DM Sans',-apple-system,'Segoe UI',sans-serif;
}
.adm-nav-brand{display:flex;align-items:center;gap:7px;padding:0 8px;}
.adm-nav-logo{height:18px;width:auto;}
.adm-nav-divider{width:1px;height:16px;background:var(--border);}
.adm-nav-name{font-size:12px;font-weight:700;color:var(--text);}
.adm-nav-badge{font-size:8px;font-weight:800;padding:1px 6px;border-radius:20px;background:linear-gradient(135deg,#0052cc,#2684ff);color:#fff;letter-spacing:.5px;text-transform:uppercase;}
.adm-nav-space{flex:1;}
.adm-nav-btn{width:30px;height:30px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--muted);transition:all .15s;cursor:pointer;border:none;background:none;}
.adm-nav-btn:hover{background:var(--bg-subtle);color:var(--text);}
.adm-nav-user{display:flex;align-items:center;gap:5px;padding:3px 8px 3px 4px;border-radius:20px;background:var(--bg-subtle);border:1px solid var(--border);}
.adm-nav-avatar{width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,#0052cc,#2684ff);display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:800;}
.adm-nav-username{font-size:11px;font-weight:600;color:var(--text-2);max-width:90px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.adm-nav-exit{display:flex;align-items:center;gap:4px;padding:5px 10px;border-radius:5px;font-size:11px;font-weight:600;color:var(--muted);transition:all .15s;cursor:pointer;border:none;background:none;text-decoration:none;}
.adm-nav-exit:hover{color:#dc2626;background:rgba(220,38,38,.06);}
.adm-nav-breadcrumb{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--muted);padding:0 4px;}
.adm-nav-breadcrumb a{color:var(--muted);text-decoration:none;font-weight:500;}
.adm-nav-breadcrumb a:hover{color:var(--primary);}
.adm-nav-breadcrumb .sep{opacity:.4;font-size:10px;}
.adm-nav-breadcrumb .cur{color:var(--text-2);font-weight:700;}

/* ── Layout adjustment for fixed navbar ── */
body::before{top:var(--navbar-h);}
.home-wrapper{padding-top:calc(var(--navbar-h) + 28px);padding-bottom:60px;}

/* ── Hide old floating toggle ── */
.theme-toggle{display:none!important;}

/* ── Sub-module cards (3 col) ── */
.sub-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;width:100%;max-width:1040px;}
@media(max-width:740px){.sub-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:460px){.sub-grid{grid-template-columns:1fr;}}

/* ── Tabs wrapper limit ── */
.tabs-wrapper,.tab-panel{width:100%;max-width:1040px;}
.section-label{font-family:'DM Sans',-apple-system,sans-serif;font-size:11px;font-weight:800;letter-spacing:.8px;text-transform:uppercase;color:var(--text-muted);display:flex;align-items:center;gap:8px;margin-bottom:14px;padding-bottom:6px;border-bottom:1px solid var(--border-soft);}
.home-footer{font-family:'DM Sans',-apple-system,sans-serif;}

/* ── Mobile ── */
@media(max-width:680px){
  .adm-nav-breadcrumb,.adm-nav-username{display:none;}
  .home-wrapper{padding-top:calc(var(--navbar-h) + 16px);}
}
</style>
</head>
<body>
<%
  const _u    = user || {};
  const _name = _u.full_name || _u.name || _u.email || 'Usuario';
  const _pts  = _name.trim().split(/\s+/);
  const _ini  = (_pts[0]?.[0]||'U').toUpperCase() + (_pts[1]?.[0]||'').toUpperCase();
  const _fst  = _pts[0] || 'Usuario';
  const _cfg  = (typeof tenantCfg !== 'undefined' && tenantCfg) ? tenantCfg : {};
  const _tname = _cfg.name ?? 'Portal TI';
%>

<!-- ══ NAVBAR (igual que /administracion) ══ -->
<nav class="adm-navbar">
  <div class="adm-nav-brand">
    <img src="/images/movistar-logo.png" alt="Logo" class="adm-nav-logo" onerror="this.style.display='none'">
    <span class="adm-nav-divider"></span>
    <span class="adm-nav-name"><%= _tname %></span>
    <span class="adm-nav-badge">ITSM</span>
  </div>
  <div class="adm-nav-breadcrumb">
    <span class="sep">·</span>
    <a href="/administracion"><i class="bi bi-shield-lock-fill" style="color:#7c3aed;font-size:10px;"></i> Admin</a>
    <span class="sep">/</span>
    <span class="cur"><i class="bi bi-headset"></i> ITSM</span>
  </div>
  <div class="adm-nav-space"></div>
  <button class="adm-nav-btn" onclick="toggleTheme()" title="Cambiar tema" id="_navThemeBtn">
    <i class="bi bi-moon-stars-fill" id="_navThemeIcon"></i>
  </button>
  <div class="adm-nav-user">
    <div class="adm-nav-avatar"><%= _ini %></div>
    <span class="adm-nav-username"><%= _fst %></span>
  </div>
  <a href="/api/auth/logout" class="adm-nav-exit"><i class="bi bi-box-arrow-right"></i><span>Salir</span></a>
</nav>

<!-- viejo toggle — oculto por CSS, lo necesitamos para que los scripts del partial funcionen -->
<div class="theme-toggle" onclick="toggleTheme()" style="display:none!important;">
  <i id="toggleIcon" class="bi bi-moon-stars-fill toggle-icon"></i>
  <div class="toggle-track"><div class="toggle-knob"></div></div>
  <span id="toggleLabel" class="toggle-label">Oscuro</span>
</div>

<div class="home-wrapper">

  <!-- TABS NAV -->
  <div class="tabs-wrapper">
    <div class="tabs-nav">
      <button class="tab-btn active" id="tb-inc"  onclick="switchTab('inc',this)"><i class="bi bi-exclamation-triangle-fill"></i> Incidencias</button>
      <button class="tab-btn"        id="tb-req"  onclick="switchTab('req',this)"><i class="bi bi-clipboard2-check-fill"></i> Requerimientos</button>
      <button class="tab-btn"        id="tb-cam"  onclick="switchTab('cam',this)"><i class="bi bi-arrow-repeat"></i> Cambios</button>
      <button class="tab-btn"        id="tb-pro"  onclick="switchTab('pro',this)"><i class="bi bi-bug-fill"></i> Problemas</button>
      <button class="tab-btn"        id="tb-cat"  onclick="switchTab('cat',this)"><i class="bi bi-list-task"></i> Catálogo</button>
      <button class="tab-btn"        id="tb-cmdb" onclick="switchTab('cmdb',this)"><i class="bi bi-diagram-3-fill"></i> CMDB</button>
    </div>
  </div>

  <!-- TAB: INCIDENCIAS -->
  <div class="tab-panel active" id="panel-inc">
    <div class="section-label"><i class="bi bi-exclamation-triangle-fill" style="color:#dc2626;"></i> Gestión de Incidencias</div>
    <div class="sub-grid">
      <a href="/itsm/incidencias/registrar" class="mod-card c-blue">
        <div class="mod-icon ib ib-blue"><i class="bi bi-pencil-square"></i></div>
        <div class="mod-name">Registrar Incidencia</div>
        <div class="mod-desc">Abre el formulario de registro de incidencias para el usuario o el técnico de soporte.</div>
        <i class="bi bi-arrow-right mod-arrow"></i>
      </a>
      <a href="/itsm/incidencias/gestion" class="mod-card c-red">
        <div class="mod-icon ib ib-red"><i class="bi bi-ticket-detailed-fill"></i></div>
        <div class="mod-name">Gestión de Incidencias</div>
        <div class="mod-desc">Cola de tickets activos, asignación a especialistas, SLA y escalamientos.</div>
        <i class="bi bi-arrow-right mod-arrow"></i>
      </a>
      <a href="/itsm/incidencias/gestion?view=local" class="mod-card c-green">
        <div class="mod-icon ib ib-green"><i class="bi bi-hdd-network-fill"></i></div>
        <div class="mod-name">Gestión Local</div>
        <div class="mod-desc">Tickets gestionados directamente en la plataforma interna, con cuentas propias del sistema.</div>
        <i class="bi bi-arrow-right mod-arrow"></i>
      </a>
    </div>
  </div>

  <!-- TAB: REQUERIMIENTOS -->
  <div class="tab-panel" id="panel-req">
    <div class="section-label"><i class="bi bi-clipboard2-check-fill" style="color:#7c3aed;"></i> Gestión de Requerimientos</div>
    <div class="sub-grid">
      <a href="/itsm/requerimientos/registrar" class="mod-card c-blue">
        <div class="mod-icon ib ib-blue"><i class="bi bi-clipboard2-plus-fill"></i></div>
        <div class="mod-name">Registrar Requerimiento</div>
        <div class="mod-desc">Abre el formulario para solicitar formalmente un servicio, recurso o mejora tecnológica.</div>
        <i class="bi bi-arrow-right mod-arrow"></i>
      </a>
      <a href="/itsm/requerimientos/gestion" class="mod-card c-indigo">
        <div class="mod-icon ib ib-indigo"><i class="bi bi-clipboard2-check-fill"></i></div>
        <div class="mod-name">Gestión de Requerimientos</div>
        <div class="mod-desc">Cola de requerimientos activos en Jira, asignación a especialistas y seguimiento SLA.</div>
        <i class="bi bi-arrow-right mod-arrow"></i>
      </a>
      <a href="/itsm/requerimientos/gestion?view=local" class="mod-card c-green">
        <div class="mod-icon ib ib-green"><i class="bi bi-hdd-network-fill"></i></div>
        <div class="mod-name">Gestión Local</div>
        <div class="mod-desc">Requerimientos gestionados directamente en la plataforma interna, con cuentas propias del sistema.</div>
        <i class="bi bi-arrow-right mod-arrow"></i>
      </a>
    </div>
  </div>

  <!-- TAB: CAMBIOS -->
  <div class="tab-panel" id="panel-cam">
    <div class="section-label"><i class="bi bi-arrow-repeat" style="color:#0891b2;"></i> Gestión de Cambios</div>
    <div class="sub-grid">
      <a href="/cambios?view=local" class="mod-card c-green">
        <div class="mod-icon ib ib-green"><i class="bi bi-hdd-network-fill"></i></div>
        <div class="mod-name">Gestión Local</div>
        <div class="mod-desc">Cambios gestionados internamente en la plataforma, sin depender de herramientas externas.</div>
        <i class="bi bi-arrow-right mod-arrow"></i>
      </a>
    </div>
  </div>

  <!-- TAB: PROBLEMAS -->
  <div class="tab-panel" id="panel-pro">
    <div class="section-label"><i class="bi bi-bug-fill" style="color:#d97706;"></i> Gestión de Problemas</div>
    <div class="sub-grid">
      <a href="/problemas?view=local" class="mod-card c-green">
        <div class="mod-icon ib ib-green"><i class="bi bi-hdd-network-fill"></i></div>
        <div class="mod-name">Gestión Local</div>
        <div class="mod-desc">Problemas registrados y gestionados directamente en la plataforma interna del equipo.</div>
        <i class="bi bi-arrow-right mod-arrow"></i>
      </a>
    </div>
  </div>

  <!-- TAB: CATÁLOGO -->
  <div class="tab-panel" id="panel-cat">
    <div class="section-label"><i class="bi bi-list-task" style="color:#059669;"></i> Catálogo de Servicios</div>
    <div class="sub-grid">
      <a href="/catalogo?view=local" class="mod-card c-green">
        <div class="mod-icon ib ib-green"><i class="bi bi-hdd-network-fill"></i></div>
        <div class="mod-name">Gestión Local</div>
        <div class="mod-desc">Administración del catálogo desde la plataforma interna, servicios propios del equipo TI.</div>
        <i class="bi bi-arrow-right mod-arrow"></i>
      </a>
      <a href="/catalogo?tab=admin" class="mod-card c-indigo">
        <div class="mod-icon ib ib-indigo"><i class="bi bi-people-fill"></i></div>
        <div class="mod-name">Administración</div>
        <div class="mod-desc">Gestión de usuarios del sistema: creación, activación y control de accesos por rol.</div>
        <i class="bi bi-arrow-right mod-arrow"></i>
      </a>
    </div>
  </div>

  <!-- TAB: CMDB -->
  <div class="tab-panel" id="panel-cmdb">
    <div class="section-label"><i class="bi bi-diagram-3-fill" style="color:#0891b2;"></i> CMDB</div>
    <div class="sub-grid">
      <a href="/cmdb?view=local" class="mod-card c-green">
        <div class="mod-icon ib ib-green"><i class="bi bi-hdd-network-fill"></i></div>
        <div class="mod-name">Gestión Local</div>
        <div class="mod-desc">CIs y relaciones gestionados directamente en la plataforma interna del inventario.</div>
        <i class="bi bi-arrow-right mod-arrow"></i>
      </a>
    </div>
  </div>

  <div class="home-footer" style="margin-top:32px;">© 2025 Stefanini Group &nbsp;·&nbsp; IT Service Management &nbsp;·&nbsp; ITIL v4</div>
</div>

<script>
/* ── THEME ── */
(function(){
  const s = localStorage.getItem('dashboardTheme') || 'light';
  document.documentElement.setAttribute('data-theme', s);
  _syncUI(s);
})();
function toggleTheme(){
  const n = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', n);
  localStorage.setItem('dashboardTheme', n);
  _syncUI(n);
}
function _syncUI(t){
  const dark = t === 'dark';
  const ico = document.getElementById('_navThemeIcon');
  if(ico) ico.className = dark ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
  // sync old toggle (oculto pero mantiene knob)
  const oi = document.getElementById('toggleIcon');
  if(oi) oi.className = dark ? 'bi bi-sun-fill toggle-icon' : 'bi bi-moon-stars-fill toggle-icon';
  const lbl = document.getElementById('toggleLabel');
  if(lbl) lbl.textContent = dark ? 'Claro' : 'Oscuro';
}
/* ── TABS ── */
function switchTab(name, btn){
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('panel-' + name).classList.add('active');
  btn.classList.add('active');
}
document.addEventListener('DOMContentLoaded', function(){
  const tab = new URLSearchParams(location.search).get('tab');
  if(tab){ const btn = document.getElementById('tb-' + tab); if(btn) switchTab(tab, btn); }
});
</script>

<!-- Socket.io notificación consulta especialista -->
<div id="_hubToastWrap" style="position:fixed;bottom:20px;right:20px;z-index:9999;display:flex;flex-direction:column;gap:8px;align-items:flex-end;pointer-events:none;"></div>
<script src="/socket.io/socket.io.js"></script>
<script>
(function(){
  if(typeof io === 'undefined') return;
  const _sk = io({ transports:['websocket','polling'] });
  _sk.on('connect', function(){ _sk.emit('joinAgents'); });
  _sk.on('consult:new', function(data){
    const name = data.userName || data.userEmail || 'Usuario';
    const wrap = document.getElementById('_hubToastWrap');
    const t = document.createElement('div');
    t.style.cssText = 'pointer-events:all;background:#fff;border:1.5px solid #0891b2;border-radius:12px;box-shadow:0 4px 20px rgba(8,145,178,.25);padding:12px 16px;max-width:320px;display:flex;align-items:flex-start;gap:10px;animation:uaIn .3s ease;';
    t.innerHTML = '<span style="font-size:20px;flex-shrink:0;">💬</span><div style="flex:1;"><div style="font-size:13px;font-weight:700;color:#0f172a;margin-bottom:2px;">Nueva consulta</div><div style="font-size:12px;color:#334155;"><b>'+name+'</b> solicita hablar con un especialista.</div><div style="margin-top:8px;display:flex;gap:6px;"><a href="/itsm/incidencias/gestion?consultId='+data.id+'" style="font-size:12px;font-weight:700;color:#fff;background:#0891b2;padding:5px 12px;border-radius:7px;text-decoration:none;">Atender</a><button onclick="this.closest(\'div[style]\').remove()" style="font-size:12px;color:#64748b;background:none;border:1.5px solid #e2e8f0;border-radius:7px;padding:5px 10px;cursor:pointer;">Cerrar</button></div></div>';
    wrap.appendChild(t);
    setTimeout(function(){ if(t.parentNode) t.remove(); }, 10000);
  });
})();
</script>
<style>@keyframes uaIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}</style>
</body>
</html>
