<script>
/* ── THEME ── */
(function(){
  const t = localStorage.getItem('dashboardTheme') || 'light';
  document.documentElement.setAttribute('data-theme', t);
  _syncTheme(t);
})();
function toggleTheme(){
  const n = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', n);
  localStorage.setItem('dashboardTheme', n);
  _syncTheme(n);
}
function _syncTheme(t){
  const dark = t === 'dark';
  const ni = document.getElementById('navThemeIcon'); if(ni) ni.className = dark ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
  const si = document.getElementById('sbThemeIcon');  if(si) si.className = dark ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
}

/* ── SIDEBAR ── */
let _sbCollapsed = localStorage.getItem('itsmSbCollapsed') === '1';
function toggleSidebar(){
  const sb = document.getElementById('sidebar');
  if(window.innerWidth <= 768){
    sb.classList.toggle('mobile-open');
    document.getElementById('sbOverlay').classList.toggle('visible', sb.classList.contains('mobile-open'));
  } else {
    _sbCollapsed = !_sbCollapsed;
    sb.classList.toggle('collapsed', _sbCollapsed);
    localStorage.setItem('itsmSbCollapsed', _sbCollapsed ? '1' : '0');
  }
}
function closeSidebarMobile(){
  document.getElementById('sidebar').classList.remove('mobile-open');
  document.getElementById('sbOverlay').classList.remove('visible');
}
(function(){
  if(_sbCollapsed) document.getElementById('sidebar').classList.add('collapsed');
})();

/* ── PANELS ── */
function showPanel(name, btn){
  document.querySelectorAll('.hub-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.sb-item[id^="sb-"]').forEach(b => { b.classList.remove('active'); });
  document.getElementById('panel-' + name).classList.add('active');
  document.getElementById('sb-' + name).classList.add('active');
  if(window.innerWidth <= 768) closeSidebarMobile();
}

/* Deep-link: /itsm?tab=req */
document.addEventListener('DOMContentLoaded', function(){
  const tab = new URLSearchParams(location.search).get('tab');
  const map = { req:'req', cam:'cam', pro:'pro', cat:'cat', cmdb:'cmdb' };
  if(tab && map[tab]){
    const btn = document.getElementById('sb-' + map[tab]);
    if(btn) showPanel(map[tab], btn);
  }
});
</script>

<!-- Socket.io notificación consulta especialista -->
<div id="_hubToastWrap" style="position:fixed;bottom:20px;right:20px;z-index:9999;display:flex;flex-direction:column;gap:8px;align-items:flex-end;pointer-events:none;"></div>
<script src="/socket.io/socket.io.js"></script>
<script>
(function(){
  if(typeof io === 'undefined') return;
  const _sk = io({ transports:['websocket','polling'] });
  _sk.on('connect', function(){ _sk.emit('joinAgents'); });
  _sk.on('consult:new', function(data){
    const name = data.userName || data.userEmail || 'Usuario';
    const wrap = document.getElementById('_hubToastWrap');
    const t = document.createElement('div');
    t.style.cssText = 'pointer-events:all;background:var(--card);border:1.5px solid #0891b2;border-radius:12px;box-shadow:0 4px 20px rgba(8,145,178,.25);padding:12px 16px;max-width:320px;display:flex;align-items:flex-start;gap:10px;animation:uaIn .3s ease;';
    t.innerHTML = '<span style="font-size:20px;flex-shrink:0;">💬</span><div style="flex:1;"><div style="font-size:13px;font-weight:700;color:var(--text);margin-bottom:2px;">Nueva consulta</div><div style="font-size:12px;color:var(--muted);"><b>'+name+'</b> solicita hablar con un especialista.</div><div style="margin-top:8px;display:flex;gap:6px;"><a href="/itsm/incidencias/gestion?consultId='+data.id+'" style="font-size:12px;font-weight:700;color:#fff;background:#0891b2;padding:5px 12px;border-radius:7px;text-decoration:none;">Atender</a><button onclick="this.closest(\'div\').parentElement.parentElement.remove()" style="font-size:12px;color:var(--muted);background:none;border:1.5px solid var(--border);border-radius:7px;padding:5px 10px;cursor:pointer;">Cerrar</button></div></div>';
    wrap.appendChild(t);
    setTimeout(function(){ if(t.parentNode) t.remove(); }, 10000);
  });
})();
</script>
<style>@keyframes uaIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}</style>
</body>
</html>
