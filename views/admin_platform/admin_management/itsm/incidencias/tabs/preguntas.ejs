var DEV_STATUS_LABEL = { pendiente:'Pendiente', aprobado:'Aprobado', rechazado:'Rechazado' };
var DEV_STATUS_COLOR = { pendiente:'#f59e0b',  aprobado:'#10b981',  rechazado:'#dc2626'   };

async function loadDevolucionRequests(){
  var status = document.getElementById('devReqFilter') ? document.getElementById('devReqFilter').value : '';
  var url = '/api/portal/devoluciones' + (status ? '?status='+encodeURIComponent(status) : '');
  var list = document.getElementById('devReqList');
  if(!list) return;
  list.innerHTML = '<div style="text-align:center;padding:32px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split" style="font-size:26px;display:block;margin-bottom:8px;opacity:.4;"></i>Cargando...</div>';
  try {
    var r = await fetch(url, { credentials:'include' });
    var d = await r.json();
    var rows = d.data || [];
    var pending = rows.filter(function(x){ return x.status==='pendiente'; }).length;
    var badge = document.getElementById('devReqBadge');
    if(badge){ badge.style.display=pending>0?'':'none'; badge.textContent=pending; }
    if(!rows.length){
      list.innerHTML='<div style="text-align:center;padding:40px;color:var(--text-muted);font-size:13px;"><i class="bi bi-inbox" style="font-size:32px;display:block;margin-bottom:8px;opacity:.3;"></i>No hay solicitudes de devolución.</div>';
      return;
    }
    list.innerHTML = (pending>0?`<div style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:10px 16px;font-size:12px;color:#92400e;display:flex;align-items:center;gap:8px;border-bottom-left-radius:0;border-bottom-right-radius:0;">
      <i class="bi bi-exclamation-triangle-fill" style="color:#f59e0b;"></i>
      <strong>${pending}</strong> solicitud${pending>1?'es':''} pendiente${pending>1?'s':''} de aprobación</div>`:'') +
    `<div style="overflow-x:auto;"><table class="table-tickets w-100" style="font-size:13px;"><thead><tr>
      <th style="padding:10px 14px;">Empleado</th>
      <th style="padding:10px 14px;">Correo</th>
      <th style="padding:10px 14px;text-align:center;">Checklist</th>
      <th style="padding:10px 14px;text-align:center;">Firma</th>
      <th style="padding:10px 14px;text-align:center;">Foto</th>
      <th style="padding:10px 14px;white-space:nowrap;">Fecha</th>
      <th style="padding:10px 14px;text-align:center;">Estado</th>
      <th style="padding:10px 14px;text-align:center;">Acciones</th>
    </tr></thead><tbody>${rows.map(function(dev){
      var sc=DEV_STATUS_COLOR[dev.status]||'#94a3b8';
      var sl=DEV_STATUS_LABEL[dev.status]||dev.status;
      var fecha=dev.created_at?new Date(dev.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}):'—';
      var checks=[dev.devolvio_celular?'📱':'',dev.entrego_fotocheck?'🪪':'',dev.mantiene_llave?'🔑':'',dev.entrego_mochila?'🎒':''].filter(Boolean).join(' ')||'—';
      var fotoCell=dev.foto_data?'<img src="'+dev.foto_data+'" style="width:40px;height:40px;object-fit:cover;border-radius:6px;cursor:pointer;border:1px solid var(--border-soft);" onclick="window.open(\''+dev.foto_data+'\',\'_blank\')" alt="foto">':'<span style="color:#94a3b8;font-size:11px;">—</span>';
      return '<tr style="'+(dev.status==='pendiente'?'background:#fffbeb;':'')+'">' +
        '<td style="padding:10px 14px;font-weight:600;">'+escHtmlPq(dev.employee_name||'—')+'</td>'+
        '<td style="padding:10px 14px;color:var(--text-muted);font-size:12px;">'+escHtmlPq(dev.employee_email||'—')+'</td>'+
        '<td style="padding:10px 14px;text-align:center;font-size:16px;">'+checks+'</td>'+
        '<td style="padding:10px 14px;text-align:center;">'+(dev.firma_digital?'<span style="color:#10b981;font-weight:700;font-size:12px;">✅ Sí</span>':'<span style="color:#94a3b8;font-size:11px;">—</span>')+'</td>'+
        '<td style="padding:10px 14px;text-align:center;">'+fotoCell+'</td>'+
        '<td style="padding:10px 14px;white-space:nowrap;color:var(--text-muted);font-size:12px;">'+fecha+'</td>'+
        '<td style="padding:10px 14px;text-align:center;"><span style="font-size:11px;font-weight:700;color:'+sc+';background:'+sc+'20;border-radius:6px;padding:3px 10px;white-space:nowrap;">'+sl+'</span></td>'+
        '<td style="padding:10px 14px;text-align:center;"><div style="display:flex;gap:6px;justify-content:center;">'+
          (dev.status!=='aprobado'?'<button onclick="devApprove('+dev.id+')" style="padding:5px 12px;border-radius:7px;border:1px solid #10b981;background:rgba(16,185,129,.08);color:#059669;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;"><i class="bi bi-check-circle-fill"></i> Aprobar</button>':'')+
          (dev.status!=='rechazado'?'<button onclick="devReject('+dev.id+')" style="padding:5px 12px;border-radius:7px;border:1px solid #f59e0b;background:rgba(245,158,11,.08);color:#b45309;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;"><i class="bi bi-x-circle"></i> Rechazar</button>':'')+
        '</div></td></tr>';
    }).join('')}</tbody></table></div>`;
  } catch(e) {
    list.innerHTML = '<div style="color:#dc2626;font-size:13px;padding:20px;">Error: '+e.message+'</div>';
  }
}

