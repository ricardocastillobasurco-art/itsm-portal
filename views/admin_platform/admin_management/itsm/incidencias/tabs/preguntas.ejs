var KB_REQ_STATUS_LABEL = { pendiente:'Pendiente', en_progreso:'En progreso', resuelto:'Resuelto' };
var KB_REQ_STATUS_COLOR = { pendiente:'#b45309', en_progreso:'#1e40af', resuelto:'#065f46' };
var KB_REQ_STATUS_BG    = { pendiente:'#fef3c7', en_progreso:'#dbeafe',  resuelto:'#d1fae5' };

async function loadKbRequests(){
  var status = document.getElementById('kbReqFilter') ? document.getElementById('kbReqFilter').value : '';
  var url    = '/api/kb/procedure-requests' + (status ? '?status='+encodeURIComponent(status) : '');
  var list   = document.getElementById('kbReqList');
  if(!list) return;
  list.innerHTML = '<div style="text-align:center;padding:32px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split" style="font-size:26px;display:block;margin-bottom:8px;opacity:.4;"></i>Cargando...</div>';
  try {
    var r = await fetch(url, { credentials:'include' });
    var d = await r.json();
    var rows = d.data || [];

    var pending = rows.filter(function(x){ return x.status==='pendiente'; }).length;
    var badge = document.getElementById('kbReqBadge');
    if(badge){ badge.style.display = pending>0?'':'none'; badge.textContent=pending; }

    if(!rows.length){
      list.innerHTML='<div style="text-align:center;padding:40px;color:var(--text-muted);font-size:13px;"><i class="bi bi-inbox" style="font-size:28px;display:block;margin-bottom:8px;opacity:.4;"></i>Sin solicitudes'+(status?' con este estado':'')+'</div>';
      return;
    }

    var html='<table style="width:100%;border-collapse:collapse;font-size:13px;"><thead><tr style="background:var(--bg-main);">';
    ['#','Usuario','Correo','Procedimiento solicitado','Descripción','Fecha','Estado','Acción'].forEach(function(h){
      html+='<th style="padding:10px 14px;font-size:11px;font-weight:700;text-transform:uppercase;color:var(--text-muted);border-bottom:2px solid var(--border-soft);text-align:left;">'+h+'</th>';
    });
    html+='</tr></thead><tbody>';

    rows.forEach(function(req){
      var col=KB_REQ_STATUS_COLOR[req.status]||'#64748b';
      var bg=KB_REQ_STATUS_BG[req.status]||'#f1f5f9';
      var lbl=KB_REQ_STATUS_LABEL[req.status]||req.status;
      var date=req.created_at?new Date(req.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}):'—';
      var rowBg=req.status==='pendiente'?'background:#fffbeb;':'';
      html+='<tr style="'+rowBg+'">';
      html+='<td style="padding:10px 14px;border-bottom:1px solid var(--border-soft);font-weight:700;color:var(--text-muted);">#'+req.id+'</td>';
      html+='<td style="padding:10px 14px;border-bottom:1px solid var(--border-soft);font-weight:600;">'+(req.user_name||'—')+'</td>';
      html+='<td style="padding:10px 14px;border-bottom:1px solid var(--border-soft);color:var(--text-muted);font-size:12px;">'+(req.user_email||'—')+'</td>';
      html+='<td style="padding:10px 14px;border-bottom:1px solid var(--border-soft);font-weight:700;max-width:220px;">'+escKb(req.query)+'</td>';
      html+='<td style="padding:10px 14px;border-bottom:1px solid var(--border-soft);color:var(--text-muted);font-size:12px;max-width:180px;">'+escKb(req.description||'—')+'</td>';
      html+='<td style="padding:10px 14px;border-bottom:1px solid var(--border-soft);font-size:12px;white-space:nowrap;">'+date+'</td>';
      html+='<td style="padding:10px 14px;border-bottom:1px solid var(--border-soft);"><span style="padding:3px 10px;border-radius:10px;font-size:10px;font-weight:700;background:'+bg+';color:'+col+';">'+lbl+'</span></td>';
      html+='<td style="padding:10px 14px;border-bottom:1px solid var(--border-soft);"><div style="display:flex;gap:4px;">';
      if(req.status!=='resuelto')  html+='<button title="Marcar resuelto" onclick="updateKbReqStatus('+req.id+',\'resuelto\')" style="padding:5px 10px;border-radius:7px;border:none;background:#10b981;color:#fff;font-size:11px;font-weight:700;cursor:pointer;"><i class="bi bi-check2"></i></button>';
      if(req.status==='pendiente') html+='<button title="En progreso" onclick="updateKbReqStatus('+req.id+',\'en_progreso\')" style="padding:5px 10px;border-radius:7px;border:none;background:#3b82f6;color:#fff;font-size:11px;font-weight:700;cursor:pointer;"><i class="bi bi-play-fill"></i></button>';
      html+='</div></td></tr>';
    });
    html+='</tbody></table>';
    list.innerHTML=html;
  } catch(e){
    list.innerHTML='<div style="text-align:center;padding:32px;color:#dc2626;font-size:13px;">Error al cargar solicitudes</div>';
  }
}

async function updateKbReqStatus(id, status){
  try {
    var r = await fetch('/api/kb/procedure-requests/'+id+'/status',{
      method:'PATCH', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({status})
    });
    var d = await r.json();
    if(d.success) loadKbRequests(); else alert('Error: '+(d.error||''));
  } catch(e){ alert('Error de conexión'); }
}

function escKb(s){ var d=document.createElement('div'); d.textContent=String(s||''); return d.innerHTML; }

