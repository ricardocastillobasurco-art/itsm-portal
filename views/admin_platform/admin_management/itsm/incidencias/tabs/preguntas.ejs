    var rows=d.data||[];
    var pending=rows.filter(g=>g.status==='pendiente').length;
    if(badge){ badge.textContent=pending; badge.style.display=pending?'':'none'; }
    if(!rows.length){ list.innerHTML='<div style="padding:40px;text-align:center;color:var(--text-muted);font-size:13px;"><i class="bi bi-inbox" style="font-size:28px;display:block;margin-bottom:8px;opacity:.4;"></i>No hay solicitudes.</div>'; return; }
    window.garDenData={};
    var html='<div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;font-size:13px;"><thead><tr style="background:var(--bg-main);">'
      +'<th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;white-space:nowrap;">Empleado</th>'
      +'<th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;white-space:nowrap;">Tipo</th>'
      +'<th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;white-space:nowrap;">Equipo / Detalle</th>'
      +'<th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;white-space:nowrap;">Firma</th>'
      +'<th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;white-space:nowrap;">Fecha</th>'
      +'<th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;white-space:nowrap;">Estado</th>'
      +'<th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;white-space:nowrap;">Acciones</th>'
      +'</tr></thead><tbody>';
    rows.forEach(function(g){
      if(g.denuncia_data) window.garDenData[g.id]=g.denuncia_data;
      var isRobo=g.tipo==='robo';
      var tipoLabel=isRobo?'<span style="background:#fee2e2;color:#dc2626;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:700;">🚨 Pérdida/Robo</span>':'<span style="background:#d1fae5;color:#065f46;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:700;">🔧 Técnica</span>';
      var detalle=isRobo?('Cuando: '+(g.cuando_ocurrio||'—')+'<br>Donde: '+(g.donde_ocurrio||'—')):((g.pieza?'<strong>'+g.pieza+'</strong><br>':'')+escHtmlInc(g.descripcion||'—').substring(0,80));
      var firma=g.firma_digital?'<img src="'+g.firma_digital+'" style="height:32px;border-radius:4px;border:1px solid var(--border-soft);" alt="firma">':'—';
      var dt=g.created_at?new Date(g.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}):'—';
      var sl=GAR_STATUS_LABEL[g.status]||g.status, sc=GAR_STATUS_COLOR[g.status]||'#666', sb=GAR_STATUS_BG[g.status]||'#f3f4f6';
      html+='<tr style="border-bottom:1px solid var(--border-soft);">'
        +'<td style="padding:10px 14px;"><div style="font-weight:700;color:var(--text-main);">'+(g.employee_name||'—')+'</div><div style="font-size:11px;color:var(--text-muted);">'+(g.employee_email||'—')+'</div></td>'
        +'<td style="padding:10px 14px;">'+tipoLabel+'</td>'
        +'<td style="padding:10px 14px;max-width:200px;font-size:12px;color:var(--text-muted);">'+detalle+'</td>'
        +'<td style="padding:10px 14px;">'+firma+'</td>'
        +'<td style="padding:10px 14px;font-size:12px;white-space:nowrap;">'+dt+'</td>'
        +'<td style="padding:10px 14px;"><span style="background:'+sb+';color:'+sc+';padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;">'+sl+'</span></td>'
        +'<td style="padding:10px 14px;"><div style="display:flex;gap:6px;flex-wrap:wrap;">'
        +(g.status!=='aprobado'?'<button onclick="garApprove('+g.id+')" style="padding:5px 12px;border-radius:7px;border:1px solid #059669;background:rgba(5,150,105,.08);color:#059669;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;"><i class="bi bi-check-circle-fill"></i> Aprobar</button>':'')
        +(g.status!=='rechazado'?'<button onclick="garReject('+g.id+')" style="padding:5px 12px;border-radius:7px;border:1px solid #f59e0b;background:rgba(245,158,11,.08);color:#b45309;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;"><i class="bi bi-x-circle"></i> Rechazar</button>':'')
        +(g.denuncia_data?'<button onclick="garVerDenuncia('+g.id+',garDenData['+g.id+'])" style="padding:5px 12px;border-radius:7px;border:1px solid #6366f1;background:rgba(99,102,241,.08);color:#4f46e5;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;"><i class="bi bi-file-earmark-pdf"></i> Denuncia</button>':'')
        +'</div></td></tr>';
    });
    html+='</tbody></table></div>';
    list.innerHTML=html;
  }catch(e){ list.innerHTML='<div style="padding:24px;text-align:center;color:var(--danger);font-size:13px;">Error: '+e.message+'</div>'; }
}

async function garApprove(id){
  if(!confirm('¿Aprobar esta solicitud de garantía?')) return;
  var r=await fetch('/api/portal/garantias/'+id,{method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:'aprobado'})});
  if(!(await r.json()).success) alert('Error al aprobar'); else loadGarantiaRequests();
