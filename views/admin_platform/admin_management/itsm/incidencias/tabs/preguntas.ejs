var _starLabels = ['','😞 Muy malo','😕 Malo','😐 Regular','😊 Bueno','🤩 Excelente'];
var _starColor  = ['','#dc2626','#f97316','#f59e0b','#22c55e','#10b981'];

async function loadSurveyGeneralResults() {
  const wrap  = document.getElementById('surveyGenWrap');
  const stats = document.getElementById('surveyGenStats');
  if(!wrap) return;
  wrap.innerHTML = '<div style="text-align:center;color:var(--text-muted);font-size:13px;padding:32px;"><i class="bi bi-hourglass" style="font-size:24px;display:block;margin-bottom:8px;"></i>Cargando...</div>';
  try {
    const r = await fetch('/api/portal/survey-general/results', {credentials:'include'});
    const j = await r.json();
    if(!j.success) throw new Error(j.error);
    const data = j.data || [];
    if(data.length){
      const avg = (data.reduce((s,x)=>s+x.rating,0)/data.length).toFixed(1);
      const low = data.filter(x=>x.rating<=2).length;
      const hi  = data.filter(x=>x.rating>=4).length;
      stats.innerHTML = `
        <div style="background:#fff;border:1px solid var(--border-soft);border-radius:10px;padding:14px 20px;display:flex;flex-direction:column;gap:4px;min-width:110px;">
          <div style="font-size:22px;font-weight:800;color:#2563eb;">${avg}</div>
          <div style="font-size:11px;color:var(--text-muted);">Promedio global</div>
          <div style="color:#f59e0b;font-size:14px;">${'★'.repeat(Math.round(avg))}${'☆'.repeat(5-Math.round(avg))}</div>
        </div>
        <div style="background:#fff;border:1px solid var(--border-soft);border-radius:10px;padding:14px 20px;display:flex;flex-direction:column;gap:4px;min-width:110px;">
          <div style="font-size:22px;font-weight:800;color:#374151;">${data.length}</div>
          <div style="font-size:11px;color:var(--text-muted);">Total respuestas</div>
        </div>
        <div style="background:#fff;border:1px solid #fecaca;border-radius:10px;padding:14px 20px;display:flex;flex-direction:column;gap:4px;min-width:110px;">
          <div style="font-size:22px;font-weight:800;color:#dc2626;">${low}</div>
          <div style="font-size:11px;color:var(--text-muted);">Bajas (1-2 ★)</div>
        </div>
        <div style="background:#fff;border:1px solid #bbf7d0;border-radius:10px;padding:14px 20px;display:flex;flex-direction:column;gap:4px;min-width:110px;">
          <div style="font-size:22px;font-weight:800;color:#10b981;">${hi}</div>
          <div style="font-size:11px;color:var(--text-muted);">Altas (4-5 ★)</div>
        </div>`;
    } else { stats.innerHTML = ''; }
    if(!data.length){
      wrap.innerHTML = '<div style="text-align:center;color:var(--text-muted);font-size:13px;padding:32px;"><i class="bi bi-inbox" style="font-size:28px;display:block;margin-bottom:8px;"></i>Sin calificaciones aún.</div>';
      return;
    }
    function miniStars(r){ return r ? ('★'.repeat(r)+'☆'.repeat(5-r)) : '—'; }
    wrap.innerHTML = `
      <table class="table-tickets w-100" style="font-size:12px;">
        <thead><tr>
          <th style="padding:10px 12px;white-space:nowrap;">Usuario</th>
          <th style="padding:10px 12px;">Email</th>
          <th style="padding:10px 12px;text-align:center;white-space:nowrap;"><i class="bi bi-laptop-fill" style="color:#2563eb;"></i> Plataforma</th>
          <th style="padding:10px 12px;text-align:center;white-space:nowrap;"><i class="bi bi-pc-display-horizontal" style="color:#7c3aed;"></i> Equipo</th>
          <th style="padding:10px 12px;text-align:center;white-space:nowrap;"><i class="bi bi-grid-3x3-gap-fill" style="color:#0891b2;"></i> App</th>
          <th style="padding:10px 12px;">Comentario</th>
          <th style="padding:10px 12px;white-space:nowrap;">Fecha</th>
          <th style="padding:10px 12px;text-align:center;">Acción</th>
        </tr></thead>
        <tbody>${data.map(s=>{
          const color  = _starColor[s.rating]||'#374151';
          const label  = _starLabels[s.rating]||'';
          const cEquip = _starColor[s.rating_equipment]||'#94a3b8';
          const cApp   = _starColor[s.rating_app]||'#94a3b8';
          const fecha  = s.created_at ? new Date(s.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}) : '—';
          const canEmail = s.rating <= 3;
          return `<tr style="${s.rating<=2?'background:#fff5f5;':''}">
            <td style="padding:9px 12px;font-weight:600;">${s.full_name||'—'}</td>
            <td style="padding:9px 12px;color:var(--text-muted);font-size:11px;">${s.email}</td>
            <td style="padding:9px 12px;text-align:center;">
              <div style="color:${color};font-size:13px;letter-spacing:1px;">${miniStars(s.rating)}</div>
              <div style="font-size:10px;color:${color};font-weight:600;">${label}</div>
            </td>
            <td style="padding:9px 12px;text-align:center;">
              <div style="color:${cEquip};font-size:13px;letter-spacing:1px;">${miniStars(s.rating_equipment)}</div>
              ${s.rating_equipment ? `<div style="font-size:10px;color:${cEquip};font-weight:600;">${_starLabels[s.rating_equipment]||''}</div>` : ''}
            </td>
            <td style="padding:9px 12px;text-align:center;">
              <div style="color:${cApp};font-size:13px;letter-spacing:1px;">${miniStars(s.rating_app)}</div>
              ${s.app_name ? `<div style="font-size:10px;color:#0891b2;font-weight:600;max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${s.app_name}">${s.app_name}</div>` : ''}
              ${s.rating_app && !s.app_name ? `<div style="font-size:10px;color:${cApp};font-weight:600;">${_starLabels[s.rating_app]||''}</div>` : ''}
            </td>
            <td style="padding:9px 12px;color:var(--text-muted);font-size:11px;max-width:180px;">${s.comment||'<span style="opacity:.5;">Sin comentario</span>'}</td>
            <td style="padding:9px 12px;white-space:nowrap;color:var(--text-muted);">${fecha}</td>
            <td style="padding:9px 12px;text-align:center;">${canEmail
              ? `<button onclick="sendSurveyFeedbackEmail(${s.id},'${s.email.replace(/'/g,"\\'")}',this)"
                  style="padding:5px 10px;border-radius:7px;border:none;background:#2563eb;color:#fff;font-size:11px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:4px;margin:0 auto;">
                  <i class="bi bi-envelope-fill"></i> Correo
                </button>`
              : '<span style="font-size:11px;color:var(--text-muted);">—</span>'}
            </td>
          </tr>`;
        }).join('')}</tbody>
      </table>`;
  } catch(e) {
    wrap.innerHTML = `<div style="color:#dc2626;font-size:13px;padding:20px;">Error: ${e.message}</div>`;
  }
}

var _surveyEmailId = null, _surveyEmailBtn = null;

function sendSurveyFeedbackEmail(id, email, btn){
  _surveyEmailId  = id;
  _surveyEmailBtn = btn;
  document.getElementById('sfEmailTo').textContent = email;
  Array.from(document.getElementById('sfQuestions').options).forEach(function(o){ o.selected=false; });
  bootstrap.Modal.getOrCreateInstance(document.getElementById('sfModal')).show();
}
</script>

