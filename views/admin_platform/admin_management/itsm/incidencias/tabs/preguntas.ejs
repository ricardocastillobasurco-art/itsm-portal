async function garReject(id){
  var r=await fetch('/api/portal/garantias/'+id,{method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:'rechazado'})});
  if(!(await r.json()).success) alert('Error al rechazar'); else loadGarantiaRequests();
}

var _garDenunciaCache={};
async function garVerDenuncia(id, dataUrl){
  var data=dataUrl||_garDenunciaCache[id];
  if(!data){ alert('Denuncia no disponible'); return; }
  _garDenunciaCache[id]=data;
  var win=window.open('','_blank');
  if(data.startsWith('data:application/pdf')||data.startsWith('data:application/octet')){
    win.document.write('<iframe src="'+data+'" style="width:100%;height:100vh;border:none;"></iframe>');
  } else {
    win.document.write('<img src="'+data+'" style="max-width:100%;">');
  }
}

function escHtmlInc(s){ var d=document.createElement('div'); d.textContent=s; return d.innerHTML; }

