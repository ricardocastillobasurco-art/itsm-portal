                <div style="font-size:11px;font-weight:700;color:var(--text-muted);letter-spacing:.06em;margin-bottom:6px;flex-shrink:0;">POR TÉCNICO <span style="font-weight:400;opacity:.5;">MTTR · FCR · ACTIVOS</span></div>
                <div id="kpiByTechWrap" style="overflow-y:auto;flex:1;min-height:0;scrollbar-width:thin;scrollbar-color:var(--border-soft) transparent;"></div>
              </div>
              <!-- Semana/mes -->
              <div style="flex:1;min-width:0;background:var(--bg-card);border:1px solid var(--border-soft);border-radius:10px;padding:10px;display:flex;flex-direction:column;overflow:hidden;">
                <div style="font-size:11px;font-weight:700;color:var(--text-muted);letter-spacing:.06em;margin-bottom:6px;flex-shrink:0;">SEMANA / MES POR ESPECIALISTA</div>
                <div id="kpiWeeklyWrap" style="overflow-y:auto;flex:1;min-height:0;scrollbar-width:thin;scrollbar-color:var(--border-soft) transparent;"></div>
              </div>
