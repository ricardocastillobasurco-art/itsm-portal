                <div style="font-size:11px;font-weight:700;color:var(--text-muted);letter-spacing:.06em;margin-bottom:5px;flex-shrink:0;">ESTADO</div>
                <div id="kpiEstadoWrap" style="display:flex;flex-direction:column;gap:3px;flex:1;min-height:0;overflow:hidden;"></div>
                <div style="font-size:10px;font-weight:600;color:var(--text-muted);letter-spacing:.05em;margin-top:6px;margin-bottom:3px;flex-shrink:0;">PRIORIDAD</div>
                <div id="kpiPriorWrap" style="display:flex;gap:4px;align-items:flex-end;flex:0 0 32px;"></div>
              </div>
            </div>

