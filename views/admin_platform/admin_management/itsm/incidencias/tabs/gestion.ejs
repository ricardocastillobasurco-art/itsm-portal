                <div style="font-size:11px;font-weight:700;color:var(--text-muted);letter-spacing:.06em;margin-bottom:4px;flex-shrink:0;">TOP REPORTERS</div>
                <div id="kpiTopReportersWrap" class="ranking-scroll"></div>
              </div>
              <!-- Top Equipos -->
              <div style="flex:1;min-width:0;background:var(--bg-card);border:1px solid var(--border-soft);border-radius:10px;padding:10px;display:flex;flex-direction:column;">
                <div style="font-size:11px;font-weight:700;color:var(--text-muted);letter-spacing:.06em;margin-bottom:4px;flex-shrink:0;">TOP EQUIPOS</div>
                <div id="kpiTopEquiposWrap" class="ranking-scroll"></div>
              </div>
              <!-- Top Categorías -->
              <div style="flex:1;min-width:0;background:var(--bg-card);border:1px solid var(--border-soft);border-radius:10px;padding:10px;display:flex;flex-direction:column;">
                <div style="font-size:11px;font-weight:700;color:var(--text-muted);letter-spacing:.06em;margin-bottom:4px;flex-shrink:0;">TOP CATEGORÍAS</div>
                <div id="kpiTopCatWrap" class="ranking-scroll"></div>
              </div>
            </div>

            <!-- Tickets en Riesgo + MTTR + Metric boxes en fila -->
            <div id="kpiBreachRow" style="display:flex;gap:8px;flex:2;min-height:260px;">
