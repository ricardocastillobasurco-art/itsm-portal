                  <div class="kpi-lbl">Vencidos abiertos</div>
                  <div class="kpi-hint">Revisar urgentes →</div>
                </div>
              </div>
              <div class="kpi-stat-card ks-amber" onclick="(document.getElementById('nav-sinAsig')||{click:()=>{}}).click()">
                <div class="kpi-stat-icon"><i class="bi bi-person-dash-fill"></i></div>
                <div class="kpi-stat-body">
                  <div class="kpi-num" id="kpiSinAsignar30">—</div>
                  <div class="kpi-lbl">Sin asignar &gt;30min</div>
                  <div class="kpi-hint">Ir a cola →</div>
                </div>
              </div>
              <div class="kpi-stat-card ks-blue" onclick="document.getElementById('kpiChartsSection').scrollIntoView({behavior:'smooth'})">
                <div class="kpi-stat-icon"><i class="bi bi-graph-up-arrow"></i></div>
                <div class="kpi-stat-body">
                  <div class="kpi-num" id="kpiPctSla">—</div>
                  <div class="kpi-lbl">% SLA cumplido</div>
                  <div class="kpi-hint" id="kpiPctSlaTrend"></div>
                </div>
              </div>
              <div class="kpi-stat-card ks-purple" onclick="document.getElementById('kpiByTechSection').scrollIntoView({behavior:'smooth'})">
                <div class="kpi-stat-icon"><i class="bi bi-stopwatch-fill"></i></div>
                <div class="kpi-stat-body">
                  <div class="kpi-num" id="kpiMttr">—</div>
                  <div class="kpi-lbl">MTTR promedio</div>
                  <div class="kpi-hint" id="kpiMttrTrend">Ver técnicos ↓</div>
                </div>
              </div>
