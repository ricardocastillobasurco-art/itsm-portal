                  <div class="mb-lbl">Reapertura tickets</div>
                  <div class="mb-val" id="mboxReopenVal">—</div>
                  <div class="mb-meta">Meta &lt;5%</div>
                </div>
                <div class="metric-box">
                  <div class="mb-lbl">MTTA promedio</div>
                  <div class="mb-val" id="mboxMttaVal">—</div>
                  <div class="mb-meta">Meta &lt;15 min</div>
                </div>
                <div class="metric-box">
                  <div class="mb-lbl">CSAT promedio</div>
                  <div class="mb-val" id="mboxCsatVal">—</div>
                  <div class="mb-meta" id="mboxCsatMeta">Meta &gt;4.0</div>
                </div>
              </div>
            </div>
          </div>

          <!-- PANEL: REPORTES -->
          <div class="panel" id="panel-reportes" style="overflow-y:auto;max-height:calc(100vh - 110px);padding-right:4px;">
            <!-- Header -->
            <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:16px;gap:12px;flex-wrap:wrap;">
              <div>
                <div style="font-size:15px;font-weight:700;color:var(--text-main);display:flex;align-items:center;gap:8px;">
                  <i class="bi bi-file-earmark-bar-graph-fill" style="color:var(--jira-blue);"></i> Reportes · Exportar Métricas
                </div>
                <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">Filtra el backlog del servicio y exporta con métricas SLA profesionales</div>
