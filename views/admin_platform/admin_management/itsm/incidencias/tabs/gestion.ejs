                  <button class="rpt-pill active" data-grp="estado" data-val="En N2"         onclick="this.classList.toggle('active')">En N2</button>
                  <button class="rpt-pill active" data-grp="estado" data-val="Pendiente"     onclick="this.classList.toggle('active')">Pendiente</button>
                  <button class="rpt-pill active" data-grp="estado" data-val="Resuelto"      onclick="this.classList.toggle('active')">Resuelto</button>
                  <button class="rpt-pill active" data-grp="estado" data-val="Cerrado"       onclick="this.classList.toggle('active')">Cerrado</button>
                  <button class="rpt-pill"        data-grp="estado" data-val="Cancelado"     onclick="this.classList.toggle('active')">Cancelado</button>
                  <button class="rpt-pill"        data-grp="estado" data-val="Observado"     onclick="this.classList.toggle('active')">Observado</button>
                  <button class="rpt-pill"        data-grp="estado" data-val="En revisión"   onclick="this.classList.toggle('active')">En revisión</button>
