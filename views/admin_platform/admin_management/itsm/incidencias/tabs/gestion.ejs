                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;flex-shrink:0;">
                  <span style="font-size:11px;font-weight:700;color:var(--text-muted);letter-spacing:.06em;">EVOLUCIÓN DE TICKETS
                    <span style="font-weight:400;margin-left:8px;"><span style="color:#3b82f6;">—</span> Creados &nbsp;<span style="color:#10b981;">—</span> Cerrados</span>
                  </span>
                  <div style="display:flex;gap:3px;">
                    <button id="chartPeriodDay"   onclick="setStatsPeriod('hoy',null);setChartPeriod('day',this)"   style="font-size:10px;padding:1px 6px;border:1px solid var(--border-soft);border-radius:4px;background:none;cursor:pointer;color:var(--text-muted);">Día</button>
                    <button id="chartPeriodWeek"  onclick="setStatsPeriod('sem',null);setChartPeriod('week',this)"  style="font-size:10px;padding:1px 6px;border:1px solid var(--jira-blue);border-radius:4px;background:none;cursor:pointer;color:var(--jira-blue);">Sem</button>
                    <button id="chartPeriodMonth" onclick="setStatsPeriod('mes',null);setChartPeriod('month',this)" style="font-size:10px;padding:1px 6px;border:1px solid var(--border-soft);border-radius:4px;background:none;cursor:pointer;color:var(--text-muted);">Mes</button>
                  </div>
                </div>
                <div style="position:relative;flex:1;min-height:0;"><canvas id="chartEvolucion" style="position:absolute;inset:0;width:100%!important;height:100%!important;"></canvas></div>
