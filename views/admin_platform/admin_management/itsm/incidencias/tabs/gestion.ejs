                  <button class="rpt-radio" data-grp="days" data-val="7"   onclick="rptRadioClick(this);rptSetDays(7)">7d</button>
                  <button class="rpt-radio active" data-grp="days" data-val="30"  onclick="rptRadioClick(this);rptSetDays(30)">30d</button>
                  <button class="rpt-radio" data-grp="days" data-val="90" onclick="rptRadioClick(this);rptSetDays(90)">90d</button>
                  <button class="rpt-radio" data-grp="days" data-val="365" onclick="rptRadioClick(this);rptSetDays(365)">1 año</button>
                  <button class="rpt-radio" data-grp="days" data-val="0"   onclick="rptRadioClick(this);rptSetDays(0)">Todo</button>
                </div>
              </div>

