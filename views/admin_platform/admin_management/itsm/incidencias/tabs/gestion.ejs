<script>
// ── Collapsible nav groups ────────────────────────────────────────────────
function toggleNavGroup(grpId, secEl) {
    var grp  = document.getElementById(grpId);
    var chev = secEl.querySelector('.nav-sec-chev');
    if (!grp) return;
    var isCollapsed = grp.classList.toggle('collapsed');
    if (chev) chev.style.transform = isCollapsed ? 'rotate(-90deg)' : '';
    try { localStorage.setItem('navgrp_' + grpId, isCollapsed ? '0' : '1'); } catch(_) {}
}

document.addEventListener('DOMContentLoaded', function() {
    // MONITOREO y ANÁLISIS: colapsados por defecto, expandidos si el usuario los abrió antes
    ['grp-mon','grp-anl'].forEach(function(id) {
        var saved = null;
        try { saved = localStorage.getItem('navgrp_' + id); } catch(_) {}
        if (saved !== '1') {
            var grp = document.getElementById(id);
            if (grp) grp.classList.add('collapsed');
            var chev = document.getElementById(id.replace('grp-','chev-'));
            if (chev) chev.style.transform = 'rotate(-90deg)';
        }
    });

    // Auto-expand group of the active nav item when showPanel activates it
    var navObs = new MutationObserver(function(muts) {
        muts.forEach(function(m) {
            var el = m.target;
            if (!el.classList.contains('nav-item') || !el.classList.contains('active')) return;
            var grp = el.closest('.nav-group');
            if (grp && grp.classList.contains('collapsed')) {
                var grpId = grp.id;
                var sec   = document.getElementById(grpId.replace('grp-','sec-'));
                if (sec) toggleNavGroup(grpId, sec);
            }
        });
    });
    var nav = document.querySelector('nav');
    if (nav) navObs.observe(nav, { subtree: true, attributes: true, attributeFilter: ['class'] });

    // CMDB empty state: hide when hot table, device detail, or stat detail become visible
    function _updateCmdbEmpty() {
        var es = document.getElementById('cmdbEmptyState');
        if (!es) return;
        var ht = document.getElementById('cmdbHotTable');
        var dd = document.getElementById('cmdbDeviceDetail');
        var sd = document.getElementById('cmdbStatDetail');
        var hide = (ht && ht.style.display === 'block') || (dd && dd.style.display === 'block') || (sd && sd.style.display === 'block');
        es.style.display = hide ? 'none' : '';
    }
    var _cmdbTargets = ['cmdbHotTable','cmdbDeviceDetail','cmdbStatDetail'];
    var _cmdbObs = new MutationObserver(_updateCmdbEmpty);
    _cmdbTargets.forEach(function(id) {
        var el = document.getElementById(id);
        if (el) _cmdbObs.observe(el, { attributes: true, attributeFilter: ['style'] });
    });

    // Pre-cargar Categorías en segundo plano para que esté listo al hacer clic
    setTimeout(function() {
        if (typeof loadSinCategorizar === 'function') loadSinCategorizar(false);
    }, 1500);

    // Activar vista desde parámetro URL (?view=sin_asignar | ?view=tecnicos)
    var _urlView = new URLSearchParams(window.location.search).get('view');
    if (_urlView) {
        setTimeout(function() {
            if (_urlView === 'sin_asignar') {
                var navEl = document.getElementById('nav-sinAsig');
                document.getElementById('incPanel-todos').style.display = 'none';
                if (typeof showPanel === 'function') showPanel('sinAsig', navEl);
                if (typeof loadSinAsig === 'function') loadSinAsig();
            } else if (_urlView === 'tecnicos') {
                var navEl2 = document.getElementById('nav-tecnicos');
                document.getElementById('incPanel-todos').style.display = 'none';
                if (typeof showPanel === 'function') showPanel('tecnicos', navEl2);
                if (typeof loadTecStats === 'function') loadTecStats();
            } else if (_urlView === 'reportes') {
                var navEl3 = document.getElementById('nav-reportes');
                document.getElementById('incPanel-todos').style.display = 'none';
                if (typeof showPanel === 'function') showPanel('reportes', navEl3);
                if (typeof initReportes === 'function') initReportes();
            }
            // Limpiar param de la URL sin recargar
            var clean = window.location.pathname;
            window.history.replaceState({}, '', clean);
        }, 400);
    }
});
</script>

<!-- Jira email config modal (replaces browser prompt) -->
<div id="jiraEmailModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9100;align-items:center;justify-content:center;">
  <div style="background:var(--bg-card);border-radius:14px;padding:24px;width:100%;max-width:420px;margin:16px;box-shadow:0 20px 60px rgba(0,0,0,.3);">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <div style="display:flex;align-items:center;gap:8px;">
        <i class="bi bi-gear-fill" style="font-size:16px;color:var(--primary);"></i>
        <span style="font-size:15px;font-weight:800;color:var(--text-main);">Configurar correo Jira</span>
      </div>
      <button onclick="closeJiraEmailModal()" style="background:none;border:none;cursor:pointer;font-size:22px;color:var(--text-muted);line-height:1;padding:0;">×</button>
    </div>
    <p style="font-size:12px;color:var(--text-muted);margin-bottom:14px;">Ingresa tu correo EXACTO de Atlassian para poder asignarte tickets Jira.</p>
    <input type="email" id="jiraEmailInput" class="form-ctrl" placeholder="tu@correo.com" style="width:100%;margin-bottom:16px;box-sizing:border-box;">
    <div style="display:flex;gap:8px;justify-content:flex-end;">
      <button class="btn-outline-sm" onclick="closeJiraEmailModal()">Cancelar</button>
      <button class="btn-sm btn-primary" onclick="saveJiraEmailModal()"><i class="bi bi-check2"></i> Guardar</button>
    </div>
  </div>
</div>
<script>
function closeJiraEmailModal() {
  document.getElementById('jiraEmailModal').style.display = 'none';
}
function saveJiraEmailModal() {
  var input = document.getElementById('jiraEmailInput');
  var modal = document.getElementById('jiraEmailModal');
  var email = (input ? input.value : '').trim();
  if (email && email.includes('@')) {
    localStorage.setItem('jira_email', email);
    if (modal) modal.style.display = 'none';
    if (typeof showToast === 'function') showToast('Correo Jira actualizado.', 'success');
    if (typeof loadMisAsig === 'function') loadMisAsig();
  } else {
    if (input) { input.style.outline = '2px solid #ef4444'; setTimeout(function() { input.style.outline = ''; }, 1500); }
  }
}
document.addEventListener('keydown', function(e) {
  var modal = document.getElementById('jiraEmailModal');
  if (!modal || modal.style.display === 'none') return;
  if (e.key === 'Escape') closeJiraEmailModal();
  if (e.key === 'Enter') saveJiraEmailModal();
});
</script>

