                  placeholder="INC-135948, pmsalinas@stefanini.com&#10;INC-136441, fjoro@stefanini.com&#10;INC-137263, rabasurco@stefanini.com&#10;INC-138071, pmsalinas@stefanini.com"></textarea>
                <div style="font-size:10px;color:var(--text-muted);margin-top:6px;">También acepta CSV con encabezados "Issue key,Assignee"</div>
                <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px;">
