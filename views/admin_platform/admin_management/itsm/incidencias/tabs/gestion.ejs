  <style>
    /* Cola Jira panels — hide by default, show only the active one */
    .panel { display: none; }
    .panel.active { display: block; }
    #panel-indicadores.active { display: flex !important; flex-direction: column; }
    #panel-alertas.active    { display: flex !important; flex-direction: column; }
    #panel-kanban.active     { display: flex !important; flex-direction: column; }
    /* ── Panel Alertas ── */
    .alrt-kpi { display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:10px;border:1px solid; }
    .alrt-kpi-ico { font-size:20px;flex-shrink:0; }
    .alrt-kpi-n  { font-size:22px;font-weight:800;line-height:1; }
    .alrt-kpi-l  { font-size:10px;color:var(--text-muted);margin-top:2px;font-family:monospace;text-transform:uppercase; }
    .alrt-red    { background:rgba(239,68,68,.07);border-color:rgba(239,68,68,.25);color:#ef4444; }
    .alrt-orange { background:rgba(249,115,22,.07);border-color:rgba(249,115,22,.25);color:#f97316; }
    .alrt-amber  { background:rgba(245,158,11,.07);border-color:rgba(245,158,11,.25);color:#d97706; }
    .alrt-section { margin-bottom:10px;border:1px solid var(--border-soft);border-radius:10px;overflow:hidden; }
    .alrt-section-hdr { display:flex;align-items:center;gap:8px;padding:9px 14px;font-size:12px;font-weight:600;cursor:pointer;user-select:none;transition:background .15s; }
    .alrt-hdr-red    { background:rgba(239,68,68,.06);color:#dc2626; }
    .alrt-hdr-orange { background:rgba(249,115,22,.06);color:#ea580c; }
    .alrt-hdr-amber  { background:rgba(245,158,11,.06);color:#b45309; }
    .alrt-section-hdr:hover { filter:brightness(.95); }
    .alrt-body { padding:6px 0;max-height:320px;overflow-y:auto; }
    .alrt-body.collapsed { display:none; }
    .alrt-chev { transition:transform .2s; }
    .alrt-chev.open { transform:rotate(180deg); }
    .alrt-loading { padding:14px;font-size:12px;color:var(--text-muted);text-align:center; }
    .alrt-row { display:flex;align-items:center;gap:10px;padding:7px 14px;border-bottom:1px solid var(--border-soft);font-size:12px; }
    .alrt-row:last-child { border-bottom:none; }
    .alrt-row:hover { background:var(--hover-row); }
    .alrt-key { font-family:monospace;font-weight:700;font-size:11px;color:var(--jira-blue);white-space:nowrap; }
    .alrt-sum { flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text-main); }
    .alrt-age { font-size:10px;font-family:monospace;color:var(--text-muted);white-space:nowrap; }
    .alrt-empty { padding:14px;font-size:12px;color:#10b981;text-align:center;font-weight:600; }
    /* ── Kanban ── */
    .kb-board    { display:flex;gap:12px;flex:1;overflow-x:auto;padding-bottom:8px;min-height:0; }
    .kb-col      { display:flex;flex-direction:column;min-width:260px;max-width:300px;flex:1;border-radius:12px;background:var(--bg-main);border:1px solid var(--border-soft);overflow:hidden; }
    .kb-col-hdr  { padding:10px 14px;font-size:11px;font-weight:700;display:flex;align-items:center;gap:7px;border-bottom:1px solid var(--border-soft);letter-spacing:.03em;flex-shrink:0; }
    .kb-col-cnt  { margin-left:auto;font-size:10px;font-family:monospace;font-weight:400;color:var(--text-muted); }
    .kb-col-body { flex:1;overflow-y:auto;padding:6px;display:flex;flex-direction:column;gap:6px;min-height:80px; }
    .kb-col-body.kb-over { background:rgba(37,99,235,.05);outline:2px dashed var(--jira-blue);outline-offset:-4px;border-radius:8px; }
    .kb-card     { background:var(--bg-card);border:1px solid var(--border-soft);border-radius:8px;padding:10px 11px;cursor:grab;transition:box-shadow .15s,transform .15s;user-select:none; }
    .kb-card:active { cursor:grabbing; }
    .kb-card.kb-dragging { opacity:.45;transform:rotate(1.5deg); }
    .kb-card:hover { box-shadow:0 2px 8px rgba(0,0,0,.12); }
    .kb-card.kb-mine { box-shadow:0 0 0 1.5px var(--jira-blue),0 2px 10px rgba(37,99,235,.18); }
    .kb-card.kb-mine:hover { box-shadow:0 0 0 2px var(--jira-blue),0 4px 14px rgba(37,99,235,.22); }
    .kb-card-top { display:flex;align-items:center;gap:6px;margin-bottom:5px; }
    .kb-key      { font-family:monospace;font-weight:700;font-size:10px;color:var(--jira-blue);cursor:pointer; }
    .kb-key:hover { text-decoration:underline; }
    .kb-sum      { font-size:12px;color:var(--text-main);line-height:1.4;margin-bottom:6px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden; }
    .kb-meta     { display:flex;align-items:center;gap:6px;font-size:10px;color:var(--text-muted); }
    .kb-avatar   { width:18px;height:18px;border-radius:50%;color:#fff;font-size:8px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0; }
    .kb-actions  { display:none;gap:4px;margin-top:7px;padding-top:7px;border-top:1px solid var(--border-soft); }
    .kb-card:hover .kb-actions { display:flex; }
    .kb-btn      { font-size:10px;padding:2px 7px;border-radius:4px;border:1px solid var(--border-soft);background:transparent;color:var(--text-muted);cursor:pointer;font-weight:500; }
    .kb-btn:hover { border-color:var(--jira-blue);color:var(--jira-blue); }
    .kb-empty    { text-align:center;padding:24px 12px;font-size:11px;color:var(--text-muted);font-style:italic; }
    .kb-toolbar  { display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-shrink:0; }
    .kb-spin     { display:inline-block;width:14px;height:14px;border:2px solid var(--border-soft);border-top-color:var(--jira-blue);border-radius:50%;animation:kb-spin .7s linear infinite;} @keyframes kb-spin{to{transform:rotate(360deg);}}
    /* ── Tech Stats ── */
    #panel-tecnicos.active { display:flex !important; flex-direction:column; }
    .tec-toolbar   { display:flex;align-items:center;gap:8px;margin-bottom:12px;flex-shrink:0;flex-wrap:wrap; }
    .tec-kpis      { display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;flex-shrink:0; }
    .tec-kpi       { padding:10px 14px;border-radius:10px;border:1px solid var(--border-soft);background:var(--bg-card); }
    .tec-kpi-val   { font-size:22px;font-weight:700;display:block; }
    .tec-kpi-lbl   { font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em; }
    .tec-table     { width:100%;border-collapse:collapse;font-size:12px; }
    .tec-table th  { padding:8px 12px;text-align:left;font-size:10px;font-weight:600;color:var(--text-muted);border-bottom:1px solid var(--border-soft);white-space:nowrap; }
    .tec-table td  { padding:9px 12px;border-bottom:1px solid var(--border-soft);vertical-align:middle; }
    .tec-row       { cursor:pointer;transition:background .12s; }
    .tec-row:hover { background:var(--bg-main); }
    .tec-row.tec-selected { background:rgba(37,99,235,.07); }
    .tec-avatar    { width:30px;height:30px;border-radius:50%;flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff; }
    .tec-badge     { display:inline-block;padding:2px 7px;border-radius:4px;font-size:10px;font-weight:600; }
    .tec-bar-wrap  { width:80px;height:5px;border-radius:3px;background:var(--border-soft);overflow:hidden;display:block;margin-top:3px; }
    .tec-bar-fill  { height:100%;border-radius:3px; }
    .tec-detail    { background:var(--bg-main); }
    .tec-dtable    { width:100%;border-collapse:collapse;font-size:11px; }
    .tec-dtable th { padding:6px 10px;font-size:10px;font-weight:600;color:var(--text-muted);border-bottom:1px solid var(--border-soft); }
    .tec-dtable td { padding:7px 10px;border-bottom:1px solid var(--border-soft); }
    .tec-chart-wrap{ margin-top:16px;position:relative;height:240px;flex-shrink:0; }
    /* ── SLA Panel ── */
    #panel-sla.active  { display:flex !important; flex-direction:column; }
    .sla-toolbar       { display:flex;align-items:center;gap:8px;margin-bottom:12px;flex-shrink:0;flex-wrap:wrap; }
    .sla-kpis          { display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;flex-shrink:0; }
    .sla-kpi           { padding:10px 14px;border-radius:10px;border:1px solid var(--border-soft);background:var(--bg-card); }
    .sla-kpi-val       { font-size:22px;font-weight:700;display:block; }
    .sla-kpi-lbl       { font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em; }
    .sla-table         { width:100%;border-collapse:collapse;font-size:12px; }
    .sla-table th      { padding:8px 12px;text-align:left;font-size:10px;font-weight:600;color:var(--text-muted);border-bottom:2px solid var(--border-soft);white-space:nowrap;cursor:pointer; }
    .sla-table th:hover{ color:var(--text-main); }
    .sla-table td      { padding:9px 12px;border-bottom:1px solid var(--border-soft);vertical-align:middle; }
    .sla-table tbody tr:hover { background:var(--bg-main); }
    .sla-table tbody tr.sla-row-breach { background:rgba(239,68,68,.04); }
    .sla-bar-track     { width:90px;height:6px;border-radius:3px;background:var(--border-soft);overflow:hidden;display:inline-block;vertical-align:middle;margin-left:7px; }
    .sla-bar-fill      { height:100%;border-radius:3px;transition:width .5s; }
    .sla-pri           { display:inline-block;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700;white-space:nowrap; }
    .sla-cd            { font-family:monospace;font-weight:700;font-size:12px;white-space:nowrap; }
    .sla-breach        { color:#ef4444; }
    .sla-risk          { color:#f59e0b; }
    .sla-ok            { color:#10b981; }
    .sla-nav-badge     { margin-left:auto;background:#ef4444;color:#fff;font-size:9px;font-weight:700;padding:1px 5px;border-radius:8px;min-width:16px;text-align:center; }
    @keyframes sla-pulse { 0%,100%{opacity:1} 50%{opacity:.35} }
    .sla-pulse         { animation:sla-pulse 1.2s ease-in-out infinite; }
    /* ── Heatmap ── */
    #panel-heatmap.active  { display:flex !important; flex-direction:column; }
    /* ── Semanal ── */
    #panel-semanal.active  { display:flex !important; flex-direction:column; }
    /* ── Timeline drawer ── */
    #tlDrawer { transition:transform .22s cubic-bezier(.4,0,.2,1); }
    .tl-event { display:flex;gap:12px;margin-bottom:14px; }
    .tl-icon  { width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0; }
    .tl-line  { width:2px;flex:1;background:var(--border-soft);margin:4px auto;min-height:10px; }
    .hm-toolbar  { display:flex;align-items:center;gap:8px;margin-bottom:12px;flex-shrink:0;flex-wrap:wrap; }
    .hm-kpis     { display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;flex-shrink:0; }
    .hm-kpi      { padding:10px 14px;border-radius:10px;border:1px solid var(--border-soft);background:var(--bg-card); }
    .hm-kpi-val  { font-size:20px;font-weight:700;display:block; }
    .hm-kpi-lbl  { font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em; }
    .hm-cell     { border-radius:5px;cursor:default;transition:transform .1s;display:flex;align-items:center;justify-content:center; }
    .hm-cell:hover { transform:scale(1.18);z-index:2;position:relative; }
    .hm-daycol   { font-size:10px;font-weight:600;color:var(--text-muted);display:flex;align-items:center;justify-content:flex-end;padding-right:7px;white-space:nowrap; }
    .hm-hrlbl    { font-size:8px;color:var(--text-muted);display:flex;align-items:center;justify-content:center; }
    .hm-tip      { position:fixed;z-index:9999;background:var(--bg-card);border:1px solid var(--border-soft);border-radius:8px;padding:7px 11px;font-size:11px;font-weight:600;pointer-events:none;box-shadow:0 4px 16px rgba(0,0,0,.18);display:none; }
    .hm-legend   { display:flex;align-items:center;gap:5px;font-size:10px;color:var(--text-muted);margin:6px 0 14px 52px; }
    .hm-lc       { width:14px;height:14px;border-radius:3px;flex-shrink:0; }
    .hm-charts   { display:grid;grid-template-columns:1fr 1fr;gap:16px;flex-shrink:0; }
    .hm-reco     { padding:12px 16px;border-radius:10px;border:1px solid var(--border-soft);background:var(--bg-card); }
    .hm-reco-item{ display:flex;align-items:flex-start;gap:9px;padding:6px 0;border-bottom:1px solid var(--border-soft);font-size:12px;line-height:1.5; }
    .hm-reco-item:last-child { border-bottom:none; }
    /* Cola Jira sidebar nav — aligned with autogestion portal .sb-item style */
    .nav-item { display:flex;align-items:center;gap:10px;padding:7px 14px;border-radius:0;cursor:pointer;font-size:12.5px;font-weight:500;color:var(--text-muted);transition:all .15s;border:none;background:none;width:100%;text-align:left;position:relative;white-space:nowrap;overflow:hidden; }
    .nav-item:hover { background:var(--bg-subtle,#e9eef5);color:var(--text-main); }
    .nav-item.active { background:var(--primary-dim,rgba(37,99,235,.1));color:var(--primary);font-weight:700; }
    .nav-item.active::before { content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--primary);border-radius:0 2px 2px 0; }
    .nav-badge { margin-left:auto;background:var(--primary);color:#fff;border-radius:10px;padding:1px 7px;font-size:10px;font-weight:700; }
    .nav-section { font-size:9px;font-weight:800;letter-spacing:1.1px;color:var(--text-muted);padding:10px 14px 3px;text-transform:uppercase;white-space:nowrap;overflow:hidden;display:block; }
    .sidebar-user { padding:10px 12px;border-top:1px solid var(--border-soft);display:flex;align-items:center;gap:8px; }
    .avatar { width:28px;height:28px;background:linear-gradient(135deg,var(--primary),var(--purple));border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:800;flex-shrink:0;letter-spacing:.5px; }
    .user-info { flex:1;min-width:0; }
    .user-name  { font-size:12px;font-weight:600;color:var(--text-main);white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
    .user-email { font-size:10px;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
    .btn-config { background:none;border:none;cursor:pointer;color:var(--text-muted);padding:4px;border-radius:4px; }
    .btn-config:hover { background:var(--bg-subtle,#e9eef5);color:var(--text-main); }
    /* Cola Jira panel content */
    .filters-row { display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap; }
    .filters-row select { font-size:12px;padding:4px 8px;border:1px solid var(--border-soft);border-radius:6px;background:var(--bg-card);color:var(--text-main); }
    .stats-row { display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px; }
    .stat-card { background:var(--bg-card);border:1px solid var(--border-soft);border-radius:8px;padding:8px 14px;display:flex;flex-direction:column;align-items:center;min-width:80px; }
    .stat-val { font-size:20px;font-weight:700;font-family:monospace; }
    .stat-lbl { font-size:10px;color:var(--text-muted);margin-top:2px; }
    .c-blue  { color:var(--jira-blue); }
    .c-amber { color:#d97706; }
    .c-green { color:#16a34a; }
    .ticket-list { display:flex;flex-direction:column;gap:8px; }
    .search-bar { display:flex;gap:8px;margin-bottom:16px; }
    .search-bar input { flex:1;padding:9px 12px;border:1px solid var(--border-soft);border-radius:8px;font-size:13px;background:var(--bg-card);color:var(--text-main); }
    .hist-form { display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;margin-bottom:16px; }
    .hist-form label { font-size:9px;font-family:monospace;letter-spacing:.08em;color:var(--text-muted);display:block;margin-bottom:4px; }
    .hist-form input,.hist-form select { padding:7px 10px;border:1px solid var(--border-soft);border-radius:6px;font-size:12px;background:var(--bg-card);color:var(--text-main); }
    .skeleton { background:linear-gradient(90deg,var(--bg-header) 25%,var(--bg-card) 50%,var(--bg-header) 75%);background-size:200%;animation:incShimmer 1.4s infinite;border-radius:10px;height:80px;margin-bottom:8px; }
    .empty-state { display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 20px;color:var(--text-muted);text-align:center; }
    .empty-state svg { width:40px;height:40px;margin-bottom:12px;opacity:.4; }
    .empty-state p { font-size:13px;margin:0; }
    /* ranking-scroll — top reporters/equipos/categorías */
    .ranking-scroll{overflow-y:auto;flex:1;min-height:0;scrollbar-width:thin;scrollbar-color:var(--border-soft) transparent;}
    .ranking-scroll::-webkit-scrollbar{width:4px;}
    .ranking-scroll::-webkit-scrollbar-track{background:transparent;}
    .ranking-scroll::-webkit-scrollbar-thumb{background:var(--border-soft);border-radius:4px;}
    /* tech-quick-drop — autocomplete asignación inline */
    .tech-quick-drop{position:absolute;top:calc(100% + 4px);left:0;right:0;z-index:500;background:var(--bg-card);border:1px solid var(--border-soft);border-radius:8px;box-shadow:0 4px 20px rgba(0,0,0,.15);max-height:220px;overflow-y:auto;display:none;scrollbar-width:thin;}
    .tech-quick-drop.show{display:block;}
    .tech-quick-item{padding:7px 10px;cursor:pointer;display:flex;align-items:center;gap:10px;}
    .tech-quick-item:hover{background:var(--hover-row);}
    .tqi-avatar{width:26px;height:26px;background:var(--jira-blue);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:700;flex-shrink:0;}
    .tqi-name{font-size:12px;font-weight:600;color:var(--text-main);}
    .tqi-email{font-size:10px;color:var(--text-muted);}
    /* metric-box — bottom KPI boxes */
    .metric-box{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:10px;padding:10px 12px;display:flex;flex-direction:column;justify-content:center;gap:3px;overflow:hidden;}
    .metric-box .mb-lbl{font-size:10px;color:var(--text-muted);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .metric-box .mb-val{font-size:20px;font-weight:800;font-family:monospace;color:var(--text-main);line-height:1.1;}
    .metric-box .mb-meta{font-size:9px;color:var(--text-muted);}
    /* KPI stat cards — panel Indicadores */
    .kpi-stat-card { background:var(--bg-card);border:1px solid var(--border-soft);border-radius:10px;padding:14px 16px;display:flex;align-items:center;gap:12px;transition:box-shadow .15s,transform .12s;cursor:pointer;user-select:none; }
    .kpi-stat-card:hover { box-shadow:0 4px 18px rgba(0,0,0,.1);transform:translateY(-2px); }
    .kpi-stat-card:active { transform:translateY(0); }
    .kpi-stat-icon { width:40px;height:40px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0; }
    .kpi-stat-body .kpi-num { font-size:26px;font-weight:800;font-family:monospace;line-height:1; }
    .kpi-stat-body .kpi-lbl { font-size:10px;font-weight:700;color:var(--text-muted);margin-top:4px;letter-spacing:.05em;text-transform:uppercase; }
    .kpi-stat-body .kpi-hint { font-size:9px;color:var(--text-muted);margin-top:2px;opacity:.65; }
    .ks-green .kpi-stat-icon { background:rgba(16,185,129,.12);color:#10b981; } .ks-green .kpi-num { color:#10b981; } .ks-green { border-left:3px solid #10b981; }
    .ks-amber .kpi-stat-icon { background:rgba(245,158,11,.12);color:#f59e0b; } .ks-amber .kpi-num { color:#f59e0b; } .ks-amber { border-left:3px solid #f59e0b; }
    .ks-red   .kpi-stat-icon { background:rgba(239,68,68,.12); color:#ef4444; } .ks-red   .kpi-num { color:#ef4444; } .ks-red   { border-left:3px solid #ef4444; }
    .ks-blue  .kpi-stat-icon { background:rgba(59,130,246,.12);color:#3b82f6; } .ks-blue  .kpi-num { color:#3b82f6; } .ks-blue  { border-left:3px solid #3b82f6; }
    .ks-purple .kpi-stat-icon { background:rgba(124,58,237,.12);color:#7c3aed; } .ks-purple .kpi-num { color:#7c3aed; } .ks-purple { border-left:3px solid #7c3aed; }
    [data-theme="dark"] .kpi-stat-card:hover { box-shadow:0 4px 18px rgba(0,0,0,.35); }
    @keyframes spin { to { transform:rotate(360deg); } }
    .spin { display:inline-block; animation:spin .7s linear infinite; }
    /* Reportes pills */
    .rpt-pill{font-size:11px;padding:3px 10px;border:1px solid var(--border-soft);border-radius:20px;background:none;cursor:pointer;color:var(--text-muted);transition:all .15s;white-space:nowrap;}
    .rpt-pill:hover{background:var(--hover-row);color:var(--text-main);}
    .rpt-pill.active{background:rgba(37,99,235,.1);color:var(--jira-blue);border-color:rgba(37,99,235,.35);font-weight:600;}
    .rpt-radio{font-size:11px;padding:3px 10px;border:1px solid var(--border-soft);border-radius:20px;background:none;cursor:pointer;color:var(--text-muted);transition:all .15s;white-space:nowrap;}
    .rpt-radio:hover{background:var(--hover-row);color:var(--text-main);}
    .rpt-radio.active{background:var(--jira-blue);color:#fff;border-color:var(--jira-blue);}
    .rpt-input{width:100%;padding:7px 10px;border:1px solid var(--border-soft);border-radius:6px;font-size:12px;background:var(--bg-card);color:var(--text-main);}
    .rpt-input:focus{outline:none;border-color:var(--jira-blue);}
    .rpt-table th,.rpt-table td{padding:7px 10px;text-align:left;white-space:nowrap;}
    .rpt-table th{font-size:9px;font-family:monospace;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);font-weight:600;background:var(--bg-header);}
    .rpt-table tr:not(:first-child){border-top:1px solid var(--border-soft);}
    .rpt-table tr:nth-child(even) td{background:var(--bg-header);}
    /* Sin asignar — filter pills + SLA urgency chips */
    .sa-pill{font-size:11px;padding:3px 10px;border:1px solid var(--border-soft);border-radius:20px;background:none;cursor:pointer;color:var(--text-muted);transition:all .15s;white-space:nowrap;}
    .sa-pill:hover{background:var(--hover-row);color:var(--text-main);}
    .sa-pill.active{background:var(--jira-blue);color:#fff;border-color:var(--jira-blue);}
    .ec-sort-btn{font-size:11px;padding:3px 10px;border:1px solid var(--border-soft);border-radius:20px;background:none;cursor:pointer;color:var(--text-muted);transition:all .15s;white-space:nowrap;display:inline-flex;align-items:center;gap:4px;}
    .ec-sort-btn:hover{background:var(--hover-row);color:var(--text-main);}
    .ec-sort-btn.active{background:#7c3aed;color:#fff;border-color:#7c3aed;}
    .c-red{color:#ef4444;}
    .sla-chip{display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:700;padding:1px 7px;border-radius:10px;font-family:monospace;white-space:nowrap;flex-shrink:0;}
    .sla-breach{background:rgba(239,68,68,.15);color:#dc2626;}
    .sla-critical{background:rgba(239,68,68,.12);color:#dc2626;}
    .sla-warning{background:rgba(245,158,11,.12);color:#b45309;}
    .sla-attention{background:rgba(234,179,8,.1);color:#92400e;}
    .sla-ok{background:rgba(16,185,129,.1);color:#059669;}
    /* Bandera SLA — siempre visible en tickets abiertos */
    .sla-flag{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:800;padding:2px 8px;border-radius:5px;font-family:monospace;white-space:nowrap;flex-shrink:0;letter-spacing:.3px;}
    .sla-flag i{font-size:9px;}
    .sla-f-red   {background:#ef4444;color:#fff;}
    .sla-f-amber {background:#f97316;color:#fff;}
    .sla-f-yellow{background:#eab308;color:#fff;}
    .sla-f-green {background:#10b981;color:#fff;}
    .meta-time{font-family:monospace;font-size:10px;background:var(--bg-main);border:1px solid var(--border-soft);border-radius:4px;padding:0 4px;margin-left:4px;opacity:.8;}
    /* Analizador panel */
    .an-stab{font-size:12px;padding:5px 14px;border-radius:8px;border:none;background:none;font-weight:600;color:var(--text-muted);cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;gap:5px;}
    .an-stab.active{background:var(--jira-blue);color:#fff;}
    .an-upload{border:2px dashed var(--border-soft);border-radius:12px;padding:36px 24px;text-align:center;cursor:pointer;transition:all .2s;margin:0;}
    .an-upload:hover,.an-upload.drag-over{border-color:var(--jira-blue);background:rgba(37,99,235,.04);}
    .an-stat{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:10px;padding:10px 14px;flex:1;min-width:100px;}
    .an-stat-lbl{font-size:10px;color:var(--text-muted);font-weight:700;text-transform:uppercase;letter-spacing:.4px;}
    .an-stat-val{font-size:20px;font-weight:800;color:var(--text-main);margin-top:2px;}
    .an-table{width:100%;border-collapse:collapse;font-size:12px;}
    .an-table th{background:var(--bg-header);padding:7px 12px;text-align:left;font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.3px;border-bottom:1px solid var(--border-soft);position:sticky;top:0;z-index:1;}
    .an-table td{padding:6px 12px;border-bottom:1px solid var(--border-soft);color:var(--text-main);white-space:nowrap;max-width:200px;overflow:hidden;text-overflow:ellipsis;}
    .an-table tr:hover td{background:var(--hover-row);}
    .an-card{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:12px;overflow:hidden;margin-bottom:12px;}
    .an-card-head{padding:11px 16px;background:var(--bg-header);border-bottom:1px solid var(--border-soft);display:flex;align-items:center;justify-content:space-between;}
    .an-card-title{font-size:13px;font-weight:700;color:var(--text-main);display:flex;align-items:center;gap:7px;}
    .an-btn{padding:5px 12px;font-size:11px;font-weight:600;border-radius:7px;border:1px solid var(--border-soft);background:var(--bg-card);color:var(--text-muted);cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;gap:5px;}
    .an-btn:hover{background:var(--hover-row);color:var(--text-main);}
    .an-btn-primary{background:var(--jira-blue);color:#fff;border-color:var(--jira-blue);}
    .an-btn-primary:hover{opacity:.88;}
    .an-dashtab{background:none;border:none;border-bottom:2px solid transparent;padding:8px 16px;font-size:12px;font-weight:600;color:var(--text-muted);cursor:pointer;transition:all .18s;display:inline-flex;align-items:center;gap:6px;margin-bottom:-1px;}
    .an-dashtab:hover{color:var(--text-main);}
    .an-dashtab.active{color:var(--jira-blue);border-bottom-color:var(--jira-blue);}
    .an-input{padding:6px 10px;border:1px solid var(--border-soft);border-radius:6px;font-size:12px;background:var(--bg-card);color:var(--text-main);outline:none;}
    .an-input:focus{border-color:var(--jira-blue);}
    .sql-editor-an{width:100%;border:1px solid var(--border-soft);border-radius:8px;padding:10px 12px;font-size:12px;font-family:monospace;background:var(--bg-header);color:var(--text-main);outline:none;resize:vertical;line-height:1.6;}
    .sql-editor-an:focus{border-color:var(--jira-blue);}
    .an-schema-table{display:flex;align-items:center;gap:6px;padding:5px 8px;border-radius:6px;cursor:pointer;font-size:11px;font-weight:600;color:var(--text-main);transition:background .15s;}
    .an-schema-table:hover{background:var(--hover-row);}
    .an-schema-cols{padding-left:16px;}
    .an-schema-col{display:flex;align-items:center;justify-content:space-between;padding:3px 8px;border-radius:5px;cursor:pointer;font-size:10px;gap:6px;transition:background .15s;}
    .an-schema-col:hover{background:var(--hover-row);}
    .an-history-item{display:flex;align-items:center;gap:6px;padding:6px 10px;background:var(--bg-card);border:1px solid var(--border-soft);border-radius:7px;cursor:pointer;transition:background .15s;}
    .an-history-item:hover{background:var(--hover-row);}
    /* Dashboard Ejecutivo */
    .exec-kpi-card{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:12px;padding:16px 20px;position:relative;overflow:hidden;}
    .exec-kpi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--exec-accent,#3b82f6);}
    .exec-kpi-lbl{font-size:9px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px;}
    .exec-kpi-val{font-size:28px;font-weight:800;line-height:1;margin-bottom:6px;}
    .exec-kpi-delta{font-size:11px;font-weight:600;display:flex;align-items:center;gap:3px;}
    .exec-kpi-delta.up{color:#10b981;} .exec-kpi-delta.down{color:#ef4444;} .exec-kpi-delta.neu{color:var(--text-muted);}
    .exec-chart-card{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:12px;padding:14px 16px;}
    .exec-chart-ttl{font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.07em;margin-bottom:10px;display:flex;align-items:center;gap:6px;}
    .exec-btn{padding:5px 14px;font-size:11px;font-weight:600;border-radius:20px;border:1px solid var(--border-soft);background:var(--bg-card);color:var(--text-muted);cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;gap:5px;}
    .exec-btn:hover{background:var(--hover-row);color:var(--text-main);}
    .exec-btn.active,.exec-btn.primary{background:var(--jira-blue);color:#fff;border-color:var(--jira-blue);}
    .exec-btn.primary:hover,.exec-btn.active:hover{opacity:.88;}
    .ni-exec{background:rgba(0,63,165,.12);color:#003fa5;}
    [data-theme="dark"] .ni-exec{background:rgba(96,165,250,.12);color:#60a5fa;}
    /* Dashboard Jira charts */
    .jdb-card{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:12px;overflow:hidden;min-width:0;}
    .jdb-card-hd{padding:10px 14px;background:var(--bg-header);border-bottom:1px solid var(--border-soft);display:flex;align-items:center;justify-content:space-between;}
    .jdb-card-title{font-size:12px;font-weight:700;color:var(--text-main);display:flex;align-items:center;gap:6px;}
    .jdb-chart-wrap{padding:12px;position:relative;height:clamp(190px,22vh,280px);}
    .jdb-grid-2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:12px;}
    .jdb-grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:12px;}
    .jdb-kpi-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;}
    .jdb-kpi{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:10px;padding:10px 14px;flex:1;min-width:90px;text-align:center;}
    .jdb-kpi-v{font-size:22px;font-weight:800;font-family:monospace;}
    .jdb-kpi-l{font-size:10px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.4px;margin-top:1px;}
    .jdb-section-hd{display:flex;align-items:center;justify-content:space-between;margin:18px 0 10px;}
    .jdb-section-title{font-size:13px;font-weight:800;color:var(--text-main);display:flex;align-items:center;gap:7px;}
    .jdb-period-btn{font-size:10px;padding:2px 9px;border:1px solid var(--border-soft);border-radius:4px;background:none;cursor:pointer;color:var(--text-muted);transition:all .15s;}
    .jdb-period-btn.active{background:var(--jira-blue);color:#fff;border-color:var(--jira-blue);}
    .jdb-skeleton{background:linear-gradient(90deg,var(--bg-header) 25%,var(--bg-card) 50%,var(--bg-header) 75%);background-size:200%;animation:incShimmer 1.4s infinite;border-radius:8px;height:200px;}
    /* Mis Paneles */
    .mp-period-btn{font-size:10px;padding:3px 10px;border:1px solid var(--border-soft);border-radius:5px;background:none;cursor:pointer;color:var(--text-muted);transition:all .15s;}
    .mp-period-btn.active{background:var(--jira-blue);color:#fff;border-color:var(--jira-blue);}
    .mp-tab{font-size:12px;font-weight:700;padding:7px 16px;border-radius:8px;cursor:pointer;color:var(--text-muted);display:inline-flex;align-items:center;gap:6px;transition:all .15s;}
    .mp-tab.active{background:var(--jira-blue);color:#fff;}
    .mp-chip{font-size:11px;padding:4px 12px;border:1px solid var(--border-soft);border-radius:20px;background:var(--bg-card);color:var(--text-muted);cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:all .15s;}
    .mp-chip.active{background:rgba(37,99,235,.12);border-color:var(--jira-blue);color:var(--jira-blue);font-weight:700;}
    .mp-kpi-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;}
    .mp-kpi{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:10px;padding:10px 16px;flex:1;min-width:80px;text-align:center;}
    .mp-kpi-v{font-size:20px;font-weight:800;font-family:monospace;}
    .mp-kpi-l{font-size:10px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.4px;margin-top:1px;}
    .mp-chart-card{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:12px;overflow:hidden;min-width:0;}
    .mp-chart-hd{padding:10px 14px;background:var(--bg-header);border-bottom:1px solid var(--border-soft);display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:700;color:var(--text-main);}
    .mp-chart-body{padding:10px;height:220px;position:relative;}
    .mp-chart-dl{background:none;border:none;cursor:pointer;color:var(--text-muted);font-size:11px;padding:2px 6px;border-radius:4px;transition:all .15s;}
    .mp-chart-dl:hover{background:var(--hover-row);color:var(--text-main);}
    .mp-dl-btn{padding:7px 16px;font-size:11px;font-weight:700;border-radius:7px;border:none;background:var(--jira-blue);color:#fff;cursor:pointer;display:inline-flex;align-items:center;gap:6px;}
    .mp-dl-btn:hover{opacity:.88;}
    .mp-chart-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:14px;}
    .mp-branding-hd{padding:14px 20px 12px;border-bottom:2px solid var(--jira-blue);display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
    /* Sidebar redesign */
    .nav-search-pin { background:rgba(37,99,235,.07);border:1px solid rgba(37,99,235,.2);border-radius:8px;color:var(--jira-blue);font-weight:600; }
    .nav-search-pin:hover { background:rgba(37,99,235,.13);color:var(--jira-blue); }
    .nav-search-pin.active { background:rgba(37,99,235,.15);border-color:var(--jira-blue); }
    .nav-sec-op  { color:#2563eb;border-left:2px solid #2563eb;padding-left:8px;font-weight:700;cursor:pointer;display:flex;align-items:center;user-select:none; }
    .nav-sec-mon { color:#d97706;border-left:2px solid #f59e0b;padding-left:8px;font-weight:700;cursor:pointer;display:flex;align-items:center;user-select:none; }
    .nav-sec-anl { color:#7c3aed;border-left:2px solid #7c3aed;padding-left:8px;font-weight:700;cursor:pointer;display:flex;align-items:center;user-select:none; }
    .nav-sec-op:hover,.nav-sec-mon:hover,.nav-sec-anl:hover { opacity:.8; }
    .nav-sec-chev { margin-left:auto;font-size:9px;opacity:.55;transition:transform .2s; }
    .nav-group { overflow:hidden;max-height:600px;transition:max-height .22s cubic-bezier(.4,0,.2,1); }
    .nav-group.collapsed { max-height:0 !important; }
    @keyframes alert-badge-pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.75;transform:scale(1.12)} }
    .alert-pulse-anim { animation:alert-badge-pulse .85s ease-in-out infinite; }
    /* CMDB empty state */
    .cmdb-empty { display:block;padding:4px 0; }
    .cmdb-empty-icon { width:36px;height:36px;border-radius:10px;background:rgba(124,58,237,.1);display:flex;align-items:center;justify-content:center;font-size:17px;color:#7c3aed;flex-shrink:0; }
    .cmdb-empty-title { font-size:13px;font-weight:700;color:var(--text-main); }
    .cmdb-empty-sub { font-size:11px;color:var(--text-muted);line-height:1.5; }
    .cmdb-grid { display:grid;grid-template-columns:240px 1fr;gap:18px;align-items:start; }
    @media(max-width:720px){ .cmdb-grid{ grid-template-columns:1fr; } }
    .cmdb-ex-chip { display:inline-flex;align-items:center;gap:5px;font-size:11px;padding:5px 13px;border-radius:20px;border:1px solid var(--border-soft);background:var(--bg-card);color:var(--text-muted);cursor:pointer;transition:all .15s;font-family:monospace;font-weight:600; }
    .cmdb-ex-chip:hover { border-color:#7c3aed;color:#7c3aed;background:rgba(124,58,237,.05); }
    .cmdb-skel { background:linear-gradient(90deg,var(--bg-header) 25%,var(--bg-card) 50%,var(--bg-header) 75%);background-size:200%;animation:incShimmer 1.4s infinite;border-radius:10px;height:56px;flex-shrink:0; }
    /* Top incidentes cards */
    .cmdb-top-card { display:flex;align-items:center;gap:10px;padding:9px 13px;border-radius:10px;border:1px solid var(--border-soft);background:var(--bg-card);cursor:pointer;transition:all .15s; }
    .cmdb-top-card:hover { transform:translateX(3px); }
    .ctc-icon { width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0; }
    .ctc-body { flex:1;min-width:0; }
    .ctc-code { font-size:12px;font-weight:700;color:var(--text-main);font-family:monospace;line-height:1.2; }
    .ctc-sub  { font-size:10px;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px; }
    .ctc-count { text-align:right;flex-shrink:0;margin-right:4px; }
    .ctc-num { font-size:20px;font-weight:800;font-family:monospace;line-height:1; }
    .ctc-lbl { font-size:9px;color:var(--text-muted); }
    .ctc-badge { padding:2px 8px;border-radius:20px;font-size:9px;font-weight:700;white-space:nowrap;flex-shrink:0; }

    /* ── Hamburger toggle (mobile only) ── */
    #incMenuBtn { display:none;align-items:center;justify-content:center;width:34px;height:34px;border:1px solid var(--border-soft);border-radius:6px;background:var(--bg-card);cursor:pointer;color:var(--text-muted);flex-shrink:0;transition:background .15s,color .15s; }
    #incMenuBtn:hover { background:var(--hover-row);color:var(--text-main); }
    /* ── Overlay backdrop ── */
    #incSidebarOverlay { display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:250;opacity:0;transition:opacity .25s;pointer-events:none; }
    #incSidebarOverlay.inc-mob-open { opacity:1;pointer-events:auto; }

    /* ── Responsive: tablet & mobile ── */
    @media (max-width: 768px) {
      #incMenuBtn { display:flex !important; }
      .itsm-breadcrumb { display:none !important; }
      .itsm-topbar { padding:8px 12px !important;gap:8px !important; }
      /* Sidebar becomes a fixed slide-over drawer */
      #incSidebar {
        position:fixed !important;
        top:0;left:0;bottom:0;
        z-index:300;
        width:260px !important;
        min-width:0 !important;
        transform:translateX(-100%);
        transition:transform .25s cubic-bezier(.4,0,.2,1);
        box-shadow:4px 0 28px rgba(0,0,0,.22);
      }
      #incSidebar.inc-mob-open { transform:translateX(0); }
      #incSidebarOverlay { display:block !important; }
      /* Content area full width */
      #incScrollArea { padding:10px !important; }
      /* KPI grids 4-col → 2-col */
      .tec-kpis,.sla-kpis,.hm-kpis { grid-template-columns:repeat(2,1fr) !important; }
      /* Local todos 6-col → 3-col */
      .inc-kpi-grid { grid-template-columns:repeat(3,1fr) !important; }
      /* Heatmap charts 2-col → 1-col */
      .hm-charts { grid-template-columns:1fr !important; }
      /* Indicadores 6-col KPI → 3-col */
      .inc-ind-kpi-grid { grid-template-columns:repeat(3,1fr) !important; }
      /* Exec KPI 5-col → 3-col, chart 2-col → 1-col */
      #execKpiRow { grid-template-columns:repeat(3,1fr) !important; }
      .exec-chart-2col { grid-template-columns:1fr !important; }
      /* Tables: horizontal scroll */
      .tec-table,.sla-table { display:block !important;overflow-x:auto !important;-webkit-overflow-scrolling:touch; }
      /* Kanban column min-width */
      .kb-col { min-width:220px !important; }
      /* Toolbars wrap */
      .tec-toolbar,.sla-toolbar,.hm-toolbar,.kb-toolbar { flex-wrap:wrap !important; }
      /* Histórico: stack form fields */
      .hist-form { flex-direction:column !important; }
      .hist-form > div, .hist-form > button, .hist-form input, .hist-form select { width:100% !important; box-sizing:border-box !important; }
      /* Indicadores: unlock fixed height so #incScrollArea can scroll through it */
      #panel-indicadores { height:auto !important; overflow:visible !important; }
      /* Charts row: stack vertically instead of horizontal fixed-width */
      #kpiChartsSection { flex:none !important; flex-direction:column !important; height:auto !important; }
      #kpiChartsSection > div { flex:none !important; width:100% !important; }
      #kpiChartsSection > div:first-child { height:200px !important; }
      #kpiChartsSection > div:nth-child(2) { height:160px !important; }
      /* Tech / rankings row: stack vertically, give each section a fixed height */
      #kpiTechRow { flex:none !important; flex-direction:column !important; height:auto !important; }
      #kpiTechRow > div { flex:none !important; height:200px !important; }
      /* Breach / MTTR / metric boxes row: stack vertically */
      #kpiBreachRow { flex:none !important; flex-direction:column !important; height:auto !important; }
      #kpiBreachRow > div { flex:none !important; }
      #kpiBreachRow > div:first-child { height:240px !important; }
      #kpiBreachRow > div:nth-child(2) { height:200px !important; }
      /* Comparativa: let #incScrollArea handle vertical scroll */
      #swPanel { flex:none !important; overflow:visible !important; }
      /* Mis Paneles: tabs wrap, smaller text */
      #mpTabBar { width:100% !important; flex-wrap:wrap !important; }
      .mp-tab { font-size:10px !important; padding:5px 8px !important; flex:1 1 auto !important; justify-content:center !important; }
      /* CMDB: stat cards — override JS-set height:80px so text never clips */
      #qstat-inc-equip, #qstat-inc-email { height:auto !important; min-height:76px !important; }
      /* CMDB: ticket history table horizontal scroll */
      #cmdbTicketHistWrap { overflow-x:auto !important; }
      /* CMDB: top-inc cards fit full width cleanly */
      .ctc-sub { font-size:9px !important; }
    }
    /* ── Responsive: medium screens (laptop 900-1200px) ── */
    @media (max-width: 1200px) {
      #mpTabBar { width:100% !important; flex-wrap:wrap !important; }
      .mp-tab { flex:1 1 auto; justify-content:center; min-width:100px; }
    }
    /* ── Responsive: altura pequeña — compactar nav para que todos los ítems sean visibles ── */
    /* 768px CSS (pantalla 768px sin DPI / 960px con 125%) */
    @media (max-height: 900px) {
      #incSidebar .nav-item { padding:5px 14px !important; font-size:12.5px !important; }
