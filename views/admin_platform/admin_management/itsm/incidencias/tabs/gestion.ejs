                <div class="meta-lbl" style="margin-bottom:6px;">Prioridad <span style="font-size:9px;opacity:.6;">(selección múltiple)</span></div>
                <div style="display:flex;flex-wrap:wrap;gap:5px;">
                  <button class="rpt-pill active" data-grp="prio" data-val="Highest" onclick="this.classList.toggle('active')" style="border-color:#ef4444;color:#ef4444;">P1 · Crítica</button>
                  <button class="rpt-pill active" data-grp="prio" data-val="High"    onclick="this.classList.toggle('active')" style="border-color:#f59e0b;color:#b45309;">P2 · Alta</button>
                  <button class="rpt-pill active" data-grp="prio" data-val="Medium"  onclick="this.classList.toggle('active')" style="border-color:#3b82f6;color:#1d4ed8;">P3 · Media</button>
                  <button class="rpt-pill active" data-grp="prio" data-val="Low"     onclick="this.classList.toggle('active')" style="border-color:#10b981;color:#047857;">P4 · Baja</button>
                  <button class="rpt-pill active" data-grp="prio" data-val="Lowest"  onclick="this.classList.toggle('active')">Sin prioridad</button>
                </div>
              </div>

              <!-- SLA + Asignado + Reporter -->
              <div style="display:grid;grid-template-columns:auto 1fr 1fr;gap:16px;align-items:start;flex-wrap:wrap;margin-bottom:14px;">
                <div>
                  <div class="meta-lbl" style="margin-bottom:6px;">SLA</div>
                  <div style="display:flex;gap:4px;flex-wrap:wrap;">
                    <button class="rpt-radio active" data-grp="sla" data-val=""       onclick="rptRadioClick(this)">Todos</button>
                    <button class="rpt-radio"        data-grp="sla" data-val="ok"     onclick="rptRadioClick(this)">Cumplido</button>
                    <button class="rpt-radio"        data-grp="sla" data-val="breach" onclick="rptRadioClick(this)">Vencido</button>
                    <button class="rpt-radio"        data-grp="sla" data-val="risk"   onclick="rptRadioClick(this)">En riesgo</button>
                  </div>
                </div>
                <div>
                  <div class="meta-lbl" style="margin-bottom:4px;">Asignado (correo)</div>
                  <input type="email" id="rpt-assignee" class="rpt-input" placeholder="Todos los asignados...">
                </div>
                <div>
                  <div class="meta-lbl" style="margin-bottom:4px;">Reporter (correo)</div>
                  <input type="email" id="rpt-reporter" class="rpt-input" placeholder="Todos los reporters...">
                </div>
              </div>

              <!-- Máx + Generar -->
              <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                  <div class="meta-lbl">Máx resultados:</div>
                  <button class="rpt-radio"        data-grp="maxres" data-val="100"  onclick="rptRadioClick(this)">100</button>
                  <button class="rpt-radio active" data-grp="maxres" data-val="500"  onclick="rptRadioClick(this)">500</button>
                  <button class="rpt-radio"        data-grp="maxres" data-val="1000" onclick="rptRadioClick(this)">1 000</button>
                  <button class="rpt-radio"        data-grp="maxres" data-val="2000" onclick="rptRadioClick(this)">Sin límite</button>
                </div>
                <button class="btn-create" style="padding:8px 20px;font-size:12px;" onclick="runReporte()">
                  <i class="bi bi-search"></i> Generar reporte
                </button>
              </div>
            </div>

            <!-- Summary row -->
            <div id="rpt-summary" style="display:none;margin-bottom:14px;"></div>

            <!-- Preview table -->
            <div id="rpt-preview"></div>
          </div>

        </div>

        <!-- ── PANEL: ANALIZADOR ──────────────────────────────────────────── -->
        <div class="panel" id="panel-analizador">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:8px;">
            <div>
              <div style="font-size:16px;font-weight:800;color:var(--text-main);display:flex;align-items:center;gap:8px;">
                <i class="bi bi-bar-chart-line-fill" style="color:var(--jira-blue);"></i> Analizador de datos
              </div>
              <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">Carga el CSV/Excel exportado desde Reportes y genera gráficos al instante</div>
            </div>
          </div>

          <!-- Sub-tab bar -->
          <div style="display:flex;gap:4px;margin-bottom:16px;background:var(--bg-card);border:1px solid var(--border-soft);border-radius:10px;padding:4px;width:fit-content;">
            <button class="an-stab active" id="anStab0" onclick="anSwitchTab(0)">
              <i class="bi bi-file-earmark-spreadsheet-fill"></i> Excel / CSV
            </button>
            <button class="an-stab" id="anStab1" onclick="anSwitchTab(1)">
              <i class="bi bi-terminal-fill"></i> SQL Playground
            </button>
          </div>

          <!-- ── EXCEL/CSV TAB ── -->
          <div id="anTab0">
            <!-- Upload zone -->
            <div id="anDataUpload" class="an-card">
              <div class="an-card-head">
                <span class="an-card-title"><i class="bi bi-file-earmark-spreadsheet-fill" style="color:#059669;"></i> Cargar archivos Excel / CSV</span>
                <span style="font-size:11px;color:var(--text-muted);">Hasta 3 archivos · .xlsx .xls .csv · máx. 10MB c/u</span>
              </div>
              <div style="padding:16px;">
                <div class="an-upload" id="anDzData"
                     onclick="document.getElementById('anFileInput').click()"
                     ondragover="anDragOver(event)" ondragleave="anDragLeave(event)" ondrop="anDropData(event)">
                  <i class="bi bi-files" style="color:var(--jira-blue);font-size:38px;display:block;margin-bottom:10px;"></i>
                  <p style="font-size:13px;color:var(--text-muted);margin:0;"><strong style="color:var(--jira-blue);">Haz clic o arrastra</strong> hasta 3 archivos Excel o CSV</p>
                  <p style="font-size:11px;color:var(--text-muted);margin:6px 0 0;">Los datos de múltiples archivos se combinarán automáticamente</p>
                </div>
                <input type="file" id="anFileInput" style="display:none;" accept=".csv,.xlsx,.xls" multiple onchange="anLoadFiles(this.files)">
                <div id="anFileChips" style="margin-top:10px;display:none;"></div>
              </div>
            </div>

            <!-- ── Guía de análisis (visible hasta que se cargue un archivo) ── -->
            <div id="anQuickGuide" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:12px;">
              <!-- Cómo exportar -->
              <div class="an-card">
                <div class="an-card-head"><span class="an-card-title"><i class="bi bi-cloud-arrow-down-fill" style="color:#3b82f6;"></i> Cómo exportar desde Jira</span></div>
                <div style="padding:14px;font-size:12px;color:var(--text-muted);line-height:1.9;">
                  <ol style="margin:0 0 10px;padding-left:16px;">
                    <li>Colas → aplicar filtro JQL</li>
                    <li>Menú <strong style="color:var(--text-main);">Exportar</strong> → CSV / Excel</li>
                    <li>Arrastra el archivo aquí arriba</li>
                  </ol>
                  <div style="background:var(--bg-main);border:1px solid var(--border-soft);border-radius:7px;padding:9px 11px;">
                    <div style="font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px;">Columnas clave</div>
                    <div style="display:flex;flex-wrap:wrap;gap:4px;">
                      <% ['Issue Key','Status','Priority','Assignee','Reporter','Created','Resolved','Time to resolve','Component'].forEach(function(c){ %>
                        <span style="background:var(--bg-card);border:1px solid var(--border-soft);border-radius:4px;padding:1px 7px;font-size:10px;color:var(--text-muted);"><%= c %></span>
                      <% }) %>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Análisis disponibles -->
              <div class="an-card">
                <div class="an-card-head"><span class="an-card-title"><i class="bi bi-bar-chart-fill" style="color:#8b5cf6;"></i> Análisis disponibles</span></div>
                <div style="padding:14px;display:flex;flex-direction:column;gap:8px;">
                  <% [
                    ['bi-graph-up-arrow','#3b82f6','Tendencias temporales automáticas'],
                    ['bi-pie-chart-fill','#8b5cf6','Distribución por cualquier campo'],
                    ['bi-people-fill','#10b981','Rankings de técnicos y reporteros'],
                    ['bi-shield-check','#6366f1','Análisis de SLA y tiempos'],
                    ['bi-funnel-fill','#f59e0b','Filtros multi-campo en tiempo real'],
                    ['bi-graph-up','#ec4899','Gráficos de barras, línea y pie custom'],
                    ['bi-download','#0ea5e9','Exportar datos filtrados a CSV']
                  ].forEach(function(i){ %>
                    <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-muted);">
                      <i class="bi <%= i[0] %>" style="color:<%= i[1] %>;flex-shrink:0;"></i> <%= i[2] %>
                    </div>
                  <% }) %>
                </div>
              </div>
              <!-- Plantillas rápidas -->
              <div class="an-card">
                <div class="an-card-head"><span class="an-card-title"><i class="bi bi-lightning-charge-fill" style="color:#f59e0b;"></i> Plantillas de análisis</span></div>
                <div style="padding:14px;">
                  <div style="font-size:11px;color:var(--text-muted);margin-bottom:10px;">Carga un archivo y aplica una plantilla para generar gráficos automáticamente:</div>
                  <div style="display:flex;flex-direction:column;gap:6px;">
                    <button class="an-btn" style="justify-content:flex-start;" onclick="anApplyTemplate('sla')"><i class="bi bi-shield-check" style="color:#6366f1;"></i> Reporte SLA</button>
                    <button class="an-btn" style="justify-content:flex-start;" onclick="anApplyTemplate('tecnicos')"><i class="bi bi-people-fill" style="color:#10b981;"></i> Productividad Técnicos</button>
                    <button class="an-btn" style="justify-content:flex-start;" onclick="anApplyTemplate('tendencia')"><i class="bi bi-graph-up-arrow" style="color:#3b82f6;"></i> Tendencia Mensual</button>
                    <button class="an-btn" style="justify-content:flex-start;" onclick="anApplyTemplate('prioridad')"><i class="bi bi-flag-fill" style="color:#f59e0b;"></i> Análisis de Prioridades</button>
                  </div>
                </div>
              </div>
            </div>
            <!-- Auto-stats (aparece al cargar archivos) -->
            <div id="anAutoStats" style="display:none;margin-top:12px;"></div>

            <!-- Dashboard (hidden until files loaded) -->
            <div id="anDashboard" style="display:none;">
              <!-- Header card (always visible) -->
              <div class="an-card" style="margin-bottom:10px;">
                <div class="an-card-head">
                  <span class="an-card-title"><i class="bi bi-bar-chart-fill" style="color:var(--jira-blue);"></i> <span id="anFileName">Análisis de datos</span></span>
                  <div style="display:flex;gap:6px;flex-wrap:wrap;">
                    <button class="an-btn" onclick="document.getElementById('anFileInput').click()"><i class="bi bi-plus-circle"></i> Agregar</button>
                    <button class="an-btn" onclick="anExportCSV()"><i class="bi bi-download"></i> CSV</button>
                    <button class="an-btn" onclick="anDashTab(0);anAddChart()"><i class="bi bi-graph-up"></i> + Gráfico</button>
                    <button class="an-btn" onclick="anReset()"><i class="bi bi-arrow-counterclockwise"></i> Limpiar</button>
                  </div>
                </div>
                <!-- Inner tab switcher -->
                <div style="display:flex;padding:0 12px;border-top:1px solid var(--border-soft);">
                  <button id="anDashBtn0" class="an-dashtab active" onclick="anDashTab(0)"><i class="bi bi-graph-up-arrow"></i> Gráficos</button>
                  <button id="anDashBtn1" class="an-dashtab" onclick="anDashTab(1)"><i class="bi bi-table"></i> Datos</button>
                </div>
              </div>

              <!-- Tab 0: Gráficos -->
              <div id="anTabViz">
                <!-- Stats row -->
                <div id="anStats" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px;"></div>
                <!-- Chart area -->
                <div id="anChartArea" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;"></div>
              </div>

              <!-- Tab 1: Datos -->
              <div id="anTabData" style="display:none;">
                <!-- Search + Filters -->
                <div class="an-card" style="margin-bottom:10px;">
                  <div style="padding:9px 16px;border-bottom:1px solid var(--border-soft);display:flex;align-items:center;gap:8px;">
                    <i class="bi bi-search" style="color:var(--text-muted);font-size:12px;"></i>
                    <input type="text" id="anGlobalSearch" class="an-input" style="flex:1;" placeholder="Buscar en todos los campos…" oninput="anOnSearch(this.value)">
                    <span id="anRowCount" style="font-size:11px;color:var(--text-muted);white-space:nowrap;"></span>
                  </div>
                  <div id="anFilterBar" style="padding:10px 16px;display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;min-height:48px;"></div>
                </div>
                <!-- Data table -->
                <div class="an-card">
                  <div class="an-card-head">
                    <span class="an-card-title"><i class="bi bi-table"></i> Datos</span>
                    <div style="display:flex;align-items:center;gap:8px;">
                      <label style="font-size:11px;color:var(--text-muted);">Filas/pág:</label>
                      <select id="anPageSize" class="an-input" style="width:70px;padding:3px 6px;" onchange="_an.pageSize=+this.value;_an.page=1;anRenderTable()">
                        <option>25</option><option>50</option><option>100</option><option>250</option>
                      </select>
                    </div>
                  </div>
                  <div id="anTableWrap" style="overflow-x:auto;overflow-y:auto;max-height:520px;"></div>
                  <div id="anPagination" style="padding:8px 16px;display:flex;gap:5px;align-items:center;border-top:1px solid var(--border-soft);flex-wrap:wrap;"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- ── SQL PLAYGROUND TAB ── -->
          <div id="anTab1" style="display:none;">
            <div style="display:grid;grid-template-columns:170px 1fr 1fr;gap:12px;margin-bottom:12px;">
              <!-- Schema Browser -->
              <div class="an-card" style="overflow:hidden;">
                <div class="an-card-head" style="padding:8px 12px;">
                  <span class="an-card-title" style="font-size:11px;"><i class="bi bi-diagram-3-fill" style="color:#7c3aed;"></i> Esquema BD</span>
                  <button class="an-btn" style="padding:2px 6px;font-size:10px;" onclick="anLoadSchema(true)" title="Recargar"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
                <div id="anSchemaTree" style="overflow-y:auto;max-height:320px;padding:6px;">
                  <div style="font-size:11px;color:var(--text-muted);padding:16px 8px;text-align:center;"><span class="kb-spin" style="display:inline-block;"></span><br>Cargando…</div>
                </div>
              </div>
              <!-- Editor -->
              <div class="an-card">
                <div class="an-card-head">
                  <span class="an-card-title"><i class="bi bi-file-code-fill" style="color:#7c3aed;"></i> Editor SQL</span>
                  <div style="display:flex;gap:6px;">
                    <button class="an-btn" onclick="anSqlFormat()" title="Formatear SQL" style="padding:5px 8px;"><i class="bi bi-text-indent-left"></i></button>
                    <button class="an-btn an-btn-primary" onclick="anRunSQL()"><i class="bi bi-play-fill"></i> Ejecutar</button>
                  </div>
                </div>
                <div style="padding:12px;">
                  <textarea id="anSqlEditor" class="sql-editor-an" rows="10"
                    placeholder="-- Solo SELECT / SHOW permitidos&#10;-- Ej: SELECT assignee_name, COUNT(*) total FROM service_requests GROUP BY assignee_name ORDER BY total DESC LIMIT 10"></textarea>
                </div>
                <div style="padding:4px 12px 10px;border-top:1px solid var(--border-soft);">
                  <div style="font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px;margin-top:6px;">Consultas ITSM rápidas</div>
                  <div style="display:flex;gap:5px;flex-wrap:wrap;">
                    <button class="an-btn" style="font-size:10px;" onclick="anSqlQuick(`SELECT assignee_name, COUNT(*) AS tickets, SUM(CASE WHEN status IN ('Closed','Resolved','Cerrado','Resuelto') THEN 1 ELSE 0 END) AS resueltos FROM service_requests WHERE created_at >= DATE_SUB(NOW(), INTERVAL 30 DAY) GROUP BY assignee_name ORDER BY tickets DESC LIMIT 15`)"><i class="bi bi-people-fill" style="color:#10b981;"></i> Por técnico</button>
                    <button class="an-btn" style="font-size:10px;" onclick="anSqlQuick(`SELECT status, COUNT(*) AS total FROM service_requests GROUP BY status ORDER BY total DESC`)"><i class="bi bi-pie-chart-fill" style="color:#8b5cf6;"></i> Por estado</button>
                    <button class="an-btn" style="font-size:10px;" onclick="anSqlQuick(`SELECT priority, COUNT(*) AS total, AVG(TIMESTAMPDIFF(HOUR, created_at, COALESCE(resolved_at, NOW()))) AS mttr_h FROM service_requests GROUP BY priority ORDER BY total DESC`)"><i class="bi bi-flag-fill" style="color:#f59e0b;"></i> SLA/prioridad</button>
                    <button class="an-btn" style="font-size:10px;" onclick="anSqlQuick(`SELECT DATE_FORMAT(created_at,'%Y-%m') AS mes, COUNT(*) AS creados, SUM(CASE WHEN status IN ('Closed','Cerrado','Resolved') THEN 1 ELSE 0 END) AS cerrados FROM service_requests GROUP BY mes ORDER BY mes DESC LIMIT 12`)"><i class="bi bi-graph-up-arrow" style="color:#3b82f6;"></i> Mensual</button>
                    <button class="an-btn" style="font-size:10px;" onclick="anSqlQuick(`SELECT * FROM employees LIMIT 20`)"><i class="bi bi-person-badge-fill" style="color:#6366f1;"></i> Empleados</button>
                    <button class="an-btn" style="font-size:10px;" onclick="anSqlQuick('SHOW TABLES')"><i class="bi bi-list-ul"></i> Tablas</button>
                  </div>
                </div>
              </div>
              <!-- Results -->
              <div style="display:flex;flex-direction:column;gap:10px;">
                <div class="an-card" style="flex:1;">
                  <div class="an-card-head">
                    <span class="an-card-title"><i class="bi bi-table" style="color:#10b981;"></i> Resultados</span>
                    <div style="display:flex;gap:6px;align-items:center;">
                      <span id="anSqlRowCount" style="font-size:11px;color:var(--text-muted);"></span>
                      <span id="anSqlTime" style="font-size:10px;color:var(--text-muted);"></span>
                      <button class="an-btn" onclick="anDownloadSqlCSV()"><i class="bi bi-download"></i> CSV</button>
                    </div>
                  </div>
                  <div id="anSqlTableWrap" style="overflow:auto;max-height:280px;">
                    <div style="padding:36px;text-align:center;color:var(--text-muted);font-size:12px;">
                      <i class="bi bi-terminal" style="font-size:26px;display:block;margin-bottom:8px;opacity:.4;"></i>
                      Ejecuta una consulta para ver resultados
                    </div>
                  </div>
                </div>
                <div class="an-card" style="font-size:11px;color:var(--text-muted);padding:10px 14px;line-height:1.8;">
                  <p style="margin:0 0 3px;"><i class="bi bi-shield-check" style="color:#10b981;"></i> Solo <strong>SELECT</strong> / <strong>SHOW</strong>. Máx. 500 filas.</p>
                  <p style="margin:0;"><i class="bi bi-grid-3x3-gap-fill" style="color:var(--jira-blue);"></i> Cada ejecución agrega un panel al tablero (máx. 3).</p>
                </div>
              </div>
            </div>
            <!-- Query history -->
            <div id="anSqlHistoryRow" style="display:none;margin-bottom:12px;">
              <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px;"><i class="bi bi-clock-history"></i> Historial reciente</div>
              <div id="anSqlHistoryList" style="display:flex;flex-direction:column;gap:5px;"></div>
            </div>
            <!-- Report board -->
            <div id="anSqlBoard" style="display:none;">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:8px;">
                <div style="display:flex;align-items:center;gap:8px;">
                  <span style="font-size:13px;font-weight:800;color:var(--text-main);"><i class="bi bi-grid-3x3-gap-fill" style="color:var(--jira-blue);margin-right:5px;"></i>Tablero visual</span>
                  <span id="anBoardCount" style="background:var(--jira-blue);color:#fff;border-radius:20px;padding:1px 9px;font-size:10px;font-weight:800;"></span>
                </div>
              </div>
              <div id="anBoardInner" style="display:grid;gap:12px;"></div>
            </div>
          </div>
        </div>

          <!-- PANEL: MIS PANELES -->
          <div class="panel" id="panel-paneles">
            <!-- Controls bar (excluded from export) -->
            <div class="mp-hide-export" style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px;">
              <div>
                <div style="font-size:15px;font-weight:800;color:var(--text-main);display:flex;align-items:center;gap:8px;">
                  <i class="bi bi-layout-wtf" style="color:var(--jira-blue);"></i> Mis Paneles
                </div>
                <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">Personaliza tu dashboard · descarga como imagen para presentaciones PPT</div>
              </div>
              <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <button class="mp-period-btn active" onclick="mpPeriod(30,this)">30d</button>
                <button class="mp-period-btn" onclick="mpPeriod(90,this)">90d</button>
                <button class="mp-period-btn" onclick="mpPeriod(365,this)">1 año</button>
                <div style="width:1px;height:18px;background:var(--border-soft);margin:0 2px;"></div>
                <button class="mp-dl-btn" onclick="mpDownload()"><i class="bi bi-download"></i> Descargar PNG</button>
              </div>
            </div>
            <!-- Category tabs -->
            <div id="mpTabBar" class="mp-hide-export" style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:10px;background:var(--bg-header);border:1px solid var(--border-soft);border-radius:10px;padding:4px;width:100%;box-sizing:border-box;">
              <div class="mp-tab active" id="mpTab0" onclick="mpSwitchCat(0)"><i class="bi bi-ticket-detailed-fill"></i> Gestión de Incidencias</div>
              <div class="mp-tab" id="mpTab1" onclick="mpSwitchCat(1)"><i class="bi bi-people-fill"></i> Productividad WP</div>
              <div class="mp-tab" id="mpTab2" onclick="mpSwitchCat(2)"><i class="bi bi-grid-fill"></i> Vista Combinada</div>
            </div>
            <!-- Chart picker chips -->
            <div id="mpChipBar" class="mp-hide-export" style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;padding:10px 12px;background:var(--bg-header);border:1px solid var(--border-soft);border-radius:10px;min-height:42px;align-items:center;"></div>
            <!-- Spinner -->
            <div id="mpSpinner" style="display:none;padding:40px;text-align:center;">
              <span class="kb-spin" style="display:inline-block;"></span>
              <div style="font-size:12px;color:var(--text-muted);margin-top:8px;">Cargando datos de Jira...</div>
            </div>
            <!-- ═══ CAPTURE ZONE — this block is exported as PNG ═══ -->
            <div id="mpCaptureZone">
              <!-- Branded header -->
              <div class="mp-branding-hd">
