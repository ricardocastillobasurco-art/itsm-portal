              <div style="display:flex;gap:8px;flex-shrink:0;">
                <button class="btn-outline-sm" id="btn-export-csv" onclick="exportarReporte('csv')" disabled title="Genera el reporte primero" style="opacity:.4;cursor:not-allowed;"><i class="bi bi-filetype-csv"></i> CSV</button>
                <button class="btn-create" id="btn-export-xlsx" onclick="exportarReporte('xlsx')" disabled title="Genera el reporte primero" style="padding:7px 14px;font-size:12px;opacity:.4;cursor:not-allowed;"><i class="bi bi-file-earmark-excel-fill"></i> Excel</button>
              </div>
