              <div class="kpi-stat-card ks-green" onclick="document.getElementById('kpiChartsSection').scrollIntoView({behavior:'smooth'})">
                <div class="kpi-stat-icon"><i class="bi bi-shield-check-fill"></i></div>
                <div class="kpi-stat-body">
                  <div class="kpi-num" id="kpiDentroSla">—</div>
                  <div class="kpi-lbl">Dentro SLA</div>
                  <div class="kpi-hint">Ver evolución ↓</div>
                </div>
              </div>
              <div class="kpi-stat-card ks-red" onclick="(document.getElementById('nav-sinAsig')||{click:()=>{}}).click()">
                <div class="kpi-stat-icon"><i class="bi bi-clock-history"></i></div>
                <div class="kpi-stat-body">
                  <div class="kpi-num" id="kpiFueraSla">—</div>
                  <div class="kpi-lbl">Fuera SLA</div>
                  <div class="kpi-hint">Ir a cola →</div>
                </div>
              </div>
              <div class="kpi-stat-card ks-red" onclick="(document.getElementById('nav-sinAsig')||{click:()=>{}}).click()">
                <div class="kpi-stat-icon"><i class="bi bi-exclamation-octagon-fill"></i></div>
                <div class="kpi-stat-body">
