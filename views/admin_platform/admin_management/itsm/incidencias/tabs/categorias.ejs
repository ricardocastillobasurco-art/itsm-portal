                <div style="font-size:11px;margin-top:2px;opacity:.7">PNG, JPG, PDF hasta 10MB</div>
            </div>
            <div class="upload-preview" id="uploadPreview" style="display:none;">
                <i class="bi bi-check-circle-fill"></i>
                <span id="uploadFileName"></span>
                <button type="button" onclick="clearFile()" style="background:none;border:none;cursor:pointer;color:#dc2626;font-size:12px;">✕ quitar</button>
            </div>
        </div>
        <!-- Result -->
        <div id="createResult" style="display:none;margin-top:16px;padding:14px;border-radius:8px;background:#eff6ff;border:1.5px solid #bfdbfe;">
            <div style="font-size:12px;color:#1e40af;font-weight:600;margin-bottom:4px;">✅ Ticket creado exitosamente</div>
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
