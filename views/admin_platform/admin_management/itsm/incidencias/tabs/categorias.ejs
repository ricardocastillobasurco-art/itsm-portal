                <button class="btn-outline-sm" onclick="copyTicketKey()"><i class="bi bi-clipboard"></i> Copiar número</button>
            </div>
        </div>
      </div>
      <div class="modal-footer" style="border-top:1px solid var(--border-soft);padding:12px 20px;display:flex;justify-content:space-between;align-items:center;">
        <button type="button" class="btn-outline-sm" onclick="openCategoryManager()" style="border-color:#7c6ff7;color:#7c6ff7;"><i class="bi bi-gear"></i> Categorías</button>
        <div style="display:flex;gap:8px;">
            <button type="button" class="btn-outline-sm" data-bs-dismiss="modal">Cancelar</button>
            <button type="button" class="btn-create" id="btnSubmit" onclick="submitTicket()"><i class="bi bi-send-fill"></i> Crear Incidencia</button>
        </div>
      </div>
    </div>
  </div>
