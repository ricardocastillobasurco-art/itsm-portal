<style>
/* ── Mobile: responsive form ────────────────────────────────────────────── */
@media(max-width:600px){
  #tabCreate .card-panel{padding:20px 14px !important;}
  #cfEmployeeInfo > div{grid-template-columns:1fr !important;}
  #cfPhoneAttachRow{grid-template-columns:1fr !important;}
  #tabCreate .btn-create{font-size:13px !important;padding:12px !important;}
}

/* ── Dark mode: fix hardcoded light colors ──────────────────────────────── */
[data-theme="dark"] #cfResult{
  background:rgba(99,102,241,.08) !important;
  border-color:rgba(99,102,241,.28) !important;
}
[data-theme="dark"] #cfResult > div:first-child{color:#818cf8 !important;}

[data-theme="dark"] #cfCmdbAlertTitle{color:#fcd34d !important;}
[data-theme="dark"] #cfCmdbAlertBody{color:#fde68a !important;}
[data-theme="dark"] #cfCmdbAlert a{color:#fbbf24 !important;}

[data-theme="dark"] #modalTicketKey{color:#60a5fa !important;}
</style>

  <div id="tabCreate" class="corp-tabpanel">
    <div style="max-width:640px;margin:0 auto;">
      <div class="card-panel" style="padding:28px 36px;">
        <!-- Encabezado -->
        <div style="text-align:center;margin-bottom:24px;padding-bottom:22px;border-bottom:1.5px solid var(--border-soft);">
          <div style="width:64px;height:64px;background:linear-gradient(135deg,#0052cc,#2684ff);border-radius:18px;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;box-shadow:0 4px 14px rgba(0,82,204,.3);">
            <i class="bi bi-exclamation-triangle-fill" style="font-size:28px;color:#fff;"></i>
          </div>
          <div style="font-size:20px;font-weight:700;color:var(--text-main);letter-spacing:-.3px;">Registrar Incidencia</div>
          <div style="font-size:12px;color:var(--text-muted);margin-top:6px;display:inline-flex;align-items:center;gap:6px;">
            <span style="width:4px;height:4px;border-radius:50%;background:var(--jira-blue);opacity:.6;display:inline-block;"></span>
            Service Desk · Portal IT
            <span style="width:4px;height:4px;border-radius:50%;background:var(--jira-blue);opacity:.6;display:inline-block;"></span>
          </div>
        </div>
        <div style="display:flex;flex-direction:column;gap:16px;">
          <!-- Reporter -->
          <div>
            <div class="form-label-custom">Tu correo corporativo *</div>
            <div class="autocomplete-wrap">
                <input type="email" id="cf_reporter" class="form-control-custom"
                       placeholder="usuario@integratel.com.pe" autocomplete="off"
                       oninput="acCfReporter(this.value)" onkeydown="acKeydown(event,'acCfReporterDrop')"
                       onblur="loadEmployeeInfo(this.value.trim())">
                <div id="acCfReporterDrop" class="ac-dropdown"></div>
            </div>
          </div>
          <!-- Info equipo (se llena al elegir reporter) -->
          <div id="cfEmployeeInfo" style="display:none;background:var(--step2-bg);border:1.5px solid var(--step2-border);border-radius:12px;padding:12px 16px;box-shadow:0 1px 4px rgba(0,0,0,.04);">
            <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--step2-color);margin-bottom:8px;display:flex;align-items:center;gap:5px;"><i class="bi bi-pc-display-horizontal"></i> Información del equipo asociado</div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px 16px;">
              <div><div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:1px;">Equipo / Tag</div><div id="cfEqEquipo" style="font-size:12px;font-weight:600;color:var(--text-main);">—</div></div>
              <div><div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:1px;">Modelo</div><div id="cfEqModelo" style="font-size:12px;font-weight:600;color:var(--text-main);">—</div></div>
              <div><div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:1px;">Departamento</div><div id="cfEqDepartamento" style="font-size:12px;font-weight:600;color:var(--text-main);">—</div></div>
              <div><div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:1px;">Ubicación</div><div id="cfEqUbicacion" style="font-size:12px;font-weight:600;color:var(--text-main);">—</div></div>
            </div>
          </div>
          <!-- Categoría / Problema -->
          <div>
            <div class="form-label-custom">¿Cuál es tu problema? *</div>
            <div class="autocomplete-wrap">
                <input type="text" id="cf_summary" class="form-control-custom"
                       placeholder="Escribe para buscar el tipo de problema..." autocomplete="off"
                       oninput="acCategory(this.value);triggerKbSuggest(this.value)" onkeydown="acKeydown(event,'acCategoryDrop')">
                <div id="acCategoryDrop" class="ac-dropdown"></div>
            </div>
            <div id="catSelectedBadge" style="display:none;margin-top:8px;align-items:center;gap:8px;">
                <span id="catBadgeText" style="background:rgba(0,82,204,.1);border:1px solid rgba(0,82,204,.3);color:var(--jira-blue);padding:5px 14px;border-radius:20px;font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:6px;"></span>
                <button onclick="clearCatSelection()" style="background:none;border:none;cursor:pointer;color:var(--text-muted);font-size:11px;padding:4px 8px;border-radius:6px;border:1px solid var(--border-soft);">✕ cambiar</button>
            </div>
          </div>
          <!-- Description -->
          <div>
            <div class="form-label-custom">Descripción del problema <span style="font-weight:400;color:var(--text-muted);font-size:10px;">(auto-generada, editable)</span></div>
            <textarea id="cf_description" class="form-control-custom" rows="2"
                      placeholder="Se completará al seleccionar el tipo de problema..." style="min-height:64px;"></textarea>
          </div>
          <!-- KB Sugerida -->
          <div id="kbSuggestWrap" style="display:none;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
              <i class="bi bi-lightbulb-fill" style="color:#f59e0b;"></i>
              <span style="font-size:12px;font-weight:700;color:var(--text-main);">Artículos relacionados — ¿ya revisaste la Base de Conocimiento?</span>
            </div>
            <div id="kbSuggestList" style="display:flex;flex-direction:column;gap:6px;"></div>
          </div>
          <!-- Teléfono + Adjunto en 2 columnas -->
          <div id="cfPhoneAttachRow" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:start;">
            <div>
              <div class="form-label-custom">Teléfono de contacto</div>
              <input type="text" id="cf_phone" class="form-control-custom" value="-" placeholder="-">
              <div style="font-size:10px;color:var(--text-muted);margin-top:3px;">Déjalo en "-" si no aplica</div>
            </div>
            <div>
              <div class="form-label-custom">Adjunto <span style="font-weight:400;color:var(--text-muted);font-size:10px;">(opcional)</span></div>
              <div class="upload-zone" id="cfUploadZone" style="padding:10px 12px;font-size:12px;">
                  <input type="file" id="cf_attachment" accept="image/*,.pdf" onchange="cfHandleFile(this)">
                  <i class="bi bi-cloud-upload" style="font-size:16px;display:block;margin-bottom:2px;"></i>
                  Adjuntar archivo
                  <div style="font-size:10px;margin-top:1px;opacity:.7">PNG, JPG, PDF · máx 10MB</div>
              </div>
              <div id="cfUploadPreview" style="display:none;" class="upload-preview">
                  <i class="bi bi-check-circle-fill"></i>
                  <span id="cfUploadFileName" style="font-size:11px;"></span>
                  <button type="button" onclick="cfClearFile()" style="background:none;border:none;cursor:pointer;color:#dc2626;font-size:11px;">✕</button>
              </div>
            </div>
          </div>
          <!-- Hidden Jira fields -->
          <input type="hidden" id="cf_component">
          <input type="hidden" id="cf_app">
          <input type="hidden" id="cf_tipologia">
          <input type="hidden" id="cf_impact">
          <input type="hidden" id="cf_urgency">
          <input type="hidden" id="cf_device_code">
          <!-- CMDB Alert: aparece si el equipo tiene alta recurrencia -->
          <div id="cfCmdbAlert" style="display:none;border-radius:10px;padding:12px 16px;border-left:4px solid #f59e0b;background:rgba(245,158,11,.08);">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
              <i class="bi bi-exclamation-triangle-fill" style="color:#d97706;font-size:15px;flex-shrink:0;"></i>
              <span id="cfCmdbAlertTitle" style="font-size:12px;font-weight:700;color:#92400e;"></span>
            </div>
            <div id="cfCmdbAlertBody" style="font-size:11px;color:#78350f;line-height:1.5;"></div>
            <div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap;">
              <a id="cfCmdbAlertLink" href="#" onclick="return false;" style="font-size:11px;font-weight:600;color:#d97706;text-decoration:underline;">Ver incidencias del equipo →</a>
            </div>
          </div>
          <!-- Result -->
          <div id="cfResult" style="display:none;padding:12px 14px;border-radius:10px;background:#eff6ff;border:1.5px solid #bfdbfe;">
              <div style="font-size:12px;color:#1e40af;font-weight:600;margin-bottom:6px;">✅ Incidencia registrada exitosamente</div>
              <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                  <span class="ticket-key" id="cfCreatedKey" style="font-size:15px;"></span>
                  <a id="cfCreatedUrl" href="#" target="_blank" class="btn-outline-sm"><i class="bi bi-box-arrow-up-right"></i> Ver en Jira</a>
                  <button type="button" class="btn-outline-sm" onclick="openManage(document.getElementById('cfCreatedKey').textContent)" style="border-color:#059669;color:#059669;display:none;" id="cfBtnManage"><i class="bi bi-sliders"></i> Gestionar</button>
                  <button class="btn-outline-sm" onclick="resetCfForm()"><i class="bi bi-plus"></i> Nueva incidencia</button>
              </div>
          </div>
          <!-- Submit -->
          <button type="button" class="btn-create" id="cfBtnSubmit" onclick="submitTicketSimple()"
                  style="width:100%;justify-content:center;padding:14px;font-size:14px;border-radius:12px;letter-spacing:.2px;box-shadow:0 2px 8px rgba(0,82,204,.25);">
              <i class="bi bi-send-fill"></i> Registrar Incidencia
          </button>
        </div>
      </div>
    </div>
  </div>

<!-- ══ MODAL: INCIDENCIA CREADA (siempre disponible, sin importar el rol) ══ -->
<div class="modal fade" id="modalTicketOk" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
    <div class="modal-content" style="border-radius:14px;border:none;overflow:hidden;">
      <div style="background:linear-gradient(135deg,#0052CC,#2684FF);padding:28px 24px 20px;text-align:center;">
        <div style="width:56px;height:56px;background:rgba(255,255,255,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
          <i class="bi bi-check-lg" style="font-size:28px;color:#fff;"></i>
        </div>
        <div style="font-size:18px;font-weight:700;color:#fff;margin-bottom:4px;">¡Incidencia registrada!</div>
        <div id="modalOkSubtitle" style="font-size:12px;color:rgba(255,255,255,.75);">Tu solicitud fue enviada a Jira Service Management</div>
      </div>
      <div style="padding:20px 24px;text-align:center;">
        <div style="font-size:11px;color:var(--text-muted);margin-bottom:8px;text-transform:uppercase;letter-spacing:.05em;">Número de ticket</div>
        <div id="modalTicketKey" style="font-size:26px;font-weight:800;color:#0052CC;font-family:'JetBrains Mono',monospace;margin-bottom:16px;letter-spacing:1px;"></div>
        <a id="modalTicketUrl" href="#" target="_blank" class="btn-outline-sm" style="display:inline-flex;gap:6px;margin-bottom:20px;border-color:#0052CC;color:#0052CC;">
          <i class="bi bi-box-arrow-up-right"></i> Ver en Jira
        </a>
        <div style="font-size:11px;color:var(--text-muted);background:var(--bg-header,#f4f5f7);border-radius:8px;padding:10px 14px;margin-bottom:16px;">
          Guarda este número para hacer seguimiento de tu solicitud.
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;">
          <% if (_isAdmin || _isEspecialista) { %>
          <button type="button" class="btn-create" style="width:100%;justify-content:center;" onclick="crtSelfAssign()">
            <i class="bi bi-person-check-fill"></i> Asignarme
          </button>
          <div style="text-align:center;margin-top:-2px;">
            <a href="#" style="font-size:10px;color:#888;" onclick="forceConfigJiraEmail();return false;"><i class="bi bi-gear" style="font-size:9px;"></i> Configurar correo Jira</a>
          </div>
          <button type="button" class="btn-create" style="width:100%;justify-content:center;background:linear-gradient(135deg,#059669,#10b981);box-shadow:0 2px 8px rgba(5,150,105,.3);" onclick="crtShowAssignPicker()">
            <i class="bi bi-people-fill"></i> Asignar a...
          </button>
          <% } %>
          <button type="button" style="width:100%;background:none;border:1.5px solid var(--border-soft,#e2e5ea);border-radius:8px;padding:8px;font-size:12px;color:var(--text-muted,#666);cursor:pointer;margin-top:4px;" onclick="bootstrap.Modal.getInstance(document.getElementById('modalTicketOk')).hide()">
            <i class="bi bi-x"></i> Cerrar
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (_isAdmin || _isEspecialista) { %>
<!-- ══ SECCIÓN: Generar incidencias desde archivo ══ -->
<div id="bkSection" style="max-width:640px;margin:20px auto 0;display:none;">
  <div class="card-panel" style="padding:0;overflow:hidden;">
    <!-- Header colapsable -->
    <button type="button" id="bkToggleBtn" onclick="bkToggle()" style="width:100%;display:flex;align-items:center;gap:12px;padding:18px 24px;background:none;border:none;cursor:pointer;text-align:left;border-bottom:1.5px solid var(--border-soft);" aria-expanded="false">
      <div style="width:38px;height:38px;background:linear-gradient(135deg,#059669,#10b981);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <i class="bi bi-file-earmark-spreadsheet-fill" style="color:#fff;font-size:17px;"></i>
      </div>
      <div style="flex:1;">
        <div style="font-size:14px;font-weight:700;color:var(--text-main);">Generar incidencias desde archivo</div>
        <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">Importa un CSV, TSV o Excel · Reporter, asignado y asunto se leen automáticamente</div>
      </div>
      <i class="bi bi-chevron-down" id="bkChevron" style="color:var(--text-muted);transition:transform .2s;"></i>
    </button>

    <!-- Cuerpo colapsado -->
    <div id="bkBody" style="display:none;padding:22px 24px;flex-direction:column;gap:16px;">

      <!-- Paso 1: Categoría -->
      <div>
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;display:flex;align-items:center;gap:5px;"><i class="bi bi-tag-fill"></i> 1. Selecciona la categoría (aplica a todos los tickets)</div>
        <div class="autocomplete-wrap">
          <input type="text" id="bkCatInput" class="form-control-custom" placeholder="Buscar categoría..." autocomplete="off"
                 oninput="acBkCat(this.value)" onkeydown="acKeydown(event,'bkCatDrop')">
          <div id="bkCatDrop" class="ac-dropdown"></div>
        </div>
        <div id="bkCatBadge" style="display:none;margin-top:8px;align-items:center;gap:8px;">
          <span id="bkCatBadgeText" style="background:rgba(5,150,105,.12);border:1px solid rgba(5,150,105,.3);color:#059669;padding:5px 14px;border-radius:20px;font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:6px;"></span>
          <button onclick="bkClearCat()" style="background:none;border:1px solid var(--border-soft);color:var(--text-muted);cursor:pointer;font-size:11px;padding:4px 8px;border-radius:6px;">✕ cambiar</button>
        </div>
      </div>

      <!-- Paso 2: Subir archivo -->
      <div>
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;display:flex;align-items:center;gap:5px;"><i class="bi bi-upload"></i> 2. Sube el archivo de reservas</div>
        <div id="bkUploadZone" class="upload-zone" style="cursor:pointer;padding:18px 16px;"
             onclick="document.getElementById('bkFileInput').click()"
             ondragover="event.preventDefault();this.classList.add('drag-over')"
             ondragleave="this.classList.remove('drag-over')"
             ondrop="event.preventDefault();this.classList.remove('drag-over');bkLoadFile(event.dataTransfer.files[0]);event.stopPropagation()">
          <input type="file" id="bkFileInput" accept=".tsv,.csv,.xlsx,.xls" style="display:none" onchange="bkLoadFile(this.files[0])" onclick="event.stopPropagation()">
          <i class="bi bi-file-earmark-arrow-up" style="font-size:22px;display:block;margin-bottom:6px;color:var(--text-muted);pointer-events:none;"></i>
          <div style="font-size:13px;font-weight:600;color:var(--text-main);pointer-events:none;">Arrastra aquí o <span style="color:#059669;">selecciona un archivo</span></div>
          <div style="font-size:11px;color:var(--text-muted);margin-top:3px;pointer-events:none;">.TSV · .CSV · .XLSX — columnas: Correo cliente, Correo personal, Servicio</div>
        </div>
        <div id="bkFileChip" style="display:none;margin-top:8px;display:none;align-items:center;gap:8px;font-size:12px;color:var(--text-main);">
          <i class="bi bi-file-earmark-check-fill" style="color:#059669;"></i>
          <span id="bkFileName"></span>
          <button onclick="bkResetFile()" style="background:none;border:none;cursor:pointer;color:#dc2626;font-size:11px;">✕</button>
        </div>
      </div>

      <!-- Vista previa -->
      <div id="bkPreview" style="display:none;">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;display:flex;align-items:center;gap:5px;"><i class="bi bi-table"></i> 3. Vista previa — <span id="bkPreviewCount">0</span> filas detectadas</div>
        <div style="overflow-x:auto;border:1px solid var(--border-soft);border-radius:8px;max-height:260px;overflow-y:auto;">
          <table style="width:100%;border-collapse:collapse;font-size:12px;" id="bkPreviewTable">
            <thead>
              <tr style="background:var(--bg-header);position:sticky;top:0;">
                <th style="padding:8px 10px;font-weight:600;text-align:left;color:var(--text-muted);white-space:nowrap;">#</th>
                <th style="padding:8px 10px;font-weight:600;text-align:left;color:var(--text-muted);white-space:nowrap;">Reporter (cliente)</th>
                <th style="padding:8px 10px;font-weight:600;text-align:left;color:var(--text-muted);white-space:nowrap;">Asignar a (personal)</th>
                <th style="padding:8px 10px;font-weight:600;text-align:left;color:var(--text-muted);">Asunto</th>
              </tr>
            </thead>
            <tbody id="bkPreviewBody"></tbody>
          </table>
        </div>
        <div style="margin-top:14px;display:flex;justify-content:flex-end;gap:8px;align-items:center;">
          <span id="bkPreviewInfo" style="font-size:12px;color:var(--text-muted);"></span>
          <button type="button" id="bkCreateBtn" class="btn-create" onclick="bkCreate()" style="display:inline-flex;align-items:center;gap:6px;font-size:13px;padding:9px 20px;">
            <i class="bi bi-lightning-fill"></i> Crear <span id="bkCreateCount">0</span> tickets en Jira
          </button>
        </div>
      </div>

      <!-- Resultados -->
      <div id="bkResults" style="display:none;"></div>
    </div>
  </div>
</div>

<% } %>
<!-- ══ PICKER: Asignar a técnico (desde modal crear) ══ -->
<div id="crtAssignOverlay" style="display:none;position:fixed;inset:0;z-index:1300;background:rgba(0,0,0,.35);" onclick="crtCloseAssignPicker()"></div>
<div id="crtAssignPicker" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:1301;background:var(--bg-card,#fff);border-radius:14px;box-shadow:0 8px 32px rgba(0,0,0,.18);width:320px;max-width:94vw;padding:0;overflow:hidden;">
  <div style="background:linear-gradient(135deg,#059669,#10b981);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;">
    <div>
      <div style="font-size:12px;font-weight:700;color:#fff;">Asignar ticket</div>
      <div id="crtAssignKey" style="font-size:10px;color:rgba(255,255,255,.75);font-family:monospace;"></div>
    </div>
    <button onclick="crtCloseAssignPicker()" style="background:rgba(255,255,255,.15);border:none;border-radius:8px;padding:4px 8px;color:#fff;cursor:pointer;font-size:16px;line-height:1;">&times;</button>
  </div>
  <div style="padding:10px 12px;">
    <input id="crtAssignSearch" type="text" placeholder="Buscar técnico..." oninput="crtFilterAgents()"
      style="width:100%;box-sizing:border-box;border:1.5px solid var(--border-soft,#e2e5ea);border-radius:8px;padding:7px 10px;font-size:12px;color:var(--text-main);background:var(--bg-main,#f8f9fa);outline:none;">
  </div>
  <div id="crtAssignList" style="max-height:240px;overflow-y:auto;padding:0 8px 10px;"></div>
</div>

  <!-- ══ TAB 2: Gestión de Tickets ══ -->