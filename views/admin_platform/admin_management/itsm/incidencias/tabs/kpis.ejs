<div id="tabKpis" class="corp-tabpanel" style="display:none;">
  <div class="page-header" style="margin-top:4px;">
    <div class="page-title"><i class="bi bi-bar-chart-line-fill" style="color:#0052CC"></i> Indicadores de Gestión <span class="jira-badge">ITSM</span></div>
    <button class="btn-outline-sm" onclick="loadStats()"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
  </div>
  <!-- Alertas en tiempo real -->
  <div id="alertasBanner" style="display:none;gap:10px;margin-bottom:16px;flex-wrap:wrap;"></div>
  <!-- KPIs SLA + MTTR -->
  <div class="cards-6" style="margin-bottom:20px;">
    <div class="kpi-card"><div><div class="kpi-title">Dentro del SLA</div><div class="kpi-value success" id="kpiDentroSla">—</div></div><div class="kpi-icon"><i class="bi bi-check-circle-fill success"></i></div></div>
    <div class="kpi-card"><div><div class="kpi-title">Fuera del SLA</div><div class="kpi-value danger" id="kpiFueraSla">—</div></div><div class="kpi-icon"><i class="bi bi-x-circle-fill danger"></i></div></div>
    <div class="kpi-card"><div><div class="kpi-title">SLA Vencido</div><div class="kpi-value danger" id="kpiVencidosAbiertos">—</div></div><div class="kpi-icon"><i class="bi bi-exclamation-triangle-fill danger"></i></div></div>
    <div class="kpi-card"><div><div class="kpi-title">Sin asignar &gt;30min</div><div class="kpi-value warning" id="kpiSinAsignar30">—</div></div><div class="kpi-icon"><i class="bi bi-person-dash warning"></i></div></div>
    <div class="kpi-card"><div><div class="kpi-title">% Cumpl. SLA</div><div class="kpi-value primary" id="kpiPctSla">—</div></div><div class="kpi-icon"><i class="bi bi-pie-chart-fill primary"></i></div></div>
    <div class="kpi-card"><div><div class="kpi-title">MTTR</div><div class="kpi-value info" id="kpiMttr">—</div></div><div class="kpi-icon"><i class="bi bi-stopwatch info"></i></div></div>
  </div>
  <!-- 3 gráficos en fila -->
  <div style="display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:16px;margin-bottom:20px;">
    <!-- Evolución -->
    <div class="card-panel">
      <div class="card-panel-title" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <span style="font-size:11px;"><i class="bi bi-graph-up" style="color:#0052CC"></i> Evolución 30 días</span>
        <div style="display:flex;gap:4px;">
          <button class="btn-outline-sm" id="chartPeriodDay"   onclick="setChartPeriod('day',this)"   style="padding:3px 8px;font-size:10px;">Día</button>
          <button class="btn-outline-sm" id="chartPeriodWeek"  onclick="setChartPeriod('week',this)"  style="padding:3px 8px;font-size:10px;border-color:var(--jira-blue);color:var(--jira-blue);">Semana</button>
          <button class="btn-outline-sm" id="chartPeriodMonth" onclick="setChartPeriod('month',this)" style="padding:3px 8px;font-size:10px;">Mes</button>
        </div>
      </div>
      <canvas id="chartEvolucion" style="max-height:160px;"></canvas>
    </div>
    <!-- Donut prioridades -->
    <div class="card-panel" style="display:flex;flex-direction:column;">
      <div class="card-panel-title" style="font-size:11px;margin-bottom:10px;"><i class="bi bi-pie-chart-fill" style="color:#ef4444"></i> Por Prioridad</div>
      <div style="flex:1;display:flex;align-items:center;justify-content:center;">
        <canvas id="chartPrioridad" style="max-height:150px;max-width:200px;"></canvas>
      </div>
    </div>
    <!-- Barras estado -->
    <div class="card-panel" style="display:flex;flex-direction:column;">
      <div class="card-panel-title" style="font-size:11px;margin-bottom:10px;"><i class="bi bi-bar-chart-horizontal-fill" style="color:#10b981"></i> Por Estado</div>
      <div style="flex:1;display:flex;align-items:center;">
        <canvas id="chartEstado" style="max-height:150px;width:100%;"></canvas>
      </div>
    </div>
  </div>
  <!-- Por técnico + Resoluciones -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">
    <div class="card-panel">
      <div class="card-panel-title"><i class="bi bi-person-badge" style="color:#0052CC"></i> Tickets por Especialista</div>
      <div id="kpiByTechWrap"><div class="spinner-wrap"><div class="spinner-border spinner-border-sm text-primary"></div></div></div>
    </div>
    <div class="card-panel">
      <div class="card-panel-title"><i class="bi bi-calendar3" style="color:#7c6ff7"></i> Resoluciones Semana / Mes</div>
      <div id="kpiWeeklyWrap"><div class="spinner-wrap"><div class="spinner-border spinner-border-sm text-primary"></div></div></div>
    </div>
  </div>
  <!-- Rankings -->
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-bottom:20px;">
    <div class="card-panel">
      <div class="card-panel-title"><i class="bi bi-person-exclamation" style="color:#ef4444"></i> Top Usuarios</div>
      <div id="kpiTopReportersWrap" style="max-height:174px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:var(--border-soft) transparent;"><div class="spinner-wrap"><div class="spinner-border spinner-border-sm text-primary"></div></div></div>
    </div>
    <div class="card-panel">
      <div class="card-panel-title"><i class="bi bi-pc-display-horizontal" style="color:#f59e0b"></i> Top Componentes</div>
      <div id="kpiTopEquiposWrap" style="max-height:174px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:var(--border-soft) transparent;"><div class="spinner-wrap"><div class="spinner-border spinner-border-sm text-primary"></div></div></div>
    </div>
    <div class="card-panel">
      <div class="card-panel-title"><i class="bi bi-tags-fill" style="color:#7c3aed"></i> Top Categorías</div>
      <div id="kpiTopCatWrap" style="max-height:174px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:var(--border-soft) transparent;"><div class="spinner-wrap"><div class="spinner-border spinner-border-sm text-primary"></div></div></div>
    </div>
  </div>
  <!-- Reportes avanzados -->
  <div class="card-panel">
    <div class="card-panel-title"><i class="bi bi-file-earmark-spreadsheet" style="color:#10b981"></i> Reportes Avanzados</div>
    <div style="display:grid;grid-template-columns:repeat(5,1fr) auto auto;gap:10px;align-items:end;flex-wrap:wrap;">
      <div><div class="form-label-custom">Estado</div>
        <select id="rptEstado" class="form-select-custom" style="font-size:12px;">
          <option value="">Todos</option>
          <option value="abierto">Abierto</option><option value="asignado">Asignado</option>
          <option value="en_progreso">En progreso</option><option value="resuelto">Resuelto</option>
          <option value="cerrado">Cerrado</option>
        </select></div>
      <div><div class="form-label-custom">Prioridad</div>
        <select id="rptPrioridad" class="form-select-custom" style="font-size:12px;">
          <option value="">Todas</option>
          <option value="P1">P1 Crítico</option><option value="P2">P2 Alto</option>
          <option value="P3">P3 Medio</option><option value="P4">P4 Bajo</option>
        </select></div>
      <div><div class="form-label-custom">Desde</div>
        <input type="date" id="rptDesde" class="form-control-custom" style="font-size:12px;"></div>
      <div><div class="form-label-custom">Hasta</div>
        <input type="date" id="rptHasta" class="form-control-custom" style="font-size:12px;"></div>
      <div><div class="form-label-custom">Buscar</div>
        <input type="text" id="rptQ" class="form-control-custom" placeholder="ID, correo, texto..." style="font-size:12px;"></div>
      <div style="display:flex;flex-direction:column;gap:6px;">
        <div class="form-label-custom">&nbsp;</div>
        <button class="btn-create" style="padding:9px 14px;font-size:12px;background:#0052CC;" onclick="exportReport('preview')"><i class="bi bi-search"></i> Buscar</button>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;">
        <div class="form-label-custom">&nbsp;</div>
        <button class="btn-create" style="padding:9px 14px;font-size:12px;" onclick="exportReport('excel')"><i class="bi bi-file-earmark-excel"></i> Excel</button>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;">
        <div class="form-label-custom">&nbsp;</div>
        <button class="btn-outline-sm" style="padding:9px 14px;" onclick="openSendReport()"><i class="bi bi-envelope"></i> Enviar</button>
      </div>
    </div>
    <div id="rptResultWrap" style="margin-top:16px;display:none;">
      <div id="rptTable"></div>
    </div>
  </div>
</div>
<!-- ══ TAB 6: AUTOMATIZACIONES ══ -->