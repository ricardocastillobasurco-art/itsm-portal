<!DOCTYPE html>
<html lang="es">
<head>
  <script>(function(){document.documentElement.setAttribute('data-theme',localStorage.getItem('dashboardTheme')||'light');})();</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Incidencias · ITSM</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="../../css/core/style.css">
  <link rel="stylesheet" href="../../css/modules/helpdesk.css">
  <link rel="stylesheet" href="../../css/core/shared.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    html,body{background:var(--bg-main);margin:0;padding:0;}
    .itsm-topbar{display:flex;align-items:center;gap:12px;padding:12px 24px;background:var(--bg-card);border-bottom:1px solid var(--border-soft);position:sticky;top:0;z-index:100;}
    .itsm-back{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--text-muted);background:var(--bg-main);border:1px solid var(--border-soft);border-radius:20px;padding:5px 12px;text-decoration:none;transition:color .2s;}
    .itsm-back:hover{color:var(--primary);}
    .itsm-breadcrumb{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted);}
    .itsm-breadcrumb a{color:var(--text-muted);text-decoration:none;font-weight:500;transition:color .2s;}
    .itsm-breadcrumb a:hover{color:var(--primary);}
    .itsm-breadcrumb .sep{opacity:.4;}
    .itsm-breadcrumb .current{color:var(--text-main);font-weight:700;}
    .dashboard-content{padding:0;}
    #tabGestion{display:none;}

    /* ── UNASSIGNED TICKET ALERT ─────────────────────────── */
    .ua-overlay{position:fixed;top:0;right:0;bottom:0;left:0;z-index:9990;pointer-events:none;display:flex;align-items:flex-start;justify-content:flex-end;padding:70px 20px 20px;}
    .ua-card{pointer-events:all;width:420px;max-width:calc(100vw - 40px);background:var(--bg-card,#fff);border:1.5px solid rgba(220,38,38,.35);border-radius:18px;box-shadow:0 8px 40px rgba(220,38,38,.18),0 24px 64px rgba(0,0,0,.18);overflow:hidden;animation:uaIn .38s cubic-bezier(.34,1.56,.64,1);}
    @keyframes uaIn{from{opacity:0;transform:scale(.82) translateY(-16px);}to{opacity:1;transform:scale(1) translateY(0);}}
    .ua-header{background:linear-gradient(135deg,#b91c1c,#ef4444);padding:13px 16px;display:flex;align-items:center;gap:10px;}
    .ua-pulse-dot{width:9px;height:9px;border-radius:50%;background:#fff;animation:uaDot 1.3s ease-in-out infinite;flex-shrink:0;}
    @keyframes uaDot{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.4;transform:scale(.65);}}
    .ua-header-title{font-size:12px;font-weight:800;color:#fff;letter-spacing:.2px;}
    .ua-queue-pill{margin-left:auto;background:rgba(255,255,255,.22);color:#fff;font-size:10px;font-weight:800;padding:3px 9px;border-radius:12px;display:none;}
    .ua-body{padding:16px 18px 18px;}
    .ua-ticket-id{display:inline-flex;align-items:center;gap:8px;margin-bottom:11px;}
    .ua-id-tag{font-family:monospace;font-size:13px;font-weight:800;background:rgba(220,38,38,.1);color:#dc2626;border:1.5px solid rgba(220,38,38,.22);border-radius:8px;padding:4px 10px;}
    .ua-prio-tag{font-size:10px;font-weight:800;padding:3px 9px;border-radius:8px;letter-spacing:.2px;}
    .ua-summary{font-size:13.5px;font-weight:700;color:var(--text-main,#0f172a);line-height:1.45;margin-bottom:10px;}
    .ua-meta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:15px;}
    .ua-meta span{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text-muted,#64748b);}
    .ua-actions{display:flex;gap:8px;}
    .ua-btn-me{flex:1;padding:10px 14px;border-radius:10px;border:none;cursor:pointer;font-size:13px;font-weight:700;font-family:inherit;background:linear-gradient(135deg,#b91c1c,#ef4444);color:#fff;display:flex;align-items:center;justify-content:center;gap:7px;transition:opacity .18s,transform .1s;}
    .ua-btn-me:hover{opacity:.88;}.ua-btn-me:active{transform:scale(.97);}
    .ua-btn-assign{padding:10px 13px;border-radius:10px;border:1.5px solid var(--border-soft,#e2e8f0);cursor:pointer;font-size:13px;font-weight:700;font-family:inherit;background:var(--bg-main,#f1f5f9);color:var(--text-main,#0f172a);display:flex;align-items:center;gap:6px;transition:border-color .18s;}
    .ua-btn-assign:hover{border-color:#3b82f6;color:#3b82f6;}
    .ua-picker{margin-top:12px;display:none;}
    .ua-picker input{width:100%;border:1.5px solid var(--border-soft,#e2e8f0);border-radius:9px;padding:8px 12px;font-size:12px;background:var(--bg-main,#f1f5f9);color:var(--text-main,#0f172a);outline:none;font-family:inherit;box-sizing:border-box;}
    .ua-picker input:focus{border-color:#3b82f6;}
    .ua-picker-drop{border:1.5px solid var(--border-soft,#e2e8f0);border-radius:9px;margin-top:4px;max-height:150px;overflow-y:auto;background:var(--bg-card,#fff);display:none;}
    .ua-picker-item{padding:9px 12px;cursor:pointer;border-bottom:1px solid var(--border-soft,#e2e8f0);font-size:12px;color:var(--text-main,#0f172a);transition:background .12s;}
    .ua-picker-item:last-child{border-bottom:none;}.ua-picker-item:hover{background:var(--bg-main,#f1f5f9);}
    .ua-picker-item strong{display:block;font-weight:700;}.ua-picker-item small{color:var(--text-muted,#64748b);}
    /* success */
    .ua-success{display:none;flex-direction:column;align-items:center;justify-content:center;padding:28px 18px;text-align:center;}
    .ua-success-icon{font-size:44px;color:#059669;animation:uaCheck .4s cubic-bezier(.34,1.56,.64,1);margin-bottom:10px;}
    @keyframes uaCheck{from{transform:scale(0);opacity:0;}to{transform:scale(1);opacity:1;}}
    .ua-success-title{font-size:15px;font-weight:800;color:var(--text-main,#0f172a);margin-bottom:4px;}
    .ua-success-sub{font-size:12px;color:var(--text-muted,#64748b);}

    /* ── CONSULT LIVE PANEL ─────────────────────────────────── */
    .cci-overlay{position:fixed;bottom:20px;right:20px;z-index:9991;display:flex;flex-direction:column;align-items:flex-end;gap:10px;pointer-events:none;}
    .cci-notif{pointer-events:all;width:340px;background:var(--bg-card,#fff);border:1.5px solid rgba(8,145,178,.38);border-radius:16px;box-shadow:0 8px 32px rgba(8,145,178,.18),0 24px 56px rgba(0,0,0,.16);overflow:hidden;animation:uaIn .35s cubic-bezier(.34,1.56,.64,1);}
    .cci-notif-hdr{background:linear-gradient(135deg,#0f766e,#0891b2);padding:11px 15px;display:flex;align-items:center;gap:9px;}
    .cci-notif-dot{width:8px;height:8px;border-radius:50%;background:#fff;animation:uaDot 1.3s ease-in-out infinite;flex-shrink:0;}
    .cci-notif-title{font-size:12px;font-weight:800;color:#fff;}
    .cci-notif-time{font-size:10px;color:rgba(255,255,255,.7);margin-left:auto;}
    .cci-notif-body{padding:13px 15px 15px;}
    .cci-notif-user{font-size:13px;font-weight:700;color:var(--text-main,#0f172a);margin-bottom:3px;}
    .cci-notif-topic{font-size:11.5px;color:var(--text-muted,#64748b);margin-bottom:11px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
    .cci-notif-btns{display:flex;gap:8px;}
    .cci-btn-take{flex:1;background:linear-gradient(135deg,#0f766e,#0891b2);color:#fff;border:none;border-radius:9px;padding:9px 12px;font-size:12.5px;font-weight:800;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;}
    .cci-btn-take:hover{opacity:.88;}
    .cci-btn-skip{background:transparent;color:var(--text-muted,#64748b);border:1.5px solid var(--border-soft,#e2e8f0);border-radius:9px;padding:9px 12px;font-size:12px;font-weight:600;cursor:pointer;}
    .cci-btn-skip:hover{border-color:var(--border-strong,#cbd5e1);}
    .cci-panel{pointer-events:all;width:340px;height:480px;background:var(--bg-card,#fff);border:1.5px solid rgba(8,145,178,.3);border-radius:16px;box-shadow:0 8px 32px rgba(0,0,0,.2);display:none;flex-direction:column;overflow:hidden;animation:uaIn .32s cubic-bezier(.34,1.56,.64,1);}
    .cci-panel.active{display:flex;}
    .cci-panel-hdr{background:linear-gradient(135deg,#0f766e,#0891b2);padding:12px 15px;display:flex;align-items:center;gap:10px;flex-shrink:0;}
    .cci-panel-av{width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.2);border:2px solid rgba(255,255,255,.35);display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;flex-shrink:0;}
    .cci-panel-info h5{margin:0;font-size:12px;font-weight:800;color:#fff;}
    .cci-panel-info p{margin:0;font-size:10px;color:rgba(255,255,255,.8);display:flex;align-items:center;gap:4px;}
    .cci-online{width:6px;height:6px;background:#4ade80;border-radius:50%;display:inline-block;animation:cbPulse 2s ease-out infinite;}
    @keyframes cbPulse{0%,100%{transform:scale(1);opacity:1;}50%{transform:scale(.65);opacity:.5;}}
    .cci-panel-x{margin-left:auto;background:rgba(255,255,255,.15);border:none;color:#fff;font-size:12px;cursor:pointer;padding:5px;border-radius:50%;width:26px;height:26px;display:flex;align-items:center;justify-content:center;}
    .cci-panel-x:hover{background:rgba(255,255,255,.28);}
    .cci-msgs{flex:1;overflow-y:auto;padding:12px;background:#f4f6fb;display:flex;flex-direction:column;gap:7px;}
    .cci-msg-user{align-self:flex-start;background:var(--bg-card,#fff);border:1.5px solid var(--border-soft,#e2e8f0);border-radius:12px 12px 12px 2px;padding:7px 11px;max-width:85%;font-size:12px;line-height:1.45;color:var(--text-main,#0f172a);}
    .cci-msg-spec{align-self:flex-end;background:linear-gradient(135deg,#2563eb,#3b82f6);color:#fff;border-radius:12px 12px 2px 12px;padding:7px 11px;max-width:85%;font-size:12px;line-height:1.45;}
    .cci-msg-sys{align-self:center;font-size:10px;color:var(--text-muted,#64748b);background:var(--bg-main,#f1f5f9);border-radius:20px;padding:3px 11px;font-style:italic;}
    .cci-msg-name{font-size:9px;font-weight:700;opacity:.65;margin-bottom:2px;}
    .cci-input-row{padding:9px 11px;border-top:1.5px solid var(--border-soft,#e2e8f0);display:flex;gap:7px;flex-shrink:0;background:var(--bg-card,#fff);}
    .cci-input{flex:1;border:1.5px solid var(--border-soft,#e2e8f0);border-radius:9px;padding:7px 11px;font-size:12px;background:var(--bg-main,#f1f5f9);color:var(--text-main,#0f172a);resize:none;outline:none;font-family:inherit;}
    .cci-input:focus{border-color:#0891b2;}
    .cci-send-btn{background:linear-gradient(135deg,#0f766e,#0891b2);color:#fff;border:none;border-radius:9px;width:36px;height:36px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;align-self:flex-end;}
    .cci-panel-footer{padding:9px 11px;border-top:1.5px solid var(--border-soft,#e2e8f0);display:flex;gap:6px;flex-shrink:0;background:var(--bg-card,#fff);}
    .cci-btn-resolve{flex:1;background:#059669;color:#fff;border:none;border-radius:8px;padding:8px;font-size:11.5px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;}
    .cci-rate-btn{background:transparent;border:none;font-size:26px;cursor:pointer;padding:2px;border-radius:6px;transition:transform .15s;}.cci-rate-btn:hover{transform:scale(1.25);}
    .cci-btn-mkticket{background:#2563eb;color:#fff;border:none;border-radius:8px;padding:8px 11px;font-size:11.5px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:4px;}
    .cci-reopen-fab{position:fixed;bottom:80px;right:20px;z-index:9990;background:linear-gradient(135deg,#0f766e,#0891b2);color:#fff;border:none;border-radius:50%;width:44px;height:44px;display:none;align-items:center;justify-content:center;font-size:18px;cursor:pointer;box-shadow:0 4px 18px rgba(8,145,178,.4);animation:uaIn .3s ease;}
    .cci-reopen-fab.visible{display:flex;}
  </style>
</head>
<body>
<%- include('../../../../shared/partials/theme-toggle') %>

<!-- TOP BAR -->
<div class="itsm-topbar">
  <button id="incMenuBtn" onclick="incToggleSidebar()" title="Menú"><i class="bi bi-list" style="font-size:16px;"></i></button>
  <a href="/itsm?tab=inc" class="itsm-back"><i class="bi bi-arrow-left"></i> ITSM</a>
  <div class="itsm-breadcrumb">
    <a href="/administracion"><i class="bi bi-shield-lock-fill"></i> Admin</a>
    <span class="sep">/</span>
    <a href="/itsm?tab=inc">ITSM</a>
    <span class="sep">/</span>
    <span class="current"><i class="bi bi-<%= locals.localView ? 'hdd-network-fill' : 'ticket-detailed-fill' %>"></i> <%= locals.localView ? 'Gestión Local' : 'Gestión de Incidencias' %></span>
  </div>
</div>

<div class="dashboard-content">
  <%
    const _role = user?.role || 'usuario';
    const _isAdmin        = _role === 'administrador';
    const _isEspecialista = ['especialista','agente','tecnico'].includes(_role);
    const _isVisor        = _role === 'visor';
  %>
  <%- include('./partials/nav-tabs',  { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/create',        { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/gestion',       { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/kpis',          { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/admin',         { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/portal',        { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/preguntas',     { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/encuesta',      { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/whatsapp',      { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/kbreqs',        { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/devoluciones',  { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/garantias',     { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/categorias',    { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/especialistas', { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./tabs/automaciones',  { _isAdmin, _isEspecialista, _isVisor }) %>
  <%- include('./partials/modals',    { _isAdmin, _isEspecialista, _isVisor }) %>
</div>

<div class="toast-container-custom" id="toastContainer" style="bottom:auto;top:70px;right:20px;"></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
const CURRENT_USER_ID    = <%- JSON.stringify(locals.currentUserId || null) %>;
const CURRENT_USER_ROLE  = <%- JSON.stringify(locals.user?.role || 'usuario') %>;
const CURRENT_USER_NAME  = <%- JSON.stringify(locals.user?.full_name || locals.user?.nombre || locals.user?.username || '') %>;
const CURRENT_USER_EMAIL = <%- JSON.stringify(locals.user?.email || locals.user?.username || '') %>;
const CURRENT_TENANT_ID  = <%- JSON.stringify(locals.user?.tenant_id || null) %>;
</script>
<script src="/js/incidencias/app.js?v=56"></script>
<script src="/js/incidencias/_exec_dashboard.js?v=2"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
(function _incSocket() {
    if (typeof io === 'undefined') return;
    const _sk = io({ transports: ['websocket', 'polling'] });
    _sk.on('connect', function(){ _sk.emit('joinAgents'); });

    _sk.on('ticket:created', data => {
        // Tickets creados desde chatbot ya tienen asignación manejada en el panel de consultas
        if (!data.fromChatbot && typeof window._uaNewTicket === 'function') window._uaNewTicket(data);
        // Incrementar badge "Sin asignar"
        const badge = document.getElementById('badge-sinAsig');
        if (badge && badge.textContent !== '—') {
            const n = parseInt(badge.textContent) || 0;
            badge.textContent = n + 1;
            badge.style.animation = 'none';
            requestAnimationFrame(() => { badge.style.animation = 'incPulse .4s ease'; });
        }
    });

    _sk.on('ticket:assigned', data => {
        // Cerrar modal si corresponde al ticket actual
        if (typeof window._uaOnAssigned === 'function') window._uaOnAssigned(data);
        if (typeof showToast === 'function')
            showToast(`<span style="font-family:monospace;">${data.key}</span> asignado a <b>${data.techName||''}</b>`, 'success', 4000);
    });

    _sk.on('ticket:closed', data => {
        if (typeof showToast !== 'function') return;
        showToast(`<span style="font-family:monospace;">${data.key}</span> cerrado por <b>${data.by||''}</b>`, 'success', 4000);
    });
    _sk.on('consult:new', function(data) {
        if (typeof showToast === 'function')
            showToast(`💬 Nueva consulta de <b>${data.userName||data.userEmail}</b>`, 'info', 5000);
        if (typeof window._cciAddNotif === 'function') window._cciAddNotif(data);
        // Refrescar tabla de consultas activas
        if (typeof loadConsultasActivas === 'function') loadConsultasActivas();
    });
    _sk.on('consult:taken', function(data) {
        if (typeof window._cciSkipNotif === 'function') window._cciSkipNotif(data.consultId);
        var si = document.getElementById('cciSide_' + data.consultId);
        if (si) { si.remove(); if(typeof _cciUpdateSideCount==='function') _cciUpdateSideCount(); }
    });
    _sk.on('consult:message', function(data) {
        if (window._cciActiveId && data.consultId === window._cciActiveId && data.role !== 'specialist')
            if (typeof window._cciLoadHistory === 'function') window._cciLoadHistory(false);
    });
    _sk.on('consult:resolved', function(data) {
        if (window._cciActiveId && data.consultId === window._cciActiveId)
            if (typeof window._cciEndSession === 'function') window._cciEndSession(data.ticketKey);
    });
})();
</script>
<script>
// showPanel() is defined in app.js with LOCAL_VIEW awareness — do NOT redefine here.
// Only define LOCAL_VIEW and the DOMContentLoaded initializer.

const LOCAL_VIEW = <%- JSON.stringify(!!locals.localView) %>;

document.addEventListener('DOMContentLoaded', function(){
  const _urlTabInit = new URLSearchParams(window.location.search).get('tab');
  if (!_urlTabInit || _urlTabInit === 'gestion') {
    const g = document.getElementById('tabGestion');
    if (g) g.style.display = 'block';
  }

  if (typeof startAlertPolling === 'function') startAlertPolling();

  if (LOCAL_VIEW) {
    // Redirigir Actualizar a API local
    const syncBtn = document.getElementById('btnSyncTickets');
    if (syncBtn) { syncBtn.onclick = () => { if(typeof loadTickets==='function') loadTickets(); }; syncBtn.title = 'Actualizar lista local'; }
    // Activar nav item "Tickets" del menú local como seleccionado
    const lnavGestion = document.getElementById('lnav-gestion');
    if (lnavGestion) lnavGestion.classList.add('active');
    // Mostrar panel todos con título local
    const title = document.getElementById('incTopbarTitle');
    if (title) title.textContent = 'Gestión Local';
    // Cargar tabla de tickets locales
    if (typeof loadTickets === 'function') loadTickets();
  } else if (!_urlTabInit || _urlTabInit === 'gestion') {
    ['incPanel-indicadores','incPanel-admin'].forEach(id => {
      const p = document.getElementById(id); if (p) p.style.display = 'none';
    });
    const todos = document.getElementById('incPanel-todos');
    if (todos) todos.style.display = 'none';

    const _qs = new URLSearchParams(window.location.search);
    const _qPanel  = _qs.get('panel');
    const _qBuscar = _qs.get('buscar');

    if (_qPanel === 'misAsig') {
      const btn = document.getElementById('nav-misAsig');
      if (btn) btn.click();
    } else if (_qBuscar) {
      const btn = document.getElementById('nav-buscar');
      if (btn) btn.click();
      requestAnimationFrame(function() {
        const inp = document.getElementById('incSearchInput');
        if (inp) { inp.value = _qBuscar; }
        if (typeof buscarTicket === 'function') buscarTicket();
      });
    } else {
      const sinAsigBtn = document.getElementById('nav-sinAsig');
      if (sinAsigBtn) { sinAsigBtn.click(); }
      else if (typeof loadSinAsig === 'function') loadSinAsig();
    }

    const histEl = document.getElementById('histEmail');
    if (histEl && !histEl.value) {
      const _savedMail = localStorage.getItem('jira_email') || CURRENT_USER_EMAIL || '';
      if (_savedMail) histEl.value = _savedMail;
    }

    setTimeout(function() { if (typeof loadHeatmap === 'function') loadHeatmap(); }, 3500);
    setTimeout(function() { if (typeof loadTecStats === 'function') loadTecStats(); }, 5500);
    setTimeout(function() { if (typeof loadMisPaneles === 'function') loadMisPaneles(); }, 7500);
    setTimeout(function() { if (typeof preloadReportes === 'function') preloadReportes(); }, 9500);
    // Cargar consultas activas desde BD al iniciar (puebla el sidebar persistentemente)
    setTimeout(function() { if (typeof loadConsultasActivas === 'function') loadConsultasActivas(); }, 1500);
    // Si viene de "Atender" en hub ITSM, abrir panel consultas y tomar la sesión
    var _consultId = new URLSearchParams(location.search).get('consultId');
    if (_consultId) {
        var navBtn = document.getElementById('nav-consultas');
        if (navBtn) navBtn.click();
        setTimeout(function() { if (typeof cciTake === 'function') cciTake(parseInt(_consultId)); }, 600);
    }
  }
});
</script>
<script>
function incToggleSidebar() {
  var sb = document.getElementById('incSidebar');
  var ov = document.getElementById('incSidebarOverlay');
  if (sb) sb.classList.toggle('inc-mob-open');
  if (ov) ov.classList.toggle('inc-mob-open');
}
function incCloseSidebar() {
  var sb = document.getElementById('incSidebar');
  var ov = document.getElementById('incSidebarOverlay');
  if (sb) sb.classList.remove('inc-mob-open');
  if (ov) ov.classList.remove('inc-mob-open');
}
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('#incSidebar .nav-item').forEach(function(item) {
    item.addEventListener('click', function() {
      if (window.innerWidth <= 768) incCloseSidebar();
    });
  });
});
</script>

