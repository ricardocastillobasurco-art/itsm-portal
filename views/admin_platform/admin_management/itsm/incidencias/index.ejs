<script>
/* ── UNASSIGNED ALERT SYSTEM ────────────────────────────── */
(function() {
  var _PRIO_BG    = { P1:'rgba(239,68,68,.12)', P2:'rgba(245,158,11,.12)', P3:'rgba(59,130,246,.12)', P4:'rgba(107,114,128,.1)' };
  var _PRIO_COLOR = { P1:'#dc2626', P2:'#d97706', P3:'#2563eb', P4:'#6b7280' };

  var _queue   = [];
  var _current = null;
  var _searchTimer = null;

  function _resetCard() {
    var bm  = document.getElementById('uaBtnMe');
    var ba  = document.getElementById('uaBtnAssign');
    var pk  = document.getElementById('uaPicker');
    var drop = document.getElementById('uaPickerDrop');
    var inp = document.getElementById('uaPickerInput');
    if (bm)   { bm.disabled  = false; bm.innerHTML  = '<i class="bi bi-person-fill-check"></i> Asignarme'; }
    if (ba)   { ba.disabled  = false; ba.innerHTML  = '<i class="bi bi-person-plus-fill"></i> Asignar a...'; }
    if (pk)   pk.style.display = 'none';
    if (drop) { drop.innerHTML = ''; drop.style.display = 'none'; }
    if (inp)  inp.value = '';
  }

  function _show(ticket) {
    _current = ticket.key;

    // Reset estados
    _resetCard();
    document.getElementById('uaBody').style.display    = '';
    document.getElementById('uaSuccess').style.display = 'none';

    // Animar re-entrada
    var card = document.getElementById('uaCard');
    if (card) { card.style.animation = 'none'; requestAnimationFrame(function(){ card.style.animation = 'uaIn .38s cubic-bezier(.34,1.56,.64,1)'; }); }

    // Llenar datos
    var prio  = ticket.priority || 'P3';
    var color = _PRIO_COLOR[prio] || '#6b7280';
    var bg    = _PRIO_BG[prio]   || 'rgba(107,114,128,.1)';
    var timeStr = new Date().toLocaleTimeString('es-PE', { hour:'2-digit', minute:'2-digit' });

    document.getElementById('uaKey').textContent     = ticket.key;
    var pt = document.getElementById('uaPrioTag');
    pt.textContent = prio; pt.style.background = bg; pt.style.color = color;
    document.getElementById('uaSummary').textContent  = ticket.summary || '(sin título)';
    document.getElementById('uaReporter').textContent = ticket.reporter || 'Desconocido';
    document.getElementById('uaTime').textContent     = timeStr;

    // Badge cola
    var pill = document.getElementById('uaQueuePill');
    if (_queue.length > 0) {
      pill.textContent = '+' + _queue.length + ' pendiente' + (_queue.length > 1 ? 's' : '');
      pill.style.display = '';
    } else { pill.style.display = 'none'; }

    document.getElementById('uaOverlay').style.display = 'flex';
  }

  function _showNext() {
    if (_queue.length > 0) {
      _show(_queue.shift());
    } else {
      _current = null;
      document.getElementById('uaOverlay').style.display = 'none';
    }
  }

  function _showSuccess(assignedTo) {
    document.getElementById('uaBody').style.display    = 'none';
    document.getElementById('uaSuccess').style.display = 'flex';
    document.getElementById('uaSuccessTitle').textContent = 'Ticket asignado correctamente';
    document.getElementById('uaSuccessSub').textContent   = assignedTo ? ('Asignado a ' + assignedTo) : 'Asignación completada';
    setTimeout(_showNext, 2400);
  }

  /* ── API pública ── */
  window.uaAssignSelf = async function() {
    var key   = _current;
    var email = (typeof CURRENT_USER_EMAIL !== 'undefined') ? CURRENT_USER_EMAIL : '';
    if (!key || !email) return;
    var btn = document.getElementById('uaBtnMe');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Asignando...'; }
    try {
      var r = await fetch('/api/jira/ticket/' + key + '/assign-tech', {
        method:'PUT', credentials:'include',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ email: email })
      });
      var d = await r.json();
      if (d.success !== false) {
        _showSuccess((typeof CURRENT_USER_NAME !== 'undefined' ? CURRENT_USER_NAME : null) || email);
      } else {
        if (typeof showToast === 'function') showToast(d.error || 'Error al asignar', 'error');
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-person-fill-check"></i> Asignarme'; }
      }
    } catch(e) {
      if (typeof showToast === 'function') showToast('Error de red', 'error');
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-person-fill-check"></i> Asignarme'; }
    }
  };

  window.uaTogglePicker = function() {
    var pk = document.getElementById('uaPicker');
    if (!pk) return;
    var open = pk.style.display !== 'none';
    pk.style.display = open ? 'none' : '';
    if (!open) { var inp = document.getElementById('uaPickerInput'); if (inp) inp.focus(); }
  };

  window.uaClosePicker = function() {
    var pk = document.getElementById('uaPicker');
    if (pk) pk.style.display = 'none';
  };

  window.uaSearchTech = function(q) {
    clearTimeout(_searchTimer);
    var drop = document.getElementById('uaPickerDrop');
    if (!drop) return;
    if (!q || q.length < 2) { drop.style.display = 'none'; return; }
    _searchTimer = setTimeout(async function() {
      try {
        var tid = (typeof CURRENT_TENANT_ID !== 'undefined' && CURRENT_TENANT_ID) ? CURRENT_TENANT_ID : 1;
        var url = (tid && tid != 1)
          ? '/api/portal/users/search?q=' + encodeURIComponent(q)
          : '/api/employees/search-emails?q=' + encodeURIComponent(q);
        var r   = await fetch(url, { credentials:'include' }).then(function(x){ return x.json(); });
        var list = (r.data || []).filter(function(u){ return u.email; });
        if (!list.length) {
          drop.innerHTML = '<div style="padding:10px 12px;font-size:12px;color:var(--text-muted,#64748b);">Sin resultados</div>';
          drop.style.display = '';
          return;
        }
        drop.innerHTML = list.map(function(u) {
          var name = (u.full_name || u.name || u.email).replace(/'/g, "\\'");
          return '<div class="ua-picker-item" onclick="uaAssignTo(\'' + u.email + '\',\'' + name + '\')">'
            + '<strong>' + (u.full_name || u.name || u.email) + '</strong>'
            + '<small>' + u.email + '</small></div>';
        }).join('');
        drop.style.display = '';
      } catch(e) {}
    }, 280);
  };

  window.uaAssignTo = async function(email, name) {
    var key = _current;
    if (!key || !email) return;
    uaClosePicker();
    var btn = document.getElementById('uaBtnAssign');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Asignando...'; }
    try {
      var r = await fetch('/api/jira/ticket/' + key + '/assign-tech', {
        method:'PUT', credentials:'include',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ email: email })
      });
      var d = await r.json();
      if (d.success !== false) {
        _showSuccess(name || email);
      } else {
        if (typeof showToast === 'function') showToast(d.error || 'Error al asignar', 'error');
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-person-plus-fill"></i> Asignar a...'; }
      }
    } catch(e) {
      if (typeof showToast === 'function') showToast('Error de red', 'error');
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-person-plus-fill"></i> Asignar a...'; }
    }
  };

  window._uaNewTicket = function(data) {
    if (_current) {
      _queue.push(data);
      // Actualizar badge
      var pill = document.getElementById('uaQueuePill');
      if (pill) { pill.textContent = '+' + _queue.length + ' pendiente' + (_queue.length > 1 ? 's' : ''); pill.style.display = ''; }
    } else {
      _show(data);
    }
  };

  window._uaOnAssigned = function(data) {
    if (data.key === _current) {
      _showSuccess(data.techName || 'otro agente');
    } else {
      // Quitar de la cola si estaba pendiente
      var idx = _queue.findIndex(function(t){ return t.key === data.key; });
      if (idx >= 0) {
        _queue.splice(idx, 1);
        var pill = document.getElementById('uaQueuePill');
        if (pill) {
          if (_queue.length > 0) { pill.textContent = '+' + _queue.length + ' pendiente' + (_queue.length > 1 ? 's' : ''); }
          else { pill.style.display = 'none'; }
        }
      }
    }
  };

  // Prevenir cierre con click fuera o Escape
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && _current) e.stopImmediatePropagation(); }, true);

})();
</script>

