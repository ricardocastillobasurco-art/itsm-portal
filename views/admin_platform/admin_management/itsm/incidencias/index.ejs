<script>
(function _cciAdmin() {
  window._cciActiveId = null;
  var _cLastMsgId = 0;
  var _cPollTimer = null;
  window._cciUpdateLastId = function(id) { if (id && id > _cLastMsgId) _cLastMsgId = id; };

  window._cciAddNotif = function(data) {
    var overlay = document.getElementById('cciOverlay');
    var panel   = document.getElementById('cciPanel');
    var div     = document.createElement('div');
    div.className = 'cci-notif';
    div.id        = 'cciNotif' + data.id;
    var topicEsc  = (data.topic || '').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    var nameEsc   = (data.userName || '').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    var emailEsc  = (data.userEmail || '').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    div.innerHTML = `
      <div class="cci-notif-hdr">
        <div class="cci-notif-dot"></div>
        <div class="cci-notif-title">💬 Nueva consulta en vivo</div>
        <div class="cci-notif-time">ahora</div>
      </div>
      <div class="cci-notif-body">
        <div class="cci-notif-user">👤 ${nameEsc || emailEsc}</div>
        ${emailEsc && nameEsc ? `<div style="font-size:11px;color:var(--text-muted,#64748b);margin-bottom:4px;">${emailEsc}</div>` : ''}
        <div class="cci-notif-topic">"${topicEsc}"</div>
        <div class="cci-notif-btns">
          <button class="cci-btn-take" onclick="cciTake(${data.id})">
            <i class="bi bi-headset"></i> Tomar consulta
          </button>
          <button class="cci-btn-skip" onclick="_cciSkipNotif(${data.id})">Ahora no</button>
        </div>
      </div>`;
    overlay.insertBefore(div, panel);
  };

  window._cciSkipNotif = function(id) {
    var el = document.getElementById('cciNotif' + id);
    if (el) { el.style.animation='none'; el.style.opacity='0'; el.style.transform='scale(.9)'; setTimeout(() => el.remove(), 220); }
    // Quitar del sidebar también
    var si = document.getElementById('cciSide_' + id);
    if (si) si.remove();
    _cciUpdateSideCount();
  };

  function _cciUpdateSideCount() {
    var list = document.getElementById('cciSideList');
    var empty = document.getElementById('cciSideEmpty');
    var badge = document.getElementById('cciSideCount');
    var cards = list ? list.querySelectorAll('.cci-side-card').length : 0;
    if (empty) empty.style.display = cards ? 'none' : '';
    if (badge) { badge.textContent = cards || ''; badge.style.display = cards ? '' : 'none'; }
  }

  window._cciRefreshSidebar = function(waiting) {
    var list = document.getElementById('cciSideList');
    if (!list) return;
    // Quitar cards antiguas que ya no están en waiting
    list.querySelectorAll('.cci-side-card').forEach(function(c) {
      var cid = c.dataset.id;
      if (!waiting.find(function(w) { return String(w.id) === cid; })) c.remove();
    });
    // Añadir las nuevas
    waiting.forEach(function(s) {
      if (document.getElementById('cciSide_' + s.id)) return; // ya existe
      var card = document.createElement('div');
      card.className = 'cci-side-card';
      card.id = 'cciSide_' + s.id;
      card.dataset.id = s.id;
      var userLabel = (s.user_name || s.user_email || 'Usuario').replace(/</g,'&lt;');
      var topic = (s.topic || '').slice(0,60).replace(/</g,'&lt;');
      card.style.cssText = 'background:var(--bg-card);border:1.5px solid #0891b2;border-radius:9px;padding:8px 10px;margin-bottom:6px;cursor:pointer;';
      card.innerHTML = '<div style="font-size:11px;font-weight:700;color:#0891b2;margin-bottom:2px;display:flex;align-items:center;gap:5px;"><span style="width:7px;height:7px;background:#10b981;border-radius:50%;display:inline-block;flex-shrink:0;"></span>' + userLabel + '</div>'
        + (s.user_email && s.user_name ? '<div style="font-size:10px;color:var(--text-muted);margin-bottom:3px;">' + (s.user_email||'').replace(/</g,'&lt;') + '</div>' : '')
        + '<div style="font-size:10.5px;color:var(--text-main);margin-bottom:6px;font-style:italic;">"' + topic + '"</div>'
        + '<button onclick="cciTake(' + s.id + ')" style="width:100%;background:#0891b2;color:#fff;border:none;border-radius:6px;padding:5px;font-size:11px;font-weight:700;cursor:pointer;"><i class="bi bi-headset"></i> Atender</button>';
      list.insertBefore(card, list.firstChild);
    });
    _cciUpdateSideCount();
  };

  window.cciTake = async function(id) {
    try {
      var r = await fetch(`/api/chatbot/consult/${id}/take`, {
        method:'POST', credentials:'include', headers:{'Content-Type':'application/json'}, body:'{}'
      });
      var d = await r.json();
      if (!d.success) {
        if (typeof showToast === 'function') showToast('Esta consulta ya fue tomada por otro agente', 'warning');
        window._cciSkipNotif(id); return;
      }
      window._cciSkipNotif(id);
      window._cciActiveId = id;
      _cLastMsgId = 0;
      _cCatsLoaded = false;
      document.getElementById('cciMsgs').innerHTML = '';
      document.getElementById('cciClosePanel').style.display = 'none';
      document.getElementById('cciPanel').classList.add('active');
      document.getElementById('cciReopenFab').classList.remove('visible');
      _cLoadHistory(true);
      _cPollTimer = setInterval(() => _cLoadHistory(false), 4000);
    } catch(e) {
      if (typeof showToast === 'function') showToast('Error al tomar la consulta', 'error');
    }
  };

  window._cciLoadHistory = function(initial) { _cLoadHistory(initial); };
  async function _cLoadHistory(initial) {
    if (!window._cciActiveId) return;
    try {
      var r = await fetch(`/api/chatbot/consult/${window._cciActiveId}/messages?since=${_cLastMsgId}`, {credentials:'include'});
      var d = await r.json();
      if (!d.success) return;
      if (initial && d.session) {
        var nameEl = document.getElementById('cciPanelName');
        var userLabel = d.session.user_email || d.session.user_name || 'usuario';
        if (nameEl) nameEl.textContent = d.session.specialist_name ? `${d.session.specialist_name} ↔ ${userLabel}` : userLabel;
      }
      if (d.messages && d.messages.length) {
        var _sessUser = d.session ? (d.session.user_name || d.session.user_email || '') : '';
        d.messages.forEach(function(m) {
          if (m.id > _cLastMsgId) {
            _cLastMsgId = m.id;
            var _dName = (m.sender_role === 'user' && _sessUser) ? _sessUser : m.sender_name;
            window._cciAddMsg(m.sender_role, _dName, m.message);
          }
        });
      }
    } catch(e) {}
  }

  window._cciAddMsg = function(role, name, text) {
    var msgs = document.getElementById('cciMsgs');
    if (!msgs) return;
    var d = document.createElement('div');
    var safe = text.replace(/</g,'&lt;').replace(/>/g,'&gt;');
    if (role === 'system') {
      d.className = 'cci-msg-sys'; d.textContent = text;
    } else if (role === 'specialist') {
      d.className = 'cci-msg-spec'; d.innerHTML = `<div class="cci-msg-name">Tú</div>${safe}`;
    } else {
      d.className = 'cci-msg-user'; d.innerHTML = `<div class="cci-msg-name">${(name||'Usuario').replace(/</g,'&lt;')}</div>${safe}`;
    }
    msgs.appendChild(d);
    msgs.scrollTop = msgs.scrollHeight;
  };

  window.cciSendMsg = async function() {
    if (!window._cciActiveId) return;
    var inp = document.getElementById('cciInput');
    var txt = inp.value.trim(); if (!txt) return;
    inp.value = '';
    try {
      await fetch(`/api/chatbot/consult/${window._cciActiveId}/message`, {
        method:'POST', credentials:'include', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ message: txt, role: 'specialist' })
      });
      if (typeof window._cciLoadHistory === 'function') window._cciLoadHistory(false);
    } catch(e) {
      if (typeof showToast === 'function') showToast('Error al enviar', 'error');
    }
  };

  var _cCatsLoaded = false;
  async function _loadCciCats() {
    if (_cCatsLoaded) return;
    var sel = document.getElementById('cciCatSelect');
    try {
      var cj = await (await fetch('/api/jira/categories', {credentials:'include'})).json();
      var cats = (cj.data || []).filter(function(c){ return !c.parent_id; });
      sel.innerHTML = '<option value="">— Sin categoría específica —</option>' +
        cats.map(function(c){ return '<option value="' + c.name.replace(/"/g,'&quot;') + '">' + (c.icon ? c.icon + ' ' : '') + c.name + '</option>'; }).join('');
      _cCatsLoaded = true;
    } catch(e) { sel.innerHTML = '<option value="">General</option>'; }
  }

  window.cciShowClose = async function() {
    if (!window._cciActiveId) return;
    var panel = document.getElementById('cciClosePanel');
    panel.style.display = 'block';
    await _loadCciCats();
  };

  window.cciCancelClose = function() {
    document.getElementById('cciClosePanel').style.display = 'none';
  };

  window.cciCloseOnly = async function() {
    if (!window._cciActiveId) return;
    document.getElementById('cciClosePanel').style.display = 'none';
    try {
      await fetch(`/api/chatbot/consult/${window._cciActiveId}/resolve`, {
        method:'POST', credentials:'include', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ createTicket: false })
      });
      window._cciEndSession(null);
      if (typeof showToast === 'function') showToast('Consulta cerrada', 'success');
    } catch(e) {
      if (typeof showToast === 'function') showToast('Error al cerrar', 'error');
    }
  };

  window.cciConfirmTicket = async function() {
    if (!window._cciActiveId) return;
    var assigneeEmail = localStorage.getItem('jira_email') || '';
    document.getElementById('cciClosePanel').style.display = 'none';
    var btn = document.getElementById('cciCatConfirmBtn');
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Creando…'; }
    try {
      var r = await fetch(`/api/chatbot/consult/${window._cciActiveId}/resolve`, {
        method:'POST', credentials:'include', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ createTicket: true, assigneeEmail })
      });
      var d = await r.json();
      if (d.ticketKey) {
        _cciSavedConsultId = window._cciActiveId; // guardar antes de limpiar sesión
        window._cciEndSession(null);
        _cciAddTicketCard(d.ticketKey, d.jiraUrl, d.assigneeName, d.reporter);
        setTimeout(function() { cciShowJiraClose(d.ticketKey); }, 300);
      } else {
        window._cciEndSession(null);
        var _errMsg = d.jiraError ? ('Jira: ' + d.jiraError.slice(0,120)) : 'No se pudo crear el ticket en Jira';
        if (typeof showToast === 'function') showToast(_errMsg, 'error', 8000);
        console.error('[cciConfirmTicket] Jira error:', d.jiraError);
      }
    } catch(e) {
      if (typeof showToast === 'function') showToast('Error al crear ticket', 'error');
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-ticket-fill"></i> Generar y asignarme'; }
    }
  };

  function _cciAddTicketCard(key, url, assigneeName, reporter) {
    var msgs = document.getElementById('cciMsgs');
    if (!msgs) return;
    var d = document.createElement('div');
    d.className = 'cci-msg-sys';
    d.style.cssText = 'padding:0;background:transparent;text-align:left;';
    var jiraLink = url ? ('<a href="' + url + '" target="_blank" style="color:#2563eb;font-weight:700;text-decoration:none;">' + key + ' <i class="bi bi-box-arrow-up-right" style="font-size:10px;"></i></a>') : ('<b>' + key + '</b>');
    var assignee = assigneeName ? ('<div style="font-size:11px;color:#64748b;margin-top:3px;">Asignado a: <b>' + assigneeName.replace(/</g,'&lt;') + '</b></div>') : '';
    var rep = reporter ? ('<div style="font-size:11px;color:#64748b;">Reporter: ' + reporter.replace(/</g,'&lt;') + '</div>') : '';
    d.innerHTML = '<div style="background:#f0fdf4;border:1.5px solid #86efac;border-radius:8px;padding:10px 13px;margin:6px 0;">'
      + '<div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;"><i class="bi bi-ticket-fill" style="color:#16a34a;font-size:13px;"></i>'
      + '<span style="font-size:11px;font-weight:700;color:#15803d;">Ticket creado</span></div>'
      + '<div style="font-size:13px;font-weight:700;">' + jiraLink + '</div>'
      + rep + assignee + '</div>';
    msgs.appendChild(d);
    msgs.scrollTop = msgs.scrollHeight;
  }

  var _cciJiraCloseKey = null;

  function cciShowJiraClose(key) {
    _cciJiraCloseKey = key;
    document.getElementById('cciJiraCloseKey').textContent = key;
    document.getElementById('cciJiraCloseComment').value = '';
    document.getElementById('cciJiraCloseResult').style.display = 'none';
    var btn = document.getElementById('cciJiraCloseBtnConfirm');
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check2-circle"></i> Confirmar cierre'; }
    document.getElementById('cciPanel').classList.add('active');
    document.getElementById('cciJiraClosePanel').style.display = 'block';
    document.getElementById('cciJiraCloseComment').focus();
  }

  window.cciJiraConfirmClose = async function() {
    var comment = (document.getElementById('cciJiraCloseComment').value || '').trim();
    if (!comment) { if (typeof showToast === 'function') showToast('Agrega un comentario de cierre', 'error'); return; }
    var btn = document.getElementById('cciJiraCloseBtnConfirm');
    var resultEl = document.getElementById('cciJiraCloseResult');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Cerrando...'; }
    resultEl.style.display = 'none';
    try {
      var r = await fetch('/api/jira/ticket/' + _cciJiraCloseKey + '/close', {
        method: 'POST', credentials: 'include', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ comment, tipo_atencion: 'remota', resolucion: 'Resuelto', proceso: 'WORKPLACE', resultado_padre: 'Workplace', resultado_hijo: 'Workplace', masiva: 'NO' })
      });
      var d = await r.json();
      if (!d.success) throw new Error(d.message || 'Error al cerrar');
      document.getElementById('cciJiraClosePanel').style.display = 'none';
      var _toastMsg = d.jiraClosed
        ? 'Ticket <b>' + _cciJiraCloseKey + '</b> cerrado en Jira y sistema local'
        : 'Ticket <b>' + _cciJiraCloseKey + '</b> cerrado localmente';
      if (typeof showToast === 'function') showToast(_toastMsg, d.jiraClosed ? 'success' : 'warning', 5000);
      var _closedKey = _cciJiraCloseKey;
      setTimeout(function() { cciOpenCategorize(_closedKey); }, 400);
    } catch(e) {
      resultEl.style.display = 'block';
      resultEl.style.background = '#fee2e2'; resultEl.style.border = '1px solid #fca5a5'; resultEl.style.color = '#dc2626';
      resultEl.innerHTML = '<i class="bi bi-x-circle-fill"></i> ' + e.message;
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check2-circle"></i> Reintentar'; }
    }
  };

  window.cciJiraCancelClose = function() {
    document.getElementById('cciJiraClosePanel').style.display = 'none';
    _cciJiraCloseKey = null;
  };

  // ── Categorización inline en chatbot ─────────────────────────────────────────
  var _cciCatKey = null;
  var _cciCatTransId = null;
  var _cciCatOptions = [];

  function cciOpenCategorize(key) {
    _cciCatKey = key;
    _cciCatTransId = null;
    _cciCatOptions = [];
    document.getElementById('cciCatKey').textContent = key;
    document.getElementById('cciCatResult').style.display = 'none';
    document.getElementById('cciCatHijoWrap').style.display = 'none';
    document.getElementById('cciCatPadre').innerHTML = '<option value="">Cargando…</option>';
    var btn = document.getElementById('cciCatBtnSubmit');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Cargando…'; }
    document.getElementById('cciPanel').classList.add('active');
    document.getElementById('cciCatPanel').style.display = 'block';
    document.getElementById('cciCatPanel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    fetch('/api/jira/ticket/' + key + '/wp-categories', { credentials: 'include' })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        _cciCatOptions = data.options || [];
        _cciCatTransId = data._transId || null;
        var padre = document.getElementById('cciCatPadre');
        padre.innerHTML = '<option value="">Selecciona…</option>' +
          _cciCatOptions.map(function(o) { return '<option value="' + o.value + '">' + o.value + '</option>'; }).join('');
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check2-circle"></i> Guardar categoría'; }
      })
      .catch(function() {
        document.getElementById('cciCatPadre').innerHTML = '<option value="">Error al cargar</option>';
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check2-circle"></i> Guardar categoría'; }
      });
  }

  window.cciUpdateCatHijo = function() {
    var padre = document.getElementById('cciCatPadre');
    var hijoWrap = document.getElementById('cciCatHijoWrap');
    var hijo = document.getElementById('cciCatHijo');
    var opt = (_cciCatOptions || []).find(function(o) { return o.value === padre.value; });
    var children = opt ? (opt.children || []) : [];
    if (children.length) {
      hijo.innerHTML = '<option value="">Ninguno</option>' + children.map(function(c) { return '<option value="' + c.value + '">' + c.value + '</option>'; }).join('');
      hijoWrap.style.display = 'block';
    } else {
      hijo.innerHTML = '<option value="">—</option>';
      hijoWrap.style.display = 'none';
    }
  };

  var _cciSurveyConsultId = null;
  var _cciSavedConsultId = null; // guardado antes de _cciEndSession para encuesta

  function _cciOpenSurvey(consultId) {
    _cciSurveyConsultId = consultId || _cciSavedConsultId;
    document.getElementById('cciSurveyPanel').style.display = 'block';
    document.getElementById('cciSurveyPanel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    if (typeof loadTickets === 'function') loadTickets();
  }

  window.cciRateSubmit = async function(rating) {
    if (!_cciSurveyConsultId) return;
    document.getElementById('cciSurveyPanel').style.display = 'none';
    try {
      await fetch('/api/chatbot/consult/' + _cciSurveyConsultId + '/rate', {
        method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rating })
      });
    } catch(_) {}
    var msgs = document.getElementById('cciMsgs');
    if (msgs) {
      var d = document.createElement('div');
      d.className = 'cci-msg-sys';
      d.style.cssText = 'padding:6px 12px;background:#f0fdf4;border:1px solid #86efac;border-radius:8px;text-align:center;margin:4px 0;';
      d.innerHTML = '¡Gracias por tu valoración! ' + ['😞','😐','🙂','😊','🤩'][rating-1];
      msgs.appendChild(d);
      msgs.scrollTop = msgs.scrollHeight;
    }
  };

  window.cciSkipSurvey = function() {
    document.getElementById('cciSurveyPanel').style.display = 'none';
    _cciSurveyConsultId = null;
  };

  window.cciSubmitCat = async function() {
    var padre = (document.getElementById('cciCatPadre').value || '').trim();
    if (!padre) { if (typeof showToast === 'function') showToast('Selecciona una categoría', 'error'); return; }
    var hijo = (document.getElementById('cciCatHijo').value || '').trim();
    var btn = document.getElementById('cciCatBtnSubmit');
    var resultEl = document.getElementById('cciCatResult');
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Guardando…'; }
    resultEl.style.display = 'none';
    try {
      var r = await fetch('/api/jira/ticket/' + _cciCatKey + '/wp-category', {
        method: 'PUT', credentials: 'include', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ resultado_padre: padre, resultado_hijo: hijo, transitionId: _cciCatTransId })
      });
      var d = await r.json();
      if (!d.success) throw new Error(d.message || 'Error al guardar');
      document.getElementById('cciCatPanel').style.display = 'none';
      if (typeof showToast === 'function') showToast('Categoría guardada: ' + padre + (hijo ? ' › ' + hijo : ''), 'success', 4000);
      setTimeout(function() { _cciOpenSurvey(); }, 300);
    } catch(e) {
      resultEl.style.display = 'block';
      resultEl.style.background = '#fee2e2'; resultEl.style.border = '1px solid #fca5a5'; resultEl.style.color = '#dc2626';
      resultEl.innerHTML = '<i class="bi bi-x-circle-fill"></i> ' + e.message;
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check2-circle"></i> Reintentar'; }
    }
  };

  window.cciSkipCat = function() {
    document.getElementById('cciCatPanel').style.display = 'none';
    _cciCatKey = null;
    _cciOpenSurvey();
  };

  window._cciEndSession = function(ticketKey) {
    clearInterval(_cPollTimer); _cPollTimer = null;
    window._cciActiveId = null;
    document.getElementById('cciPanel').classList.remove('active');
    document.getElementById('cciReopenFab').classList.remove('visible');
    if (ticketKey) {
      if (typeof showToast === 'function') showToast(`Ticket <b>${ticketKey}</b> creado y asignado`, 'success', 6000);
    }
  };

  window.cciMinimize = function() {
    document.getElementById('cciPanel').classList.remove('active');
    if (window._cciActiveId) document.getElementById('cciReopenFab').classList.add('visible');
  };

  window.cciReopen = function() {
    if (window._cciActiveId) {
      document.getElementById('cciPanel').classList.add('active');
      document.getElementById('cciReopenFab').classList.remove('visible');
    }
  };

  // Persistencia al recargar: solo restaurar chat activo propio
  document.addEventListener('DOMContentLoaded', function() {
    fetch('/api/chatbot/consults/active', { credentials: 'include' })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (!d.success) return;
        // Consultas en espera: actualizar sección del sidebar
        _cciRefreshSidebar(d.waiting || []);
        // Reabrir panel solo si hay una consulta activa asignada a este especialista
        if (d.active && !window._cciActiveId) {
          window._cciActiveId = d.active.id;
          _cLastMsgId = 0;
          document.getElementById('cciMsgs').innerHTML = '';
          document.getElementById('cciClosePanel').style.display = 'none';
          document.getElementById('cciPanel').classList.add('active');
          document.getElementById('cciReopenFab').classList.remove('visible');
          _cLoadHistory(true);
          _cPollTimer = setInterval(function() { _cLoadHistory(false); }, 4000);
        }
      })
      .catch(function() {});
  });
})();
</script>
</body>
</html>
