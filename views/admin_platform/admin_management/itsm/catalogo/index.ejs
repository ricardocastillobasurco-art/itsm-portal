        <div style="font-size:12px;color:var(--text-muted);margin-top:3px;" id="msolSvcDesc"></div>
        <div style="display:flex;gap:6px;margin-top:6px;" id="msolSvcMeta"></div>
      </div>
      <!-- Correo solicitante -->
      <div class="form-group">
        <label class="form-label-custom">Correo del solicitante *</label>
        <div class="autocomplete-wrap">
          <input type="email" id="msolEmail" class="form-control-custom" placeholder="usuario@empresa.com" autocomplete="off"
                 oninput="acSolEmail(this.value)" onkeydown="acKeydown(event,'acSolEmailDrop')">
          <div id="acSolEmailDrop" class="ac-dropdown"></div>
        </div>
      </div>
      <!-- Selector categoría + servicio si no viene pre-seleccionado -->
      <div id="msolSelCat" class="form-group">
        <label class="form-label-custom">Categoría *</label>
        <select id="msolCatSel" class="form-control-custom" onchange="onCatChange()">
          <option value="">— Seleccionar categoría —</option>
        </select>
      </div>
      <div id="msolSelSvc" class="form-group" style="display:none;">
        <label class="form-label-custom">Servicio *</label>
        <select id="msolSvcSel" class="form-control-custom" onchange="onSvcChange()">
          <option value="">— Seleccionar servicio —</option>
        </select>
      </div>
      <!-- Software (solo categoría instalación de software) -->
      <div id="msolSwZone" style="display:none;" class="form-group">
        <label class="form-label-custom">Software a instalar</label>
        <div class="autocomplete-wrap">
          <input type="text" id="msolSwInput" class="form-control-custom" placeholder="Buscar software registrado..." autocomplete="off"
                 oninput="acSw(this.value)" onkeydown="acKeydown(event,'acSwDrop')">
          <div id="acSwDrop" class="ac-dropdown"></div>
        </div>
        <div id="msolSwTags" class="tag-wrap" style="margin-top:6px;" onclick="document.getElementById('msolSwInput').focus()"></div>
        <div style="font-size:11px;color:var(--text-muted);margin-top:3px;">Si el software no está en la lista, escríbelo y presiona Enter</div>
      </div>
      <!-- Campos extra según categoría -->
      <div id="msolExtraZone" style="display:none;" class="form-group">
        <label class="form-label-custom" id="msolExtraLbl">Detalles adicionales</label>
        <textarea id="msolExtra" class="form-control-custom" rows="2" placeholder=""></textarea>
      </div>
      <!-- Descripción -->
      <div class="form-group">
        <label class="form-label-custom">Descripción de la solicitud *</label>
        <textarea id="msolDesc" class="form-control-custom" rows="3" placeholder="¿Qué necesitas específicamente?"></textarea>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div class="form-group">
          <label class="form-label-custom">Prioridad</label>
          <select id="msolPriority" class="form-control-custom">
            <option value="baja">Baja</option>
            <option value="media" selected>Media</option>
            <option value="alta">Alta</option>
            <option value="critica">Crítica</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label-custom">Fecha límite</label>
          <input type="date" id="msolDue" class="form-control-custom">
        </div>
      </div>
    </div>
    <div class="modal-ftr">
      <button class="btn-outline-sm" onclick="closeModal('modalSolicitar')">Cancelar</button>
      <button class="btn-jira" onclick="enviarSolicitud()"><i class="bi bi-send"></i> Enviar Solicitud</button>
    </div>
  </div>
</div>
