      <div class="detail-row" style="flex-direction:column;gap:2px;"><span class="detail-label">Servicio</span><span style="font-size:13px;">${esc(svcName)}</span></div>
      <div class="detail-row" style="flex-direction:column;gap:2px;"><span class="detail-label">Prioridad</span><span class="bs ${bpClass(sr.priority)}">${sr.priority}</span></div>
      <div class="detail-row" style="flex-direction:column;gap:2px;"><span class="detail-label">Vence</span><span style="font-size:13px;">${fmtDate(sr.dueDate)}</span></div>
      <div class="detail-row" style="flex-direction:column;gap:2px;"><span class="detail-label">Creado</span><span style="font-size:13px;">${fmtDate(sr.createdAt)}</span></div>
    </div>
    ${sr.description?`<div style="background:var(--bg-header);border-radius:8px;padding:12px 14px;margin-bottom:14px;"><div class="detail-label" style="margin-bottom:6px;">Descripción</div><div style="font-size:13px;white-space:pre-line;line-height:1.7;">${esc(sr.description)}</div></div>`:''}
    ${(sr.approvals||[]).length?`<div style="margin-top:10px;"><div class="detail-label" style="margin-bottom:8px;">Historial de aprobaciones</div>${sr.approvals.map(a=>`<div style="display:flex;align-items:center;gap:8px;font-size:12px;padding:6px 0;border-bottom:1px solid var(--border-row);"><span class="bs ${a.status==='aprobado'?'bs-aprobado':'bs-rechazado'}">${a.status}</span><span style="color:var(--text-muted);">${fmtDate(a.decidedAt)}</span>${a.comments?`<span>${esc(a.comments)}</span>`:''}</div>`).join('')}</div>`:''}`;

  // Botones según rol y estado
  let btns='<button class="btn-outline-sm" onclick="closeModal(\'modalDetalle\')">Cerrar</button>';
  if(_userCanManage){
    btns+=`<button class="btn-outline-sm" onclick="openEmailModal('${id}','${esc(sr.requesterEmail||'')}','${esc(sr.title||'')}');closeModal('modalDetalle');"><i class="bi bi-envelope"></i> Enviar correo</button>`;
    if(sr.status==='pendiente_aprobacion'){
      btns+=`<button class="btn-success-sm" onclick="aprobar('${id}');closeModal('modalDetalle');"><i class="bi bi-check"></i> Aprobar</button>`;
      btns+=`<button class="btn-danger-sm" onclick="openDenegar('${id}');closeModal('modalDetalle');"><i class="bi bi-x"></i> Denegar</button>`;
