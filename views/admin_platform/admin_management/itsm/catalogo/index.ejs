    if(cfg.pend){document.getElementById('auto_pend_enabled').checked=true;toggleAutoSection('pend');if(cfg.pend.email)document.getElementById('auto_pend_email').value=cfg.pend.email;if(cfg.pend.hours)document.getElementById('auto_pend_hours').value=cfg.pend.hours;}
    if(cfg.sat){document.getElementById('auto_sat_enabled').checked=true;toggleAutoSection('sat');}
    if(cfg.sla){document.getElementById('auto_sla_enabled').checked=true;toggleAutoSection('sla');if(cfg.sla.email)document.getElementById('auto_sla_email').value=cfg.sla.email;if(cfg.sla.hours)document.getElementById('auto_sla_hours').value=cfg.sla.hours;}
  }catch(e){}
