  _currentEmailId=id;
  document.getElementById('emailTo').value=email||'—';
  document.getElementById('emailAsunto').value=`Actualización de tu solicitud — ${title}`;
  document.getElementById('emailMensaje').value='';
  openModal('modalEmail');
}
async function enviarEmail(){
  const msg=document.getElementById('emailMensaje').value.trim();
  if(!msg)return toast('El mensaje es requerido','err');
  const r=await fetch(`/api/service-requests/${_currentEmailId}/notify`,{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({mensaje:msg,asunto:document.getElementById('emailAsunto').value})});
  const d=await r.json();
  if(!d.success)return toast(d.error,'err');
  closeModal('modalEmail');
  toast('Correo enviado','ok');
}

// ── INIT ──────────────────────────────────────────────────────────────────
loadCatalog();

// Pre-fill reporter email from portal session (URL param takes priority over localStorage)
(function prefillReporter(){
  const params = new URLSearchParams(window.location.search);
  const email = params.get('reporter') || localStorage.getItem('portal_user_email') || '';
  if(!email) return;
  const el = document.getElementById('msolEmail');
  if(el && !el.value) el.value = email;
})();
</script>
