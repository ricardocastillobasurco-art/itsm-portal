// ── INDICADORES ───────────────────────────────────────────────────────────
let _indPrioChart=null;
async function loadIndicadores(){
  const r=await fetch('/api/service-requests?limit=500',{credentials:'include'});
  const d=await r.json();
  const rows=d.data||[];
  const total=rows.length||1;
  document.getElementById('indTotal').textContent=d.total||rows.length;
  document.getElementById('indPend').textContent=rows.filter(r=>r.status==='pendiente_aprobacion').length;
  document.getElementById('indAprov').textContent=rows.filter(r=>r.status==='aprobado').length;
  document.getElementById('indProc').textContent=rows.filter(r=>r.status==='en_proceso').length;
  document.getElementById('indComp').textContent=rows.filter(r=>r.status==='completado').length;
  document.getElementById('indRej').textContent=rows.filter(r=>r.status==='rechazado').length;
  // By status bars
  const statuses=['pendiente_aprobacion','aprobado','en_proceso','completado','rechazado','borrador'];
  const scols={'pendiente_aprobacion':'var(--warning)','aprobado':'var(--success)','en_proceso':'var(--primary)','completado':'var(--info)','rechazado':'var(--danger)','borrador':'var(--text-muted)'};
  document.getElementById('indStatusRows').innerHTML=statuses.map(s=>{
    const cnt=rows.filter(r=>r.status===s).length;
    const pct=Math.round(cnt/total*100);
    return `<div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
      <span style="width:140px;font-size:12px;font-weight:600;">${fmtStatus(s)}</span>
      <div style="flex:1;height:8px;background:var(--border-soft);border-radius:4px;overflow:hidden;"><div style="height:100%;width:${pct}%;background:${scols[s]};border-radius:4px;transition:width .4s;"></div></div>
      <span style="width:28px;text-align:right;font-size:12px;font-weight:700;">${cnt}</span>
    </div>`;
  }).join('');
  // By category bars
  const catMap={};
  rows.forEach(r=>{const k=r.service?.categoria?.name||'Sin categoría';catMap[k]=(catMap[k]||0)+1;});
  const sorted=Object.entries(catMap).sort((a,b)=>b[1]-a[1]).slice(0,8);
  document.getElementById('indCatRows').innerHTML=sorted.length?sorted.map(([k,v])=>{
    const pct=Math.round(v/total*100);
    return `<div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
      <span style="width:110px;font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${esc(k)}">${esc(k)}</span>
      <div style="flex:1;height:8px;background:var(--border-soft);border-radius:4px;overflow:hidden;"><div style="height:100%;width:${pct}%;background:var(--jira-blue);border-radius:4px;transition:width .4s;"></div></div>
      <span style="width:28px;text-align:right;font-size:12px;font-weight:700;">${v}</span>
    </div>`;
  }).join(''):'<div class="empty-state" style="padding:20px;"><i class="bi bi-inbox"></i><p>Sin datos</p></div>';
  // Donut prioridad
  const prioMap={baja:0,media:0,alta:0,critica:0};
  rows.forEach(r=>{if(prioMap[r.priority]!==undefined)prioMap[r.priority]++;});
  const pCanvas=document.getElementById('indChartPrio');
  if(pCanvas){
    if(_indPrioChart)_indPrioChart.destroy();
    _indPrioChart=new Chart(pCanvas,{type:'doughnut',data:{labels:['Baja','Media','Alta','Crítica'],datasets:[{data:[prioMap.baja,prioMap.media,prioMap.alta,prioMap.critica],backgroundColor:['#10b981','#f59e0b','#ef4444','#8b5cf6'],borderWidth:2,borderColor:'var(--bg-card)'}]},options:{responsive:true,maintainAspectRatio:true,plugins:{legend:{position:'bottom',labels:{font:{size:10},padding:8}}}}});
  }
}

