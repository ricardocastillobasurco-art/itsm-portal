      btns+=`<button class="btn-success-sm" onclick="cambiarEstado('${id}','completado');closeModal('modalDetalle');"><i class="bi bi-check2-all"></i> Completar</button>`;
  }
  document.getElementById('detFtr').innerHTML=btns;
}

