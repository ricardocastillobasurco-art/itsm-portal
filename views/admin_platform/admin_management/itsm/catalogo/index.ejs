<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - Service Desk</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="../css/core/style.css">
       <link rel="stylesheet" href="../css/modules/helpdesk.css">
       <link rel="stylesheet" href="../css/core/shared.css">
       <link rel="stylesheet" href="../css/modules/catalog.css">
      
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
.itsm-topbar-cat{display:flex;align-items:center;gap:12px;padding:10px 20px;background:var(--bg-card);border-bottom:1px solid var(--border-color);margin-bottom:8px;}
.itsm-back-cat{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--text-muted);background:var(--bg-main,#f0f4f8);border:1px solid var(--border-color);border-radius:20px;padding:5px 12px;text-decoration:none;transition:color .2s;}
.itsm-back-cat:hover{color:var(--primary-blue,#0052cc);}
.itsm-bc-cat{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted);}
.itsm-bc-cat a{color:var(--text-muted);text-decoration:none;font-weight:500;transition:color .2s;}
.itsm-bc-cat a:hover{color:var(--primary-blue,#0052cc);}
.itsm-bc-cat .sep{opacity:.4;}
.itsm-bc-cat .current{color:var(--text-primary);font-weight:700;}
</style>
</head>
<body>
<%
  const _role = user?.role || 'usuario';
  const _isAdmin       = _role === 'administrador';
  const _isEsp         = ['especialista','agente','tecnico'].includes(_role);
  const _isVisor       = _role === 'visor';
  const _canRequest    = !_isVisor;
  const _canManage     = _isAdmin || _isEsp;
  // Tabs por perfil:
  // usuario      : Registrar
  // visor        : Registrar, Indicadores
  // especialista : Registrar, Gestión, Indicadores, Categorías, Software
  // admin        : todo + Especialistas, Automatizaciones, Administración
%>
<script>(function(){document.documentElement.setAttribute('data-theme',localStorage.getItem('dashboardTheme')||'light');})();</script>
<script>
function _syncToggleUI(theme){const dark=theme==='dark';const icon=document.getElementById('toggleIcon'),label=document.getElementById('toggleLabel'),track=document.getElementById('themeTrack'),knob=document.getElementById('themeKnob');if(icon)icon.className=dark?'bi bi-sun-fill':'bi bi-moon-stars-fill';if(label)label.textContent=dark?'Claro':'Oscuro';if(track)track.style.background=dark?'#3b82f6':'#cbd5e1';if(knob)knob.style.transform=dark?'translateX(15px)':'translateX(0)';}
function toggleTheme(){const h=document.documentElement,n=h.getAttribute('data-theme')==='dark'?'light':'dark';h.setAttribute('data-theme',n);localStorage.setItem('dashboardTheme',n);_syncToggleUI(n);}
document.addEventListener('DOMContentLoaded',()=>{_syncToggleUI(localStorage.getItem('dashboardTheme')||'light');});
</script>
<div class="dashboard-wrapper">
<div class="dashboard-content">

<div class="itsm-topbar-cat" style="justify-content:space-between;">
  <div style="display:flex;align-items:center;gap:12px;">
    <a href="/itsm?tab=cat" class="itsm-back-cat"><i class="bi bi-arrow-left"></i> ITSM</a>
    <div class="itsm-bc-cat">
      <a href="/administracion"><i class="bi bi-shield-lock-fill"></i> Admin</a>
      <span class="sep">/</span>
      <a href="/itsm?tab=cat">ITSM</a>
      <span class="sep">/</span>
      <span class="current"><i class="bi bi-list-task"></i> Catálogo de Servicios</span>
    </div>
  </div>
  <button onclick="toggleTheme()" style="display:flex;align-items:center;gap:6px;background:none;border:none;cursor:pointer;padding:4px 8px;border-radius:8px;">
    <div id="themeTrack" style="width:32px;height:18px;border-radius:9px;background:#cbd5e1;position:relative;transition:background .3s;">
      <div id="themeKnob" style="width:14px;height:14px;border-radius:50%;background:#fff;position:absolute;top:2px;left:2px;transition:transform .3s;"></div>
    </div>
    <i id="toggleIcon" class="bi bi-moon-stars-fill" style="font-size:14px;color:var(--text-muted);"></i>
    <span id="toggleLabel" style="font-size:12px;color:var(--text-muted);font-weight:500;">Oscuro</span>
  </button>
</div>

<nav class="corp-tabnav" role="tablist">
  <!-- Gestión Local: Registrar + Indicadores -->
  <button class="corp-tab active" id="tabBtnRegistrar"   data-cat="local" onclick="doTab('registrar',this)"><i class="bi bi-pencil-square"></i> Registrar</button>
  <% if (_isVisor || _canManage) { %>
  <button class="corp-tab"        id="tabBtnIndicadores" data-cat="local" onclick="doTab('indicadores',this)"><i class="bi bi-bar-chart-line"></i> Indicadores</button>
  <% } %>
  <!-- Tab Gestión oculto (se carga dentro de Indicadores en modo local) -->
  <% if (_canManage) { %>
  <button class="corp-tab" id="tabBtnGestion" data-cat="hidden" onclick="doTab('gestion',this)" style="display:none"><i class="bi bi-ticket-detailed"></i> Gestión</button>
  <% } %>
  <!-- Administración: Categorías, Software, Especialistas, Automatizaciones, Gestión de Usuarios -->
  <% if (_canManage) { %>
  <button class="corp-tab" id="tabBtnCategorias"    data-cat="admin" onclick="doTab('categorias',this)"><i class="bi bi-tags"></i> Categorías</button>
  <button class="corp-tab" id="tabBtnSoftware"      data-cat="admin" onclick="doTab('software',this)"><i class="bi bi-box-seam"></i> Software</button>
  <% } %>
  <% if (_isAdmin) { %>
  <button class="corp-tab" id="tabBtnEspecialistas" data-cat="admin" onclick="doTab('especialistas',this)"><i class="bi bi-people"></i> Especialistas</button>
  <button class="corp-tab" id="tabBtnAutomaciones"  data-cat="admin" onclick="doTab('automaciones',this)"><i class="bi bi-gear-wide-connected"></i> Automatizaciones</button>
  <button class="corp-tab" id="tabBtnAdmin"         data-cat="admin" onclick="doTab('admin',this)"><i class="bi bi-people-fill"></i> Gestión de Usuarios</button>
  <% } %>
</nav>

<script>
var _tabLoaded={};
var _userCanRequest=<%= _canRequest %>;
var _userCanManage=<%= _canManage %>;
var _isAdmin=<%= _isAdmin %>;

var _catParams = new URLSearchParams(location.search);
var _catView   = _catParams.get('view');  // 'local' o null
var _catTab    = _catParams.get('tab');   // 'admin', nombre de tab, o null
var _isLocalMode = _catView === 'local';
var _isAdminMode = !_isLocalMode && (_catTab !== null);

function doTab(name, btn){
  document.querySelectorAll('.corp-tabpanel').forEach(p => p.style.display='none');
  document.querySelectorAll('.corp-tab').forEach(b => b.classList.remove('active'));
  var panels = {registrar:'tab-registrar',gestion:'tab-gestion',indicadores:'tab-indicadores',
                categorias:'tab-categorias',software:'tab-software',especialistas:'tab-especialistas',
                automaciones:'tab-automaciones',admin:'tab-admin'};
  var el = document.getElementById(panels[name]);
  if(el) el.style.display = 'block';
  if(btn) btn.classList.add('active');

  // En modo local, Indicadores unifica con Gestión (orden: KPIs → Charts → Tabla)
  if(_isLocalMode && name === 'indicadores'){
    var gestEl = document.getElementById('tab-gestion');
    var indEl  = document.getElementById('tab-indicadores');
    if(gestEl && indEl){
      // Mover tab-gestion inmediatamente después de tab-indicadores en el DOM
      if(indEl.nextSibling !== gestEl) indEl.parentNode.insertBefore(gestEl, indEl.nextSibling);
      gestEl.style.display = 'block';
      // Ocultar header y KPI cards de gestión (ya están en indicadores)
      var phdr = gestEl.querySelector('.page-header');
      if(phdr) phdr.style.display = 'none';
      var cards6 = gestEl.querySelector('.cards-6');
      if(cards6) cards6.style.display = 'none';
      // Añadir etiqueta de sección si aún no existe
      if(!document.getElementById('_gestSectionLbl')){
        var lbl = document.createElement('div');
        lbl.id = '_gestSectionLbl';
        lbl.style.cssText = 'font-size:15px;font-weight:700;margin:20px 0 12px;display:flex;align-items:center;gap:8px;';
        lbl.innerHTML = '<i class="bi bi-table" style="color:var(--jira-blue);"></i> Solicitudes';
        gestEl.insertBefore(lbl, gestEl.firstChild);
      }
    }
    if(typeof loadGestion === 'function') loadGestion();
  }

  if(name === 'gestion'){ if(typeof loadGestion === 'function') loadGestion(); return; }
  if(!_tabLoaded[name]){
    _tabLoaded[name] = true;
    setTimeout(()=>{
      if(name==='registrar'    && typeof loadCatalog==='function')       loadCatalog();
      if(name==='indicadores'  && typeof loadIndicadores==='function')   loadIndicadores();
      if(name==='categorias'   && typeof loadCats==='function')          loadCats();
      if(name==='software'     && typeof loadSoftwareList==='function')  loadSoftwareList();
      if(name==='especialistas'&& typeof loadSpecialists==='function')   loadSpecialists();
      if(name==='automaciones' && typeof loadAutomations==='function')   loadAutomations();
      if(name==='admin'        && typeof loadAdminUsers==='function')    loadAdminUsers();
    },0);
  }
}

document.addEventListener('DOMContentLoaded', function(){
  if(_isLocalMode){
    // Ocultar tabs de administración
    document.querySelectorAll('[data-cat="admin"]').forEach(b => b.style.display='none');
    // Activar Registrar por defecto
    doTab('registrar', document.getElementById('tabBtnRegistrar'));
  } else if(_isAdminMode){
    // Ocultar tabs de gestión local
    document.querySelectorAll('[data-cat="local"]').forEach(b => b.style.display='none');
    // Activar tab solicitado o el primero admin disponible
    var t = _catTab;
    var btn = t ? document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1)) : null;
    if(btn){ doTab(t, btn); }
    else {
      var first = document.querySelector('[data-cat="admin"]:not([style*="display:none"])');
      if(first) first.click();
    }
  } else {
    // Sin parámetros: comportamiento normal (todos los tabs visibles)
    var t = _catTab;
    if(t){
      var btn = document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
      if(btn) doTab(t, btn);
    }
  }
});
</script>

<!-- ══ TAB: REGISTRAR ══ -->
<div id="tab-registrar" class="corp-tabpanel" style="display:block;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px;">
    <div style="font-size:18px;font-weight:700;display:flex;align-items:center;gap:9px;">
      <i class="bi bi-grid-3x3-gap" style="color:var(--jira-blue);"></i> Catálogo de Servicios
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
      <input class="s-input" style="width:220px;" id="catSearchInput" placeholder="Buscar servicio..." oninput="filterCatalog()">
      <% if (_canManage) { %>
      <button class="btn-jira" onclick="openModalAddSvc()"><i class="bi bi-plus-lg"></i> Agregar Servicio</button>
      <% } %>
    </div>
  </div>
  <div class="two-col">
    <div class="cat-sidebar">
      <div class="cat-sidebar-head">Categorías</div>
      <div id="catNavList"><div style="padding:20px;text-align:center;color:var(--text-muted);font-size:13px;"><i class="bi bi-arrow-clockwise"></i> Cargando...</div></div>
    </div>
    <div class="card-panel" style="padding:0;">
      <div style="padding:12px 16px;background:var(--bg-header);border-bottom:1px solid var(--border-soft);display:flex;align-items:center;justify-content:space-between;">
        <span style="font-weight:700;font-size:13px;display:flex;align-items:center;gap:7px;" id="catPanelTitle"><i class="bi bi-grid-3x3-gap"></i> Todos los servicios</span>
        <span style="font-size:12px;color:var(--text-muted);" id="svcCount">0 servicios</span>
      </div>
      <div class="svc-grid" id="svcGrid"><div class="empty-state" style="grid-column:1/-1;"><i class="bi bi-arrow-clockwise"></i></div></div>
    </div>
  </div>
</div>

<!-- ══ TAB: GESTIÓN ══ -->
<% if (_canManage) { %>
<div id="tab-gestion" class="corp-tabpanel" style="display:none;">
  <div class="page-header">
    <div class="page-title"><i class="bi bi-kanban-fill" style="color:var(--jira-blue);"></i> Gestión de Solicitudes</div>
    <button class="btn-outline-sm" onclick="loadGestion()"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
  </div>
  <div class="cards-6">
    <div class="kpi-card"><div><div class="kpi-title">Total</div><div class="kpi-value" id="gkTotal" style="color:var(--purple);">—</div></div><i class="bi bi-collection kpi-icon" style="color:var(--purple);"></i></div>
    <div class="kpi-card" onclick="setGestPill(null,'pendiente_aprobacion')"><div><div class="kpi-title">Pendientes</div><div class="kpi-value" id="gkPend" style="color:var(--warning);">—</div></div><i class="bi bi-hourglass-split kpi-icon" style="color:var(--warning);"></i></div>
    <div class="kpi-card" onclick="setGestPill(null,'aprobado')"><div><div class="kpi-title">Aprobadas</div><div class="kpi-value" id="gkAprov" style="color:var(--success);">—</div></div><i class="bi bi-check-circle kpi-icon" style="color:var(--success);"></i></div>
    <div class="kpi-card" onclick="setGestPill(null,'en_proceso')"><div><div class="kpi-title">En proceso</div><div class="kpi-value" id="gkProc" style="color:var(--primary);">—</div></div><i class="bi bi-arrow-repeat kpi-icon" style="color:var(--primary);"></i></div>
    <div class="kpi-card" onclick="setGestPill(null,'completado')"><div><div class="kpi-title">Completadas</div><div class="kpi-value" id="gkComp" style="color:var(--info);">—</div></div><i class="bi bi-check2-all kpi-icon" style="color:var(--info);"></i></div>
    <div class="kpi-card" onclick="setGestPill(null,'rechazado')"><div><div class="kpi-title">Rechazadas</div><div class="kpi-value" id="gkRej" style="color:var(--danger);">—</div></div><i class="bi bi-x-circle kpi-icon" style="color:var(--danger);"></i></div>
  </div>
  <div class="card-panel" style="padding:0;overflow:hidden;">
    <div class="search-gbar">
      <div class="search-gbar-wrap">
        <i class="bi bi-search"></i>
        <input id="gestQ" placeholder="Buscar solicitante, título, categoría..." oninput="filterGestion()">
      </div>
      <div class="filter-pills" id="gestPills">
        <span class="pill active" onclick="setGestPill(this,'all')">Todas</span>
        <span class="pill" onclick="setGestPill(this,'pendiente_aprobacion')">Pendientes</span>
        <span class="pill" onclick="setGestPill(this,'aprobado')">Aprobadas</span>
        <span class="pill" onclick="setGestPill(this,'en_proceso')">En proceso</span>
        <span class="pill" onclick="setGestPill(this,'completado')">Completadas</span>
        <span class="pill" onclick="setGestPill(this,'rechazado')">Rechazadas</span>
      </div>
    </div>
    <div id="gestTableWrap">
      <div class="empty-state"><i class="bi bi-arrow-clockwise"></i><p>Cargando solicitudes...</p></div>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 16px;flex-wrap:wrap;gap:8px;">
      <span id="gestPagInfo" style="font-size:12px;color:var(--text-muted);"></span>
      <div id="gestPagBtns" style="display:flex;gap:6px;"></div>
    </div>
  </div>
</div>
<% } %>

<!-- ══ TAB: INDICADORES ══ -->
<% if (_isVisor || _canManage) { %>
<div id="tab-indicadores" class="corp-tabpanel" style="display:none;">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
    <div style="font-size:20px;font-weight:700;display:flex;align-items:center;gap:9px;"><i class="bi bi-bar-chart-line-fill" style="color:var(--jira-blue);"></i> Indicadores <span style="background:var(--jira-blue);color:#fff;font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;letter-spacing:.5px;">ITSM</span></div>
    <button class="btn-outline-sm" onclick="loadIndicadores()"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
  </div>
  <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:20px;">
    <div class="kpi-card"><div><div class="kpi-title">Total</div><div class="kpi-value" id="indTotal" style="color:var(--purple);">—</div></div><i class="bi bi-collection kpi-icon" style="color:var(--purple);"></i></div>
    <div class="kpi-card"><div><div class="kpi-title">Pendientes</div><div class="kpi-value" id="indPend" style="color:var(--warning);">—</div></div><i class="bi bi-hourglass-split kpi-icon" style="color:var(--warning);"></i></div>
    <div class="kpi-card"><div><div class="kpi-title">Aprobadas</div><div class="kpi-value" id="indAprov" style="color:var(--success);">—</div></div><i class="bi bi-check-circle kpi-icon" style="color:var(--success);"></i></div>
    <div class="kpi-card"><div><div class="kpi-title">En proceso</div><div class="kpi-value" id="indProc" style="color:var(--primary);">—</div></div><i class="bi bi-arrow-repeat kpi-icon" style="color:var(--primary);"></i></div>
    <div class="kpi-card"><div><div class="kpi-title">Completadas</div><div class="kpi-value" id="indComp" style="color:var(--info);">—</div></div><i class="bi bi-check2-all kpi-icon" style="color:var(--info);"></i></div>
    <div class="kpi-card"><div><div class="kpi-title">Rechazadas</div><div class="kpi-value" id="indRej" style="color:var(--danger);">—</div></div><i class="bi bi-x-circle kpi-icon" style="color:var(--danger);"></i></div>
  </div>
  <div style="display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:16px;margin-bottom:20px;">
    <div class="card-panel">
      <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;display:flex;align-items:center;gap:6px;"><i class="bi bi-bar-chart-horizontal-fill" style="color:var(--jira-blue);"></i> Por estado</div>
      <div id="indStatusRows"></div>
    </div>
    <div class="card-panel" style="display:flex;flex-direction:column;">
      <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;display:flex;align-items:center;gap:6px;"><i class="bi bi-pie-chart-fill" style="color:var(--purple);"></i> Por prioridad</div>
      <div style="flex:1;display:flex;align-items:center;justify-content:center;"><canvas id="indChartPrio" style="max-height:140px;max-width:180px;"></canvas></div>
    </div>
    <div class="card-panel" style="display:flex;flex-direction:column;">
      <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;display:flex;align-items:center;gap:6px;"><i class="bi bi-tags-fill" style="color:var(--info);"></i> Por categoría</div>
      <div id="indCatRows"></div>
    </div>
  </div>
</div>
<% } %>

<!-- ══ TAB: CATEGORÍAS ══ -->
<% if (_canManage) { %>
<div id="tab-categorias" class="corp-tabpanel" style="display:none;">
  <div style="display:grid;grid-template-columns:1fr 400px;gap:20px;align-items:start;">
    <div class="card-panel">
      <div style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:16px;display:flex;align-items:center;gap:8px;"><i class="bi bi-tags" style="color:var(--jira-blue);"></i> Categorías configuradas</div>
      <div id="catsBody" style="display:flex;flex-direction:column;gap:8px;min-height:60px;"></div>
    </div>
    <div class="card-panel" style="position:sticky;top:80px;">
      <div style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:16px;display:flex;align-items:center;gap:8px;" id="catFormTitle"><i class="bi bi-plus-circle" style="color:var(--jira-blue);"></i> Nueva Categoría</div>
      <input type="hidden" id="catEditId">
      <div style="display:flex;flex-direction:column;gap:12px;">
        <div><div class="form-label-custom">Nombre *</div>
          <input type="text" id="catName" class="form-control-custom" placeholder="Ej: Instalación de Software"></div>
        <div><div class="form-label-custom">Descripción</div>
          <textarea id="catDesc" class="form-control-custom" rows="2" placeholder="Breve descripción de la categoría"></textarea></div>
        <div><div class="form-label-custom">Icono Bootstrap <a href="https://icons.getbootstrap.com" target="_blank" style="font-size:10px;color:var(--jira-blue);">bootstrap-icons ↗</a></div>
          <div style="display:flex;gap:8px;align-items:center;">
            <input type="text" id="catIcon" class="form-control-custom" placeholder="Ej: box-seam, folder, gear" oninput="previewCatIcon()">
            <i id="catIconPreview" class="bi bi-folder" style="font-size:24px;color:var(--jira-blue);min-width:28px;"></i>
          </div></div>
        <div style="display:flex;gap:8px;justify-content:flex-end;padding-top:4px;">
          <button class="btn-outline-sm" onclick="resetCatForm()"><i class="bi bi-x-circle"></i> Limpiar</button>
          <button class="btn-jira" onclick="guardarCategoria()"><i class="bi bi-save"></i> <span id="catSaveLabel">Guardar</span></button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ══ TAB: SOFTWARE ══ -->
<div id="tab-software" class="corp-tabpanel" style="display:none;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px;">
    <div style="font-size:20px;font-weight:700;display:flex;align-items:center;gap:9px;"><i class="bi bi-box-seam" style="color:var(--jira-blue);"></i> Catálogo de Software</div>
    <button class="btn-jira" onclick="openModalAddSw()"><i class="bi bi-plus-lg"></i> Registrar Software</button>
  </div>
  <div class="card-panel" style="padding:0;">
    <div style="padding:12px 16px;background:var(--bg-header);border-bottom:1px solid var(--border-soft);">
      <input class="s-input" id="swSearch" placeholder="Buscar software..." oninput="filterSwList()" style="width:240px;">
    </div>
    <div class="tbl-wrap">
      <table class="tbl">
