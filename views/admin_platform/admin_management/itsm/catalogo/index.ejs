async function confirmarDenegar(){
  const reason=document.getElementById('denyReason').value.trim();
  if(!reason)return toast('El motivo de rechazo es requerido','err');
  const r=await fetch(`/api/service-requests/${_currentDenyId}/approve`,{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({decision:'rechazado',comments:reason})});
  const d=await r.json();
