      <div class="form-group">
        <label class="form-label-custom">Motivo de rechazo *</label>
        <textarea id="denyReason" class="form-control-custom" rows="4" placeholder="Explica el motivo del rechazo..."></textarea>
      </div>
    </div>
    <div class="modal-ftr">
      <button class="btn-outline-sm" onclick="closeModal('modalDenegar')">Cancelar</button>
      <button class="btn-danger-sm" onclick="confirmarDenegar()"><i class="bi bi-x-circle"></i> Denegar</button>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
// ── Helpers ────────────────────────────────────────────────────────────────
function esc(t){const d=document.createElement('div');d.textContent=String(t||'');return d.innerHTML;}
function toast(msg,type='inf'){const b=document.getElementById('toastBox'),d=document.createElement('div');d.className='t-item t-'+type;d.innerHTML=`<i class="bi bi-${type==='ok'?'check-circle':type==='err'?'x-circle':'info-circle'}"></i><span>${msg}</span>`;b.appendChild(d);setTimeout(()=>d.remove(),4000);}
function closeModal(id){document.getElementById(id).classList.remove('open');}
function openModal(id){document.getElementById(id).classList.add('open');}
function fmtDate(d){return d?new Date(d).toLocaleDateString('es',{day:'2-digit',month:'short',year:'numeric'}):'—';}
function fmtStatus(s){return{borrador:'Borrador',pendiente_aprobacion:'Pendiente aprobación',aprobado:'Aprobado',en_proceso:'En proceso',completado:'Completado',rechazado:'Rechazado',cancelado:'Cancelado'}[s]||s;}
function bsClass(s){return'bs-'+s.replace(/ /g,'_');}
function bpClass(p){return'bp-'+(p||'media');}
function acKeydown(e,dropId){const d=document.getElementById(dropId);if(!d||!d.classList.contains('show'))return;const items=[...d.querySelectorAll('.ac-item')];if(!items.length)return;const cur=d.querySelector('.active-ac');let idx=items.indexOf(cur);if(e.key==='ArrowDown'){e.preventDefault();if(cur)cur.classList.remove('active-ac');items[(idx+1)%items.length].classList.add('active-ac');}else if(e.key==='ArrowUp'){e.preventDefault();if(cur)cur.classList.remove('active-ac');items[(idx-1+items.length)%items.length].classList.add('active-ac');}else if(e.key==='Enter'){e.preventDefault();const a=d.querySelector('.active-ac');if(a)a.click();}}
function renderPag(containerId,total,page,limit,cb){const pages=Math.ceil(total/limit);const c=document.getElementById(containerId);if(!c||pages<=1){if(c)c.innerHTML='';return;}let h='';for(let i=1;i<=Math.min(pages,7);i++)h+=`<div class="pg-btn ${i===page?'active':''}" onclick="(${cb})(${i})">${i}</div>`;c.innerHTML=h;}

// ── STATE ──────────────────────────────────────────────────────────────────
let _allCats=[], _allSvcs=[], _activeCatId='', _activeSvcId=null;
let _msolPreSvcId=null, _msolSwTags=[];
let _currentDetailId=null, _currentEmailId=null, _currentDenyId=null;
let _swAll=[];

// ── CATALOG LOAD ──────────────────────────────────────────────────────────
async function loadCatalog(){
  const [cr,sr]=await Promise.all([fetch('/api/catalog/categories',{credentials:'include'}),fetch('/api/catalog',{credentials:'include'})]);
  _allCats=(await cr.json()).data||[];
  _allSvcs=(await sr.json()).data||[];
  renderCatNav();
  renderSvcGrid(_allSvcs);
  // also populate modal selects
  const catSel=document.getElementById('msolCatSel');
  const asvCatSel=document.getElementById('asvCatId');
  const opts='<option value="">— Seleccionar categoría —</option>'+_allCats.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join('');
  if(catSel)catSel.innerHTML=opts;
  if(asvCatSel)asvCatSel.innerHTML=opts;
}

function renderCatNav(){
  const cnt={};
  _allSvcs.forEach(s=>{cnt[s.categoryId]=(cnt[s.categoryId]||0)+1;});
  document.getElementById('catNavList').innerHTML=
    `<div class="cat-item ${!_activeCatId?'active':''}" onclick="selectCat('')"><i class="bi bi-grid-3x3-gap" style="font-size:16px;"></i>Todos<span class="cnt">${_allSvcs.length}</span></div>`+
    _allCats.map(c=>`<div class="cat-item ${_activeCatId===c.id?'active':''}" onclick="selectCat('${c.id}')"><i class="bi bi-${esc(c.icon||'folder')}" style="font-size:16px;"></i>${esc(c.name)}<span class="cnt">${cnt[c.id]||0}</span></div>`).join('');
}

function selectCat(id){
  _activeCatId=id;
  renderCatNav();
  const filtered=id?_allSvcs.filter(s=>s.categoryId===id):_allSvcs;
  const cat=_allCats.find(c=>c.id===id);
  document.getElementById('catPanelTitle').innerHTML=`<i class="bi bi-${esc(cat?.icon||'grid-3x3-gap')}"></i> ${esc(cat?.name||'Todos los servicios')}`;
  renderSvcGrid(filtered);
}

function filterCatalog(){
  const q=document.getElementById('catSearchInput').value.toLowerCase();
  const src=_activeCatId?_allSvcs.filter(s=>s.categoryId===_activeCatId):_allSvcs;
  renderSvcGrid(q?src.filter(s=>s.name.toLowerCase().includes(q)||(s.description||'').toLowerCase().includes(q)):src);
}

function renderSvcGrid(svcs){
  document.getElementById('svcCount').textContent=`${svcs.length} servicio${svcs.length!==1?'s':''}`;
  const g=document.getElementById('svcGrid');
  if(!svcs.length){g.innerHTML='<div class="empty-state" style="grid-column:1/-1;"><i class="bi bi-inbox"></i><p>Sin servicios en esta categoría</p></div>';return;}
  g.innerHTML=svcs.map(s=>`
    <div class="svc-card" onclick="_userCanRequest&&openModalSolicitar('${s.id}')">
      ${_userCanManage?`<div class="svc-admin-btns"><button class="btn-outline-sm" onclick="event.stopPropagation();editSvc('${s.id}')" title="Editar"><i class="bi bi-pencil"></i></button></div>`:''}
      ${_userCanRequest?`<button class="svc-btn-hover" onclick="event.stopPropagation();openModalSolicitar('${s.id}')"><i class="bi bi-send"></i> Solicitar</button>`:''}
      <div class="svc-name"><i class="bi bi-${esc(s.categoria?.icon||'box')}" style="color:var(--jira-blue);"></i>${esc(s.name)}</div>
      <div class="svc-desc">${esc(s.description||'Sin descripción')}</div>
      <div class="svc-meta">
        <span class="badge-sla"><i class="bi bi-clock"></i> SLA ${s.slaHours}h</span>
        ${s.approvalRequired?'<span class="badge-aprob"><i class="bi bi-person-check"></i> Req. aprobación</span>':''}
      </div>
      ${!_userCanRequest?'<div style="margin-top:10px;font-size:11px;color:var(--text-muted);font-style:italic;">Sin permisos para solicitar</div>':''}
    </div>`).join('');
}

// ── SOLICITAR MODAL ───────────────────────────────────────────────────────
function openModalSolicitar(svcId){
  _msolPreSvcId=svcId;
  _msolSwTags=[];
  document.getElementById('msolEmail').value='';
  document.getElementById('msolDesc').value='';
  document.getElementById('msolDue').value='';
  document.getElementById('msolPriority').value='media';
  document.getElementById('msolSwTags').innerHTML='';
  document.getElementById('msolSwInput').value='';
  document.getElementById('acSwDrop').classList.remove('show');
  document.getElementById('acSolEmailDrop').classList.remove('show');

  if(svcId){
    const svc=_allSvcs.find(s=>s.id===svcId);
    document.getElementById('msolTitle').textContent=svc?.name||'Solicitar';
    document.getElementById('msolSvcName').textContent=svc?.name||'';
    document.getElementById('msolSvcDesc').textContent=svc?.description||'';
    document.getElementById('msolSvcMeta').innerHTML=(svc?`<span class="badge-sla">SLA ${svc.slaHours}h</span>${svc.approvalRequired?'<span class="badge-aprob">Req. aprobación</span>':''}`:'');
    document.getElementById('msolInfo').style.display='';
    document.getElementById('msolSelCat').style.display='none';
    document.getElementById('msolSelSvc').style.display='none';
    _activeSvcId=svcId;
    showSwZone(svc?.categoria?.name||svc?.category?.name||'');
  } else {
    document.getElementById('msolTitle').textContent='Nueva Solicitud';
    document.getElementById('msolInfo').style.display='none';
    document.getElementById('msolSelCat').style.display='';
    document.getElementById('msolSelSvc').style.display='none';
    document.getElementById('msolCatSel').value='';
    _activeSvcId=null;
    showSwZone('');
  }
  openModal('modalSolicitar');
}

function onCatChange(){
  const catId=document.getElementById('msolCatSel').value;
  const svcsInCat=_allSvcs.filter(s=>s.categoryId===catId);
  const sel=document.getElementById('msolSvcSel');
  if(svcsInCat.length&&catId){
    sel.innerHTML='<option value="">— Seleccionar servicio —</option>'+svcsInCat.map(s=>`<option value="${s.id}">${esc(s.name)}</option>`).join('');
    document.getElementById('msolSelSvc').style.display='';
  } else {
    document.getElementById('msolSelSvc').style.display='none';
  }
  const cat=_allCats.find(c=>c.id===catId);
  showSwZone(cat?.name||'');
  _activeSvcId=null;
}

function onSvcChange(){
  _activeSvcId=document.getElementById('msolSvcSel').value||null;
}

function showSwZone(catName){
  const name=(catName||'').toLowerCase();
  const isSw=name.includes('software')||name.includes('instalaci');
  const isAcceso=name.includes('acceso')||name.includes('accesos');
  const isRed=name.includes('red')||name.includes('vpn')||name.includes('conect');
  document.getElementById('msolSwZone').style.display=isSw?'':'none';
  const extra=document.getElementById('msolExtraZone');
  const lbl=document.getElementById('msolExtraLbl');
  if(isAcceso){extra.style.display='';lbl.textContent='Aplicación / sistema al que necesita acceso';}
  else if(isRed){extra.style.display='';lbl.textContent='Detalle de red o VPN requerido';}
  else{extra.style.display='none';}
}

// Autocomplete email solicitante
let _acEmailTimer;
function acSolEmail(val){
  clearTimeout(_acEmailTimer);
  const drop=document.getElementById('acSolEmailDrop');
  if(!val||val.length<2){drop.classList.remove('show');return;}
  _acEmailTimer=setTimeout(async()=>{
    const r=await fetch(`/api/employees/search-emails?q=${encodeURIComponent(val)}`,{credentials:'include'});
    const d=await r.json();
    const emps=(d.data||[]).slice(0,8);
    if(!emps.length){drop.innerHTML='<div class="ac-item"><span class="ac-sub">Sin resultados</span></div>';drop.classList.add('show');return;}
    drop.innerHTML=emps.map(e=>`<div class="ac-item" onclick="pickSolEmail('${esc(e.email||'')}')"><div class="ac-name">${esc(e.full_name||'')}</div><div class="ac-sub">${esc(e.email||'')} · ${esc(e.position_name||'')}</div></div>`).join('');
    drop.classList.add('show');
  },260);
}
function pickSolEmail(email){
  document.getElementById('msolEmail').value=email;
  document.getElementById('acSolEmailDrop').classList.remove('show');
}

// Autocomplete software
let _acSwTimer;
function acSw(val){
  clearTimeout(_acSwTimer);
  const drop=document.getElementById('acSwDrop');
  _acSwTimer=setTimeout(async()=>{
    const r=await fetch(`/api/service-requests/software?q=${encodeURIComponent(val)}`,{credentials:'include'});
    const d=await r.json();
    const items=(d.data||[]).slice(0,10);
    if(!items.length){drop.innerHTML=`<div class="ac-item" onclick="addSwTag('${esc(val)}')"><i class="bi bi-plus"></i> Agregar "${esc(val)}"</div>`;drop.classList.add('show');return;}
    drop.innerHTML=items.map(s=>`<div class="ac-item" onclick="addSwTag('${esc(s.nombre)}')"><div class="ac-name">${esc(s.nombre)}</div><div class="ac-sub">${esc(s.version||'')} · ${esc(s.proveedor||'')}</div></div>`).join('');
    if(val) drop.innerHTML+=`<div class="ac-item" onclick="addSwTag('${esc(val)}')"><i class="bi bi-plus"></i> Agregar "${esc(val)}" manualmente</div>`;
    drop.classList.add('show');
  },240);
}
function addSwTag(nombre){
  if(!nombre.trim()||_msolSwTags.includes(nombre.trim()))return;
  _msolSwTags.push(nombre.trim());
  renderSwTags();
  document.getElementById('msolSwInput').value='';
  document.getElementById('acSwDrop').classList.remove('show');
}
function removeSwTag(idx){
  _msolSwTags.splice(idx,1);
  renderSwTags();
}
function renderSwTags(){
  document.getElementById('msolSwTags').innerHTML=_msolSwTags.map((t,i)=>`<span class="sw-tag">${esc(t)}<span class="rm" onclick="removeSwTag(${i})">✕</span></span>`).join('');
}
document.addEventListener('keydown',e=>{if(e.key==='Enter'&&document.activeElement===document.getElementById('msolSwInput')){e.preventDefault();const v=document.getElementById('msolSwInput').value.trim();if(v)addSwTag(v);}});
document.addEventListener('click',e=>{
  ['acSolEmailDrop','acSwDrop'].forEach(id=>{const el=document.getElementById(id);if(el&&!el.parentElement.contains(e.target))el.classList.remove('show');});
});

async function enviarSolicitud(){
  const email=document.getElementById('msolEmail').value.trim();
  const desc=document.getElementById('msolDesc').value.trim();
  if(!email)return toast('El correo del solicitante es requerido','err');
  if(!desc)return toast('La descripción es requerida','err');
  const svcId=_msolPreSvcId||_activeSvcId||document.getElementById('msolSvcSel')?.value||null;
  const catId=document.getElementById('msolCatSel')?.value||null;
  const cat=_allCats.find(c=>c.id===catId);
  const svc=_allSvcs.find(s=>s.id===svcId);
  const title=svc?`Solicitud: ${svc.name}`:cat?`Solicitud: ${cat.name}`:'Nueva solicitud';
  const extra=document.getElementById('msolExtra')?.value||'';
  const body={
    title, description:desc, serviceId:svcId||undefined,
    priority:document.getElementById('msolPriority').value,
    dueDate:document.getElementById('msolDue').value||undefined,
    requesterEmail:email,
    softwareItems:_msolSwTags.length?_msolSwTags:undefined,
    extraData:extra||undefined,
  };
  const r=await fetch('/api/service-requests',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify(body)});
  const d=await r.json();
  if(!d.success)return toast(d.error,'err');
  closeModal('modalSolicitar');
  toast('Solicitud enviada correctamente','ok');
  if(_tabLoaded['indicadores'])loadIndicadores();
}

// ── AGREGAR SERVICIO ──────────────────────────────────────────────────────
function openModalAddSvc(){
  document.getElementById('asvName').value='';
  document.getElementById('asvDesc').value='';
  document.getElementById('asvSla').value=8;
  document.getElementById('asvApproval').value='0';
  if(_allCats.length){
    document.getElementById('asvCatId').innerHTML='<option value="">— Seleccionar —</option>'+_allCats.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join('');
  }
  openModal('modalAddSvc');
}
async function guardarServicio(){
  const catId=document.getElementById('asvCatId').value;
  const name=document.getElementById('asvName').value.trim();
  if(!catId||!name)return toast('Categoría y nombre son requeridos','err');
  const r=await fetch('/api/catalog',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({categoryId:catId,name,description:document.getElementById('asvDesc').value,slaHours:parseInt(document.getElementById('asvSla').value)||8,approvalRequired:document.getElementById('asvApproval').value==='1'})});
  const d=await r.json();
  if(!d.success)return toast(d.error,'err');
  closeModal('modalAddSvc');
  toast('Servicio agregado','ok');
  await loadCatalog();
}

// ── SOFTWARE MODAL ────────────────────────────────────────────────────────
function onSwCatChange(){
  const cat=document.getElementById('swCat').value;
  const zone=document.getElementById('swExtraZone');
  const lbl=document.getElementById('swExtraLbl');
  if(cat==='Accesos'){zone.style.display='';lbl.textContent='URL o sistema de acceso';}
  else if(cat==='Redes'){zone.style.display='';lbl.textContent='Tipo de red / VPN / protocolo';}
  else if(cat==='Licenciado'){zone.style.display='';lbl.textContent='Nro. de licencia o contrato';}
  else zone.style.display='none';
}
function openModalAddSw(){
  ['swNombre','swVersion','swProveedor'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('swCat').value='Software';
  document.getElementById('swExtraZone').style.display='none';
  if(document.getElementById('swDetalles'))document.getElementById('swDetalles').value='';
  openModal('modalAddSw');
}
async function guardarSoftware(){
  const nombre=document.getElementById('swNombre').value.trim();
  if(!nombre)return toast('El nombre es requerido','err');
  const r=await fetch('/api/service-requests/software',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({nombre,version:document.getElementById('swVersion').value||undefined,proveedor:document.getElementById('swProveedor').value||undefined,categoria:document.getElementById('swCat').value,detalles:document.getElementById('swDetalles')?.value||undefined})});
  const d=await r.json();
  if(!d.success)return toast(d.error,'err');
  closeModal('modalAddSw');
  toast('Software registrado','ok');
  if(_tabLoaded['software'])loadSoftwareList();
}


// ── GESTIÓN ───────────────────────────────────────────────────────────────
let _allSolicitudes=[], _gestPill='all', _gestPage=1;
const GEST_PAGE_SIZE=20;

function setGestPill(el,val){
  _gestPill=val||'all';
  _gestPage=1;
  document.querySelectorAll('#gestPills .pill').forEach(p=>p.classList.remove('active'));
  if(el){el.classList.add('active');}
  else{const p=document.querySelector(`#gestPills .pill[onclick*="'${_gestPill}'"]`);if(p)p.classList.add('active');}
  renderGestion();
}
function filterGestion(){_gestPage=1;renderGestion();}
function gestGoPage(p){
  const q=(document.getElementById('gestQ')?.value||'').toLowerCase().trim();
  const filtered=_allSolicitudes.filter(r=>{
    if(_gestPill!=='all'&&r.status!==_gestPill)return false;
    if(q){const h=[r.title,r.requesterEmail,r.service?.name,r.service?.categoria?.name].join(' ').toLowerCase();if(!h.includes(q))return false;}
    return true;
  });
  const pages=Math.ceil(filtered.length/GEST_PAGE_SIZE)||1;
  if(p<1||p>pages)return;
  _gestPage=p;
  renderGestion();
}

async function loadGestion(){
  const wrap=document.getElementById('gestTableWrap');
  if(wrap)wrap.innerHTML='<div class="empty-state"><i class="bi bi-arrow-clockwise"></i><p>Cargando solicitudes...</p></div>';
  try{
    const r=await fetch('/api/service-requests?limit=500',{credentials:'include'});
    const d=await r.json();
    _allSolicitudes=d.data||[];
    const all=_allSolicitudes;
    document.getElementById('gkTotal').textContent=all.length;
    document.getElementById('gkPend').textContent=all.filter(x=>x.status==='pendiente_aprobacion').length;
    document.getElementById('gkAprov').textContent=all.filter(x=>x.status==='aprobado').length;
    document.getElementById('gkProc').textContent=all.filter(x=>x.status==='en_proceso').length;
    document.getElementById('gkComp').textContent=all.filter(x=>x.status==='completado').length;
    document.getElementById('gkRej').textContent=all.filter(x=>x.status==='rechazado').length;
    renderGestion();
  }catch(err){
    if(wrap)wrap.innerHTML=`<div class="empty-state"><i class="bi bi-exclamation-triangle"></i><p>Error cargando datos.<br><small>${err.message}</small></p><button class="btn-outline-sm" style="margin-top:8px;" onclick="loadGestion()"><i class="bi bi-arrow-clockwise"></i> Reintentar</button></div>`;
  }
}

function renderGestion(){
  const q=(document.getElementById('gestQ')?.value||'').toLowerCase().trim();
  let rows=_allSolicitudes.filter(r=>{
    if(_gestPill!=='all'&&r.status!==_gestPill)return false;
    if(q){const h=[r.title,r.requesterEmail,r.service?.name,r.service?.categoria?.name].join(' ').toLowerCase();if(!h.includes(q))return false;}
    return true;
  });
  rows.sort((a,b)=>{
    const pa=a.status==='pendiente_aprobacion'?0:1, pb=b.status==='pendiente_aprobacion'?0:1;
    if(pa!==pb)return pa-pb;
    return new Date(b.createdAt)-new Date(a.createdAt);
  });
  const total=rows.length;
  const pages=Math.ceil(total/GEST_PAGE_SIZE)||1;
  if(_gestPage>pages)_gestPage=1;
  const start=(_gestPage-1)*GEST_PAGE_SIZE;
  const pageRows=rows.slice(start,start+GEST_PAGE_SIZE);
  const wrap=document.getElementById('gestTableWrap');
  if(!pageRows.length){
    wrap.innerHTML='<div class="empty-state"><i class="bi bi-inbox"></i><p>Sin solicitudes</p></div>';
    document.getElementById('gestPagInfo').textContent='';
    document.getElementById('gestPagBtns').innerHTML='';
    return;
  }
  wrap.innerHTML=`<div style="overflow-x:auto;"><table class="tbl">
    <thead><tr><th>Solicitante</th><th>Título / Servicio</th><th>Categoría</th><th>Prioridad</th><th>Estado</th><th>Creado</th><th>Acciones</th></tr></thead>
    <tbody>${pageRows.map(r=>`<tr onclick="verDetalle('${r.id}')" style="cursor:pointer;">
      <td><div style="font-weight:600;font-size:13px;">${esc(r.requesterEmail||'—')}</div></td>
      <td><div style="font-weight:600;max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${esc(r.title||'')}">${esc(r.title||'—')}</div><div style="font-size:11px;color:var(--text-muted);">${esc(r.service?.name||'Sin servicio')}</div></td>
      <td style="font-size:12px;">${esc(r.service?.categoria?.name||'—')}</td>
      <td><span class="bs ${bpClass(r.priority)}">${r.priority||'media'}</span></td>
      <td><span class="bs ${bsClass(r.status)}">${fmtStatus(r.status)}</span></td>
      <td style="font-size:12px;color:var(--text-muted);white-space:nowrap;">${fmtDate(r.createdAt)}</td>
      <td onclick="event.stopPropagation();"><div style="display:flex;gap:4px;flex-wrap:wrap;">
        ${r.status==='pendiente_aprobacion'?`<button class="btn-success-sm" style="padding:4px 9px;font-size:11px;" onclick="aprobar('${r.id}')"><i class="bi bi-check-lg"></i> Aprobar</button><button class="btn-danger-sm" style="padding:4px 9px;font-size:11px;" onclick="openDenegar('${r.id}')"><i class="bi bi-x-lg"></i> Denegar</button>`:''}
        ${r.status==='aprobado'?`<button class="btn-outline-sm" style="padding:4px 9px;font-size:11px;" onclick="cambiarEstado('${r.id}','en_proceso')"><i class="bi bi-arrow-repeat"></i> En proceso</button>`:''}
        ${r.status==='en_proceso'?`<button class="btn-success-sm" style="padding:4px 9px;font-size:11px;" onclick="cambiarEstado('${r.id}','completado')"><i class="bi bi-check2-all"></i> Completar</button>`:''}
        <button class="btn-outline-sm" style="padding:4px 8px;" onclick="openEmailModal('${r.id}','${esc(r.requesterEmail||'')}','${esc(r.title||'')}')"><i class="bi bi-envelope"></i></button>
      </div></td>
    </tr>`).join('')}</tbody>
  </table></div>`;
  const info=document.getElementById('gestPagInfo');
  const btns=document.getElementById('gestPagBtns');
  const e=Math.min(start+GEST_PAGE_SIZE,total);
  if(info)info.textContent=total?`Mostrando ${start+1}–${e} de ${total} solicitudes`:'';
  if(!btns)return;
  if(pages<=1){btns.innerHTML='';return;}
  let html=`<button class="btn-outline-sm" onclick="gestGoPage(${_gestPage-1})" ${_gestPage===1?'disabled':''}><i class="bi bi-chevron-left"></i></button>`;
  for(let i=1;i<=pages;i++){
    if(i===1||i===pages||(i>=_gestPage-1&&i<=_gestPage+1))
      html+=`<button class="btn-outline-sm" style="${i===_gestPage?'background:var(--jira-blue);color:white;border-color:var(--jira-blue);':''}" onclick="gestGoPage(${i})">${i}</button>`;
    else if(i===_gestPage-2||i===_gestPage+2)
      html+=`<span style="padding:4px 6px;font-size:12px;color:var(--text-muted);">…</span>`;
  }
  html+=`<button class="btn-outline-sm" onclick="gestGoPage(${_gestPage+1})" ${_gestPage===pages?'disabled':''}><i class="bi bi-chevron-right"></i></button>`;
  btns.innerHTML=html;
}

