    if(sr.status==='aprobado')
      btns+=`<button class="btn-outline-sm" style="border-color:var(--primary);color:var(--primary);" onclick="cambiarEstado('${id}','en_proceso');closeModal('modalDetalle');"><i class="bi bi-arrow-repeat"></i> En proceso</button>`;
