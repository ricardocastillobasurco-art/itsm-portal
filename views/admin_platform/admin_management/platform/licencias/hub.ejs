<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<script>(function(){document.documentElement.setAttribute('data-theme',localStorage.getItem('dashboardTheme')||'light');})();</script>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Licenciamiento · IT Platform</title>
<%- include('../../../../shared/partials/admin/hub-styles') %>
</head>
<body>
<%
  const _u=user||{};const _n=_u.full_name||_u.name||_u.email||'Usuario';
  const _p=_n.trim().split(/\s+/);const _i=(_p[0]?.[0]||'U').toUpperCase()+(_p[1]?.[0]||'').toUpperCase();
%>
<nav class="navbar">
  <button class="nav-hamburger" onclick="toggleSidebar()"><i class="bi bi-layout-sidebar"></i></button>
  <div class="nav-brand">
    <img src="/images/movistar-logo.png" alt="" class="nav-logo" onerror="this.style.display='none'">
    <span class="nav-divider"></span>
    <span class="nav-name">IT Platform</span>
    <span class="nav-badge" style="background:linear-gradient(135deg,#059669,#10b981);">LICENCIAS</span>
  </div>
  <div class="nav-breadcrumb">
    <span class="sep">·</span>
    <a href="/administracion"><i class="bi bi-shield-lock-fill" style="color:#7c3aed;font-size:10px;"></i> Admin</a>
    <span class="sep">/</span>
    <span class="cur"><i class="bi bi-key-fill"></i> Licenciamiento</span>
  </div>
  <div class="nav-space"></div>
  <button class="nav-icon-btn" onclick="toggleTheme()"><i class="bi bi-moon-stars-fill" id="navThemeIcon"></i></button>
  <div class="nav-user"><div class="nav-avatar"><%= _i %></div><span class="nav-username"><%= _p[0] %></span></div>
  <a href="/api/auth/logout" class="nav-exit"><i class="bi bi-box-arrow-right"></i> Salir</a>
</nav>

<div class="app-shell">
  <div class="sidebar" id="sidebar">
    <div class="sb-header">
      <div class="sb-icon-box" style="background:linear-gradient(135deg,#059669,#10b981);"><i class="bi bi-key-fill"></i></div>
      <div class="sb-brand"><div class="sb-brand-name">Licencias</div><div class="sb-brand-sub">M365 & Software</div></div>
    </div>
    <nav class="sb-nav">
      <a class="sb-item" href="/administracion"><i class="bi bi-arrow-left-circle sb-icon" style="color:var(--muted-2);"></i><span class="sb-label">← Administración</span></a>
      <div class="sb-divider"></div>
      <span class="sb-section-label">Licenciamiento</span>
      <button class="sb-item active" id="sb-m365" onclick="showPanel('m365',this)"><i class="bi bi-microsoft sb-icon" style="color:#059669;"></i><span class="sb-label">Microsoft 365</span></button>
      <button class="sb-item" id="sb-soft" onclick="showPanel('soft',this)"><i class="bi bi-box-seam-fill sb-icon" style="color:#d97706;"></i><span class="sb-label">Software</span></button>
    </nav>
    <div class="sb-footer">
      <div class="sb-user-av"><%= _i %></div>
      <div class="sb-user-info"><div class="sb-user-name"><%= _n %></div><div class="sb-user-role"><%= _u.role||'agente' %></div></div>
      <button class="sb-theme-btn" onclick="toggleTheme()"><i class="bi bi-moon-stars-fill" id="sbThemeIcon"></i></button>
    </div>
  </div>
  <div class="sb-overlay" id="sbOverlay" onclick="closeSidebarMobile()"></div>

  <div class="content-area">

    <!-- MICROSOFT 365 -->
    <div class="hub-panel active" id="panel-m365">
      <div class="content-header">
        <div><div class="ch-title">Licenciamiento Microsoft 365</div><div class="ch-sub">Dashboard, asignaciones, alertas y uso de aplicaciones</div></div>
        <div class="ch-actions"><a href="/licencias/panel" style="display:flex;align-items:center;gap:6px;padding:6px 14px;border-radius:var(--radius-sm);background:var(--primary);color:#fff;font-size:12px;font-weight:700;"><i class="bi bi-box-arrow-up-right"></i> Ir al panel</a></div>
      </div>
      <div class="content-body"><div class="hub-grid">
        <a href="/licencias/panel" class="hub-card hc-green">
          <div class="hub-card-icon"><i class="bi bi-grid-1x2-fill"></i></div>
          <div class="hub-card-name">Dashboard M365</div>
          <div class="hub-card-desc">KPIs generales de licencias, consumo por servicio y estado global de asignaciones.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
        <a href="/licencias/panel?tab=asignaciones" class="hub-card hc-cyan">
          <div class="hub-card-icon"><i class="bi bi-person-badge-fill"></i></div>
          <div class="hub-card-name">Asignaciones</div>
          <div class="hub-card-desc">Gestiona la asignación y revocación de licencias M365 por usuario o grupo.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
        <a href="/licencias/panel?tab=alertas" class="hub-card hc-amber">
          <div class="hub-card-icon"><i class="bi bi-bell-fill"></i></div>
          <div class="hub-card-name">Alertas</div>
          <div class="hub-card-desc">Licencias próximas a vencer, sin asignar o con consumo anómalo que requieren atención.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
        <a href="/licencias/panel?tab=usoapps" class="hub-card hc-blue">
          <div class="hub-card-icon"><i class="bi bi-graph-up-arrow"></i></div>
          <div class="hub-card-name">Uso de Aplicaciones</div>
          <div class="hub-card-desc">Estadísticas de actividad y adopción por servicio: Teams, Exchange, SharePoint, OneDrive.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
        <a href="/licencias/panel?tab=tendencias" class="hub-card hc-purple">
          <div class="hub-card-icon"><i class="bi bi-bar-chart-fill"></i></div>
          <div class="hub-card-name">Tendencias 30d</div>
          <div class="hub-card-desc">Evolución de usuarios activos en los últimos 30 días por servicio de Microsoft 365.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
      </div></div>
    </div>

    <!-- SOFTWARE -->
    <div class="hub-panel" id="panel-soft">
      <div class="content-header"><div><div class="ch-title">Licencias de Software</div><div class="ch-sub">Inventario de licencias de software corporativo</div></div></div>
      <div class="content-body"><div class="hub-grid">
        <div class="hub-card hc-amber disabled">
          <div class="hub-card-icon"><i class="bi bi-collection-fill"></i></div>
          <div class="hub-card-name">Catálogo de Software</div>
          <div class="hub-card-desc">Inventario de licencias de software instaladas en los equipos del parque TI.</div>
          <span class="hub-card-soon">PRÓXIMAMENTE</span>
        </div>
        <div class="hub-card hc-indigo disabled">
          <div class="hub-card-icon"><i class="bi bi-calendar-check-fill"></i></div>
          <div class="hub-card-name">Vencimientos</div>
          <div class="hub-card-desc">Control de fechas de expiración y renovación de licencias de software por contrato.</div>
          <span class="hub-card-soon">PRÓXIMAMENTE</span>
        </div>
      </div></div>
    </div>

  </div>
</div>

<script>
(function(){const t=localStorage.getItem('dashboardTheme')||'light';document.documentElement.setAttribute('data-theme',t);_sy(t);})();
function toggleTheme(){const n=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark';document.documentElement.setAttribute('data-theme',n);localStorage.setItem('dashboardTheme',n);_sy(n);}
function _sy(t){const d=t==='dark';['navThemeIcon','sbThemeIcon'].forEach(id=>{const el=document.getElementById(id);if(el)el.className=d?'bi bi-sun-fill':'bi bi-moon-stars-fill';});}
let _c=localStorage.getItem('licSbCol')==='1';
function toggleSidebar(){const sb=document.getElementById('sidebar');if(window.innerWidth<=768){sb.classList.toggle('mobile-open');document.getElementById('sbOverlay').classList.toggle('visible',sb.classList.contains('mobile-open'));}else{_c=!_c;sb.classList.toggle('collapsed',_c);localStorage.setItem('licSbCol',_c?'1':'0');}}
function closeSidebarMobile(){document.getElementById('sidebar').classList.remove('mobile-open');document.getElementById('sbOverlay').classList.remove('visible');}
function showPanel(n,btn){document.querySelectorAll('.hub-panel').forEach(p=>p.classList.remove('active'));document.querySelectorAll('.sb-item[id^="sb-"]').forEach(b=>b.classList.remove('active'));document.getElementById('panel-'+n).classList.add('active');document.getElementById('sb-'+n).classList.add('active');if(window.innerWidth<=768)closeSidebarMobile();}
(function(){if(_c)document.getElementById('sidebar').classList.add('collapsed');const tab=new URLSearchParams(location.search).get('tab');if(tab==='soft'){const btn=document.getElementById('sb-soft');if(btn)showPanel('soft',btn);}})();
</script>
</body>
</html>
