<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/core/api.js"></script>
<script src="/js/licenses-dashboard.js"></script>
<script>
function toggleTheme(){
  const h=document.documentElement, n=h.getAttribute('data-theme')==='dark'?'light':'dark';
  h.setAttribute('data-theme',n); localStorage.setItem('dashboardTheme',n); _syncThemeUI(n);
}
function _syncThemeUI(t){
  const icon=document.getElementById('themeIcon'), lbl=document.getElementById('themeLabel'),
        track=document.getElementById('themeTrack'), knob=document.getElementById('themeKnob');
  if(!icon) return;
  const dark = t==='dark';
  icon.className = dark ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
  if(lbl)   lbl.textContent  = dark ? 'Claro'  : 'Oscuro';
  if(track) track.style.background = dark ? '#3b82f6' : '#cbd5e1';
  if(knob)  knob.style.transform   = dark ? 'translateX(15px)' : 'translateX(0)';
}
document.addEventListener('DOMContentLoaded', function(){
  _syncThemeUI(localStorage.getItem('dashboardTheme')||'light');
  const _t = new URLSearchParams(location.search).get('tab');
  if(_t){ const _b = document.querySelector('.tab-btn[onclick*="\''+_t+'\'"]'); if(_b) _b.click(); }
});
</script>
