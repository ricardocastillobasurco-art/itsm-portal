<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<script>(function(){document.documentElement.setAttribute('data-theme',localStorage.getItem('dashboardTheme')||'light');})();</script>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Colaboradores · IT Platform</title>
<%- include('../../../../shared/partials/admin/hub-styles') %>
</head>
<body>
<%
  const _u=user||{};const _n=_u.full_name||_u.name||_u.email||'Usuario';
  const _p=_n.trim().split(/\s+/);const _i=(_p[0]?.[0]||'U').toUpperCase()+(_p[1]?.[0]||'').toUpperCase();
%>
<nav class="navbar">
  <button class="nav-hamburger" onclick="toggleSidebar()"><i class="bi bi-layout-sidebar"></i></button>
  <div class="nav-brand">
    <img src="/images/movistar-logo.png" alt="" class="nav-logo" onerror="this.style.display='none'">
    <span class="nav-divider"></span>
    <span class="nav-name">IT Platform</span>
    <span class="nav-badge" style="background:linear-gradient(135deg,#4338ca,#6366f1);">USUARIOS</span>
  </div>
  <div class="nav-breadcrumb">
    <span class="sep">·</span>
    <a href="/administracion"><i class="bi bi-shield-lock-fill" style="color:#7c3aed;font-size:10px;"></i> Admin</a>
    <span class="sep">/</span>
    <span class="cur"><i class="bi bi-people-fill"></i> Colaboradores</span>
  </div>
  <div class="nav-space"></div>
  <button class="nav-icon-btn" onclick="toggleTheme()"><i class="bi bi-moon-stars-fill" id="navThemeIcon"></i></button>
  <div class="nav-user"><div class="nav-avatar"><%= _i %></div><span class="nav-username"><%= _p[0] %></span></div>
  <a href="/api/auth/logout" class="nav-exit"><i class="bi bi-box-arrow-right"></i> Salir</a>
</nav>

<div class="app-shell">
  <div class="sidebar" id="sidebar">
    <div class="sb-header">
      <div class="sb-icon-box" style="background:linear-gradient(135deg,#4338ca,#6366f1);"><i class="bi bi-people-fill"></i></div>
      <div class="sb-brand"><div class="sb-brand-name">Colaboradores</div><div class="sb-brand-sub">Gestión de Usuarios</div></div>
    </div>
    <nav class="sb-nav">
      <a class="sb-item" href="/administracion"><i class="bi bi-arrow-left-circle sb-icon" style="color:var(--muted-2);"></i><span class="sb-label">← Administración</span></a>
      <div class="sb-divider"></div>
      <span class="sb-section-label">Directorio</span>
      <button class="sb-item active" id="sb-emp" onclick="showPanel('emp',this)"><i class="bi bi-person-badge-fill sb-icon" style="color:#4338ca;"></i><span class="sb-label">Empleados</span></button>
      <button class="sb-item" id="sb-ad" onclick="showPanel('ad',this)"><i class="bi bi-microsoft sb-icon" style="color:#2563eb;"></i><span class="sb-label">Directorio AD</span></button>
    </nav>
    <div class="sb-footer">
      <div class="sb-user-av"><%= _i %></div>
      <div class="sb-user-info"><div class="sb-user-name"><%= _n %></div><div class="sb-user-role"><%= _u.role||'agente' %></div></div>
      <button class="sb-theme-btn" onclick="toggleTheme()"><i class="bi bi-moon-stars-fill" id="sbThemeIcon"></i></button>
    </div>
  </div>
  <div class="sb-overlay" id="sbOverlay" onclick="closeSidebarMobile()"></div>

  <div class="content-area">

    <!-- EMPLEADOS -->
    <div class="hub-panel active" id="panel-emp">
      <div class="content-header">
        <div><div class="ch-title">Gestión de Empleados</div><div class="ch-sub">Directorio y asignaciones de activos por colaborador</div></div>
        <div class="ch-actions"><a href="/colaboradores/panel" style="display:flex;align-items:center;gap:6px;padding:6px 14px;border-radius:var(--radius-sm);background:var(--primary);color:#fff;font-size:12px;font-weight:700;"><i class="bi bi-box-arrow-up-right"></i> Ir al panel</a></div>
      </div>
      <div class="content-body"><div class="hub-grid">
        <a href="/colaboradores/panel" class="hub-card hc-indigo">
          <div class="hub-card-icon"><i class="bi bi-person-badge-fill"></i></div>
          <div class="hub-card-name">Directorio de Empleados</div>
          <div class="hub-card-desc">Listado completo de colaboradores activos con datos de contacto, cargo y área.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
        <a href="/colaboradores/panel?tab=asg" class="hub-card hc-blue">
          <div class="hub-card-icon"><i class="bi bi-clipboard-check-fill"></i></div>
          <div class="hub-card-name">Asignaciones</div>
          <div class="hub-card-desc">Equipos e inventario asignado a cada colaborador. Alta, baja y transferencia de activos.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
      </div></div>
    </div>

    <!-- DIRECTORIO AD -->
    <div class="hub-panel" id="panel-ad">
      <div class="content-header">
        <div><div class="ch-title">Directorio Active Directory / Entra ID</div><div class="ch-sub">Usuarios Azure AD, MFA, inicios de sesión y auditoría</div></div>
      </div>
      <div class="content-body"><div class="hub-grid">
        <a href="/colaboradores/panel?tab=entra" class="hub-card hc-blue">
          <div class="hub-card-icon"><i class="bi bi-microsoft"></i></div>
          <div class="hub-card-name">Usuarios Entra ID</div>
          <div class="hub-card-desc">Directorio de usuarios sincronizados con Azure Active Directory. Licencias y estado de cuenta.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
        <a href="/colaboradores/panel?tab=mfa" class="hub-card hc-purple">
          <div class="hub-card-icon"><i class="bi bi-shield-lock-fill"></i></div>
          <div class="hub-card-name">Seguridad MFA</div>
          <div class="hub-card-desc">Estado de autenticación multifactor por usuario. Métodos registrados y cobertura MFA.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
        <a href="/colaboradores/panel?tab=signins" class="hub-card hc-cyan">
          <div class="hub-card-icon"><i class="bi bi-box-arrow-in-right"></i></div>
          <div class="hub-card-name">Inicios de Sesión</div>
          <div class="hub-card-desc">Registros de acceso al sistema: usuarios, apps, ubicaciones, riesgo y estado de inicio.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
        <a href="/colaboradores/panel?tab=auditlog" class="hub-card hc-indigo">
          <div class="hub-card-icon"><i class="bi bi-journal-text"></i></div>
          <div class="hub-card-name">Auditoría de Directorio</div>
          <div class="hub-card-desc">Historial de cambios en el directorio corporativo: altas, bajas, modificaciones y eventos.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
      </div></div>
    </div>

  </div>
</div>

<script>
(function(){const t=localStorage.getItem('dashboardTheme')||'light';document.documentElement.setAttribute('data-theme',t);_sy(t);})();
function toggleTheme(){const n=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark';document.documentElement.setAttribute('data-theme',n);localStorage.setItem('dashboardTheme',n);_sy(n);}
function _sy(t){const d=t==='dark';['navThemeIcon','sbThemeIcon'].forEach(id=>{const el=document.getElementById(id);if(el)el.className=d?'bi bi-sun-fill':'bi bi-moon-stars-fill';});}
let _c=localStorage.getItem('colabSbCol')==='1';
function toggleSidebar(){const sb=document.getElementById('sidebar');if(window.innerWidth<=768){sb.classList.toggle('mobile-open');document.getElementById('sbOverlay').classList.toggle('visible',sb.classList.contains('mobile-open'));}else{_c=!_c;sb.classList.toggle('collapsed',_c);localStorage.setItem('colabSbCol',_c?'1':'0');}}
function closeSidebarMobile(){document.getElementById('sidebar').classList.remove('mobile-open');document.getElementById('sbOverlay').classList.remove('visible');}
function showPanel(n,btn){document.querySelectorAll('.hub-panel').forEach(p=>p.classList.remove('active'));document.querySelectorAll('.sb-item[id^="sb-"]').forEach(b=>b.classList.remove('active'));document.getElementById('panel-'+n).classList.add('active');document.getElementById('sb-'+n).classList.add('active');if(window.innerWidth<=768)closeSidebarMobile();}
(function(){if(_c)document.getElementById('sidebar').classList.add('collapsed');const tab=new URLSearchParams(location.search).get('tab');if(tab==='ad'){const btn=document.getElementById('sb-ad');if(btn)showPanel('ad',btn);}})();
</script>
</body>
</html>
