function renderFaqTable(list){
  const tbody = document.getElementById('faqTableBody');
  if(!list.length){ tbody.innerHTML='<tr><td colspan="6"><div class="empty-state"><i class="bi bi-patch-question"></i><p>No hay preguntas</p></div></td></tr>'; return; }
  tbody.innerHTML = list.map(f => {
    const isVisible = f.visible === undefined ? true : !!f.visible;
    const stCls = isVisible ? 'art-status-pub' : 'art-status-hidden';
    const stLbl = isVisible ? '<i class="bi bi-eye-fill"></i> Visible' : '<i class="bi bi-eye-slash-fill"></i> Oculto';
    return `<tr>
      <td style="max-width:300px;"><strong style="font-size:13px;">${f.question||f.pregunta||''}</strong></td>
      <td style="font-size:12px;color:var(--text-muted);">${f.category||f.categoria||'—'}</td>
      <td><span class="art-status ${stCls}" style="font-size:10px;">${stLbl}</span></td>
      <td style="font-size:12px;text-align:center;">${f.order_num||f.orden||0}</td>
      <td style="font-size:12px;">${f.views||0}</td>
      <td>
        <button class="art-action-btn" onclick="editFaqItem(${f.id})"><i class="bi bi-pencil-fill"></i> Editar</button>
        <button class="art-action-btn" onclick="toggleFaqVisible(${f.id},${isVisible?0:1},this)">${isVisible?'Ocultar':'Mostrar'}</button>
        <button class="art-action-btn danger" onclick="deleteFaq(${f.id},this)"><i class="bi bi-trash3-fill"></i></button>
      </td>
    </tr>`;
  }).join('');
}
function _populateFaqCatFilter(){
  const sel = document.getElementById('faqCatFilter');
  const cats = [...new Set(_faqAll.map(f => f.category||f.categoria).filter(Boolean))];
  sel.innerHTML = '<option value="">Todas las categorías</option>' + cats.map(c => `<option value="${c}">${c}</option>`).join('');
}
function filterFaqs(){
  const q = document.getElementById('faqSearchInput').value.toLowerCase();
  const cat = document.getElementById('faqCatFilter').value;
  renderFaqTable(_faqAll.filter(f => {
    const matchQ = !q || (f.question||f.pregunta||'').toLowerCase().includes(q) || (f.answer||f.respuesta||'').toLowerCase().includes(q);
    const matchC = !cat || (f.category||f.categoria) === cat;
    return matchQ && matchC;
  }));
}
function setFaqFilter(btn, val){
  document.querySelectorAll('#faq-gestion .panel-filter[data-filter]').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
}
async function editFaqItem(id){
  const f = _faqAll.find(x=>x.id===id) || {};
  document.getElementById('edit-faq-id').value = id;
  document.getElementById('edit-faq-cat').value = f.category||f.categoria||'';
  document.getElementById('edit-faq-order').value = f.order_num||f.orden||0;
  document.getElementById('edit-faq-visible').value = (f.visible===undefined||f.visible===null||f.visible==1) ? '1' : '0';
  document.getElementById('edit-faq-question').value = f.question||f.pregunta||'';
  document.getElementById('edit-faq-answer').value = f.answer||f.respuesta||'';
  openModal('modalEditFAQ');
}
async function updateFAQ(){
  const id = document.getElementById('edit-faq-id').value;
  const body = {
    category: document.getElementById('edit-faq-cat').value.trim(),
    order_num: parseInt(document.getElementById('edit-faq-order').value)||0,
    visible: parseInt(document.getElementById('edit-faq-visible').value),
    question: document.getElementById('edit-faq-question').value.trim(),
    answer: document.getElementById('edit-faq-answer').value.trim()
  };
  const btn = event.target; btn.disabled=true;
  try {
    const r = await fetch(`/api/faq/${id}`, {method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    const d = await r.json();
    if(d.success||d.data||r.ok){ toast('Pregunta actualizada'); closeModal('modalEditFAQ'); loadFaqList(); }
    else toast(d.error||'Error','err');
  } catch(e){ toast('Error de conexión','err'); }
  finally{ btn.disabled=false; }
}
async function toggleFaqVisible(id, val, btn){
  if(btn) btn.disabled=true;
  try {
    const r = await fetch(`/api/faq/${id}`, {method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({visible:val})});
    if(r.ok){
      const item = _faqAll.find(f=>f.id===id);
      if(item) item.visible = val;
      toast(val?'Pregunta visible':'Pregunta oculta');
      renderFaqTable(_faqAll);
    } else toast('Error','err');
  } catch(e){ toast('Error','err'); }
  finally{ if(btn) btn.disabled=false; }
}
async function deleteFaq(id, btn){
  if(!confirm('¿Eliminar esta pregunta?')) return;
  try {
    const r = await fetch(`/api/faq/${id}`, {method:'DELETE',credentials:'include'});
    if(r.ok){ toast('Pregunta eliminada'); loadFaqList(); }
    else toast('Error al eliminar','err');
  } catch(e){ toast('Error','err'); }
}

/* ── SOLICITUDES FAQ ─────────────────────────────────────────────────────────
 * Las preguntas del usuario vienen de portal_user_questions via GET /api/portal/questions
 * Status: 'pending' | 'answered' | 'published'
 * Publicar: PUT /api/portal/questions/:id {answer,category} → POST /api/portal/questions/:id/publish
 * ─────────────────────────────────────────────────────────────────────────── */
let _faqSolMap = {};
let _faqSolAll = [];
let _faqSolFilter = 'pending';

async function loadFaqSolicitudes(){
  const grid = document.getElementById('faqSolicitudesGrid');
  grid.innerHTML='<div style="grid-column:1/-1"><div class="empty-state"><i class="bi bi-arrow-clockwise"></i><p>Cargando...</p></div></div>';
  try {
    const r = await fetch('/api/portal/questions', {credentials:'include'});
    const d = await r.json();
    _faqSolAll = d.data || [];
    _faqSolMap = {};
    _faqSolAll.forEach(s => { _faqSolMap[s.id] = s; });
    renderFaqSolicitudes();
  } catch(e){ grid.innerHTML='<div style="grid-column:1/-1"><div class="empty-state"><i class="bi bi-wifi-off"></i><p>Error al cargar solicitudes</p></div></div>'; }
}

function setFaqSolFilter(f, btn){
  _faqSolFilter = f;
  document.querySelectorAll('#faq-solicitudes .panel-filter').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  renderFaqSolicitudes();
}

function filterFaqSolicitudes(q){ renderFaqSolicitudes(q); }

function renderFaqSolicitudes(searchQ){
  const grid = document.getElementById('faqSolicitudesGrid');
  const q = (searchQ ?? document.getElementById('faqSolSearch')?.value ?? '').toLowerCase();
  let list = _faqSolAll;
  if(_faqSolFilter !== 'all') list = list.filter(s => (s.status||'pending') === _faqSolFilter);
  if(q) list = list.filter(s => (s.question||'').toLowerCase().includes(q)||(s.name||'').toLowerCase().includes(q)||(s.email||'').toLowerCase().includes(q));
  if(!list.length){
    const labels = {pending:'pendientes',answered:'respondidas',published:'publicadas',all:''};
    grid.innerHTML=`<div style="grid-column:1/-1"><div class="empty-state"><i class="bi bi-chat-left-x"></i><p>No hay solicitudes${labels[_faqSolFilter]?' '+labels[_faqSolFilter]:''}</p></div></div>`;
    return;
  }
  const colors = ['#3b82f6','#7c3aed','#0891b2','#059669','#d97706'];
  const stBadge = st => st==='published'?'sol-badge-accepted':st==='answered'?'sol-badge-pending':'sol-badge-pending';
  const stLabel = st => st==='published'?'Publicada':st==='answered'?'Respondida':'Pendiente';
  grid.innerHTML = list.map(s => {
    const ini = (s.name||s.email||'?').charAt(0).toUpperCase();
    const col = colors[ini.charCodeAt(0)%colors.length];
    const isPend = (s.status||'pending') === 'pending';
    return `<div class="sol-card" id="sol-faq-${s.id}">
      <div class="sol-card-header">
        <div class="sol-avatar" style="background:${col};">${ini}</div>
        <div>
          <div class="sol-user-name">${s.name||'Anónimo'}</div>
          <div class="sol-user-email">${s.email||''} · ${_fmtDate(s.created_at)}</div>
        </div>
      </div>
      <div class="sol-card-body"><strong>${s.question||''}</strong>${s.category?`<br><span style="font-size:11px;color:var(--text-muted);">Categoría: ${s.category}</span>`:''}</div>
      <div class="sol-card-footer">
        <span class="sol-badge ${stBadge(s.status)}">${stLabel(s.status)}</span>
        ${isPend?`
        <button class="sol-action sol-action-accept" onclick="openPublishFaqResp(${s.id})"><i class="bi bi-patch-plus-fill"></i> Publicar respuesta</button>
        <button class="sol-action sol-action-reject" onclick="handleFaqReq(${s.id},this)"><i class="bi bi-x-lg"></i> Descartar</button>`:''}
      </div>
    </div>`;
  }).join('');
}

function openPublishFaqResp(reqId){
  const s = _faqSolMap[reqId] || {};
  document.getElementById('faqRespReqId').value      = reqId;
  document.getElementById('faqResp-question').value  = s.question || '';
  document.getElementById('faqResp-answer').value    = '';
  document.getElementById('faqResp-category').value  = s.category || 'General';
  document.getElementById('faqResp-order').value     = '0';
  document.getElementById('faqRespSolicitante').textContent = s.name ? `Solicitado por: ${s.name} — ${s.email||''}` : (s.email||'');
  openModal('modalPublishFaqResp');
}

async function submitPublishFaqResp(btn){
  const reqId    = document.getElementById('faqRespReqId').value;
  const category = document.getElementById('faqResp-category').value.trim();
  const question = document.getElementById('faqResp-question').value.trim();
  const answer   = document.getElementById('faqResp-answer').value.trim();
  if(!category||!question||!answer){ toast('Completa todos los campos requeridos','err'); return; }
  const origHtml = btn.innerHTML;
  btn.disabled=true; btn.innerHTML='<i class="bi bi-hourglass-split"></i> Publicando…';
  try {
    // 1. Guardar respuesta en el registro
    const rPut = await fetch(`/api/portal/questions/${reqId}`, {method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({answer,category})});
    const dPut = await rPut.json();
    if(!rPut.ok){ toast(dPut.error||'Error al guardar respuesta','err'); return; }
    // 2. Publicar como FAQ
    const rPub = await fetch(`/api/portal/questions/${reqId}/publish`, {method:'POST',credentials:'include'});
    const dPub = await rPub.json();
    if(!rPub.ok){ toast(dPub.error||'Error al publicar','err'); return; }
    const item = _faqSolMap[reqId];
    if(item){ item.status='published'; item.answer=answer; }
    toast('Pregunta publicada en FAQ y solicitud resuelta');
    closeModal('modalPublishFaqResp');
    renderFaqSolicitudes();
  } catch(e){ toast('Error de conexión','err'); }
  finally{ btn.disabled=false; btn.innerHTML=origHtml; }
}

async function handleFaqReq(id, btn){
  if(!confirm('¿Descartar esta solicitud?')) return;
  btn.disabled=true;
  try {
    const r = await fetch(`/api/portal/questions/${id}`, {method:'DELETE',credentials:'include'});
    if(r.ok){
      toast('Solicitud descartada');
      _faqSolAll = _faqSolAll.filter(s=>s.id!==id);
      delete _faqSolMap[id];
      renderFaqSolicitudes();
    } else toast('Error al actualizar','err');
  } catch(e){ toast('Sin conexión','err'); }
  finally{ btn.disabled=false; }
}

/* ── DEEP LINK ──────────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', function(){
  const p = new URLSearchParams(location.search);
  const tab = p.get('tab');
  if(tab){ const btn=document.getElementById('tb-'+tab); if(btn) switchTab(tab,btn); }
  const sec = p.get('sec');
  if(sec){ const cur = tab||'kb'; setTimeout(()=>{ if(cur==='kb') showKbSection(sec,null); else showFaqSection(sec,null); }, 50); }
  loadKbData();
});

function loadKbData(){ /* carga lazy solo cuando se necesita */ }
function loadFaqData(){ loadFaqList(); }
</script>
