    <thead><tr>
      <th>Recurso</th><th>Categoría</th><th>Tipo</th><th>Estado</th><th>Fecha</th><th style="min-width:260px;">Acciones</th>
    </tr></thead>
    <tbody>
    ${list.map(a=>`<tr id="aporte-row-${a.id}">
      <td>
        <div class="aporte-title">${a.title||'Sin título'}</div>
        <div class="aporte-author"><i class="bi bi-person-fill"></i> ${a.author||'Usuario'}</div>
      </td>
      <td><span style="font-size:11px;background:var(--bg-main);padding:3px 8px;border-radius:7px;color:var(--text-muted);font-weight:600;">${a.category||'general'}</span></td>
      <td><span class="aporte-type-badge ${typeCls(a.content_type)}">${typeIcon(a.content_type)} ${a.content_type||'url'}</span></td>
      <td><span class="aporte-status-badge ${stCls(a.status||'publicado')}">${stLabel(a.status||'publicado')}</span></td>
      <td style="font-size:11px;color:var(--text-muted);white-space:nowrap;">${_fmtDate(a.created_at)}</td>
      <td>
        <div class="aporte-actions">
          <button class="aporte-btn" onclick="viewAporteById(${a.id})"><i class="bi bi-eye"></i> Ver</button>
          ${(a.status||'publicado')==='pendiente'?`
          <button class="aporte-btn approve" id="ab-approve-${a.id}" onclick="handleLearningStatus(${a.id},'publicado',this)"><i class="bi bi-check-lg"></i> Aprobar</button>
          <button class="aporte-btn deny" id="ab-deny-${a.id}" onclick="handleLearningStatus(${a.id},'rechazado',this)"><i class="bi bi-x-lg"></i> Denegar</button>`:''}
          <button class="aporte-btn" onclick="openRespAporte(${a.id},'${(a.author||'').replace(/'/g,"&#39;")}')"><i class="bi bi-reply"></i> Responder</button>
        </div>
