  openModal('modalViewFaqAporte');
}

async function handleFaqAporteStatus(id, status, btn){
  if(btn) btn.disabled=true;
  try {
    let r, d;
    if(status === 'rejected'){
      r = await fetch(`/api/portal/contributions/${id}`, {method:'DELETE',credentials:'include'});
      d = await r.json();
    } else {
      r = await fetch(`/api/portal/contributions/${id}`, {method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:'approved'})});
      d = await r.json();
    }
    if(r.ok){
      toast(status==='approved'?'Aporte aprobado y publicado':'Aporte rechazado');
      if(status==='rejected'){
        _faqAportesData = _faqAportesData.filter(a=>a.id!==id);
      } else {
        const item = _faqAportesData.find(a=>a.id===id);
        if(item) item.status = 'approved';
      }
      renderFaqAportesTable();
    } else toast(d?.error||'Error','err');
  } catch(e){ toast('Sin conexión','err'); }
  finally{ if(btn) btn.disabled=false; }
}

