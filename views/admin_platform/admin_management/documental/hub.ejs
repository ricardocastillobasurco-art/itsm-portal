  }
  const typeIcon = t => t==='pdf'?'<i class="bi bi-file-earmark-pdf-fill"></i>':t==='video'?'<i class="bi bi-play-circle-fill"></i>':t==='text'?'<i class="bi bi-file-text"></i>':'<i class="bi bi-link-45deg"></i>';
  const typeCls  = t => t==='pdf'?'aporte-type-pdf':t==='video'?'aporte-type-video':t==='text'?'aporte-type-text':'aporte-type-url';
  const stCls    = s => s==='publicado'?'aporte-status-publicado':s==='rechazado'?'aporte-status-rechazado':'aporte-status-pendiente';
  const stLabel  = s => s==='publicado'?'<i class="bi bi-check-circle-fill"></i> Aprobado':s==='rechazado'?'<i class="bi bi-x-circle-fill"></i> Rechazado':'<i class="bi bi-clock-fill"></i> Pendiente';
