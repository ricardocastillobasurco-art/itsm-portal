<!DOCTYPE html>
<html lang="es">
<head>
<script>(function(){document.documentElement.setAttribute('data-theme',localStorage.getItem('dashboardTheme')||'light');})();</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gestión Documental · IT Platform</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<%- include('../../../shared/partials/autogestion/styles') %>
<style>
.sub-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;width:100%;max-width:1040px;}
@media(max-width:740px){.sub-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:460px){.sub-grid{grid-template-columns:1fr;}}
.back-btn{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:var(--text-muted);background:var(--bg-card);border:1px solid var(--border-soft);border-radius:20px;padding:6px 14px;text-decoration:none;box-shadow:var(--shadow-card);transition:color .2s;margin-bottom:6px;}
.back-btn:hover{color:var(--primary);}

/* ── Panel de gestión inline ──────────────────────────────────────── */
.mgmt-panel{display:none;width:100%;max-width:1040px;animation:fadeIn .25s ease;}
.mgmt-panel.active{display:block;}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* Filtros / toolbar */
.panel-toolbar{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap;}
.panel-search{flex:1;min-width:200px;border:1.5px solid var(--border-soft);border-radius:10px;padding:8px 14px;font-size:13px;background:var(--bg-card);color:var(--text-main);outline:none;font-family:inherit;}
.panel-search:focus{border-color:var(--primary);}
.panel-filter{padding:8px 14px;border:1.5px solid var(--border-soft);border-radius:10px;font-size:12px;font-weight:600;background:var(--bg-card);color:var(--text-muted);cursor:pointer;transition:all .18s;}
.panel-filter.active,.panel-filter:hover{border-color:var(--primary);color:var(--primary);background:rgba(59,130,246,.06);}
.panel-btn-new{display:inline-flex;align-items:center;gap:6px;padding:8px 18px;border-radius:10px;background:var(--primary);color:#fff;font-size:12px;font-weight:700;border:none;cursor:pointer;transition:opacity .18s;white-space:nowrap;}
.panel-btn-new:hover{opacity:.88;}

/* Tabla de artículos */
.articles-table{width:100%;border-collapse:collapse;}
.articles-table th{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--text-muted);padding:8px 14px;border-bottom:2px solid var(--border-soft);text-align:left;}
.articles-table td{padding:11px 14px;border-bottom:1px solid var(--border-soft);font-size:13px;color:var(--text-main);vertical-align:middle;}
.articles-table tr:hover td{background:rgba(59,130,246,.03);}
.art-status{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:700;}
.art-status-pub{background:#d1fae5;color:#059669;}
.art-status-draft{background:#fef3c7;color:#92400e;}
.art-status-rev{background:#dbeafe;color:#1d4ed8;}
.art-status-hidden{background:#f1f5f9;color:#64748b;}
.art-action-btn{padding:4px 10px;border-radius:7px;border:1.5px solid var(--border-soft);background:transparent;font-size:11px;font-weight:700;cursor:pointer;color:var(--text-muted);transition:all .15s;margin-right:4px;}
.art-action-btn:hover{border-color:var(--primary);color:var(--primary);}
.art-action-btn.danger:hover{border-color:#ef4444;color:#ef4444;}

/* Solicitudes / aportes cards */
.sol-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;}
@media(max-width:640px){.sol-grid{grid-template-columns:1fr;}}
.sol-card{background:var(--bg-card);border:1px solid var(--border-soft);border-radius:14px;padding:16px;transition:box-shadow .2s,transform .15s;}
.sol-card:hover{box-shadow:0 6px 20px rgba(0,0,0,.09);transform:translateY(-2px);}
.sol-card-header{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
.sol-avatar{width:38px;height:38px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;color:#fff;}
.sol-user-name{font-size:13px;font-weight:700;color:var(--text-main);}
.sol-user-email{font-size:11px;color:var(--text-muted);}
.sol-card-body{font-size:12.5px;color:var(--text-main);line-height:1.55;margin-bottom:10px;}
.sol-card-footer{display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
.sol-badge{display:inline-block;padding:3px 9px;border-radius:10px;font-size:10px;font-weight:700;}
.sol-badge-pending{background:#fef3c7;color:#92400e;}
.sol-badge-accepted{background:#d1fae5;color:#059669;}
.sol-badge-rejected{background:#fee2e2;color:#b91c1c;}
.sol-action{padding:5px 12px;border-radius:8px;border:none;font-size:11px;font-weight:700;cursor:pointer;transition:all .15s;}
.sol-action-accept{background:#d1fae5;color:#059669;}.sol-action-accept:hover{background:#a7f3d0;}
.sol-action-reject{background:#fee2e2;color:#dc2626;}.sol-action-reject:hover{background:#fca5a5;}

/* Modal de publicar/editar */
.doc-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;display:none;align-items:center;justify-content:center;padding:16px;}
.doc-modal-overlay.open{display:flex;}
.doc-modal{background:var(--bg-card);border-radius:18px;padding:28px;width:100%;max-width:600px;box-shadow:0 24px 60px rgba(0,0,0,.25);position:relative;max-height:90vh;overflow-y:auto;}
.doc-modal h3{font-size:16px;font-weight:800;color:var(--text-main);margin:0 0 20px;display:flex;align-items:center;gap:9px;}
.doc-modal-close{position:absolute;top:14px;right:16px;background:none;border:none;font-size:18px;cursor:pointer;color:var(--text-muted);}
.doc-modal-close:hover{color:var(--text-main);}
.fm-row{margin-bottom:14px;}
.fm-row label{display:block;font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px;}
.fm-row input,.fm-row select,.fm-row textarea{width:100%;border:1.5px solid var(--border-soft);border-radius:10px;padding:9px 12px;font-size:13px;background:var(--bg-main);color:var(--text-main);outline:none;font-family:inherit;transition:border-color .2s;box-sizing:border-box;}
.fm-row input:focus,.fm-row select:focus,.fm-row textarea:focus{border-color:var(--primary);}
.fm-row textarea{resize:vertical;min-height:90px;}
.fm-row-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.fm-footer{display:flex;gap:10px;justify-content:flex-end;margin-top:20px;}
.btn-cancel{padding:9px 20px;border-radius:10px;background:var(--bg-main);color:var(--text-muted);border:1.5px solid var(--border-soft);font-size:13px;font-weight:700;cursor:pointer;}
.btn-submit-purp{padding:9px 22px;border-radius:10px;background:linear-gradient(135deg,#7c3aed,#6d28d9);color:#fff;border:none;font-size:13px;font-weight:700;cursor:pointer;}
.btn-submit-cyan{padding:9px 22px;border-radius:10px;background:linear-gradient(135deg,#0891b2,#0e7490);color:#fff;border:none;font-size:13px;font-weight:700;cursor:pointer;}
.btn-submit-purp:hover,.btn-submit-cyan:hover{opacity:.88;}

/* Empty state */
.empty-state{padding:40px 20px;text-align:center;color:var(--text-muted);}
.empty-state i{font-size:40px;opacity:.3;margin-bottom:12px;display:block;}
.empty-state p{font-size:13px;}

/* Tabla aportes */
.aportes-table-wrap{overflow-x:auto;border:1px solid var(--border-soft);border-radius:12px;background:var(--bg-card);}
.aportes-table{width:100%;border-collapse:collapse;font-size:13px;}
.aportes-table thead th{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--text-muted);padding:10px 14px;border-bottom:2px solid var(--border-soft);text-align:left;white-space:nowrap;background:var(--bg-main);}
.aportes-table tbody tr{transition:background .15s;}
.aportes-table tbody tr:hover{background:rgba(59,130,246,.04);}
.aportes-table tbody td{padding:11px 14px;border-bottom:1px solid var(--border-soft);vertical-align:middle;color:var(--text-main);}
.aportes-table tbody tr:last-child td{border-bottom:none;}
.aporte-title{font-weight:700;color:var(--text-main);}
.aporte-author{font-size:11px;color:var(--text-muted);}
.aporte-type-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:8px;font-size:10px;font-weight:700;}
.aporte-type-pdf{background:#fee2e2;color:#b91c1c;}
.aporte-type-url{background:#dbeafe;color:#1d4ed8;}
.aporte-type-text{background:#d1fae5;color:#065f46;}
.aporte-type-video{background:#f3e8ff;color:#7c3aed;}
.aporte-status-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-size:10px;font-weight:700;}
.aporte-status-pendiente{background:#fef3c7;color:#92400e;}
.aporte-status-publicado{background:#d1fae5;color:#059669;}
.aporte-status-rechazado{background:#fee2e2;color:#b91c1c;}
.aporte-actions{display:flex;gap:5px;flex-wrap:nowrap;}
.aporte-btn{padding:4px 10px;border-radius:7px;border:1.5px solid var(--border-soft);background:transparent;font-size:11px;font-weight:700;cursor:pointer;color:var(--text-muted);transition:all .15s;white-space:nowrap;display:inline-flex;align-items:center;gap:4px;}
.aporte-btn:hover{border-color:var(--primary);color:var(--primary);}
.aporte-btn.approve:hover{border-color:#059669;color:#059669;background:#d1fae5;}
.aporte-btn.deny:hover{border-color:#dc2626;color:#dc2626;background:#fee2e2;}
.aporte-btn:disabled{opacity:.45;cursor:not-allowed;}

/* Toast */
.doc-toast{position:fixed;bottom:28px;right:28px;z-index:99999;display:flex;align-items:center;gap:10px;padding:13px 18px;border-radius:14px;font-size:13px;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,.2);color:#fff;transform:translateY(20px);opacity:0;transition:all .3s;pointer-events:none;}
.doc-toast.show{transform:translateY(0);opacity:1;}
.doc-toast.ok{background:#059669;}.doc-toast.err{background:#dc2626;}
</style>
</head>
<body>
<style>
.hub-topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 24px;background:var(--bg-card,#fff);border-bottom:1px solid var(--border-soft,#e2e8f0);position:sticky;top:0;z-index:999;}
.hub-back{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--text-muted,#64748b);background:var(--bg-main,#f0f4f8);border:1px solid var(--border-soft,#e2e8f0);border-radius:20px;padding:5px 12px;text-decoration:none;transition:color .2s;}
.hub-back:hover{color:var(--primary,#3b82f6);}
.hub-bc{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted,#64748b);}
.hub-bc a{color:var(--text-muted,#64748b);text-decoration:none;font-weight:500;transition:color .2s;}
.hub-bc a:hover{color:var(--primary,#3b82f6);}
.hub-bc .sep{opacity:.4;}
.hub-bc .current{color:var(--text-main,#1e293b);font-weight:700;}
</style>
<div class="hub-topbar">
  <div style="display:flex;align-items:center;gap:12px;">
    <a href="/administracion" class="hub-back"><i class="bi bi-arrow-left"></i> Admin</a>
    <div class="hub-bc">
      <a href="/administracion"><i class="bi bi-shield-lock-fill"></i> Admin</a>
      <span class="sep">/</span>
      <span class="current"><i class="bi bi-journal-richtext"></i> Gestión Documental</span>
    </div>
  </div>
  <button onclick="toggleTheme()" style="display:flex;align-items:center;gap:6px;background:none;border:none;cursor:pointer;padding:4px 8px;border-radius:8px;">
    <div id="themeTrack" style="width:32px;height:18px;border-radius:9px;background:#cbd5e1;position:relative;transition:background .3s;">
      <div id="themeKnob" style="width:14px;height:14px;border-radius:50%;background:#fff;position:absolute;top:2px;left:2px;transition:transform .3s;"></div>
    </div>
    <i id="toggleIcon" class="bi bi-moon-stars-fill" style="font-size:14px;color:var(--text-muted,#64748b);"></i>
    <span id="toggleLabel" style="font-size:12px;color:var(--text-muted,#64748b);font-weight:500;">Oscuro</span>
  </button>
</div>

<%
  const _name = user ? (user.full_name || user.name || user.email || 'Admin') : 'Admin';
%>

<div class="home-wrapper">

  <!-- HERO -->
  <div class="hero">
    <div class="hero-logo">
      <div class="hero-logo-icon" style="background:linear-gradient(135deg,#7c3aed,#4f46e5);"><i class="bi bi-journal-richtext"></i></div>
      <div class="hero-logo-text">Documental · <span>GESTIÓN DE CONTENIDO</span></div>
    </div>
    <div class="hero-title">Knowledge Management · Base de Conocimiento · FAQ</div>
    <div class="hero-chip" style="background:rgba(124,58,237,.1);color:#7c3aed;border-color:rgba(124,58,237,.25);">
      <i class="bi bi-circle-fill" style="font-size:8px;color:#10b981;"></i>
      Gestión integral de contenido y conocimiento
    </div>
    <div style="margin-top:12px;display:flex;align-items:center;gap:10px;justify-content:center;flex-wrap:wrap;">
      <a href="/administracion" class="back-btn"><i class="bi bi-arrow-left"></i> Panel de administración</a>
    </div>
  </div>

  <!-- TABS NAV -->
  <div class="tabs-wrapper">
    <div class="tabs-nav">
      <button class="tab-btn active" id="tb-kb"  onclick="switchTab('kb',this)"><i class="bi bi-book-fill"></i> Base de Conocimiento</button>
      <button class="tab-btn"        id="tb-faq" onclick="switchTab('faq',this)"><i class="bi bi-patch-question-fill"></i> Preguntas Frecuentes</button>
    </div>
  </div>

  <!-- ══ TAB: BASE DE CONOCIMIENTO ══════════════════════════════════════════ -->
  <div class="tab-panel active" id="panel-kb">

    <!-- Sub-tabs KB -->
    <div style="display:flex;align-items:center;gap:6px;margin-bottom:16px;flex-wrap:wrap;" id="kb-subtabs">
      <button class="panel-filter active" onclick="showKbSection('hub',this)"><i class="bi bi-grid-1x2-fill"></i> Módulos</button>
      <button class="panel-filter" onclick="showKbSection('gestion',this)"><i class="bi bi-list-ul"></i> Gestión</button>
      <button class="panel-filter" onclick="showKbSection('solicitudes',this)"><i class="bi bi-inbox-fill"></i> Solicitudes</button>
      <button class="panel-filter" onclick="showKbSection('aportes',this)"><i class="bi bi-lightbulb-fill"></i> Aportes</button>
      <button id="kbRefreshBtn" title="Actualizar sección" onclick="refreshKbSection()" style="margin-left:auto;display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:10px;border:1.5px solid var(--border-soft);background:var(--bg-card);color:var(--text-muted);font-size:12px;font-weight:700;cursor:pointer;transition:all .2s;">
        <i class="bi bi-arrow-clockwise" id="kbRefreshIcon"></i> Actualizar
      </button>
    </div>

    <!-- KB: Hub cards -->
    <div class="mgmt-panel active" id="kb-hub">
      <div class="section-label"><i class="bi bi-book-fill"></i> &nbsp;Gestión de Base de Conocimiento</div>
      <div class="sub-grid">
        <div class="mod-card c-purp" onclick="openModal('modalKB')">
          <div class="mod-icon ib ib-purp"><i class="bi bi-plus-square-fill"></i></div>
          <div class="mod-name">Publicar Artículo</div>
          <div class="mod-desc">Crea y publica un nuevo artículo técnico, procedimiento o guía en la base de conocimiento.</div>
          <i class="bi bi-arrow-right mod-arrow"></i>
        </div>
        <div class="mod-card c-indigo" onclick="showKbSection('gestion',document.querySelector('[onclick=\"showKbSection(\'gestion\',this)\"]'))">
          <div class="mod-icon ib ib-indigo"><i class="bi bi-file-earmark-text-fill"></i></div>
          <div class="mod-name">Gestión de Artículos</div>
          <div class="mod-desc">Revisa, edita, publica o archiva todos los artículos del sistema. Control completo del contenido.</div>
          <i class="bi bi-arrow-right mod-arrow"></i>
        </div>
        <div class="mod-card c-blue" onclick="showKbSection('solicitudes',document.querySelectorAll('#kb-subtabs .panel-filter')[2])">
          <div class="mod-icon ib ib-blue"><i class="bi bi-inbox-fill"></i></div>
          <div class="mod-name">Solicitudes de Artículos</div>
          <div class="mod-desc">Revisa las solicitudes enviadas por usuarios pidiendo documentación sobre temas específicos.</div>
          <i class="bi bi-arrow-right mod-arrow"></i>
        </div>
        <div class="mod-card c-amber" onclick="showKbSection('aportes',document.querySelectorAll('#kb-subtabs .panel-filter')[3])">
          <div class="mod-icon ib ib-amber"><i class="bi bi-lightbulb-fill"></i></div>
          <div class="mod-name">Aportes de Usuarios</div>
          <div class="mod-desc">Artículos borradores enviados por colaboradores. Revísalos y apruébalos para su publicación.</div>
          <i class="bi bi-arrow-right mod-arrow"></i>
        </div>
        <a href="/knowledge-base" class="mod-card c-cyan">
          <div class="mod-icon ib ib-cyan"><i class="bi bi-eye-fill"></i></div>
          <div class="mod-name">Vista de Usuario</div>
          <div class="mod-desc">Ve cómo los colaboradores ven la base de conocimiento en el portal de autogestión.</div>
          <i class="bi bi-arrow-right mod-arrow"></i>
        </a>
      </div>
    </div>

    <!-- KB: Gestión de artículos -->
    <div class="mgmt-panel" id="kb-gestion">
      <div class="panel-toolbar">
        <input class="panel-search" placeholder="Buscar artículo..." id="kbSearchInput" oninput="filterArticles()">
        <button class="panel-filter active" data-filter="all" onclick="setKbFilter(this,'all')">Todos</button>
        <button class="panel-filter" data-filter="publicado" onclick="setKbFilter(this,'publicado')">Publicados</button>
        <button class="panel-filter" data-filter="oculto" onclick="setKbFilter(this,'oculto')">Ocultos</button>
        <button class="panel-filter" data-filter="borrador" onclick="setKbFilter(this,'borrador')">Borradores</button>
        <button class="panel-filter" data-filter="revision" onclick="setKbFilter(this,'revision')">En revisión</button>
        <button class="panel-btn-new" onclick="openModal('modalKB')"><i class="bi bi-plus-lg"></i> Nuevo artículo</button>
      </div>
      <div style="background:var(--bg-card);border:1px solid var(--border-soft);border-radius:14px;overflow:hidden;">
        <table class="articles-table">
          <thead>
            <tr>
              <th>Título</th>
              <th>Categoría</th>
              <th>Estado</th>
              <th>Vistas</th>
              <th>Última modificación</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="kbTableBody">
            <tr><td colspan="6"><div class="empty-state"><i class="bi bi-arrow-clockwise"></i><p>Cargando artículos...</p></div></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- KB: Solicitudes -->
    <div class="mgmt-panel" id="kb-solicitudes">
      <div class="panel-toolbar">
        <input class="panel-search" placeholder="Buscar solicitud..." oninput="filterSolicitudes('kb')">
        <button class="panel-filter active">Pendientes</button>
        <button class="panel-filter">Aceptadas</button>
        <button class="panel-filter">Rechazadas</button>
      </div>
      <div class="sol-grid" id="kbSolicitudesGrid">
        <div style="grid-column:1/-1"><div class="empty-state"><i class="bi bi-arrow-clockwise"></i><p>Cargando solicitudes...</p></div></div>
      </div>
    </div>

    <!-- KB: Aportes -->
    <div class="mgmt-panel" id="kb-aportes">
      <div class="panel-toolbar">
        <input class="panel-search" id="aportesSearch" placeholder="Buscar aporte..." oninput="filterAportesTable(this.value)">
        <button class="panel-filter active" onclick="setAportesFilter('pendiente',this)">Pendientes</button>
        <button class="panel-filter" onclick="setAportesFilter('publicado',this)">Aprobados</button>
        <button class="panel-filter" onclick="setAportesFilter('rechazado',this)">Rechazados</button>
        <button class="panel-filter" onclick="setAportesFilter('all',this)">Todos</button>
        <button class="panel-btn-new" onclick="openModal('modalKB')"><i class="bi bi-plus-lg"></i> Publicar nuevo</button>
      </div>
      <div id="kbAportesWrap">
        <div class="empty-state"><i class="bi bi-arrow-clockwise"></i><p>Cargando aportes...</p></div>
      </div>
    </div>

  </div><!-- /panel-kb -->

  <!-- ══ TAB: PREGUNTAS FRECUENTES ══════════════════════════════════════════ -->
  <div class="tab-panel" id="panel-faq">

    <!-- Sub-tabs FAQ -->
    <div style="display:flex;align-items:center;gap:6px;margin-bottom:16px;flex-wrap:wrap;" id="faq-subtabs">
      <button class="panel-filter active" onclick="showFaqSection('hub',this)"><i class="bi bi-grid-1x2-fill"></i> Módulos</button>
      <button class="panel-filter" onclick="showFaqSection('gestion',this)"><i class="bi bi-list-ul"></i> Gestión</button>
      <button class="panel-filter" onclick="showFaqSection('solicitudes',this)"><i class="bi bi-inbox-fill"></i> Solicitudes</button>
      <button class="panel-filter" onclick="showFaqSection('aportes',this)"><i class="bi bi-lightbulb-fill"></i> Aportes</button>
      <button id="faqRefreshBtn" title="Actualizar sección" onclick="refreshFaqSection()" style="margin-left:auto;display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:10px;border:1.5px solid var(--border-soft);background:var(--bg-card);color:var(--text-muted);font-size:12px;font-weight:700;cursor:pointer;transition:all .2s;">
        <i class="bi bi-arrow-clockwise" id="faqRefreshIcon"></i> Actualizar
      </button>
    </div>

    <!-- FAQ: Hub cards -->
    <div class="mgmt-panel active" id="faq-hub">
      <div class="section-label"><i class="bi bi-patch-question-fill"></i> &nbsp;Gestión de Preguntas Frecuentes</div>
      <div class="sub-grid">
        <div class="mod-card c-cyan" onclick="openModal('modalFAQ')">
