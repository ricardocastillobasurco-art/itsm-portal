    </tr>`).join('')}
    </tbody>
  </table></div>`;
}

function viewAporteById(id){ viewAporte(_aportesData.find(a=>a.id===id)||{id}); }
async function viewAporte(a){
  document.getElementById('viewAporteTitle').textContent    = a.title||'Recurso';
  document.getElementById('viewAporteAuthor').textContent   = a.author||'—';
  document.getElementById('viewAporteCategory').textContent = a.category||'general';
  document.getElementById('viewAporteType').innerHTML       = a.content_type==='pdf'?'<i class="bi bi-file-earmark-pdf-fill" style="color:#b91c1c;"></i> PDF':a.content_type==='video'?'<i class="bi bi-play-circle-fill" style="color:#7c3aed;"></i> Video':a.content_type==='text'?'<i class="bi bi-file-text" style="color:#10b981;"></i> Texto':'<i class="bi bi-link-45deg" style="color:#1d4ed8;"></i> URL';
  document.getElementById('viewAporteDate').textContent     = _fmtDate(a.created_at);
  document.getElementById('viewAporteDesc').textContent     = a.description||'Sin descripción';
  const cont = document.getElementById('viewAporteContent');
  cont.innerHTML = '<div style="text-align:center;padding:24px;color:var(--text-muted);"><i class="bi bi-arrow-clockwise"></i> Cargando contenido...</div>';
  openModal('modalViewAporte');
  // Acciones
  const actDiv = document.getElementById('viewAporteActions');
  const isPend = (a.status||'pendiente')==='pendiente';
  actDiv.innerHTML = `<button class="btn-cancel" onclick="closeModal('modalViewAporte')">Cerrar</button>
    ${isPend?`<button class="btn-submit-purp" id="vabtn-approve" onclick="handleLearningStatus(${a.id},'publicado',this).then(()=>closeModal('modalViewAporte'))"><i class="bi bi-check-lg"></i> Aprobar</button>
    <button style="padding:9px 18px;border-radius:10px;background:#fee2e2;color:#dc2626;border:none;font-weight:700;cursor:pointer;" id="vabtn-deny" onclick="handleLearningStatus(${a.id},'rechazado',this).then(()=>closeModal('modalViewAporte'))"><i class="bi bi-x-lg"></i> Denegar</button>`:''}`;
  // Cargar contenido real desde el backend
  try {
    const r  = await fetch(`/api/kb/learning/${a.id}/content`, {credentials:'include'});
    const d  = await r.json();
    const raw = d.data || '';
    if(a.content_type === 'pdf'){
      // raw es base64; crear blob URL para iframe
      const bin  = atob(raw.replace(/^data:[^;]+;base64,/,''));
      const arr  = new Uint8Array(bin.length);
      for(let i=0;i<bin.length;i++) arr[i]=bin.charCodeAt(i);
      const blob = new Blob([arr],{type:'application/pdf'});
      const url  = URL.createObjectURL(blob);
      cont.innerHTML = `<iframe src="${url}" width="100%" height="500px" style="border:none;border-radius:8px;"></iframe>
        <div style="margin-top:8px;text-align:center;"><a href="${url}" download="${a.file_name||'recurso.pdf'}" style="font-size:12px;color:var(--primary);font-weight:600;"><i class="bi bi-download"></i> Descargar PDF</a></div>`;
    } else if(a.content_type === 'video'){
      // Intentar embed YouTube/Vimeo o mostrar enlace
      const ytMatch = raw.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([A-Za-z0-9_-]{11})/);
      const vmMatch = raw.match(/vimeo\.com\/(\d+)/);
      if(ytMatch){
        cont.innerHTML=`<iframe width="100%" height="380" src="https://www.youtube.com/embed/${ytMatch[1]}" frameborder="0" allowfullscreen style="border-radius:8px;"></iframe>`;
      } else if(vmMatch){
        cont.innerHTML=`<iframe width="100%" height="380" src="https://player.vimeo.com/video/${vmMatch[1]}" frameborder="0" allowfullscreen style="border-radius:8px;"></iframe>`;
      } else {
        cont.innerHTML=`<a href="${raw}" target="_blank" rel="noopener" style="color:var(--primary);font-weight:600;word-break:break-all;"><i class="bi bi-play-circle-fill"></i> ${raw}</a>`;
      }
    } else if(a.content_type === 'text'){
      // Contenido de texto plano — mostrar como bloque legible
      cont.innerHTML=`<div style="background:var(--bg-main,#f8fafc);border:1px solid var(--border-soft);border-radius:10px;padding:20px;font-size:14px;line-height:1.8;white-space:pre-wrap;max-height:420px;overflow-y:auto;color:var(--text-main);">${raw.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div>`;
    } else {
      // URL — mostrar enlace + preview en iframe
      const isValidUrl = /^https?:\/\//i.test(raw);
      cont.innerHTML=`<div style="margin-bottom:10px;">
        ${isValidUrl?`<a href="${raw}" target="_blank" rel="noopener" style="color:var(--primary);font-weight:600;word-break:break-all;"><i class="bi bi-box-arrow-up-right"></i> Abrir enlace en nueva pestaña</a>`:
          `<span style="color:var(--text-muted);font-size:13px;"><i class="bi bi-exclamation-triangle" style="color:#f59e0b;"></i> URL inválida: <code>${raw.replace(/&/g,'&amp;')}</code></span>`}
      </div>
      ${isValidUrl?`<iframe src="${raw}" width="100%" height="400px" style="border:1.5px solid var(--border-soft);border-radius:8px;" sandbox="allow-scripts allow-same-origin"></iframe>`:''}`;
    }
  } catch(e){
    cont.innerHTML='<div style="padding:20px;text-align:center;color:var(--text-muted);"><i class="bi bi-exclamation-triangle"></i> No se pudo cargar el contenido</div>';
  }
}

