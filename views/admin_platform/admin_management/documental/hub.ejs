    <div class="fm-row"><label>Asunto</label><input type="text" id="respFaqAporteAsunto" placeholder="Ej: Tu aporte ha sido revisado"></div>
    <div class="fm-row"><label>Mensaje</label><textarea id="respFaqAporteMensaje" rows="5" placeholder="Escribe tu comentario sobre el aporte enviado..."></textarea></div>
    <div class="fm-footer">
      <button class="btn-cancel" onclick="closeModal('modalRespFaqAporte')">Cancelar</button>
      <button style="padding:9px 22px;border-radius:10px;background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;border:none;font-size:13px;font-weight:700;cursor:pointer;" onclick="sendRespFaqAporte()"><i class="bi bi-send-fill"></i> Enviar</button>
    </div>
  </div>
</div>

<!-- Modal: Publicar respuesta a solicitud de FAQ -->
<div class="doc-modal-overlay" id="modalPublishFaqResp">
  <div class="doc-modal" style="max-width:600px;">
    <button class="doc-modal-close" onclick="closeModal('modalPublishFaqResp')"><i class="bi bi-x-lg"></i></button>
    <h3><i class="bi bi-patch-plus-fill" style="color:#0891b2;"></i> Publicar respuesta a solicitud</h3>
    <div id="faqRespSolicitante" style="font-size:11px;color:var(--text-muted);background:var(--bg-main);padding:6px 12px;border-radius:8px;margin:-8px 0 16px;"></div>
    <input type="hidden" id="faqRespReqId">
    <div class="fm-row-2">
      <div class="fm-row" style="margin:0;"><label>Categoría *</label>
        <input id="faqResp-category" type="text" list="faqResp-cats" placeholder="Ej: Incidencias">
        <datalist id="faqResp-cats">
          <option value="Incidencias"><option value="Requerimientos"><option value="Equipos y Mantenimiento">
          <option value="Accesos y Correo"><option value="Software y Licencias"><option value="General">
        </datalist>
      </div>
      <div class="fm-row" style="margin:0;"><label>Orden</label><input id="faqResp-order" type="number" value="0" min="0"></div>
    </div>
    <div class="fm-row" style="margin-top:14px;"><label>Pregunta *</label><input id="faqResp-question" type="text" placeholder="Pregunta que verán los usuarios"></div>
    <div class="fm-row"><label>Respuesta *</label><textarea id="faqResp-answer" rows="7" placeholder="Respuesta completa y clara..."></textarea></div>
    <div class="fm-footer" style="justify-content:space-between;">
      <button class="btn-cancel" onclick="closeModal('modalPublishFaqResp')">Cancelar</button>
      <button class="btn-submit-cyan" onclick="submitPublishFaqResp(this)"><i class="bi bi-send-fill"></i> Publicar y resolver</button>
    </div>
  </div>
</div>

<div class="doc-toast" id="docToast"></div>

<script>
/* ── THEME ──────────────────────────────────────────────────── */
(function(){
  const s = localStorage.getItem('dashboardTheme') || 'light';
  document.documentElement.setAttribute('data-theme', s);
  _syncUI(s);
})();
function toggleTheme(){
  const n = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', n);
  localStorage.setItem('dashboardTheme', n);
  _syncUI(n);
}
function _syncUI(t){
  const dark=t==='dark';
  const icon=document.getElementById('toggleIcon'),label=document.getElementById('toggleLabel'),track=document.getElementById('themeTrack'),knob=document.getElementById('themeKnob');
  if(icon)icon.className=dark?'bi bi-sun-fill':'bi bi-moon-stars-fill';
  if(label)label.textContent=dark?'Claro':'Oscuro';
  if(track)track.style.background=dark?'#3b82f6':'#cbd5e1';
  if(knob)knob.style.transform=dark?'translateX(15px)':'translateX(0)';
}

/* ── TABS PRINCIPALES ───────────────────────────────────────── */
function switchTab(name, btn){
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('panel-' + name).classList.add('active');
  btn.classList.add('active');
  if(name === 'kb')  loadKbData();
  if(name === 'faq') loadFaqData();
}

/* ── SUB-SECCIONES KB ───────────────────────────────────────── */
let _kbActiveSection = 'hub';
function showKbSection(key, btn){
  _kbActiveSection = key;
  document.querySelectorAll('#kb-subtabs .panel-filter').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('#panel-kb .mgmt-panel').forEach(p => p.classList.remove('active'));
  if(btn) btn.classList.add('active');
  document.getElementById('kb-' + key).classList.add('active');
  if(key === 'gestion')     loadKbArticles();
  if(key === 'solicitudes') loadKbSolicitudes();
  if(key === 'aportes')     loadKbAportes();
}

async function refreshKbSection(){
  const icon = document.getElementById('kbRefreshIcon');
  const btn  = document.getElementById('kbRefreshBtn');
  btn.disabled = true;
  icon.style.transition = 'transform .6s';
  icon.style.transform  = 'rotate(360deg)';
  setTimeout(() => { icon.style.transition=''; icon.style.transform=''; }, 650);
  if(_kbActiveSection === 'gestion')     await loadKbArticles();
  else if(_kbActiveSection === 'solicitudes') await loadKbSolicitudes();
  else if(_kbActiveSection === 'aportes')     await loadKbAportes();
  else { /* hub: nada que recargar */ toast('Sección actualizada'); }
  btn.disabled = false;
}

/* ── SUB-SECCIONES FAQ ──────────────────────────────────────── */
let _faqActiveSection = 'hub';
function showFaqSection(key, btn){
  _faqActiveSection = key;
  document.querySelectorAll('#faq-subtabs .panel-filter').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('#panel-faq .mgmt-panel').forEach(p => p.classList.remove('active'));
  if(btn) btn.classList.add('active');
  document.getElementById('faq-' + key).classList.add('active');
  if(key === 'gestion')     loadFaqList();
  if(key === 'solicitudes') loadFaqSolicitudes();
  if(key === 'aportes')     loadFaqAportes();
}

async function refreshFaqSection(){
  const icon = document.getElementById('faqRefreshIcon');
  const btn  = document.getElementById('faqRefreshBtn');
  btn.disabled = true;
  icon.style.transition = 'transform .6s';
  icon.style.transform  = 'rotate(360deg)';
  setTimeout(() => { icon.style.transition=''; icon.style.transform=''; }, 650);
  if(_faqActiveSection === 'gestion')          await loadFaqList();
  else if(_faqActiveSection === 'solicitudes') await loadFaqSolicitudes();
  else if(_faqActiveSection === 'aportes')     await loadFaqAportes();
  else toast('Sección actualizada');
  btn.disabled = false;
}

/* ── MODALS ─────────────────────────────────────────────────── */
function openModal(id){
  document.getElementById(id).classList.add('open');
  if(id === 'modalKB') loadKBCategories();
}
function closeModal(id){
  document.getElementById(id).classList.remove('open');
  if(id==='modalViewAporte'){
    const iframe = document.querySelector('#viewAporteContent iframe');
    if(iframe && iframe.src.startsWith('blob:')){ URL.revokeObjectURL(iframe.src); iframe.src=''; }
  }
}
document.querySelectorAll('.doc-modal-overlay').forEach(el =>
  el.addEventListener('click', e => { if(e.target === el) el.classList.remove('open'); })
);
document.addEventListener('keydown', e => { if(e.key === 'Escape') document.querySelectorAll('.doc-modal-overlay.open').forEach(m => m.classList.remove('open')); });

/* ── TOAST ──────────────────────────────────────────────────── */
function toast(msg, type='ok'){
  const t = document.getElementById('docToast');
  t.textContent = (type==='ok' ? '✓  ' : '✕  ') + msg;
  t.className = 'doc-toast ' + type + ' show';
  setTimeout(() => t.classList.remove('show'), 3500);
}

/* ── KB CATEGORIES ──────────────────────────────────────────── */
async function loadKBCategories(){
  const sel = document.getElementById('kb-category');
  if(sel.options.length > 1) return;
  try {
    const r = await fetch('/api/kb/categories', {credentials:'include'});
    const d = await r.json();
    (d.data || d || []).forEach(c => {
      const o = document.createElement('option');
      o.value = c.id; o.textContent = c.name || c.nombre || c.category;
      sel.appendChild(o);
    });
  } catch(e){}
}

/* ── SUBMIT KB ──────────────────────────────────────────────── */
async function submitKB(){
  const title = document.getElementById('kb-title').value.trim();
  const content = document.getElementById('kb-content').value.trim();
  if(!title)   { toast('El título es requerido','err'); return; }
  if(!content) { toast('El contenido es requerido','err'); return; }
  const btn = event.target; btn.disabled=true; btn.innerHTML='<i class="bi bi-hourglass-split"></i> Publicando…';
  try {
    const r = await fetch('/api/kb/admin-create', {method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},
      body: JSON.stringify({title, content, status: document.getElementById('kb-status').value,
        excerpt: document.getElementById('kb-excerpt').value.trim(),
        kbCategoryId: document.getElementById('kb-category').value || null,
        tags: document.getElementById('kb-tags').value.trim(),
        tipo: document.getElementById('kb-tipo').value})});
    const d = await r.json();
    if(d.success || d.data){ toast('Artículo publicado'); closeModal('modalKB'); ['kb-title','kb-content','kb-excerpt','kb-tags'].forEach(id=>document.getElementById(id).value=''); loadKbArticles(); }
    else toast(d.error || 'Error al publicar','err');
  } catch(e){ toast('Error de conexión','err'); }
  finally{ btn.disabled=false; btn.innerHTML='<i class="bi bi-send-fill"></i> Publicar'; }
}

/* ── SUBMIT FAQ ─────────────────────────────────────────────── */
async function submitFAQ(){
  const category = document.getElementById('faq-category').value.trim();
  const question = document.getElementById('faq-question').value.trim();
  const answer   = document.getElementById('faq-answer').value.trim();
  if(!category||!question||!answer){ toast('Completa todos los campos requeridos','err'); return; }
  const btn = event.target; btn.disabled=true; btn.innerHTML='<i class="bi bi-hourglass-split"></i> Publicando…';
  try {
    const r = await fetch('/api/faq', {method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},
      body: JSON.stringify({category, question, answer, order_num: parseInt(document.getElementById('faq-order').value)||0})});
    const d = await r.json();
    if(d.success){ toast('Pregunta publicada'); closeModal('modalFAQ'); ['faq-category','faq-question','faq-answer'].forEach(id=>document.getElementById(id).value=''); document.getElementById('faq-order').value='0'; loadFaqList(); }
    else toast(d.error || 'Error al publicar','err');
  } catch(e){ toast('Error de conexión','err'); }
  finally{ btn.disabled=false; btn.innerHTML='<i class="bi bi-send-fill"></i> Publicar'; }
}

/* ── CARGAR ARTÍCULOS KB ────────────────────────────────────── */
let _kbAll = [];
async function loadKbArticles(){
  const tbody = document.getElementById('kbTableBody');
  tbody.innerHTML = '<tr><td colspan="6"><div class="empty-state"><i class="bi bi-arrow-clockwise"></i><p>Cargando...</p></div></td></tr>';
  try {
    const r = await fetch('/api/kb?admin=1&status=all&limit=200', {credentials:'include'});
    const d = await r.json();
    _kbAll = d.data || d.articles || d || [];
    renderKbTable(_kbAll);
  } catch(e){
    tbody.innerHTML = '<tr><td colspan="6"><div class="empty-state"><i class="bi bi-exclamation-triangle"></i><p>Error al cargar artículos</p></div></td></tr>';
  }
}
function renderKbTable(list){
  const tbody = document.getElementById('kbTableBody');
  if(!list.length){ tbody.innerHTML='<tr><td colspan="6"><div class="empty-state"><i class="bi bi-journal-x"></i><p>No hay artículos</p></div></td></tr>'; return; }
  const stCls = s => s==='publicado'?'art-status-pub':s==='oculto'?'art-status-hidden':s==='borrador'?'art-status-draft':'art-status-rev';
  const stLbl = s => ({publicado:'Publicado',borrador:'Borrador',revision:'En revisión',oculto:'Oculto',archivado:'Archivado'})[s]||s||'—';
  tbody.innerHTML = list.map(a => `
    <tr data-status="${a.status||''}">
      <td><strong style="font-size:13px;">${a.title||a.titulo||''}</strong><br><span style="font-size:11px;color:var(--text-muted);">${(a.excerpt||a.extracto||'').substring(0,80)}</span></td>
      <td style="font-size:12px;color:var(--text-muted);">${a.kbCategory?.name||a.categoria?.name||a.category?.name||'—'}</td>
      <td><span class="art-status ${stCls(a.status)}">${stLbl(a.status)}</span></td>
      <td style="font-size:12px;">${a.views||a.vistas||0}</td>
      <td style="font-size:11px;color:var(--text-muted);">${_fmtDate(a.updatedAt||a.updated_at||a.createdAt||a.created_at)}</td>
      <td>
        <button class="art-action-btn" onclick="editKbArticle('${a.id}')"><i class="bi bi-pencil-fill"></i> Editar</button>
        <button class="art-action-btn" onclick="toggleKbStatus('${a.id}','${a.status==='publicado'?'oculto':'publicado'}',this)">${a.status==='publicado'?'Ocultar':'Publicar'}</button>
        <button class="art-action-btn danger" onclick="deleteKbArticle('${a.id}',this)"><i class="bi bi-trash3-fill"></i></button>
      </td>
    </tr>`).join('');
}
function _fmtDate(d){ if(!d) return '—'; const dt = new Date(d); return dt.toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'2-digit'}); }
function filterArticles(){
  const q = document.getElementById('kbSearchInput').value.toLowerCase();
  renderKbTable(_kbAll.filter(a => (a.title||a.titulo||'').toLowerCase().includes(q) || (a.excerpt||a.extracto||'').toLowerCase().includes(q)));
}
let _kbFilter = 'all';
function setKbFilter(btn, val){
  document.querySelectorAll('#kb-gestion .panel-filter[data-filter]').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active'); _kbFilter = val;
  renderKbTable(val === 'all' ? _kbAll : _kbAll.filter(a => a.status === val));
}
async function editKbArticle(id){
  const btn = event?.target; if(btn){ btn.disabled=true; }
  try {
    // Usar el endpoint de lista para evitar incrementar vistas
    const r = await fetch(`/api/kb/${id}`, {credentials:'include'});
    if(!r.ok){ toast('Error al cargar artículo','err'); return; }
    const d = await r.json();
    const a = d.data || d;
    document.getElementById('edit-kb-id').value      = a.id;
    document.getElementById('edit-kb-title').value   = a.title || '';
    document.getElementById('edit-kb-excerpt').value = a.excerpt || '';
    document.getElementById('edit-kb-tipo').value    = a.tipo || 'articulo';
    document.getElementById('edit-kb-status').value  = a.status || 'borrador';
    document.getElementById('edit-kb-tags').value    = Array.isArray(a.tags) ? a.tags.join(', ') : (a.tags || '');
    document.getElementById('edit-kb-content').value = a.content || '';
    openModal('modalEditKB');
  } catch(e){ toast('Error al cargar artículo','err'); }
  finally{ if(btn) btn.disabled=false; }
}
async function updateKB(){
  const id      = document.getElementById('edit-kb-id').value;
  const tagsRaw = document.getElementById('edit-kb-tags').value.trim();
  const body = {
    title:   document.getElementById('edit-kb-title').value.trim(),
    excerpt: document.getElementById('edit-kb-excerpt').value.trim(),
    tipo:    document.getElementById('edit-kb-tipo').value,
    status:  document.getElementById('edit-kb-status').value,
    content: document.getElementById('edit-kb-content').value.trim(),
    tags:    tagsRaw, // siempre string
  };
  if(!body.title){ toast('El título es obligatorio','err'); return; }
  const btn = event.target; btn.disabled=true; btn.innerHTML='<i class="bi bi-hourglass-split"></i> Guardando…';
  try {
    const r = await fetch(`/api/kb/${id}`, {method:'PATCH',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    const d = await r.json();
    if(r.ok){ toast('Artículo actualizado'); closeModal('modalEditKB'); loadKbArticles(); }
    else toast(d.error||'Error al guardar','err');
  } catch(e){ toast('Error de conexión','err'); }
  finally{ btn.disabled=false; btn.innerHTML='<i class="bi bi-floppy-fill"></i> Guardar'; }
}
async function toggleKbStatus(id, newStatus, btn){
  try {
    const r = await fetch(`/api/kb/${id}`, {method:'PATCH',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:newStatus})});
    if(r.ok){ toast(`Artículo ${newStatus}`); loadKbArticles(); }
    else toast('Error','err');
  } catch(e){ toast('Error','err'); }
}
async function deleteKbArticle(id, btn){
  if(!confirm('¿Eliminar este artículo?')) return;
  try {
    const r = await fetch(`/api/kb/${id}`, {method:'DELETE',credentials:'include'});
    if(r.ok){ toast('Artículo eliminado'); loadKbArticles(); }
    else toast('Error al eliminar','err');
  } catch(e){ toast('Error','err'); }
}

/* ── SOLICITUDES KB (procedure-requests) ────────────────────── */
let _solMap = {};
async function loadKbSolicitudes(){
  const grid = document.getElementById('kbSolicitudesGrid');
  grid.innerHTML='<div style="grid-column:1/-1"><div class="empty-state"><i class="bi bi-arrow-clockwise"></i><p>Cargando...</p></div></div>';
  try {
    const r = await fetch('/api/kb/procedure-requests', {credentials:'include'});
    const d = await r.json();
    const list = (d.data || d || []).filter(s => s.status !== 'resuelto' && s.status !== 'rechazado');
    _solMap = {};
    list.forEach(s => { _solMap[s.id] = s; });
    if(!list.length){ grid.innerHTML='<div style="grid-column:1/-1"><div class="empty-state"><i class="bi bi-inbox"></i><p>No hay solicitudes pendientes</p></div></div>'; return; }
    grid.innerHTML = list.map(s => {
      const ini = (s.user_name||s.user_email||'?').charAt(0).toUpperCase();
      const colors=['#3b82f6','#7c3aed','#0891b2','#059669','#d97706'];
      const col = colors[ini.charCodeAt(0)%colors.length];
      return `<div class="sol-card" id="sol-kb-${s.id}">
        <div class="sol-card-header">
          <div class="sol-avatar" style="background:${col};">${ini}</div>
          <div>
            <div class="sol-user-name">${s.user_name||'Anónimo'}</div>
            <div class="sol-user-email">${s.user_email||''} · ${_fmtDate(s.created_at)}</div>
          </div>
        </div>
        <div class="sol-card-body"><strong>${s.query||''}</strong>${s.description?`<br><span style="font-size:11px;color:var(--text-muted);">${s.description}</span>`:''}</div>
        <div class="sol-card-footer">
          <span class="sol-badge sol-badge-${s.status==='resuelto'?'accepted':'pending'}">${s.status||'pendiente'}</span>
          <button class="sol-action sol-action-accept" onclick="openPublishProc(${s.id})"><i class="bi bi-file-earmark-plus-fill"></i> Publicar procedimiento</button>
          <button class="sol-action sol-action-reject" onclick="handleProcReq(${s.id},'rechazado',this)"><i class="bi bi-x-lg"></i> Rechazar</button>
        </div>
      </div>`;
    }).join('');
  } catch(e){ grid.innerHTML='<div style="grid-column:1/-1"><div class="empty-state"><i class="bi bi-wifi-off"></i><p>Error al cargar solicitudes</p></div></div>'; }
}

/* ── PUBLICAR PROCEDIMIENTO DESDE SOLICITUD ─────────────────── */
let _ppPdfB64 = '';

function openPublishProc(reqId){
  const s = _solMap[reqId] || {};
  document.getElementById('ppReqId').value         = reqId;
  document.getElementById('ppTitle').value          = s.query || '';
  document.getElementById('ppDescription').value    = s.description || '';
  document.getElementById('ppContent').value        = s.description
    ? `Solicitud del usuario:\n${s.description}\n\nPasos del procedimiento:\n1. `
    : 'Pasos del procedimiento:\n1. ';
  document.getElementById('ppContentUrl').value     = '';
  document.getElementById('ppContentPdf').value     = '';
  document.getElementById('ppPdfName').textContent  = '';
  document.getElementById('ppSolicitante').textContent = s.user_name ? `Solicitado por: ${s.user_name} — ${s.user_email||''}` : '';
  _ppPdfB64 = '';
  togglePpContent('text');
  document.getElementById('ppContentType').value    = 'text';
  openModal('modalPublishProc');
}

function togglePpContent(type){
  document.getElementById('ppContentTextRow').style.display = type === 'text' ? '' : 'none';
  document.getElementById('ppContentUrlRow').style.display  = type === 'url'  ? '' : 'none';
  document.getElementById('ppContentPdfRow').style.display  = type === 'pdf'  ? '' : 'none';
}

function loadPpPdf(input){
  const file = input.files[0];
  if(!file){ _ppPdfB64=''; return; }
  document.getElementById('ppPdfName').textContent = `${file.name} (${(file.size/1024).toFixed(0)} KB)`;
  const reader = new FileReader();
  reader.onload = e => { _ppPdfB64 = e.target.result; };
  reader.readAsDataURL(file);
}

function _ppGetPayload(){
  const title       = document.getElementById('ppTitle').value.trim();
  const description = document.getElementById('ppDescription').value.trim();
  const category    = document.getElementById('ppCategory').value;
  const contentType = document.getElementById('ppContentType').value;
  let content_data = '', file_name = '';
  if(!title) return null;
  if(contentType === 'text'){
    content_data = document.getElementById('ppContent').value.trim();
  } else if(contentType === 'url'){
    content_data = document.getElementById('ppContentUrl').value.trim();
  } else if(contentType === 'pdf'){
    content_data = _ppPdfB64;
    file_name = document.getElementById('ppContentPdf').files[0]?.name || 'procedimiento.pdf';
  }
  return { title, description, procedure_category: category, content_type: contentType, content_data, file_name };
}

async function saveProcDraft(btn){
  const payload = _ppGetPayload();
  if(!payload?.title){ toast('El título es obligatorio','err'); return; }
  if(!payload.content_data){ toast('Agrega el contenido antes de guardar','err'); return; }
  const origHtml = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Guardando…';
  try {
    const r = await fetch('/api/kb/procedures/draft', {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    const d = await r.json();
    if(r.ok && d.success){ toast('Borrador guardado — puedes publicarlo desde Gestión'); closeModal('modalPublishProc'); }
    else toast(d.error || 'Error al guardar borrador','err');
  } catch(e){ toast('Error de conexión','err'); }
  finally{ btn.disabled=false; btn.innerHTML=origHtml; }
}

async function submitPublishProc(btn){
  const reqId  = document.getElementById('ppReqId').value;
  const payload = _ppGetPayload();
  if(!payload?.title){ toast('El título es obligatorio','err'); return; }
  if(!payload.content_data){ toast('El contenido es obligatorio','err'); return; }

  const origHtml = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Publicando…';
  try {
    const rProc = await fetch('/api/kb/procedures', {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    const dProc = await rProc.json();
    if(!rProc.ok){ toast(dProc.error || 'Error al publicar','err'); return; }
    if(reqId){
      await fetch(`/api/kb/procedure-requests/${reqId}/status`, {
        method:'PATCH', credentials:'include',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({status:'resuelto'})
      });
      document.getElementById(`sol-kb-${reqId}`)?.remove();
    }
    toast('Procedimiento publicado y solicitud resuelta');
    closeModal('modalPublishProc');
  } catch(e){ toast('Error de conexión','err'); }
  finally{ btn.disabled=false; btn.innerHTML=origHtml; }
}

