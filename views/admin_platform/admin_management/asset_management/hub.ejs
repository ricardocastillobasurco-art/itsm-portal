<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<script>(function(){document.documentElement.setAttribute('data-theme',localStorage.getItem('dashboardTheme')||'light');})();</script>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Gestión de Activos · IT Platform</title>
<%- include('../../../shared/partials/admin/hub-styles') %>
</head>
<body>
<%
  const _u=user||{};const _n=_u.full_name||_u.name||_u.email||'Usuario';
  const _p=_n.trim().split(/\s+/);const _i=(_p[0]?.[0]||'U').toUpperCase()+(_p[1]?.[0]||'').toUpperCase();
%>
<nav class="navbar">
  <button class="nav-hamburger" onclick="toggleSidebar()"><i class="bi bi-layout-sidebar"></i></button>
  <div class="nav-brand">
    <img src="/images/movistar-logo.png" alt="" class="nav-logo" onerror="this.style.display='none'">
    <span class="nav-divider"></span>
    <span class="nav-name">IT Platform</span>
    <span class="nav-badge" style="background:linear-gradient(135deg,#d97706,#f59e0b);">ACTIVOS</span>
  </div>
  <div class="nav-breadcrumb">
    <span class="sep">·</span>
    <a href="/administracion"><i class="bi bi-shield-lock-fill" style="color:#7c3aed;font-size:10px;"></i> Admin</a>
    <span class="sep">/</span>
    <span class="cur"><i class="bi bi-laptop-fill"></i> Gestión de Activos</span>
  </div>
  <div class="nav-space"></div>
  <button class="nav-icon-btn" onclick="toggleTheme()"><i class="bi bi-moon-stars-fill" id="navThemeIcon"></i></button>
  <div class="nav-user"><div class="nav-avatar"><%= _i %></div><span class="nav-username"><%= _p[0] %></span></div>
  <a href="/api/auth/logout" class="nav-exit"><i class="bi bi-box-arrow-right"></i> Salir</a>
</nav>

<div class="app-shell">
  <div class="sidebar" id="sidebar">
    <div class="sb-header">
      <div class="sb-icon-box" style="background:linear-gradient(135deg,#d97706,#f59e0b);"><i class="bi bi-laptop-fill"></i></div>
      <div class="sb-brand"><div class="sb-brand-name">Activos TI</div><div class="sb-brand-sub">Gestión de Inventario</div></div>
    </div>
    <nav class="sb-nav">
      <a class="sb-item" href="/administracion"><i class="bi bi-arrow-left-circle sb-icon" style="color:var(--muted-2);"></i><span class="sb-label">← Administración</span></a>
      <div class="sb-divider"></div>
      <span class="sb-section-label">Inventario</span>
      <button class="sb-item active" id="sb-inv" onclick="showPanel('inv',this)"><i class="bi bi-pc-display-horizontal sb-icon" style="color:#2563eb;"></i><span class="sb-label">Inventario TI</span></button>
      <div class="sb-divider"></div>
      <span class="sb-section-label">Operaciones</span>
      <button class="sb-item" id="sb-gar" onclick="showPanel('gar',this)"><i class="bi bi-shield-check sb-icon" style="color:#059669;"></i><span class="sb-label">Garantías</span></button>
      <button class="sb-item" id="sb-dev" onclick="showPanel('dev',this)"><i class="bi bi-box-arrow-in-left sb-icon" style="color:#0891b2;"></i><span class="sb-label">Devoluciones</span></button>
      <button class="sb-item" id="sb-sccm" onclick="showPanel('sccm',this)"><i class="bi bi-windows sb-icon" style="color:#2563eb;"></i><span class="sb-label">SCCM / Intune</span></button>
      <button class="sb-item" id="sb-sopor" onclick="showPanel('sopor',this)"><i class="bi bi-tools sb-icon" style="color:#059669;"></i><span class="sb-label">Soporte Técnico</span></button>
    </nav>
    <div class="sb-footer">
      <div class="sb-user-av"><%= _i %></div>
      <div class="sb-user-info"><div class="sb-user-name"><%= _n %></div><div class="sb-user-role"><%= _u.role||'agente' %></div></div>
      <button class="sb-theme-btn" onclick="toggleTheme()"><i class="bi bi-moon-stars-fill" id="sbThemeIcon"></i></button>
    </div>
  </div>
  <div class="sb-overlay" id="sbOverlay" onclick="closeSidebarMobile()"></div>

  <div class="content-area">

    <!-- INVENTARIO TI -->
    <div class="hub-panel active" id="panel-inv">
      <div class="content-header">
        <div><div class="ch-title">Inventario TI</div><div class="ch-sub">Equipos, CMDB y activos tecnológicos</div></div>
        <div class="ch-actions"><a href="/equipment" style="display:flex;align-items:center;gap:6px;padding:6px 14px;border-radius:var(--radius-sm);background:var(--primary);color:#fff;font-size:12px;font-weight:700;"><i class="bi bi-box-arrow-up-right"></i> Ir a Equipos</a></div>
      </div>
      <div class="content-body"><div class="hub-grid">
        <div class="hub-card hc-blue" onclick="location.href='/equipment'">
          <div class="hub-card-icon"><i class="bi bi-pc-display-horizontal"></i></div>
          <div class="hub-card-name">Equipos</div>
          <div class="hub-card-desc">Inventario completo de activos TI: listado, almacén físico y recuperos.</div>
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;">
            <a href="/equipment" onclick="event.stopPropagation()" style="font-size:10.5px;font-weight:600;padding:3px 9px;border-radius:6px;background:var(--primary-dim);color:var(--primary);"><i class="bi bi-table"></i> Listado</a>
            <a href="/almacen" onclick="event.stopPropagation()" style="font-size:10.5px;font-weight:600;padding:3px 9px;border-radius:6px;background:var(--primary-dim);color:var(--primary);"><i class="bi bi-archive-fill"></i> Almacén</a>
            <a href="/almacen?tab=recuperos" onclick="event.stopPropagation()" style="font-size:10.5px;font-weight:600;padding:3px 9px;border-radius:6px;background:var(--primary-dim);color:var(--primary);"><i class="bi bi-recycle"></i> Recuperos</a>
          </div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </div>
        <a href="/cmdb" class="hub-card hc-indigo">
          <div class="hub-card-icon"><i class="bi bi-diagram-3-fill"></i></div>
          <div class="hub-card-name">CMDB</div>
          <div class="hub-card-desc">Base de datos de configuración: relaciones entre CIs, equipos y servicios.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
      </div></div>
    </div>

    <!-- GARANTÍAS -->
    <div class="hub-panel" id="panel-gar">
      <div class="content-header"><div><div class="ch-title">Garantías</div><div class="ch-sub">Control de garantías y vencimientos</div></div></div>
      <div class="content-body"><div class="hub-grid">
        <a href="/warranty" class="hub-card hc-green">
          <div class="hub-card-icon"><i class="bi bi-shield-check"></i></div>
          <div class="hub-card-name">Gestión de Garantías</div>
          <div class="hub-card-desc">Control de garantías activas, vencidas y próximas a vencer por equipo.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
        <a href="/warranty?tab=alertas" class="hub-card hc-amber">
          <div class="hub-card-icon"><i class="bi bi-bell-fill"></i></div>
          <div class="hub-card-name">Alertas de Vencimiento</div>
          <div class="hub-card-desc">Equipos con garantía próxima a vencer o ya expirada que requieren acción.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
      </div></div>
    </div>

    <!-- DEVOLUCIONES -->
    <div class="hub-panel" id="panel-dev">
      <div class="content-header"><div><div class="ch-title">Devoluciones</div><div class="ch-sub">Registro y seguimiento de equipos devueltos</div></div></div>
      <div class="content-body"><div class="hub-grid">
        <a href="/incidencias?tab=devoluciones" class="hub-card hc-cyan">
          <div class="hub-card-icon"><i class="bi bi-box-arrow-in-left"></i></div>
          <div class="hub-card-name">Gestión de Devoluciones</div>
          <div class="hub-card-desc">Registro y seguimiento de equipos devueltos por colaboradores al área TI.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
        <a href="/incidencias?tab=devoluciones&view=pendientes" class="hub-card hc-amber">
          <div class="hub-card-icon"><i class="bi bi-hourglass-split"></i></div>
          <div class="hub-card-name">Pendientes de Recepción</div>
          <div class="hub-card-desc">Devoluciones solicitadas que aún no han sido físicamente recibidas en el almacén.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
      </div></div>
    </div>

    <!-- SCCM -->
    <div class="hub-panel" id="panel-sccm">
      <div class="content-header"><div><div class="ch-title">SCCM / Endpoint Manager</div><div class="ch-sub">Administración de endpoints con Microsoft Endpoint Manager</div></div></div>
      <div class="content-body"><div class="hub-grid">
        <a href="/sccm" class="hub-card hc-blue">
          <div class="hub-card-icon"><i class="bi bi-windows"></i></div>
          <div class="hub-card-name">SCCM / Intune</div>
          <div class="hub-card-desc">Administración de endpoints vía Microsoft Endpoint Manager y SCCM.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
        <a href="/sccm?tab=inventario" class="hub-card hc-indigo">
          <div class="hub-card-icon"><i class="bi bi-hdd-stack-fill"></i></div>
          <div class="hub-card-name">Inventario SCCM</div>
          <div class="hub-card-desc">Hardware y software detectado por el agente SCCM en todos los equipos de la red.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
      </div></div>
    </div>

    <!-- SOPORTE TÉCNICO -->
    <div class="hub-panel" id="panel-sopor">
      <div class="content-header"><div><div class="ch-title">Soporte Técnico</div><div class="ch-sub">Sesiones de soporte remoto y control de Active Directory</div></div></div>
      <div class="content-body"><div class="hub-grid">
        <a href="/soporte" class="hub-card hc-green">
          <div class="hub-card-icon"><i class="bi bi-tools"></i></div>
          <div class="hub-card-name">Soporte Técnico</div>
          <div class="hub-card-desc">Gestión de sesiones de soporte remoto y presencial, control de Active Directory.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
        <a href="/soporte?tab=sesiones" class="hub-card hc-cyan">
          <div class="hub-card-icon"><i class="bi bi-display-fill"></i></div>
          <div class="hub-card-name">Sesiones Activas</div>
          <div class="hub-card-desc">Monitoreo en tiempo real de sesiones de soporte remoto abiertas por el equipo TI.</div>
          <i class="bi bi-arrow-right hub-card-arrow"></i>
        </a>
      </div></div>
    </div>

  </div>
</div>

<script>
(function(){const t=localStorage.getItem('dashboardTheme')||'light';document.documentElement.setAttribute('data-theme',t);_sy(t);})();
function toggleTheme(){const n=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark';document.documentElement.setAttribute('data-theme',n);localStorage.setItem('dashboardTheme',n);_sy(n);}
function _sy(t){const d=t==='dark';['navThemeIcon','sbThemeIcon'].forEach(id=>{const el=document.getElementById(id);if(el)el.className=d?'bi bi-sun-fill':'bi bi-moon-stars-fill';});}
let _c=localStorage.getItem('actSbCol')==='1';
function toggleSidebar(){const sb=document.getElementById('sidebar');if(window.innerWidth<=768){sb.classList.toggle('mobile-open');document.getElementById('sbOverlay').classList.toggle('visible',sb.classList.contains('mobile-open'));}else{_c=!_c;sb.classList.toggle('collapsed',_c);localStorage.setItem('actSbCol',_c?'1':'0');}}
function closeSidebarMobile(){document.getElementById('sidebar').classList.remove('mobile-open');document.getElementById('sbOverlay').classList.remove('visible');}
function showPanel(n,btn){document.querySelectorAll('.hub-panel').forEach(p=>p.classList.remove('active'));document.querySelectorAll('.sb-item[id^="sb-"]').forEach(b=>b.classList.remove('active'));document.getElementById('panel-'+n).classList.add('active');document.getElementById('sb-'+n).classList.add('active');if(window.innerWidth<=768)closeSidebarMobile();}
(function(){if(_c)document.getElementById('sidebar').classList.add('collapsed');const tab=new URLSearchParams(location.search).get('tab');const map={inv:'inv',gar:'gar',dev:'dev',sccm:'sccm',sopor:'sopor'};if(tab&&map[tab]){const btn=document.getElementById('sb-'+map[tab]);if(btn)showPanel(map[tab],btn);}})();
</script>
</body>
</html>
