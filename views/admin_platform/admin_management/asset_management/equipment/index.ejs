    if (!confirm('¿'+lbl[0].toUpperCase()+lbl.slice(1)+' usuario "'+name+'"?')) return;
    fetch('/api/rmm/device/user/action',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({nodeId:_rmmToolsNodeId,name:name,action:action})})
    .then(function(r){return r.json();}).then(function(d){
        if (d.ok) { _rmmToolsData['users']=null; loadRMMTab('users'); }
