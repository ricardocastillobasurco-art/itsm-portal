var _invUpdCachedData = null;
function loadInvUpd(refresh) {
    var el = document.getElementById('invContent-upd');
    if (!_invOnline) { _invOfflineMsg(el); _invLoaded.upd=true; return; }
    // Si ya hay datos del pre-fetch o cache, mostrar inmediatamente
    if (!refresh && _invLoaded.upd && _invUpdates.length) {
        renderInvUpd(_invUpdates, _invUpdCachedData);
        return;
    }
    el.innerHTML = '<div class="text-center py-4"><span class="mini-spin"></span><p class="text-muted mt-2" style="font-size:12px;">Consultando actualizaciones instaladas...</p></div>';
    _invFetch('device/updates', function(j, err) {
        _invLoaded.upd = true;
        if (err || !j || !j.ok) { _invScriptUnavailable(el, 'upd'); return; }
        if (j.scriptUnavailable && !(j.updates||[]).length) {
            el.innerHTML = '<div style="text-align:center;padding:32px 20px;"><i class="bi bi-shield-exclamation" style="font-size:28px;color:var(--text-muted);display:block;margin-bottom:10px;"></i><div style="font-size:12px;color:var(--text-muted);">No se pudieron obtener actualizaciones (script no ejecutado)</div><button onclick="_refreshInvUpd()" class="btn btn-sm btn-outline-secondary mt-3"><i class="bi bi-arrow-clockwise me-1"></i>Reintentar</button></div>';
            return;
        }
        _invUpdates = j.updates || [];
        _invUpdCachedData = j;
        var badge = document.getElementById('invBadge-upd');
        badge.textContent = _invUpdates.length;
        badge.style.display = 'inline';
        // Guardar en cache frontend
        if (!_invFrontCache[_invNodeId]) _invFrontCache[_invNodeId] = {};
        _invFrontCache[_invNodeId].upd = { data: j, ts: Date.now() };
        renderInvUpd(_invUpdates, j);
    }, refresh ? { refresh: true } : undefined);
}
function _refreshInvUpd() {
    _invLoaded.upd = false;
    _invUpdates = [];
    if (_invFrontCache[_invNodeId]) delete _invFrontCache[_invNodeId].upd;
    loadInvUpd(true);
}

