<script>
function toggleTheme() {
    const html    = document.documentElement;
    const current = html.getAttribute('data-theme');
    const next    = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    localStorage.setItem('dashboardTheme', next);
    if (typeof updateChartsTheme === 'function') updateChartsTheme(next);
}
document.addEventListener('DOMContentLoaded', function () {
    const saved = localStorage.getItem('dashboardTheme') || 'light';
    document.documentElement.setAttribute('data-theme', saved);

    // Enter para buscar en Intune
    var is = document.getElementById('intuneSearch');
    if (is) is.addEventListener('keydown', function(e){ if(e.key==='Enter') loadIntune(true); });

    // Deep-link: /equipment?tab=cfg activa el panel de configuración sin tab button visible
    var _tabQ = new URLSearchParams(location.search).get('tab');
    if (_tabQ === 'cfg') {
        switchEqTab('cfg', null);
        // Mostrar el panel aunque no haya botón activo en la barra
        var p = document.getElementById('tab-cfg');
        if (p) p.classList.add('active');
        document.querySelectorAll('.eq-panel').forEach(function(el){ if (el.id !== 'tab-cfg') el.classList.remove('active'); });
    }
});

// ── HELPER ───────────────────────────────────────────────────────────────────
function _esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function _msgMsLogin(cols) {
    return '<tr><td colspan="' + cols + '" class="text-center py-5">'
        + '<i class="bi bi-microsoft" style="font-size:36px;display:block;margin-bottom:12px;color:#0078d4;"></i>'
        + '<p style="font-weight:700;font-size:14px;margin-bottom:6px;color:var(--text-main);">Requiere inicio de sesión con Microsoft</p>'
        + '<p style="font-size:12px;color:var(--text-muted);margin-bottom:16px;">Esta pestaña usa Azure AD / Intune. Debes ingresar con tu cuenta Microsoft para ver los datos.</p>'
        + '<a href="/api/auth/microsoft" style="display:inline-flex;align-items:center;gap:8px;background:#0078d4;color:#fff;padding:10px 20px;border-radius:8px;text-decoration:none;font-size:13px;font-weight:600;">'
        + '<i class="bi bi-microsoft"></i> Iniciar sesión con Microsoft</a>'
        + '</td></tr>';
}

function _fmtSync(dt) {
    if (!dt) return '—';
    var d = new Date(dt);
    return d.toLocaleString('es-PE', {day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit'});
}

// ── TABS ─────────────────────────────────────────────────────────────────────
var _intuneLoaded = false, _compLoaded = false, _appsTabLoaded = false, _blLoaded = false, _rmmLoaded = false, _scriptsLoaded = false, _almacenLoaded = false, _asgLoaded = false;
function switchEqTab(name, btn) {
    document.querySelectorAll('.eq-panel').forEach(function(p){ p.classList.remove('active'); });
    document.querySelectorAll('.eq-tab-btn').forEach(function(b){ b.classList.remove('active'); });
    var panel = document.getElementById('tab-' + name);
    if (panel) panel.classList.add('active');
    if (btn) btn.classList.add('active');
    // Scroll al inicio para que el contenido del nuevo tab sea visible
    var tabNav = document.querySelector('.eq-tabs');
    if (tabNav) tabNav.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (name === 'dispositivos' && !_intuneLoaded) { _intuneLoaded = true; loadIntune(); }
    if (name === 'cumplimiento' && !_compLoaded)   { _compLoaded   = true; loadCompliance(); }
    if (name === 'apps'         && !_appsTabLoaded){ _appsTabLoaded = true; loadAppsTab(); }
    if (name === 'bitlocker'    && !_blLoaded)      { _blLoaded      = true; loadBitLocker(); }
    if (name === 'rmm'          && !_rmmLoaded)     { _rmmLoaded     = true; loadRMM(); loadRMMAlertStats(); }
    if (name === 'cfg'          && !_scriptsLoaded) { _scriptsLoaded = true; loadScriptsCols(); }
    if (name === 'almacen'      && !_almacenLoaded) { _almacenLoaded  = true; loadAlmacen(); }
    if (name === 'asignaciones' && !_asgLoaded)     { _asgLoaded = true; loadAsgData(); initAsgModalAC(); }
    // URL sync para tab=asignaciones
    var url = new URL(window.location);
    if (name === 'asignaciones') { url.searchParams.set('tab','asignaciones'); } else { url.searchParams.delete('tab'); }
    window.history.replaceState({}, '', url);
}

// ── ASIGNACIONES ─────────────────────────────────────────────────────────────
var ASG_DATA=[],ASG_FILTERED=[],ASG_PAGE=1,ASG_PER_PAGE=25;
var asgChart=null,asgActivePill='all',asgSearchTerm='';

function _asgFmtDate(d){ if(!d)return'—'; var dt=new Date(d); return isNaN(dt)?d:dt.toLocaleDateString('es-PE'); }
function _asgIsDark(){ return document.documentElement.getAttribute('data-theme')==='dark'; }

async function loadAsgData(){
  document.getElementById('asgTableBody').innerHTML='<tr><td colspan="10" class="asg-empty"><i class="bi bi-arrow-repeat spin-anim"></i><p>Cargando asignaciones...</p></td></tr>';
  try{
    var res=await fetch('/api/assignments',{credentials:'include'});
    var json=await res.json();
    if(!json.success)throw new Error(json.message||json.error||'Error API');
    ASG_DATA=json.data||[];
    renderAsgKPIs(); renderAsgChart(); renderAsgTopModels(); applyAsgFilters();
  }catch(e){
    document.getElementById('asgTableBody').innerHTML='<tr><td colspan="10" class="asg-empty"><i class="bi bi-exclamation-triangle-fill"></i><p>Error: '+e.message+'</p></td></tr>';
  }
}

function renderAsgKPIs(){
  var now=new Date(),y=now.getFullYear(),m=now.getMonth();
  var esteMes=ASG_DATA.filter(function(a){ var d=new Date(a.assignment_date); return d.getFullYear()===y&&d.getMonth()===m; }).length;
  var byEmp={}; ASG_DATA.forEach(function(a){ byEmp[a.employee_cip]=(byEmp[a.employee_cip]||0)+1; });
  var multi=Object.values(byEmp).filter(function(v){ return v>1; }).length;
  var sorted=[].concat(ASG_DATA).sort(function(a,b){ return new Date(b.assignment_date)-new Date(a.assignment_date); });
  var ultima=sorted[0]?_asgFmtDate(sorted[0].assignment_date):'—';
  var byModel={}; ASG_DATA.forEach(function(a){ byModel[a.equipment_model]=(byModel[a.equipment_model]||0)+1; });
  var modelTop=Object.entries(byModel).sort(function(a,b){ return b[1]-a[1]; })[0];
  var byDept={}; ASG_DATA.forEach(function(a){ var d=a.department_name||'Sin depto'; byDept[d]=(byDept[d]||0)+1; });
  var deptTop=Object.entries(byDept).sort(function(a,b){ return b[1]-a[1]; })[0];
  function _s(id,v){ var el=document.getElementById(id); if(el)el.textContent=v; }
  _s('asgTotal',ASG_DATA.length); _s('asgEsteMes',esteMes); _s('asgMulti',multi);
  _s('asgUltima',ultima); _s('asgModeloTop',modelTop?modelTop[0]:'—');
  _s('asgDeptoTop',deptTop?deptTop[0].substring(0,18)+(deptTop[0].length>18?'…':''):'—');
}

function renderAsgChart(){
  var dark=_asgIsDark();
  var grid=dark?'rgba(255,255,255,.04)':'rgba(0,0,0,.04)', tick=dark?'#94a3b8':'#64748b';
  var months=[],counts={};
  for(var i=11;i>=0;i--){ var d=new Date(); d.setMonth(d.getMonth()-i); var key=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0'); var label=d.toLocaleDateString('es-PE',{month:'short',year:'2-digit'}); months.push({key,label}); counts[key]=0; }
  ASG_DATA.forEach(function(a){ if(!a.assignment_date)return; var k=a.assignment_date.substring(0,7); if(counts[k]!==undefined)counts[k]++; });
  var labels=months.map(function(m){ return m.label; }), data=months.map(function(m){ return counts[m.key]; });
  var maxVal=Math.max.apply(null,data);
  var pClr=dark?'#60a5fa':'#3b82f6', dClr=dark?'rgba(96,165,250,.25)':'rgba(59,130,246,.2)';
  var colors=data.map(function(v){ return v===maxVal&&v>0?pClr:dClr; });
  var ctx=document.getElementById('asgChartBar');
  if(!ctx)return;
  if(asgChart)asgChart.destroy();
  asgChart=new Chart(ctx.getContext('2d'),{type:'bar',data:{labels,datasets:[{data,backgroundColor:colors,borderRadius:6,borderSkipped:false}]},options:{responsive:true,maintainAspectRatio:true,plugins:{legend:{display:false},tooltip:{callbacks:{label:function(c){ return ' '+c.parsed.y+' asignaciones'; }}}},scales:{y:{beginAtZero:true,grid:{color:grid},ticks:{color:tick,font:{size:11},precision:0}},x:{grid:{display:false},ticks:{color:tick,font:{size:11}}}}}});
}

function dlAsgChart(){ if(!asgChart)return; var a=document.createElement('a'); a.download='asignaciones_chart_'+new Date().toISOString().split('T')[0]+'.png'; a.href=asgChart.toBase64Image(); a.click(); }

function renderAsgTopModels(){
  var byModel={}; ASG_DATA.forEach(function(a){ var k=a.equipment_model||'Sin modelo'; byModel[k]=(byModel[k]||0)+1; });
  var top=Object.entries(byModel).sort(function(a,b){ return b[1]-a[1]; }).slice(0,8);
  var maxCount=top[0]?top[0][1]:1;
  document.getElementById('asgTopModelos').innerHTML=top.map(function(item,i){
    var name=item[0], count=item[1];
    return '<li class="top-list-item"><span class="rank-badge rank-'+(i+1)+'">'+(i+1)+'</span><span class="top-name" title="'+name+'">'+name+'</span><div class="top-bar-wrap"><div class="top-bar" style="width:'+Math.round(count/maxCount*100)+'%"></div></div><span class="top-count">'+count+'</span></li>';
  }).join('');
}

function setAsgPill(pill){
  asgActivePill=pill;
  ['all','month','multi'].forEach(function(p){ document.getElementById('apill-'+p).classList.toggle('active',p===pill); });
  ASG_PAGE=1; applyAsgFilters();
}

function applyAsgFilters(){
  var term=asgSearchTerm.toLowerCase(), now=new Date(), monthAgo=new Date(now.getFullYear(),now.getMonth()-1,now.getDate());
  var byEmp={}; ASG_DATA.forEach(function(a){ byEmp[a.employee_cip]=(byEmp[a.employee_cip]||0)+1; });
  ASG_FILTERED=ASG_DATA.filter(function(a){
    if(asgActivePill==='month'&&new Date(a.assignment_date)<monthAgo)return false;
    if(asgActivePill==='multi'&&(byEmp[a.employee_cip]||0)<=1)return false;
    if(term){ var hay=[a.employee_name,a.employee_cip,a.equipment_code,a.equipment_model,a.department_name,a.location_name,a.assignment_id].join(' ').toLowerCase(); if(!hay.includes(term))return false; }
    return true;
  });
  document.getElementById('asgTableCount').textContent=ASG_FILTERED.length;
  renderAsgTable(); renderAsgPagination();
}

function _asgEqIcon(type){
  var map={Laptop:'asg-eq-laptop bi-laptop',Desktop:'asg-eq-desktop bi-pc-display',Monitor:'asg-eq-monitor bi-display',Tablet:'asg-eq-tablet bi-tablet'};
  var cls=map[type]||'asg-eq-other bi-device-hdd'; var parts=cls.split(' ');
  return '<span class="asg-eq-icon '+parts[0]+'"><i class="bi '+parts[1]+'"></i></span>';
}
function _asgTypePill(type){
  var map={Laptop:'ap-blue',Desktop:'ap-green',Monitor:'ap-yellow',Tablet:'ap-purple'};
  return '<span class="asg-pill '+(map[type]||'ap-gray')+'">'+( type||'—')+'</span>';
}

function renderAsgTable(){
  var start=(ASG_PAGE-1)*ASG_PER_PAGE, page=ASG_FILTERED.slice(start,start+ASG_PER_PAGE);
  var sevenAgo=new Date(Date.now()-7*24*60*60*1000);
  if(!page.length){ document.getElementById('asgTableBody').innerHTML='<tr><td colspan="10" class="asg-empty"><i class="bi bi-inbox"></i><p>Sin asignaciones</p></td></tr>'; return; }
  document.getElementById('asgTableBody').innerHTML=page.map(function(a){
    var isRecent=a.assignment_date&&new Date(a.assignment_date)>=sevenAgo;
    return '<tr class="'+(isRecent?'row-recent':'')+'"><td><span style="font-family:monospace;font-size:11px;color:var(--text-muted)">#'+a.assignment_id+'</span></td>'+
      '<td style="text-align:left;"><strong style="font-size:13px">'+( a.employee_name||'—')+'</strong></td>'+
      '<td><span style="font-family:monospace;font-size:12px">'+( a.employee_cip||'—')+'</span></td>'+
      '<td style="text-align:left;">'+_asgEqIcon(a.equipment_type)+'<strong>'+( a.equipment_code||'—')+'</strong></td>'+
      '<td>'+( a.equipment_model||'—')+'</td>'+
      '<td>'+_asgTypePill(a.equipment_type)+'</td>'+
      '<td style="font-size:12px;color:var(--text-muted)">'+_asgFmtDate(a.assignment_date)+'</td>'+
      '<td style="font-size:12px">'+( a.department_name||'—')+'</td>'+
      '<td style="font-size:12px">'+( a.location_name||'—')+'</td>'+
      '<td style="white-space:nowrap;">'+
        '<button class="asg-btn-primary" style="padding:4px 9px;font-size:11px;margin-right:3px;" title="Editar" onclick=\'openEditAsg('+JSON.stringify(a)+')\'><i class="bi bi-pencil-fill"></i></button>'+
        '<button class="asg-btn-warning" style="padding:4px 9px;font-size:11px;margin-right:3px;background:#f59e0b;color:#fff;border:none;border-radius:6px;cursor:pointer;" title="Devolver equipo" onclick="confirmReturn('+a.assignment_id+',\''+( a.equipment_code||'')+'\',' +'\''+( a.employee_name||'')+'\')"><i class="bi bi-box-arrow-in-left"></i></button>'+
        '<button class="asg-btn-info" style="padding:4px 9px;font-size:11px;background:#06b6d4;color:#fff;border:none;border-radius:6px;cursor:pointer;" title="Transferir a otro empleado" onclick="openTransferModal('+a.assignment_id+',\''+( a.equipment_code||'')+'\')"><i class="bi bi-arrow-left-right"></i></button>'+
      '</td></tr>';
  }).join('');
}

function renderAsgPagination(){
  var total=ASG_FILTERED.length, pages=Math.ceil(total/ASG_PER_PAGE);
  var start2=Math.min((ASG_PAGE-1)*ASG_PER_PAGE+1,total), end2=Math.min(ASG_PAGE*ASG_PER_PAGE,total);
  document.getElementById('asgPagInfo').textContent=total>0?(start2.toLocaleString()+'–'+end2.toLocaleString()+' de '+total.toLocaleString()+' asignaciones'):'Sin resultados';
  var btns=document.getElementById('asgPagBtns');
  if(pages<=1){ btns.innerHTML=''; return; }
  var h='<button class="asg-pg-btn" onclick="goAsgPage('+(ASG_PAGE-1)+')" '+(ASG_PAGE===1?'disabled':'')+'>‹</button>';
  var s=Math.max(1,ASG_PAGE-2), e2=Math.min(pages,ASG_PAGE+2);
  if(s>1)h+='<button class="asg-pg-btn" onclick="goAsgPage(1)">1</button>'+(s>2?'<span style="padding:0 4px;color:var(--text-muted)">…</span>':'');
  for(var p=s;p<=e2;p++) h+='<button class="asg-pg-btn '+(p===ASG_PAGE?'active':'')+'" onclick="goAsgPage('+p+')">'+p+'</button>';
  if(e2<pages)h+=(e2<pages-1?'<span style="padding:0 4px;color:var(--text-muted)">…</span>':'')+'<button class="asg-pg-btn" onclick="goAsgPage('+pages+')">'+pages+'</button>';
  h+='<button class="asg-pg-btn" onclick="goAsgPage('+(ASG_PAGE+1)+')" '+(ASG_PAGE>=pages?'disabled':'')+'>›</button>';
  btns.innerHTML=h;
}
function goAsgPage(p){ ASG_PAGE=p; renderAsgTable(); renderAsgPagination(); }

function exportAsg(fmt){
  if(!ASG_FILTERED.length){ return; }
  var rows=ASG_FILTERED.map(function(a){ return {ID:a.assignment_id,Empleado:a.employee_name,CIP:a.employee_cip,Equipo:a.equipment_code,Modelo:a.equipment_model,Tipo:a.equipment_type,Fecha:a.assignment_date,Departamento:a.department_name,Ubicacion:a.location_name}; });
  var ws=XLSX.utils.json_to_sheet(rows), wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'Asignaciones');
  XLSX.writeFile(wb,'asignaciones_'+new Date().toISOString().split('T')[0]+'.'+(fmt==='excel'?'xlsx':'csv'));
}

// ── DEVOLVER EQUIPO ───────────────────────────────────────────────────────────
async function confirmReturn(assignmentId, equipCode, empName){
  if(!confirm('¿Confirmar devolución?\n\nEquipo: '+equipCode+'\nEmpleado: '+empName+'\n\nEl equipo pasará a estado Disponible.')) return;
  try {
    var r = await fetch('/api/assignments/'+assignmentId+'/return', { method:'PUT', credentials:'include', headers:{'Content-Type':'application/json'}, body:'{}' });
    var j = await r.json();
    if(!r.ok || !j.success) { alert('Error: '+(j.message||j.error||'Error al devolver')); return; }
    _asgToast('✅ Equipo '+equipCode+' devuelto correctamente', '#10b981');
    loadAsgData();
    if(typeof initEquipmentTable === 'function') initEquipmentTable();
  } catch(e) { alert('Error de red: '+e.message); }
}

// ── MODAL TRANSFERIR ──────────────────────────────────────────────────────────
function openTransferModal(assignmentId, equipCode){
  var period = new Date().toISOString().slice(0,7).replace('-','');
  var newEmpId = prompt('Transferir equipo '+equipCode+'\n\nIngresa el ID del nuevo empleado (número):');
  if(!newEmpId || isNaN(parseInt(newEmpId))) return;
  if(!confirm('¿Confirmar transferencia del equipo '+equipCode+' al empleado ID '+newEmpId+'?')) return;
  fetch('/api/assignments/'+assignmentId+'/transfer', {
    method:'POST', credentials:'include',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ new_employee_id: parseInt(newEmpId), period: period })
  }).then(function(r){ return r.json(); }).then(function(j){
    if(!j.success){ alert('Error: '+(j.message||j.error||'Error al transferir')); return; }
    _asgToast('✅ Equipo transferido correctamente', '#06b6d4');
    loadAsgData();
  }).catch(function(e){ alert('Error de red: '+e.message); });
}

function _asgToast(msg, color){
  var t=document.createElement('div');
  t.style.cssText='position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;background:'+color+';color:#fff;padding:.75rem 1.25rem;border-radius:8px;font-size:.85rem;font-weight:700;box-shadow:0 4px 16px rgba(0,0,0,.2);transition:opacity .4s;';
  t.textContent=msg; document.body.appendChild(t);
  setTimeout(function(){ t.style.opacity='0'; setTimeout(function(){ t.remove(); }, 400); }, 3000);
}

// Autocomplete modales ASG
var _asgACTimer=null;
function _asgSetupAC(inputId,resultsId,url,handlers,minLen){
  minLen=minLen||2;
  var input=document.getElementById(inputId), results=document.getElementById(resultsId);
  if(!input||!results)return;
  input.addEventListener('input',function(){
    clearTimeout(_asgACTimer);
    var val=input.value.trim();
    if(val.length<minLen){ results.style.display='none'; return; }
    _asgACTimer=setTimeout(async function(){
      try{
        var res=await fetch(url+encodeURIComponent(val),{credentials:'include'});
        var json=await res.json();
        var items=json.data||[];
        results.innerHTML=items.length
          ?items.slice(0,8).map(function(item,i){ return handlers.render(item,i); }).join('')
          :'<div class="asg-ac-item" style="cursor:default;color:var(--text-muted)">Sin resultados</div>';
        results.querySelectorAll('[data-idx]').forEach(function(el,idx){ el.dataset.idx=idx; el.addEventListener('click',function(){ handlers.pick(items[parseInt(el.dataset.idx)]); results.style.display='none'; }); });
        results.style.display='block';
      }catch(e){ results.style.display='none'; }
    },300);
  });
  document.addEventListener('click',function(e){ if(!input.contains(e.target)&&!results.contains(e.target)) results.style.display='none'; });
}

