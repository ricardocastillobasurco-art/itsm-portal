// ═══════════════════════════════════════════════════════════════════════════
// RMM — Context menu
// ═══════════════════════════════════════════════════════════════════════════
var _rmmCtxNodeId = null, _rmmCtxName = null, _rmmCtxOnline = false;

function showRMMCtx(e, nodeId, name, online) {
    e.preventDefault(); e.stopPropagation();
    _rmmCtxNodeId = nodeId; _rmmCtxName = name; _rmmCtxOnline = !!online;
    var onlineOnly = ['rmmCtxKvm','rmmCtxTerm','rmmCtxProc','rmmCtxSvc','rmmCtxSw',
                      'rmmCtxEvt','rmmCtxMet','rmmCtxTasks','rmmCtxUsers','rmmCtxNet',
                      'rmmCtxReset','rmmCtxSleep','rmmCtxOff','rmmCtxUpd','rmmCtxDeploy','rmmCtxChat'];
    onlineOnly.forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.classList.toggle('disabled', !online);
    });
    var m = document.getElementById('rmmCtxMenu');
    m.style.display = 'block';
    var x = e.clientX, y = e.clientY;
    m.style.left = '-9999px'; m.style.top = '-9999px';
    requestAnimationFrame(function() {
        var mw = m.offsetWidth || 210, mh = m.offsetHeight || 320;
        if (x + mw > window.innerWidth)  x = window.innerWidth  - mw - 8;
        if (y + mh > window.innerHeight) y = window.innerHeight - mh - 8;
        m.style.left = x + 'px'; m.style.top = y + 'px';
    });
    document.addEventListener('mousedown', _rmmCtxDismiss, { once: true });
}

function hideRMMCtx() {
    document.getElementById('rmmCtxMenu').style.display = 'none';
}

function _rmmCtxDismiss(e) {
    var m = document.getElementById('rmmCtxMenu');
    if (m && !m.contains(e.target)) hideRMMCtx();
}

function rmmCtxDoKvm()  { hideRMMCtx(); connectRMM(_rmmCtxNodeId, _rmmCtxName, ''); }
function rmmCtxDoInv()  { hideRMMCtx(); openRMMInventory(_rmmCtxNodeId, _rmmCtxName, _rmmCtxOnline ? 1 : 0, ''); }
function rmmCtxDoTools(tab) { hideRMMCtx(); openRMMTools(_rmmCtxNodeId, _rmmCtxName, tab); }
function rmmCtxDoToast(){ hideRMMCtx(); openRMMToast(_rmmCtxNodeId, _rmmCtxName); }
function rmmCtxDoPower(action){ hideRMMCtx(); openRMMPower(_rmmCtxNodeId, _rmmCtxName, action); }

var _rmmTermNodeId = null;

function rmmCtxDoTerm() { hideRMMCtx(); openRMMTerm(_rmmCtxNodeId, _rmmCtxName); }

function openRMMTerm(nodeId, name) {
    if (!nodeId) return;
    _rmmTermNodeId = nodeId;
    document.getElementById('rmmTermDevName').textContent = name || nodeId;
    document.getElementById('rmmTermStatus').textContent = '';
    var frame   = document.getElementById('rmmTermFrame');
    var loading = document.getElementById('rmmTermLoading');
    frame.style.display = 'none';
    frame.src = 'about:blank';
    loading.style.display = 'flex';
    loading.innerHTML = '<span class="mini-spin" style="border-color:rgba(63,185,80,.3);border-top-color:#3fb950;width:28px;height:28px;border-width:3px;"></span><span>Iniciando sesión de terminal...</span>';
    document.getElementById('rmmTermOverlay').classList.add('show');

    fetch('/api/rmm/session', {
        method:'POST', credentials:'include',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ nodeId: nodeId, viewmode: 1 })
    })
    .then(function(r){ return r.json(); })
    .then(function(d){
        if (!d.ok || !d.url) {
            loading.innerHTML = '<i class="bi bi-exclamation-circle" style="font-size:26px;color:#f85149;"></i><span style="color:#f85149;">' + _esc(d.error || 'No se pudo abrir la terminal') + '</span>';
            return;
        }
        frame.src = d.url;
        frame.onload = function() {
            loading.style.display = 'none';
            frame.style.display = 'block';
            document.getElementById('rmmTermStatus').textContent = 'Conectado';
            document.getElementById('rmmTermStatus').style.color = '#3fb950';
        };
        setTimeout(function() {
            if (loading.style.display !== 'none') {
                loading.style.display = 'none';
                frame.style.display = 'block';
            }
        }, 8000);
    })
    .catch(function(e){
        loading.innerHTML = '<i class="bi bi-exclamation-circle" style="font-size:26px;color:#f85149;"></i><span style="color:#f85149;">Error: ' + _esc(e.message) + '</span>';
    });
}

function closeRMMTerm() {
    document.getElementById('rmmTermOverlay').classList.remove('show');
    var frame = document.getElementById('rmmTermFrame');
    frame.src = 'about:blank';
    document.getElementById('rmmTermStatus').textContent = '';
    _rmmTermNodeId = null;
}

// ═══════════════════════════════════════════════════════════════════════════
// RMM — Power modal
// ═══════════════════════════════════════════════════════════════════════════
var _rmmPowerNodeId = null, _rmmPowerAction = null;

function openRMMPower(nodeId, name, action) {
    _rmmPowerNodeId = nodeId; _rmmPowerAction = action;
    var cfg = {
        reset: { icon:'bi-arrow-repeat', color:'var(--warning)', label:'Reiniciar', warn:'' },
        sleep: { icon:'bi-moon-fill',     color:'var(--info)',    label:'Suspender', warn:'' },
        off:   { icon:'bi-power',         color:'var(--danger)',  label:'Apagar',    warn:'⚠ Esta acción apagará el equipo. El usuario perderá todo lo no guardado.' }
    };
    var c = cfg[action] || cfg.reset;
    document.getElementById('rmmPowerTitle').textContent = c.label + ' — ' + name;
    document.getElementById('rmmPowerIcon').className = 'bi ' + c.icon;
    document.getElementById('rmmPowerIcon').style.color = c.color;
    document.getElementById('rmmPowerDev').textContent = name;
    document.getElementById('rmmPowerWarn').textContent = c.warn;
    var btn = document.getElementById('rmmPowerConfirmBtn');
    btn.className = 'btn btn-sm ' + (action==='off' ? 'btn-danger' : 'btn-warning');
    btn.textContent = 'Confirmar ' + c.label;
    document.getElementById('rmmPowerOverlay').classList.add('show');
}

function doRMMPower() {
    if (!_rmmPowerNodeId || !_rmmPowerAction) return;
    document.getElementById('rmmPowerOverlay').classList.remove('show');
    fetch('/api/rmm/device/power', {
        method:'POST', credentials:'include',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({nodeId:_rmmPowerNodeId, action:_rmmPowerAction})
    }).then(function(r){ return r.json(); }).then(function(d){
        if (!d.ok) alert('Error: ' + (d.error||'desconocido'));
    }).catch(function(e){ alert('Error: ' + e.message); });
}

// ═══════════════════════════════════════════════════════════════════════════
// RMM — Toast modal
// ═══════════════════════════════════════════════════════════════════════════
var _rmmToastNodeId = null;

function openRMMToast(nodeId, name) {
    _rmmToastNodeId = nodeId;
    document.getElementById('rmmToastDev').textContent = name;
    document.getElementById('rmmToastTitle').value = '';
    document.getElementById('rmmToastMsg').value = '';
    document.getElementById('rmmToastOverlay').classList.add('show');
    setTimeout(function(){ document.getElementById('rmmToastMsg').focus(); }, 120);
}

function doRMMToast() {
    var msg = (document.getElementById('rmmToastMsg').value||'').trim();
    if (!msg) { document.getElementById('rmmToastMsg').focus(); return; }
    var title = document.getElementById('rmmToastTitle').value.trim();
    document.getElementById('rmmToastOverlay').classList.remove('show');
    fetch('/api/rmm/device/toast', {
        method:'POST', credentials:'include',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({nodeId:_rmmToastNodeId, title:title||undefined, message:msg})
    }).then(function(r){ return r.json(); }).then(function(d){
        if (!d.ok) alert('Error: ' + (d.error||'desconocido'));
    }).catch(function(e){ alert('Error: ' + e.message); });
}

// ═══════════════════════════════════════════════════════════════════════════
// RMM — Herramientas modal (8 tabs)
// ═══════════════════════════════════════════════════════════════════════════
var _rmmToolsNodeId = null, _rmmToolsName = null, _rmmToolsTab = 'proc';
var _rmmToolsData   = {proc:null,svc:null,sw:null,evt:null,met:null,tasks:null,users:null,net:null,upd:null,deploy:null};
var _rmmToolsEvtLvl = null;

function openRMMTools(nodeId, name, tab) {
    _rmmToolsNodeId = nodeId; _rmmToolsName = name; _rmmToolsTab = tab||'proc';
    _rmmToolsData   = {proc:null,svc:null,sw:null,evt:null,met:null,tasks:null,users:null,net:null};
    _rmmToolsEvtLvl = null;
    document.getElementById('rmmToolsDevName').textContent = name;
    document.getElementById('rmmToolsSearch').value = '';
    document.getElementById('rmmToolsOverlay').classList.add('show');
    switchRMMTab(_rmmToolsTab);
}

function closeRMMTools() {
    document.getElementById('rmmToolsOverlay').classList.remove('show');
    _rmmToolsNodeId = null;
}

function rmmToolsRefresh() {
    _rmmToolsData[_rmmToolsTab] = null;
    _rmmToolsEvtLvl = null;
    loadRMMTab(_rmmToolsTab);
}

function switchRMMTab(tab) {
    _rmmToolsTab = tab;
    ['proc','svc','sw','evt','met','tasks','users','net','upd','deploy','files','rec'].forEach(function(t) {
        document.getElementById('rtab-'+t).classList.toggle('active', t===tab);
    });
    document.getElementById('rmmToolsSearch').value = '';
    _rmmToolsEvtLvl = null;
    loadRMMTab(tab);
}

function rmmToolsFilter(q) {
    if (_rmmToolsTab === 'upd') {
        if (_rmmToolsData['upd'] === null) return;
        var fq = q.toLowerCase().trim();
        var d = _rmmToolsData['upd'];
        var filtered = Object.assign({}, d, { updates: (d.updates||[]).filter(function(u){ return !fq || (u.id||'').toLowerCase().includes(fq) || (u.desc||'').toLowerCase().includes(fq); }) });
        _renderUpdates(filtered);
        return;
    }
    if (_rmmToolsData[_rmmToolsTab]===null || _rmmToolsTab==='met' || _rmmToolsTab==='net') return;
    renderRMMTab(_rmmToolsTab, _rmmToolsData[_rmmToolsTab], q.toLowerCase().trim());
}

var _rmmFilesPath = 'C:\\';

function loadRMMTab(tab) {
    if (!_rmmToolsNodeId) return;
    var content = document.getElementById('rmmToolsContent');
    if (tab === 'upd')    { loadRMMUpdates(); return; }
    if (tab === 'deploy') { loadRMMDeploy(); return; }
    if (tab === 'files')  { loadRMMFiles(_rmmFilesPath); return; }
    if (tab === 'rec')   { loadRMMRecordings(); return; }
    if (_rmmToolsData[tab] !== null) { renderRMMTab(tab, _rmmToolsData[tab]); return; }
    content.innerHTML = '<div class="text-center py-5 text-muted"><span class="mini-spin"></span><p class="mt-2" style="font-size:12px;">Ejecutando en el dispositivo...</p></div>';
    var ep = tab==='proc'?'/api/rmm/device/processes'
           : tab==='svc' ?'/api/rmm/device/services'
           : tab==='evt' ?'/api/rmm/device/eventlog'
           : tab==='met' ?'/api/rmm/device/metrics'
           : tab==='tasks'?'/api/rmm/device/tasks'
           : tab==='users'?'/api/rmm/device/users'
           : tab==='net'  ?'/api/rmm/device/network'
           : '/api/rmm/device/apps';
    fetch(ep, {method:'POST', credentials:'include', headers:{'Content-Type':'application/json'}, body:JSON.stringify({nodeId:_rmmToolsNodeId})})
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (!d.ok) { content.innerHTML='<div class="text-danger text-center p-4">Error: '+_esc(d.error||'desconocido')+'</div>'; return; }
        _rmmToolsData[tab] = tab==='proc'?d.processes : tab==='svc'?d.services : tab==='evt'?d.events
                           : tab==='met'?d.metrics   : tab==='tasks'?d.tasks  : tab==='users'?d.users
                           : tab==='net'?d.network   : d.apps;
        renderRMMTab(tab, _rmmToolsData[tab]||[]);
    })
    .catch(function(e){ content.innerHTML='<div class="text-danger text-center p-4">'+_esc(e.message)+'</div>'; });
}

function setRMMEvtLvl(lvl) {
    _rmmToolsEvtLvl = lvl;
    if (_rmmToolsData['evt'] !== null) renderRMMTab('evt', _rmmToolsData['evt']);
}

function _rmmMetBar(label, value, pct, color) {
    var s = Math.min(Math.max(pct||0,0),100);
    return '<div class="rmm-mbar-item">'
        + '<div class="rmm-mbar-label"><span>'+_esc(label)+'</span><span style="color:'+color+';">'+s+'% &nbsp;'+_esc(value)+'</span></div>'
        + '<div class="rmm-mbar-track"><div class="rmm-mbar-fill" style="width:'+s+'%;background:'+color+';"></div></div>'
        + '</div>';
}

function renderRMMTab(tab, data, filter) {
    var content = document.getElementById('rmmToolsContent');
    var info    = document.getElementById('rmmToolsInfo');

    // ── Métricas ──────────────────────────────────────────────────────────
    if (tab === 'met') {
        var m = data;
        if (!m || m.error) { content.innerHTML='<div class="text-danger text-center p-4">'+(m&&m.error?_esc(m.error):'Sin datos')+'</div>'; return; }
        var cc = m.cpu>80?'var(--danger)':m.cpu>60?'var(--warning)':'var(--success)';
        var rc = m.usedPct>80?'var(--danger)':m.usedPct>60?'var(--warning)':'var(--success)';
        var dk = (m.disks||[]).map(function(d){
            var c=d.p>85?'var(--danger)':d.p>70?'var(--warning)':'var(--primary)';
            return _rmmMetBar('Disco '+d.d,(d.t-d.f).toFixed(1)+' / '+d.t+' GB',d.p,c);
        }).join('');
        content.innerHTML='<div class="rmm-mbar-wrap">'
            +'<div style="font-size:11px;color:var(--text-muted);text-align:right;margin-bottom:14px;">Snapshot: '+_esc(m.ts||'—')+'</div>'
            +_rmmMetBar('CPU',m.cpu+'%',m.cpu,cc)
            +_rmmMetBar('RAM',(m.usedMB/1024).toFixed(1)+' / '+(m.totalMB/1024).toFixed(1)+' GB',m.usedPct,rc)
            +dk+'</div>';
        info.textContent='Snapshot '+_esc(m.ts||'');
        return;
    }

    // ── Red ───────────────────────────────────────────────────────────────
    if (tab === 'net') {
        var net = data;
        if (!net || net.error) { content.innerHTML='<div class="text-danger text-center p-4">'+(net&&net.error?_esc(net.error):'Sin datos')+'</div>'; return; }
        var ips  = Array.isArray(net.ips)      ? net.ips      : [];
        var gws  = Array.isArray(net.gateways) ? net.gateways : [];
        var dnss = Array.isArray(net.dns)      ? net.dns      : [];
        var ads  = Array.isArray(net.adapters) ? net.adapters : [];
        info.textContent = ips.length + ' interfaz(ces)';
        var rows = ips.map(function(ip) {
            var gw  = (gws.find(function(g){return g.iface===ip.iface;})||{}).gw||'—';
            var dns = (dnss.find(function(d){return d.iface===ip.iface;})||{}).servers||'—';
            var ad  = ads.find(function(a){return a.name===ip.iface;})||{};
            return '<tr>'
                +'<td style="font-weight:600;">'+_esc(ip.iface||'')+'</td>'
                +'<td style="font-family:monospace;font-size:12px;">'+_esc(ip.ip||'')+'<span style="color:var(--text-muted);">/'+ip.prefix+'</span></td>'
                +'<td style="font-family:monospace;font-size:12px;">'+_esc(gw)+'</td>'
                +'<td style="font-size:11px;color:var(--text-muted);">'+_esc(dns)+'</td>'
                +'<td style="font-size:11px;color:var(--text-muted);">'+_esc(ad.mac||'')+'</td>'
                +'<td style="font-size:11px;color:var(--text-muted);">'+_esc(ad.speed||'')+'</td></tr>';
        });
        content.innerHTML='<div style="overflow-x:auto;"><table class="rmm-ttbl"><thead><tr><th>Interfaz</th><th>IP</th><th>Gateway</th><th>DNS</th><th>MAC</th><th>Velocidad</th></tr></thead><tbody>'+(rows.length?rows.join(''):'<tr><td colspan="6" class="text-center text-muted py-4">Sin interfaces activas</td></tr>')+'</tbody></table></div>';
        return;
    }

    // ── Event Log ─────────────────────────────────────────────────────────
    if (tab === 'evt') {
        var all  = data || [];
        var lf   = _rmmToolsEvtLvl;
        var list = lf ? all.filter(function(e){ return e.lvl===lf; }) : all;
        if (filter) list = list.filter(function(e){ return JSON.stringify(e).toLowerCase().includes(filter); });
        var levels = [{lbl:'Todos',val:null,c:'var(--text-muted)'},{lbl:'Critical',val:'Critical',c:'#dc2626'},{lbl:'Error',val:'Error',c:'var(--danger)'},{lbl:'Warning',val:'Warning',c:'var(--warning)'}];
        var fbar = '<div class="rmm-evt-bar">'+levels.map(function(l){
            var ac = l.val===lf;
            return '<button class="rmm-evt-btn'+(ac?' active':'')+'" style="color:'+l.c+';'+(ac?'background:'+l.c+'1a;border-color:'+l.c+';':'')+'" onclick="setRMMEvtLvl('+JSON.stringify(l.val)+')">'+_esc(l.lbl)+'</button>';
        }).join('')+'<span style="margin-left:auto;font-size:11px;color:var(--text-muted);">'+list.length+' eventos</span></div>';
        info.textContent = list.length+' de '+all.length+' eventos';
        if (!list.length) { content.innerHTML=fbar+'<div class="text-center text-muted py-5">Sin eventos para el filtro seleccionado</div>'; return; }
        content.innerHTML=fbar+'<div style="overflow-x:auto;"><table class="rmm-ttbl"><thead><tr><th>Fecha/Hora</th><th>Nivel</th><th>Fuente</th><th>Mensaje</th></tr></thead><tbody>'+
            list.map(function(e){
                var lc=e.lvl==='Critical'?'#dc2626':e.lvl==='Error'?'var(--danger)':'var(--warning)';
                var badge='<span style="font-size:10px;padding:2px 7px;border-radius:10px;background:'+lc+'22;color:'+lc+';font-weight:700;white-space:nowrap;">'+_esc(e.lvl)+'</span>';
                return '<tr><td style="font-size:11px;font-family:monospace;white-space:nowrap;">'+_esc(e.t||'')+'</td><td>'+badge+'</td>'
                    +'<td style="font-size:11px;color:var(--text-muted);white-space:nowrap;max-width:150px;overflow:hidden;text-overflow:ellipsis;">'+_esc(e.src||'')+'</td>'
                    +'<td style="font-size:12px;max-width:380px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="'+_esc(e.msg||'')+'">'+_esc(e.msg||'')+'</td></tr>';
            }).join('')+'</tbody></table></div>';
        return;
    }

    // ── Tablas genéricas (proc / svc / sw / tasks / users) ───────────────
    var list2 = filter
        ? data.filter(function(r){ return JSON.stringify(r).toLowerCase().includes(filter); })
        : data;

    if (tab === 'proc') {
        info.textContent = list2.length+' procesos';
        if (!list2.length) { content.innerHTML='<div class="text-center text-muted py-5">Sin procesos</div>'; return; }
        content.innerHTML='<table class="rmm-ttbl"><thead><tr><th>Proceso</th><th class="rmm-num">PID</th><th class="rmm-num">CPU (s)</th><th class="rmm-num">RAM (MB)</th><th></th></tr></thead><tbody>'+
            list2.map(function(p){
                var cs=p.cpu>10?'color:var(--danger);font-weight:700;':p.cpu>2?'color:var(--warning);':'';
                return '<tr><td style="font-weight:600;">'+_esc(p.name)+'</td>'
                    +'<td class="rmm-num" style="color:var(--text-muted);">'+p.pid+'</td>'
                    +'<td class="rmm-num" style="'+cs+'">'+p.cpu+'</td>'
                    +'<td class="rmm-num">'+p.mem+'</td>'
                    +'<td style="text-align:right;"><button class="btn btn-sm btn-outline-danger" style="padding:2px 8px;font-size:11px;" onclick="rmmKillProc('+p.pid+',\''+_esc(p.name)+'\')"><i class="bi bi-x-circle"></i></button></td></tr>';
            }).join('')+'</tbody></table>';
    } else if (tab === 'svc') {
        info.textContent = list2.length+' servicios';
        if (!list2.length) { content.innerHTML='<div class="text-center text-muted py-5">Sin servicios</div>'; return; }
        content.innerHTML='<table class="rmm-ttbl"><thead><tr><th>Servicio</th><th>Estado</th><th></th></tr></thead><tbody>'+
            list2.map(function(s){
                var run=s.status==='Running', stp=s.status==='Stopped';
                var bc=run?'var(--success)':stp?'var(--danger)':'var(--warning)';
                var badge='<span style="font-size:10px;padding:2px 8px;border-radius:20px;background:'+bc+'22;color:'+bc+';font-weight:700;">'+_esc(s.status)+'</span>';
                return '<tr><td><div style="font-weight:600;font-size:12.5px;">'+_esc(s.display||s.name)+'</div><div style="font-size:10px;color:var(--text-muted);font-family:monospace;">'+_esc(s.name)+'</div></td>'
                    +'<td>'+badge+'</td>'
                    +'<td style="text-align:right;white-space:nowrap;display:flex;gap:3px;justify-content:flex-end;">'
                    +(!run?'<button class="btn btn-sm btn-outline-success" style="padding:2px 7px;font-size:11px;" title="Iniciar" onclick="rmmSvcAction(\''+_esc(s.name)+'\',\'start\')"><i class="bi bi-play-fill"></i></button>':'')
                    +(run?'<button class="btn btn-sm btn-outline-danger" style="padding:2px 7px;font-size:11px;" title="Detener" onclick="rmmSvcAction(\''+_esc(s.name)+'\',\'stop\')"><i class="bi bi-stop-fill"></i></button>':'')
                    +'<button class="btn btn-sm btn-outline-secondary" style="padding:2px 7px;font-size:11px;" title="Reiniciar" onclick="rmmSvcAction(\''+_esc(s.name)+'\',\'restart\')"><i class="bi bi-arrow-repeat"></i></button>'
                    +'</td></tr>';
            }).join('')+'</tbody></table>';
    } else if (tab === 'tasks') {
        info.textContent = list2.length+' tareas';
        if (!list2.length) { content.innerHTML='<div class="text-center text-muted py-5">Sin tareas</div>'; return; }
        var stCol={'Ready':'var(--success)','Running':'var(--primary)','Disabled':'var(--text-muted)','Queued':'var(--warning)'};
        content.innerHTML='<table class="rmm-ttbl"><thead><tr><th>Tarea</th><th>Estado</th><th>Última ejecución</th><th>Próxima</th><th></th></tr></thead><tbody>'+
            list2.map(function(t){
                var sc=stCol[t.state]||'var(--text-muted)';
                var badge='<span style="font-size:10px;padding:2px 8px;border-radius:20px;background:'+sc+'22;color:'+sc+';font-weight:700;">'+_esc(t.state||'')+'</span>';
                var runBtn=t.state!=='Disabled'?'<button class="btn btn-sm btn-outline-success" style="padding:2px 7px;font-size:11px;" title="Ejecutar" onclick="rmmTaskRun(\''+_esc(t.name)+'\')"><i class="bi bi-play-fill"></i></button>':'';
                return '<tr><td><div style="font-weight:600;">'+_esc(t.name)+'</div><div style="font-size:10px;color:var(--text-muted);font-family:monospace;">'+_esc(t.path||'')+'</div></td>'
                    +'<td>'+badge+'</td>'
                    +'<td style="font-size:11px;color:var(--text-muted);white-space:nowrap;">'+_esc(t.lastRun||'—')+'</td>'
                    +'<td style="font-size:11px;color:var(--text-muted);white-space:nowrap;">'+_esc(t.nextRun||'—')+'</td>'
                    +'<td style="text-align:right;">'+runBtn+'</td></tr>';
            }).join('')+'</tbody></table>';
    } else if (tab === 'users') {
        info.textContent = list2.length+' usuarios';
        if (!list2.length) { content.innerHTML='<div class="text-center text-muted py-5">Sin usuarios</div>'; return; }
        content.innerHTML='<table class="rmm-ttbl"><thead><tr><th>Usuario</th><th>Estado</th><th>Último inicio</th><th></th></tr></thead><tbody>'+
            list2.map(function(u){
                var ec=u.enabled?'var(--success)':'var(--text-muted)';
                var badge='<span style="font-size:10px;padding:2px 8px;border-radius:20px;background:'+ec+'22;color:'+ec+';font-weight:700;">'+(u.enabled?'Habilitado':'Deshabilitado')+'</span>';
                var act=u.enabled?'disable':'enable', al=u.enabled?'Deshabilitar':'Habilitar', ac=u.enabled?'var(--danger)':'var(--success)';
                return '<tr><td><div style="font-weight:600;">'+_esc(u.name)+'</div>'+(u.full?'<div style="font-size:10px;color:var(--text-muted);">'+_esc(u.full)+'</div>':'')+'</td>'
                    +'<td>'+badge+'</td>'
                    +'<td style="font-size:11px;color:var(--text-muted);white-space:nowrap;">'+_esc(u.lastLogon||'—')+'</td>'
                    +'<td style="text-align:right;"><button class="btn btn-sm btn-outline-secondary" style="padding:2px 8px;font-size:11px;color:'+ac+';border-color:'+ac+'55;" onclick="rmmUserAction(\''+_esc(u.name)+'\',\''+act+'\')">'+al+'</button></td></tr>';
            }).join('')+'</tbody></table>';
    } else {
        // Software
        info.textContent = list2.length+' aplicaciones';
        if (!list2.length) { content.innerHTML='<div class="text-center text-muted py-5">Sin software</div>'; return; }
        content.innerHTML='<table class="rmm-ttbl"><thead><tr><th>Aplicación</th><th>Versión</th><th>Publisher</th><th>Fecha</th></tr></thead><tbody>'+
            list2.map(function(a){
                return '<tr><td style="font-weight:600;">'+_esc(a.name||'')+'</td>'
                    +'<td style="font-size:11px;font-family:monospace;color:var(--text-muted);">'+_esc(a.version||'—')+'</td>'
                    +'<td style="font-size:11px;color:var(--text-muted);">'+_esc(a.publisher||'—')+'</td>'
                    +'<td style="font-size:11px;color:var(--text-muted);">'+_esc(a.date||'—')+'</td></tr>';
            }).join('')+'</tbody></table>';
    }
}

function rmmKillProc(pid, name) {
    if (!confirm('¿Terminar proceso "'+name+'" (PID '+pid+')?')) return;
    fetch('/api/rmm/device/process/kill', {method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({nodeId:_rmmToolsNodeId,pid:pid})})
    .then(function(r){return r.json();}).then(function(d){
        if (d.ok) { _rmmToolsData['proc']=null; loadRMMTab('proc'); }
        else alert('Error: '+(d.error||'desconocido'));
    }).catch(function(e){alert('Error: '+e.message);});
}

function rmmSvcAction(name, action) {
    var labels={start:'iniciado',stop:'detenido',restart:'reiniciado'};
    fetch('/api/rmm/device/service/action',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({nodeId:_rmmToolsNodeId,name:name,action:action})})
    .then(function(r){return r.json();}).then(function(d){
        if (d.ok) { setTimeout(function(){_rmmToolsData['svc']=null;loadRMMTab('svc');},1500); }
        else alert('Error: '+(d.error||'desconocido'));
    }).catch(function(e){alert('Error: '+e.message);});
}

function rmmTaskRun(name) {
    if (!confirm('¿Ejecutar tarea "'+name+'" ahora?')) return;
    fetch('/api/rmm/device/task/run',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({nodeId:_rmmToolsNodeId,name:name})})
    .then(function(r){return r.json();}).then(function(d){
        if (d.ok) { alert('✔ Tarea "'+name+'" iniciada'); _rmmToolsData['tasks']=null; loadRMMTab('tasks'); }
        else alert('Error: '+(d.error||'desconocido'));
    }).catch(function(e){alert('Error: '+e.message);});
}

// ── Motor de Alertas RMM ─────────────────────────────────────────────────────
var _alertsPanelOpen = false;

function _updateAlertBadge(total) {
    var badge = document.getElementById('rmmAlertBadge');
    var btn   = document.getElementById('rmmAlertBtn');
    var bb    = document.getElementById('rmmAlertBtnBadge');
    var tabBadge = document.getElementById('rmmAlertBadge');
    if (total > 0) {
        if (badge)  { badge.textContent = total; badge.style.display = 'inline'; }
        if (btn)    btn.style.display = 'inline-flex';
        if (bb)     bb.textContent = total;
    } else {
        if (badge)  badge.style.display = 'none';
        if (btn)    btn.style.display = 'none';
    }
}

function loadRMMAlertStats() {
    fetch('/api/rmm/alerts/stats', {credentials:'include'})
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (d.ok) _updateAlertBadge(d.total || 0);
    }).catch(function(){});
}

function toggleAlertsPanel() {
    _alertsPanelOpen = !_alertsPanelOpen;
    document.getElementById('rmmAlertsPanel').style.display = _alertsPanelOpen ? 'block' : 'none';
    if (_alertsPanelOpen) loadRMMAlerts();
}

var _alertSevColor = { critical: ['#f85149','rgba(248,81,73,.1)'], warning: ['#e3b341','rgba(227,179,65,.1)'], info: ['#58a6ff','rgba(88,166,255,.1)'] };

function loadRMMAlerts() {
    var status = document.getElementById('alertStatusFilter').value;
    var list   = document.getElementById('rmmAlertsList');
    list.innerHTML = '<div class="text-center py-3"><span class="mini-spin"></span></div>';
    fetch('/api/rmm/alerts?status='+encodeURIComponent(status)+'&limit=50', {credentials:'include'})
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (!d.ok) { list.innerHTML='<div class="text-danger text-center p-3">'+_esc(d.error||'Error')+'</div>'; return; }
        _updateAlertBadge((d.stats||{}).total || 0);
        var alerts = d.alerts || [];
        if (!alerts.length) {
            list.innerHTML='<div class="text-center text-muted py-4" style="font-size:12px;"><i class="bi bi-check-circle" style="font-size:24px;display:block;margin-bottom:6px;opacity:.4;"></i>Sin alertas '+_esc(status)+'s</div>';
            return;
        }
        var rows = alerts.map(function(a) {
            var sc = _alertSevColor[a.severity] || _alertSevColor['info'];
            var ts = (a.fired_at||'').substring(0,16).replace('T',' ');
            var btns = '';
            if (a.status === 'open') {
                btns = '<button class="btn btn-sm" style="font-size:10px;padding:1px 7px;border:1px solid var(--border-soft);" onclick="ackAlert('+a.id+')">Reconocer</button> '
                     + '<button class="btn btn-sm" style="font-size:10px;padding:1px 7px;border:1px solid rgba(63,185,80,.4);color:var(--success);" onclick="resolveAlert('+a.id+')">Resolver</button>';
            } else if (a.status === 'acknowledged') {
                btns = '<button class="btn btn-sm" style="font-size:10px;padding:1px 7px;border:1px solid rgba(63,185,80,.4);color:var(--success);" onclick="resolveAlert('+a.id+')">Resolver</button>';
            }
            return '<div style="display:flex;align-items:flex-start;gap:10px;padding:8px 10px;border-bottom:1px solid var(--border-soft);border-left:3px solid '+sc[0]+';background:'+sc[1]+';border-radius:0 6px 6px 0;margin-bottom:4px;">'
                + '<i class="bi bi-exclamation-triangle-fill" style="color:'+sc[0]+';margin-top:2px;flex-shrink:0;"></i>'
                + '<div style="flex:1;">'
                + '<div style="font-size:12px;font-weight:600;">'+_esc(a.node_name||a.node_id)+'</div>'
                + '<div style="font-size:11px;color:var(--text-muted);">'+_esc(a.message)+'</div>'
                + '<div style="font-size:10px;color:var(--text-muted);margin-top:2px;">'+_esc(ts)+(a.ack_by?' · Reconocida por '+_esc(a.ack_by):'')+'</div>'
                + '</div>'
                + '<div style="flex-shrink:0;display:flex;gap:4px;">'+btns+'</div>'
                + '</div>';
        }).join('');
        list.innerHTML = '<div style="max-height:360px;overflow-y:auto;">'+rows+'</div>';
    }).catch(function(e){ list.innerHTML='<div class="text-danger text-center p-3">'+_esc(e.message)+'</div>'; });
}

function ackAlert(id) {
    fetch('/api/rmm/alerts/'+id+'/ack', {method:'PUT', credentials:'include'})
    .then(function(r){return r.json();}).then(function(d){ if(d.ok) loadRMMAlerts(); });
}

function resolveAlert(id) {
    fetch('/api/rmm/alerts/'+id+'/resolve', {method:'PUT', credentials:'include'})
    .then(function(r){return r.json();}).then(function(d){ if(d.ok) loadRMMAlerts(); });
}

// Socket.io: recibir alertas en tiempo real
(function() {
    if (typeof io === 'undefined') return;
    var sock = io({ transports: ['websocket'], reconnection: true });
    sock.emit('joinAgents');
    sock.on('rmm:alert', function(data) {
        loadRMMAlertStats();
        if (_alertsPanelOpen) loadRMMAlerts();
        // Toast rápido
        var msg = (data.nodeName||data.nodeId) + ': ' + (data.message||data.metric);
        var toastEl = document.createElement('div');
        toastEl.style.cssText = 'position:fixed;bottom:20px;right:20px;z-index:99999;background:#1a1a2e;color:#fff;padding:10px 16px;border-radius:8px;border-left:4px solid #f85149;font-size:12px;max-width:320px;box-shadow:0 4px 20px rgba(0,0,0,.4);';
        toastEl.innerHTML = '<i class="bi bi-bell-fill me-2" style="color:#f85149;"></i><strong>Alerta RMM</strong><br>'+_esc(msg);
        document.body.appendChild(toastEl);
        setTimeout(function(){ toastEl.remove(); }, 6000);
    });
})();

// Cargar stats al abrir el tab RMM
var _origSwitchEqTab = typeof switchEqTab === 'function' ? switchEqTab : null;

// ── Deploy de software ────────────────────────────────────────────────────────
var _catalogAll = [];

function loadRMMDeploy() {
    var content = document.getElementById('rmmToolsContent');
    var info    = document.getElementById('rmmToolsInfo');
    content.innerHTML = '<div class="text-center py-5 text-muted"><span class="mini-spin"></span><p class="mt-2" style="font-size:12px;">Cargando catálogo...</p></div>';
    info.textContent = '';

    Promise.all([
        fetch('/api/rmm/software/catalog', {credentials:'include'}).then(function(r){return r.json();}),
        fetch('/api/rmm/device/deploy/jobs?nodeId='+encodeURIComponent(_rmmToolsNodeId)+'&limit=10', {credentials:'include'}).then(function(r){return r.json();})
    ]).then(function(results) {
        var catData = results[0];
        var jobData = results[1];
        _catalogAll = catData.apps || [];
        info.textContent = _catalogAll.length + ' aplicaciones en catálogo';
        _renderDeployTab(_catalogAll, jobData.jobs || []);
    }).catch(function(e){ content.innerHTML='<div class="text-danger text-center p-4">'+_esc(e.message)+'</div>'; });
}

function _renderDeployTab(apps, jobs) {
    var content = document.getElementById('rmmToolsContent');

    var jobsHtml = '';
    if (jobs.length) {
        var jrows = jobs.map(function(j) {
            var sc = j.status==='ok'?'var(--success)':j.status==='error'?'var(--danger)':j.status==='running'?'var(--primary)':'var(--text-muted)';
            var sl = {ok:'✓ Completado',error:'✗ Error',running:'⟳ Ejecutando',pending:'⏳ Pendiente'}[j.status]||j.status;
            return '<tr>'
                + '<td style="font-size:12px;">'+_esc(j.app_name)+'</td>'
                + '<td style="font-size:11px;color:var(--text-muted);">'+_esc((j.started_at||'').substring(0,16).replace('T',' '))+'</td>'
                + '<td><span style="font-size:10px;font-weight:700;color:'+sc+';">'+sl+'</span>'+(j.error_msg?'<br><span style="font-size:10px;color:var(--danger);">'+_esc(j.error_msg.substring(0,80))+'</span>':'')+'</td>'
                + '<td style="font-size:11px;color:var(--text-muted);">'+(j.exit_code!==null?'Exit: '+j.exit_code:'—')+'</td>'
                + '</tr>';
        }).join('');
        jobsHtml = '<div style="border-bottom:1px solid var(--border-soft);padding-bottom:0;">'
            + '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-muted);padding:8px 14px 4px;">Últimos despliegues en este equipo</div>'
            + '<div style="overflow-x:auto;"><table class="rmm-ttbl" style="margin:0;"><thead><tr><th>App</th><th>Inicio</th><th>Estado</th><th>Código</th></tr></thead><tbody>'+jrows+'</tbody></table></div>'
            + '</div>';
    }

    var cats = {};
    apps.forEach(function(a){ cats[a.category] = (cats[a.category]||[]); cats[a.category].push(a); });

    var appsHtml = '<div style="padding:8px 14px;">'
        + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">'
        + '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-muted);">Catálogo disponible</div>'
        + '<button class="btn btn-sm btn-outline-secondary" style="font-size:10px;padding:2px 8px;" onclick="openCatalog()"><i class="bi bi-gear me-1"></i>Administrar catálogo</button>'
        + '</div>';

    if (!apps.length) {
        appsHtml += '<div class="text-center text-muted py-5" style="font-size:12px;"><i class="bi bi-inbox" style="font-size:28px;display:block;margin-bottom:8px;opacity:.3;"></i>Catálogo vacío. <a href="#" onclick="openCatalog()">Añade aplicaciones</a>.</div>';
    } else {
        Object.keys(cats).forEach(function(cat) {
            appsHtml += '<div style="font-size:10px;color:var(--text-muted);font-weight:600;margin:10px 0 4px;text-transform:uppercase;letter-spacing:.05em;">'+_esc(cat)+'</div>';
            appsHtml += '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:6px;">';
            cats[cat].forEach(function(a) {
                appsHtml += '<div style="background:var(--bg-card);border:1px solid var(--border-soft);border-radius:8px;padding:9px 12px;display:flex;flex-direction:column;gap:4px;">'
                    + '<div style="font-size:12px;font-weight:600;">'+_esc(a.name)+'</div>'
                    + '<div style="font-size:10px;color:var(--text-muted);">'+_esc(a.version||'—')+' · '+_esc(a.type.toUpperCase())+'</div>'
                    + '<button class="btn btn-sm btn-primary" style="font-size:11px;padding:3px 0;margin-top:4px;" onclick="deployApp('+a.id+','+JSON.stringify(a.name)+')">'
                    + '<i class="bi bi-rocket-takeoff me-1"></i>Desplegar</button>'
                    + '</div>';
            });
            appsHtml += '</div>';
        });
    }
    appsHtml += '</div>';

    content.innerHTML = jobsHtml + appsHtml;
}

function deployApp(catalogId, appName) {
    if (!confirm('¿Desplegar "'+appName+'" en este equipo?\n\nEl equipo descargará e instalará la aplicación de forma silenciosa.')) return;
    var info = document.getElementById('rmmToolsInfo');
    info.textContent = 'Iniciando despliegue de ' + appName + '...';
    fetch('/api/rmm/device/deploy', {method:'POST', credentials:'include', headers:{'Content-Type':'application/json'},
        body:JSON.stringify({nodeId:_rmmToolsNodeId, nodeName:_rmmToolsName, catalogId:catalogId})})
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (!d.ok) { alert('Error: '+(d.error||'desconocido')); return; }
        info.textContent = 'Despliegue en curso (job #'+d.jobId+'). Actualizando en 5s...';
        setTimeout(function(){ loadRMMDeploy(); }, 5000);
    })
    .catch(function(e){ alert('Error: '+e.message); });
}

// ── Catálogo — gestión ────────────────────────────────────────────────────────
function openCatalog() {
    document.getElementById('rmmCatalogOverlay').classList.add('show');
    closeCatalogForm();
    fetchCatalog();
}

function closeCatalog() {
    document.getElementById('rmmCatalogOverlay').classList.remove('show');
}

function fetchCatalog() {
    document.getElementById('catalogList').innerHTML = '<div class="text-center py-4"><span class="mini-spin"></span></div>';
    fetch('/api/rmm/software/catalog', {credentials:'include'})
    .then(function(r){ return r.json(); })
    .then(function(d) {
        _catalogAll = d.apps || [];
        renderCatalog(_catalogAll);
    }).catch(function(e){ document.getElementById('catalogList').innerHTML='<div class="text-danger text-center p-4">'+_esc(e.message)+'</div>'; });
}

function filterCatalog(q) {
    var fq = q.toLowerCase();
    renderCatalog(_catalogAll.filter(function(a){ return !fq || a.name.toLowerCase().includes(fq) || (a.category||'').toLowerCase().includes(fq); }));
}

function renderCatalog(apps) {
    var list = document.getElementById('catalogList');
    if (!apps.length) { list.innerHTML='<div class="text-center text-muted py-5" style="font-size:12px;">Sin resultados</div>'; return; }
    var rows = apps.map(function(a) {
        return '<tr>'
            + '<td style="font-size:12px;font-weight:600;">'+_esc(a.name)+'</td>'
            + '<td style="font-size:11px;color:var(--text-muted);">'+_esc(a.version||'—')+'</td>'
            + '<td style="font-size:11px;color:var(--text-muted);">'+_esc(a.category||'General')+'</td>'
            + '<td style="font-size:10px;font-family:monospace;color:var(--text-muted);">'+_esc(a.type.toUpperCase())+'</td>'
            + '<td style="font-size:11px;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-muted);">'+_esc(a.url)+'</td>'
            + '<td style="white-space:nowrap;">'
            + '<button class="btn btn-sm btn-outline-secondary me-1" style="font-size:10px;padding:1px 6px;" onclick="openCatalogForm('+JSON.stringify(a)+')"><i class="bi bi-pencil"></i></button>'
            + '<button class="btn btn-sm btn-outline-danger" style="font-size:10px;padding:1px 6px;" onclick="deleteCatalogItem('+a.id+','+JSON.stringify(a.name)+')"><i class="bi bi-trash3"></i></button>'
            + '</td></tr>';
    }).join('');
    list.innerHTML = '<div style="overflow-x:auto;"><table class="rmm-ttbl"><thead><tr><th>Nombre</th><th>Versión</th><th>Categoría</th><th>Tipo</th><th>URL</th><th></th></tr></thead><tbody>'+rows+'</tbody></table></div>';
}

function openCatalogForm(app) {
    var f = document.getElementById('catalogForm');
    document.getElementById('catalogFormTitle').textContent = app ? 'Editar: '+app.name : 'Nueva aplicación';
    document.getElementById('cfId').value      = app ? app.id : '';
    document.getElementById('cfName').value    = app ? app.name : '';
    document.getElementById('cfVersion').value = app ? (app.version||'') : '';
    document.getElementById('cfUrl').value     = app ? app.url : '';
    document.getElementById('cfType').value    = app ? app.type : 'exe';
    document.getElementById('cfCategory').value= app ? (app.category||'General') : 'General';
    document.getElementById('cfSha256').value  = app ? (app.sha256||'') : '';
    document.getElementById('cfArgs').value    = app ? (app.silent_args||'') : '';
    f.style.display = 'block';
    document.getElementById('cfName').focus();
}

function closeCatalogForm() {
    document.getElementById('catalogForm').style.display = 'none';
}

function saveCatalogItem() {
    var id   = document.getElementById('cfId').value;
    var body = {
        name:        document.getElementById('cfName').value.trim(),
        version:     document.getElementById('cfVersion').value.trim(),
        url:         document.getElementById('cfUrl').value.trim(),
        type:        document.getElementById('cfType').value,
        category:    document.getElementById('cfCategory').value.trim()||'General',
        sha256:      document.getElementById('cfSha256').value.trim(),
        silent_args: document.getElementById('cfArgs').value.trim(),
    };
    if (!body.name || !body.url) { alert('Nombre y URL son obligatorios'); return; }
    var method = id ? 'PUT' : 'POST';
    var url    = id ? '/api/rmm/software/catalog/'+id : '/api/rmm/software/catalog';
    fetch(url, {method:method, credentials:'include', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)})
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (!d.ok) { alert('Error: '+(d.error||'desconocido')); return; }
        closeCatalogForm();
        fetchCatalog();
    }).catch(function(e){ alert('Error: '+e.message); });
}

function deleteCatalogItem(id, name) {
    if (!confirm('¿Eliminar "'+name+'" del catálogo?')) return;
    fetch('/api/rmm/software/catalog/'+id, {method:'DELETE', credentials:'include'})
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (!d.ok) { alert('Error: '+(d.error||'desconocido')); return; }
        fetchCatalog();
    }).catch(function(e){ alert('Error: '+e.message); });
}

// ── Windows Update — historial ────────────────────────────────────────────────
var _updFilter = '';

var _updCatColor = {
    'Seguridad':    ['#f85149','rgba(248,81,73,.12)'],
    'Acumulativa':  ['#58a6ff','rgba(88,166,255,.12)'],
    'Definiciones': ['#56d364','rgba(86,211,100,.12)'],
    'Controlador':  ['#bc8cff','rgba(188,140,255,.12)'],
    'Feature Update':['#e3b341','rgba(227,179,65,.12)'],
    'Actualizacion':['#8b949e','rgba(139,148,158,.1)'],
};

function _updBadge(cat) {
    var c = _updCatColor[cat] || _updCatColor['Actualizacion'];
    return '<span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:10px;color:'+c[0]+';background:'+c[1]+';white-space:nowrap;">'+_esc(cat)+'</span>';
}

function loadRMMUpdates(filter) {
    if (filter !== undefined) _updFilter = filter;
    var content = document.getElementById('rmmToolsContent');
    var info    = document.getElementById('rmmToolsInfo');

    if (_rmmToolsData['upd'] !== null) {
        _renderUpdates(_rmmToolsData['upd']);
        return;
    }

    content.innerHTML = '<div class="text-center py-5 text-muted"><span class="mini-spin"></span><p class="mt-2" style="font-size:12px;">Consultando historial de actualizaciones...<br><span style="font-size:11px;opacity:.7;">Puede tardar hasta 75 segundos la primera vez</span></p></div>';
    info.textContent = '';

    fetch('/api/rmm/device/updates', {method:'POST', credentials:'include', headers:{'Content-Type':'application/json'}, body:JSON.stringify({nodeId:_rmmToolsNodeId})})
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (!d.ok) { content.innerHTML='<div class="text-danger text-center p-4">'+_esc(d.error||'Error')+'</div>'; return; }
        _rmmToolsData['upd'] = d;
        _renderUpdates(d);
    })
    .catch(function(e){ content.innerHTML='<div class="text-danger text-center p-4">'+_esc(e.message)+'</div>'; });
}

function _renderUpdates(d) {
    var content = document.getElementById('rmmToolsContent');
    var info    = document.getElementById('rmmToolsInfo');
    var updates = d.updates || [];

    var cats = {};
    updates.forEach(function(u){ cats[u.cat] = (cats[u.cat]||0)+1; });

    var filterBar = '<div style="display:flex;flex-wrap:wrap;gap:6px;padding:10px 14px;border-bottom:1px solid var(--border-soft);flex-shrink:0;">'
        + '<button style="font-size:10px;font-weight:700;padding:2px 9px;border-radius:12px;border:1px solid var(--border-soft);background:'
        + (_updFilter===''?'var(--primary)':'none')+';color:'+(_updFilter===''?'#fff':'var(--text-muted)')+';cursor:pointer;" onclick="loadRMMUpdates(\'\')">Todas ('+updates.length+')</button>';
    Object.keys(cats).forEach(function(c) {
        var cc = _updCatColor[c] || _updCatColor['Actualizacion'];
        var active = _updFilter === c;
        filterBar += '<button style="font-size:10px;font-weight:700;padding:2px 9px;border-radius:12px;border:1px solid '+(active?cc[0]:'var(--border-soft)')+';background:'+(active?cc[1]:'none')+';color:'+cc[0]+';cursor:pointer;" onclick="loadRMMUpdates('+JSON.stringify(c)+')">'+_esc(c)+' ('+cats[c]+')</button>';
    });
    filterBar += '</div>';

    var shown = _updFilter ? updates.filter(function(u){ return u.cat===_updFilter; }) : updates;

    var lastDate = shown.length ? shown[0].date : '—';
    var cacheNote = d.cached ? ' · Caché '+(_esc(d.cachedAt||'').substring(0,10)) : '';
    info.textContent = shown.length + ' actualizaciones' + (_updFilter?' ('+_updFilter+')':'') + cacheNote;
    if (d.warn) info.textContent += ' ⚠';

    if (!shown.length) {
        content.innerHTML = filterBar + '<div class="text-center text-muted py-5" style="font-size:12px;"><i class="bi bi-patch-check" style="font-size:28px;display:block;margin-bottom:8px;opacity:.3;"></i>Sin actualizaciones en esta categoría</div>';
        return;
    }

    var rows = shown.map(function(u) {
        return '<tr>'
            + '<td style="font-family:monospace;font-size:11px;color:var(--text-muted);white-space:nowrap;">'+_esc(u.id||'—')+'</td>'
            + '<td style="font-size:12px;word-break:break-word;max-width:380px;">'+_esc(u.desc)+'</td>'
            + '<td style="white-space:nowrap;font-size:11px;color:var(--text-muted);">'+_esc(u.date||'—')+'</td>'
            + '<td>'+_updBadge(u.cat)+'</td>'
            + '</tr>';
    }).join('');

    content.innerHTML = filterBar
        + '<div style="overflow-x:auto;overflow-y:auto;">'
        + '<table class="rmm-ttbl"><thead><tr><th style="width:80px;">KB</th><th>Descripción</th><th style="width:90px;">Fecha</th><th style="width:110px;">Categoría</th></tr></thead>'
        + '<tbody>'+rows+'</tbody></table></div>';
}

// ── Explorador de archivos ────────────────────────────────────────────────────
function _fmtSize(n) {
    if (n<0) return '—';
    if (n<1024) return n+' B';
    if (n<1048576) return (n/1024).toFixed(1)+' KB';
    if (n<1073741824) return (n/1048576).toFixed(1)+' MB';
    return (n/1073741824).toFixed(2)+' GB';
}

function loadRMMFiles(path) {
    _rmmFilesPath = path || 'C:\\';
    var content = document.getElementById('rmmToolsContent');
    content.innerHTML = '<div class="text-center py-5 text-muted"><span class="mini-spin"></span><p class="mt-2" style="font-size:12px;">Leyendo directorio...</p></div>';
    fetch('/api/rmm/device/files', {method:'POST', credentials:'include', headers:{'Content-Type':'application/json'}, body:JSON.stringify({nodeId:_rmmToolsNodeId, path:_rmmFilesPath})})
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (!d.ok) { content.innerHTML='<div class="text-danger text-center p-4">'+_esc(d.error||'Error')+'</div>'; return; }
        _rmmFilesPath = d.path;
        var items = d.items || [];
        var info = document.getElementById('rmmToolsInfo');
        info.textContent = items.length + ' elementos · ' + _esc(d.path);
        var bar = '<div class="rmm-file-bar">'
            + (d.parent ? '<button class="btn btn-sm btn-outline-secondary" style="padding:2px 8px;font-size:11px;" onclick="loadRMMFiles('+JSON.stringify(d.parent)+')"><i class="bi bi-arrow-up"></i></button>' : '')
            + '<span class="rmm-file-path">'+_esc(d.path)+'</span>'
            + '<label class="btn btn-sm btn-outline-primary" style="padding:2px 8px;font-size:11px;cursor:pointer;" title="Subir archivo"><i class="bi bi-upload"></i><input type="file" style="display:none;" onchange="rmmUploadFile(this)"></label>'
            + '<button class="btn btn-sm btn-outline-secondary" style="padding:2px 8px;font-size:11px;" onclick="rmmMkdir()"><i class="bi bi-folder-plus"></i></button>'
            + '</div>';
        if (!items.length) {
            content.innerHTML = bar + '<div class="text-center text-muted py-5" style="font-size:12px;">Carpeta vacía</div>';
            return;
        }
        var rows = items.map(function(it) {
            var icon = it.d ? '<i class="bi bi-folder-fill" style="color:#e3b341;font-size:14px;"></i>'
                            : '<i class="bi bi-file-earmark" style="color:var(--text-muted);font-size:13px;"></i>';
            var nameClick = it.d
                ? 'onclick="loadRMMFiles('+JSON.stringify((_rmmFilesPath.replace(/\\$/,'')+'\\')+it.n)+')"'
                : '';
            var dlBtn = !it.d ? '<button class="btn btn-sm btn-outline-secondary" style="padding:1px 5px;font-size:10px;" title="Descargar" onclick="rmmDownloadFile('+JSON.stringify(_rmmFilesPath.replace(/\\$/,'')+'\\'+''+it.n)+')"><i class="bi bi-download"></i></button>' : '';
            var delBtn = '<button class="btn btn-sm btn-outline-danger" style="padding:1px 5px;font-size:10px;" title="Eliminar" onclick="rmmDeleteFile('+JSON.stringify(_rmmFilesPath.replace(/\\$/,'')+'\\'+''+it.n)+','+JSON.stringify(it.n)+')"><i class="bi bi-trash3"></i></button>';
            return '<div class="rmm-file-row" '+nameClick+'>'
                + '<span style="flex-shrink:0;">'+icon+'</span>'
                + '<span class="fi-name">'+_esc(it.n)+'</span>'
                + '<span class="fi-size">'+_fmtSize(it.s)+'</span>'
                + '<span class="fi-date">'+_esc(it.m||'')+'</span>'
                + '<span class="fi-act">'+dlBtn+delBtn+'</span>'
                + '</div>';
        });
        content.innerHTML = bar + '<div style="overflow-y:auto;">' + rows.join('') + '</div>';
    })
    .catch(function(e){ content.innerHTML='<div class="text-danger text-center p-4">'+_esc(e.message)+'</div>'; });
}

function rmmDownloadFile(path) {
    fetch('/api/rmm/device/files/read', {method:'POST', credentials:'include', headers:{'Content-Type':'application/json'}, body:JSON.stringify({nodeId:_rmmToolsNodeId, path:path})})
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (!d.ok) { alert('Error: '+(d.error||'No se pudo descargar')); return; }
        var bytes = Uint8Array.from(atob(d.content), function(c){ return c.charCodeAt(0); });
        var blob  = new Blob([bytes]);
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = d.name || 'archivo';
        a.click();
    })
    .catch(function(e){ alert('Error: '+e.message); });
}

function rmmDeleteFile(path, name) {
    if (!confirm('¿Eliminar "'+name+'"? Esta acción no se puede deshacer.')) return;
    fetch('/api/rmm/device/files/delete', {method:'POST', credentials:'include', headers:{'Content-Type':'application/json'}, body:JSON.stringify({nodeId:_rmmToolsNodeId, path:path})})
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (!d.ok) { alert('Error: '+(d.error||'No se pudo eliminar')); return; }
        loadRMMFiles(_rmmFilesPath);
    })
    .catch(function(e){ alert('Error: '+e.message); });
}

function rmmMkdir() {
    var name = prompt('Nombre de la nueva carpeta:');
    if (!name) return;
    var newPath = _rmmFilesPath.replace(/\\$/, '') + '\\' + name;
    fetch('/api/rmm/device/files/mkdir', {method:'POST', credentials:'include', headers:{'Content-Type':'application/json'}, body:JSON.stringify({nodeId:_rmmToolsNodeId, path:newPath})})
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (!d.ok) { alert('Error: '+(d.error||'No se pudo crear')); return; }
        loadRMMFiles(_rmmFilesPath);
    })
    .catch(function(e){ alert('Error: '+e.message); });
}

function rmmUploadFile(input) {
    var file = input.files[0];
    if (!file) return;
    if (file.size > 2621440) { alert('Archivo demasiado grande. Máximo 2.5 MB.'); return; }
    var reader = new FileReader();
    reader.onload = function(e) {
        var b64 = e.target.result.split(',')[1];
        var destPath = _rmmFilesPath.replace(/\\$/, '') + '\\' + file.name;
        fetch('/api/rmm/device/files/write', {method:'POST', credentials:'include', headers:{'Content-Type':'application/json'}, body:JSON.stringify({nodeId:_rmmToolsNodeId, path:destPath, content:b64})})
        .then(function(r){ return r.json(); })
        .then(function(d) {
            if (!d.ok) { alert('Error al subir: '+(d.error||'desconocido')); return; }
            loadRMMFiles(_rmmFilesPath);
        })
        .catch(function(e){ alert('Error: '+e.message); });
    };
    reader.readAsDataURL(file);
    input.value = '';
}

// ── Chat bidireccional ────────────────────────────────────────────────────────
var _rmmChatNodeId  = null;
var _rmmChatPollTm  = null;
var _rmmChatSince   = 0;

function rmmCtxDoChat() {
    hideRMMCtx();
    openRMMChat(_rmmCtxNodeId, _rmmCtxName);
}

function openRMMChat(nodeId, name) {
    _rmmChatNodeId = nodeId;
    _rmmChatSince  = Date.now() - 5000;
    document.getElementById('rmmChatDev').textContent = name || nodeId;
    document.getElementById('rmmChatMessages').innerHTML = '<div class="text-center text-muted" style="font-size:11px;padding:20px 0;">Chat iniciado. Escribe un mensaje al usuario.</div>';
    document.getElementById('rmmChatInput').value = '';
    document.getElementById('rmmChatOverlay').classList.add('show');
    if (_rmmChatPollTm) clearInterval(_rmmChatPollTm);
    _rmmChatPollTm = setInterval(pollRMMChat, 2000);
}

function closeRMMChat() {
    document.getElementById('rmmChatOverlay').classList.remove('show');
    if (_rmmChatPollTm) { clearInterval(_rmmChatPollTm); _rmmChatPollTm = null; }
    if (_rmmChatNodeId) {
        fetch('/api/rmm/device/chat', {method:'DELETE', credentials:'include', headers:{'Content-Type':'application/json'}, body:JSON.stringify({nodeId:_rmmChatNodeId})});
        _rmmChatNodeId = null;
    }
}

function sendRMMChat() {
    var msg = document.getElementById('rmmChatInput').value.trim();
    if (!msg || !_rmmChatNodeId) return;
    document.getElementById('rmmChatInput').value = '';
    fetch('/api/rmm/device/chat/send', {method:'POST', credentials:'include', headers:{'Content-Type':'application/json'}, body:JSON.stringify({nodeId:_rmmChatNodeId, msg:msg})})
    .then(function(r){ return r.json(); })
    .then(function(d) { if (d.ok) pollRMMChat(); })
    .catch(function(e){ console.error('Chat error:', e.message); });
}

function pollRMMChat() {
    if (!_rmmChatNodeId) return;
    fetch('/api/rmm/device/chat/messages?nodeId='+encodeURIComponent(_rmmChatNodeId)+'&since='+_rmmChatSince, {credentials:'include'})
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (!d.ok || !d.messages || !d.messages.length) return;
        var box = document.getElementById('rmmChatMessages');
        var atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 40;
        d.messages.forEach(function(m) {
            if (m.ts > _rmmChatSince) _rmmChatSince = m.ts;
            var ts = new Date(m.ts).toLocaleTimeString();
            var div = document.createElement('div');
            div.style.display = 'flex';
            div.style.flexDirection = 'column';
            div.style.alignItems = m.from==='tech' ? 'flex-end' : 'flex-start';
            div.innerHTML = '<div class="chat-bubble '+(m.from==='tech'?'chat-from-tech':'chat-from-device')+'">'+_esc(m.msg)+'</div>'
                          + '<span class="chat-ts">'+(m.from==='tech'?'Técnico':'Usuario')+' · '+_esc(ts)+'</span>';
            box.appendChild(div);
        });
        if (atBottom) box.scrollTop = box.scrollHeight;
    })
    .catch(function(){});
}

