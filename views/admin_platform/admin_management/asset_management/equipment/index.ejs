// ── TAB: EJECUTAR SCRIPT en inventario ───────────────────────────────────────
var _runCols    = [];   // colecciones cargadas
var _runScripts = [];   // todos los scripts cargados

function initRunTab() {
    _invLoaded.run = true;
    var selCol = document.getElementById('runScriptCol');
    if (_runCols.length) { _populateRunCols(); return; }
    selCol.innerHTML = '<option value="">Cargando...</option>';
    fetch('/api/rmm/scripts/collections', { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(j){
            _runCols = j.collections || [];
            fetch('/api/rmm/scripts', { credentials: 'include' })
                .then(function(r2){ return r2.json(); })
                .then(function(j2){
                    _runScripts = j2.scripts || [];
                    _populateRunCols();
                });
        })
        .catch(function(){ selCol.innerHTML = '<option value="">Error al cargar</option>'; });
}

function _populateRunCols() {
    var sel = document.getElementById('runScriptCol');
    sel.innerHTML = '<option value="">— Colección —</option>'
        + _runCols.map(function(c){ return '<option value="' + c.id + '">' + _esc(c.name) + '</option>'; }).join('');
    document.getElementById('runScriptSel').innerHTML = '<option value="">— selecciona colección primero —</option>';
    document.getElementById('runScriptBtn').disabled = true;
    document.getElementById('runScriptPreview').style.display = 'none';
}

function onRunColChange() {
    var colId = document.getElementById('runScriptCol').value;
    var sel   = document.getElementById('runScriptSel');
    sel.innerHTML = '<option value="">— Script —</option>';
    document.getElementById('runScriptBtn').disabled = true;
    document.getElementById('runScriptPreview').style.display = 'none';
    if (!colId) return;
    var filtered = _runScripts.filter(function(s){ return String(s.collection_id) === String(colId); });
    sel.innerHTML = '<option value="">— Script —</option>'
        + filtered.map(function(s){ return '<option value="' + s.id + '">' + _esc(s.name) + '</option>'; }).join('');
}

function onRunScriptChange() {
    var sid  = document.getElementById('runScriptSel').value;
    var btn  = document.getElementById('runScriptBtn');
    var prev = document.getElementById('runScriptPreview');
    var code = document.getElementById('runScriptCode');
    var custom = (document.getElementById('runCustomCode').value || '').trim();
    if (!sid) { prev.style.display = 'none'; }
    else {
        var script = _runScripts.find(function(s){ return String(s.id) === String(sid); });
        if (script) { code.textContent = script.code; prev.style.display = 'block'; }
    }
    btn.disabled = !sid && !custom;
}

function onCustomCodeInput() {
    var custom = (document.getElementById('runCustomCode').value || '').trim();
    var sid    = document.getElementById('runScriptSel').value;
    document.getElementById('runScriptBtn').disabled = !custom && !sid;
    // Si hay comando pegado, deseleccionar script y ocultar preview
    if (custom) {
        document.getElementById('runScriptPreview').style.display = 'none';
    }
}

function execInvScript() {
    if (!_invNodeId) return;
    var sid    = document.getElementById('runScriptSel').value;
    var custom = (document.getElementById('runCustomCode').value || '').trim();
    if (!sid && !custom) return;

    var btn = document.getElementById('runScriptBtn');
    var out = document.getElementById('runScriptOutput');
    btn.disabled = true;
    btn.innerHTML = '<span class="mini-spin" style="width:12px;height:12px;border-width:2px;"></span> Ejecutando...';

    out.innerHTML = '<span id="runScriptStatus" style="color:#60a5fa;font-size:12px;font-family:monospace;">&gt; Ejecutando en el dispositivo (0s)...</span>';
    var _runStart  = Date.now();
    var _runTicker = setInterval(function(){
        var el = document.getElementById('runScriptStatus');
        if (el) el.textContent = '> Ejecutando en el dispositivo (' + Math.round((Date.now()-_runStart)/1000) + 's)...';
    }, 1000);

    var _abort      = new AbortController();
    var _abortTimer = setTimeout(function(){ _abort.abort(); }, 125000);

    var done = function(j, errMsg) {
        clearInterval(_runTicker);
        clearTimeout(_abortTimer);
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-play-fill me-1"></i>Ejecutar';
        var elapsed = Math.round((Date.now()-_runStart)/1000);
        if (errMsg) {
            out.innerHTML = '<span style="color:#f87171;font-size:12px;font-family:monospace;">&gt; ' + _esc(errMsg) + '</span>';
            return;
        }
        if (!j || !j.ok) {
            out.innerHTML = '<span style="color:#f87171;font-size:12px;font-family:monospace;">&gt; Error: ' + _esc((j && j.error) || 'Error desconocido') + '</span>';
            return;
        }
        var lines = (j.output || '').split('\n').map(function(l){
            var t = l.trim();
            var color = '#e2e8f0';
            if (t.startsWith('==='))                         color = '#60a5fa';
            else if (/error|fallo|fail/i.test(t))           color = '#f87171';
            else if (/ok|completado|listo|done|success/i.test(t)) color = '#34d399';
            else if (/warn|advertencia/i.test(t))           color = '#fbbf24';
            return '<span style="color:' + color + ';">' + _esc(l) + '</span>';
        }).join('\n');
        out.innerHTML = '<pre style="margin:0;font-family:monospace;font-size:12px;white-space:pre-wrap;color:#e2e8f0;">'
            + '<span style="color:#64748b;">// ' + _esc(j.scriptName||'Script') + ' — ' + new Date().toLocaleTimeString('es-PE') + ' (' + elapsed + 's)</span>\n\n'
            + lines + '</pre>';
    };

    var body = { nodeId: _invNodeId };
    if (custom) body.customCode = custom;
    else        body.scriptId   = sid;

    fetch('/api/rmm/device/run', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        signal: _abort.signal
    })
    .then(function(r){ clearTimeout(_abortTimer); return r.json(); })
    .then(function(j){ done(j, null); })
    .catch(function(e){
        var msg = e.name === 'AbortError' ? 'Tiempo de espera agotado (>95s) — el dispositivo no respondió' : e.message;
        done(null, msg);
    });
}

// ── CONFIGURACIÓN RMM ────────────────────────────────────────────────────────
var _cfgLoaded = false;

function loadRMMConfig() {
    document.getElementById('rmmCfgStatus').textContent = 'Cargando…';
    fetch('/api/rmm/config', { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(j){
            if (!j.ok) { document.getElementById('cfgSaveMsg').textContent = 'Error al cargar'; return; }
            var s = j.settings || {};
            document.getElementById('cfgMeshUrl').value       = (s.mesh_url        && !s.mesh_url.is_secret)        ? s.mesh_url.value        : (j.current.url       || '');
            document.getElementById('cfgMeshPublicUrl').value = (s.mesh_public_url && !s.mesh_public_url.is_secret) ? s.mesh_public_url.value  : (j.current.publicUrl || '');
            document.getElementById('cfgMeshUser').value      = (s.mesh_user       && !s.mesh_user.is_secret)       ? s.mesh_user.value        : (j.current.user      || '');
            document.getElementById('cfgMeshPass').placeholder = j.current.hasPass ? 'Contraseña guardada (dejar vacío para no cambiar)' : 'Sin contraseña guardada';
            var st = document.getElementById('rmmCfgStatus');
            if (j.connected) {
                st.textContent = 'Conectado';
                st.style.background = 'rgba(34,197,94,.15)';
                st.style.color = '#22c55e';
            } else {
                st.textContent = 'Desconectado';
                st.style.background = 'rgba(239,68,68,.1)';
                st.style.color = '#ef4444';
            }
        })
        .catch(function(e){ document.getElementById('cfgSaveMsg').textContent = 'Error: ' + e.message; });
}

function saveRMMConfig() {
    var body = {
        mesh_url:        document.getElementById('cfgMeshUrl').value.trim(),
        mesh_public_url: document.getElementById('cfgMeshPublicUrl').value.trim(),
        mesh_user:       document.getElementById('cfgMeshUser').value.trim(),
    };
    var pass = document.getElementById('cfgMeshPass').value;
    if (pass) body.mesh_pass = pass;
    var msg = document.getElementById('cfgSaveMsg');
    msg.textContent = 'Guardando…';
    fetch('/api/rmm/config', { method: 'PUT', credentials: 'include',
        headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
        .then(function(r){ return r.json(); })
        .then(function(j){
            if (!j.ok) { msg.textContent = 'Error: ' + (j.error||'desconocido'); msg.style.color='#ef4444'; return; }
            msg.textContent = 'Guardado. Reconectando…';
            msg.style.color = '#22c55e';
            document.getElementById('cfgMeshPass').value = '';
            document.getElementById('rmmCfgStatus').textContent = 'Reconectando…';
            document.getElementById('rmmCfgStatus').style.background = '';
            document.getElementById('rmmCfgStatus').style.color = '';
            setTimeout(function() { _cfgLoaded = false; loadRMMConfig(); msg.textContent = ''; }, 3500);
        })
        .catch(function(e){ msg.textContent = 'Error: ' + e.message; msg.style.color='#ef4444'; });
}

function testRMMConn() {
    var msg = document.getElementById('cfgSaveMsg');
    msg.textContent = 'Probando…';
    msg.style.color = '';
    fetch('/api/rmm/status', { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(j){
            if (j.connected) {
                msg.textContent = 'Conexión OK (' + (j.deviceCount||0) + ' dispositivos)';
                msg.style.color = '#22c55e';
            } else {
                msg.textContent = 'Sin conexión con MeshCentral';
                msg.style.color = '#ef4444';
            }
            setTimeout(function(){ msg.textContent = ''; }, 4000);
        })
        .catch(function(e){ msg.textContent = 'Error: ' + e.message; msg.style.color='#ef4444'; });
}

function toggleCfgPass() {
    var inp = document.getElementById('cfgMeshPass');
    var eye = document.getElementById('cfgPassEye');
    if (inp.type === 'password') {
        inp.type = 'text';
        eye.className = 'bi bi-eye-slash';
    } else {
        inp.type = 'password';
        eye.className = 'bi bi-eye';
    }
}

// ── GESTIÓN DE SCRIPTS RMM (tab Scripts RMM) ─────────────────────────────────
var _activeColId   = null;
var _scriptsCols   = [];
var _scriptsAll    = [];

function loadScriptsCols() {
    var wrap = document.getElementById('scriptsColList');
    wrap.innerHTML = '<div class="text-center py-3"><span class="mini-spin"></span></div>';
    fetch('/api/rmm/scripts/collections', { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(j){
            _scriptsCols = j.collections || [];
            renderColList();
            if (_scriptsCols.length) selectCol(_scriptsCols[0].id);
        })
        .catch(function(){ wrap.innerHTML = '<div class="text-danger p-3" style="font-size:12px;">Error al cargar colecciones</div>'; });
}

function renderColList() {
    var wrap = document.getElementById('scriptsColList');
    if (!_scriptsCols.length) {
        wrap.innerHTML = '<div class="text-center py-3 text-muted" style="font-size:12px;">Sin colecciones. Crea una con el botón +</div>';
        return;
    }
    wrap.innerHTML = _scriptsCols.map(function(c){
        return '<div class="scripts-col-item' + (c.id===_activeColId?' active':'') + '" onclick="selectCol(' + c.id + ')" data-col-id="' + c.id + '">'
            + '<i class="bi ' + _esc(c.icon||'bi-collection') + ' col-icon"></i>'
            + '<span class="col-name">' + _esc(c.name) + '</span>'
            + '<span class="col-cnt">' + (c.script_count||0) + '</span>'
            + '</div>';
    }).join('');
}

function selectCol(id) {
    _activeColId = id;
    // Actualizar estilo activo
    document.querySelectorAll('.scripts-col-item').forEach(function(el){
        el.classList.toggle('active', parseInt(el.dataset.colId)===id);
    });
    var col = _scriptsCols.find(function(c){ return c.id===id; });
    if (col) {
        document.getElementById('scriptsColTitle').textContent = col.name;
        var icon = document.getElementById('scriptsColIcon');
        icon.className = 'bi ' + (col.icon||'bi-collection');
        document.getElementById('scriptsColBadge').style.display = 'none';
    }
    document.getElementById('btnNewScript').disabled = false;
    loadScripts(id);
}

function loadScripts(colId) {
    var wrap = document.getElementById('scriptsListWrap');
    wrap.innerHTML = '<div class="text-center py-4"><span class="mini-spin"></span></div>';
    fetch('/api/rmm/scripts?collection_id=' + colId, { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(j){
            _scriptsAll = j.scripts || [];
            renderScripts();
        })
        .catch(function(){ wrap.innerHTML = '<div class="text-danger p-3" style="font-size:12px;">Error al cargar scripts</div>'; });
}

function renderScripts() {
    var wrap = document.getElementById('scriptsListWrap');
    var badge = document.getElementById('scriptsColBadge');
    badge.textContent = _scriptsAll.length;
    badge.style.display = _scriptsAll.length ? 'inline' : 'none';
    if (!_scriptsAll.length) {
        wrap.innerHTML = '<div class="text-center py-5 text-muted" style="font-size:12px;">'
            + '<i class="bi bi-file-code" style="font-size:28px;display:block;margin-bottom:8px;opacity:.3;"></i>'
            + 'No hay scripts en esta colección.<br>Crea uno con el botón "Nuevo script".</div>';
        return;
    }
    wrap.innerHTML = '<div style="padding:8px;">'
        + _scriptsAll.map(function(s){
            return '<div class="script-card">'
                + '<i class="bi bi-terminal" style="font-size:16px;color:var(--primary);margin-top:2px;flex-shrink:0;"></i>'
                + '<div style="flex:1;min-width:0;">'
                + '<div class="sc-name">' + _esc(s.name) + '</div>'
                + (s.description ? '<div class="sc-desc">' + _esc(s.description) + '</div>' : '')
                + '</div>'
                + '<div class="sc-actions">'
                + '<button class="btn btn-sm btn-outline-secondary" style="font-size:11px;padding:3px 8px;" onclick="openScriptModal(' + s.id + ')"><i class="bi bi-pencil"></i></button>'
                + '</div>'
                + '</div>';
          }).join('')
        + '</div>';
}

// ── MODALES: COLECCIÓN ────────────────────────────────────────────────────────
function openColModal(id) {
    document.getElementById('colModalId').value   = id || '';
    document.getElementById('colModalTitle').innerHTML = id
        ? '<i class="bi bi-collection me-2"></i>Editar colección'
        : '<i class="bi bi-collection me-2"></i>Nueva colección';
    document.getElementById('btnDeleteCol').style.display = id ? 'inline-block' : 'none';
    if (id) {
        var col = _scriptsCols.find(function(c){ return c.id===id; });
        document.getElementById('colModalName').value = col ? col.name : '';
        document.getElementById('colModalDesc').value = col ? (col.description||'') : '';
        document.getElementById('colModalIcon').value = col ? (col.icon||'bi-collection') : 'bi-collection';
    } else {
        document.getElementById('colModalName').value = '';
        document.getElementById('colModalDesc').value = '';
        document.getElementById('colModalIcon').value = 'bi-collection';
    }
    new bootstrap.Modal(document.getElementById('colModal')).show();
}

function saveCol() {
    var id   = document.getElementById('colModalId').value;
    var body = {
        name:        document.getElementById('colModalName').value.trim(),
        description: document.getElementById('colModalDesc').value.trim(),
        icon:        document.getElementById('colModalIcon').value.trim() || 'bi-collection',
    };
    if (!body.name) { alert('El nombre es obligatorio'); return; }
    var url    = id ? '/api/rmm/scripts/collections/' + id : '/api/rmm/scripts/collections';
    var method = id ? 'PUT' : 'POST';
    fetch(url, { method, credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
        .then(function(r){ return r.json(); })
        .then(function(j){
            if (!j.ok) { alert(j.error||'Error'); return; }
            bootstrap.Modal.getInstance(document.getElementById('colModal')).hide();
            _scriptsLoaded = false;
            loadScriptsCols();
        })
        .catch(function(e){ alert('Error: ' + e.message); });
}

function deleteCol() {
    var id = document.getElementById('colModalId').value;
    if (!id || !confirm('¿Eliminar colección y todos sus scripts?')) return;
    fetch('/api/rmm/scripts/collections/' + id, { method: 'DELETE', credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(j){
            if (!j.ok) { alert(j.error||'Error'); return; }
            bootstrap.Modal.getInstance(document.getElementById('colModal')).hide();
            _activeColId = null;
            _scriptsLoaded = false;
            loadScriptsCols();
        })
        .catch(function(e){ alert('Error: ' + e.message); });
}

// ── MODALES: SCRIPT ───────────────────────────────────────────────────────────
function openScriptModal(id) {
    document.getElementById('scriptModalId').value = id || '';
    document.getElementById('scriptModalTitle').innerHTML = id
        ? '<i class="bi bi-terminal me-2"></i>Editar script'
        : '<i class="bi bi-terminal me-2"></i>Nuevo script';
    document.getElementById('btnDeleteScript').style.display = id ? 'inline-block' : 'none';

    // Llenar selector de colecciones
    var sel = document.getElementById('scriptModalCol');
    sel.innerHTML = _scriptsCols.map(function(c){
        return '<option value="' + c.id + '"' + (c.id===_activeColId?' selected':'') + '>' + _esc(c.name) + '</option>';
    }).join('');

    if (id) {
        var s = _scriptsAll.find(function(x){ return x.id===id; });
        document.getElementById('scriptModalName').value = s ? s.name : '';
        document.getElementById('scriptModalDesc').value = s ? (s.description||'') : '';
        document.getElementById('scriptModalCode').value = s ? s.code : '';
        if (s) sel.value = s.collection_id;
    } else {
        document.getElementById('scriptModalName').value = '';
        document.getElementById('scriptModalDesc').value = '';
        document.getElementById('scriptModalCode').value = '';
    }
    new bootstrap.Modal(document.getElementById('scriptModal')).show();
}

function saveScript() {
    var id   = document.getElementById('scriptModalId').value;
    var body = {
        collection_id: document.getElementById('scriptModalCol').value,
        name:          document.getElementById('scriptModalName').value.trim(),
        description:   document.getElementById('scriptModalDesc').value.trim(),
        code:          document.getElementById('scriptModalCode').value,
    };
    if (!body.name || !body.code) { alert('Nombre y código son obligatorios'); return; }
    var url    = id ? '/api/rmm/scripts/' + id : '/api/rmm/scripts';
    var method = id ? 'PUT' : 'POST';
    fetch(url, { method, credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
        .then(function(r){ return r.json(); })
        .then(function(j){
            if (!j.ok) { alert(j.error||'Error'); return; }
            bootstrap.Modal.getInstance(document.getElementById('scriptModal')).hide();
            loadScripts(_activeColId);
        })
        .catch(function(e){ alert('Error: ' + e.message); });
}

function deleteScript() {
    var id = document.getElementById('scriptModalId').value;
    if (!id || !confirm('¿Eliminar este script?')) return;
    fetch('/api/rmm/scripts/' + id, { method: 'DELETE', credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(j){
            if (!j.ok) { alert(j.error||'Error'); return; }
            bootstrap.Modal.getInstance(document.getElementById('scriptModal')).hide();
            loadScripts(_activeColId);
        })
        .catch(function(e){ alert('Error: ' + e.message); });
}

