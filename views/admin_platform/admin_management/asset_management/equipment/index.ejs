  <div class="rmm-mbox" style="width:820px;max-width:96vw;">
    <div class="rmm-mhead">
      <div class="rmm-mtitle"><i class="bi bi-rocket-takeoff" style="color:var(--primary);"></i> Catálogo de Software</div>
