function exportBlCSV() {
    var q    = (document.getElementById('blSearch').value || '').toLowerCase().trim();
    var rows = _blData.filter(function(d) {
        if (_blActiveFilter === 'encrypted'   && !d.isEncrypted) return false;
        if (_blActiveFilter === 'unencrypted' &&  d.isEncrypted) return false;
        if (q && !(d.deviceName||'').toLowerCase().includes(q) && !(d.userDisplayName||'').toLowerCase().includes(q)) return false;
        return true;
    });
    if (!rows.length) return;
    var cols = ['deviceName','userDisplayName','userPrincipalName','isEncrypted','complianceState','operatingSystem','osVersion','lastSyncDateTime'];
    var hdr  = ['Equipo','Usuario','Email','Cifrado','Cumplimiento','SO','Version SO','Ultima Sync'];
    var csv  = [hdr].concat(rows.map(function(d){
        return cols.map(function(c){ var v=String(d[c]==null?'':d[c]); return (v.includes(',')||v.includes('"'))?'"'+v.replace(/"/g,'""')+'"':v; });
    })).map(function(r){ return r.join(','); }).join('\n');
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob(['﻿'+csv], {type:'text/csv;charset=utf-8;'}));
    a.download = 'bitlocker_' + new Date().toISOString().slice(0,10) + '.csv';
    a.click();
}

// ── ALMACÉN TAB ───────────────────────────────────────────────────────────────
var _almDispPage = 1, _almFallasPage = 1, _almTrasladosPage = 1;
var _almUnifiedTimer;
var _almActiveTab = 'disponibles';
var _almSearchPH = { disponibles:'Buscar código, marca, modelo…', fallas:'Buscar equipo o componente…', traslados:'Buscar equipo, origen, destino…' };

function switchAlmTab(name, btn) {
    _almActiveTab = name;
    document.getElementById('almPanelDisponibles').style.display = name === 'disponibles' ? '' : 'none';
    document.getElementById('almPanelFallas').style.display      = name === 'fallas'      ? '' : 'none';
    document.getElementById('almPanelTraslados').style.display   = name === 'traslados'   ? '' : 'none';
    document.querySelectorAll('.alm-sub-btn').forEach(function(b){ b.classList.remove('active'); });
    if (btn) btn.classList.add('active');
    var inp = document.getElementById('almUnifiedSearch');
    if (inp) { inp.value = ''; inp.placeholder = _almSearchPH[name] || 'Buscar…'; }
    if (name === 'fallas'    && !document.getElementById('almBodyFallas').dataset.loaded)    { document.getElementById('almBodyFallas').dataset.loaded = '1';    loadAlmFallas(true); }
    if (name === 'traslados' && !document.getElementById('almBodyTraslados').dataset.loaded) { document.getElementById('almBodyTraslados').dataset.loaded = '1'; loadAlmTraslados(true); }
}

function almUnifiedSearchFn() {
    clearTimeout(_almUnifiedTimer);
    _almUnifiedTimer = setTimeout(function(){
        if (_almActiveTab === 'disponibles') loadAlmDisp(true);
        else if (_almActiveTab === 'fallas') loadAlmFallas(true);
        else loadAlmTraslados(true);
    }, 350);
}

function loadAlmacen() {
    fetch('/api/almacen/stats', { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(d){
            if (!d.success) return;
            var s = d.data;
            document.getElementById('almKpiDisp').textContent      = s.totalDisponibles  || 0;
            document.getElementById('almKpiFallas').textContent    = s.fallasPendientes  || 0;
            document.getElementById('almKpiTraslados').textContent = s.trasladosMes      || 0;
            var sel = document.getElementById('almFilterTipo');
            (s.porTipo || []).forEach(function(t){
                var o = document.createElement('option');
                o.value = t.tipo;
                o.textContent = t.tipo + ' (' + t.total + ')';
                sel.appendChild(o);
            });
        });
    loadAlmDisp(true);
}

function loadAlmDisp(reset) {
    if (reset) _almDispPage = 1;
    var search = (document.getElementById('almUnifiedSearch')?.value || '').trim();
    var tipo   = document.getElementById('almFilterTipo')?.value  || '';
    var url = '/api/almacen/disponibles?page=' + _almDispPage + '&limit=20';
    if (search) url += '&search=' + encodeURIComponent(search);
    if (tipo)   url += '&tipo='   + encodeURIComponent(tipo);
    var tbody = document.getElementById('almBodyDisp');
    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-3 text-muted"><span class="mini-spin" style="width:12px;height:12px;border-width:2px;"></span> Cargando…</td></tr>';
    fetch(url, { credentials: 'include' }).then(function(r){ return r.json(); }).then(function(d){
        if (!d.success || !d.data.length) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Sin equipos disponibles</td></tr>';
            document.getElementById('almPagDisp').innerHTML = ''; return;
        }
        tbody.innerHTML = d.data.map(function(e){
            return '<tr><td style="font-weight:700;color:var(--primary);white-space:nowrap;">' + _esc(e.device_code) + '</td>'
                + '<td>' + _esc(e.equipment_type) + '</td>'
                + '<td>' + _esc(e.brand) + ' ' + _esc(e.model) + '</td>'
                + '<td style="color:var(--text-muted);font-size:11px;">' + _esc(e.serial_number || '—') + '</td>'
                + '<td style="white-space:nowrap;">' + _esc(e.ram_memory || '—') + '</td>'
                + '<td style="white-space:nowrap;">' + _esc(e.disk_capacity || '—') + '</td>'
                + '<td style="font-size:11px;">' + _esc(e.operating_system || '—') + '</td></tr>';
        }).join('');
        _almPag('almPagDisp', d.pagination, 'almGotoDisp');
    });
}
function almGotoDisp(p) { _almDispPage = p; loadAlmDisp(); }

function loadAlmFallas(reset) {
    if (reset) _almFallasPage = 1;
    var search = (document.getElementById('almUnifiedSearch')?.value || '').trim();
    var status = document.getElementById('almFilterFallaStatus')?.value || '';
    var url = '/api/almacen/fallas?page=' + _almFallasPage + '&limit=20';
    if (search) url += '&search=' + encodeURIComponent(search);
    if (status) url += '&status=' + encodeURIComponent(status);
    var tbody = document.getElementById('almBodyFallas');
    tbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted"><span class="mini-spin" style="width:12px;height:12px;border-width:2px;"></span> Cargando…</td></tr>';
    var SC = { 'Pendiente':'#f59e0b','En proceso':'#3b82f6','Esperando repuesto':'#8b5cf6','Resuelto':'#10b981','Dado de baja':'#94a3b8' };
    fetch(url, { credentials: 'include' }).then(function(r){ return r.json(); }).then(function(d){
        if (!d.success || !d.data.length) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">Sin fallas registradas</td></tr>';
            document.getElementById('almPagFallas').innerHTML = ''; return;
        }
        tbody.innerHTML = d.data.map(function(f){
            var col = SC[f.repair_status] || '#94a3b8';
            var dt  = f.created_at ? new Date(f.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short'}) : '—';
            var desc = f.description ? (f.description.length > 50 ? f.description.slice(0,48)+'…' : f.description) : '—';
            return '<tr><td style="white-space:nowrap;"><span style="font-weight:700;">' + _esc(f.device_code) + '</span><br>'
                + '<span style="font-size:10px;color:var(--text-muted);">' + _esc(f.brand + ' ' + f.model) + '</span></td>'
                + '<td>' + _esc(f.component) + '</td>'
                + '<td style="max-width:200px;" title="' + _esc(f.description) + '">' + _esc(desc) + '</td>'
                + '<td><span style="background:' + col + '22;color:' + col + ';padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700;">' + _esc(f.repair_status) + '</span></td>'
                + '<td style="font-size:11px;color:var(--text-muted);">' + dt + '</td></tr>';
        }).join('');
        _almPag('almPagFallas', d.pagination, 'almGotoFallas');
    });
}
function almGotoFallas(p) { _almFallasPage = p; loadAlmFallas(); }

function loadAlmTraslados(reset) {
    if (reset) _almTrasladosPage = 1;
    var search = (document.getElementById('almUnifiedSearch')?.value || '').trim();
    var url = '/api/almacen/traslados?page=' + _almTrasladosPage + '&limit=20';
    if (search) url += '&search=' + encodeURIComponent(search);
    var tbody = document.getElementById('almBodyTraslados');
    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted"><span class="mini-spin" style="width:12px;height:12px;border-width:2px;"></span> Cargando…</td></tr>';
    fetch(url, { credentials: 'include' }).then(function(r){ return r.json(); }).then(function(d){
        if (!d.success || !d.data.length) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">Sin traslados registrados</td></tr>';
            document.getElementById('almPagTraslados').innerHTML = ''; return;
        }
        tbody.innerHTML = d.data.map(function(t){
            var dt = t.transfer_date ? new Date(t.transfer_date).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}) : '—';
            var orig = [t.origin_name, t.origin_city].filter(Boolean).join(', ') || '—';
            var dest = [t.destination_name, t.destination_city].filter(Boolean).join(', ') || '—';
            return '<tr><td style="font-weight:700;white-space:nowrap;">' + _esc(t.device_code) + '</td>'
                + '<td>' + _esc(t.equipment_type) + '</td>'
                + '<td style="font-size:11px;">' + _esc(orig) + '</td>'
                + '<td style="font-size:11px;">' + _esc(dest) + '</td>'
                + '<td style="font-size:11px;white-space:nowrap;">' + dt + '</td>'
                + '<td style="font-size:11px;color:var(--text-muted);">' + _esc(t.notes || '—') + '</td></tr>';
        }).join('');
        _almPag('almPagTraslados', d.pagination, 'almGotoTraslados');
    });
}
function almGotoTraslados(p) { _almTrasladosPage = p; loadAlmTraslados(); }

function _almPag(containerId, pag, fnName) {
    var el = document.getElementById(containerId);
    if (!pag || pag.pages <= 1) { el.innerHTML = ''; return; }
    var html = '<span style="color:var(--text-muted);font-size:11px;">Página ' + pag.page + ' de ' + pag.pages + ' · ' + pag.total + ' registros</span> ';
    if (pag.page > 1)         html += '<button class="btn btn-sm btn-outline-secondary py-0 px-2 ms-2" onclick="' + fnName + '(' + (pag.page-1) + ')">‹</button> ';
    if (pag.page < pag.pages) html += '<button class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="' + fnName + '(' + (pag.page+1) + ')">›</button>';
    el.innerHTML = html;
}


// ── PANEL LATERAL CONFIGURACIÓN ───────────────────────────────────────────────
function switchCfgPanel(name, btn) {
    document.getElementById('cfgPanelScripts').style.display = name === 'scripts' ? '' : 'none';
    document.getElementById('cfgPanelMesh').style.display    = name === 'mesh'    ? '' : 'none';
    document.querySelectorAll('.cfg-nav-btn').forEach(function(b){ b.classList.remove('active'); });
    if (btn) btn.classList.add('active');
    if (name === 'mesh' && !_cfgLoaded) { _cfgLoaded = true; loadRMMConfig(); }
}
</script>
</body>
</html>
