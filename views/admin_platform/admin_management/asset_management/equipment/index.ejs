var _rmmView = 'list';

function setRMMView(v) {
    _rmmView = v;
    document.getElementById('rmmVBtnList').classList.toggle('active', v==='list');
    document.getElementById('rmmVBtnGrid').classList.toggle('active', v==='grid');
    document.getElementById('rmmListWrap').style.display = v==='list' ? '' : 'none';
    var grid = document.getElementById('rmmGrid');
    if (v === 'grid') {
        grid.classList.add('visible');
        if (_rmmAll.length) renderRMMGrid(_rmmAll);
    } else {
        grid.classList.remove('visible');
    }
}

function renderRMMGrid(devices) {
    var grid = document.getElementById('rmmGrid');
    if (!devices.length) {
        grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:50px;color:var(--text-muted);"><i class="bi bi-laptop" style="font-size:36px;display:block;margin-bottom:12px;opacity:.3;"></i>No se encontraron dispositivos</div>';
        return;
    }
    var osIcons = { 1:'bi-windows', 2:'bi-apple', 3:'bi-ubuntu', 4:'bi-android2' };
    grid.innerHTML = devices.map(function(d) {
        var oi  = osIcons[d.ostype] || 'bi-laptop';
        var bc  = d.online ? '#10b981' : '#94a3b8';
        var oc  = d.online ? '#10b981' : '#94a3b8';
        var sub = d.os || d.host || '—';
        var nid = (d.nodeId||'').replace(/\\/g,'\\\\').replace(/'/g,"\\'");
        var nm  = (d.name||'').replace(/\\/g,'\\\\').replace(/'/g,"\\'");
        var ip  = (d.ip||d.host||'').replace(/'/g,"\\'");
        var exip= (d.exip||'').replace(/'/g,"\\'");
        var kvmBtn = d.online
            ? '<button class="rmm-cbtn" title="KVM" onclick="event.stopPropagation();connectRMM(\''+nid+'\',\''+nm+'\',\''+ip+'\')"><i class="bi bi-display"></i></button>'
            : '<button class="rmm-cbtn" disabled style="opacity:.3;cursor:default;" title="Fuera de línea"><i class="bi bi-display"></i></button>';
        var toolsBtn = d.online
            ? '<button class="rmm-cbtn" title="Herramientas" onclick="event.stopPropagation();openRMMTools(\''+nid+'\',\''+nm+'\',\'proc\')"><i class="bi bi-tools"></i></button>'
            : '';
        var infoBtn = '<button class="rmm-cbtn" title="Info sistema" onclick="event.stopPropagation();openRMMInventory(\''+nid+'\',\''+nm+'\','+(d.online?1:0)+',\''+exip+'\')"><i class="bi bi-cpu"></i></button>';
        var pwrBtn = d.online
            ? '<button class="rmm-cbtn red" title="Power" onclick="event.stopPropagation();showRMMCtx(event,\''+nid+'\',\''+nm+'\',true)"><i class="bi bi-power"></i></button>'
            : '';
        return '<div class="rmm-card" oncontextmenu="showRMMCtx(event,\''+nid+'\',\''+nm+'\','+d.online+')">'
            + '<div class="rmm-card-bar" style="background:'+bc+';"></div>'
            + '<div class="rmm-card-body">'
            + '<div class="rmm-card-name"><i class="bi '+oi+'" style="margin-right:5px;opacity:.6;"></i>'+_esc(d.name)+'</div>'
            + '<div class="rmm-card-sub">'+_esc(sub)+'</div>'
            + '<div class="rmm-card-meta">'
            + '<div class="rmm-card-status" style="color:'+oc+';">'
            + '<div style="width:7px;height:7px;border-radius:50%;background:'+oc+';'+(d.online?'box-shadow:0 0 0 3px rgba(16,185,129,.18)':'')+'"></div>'
            + (d.online?'En línea':'Fuera de línea')+'</div>'
            + '<div class="rmm-card-btns">'+kvmBtn+toolsBtn+infoBtn+pwrBtn+'</div>'
            + '</div></div></div>';
    }).join('');
}

