<script>
/* ─── Dark Mode — init inmediato (sin flash) ────────── */
(function () {
    const saved = localStorage.getItem('dashboardTheme') || 'light';
    document.documentElement.setAttribute('data-theme', saved);
})();

function toggleTheme() {
    const html    = document.documentElement;
    const current = html.getAttribute('data-theme');
    const next    = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    localStorage.setItem('dashboardTheme', next);
    _syncToggleUI(next);
    if (typeof updateChartsTheme === 'function') updateChartsTheme(next);
}

function _syncToggleUI(theme) {
    const dark=theme==='dark';
    const icon=document.getElementById('toggleIcon'),label=document.getElementById('toggleLabel'),track=document.getElementById('themeTrack'),knob=document.getElementById('themeKnob');
    if(icon)icon.className=dark?'bi bi-sun-fill':'bi bi-moon-stars-fill';
    if(label)label.textContent=dark?'Claro':'Oscuro';
    if(track)track.style.background=dark?'#3b82f6':'#cbd5e1';
    if(knob)knob.style.transform=dark?'translateX(15px)':'translateX(0)';
}

document.addEventListener('DOMContentLoaded', function () {
    const saved = localStorage.getItem('dashboardTheme') || 'light';
    _syncToggleUI(saved);
});
</script>

