                + '<td style="color:var(--text-muted);">'+_esc(r.duration||'—')+'</td>'
                + '<td><button class="btn btn-sm btn-outline-primary" style="font-size:11px;padding:2px 8px;" onclick="rmmPlayRec(\''+_esc(r.id||r.file)+'\')"><i class="bi bi-play-fill"></i> Reproducir</button></td>'
                + '</tr>';
        }).join('');
        content.innerHTML = '<div style="overflow-x:auto;"><table class="rmm-ttbl"><thead><tr><th>Sesión</th><th>Inicio</th><th>Duración</th><th></th></tr></thead><tbody>'+rows+'</tbody></table></div>';
    })
