<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Equipos - Equipment Management</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="../css/core/style.css">

    <style>
:root,
[data-theme="light"] {
    --bg-main: #f5f7fa;
    --bg-card: #ffffff;
    --bg-header: #fafbfc;
    --border-soft: #e2e8f0;
    --text-main: #1e293b;
    --text-muted: #64748b;
    --primary: #3b82f6;
    --success: #10b981;
    --warning: #f59e0b;
    --info: #06b6d4;
    --danger: #ef4444;
    --hover-row: #f8fafc;
    --input-bg: #ffffff;
    --shadow-card: 0 1px 3px rgba(0,0,0,.05);
    --shadow-hover: 0 4px 12px rgba(0,0,0,.08);
    --scrollbar-thumb: #cbd5e1;
    --scrollbar-thumb-hover: #94a3b8;
    --scrollbar-track: #f1f5f9;
    --modal-bg: #ffffff;
    --modal-border: #e2e8f0;
    --input-readonly-bg: #f8fafc;
}
[data-theme="dark"] {
    --bg-main: #0f172a;
    --bg-card: #1e293b;
    --bg-header: #162032;
    --border-soft: #2d3f55;
    --text-main: #e2e8f0;
    --text-muted: #94a3b8;
    --primary: #60a5fa;
    --success: #34d399;
    --warning: #fbbf24;
    --info: #22d3ee;
    --danger: #f87171;
    --hover-row: #243348;
    --input-bg: #1e293b;
    --shadow-card: 0 1px 3px rgba(0,0,0,.3);
    --shadow-hover: 0 4px 12px rgba(0,0,0,.4);
    --scrollbar-thumb: #334155;
    --scrollbar-thumb-hover: #475569;
    --scrollbar-track: #1e293b;
    --modal-bg: #1e293b;
    --modal-border: #2d3f55;
    --input-readonly-bg: #162032;
}
*{ box-sizing: border-box; }
body {
    margin: 0;
    background: var(--bg-main);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--text-main);
    overflow-x: hidden;
    transition: background 0.3s ease, color 0.3s ease;
}
.dashboard-wrapper { width: 100%; padding: 12px; margin-top: 60px; }
.dashboard-content { width: 100%; max-width: 1680px; margin: 0 auto; }

/* ── KPI CARDS ── */
.cards-4 {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    margin-bottom: 14px;
}
@media (max-width: 1200px) { .cards-4 { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 768px)  { .cards-4 { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 576px)  { .cards-4 { grid-template-columns: 1fr; } }

/* ── PIVOT TABLE ── */
.pivot-wrap { overflow-x: auto; }
.pivot-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.pivot-table thead th {
    background: var(--bg-header); color: var(--text-muted); font-size: 10px;
    text-transform: uppercase; letter-spacing: .5px; padding: 10px 14px;
    border-bottom: 2px solid var(--border-soft); text-align: center; white-space: nowrap;
    position: sticky; top: 0; z-index: 5;
}
.pivot-table thead th:first-child,
.pivot-table thead th:nth-child(2) { text-align: left; }
.pivot-table tbody td {
    padding: 8px 14px; border-bottom: 1px solid var(--border-soft);
    text-align: center; color: var(--text-main);
}
.pivot-row:hover td { background: var(--hover-row); }
.pivot-subtotal td { background: var(--bg-header); font-size: 11px; }
.pivot-grand    td { background: var(--bg-header); font-weight: 700; font-size: 12px; border-top: 2px solid var(--border-soft); }
.pivot-tipo-badge {
    display: inline-block; padding: 3px 9px; border-radius: 5px;
    font-size: 11px; font-weight: 600; white-space: nowrap;
}

/* ── FILTROS BAR ── */
.filters-bar {
    display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
    margin-bottom: 12px;
}
.filters-bar select, .filters-bar input {
    background: var(--bg-card); color: var(--text-main);
    border: 1px solid var(--border-soft); border-radius: 8px;
    padding: 7px 12px; font-size: 12px; cursor: pointer;
    transition: border-color .2s, background .3s, color .3s;
}
.filters-bar select:focus, .filters-bar input:focus {
    outline: none; border-color: var(--primary);
}
.btn-filter-clear {
    padding: 7px 14px; border-radius: 8px; font-size: 12px; font-weight: 600;
    background: transparent; border: 1px solid var(--border-soft);
    color: var(--text-muted); cursor: pointer; transition: all .2s;
}
.btn-filter-clear:hover { background: var(--border-soft); color: var(--text-main); }
.btn-export {
    padding: 7px 14px; border-radius: 8px; font-size: 12px; font-weight: 600;
    background: #10b981; border: none; color: #fff; cursor: pointer;
    display: flex; align-items: center; gap: 5px; transition: background .2s;
}
.btn-export:hover { background: #059669; }

.kpi-card {
    background: var(--bg-card);
    border-radius: 12px;
    height: 80px;
    padding: 12px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--border-soft);
    box-shadow: var(--shadow-card);
    transition: all 0.2s, background 0.3s, border-color 0.3s;
}
.kpi-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-hover); }
.kpi-title { font-size: 9px; letter-spacing:.5px; text-transform:uppercase; color:var(--text-muted); font-weight:600; margin-bottom:5px; }
.kpi-value { font-size: 24px; font-weight: 700; line-height: 1; }
.kpi-icon  { font-size: 28px; opacity: .25; }
.primary { color: var(--primary); }
.success { color: var(--success); }
.warning { color: var(--warning); }
.info    { color: var(--info); }
.danger  { color: var(--danger); }

/* ── CHARTS ROW ── */
.row-dashboard {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: 14px;
    margin-bottom: 14px;
}
@media (max-width: 1200px) { .row-dashboard { grid-template-columns: 1fr; } }

/* ── CARD BI ── */
.card-bi {
    background: var(--bg-card);
    border-radius: 12px;
    border: 1px solid var(--border-soft);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: background 0.3s, border-color 0.3s;
}
.card-bi-header {
    padding: 14px 20px;
    border-bottom: 1px solid var(--border-soft);
    font-weight: 600;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-header);
    flex-shrink: 0;
    color: var(--text-main);
    transition: background 0.3s, border-color 0.3s, color 0.3s;
}
.card-bi-body { padding: 0; flex: 1; overflow: auto; min-height: 0; }
.card-distribucion { height: 360px; }
.card-top-modelos  { height: 360px; }

/* ── TABLE ── */
.table { width: 100%; margin-bottom: 0; font-size: 13px; color: var(--text-main); }
.table thead th {
    font-size: 10px; text-transform: uppercase; color: var(--text-muted);
    background: var(--bg-header); border-bottom: 1px solid var(--border-soft);
    padding: 12px 16px; font-weight: 600; text-align: center;
    position: sticky; top: 0; z-index: 10;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
}
.table tbody td {
    padding: 14px 16px; font-size: 13px; vertical-align: middle;
    text-align: center; border-bottom: 1px solid var(--border-soft);
    color: var(--text-main); background: transparent;
    transition: background 0.15s, border-color 0.3s, color 0.3s;
}
.table tbody td:first-child { text-align: left; font-weight: 600; }
.table-hover tbody tr:hover td { background-color: var(--hover-row) !important; }
[data-theme="dark"] .table { --bs-table-bg: transparent; --bs-table-border-color: var(--border-soft); }
[data-theme="dark"] .table-hover > tbody > tr:hover > * { --bs-table-accent-bg: var(--hover-row); }

.badge { font-size: 11px; padding: 5px 10px; border-radius: 6px; font-weight: 600; }

/* ── SEARCH BOX ── */
.search-box { position: relative; margin-bottom: 12px; }
.search-box input {
    width: 100%; padding: 11px 16px;
    border: 2px solid var(--border-soft); border-radius: 12px;
    font-size: 14px; background: var(--bg-card); color: var(--text-main);
    transition: all 0.2s, background 0.3s, color 0.3s, border-color 0.3s;
}
.search-box input::placeholder { color: var(--text-muted); }
.search-box input:focus {
    outline: none; border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(59,130,246,.1);
    background: var(--bg-card); color: var(--text-main);
}

.card-equipos .card-bi-body { max-height: 600px; }
.table-equipos thead th { background: var(--bg-header); position: sticky; top: 0; z-index: 10; }

.mini-spin {
    display:inline-block; width:14px; height:14px;
    border:2px solid var(--border-soft); border-top-color:var(--primary);
    border-radius:50%; animation:spin .65s linear infinite;
}
@keyframes spin { to { transform:rotate(360deg); } }

.form-control, .form-select {
    background-color: var(--input-bg); color: var(--text-main);
    border-color: var(--border-soft);
    transition: background 0.3s, border-color 0.3s, color 0.3s;
}
.form-control:focus, .form-select:focus {
    background-color: var(--input-bg); color: var(--text-main);
    border-color: var(--primary); box-shadow: 0 0 0 3px rgba(59,130,246,.15);
}
.form-control::placeholder { color: var(--text-muted); }
.form-control.bg-light, .form-control[readonly] {
    background-color: var(--input-readonly-bg) !important; color: var(--text-muted);
}
.form-label { color: var(--text-main); transition: color 0.3s; }
[data-theme="dark"] .modal-content { background-color: var(--modal-bg); border-color: var(--modal-border); color: var(--text-main); }
[data-theme="dark"] .modal-body, [data-theme="dark"] .modal-footer { background-color: var(--modal-bg); border-color: var(--modal-border); }
[data-theme="dark"] .btn-secondary { background-color: #334155; border-color: #475569; color: #e2e8f0; }
[data-theme="dark"] .btn-secondary:hover { background-color: #475569; }
.btn-sm { padding: 6px 14px; font-size: 12px; font-weight: 600; }
.btn-outline-secondary { border-color: var(--border-soft); color: var(--text-muted); background: transparent; }
.btn-outline-secondary:hover { background-color: var(--border-soft); color: var(--text-main); }
.btn-outline-primary { border-color: var(--primary); color: var(--primary); background: transparent; }
.btn-outline-primary:hover { background-color: var(--primary); border-color: var(--primary); color: white; }
.text-muted { color: var(--text-muted) !important; transition: color 0.3s; }
.border-top { border-color: var(--border-soft) !important; }
*::-webkit-scrollbar { width: 6px; height: 6px; }
*::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb); border-radius: 3px; }
*::-webkit-scrollbar-thumb:hover { background: var(--scrollbar-thumb-hover); }
*::-webkit-scrollbar-track { background: var(--scrollbar-track); }

/* ── ASG TAB: compat variables ── */
:root,[data-theme="light"]{
  --card-bg:var(--bg-card);--bdr:var(--border-soft);--txt:var(--text-main);--mut:var(--text-muted);
  --hdr-bg:var(--bg-header);--inp:var(--input-bg);--hov:var(--hover-row);
  --sh:var(--shadow-card);--sh-md:var(--shadow-hover);
  --clr-ok:var(--success);--clr-red:var(--danger);--clr-blue:var(--primary);
  --clr-warn:var(--warning);--clr-info:var(--info);--clr-purple:#8b5cf6;
  --st-act-bg:#dcfce7;--st-act-txt:#16a34a;--st-baj-bg:#fee2e2;--st-baj-txt:#dc2626;
  --eq-lap-bg:#dbeafe;--eq-lap-c:#2563eb;--eq-dsk-bg:#d1fae5;--eq-dsk-c:#059669;
  --eq-mon-bg:#fef3c7;--eq-mon-c:#d97706;--eq-tab-bg:#ede9fe;--eq-tab-c:#7c3aed;
  --row-rec-bg:#f0fdf4;--row-rec-bdr:#10b981;
}
[data-theme="dark"]{
  --clr-purple:#a78bfa;
  --st-act-bg:#064e3b;--st-act-txt:#6ee7b7;--st-baj-bg:#450a0a;--st-baj-txt:#fca5a5;
  --eq-lap-bg:#1e3a5f;--eq-lap-c:#93c5fd;--eq-dsk-bg:#064e3b;--eq-dsk-c:#6ee7b7;
  --eq-mon-bg:#422006;--eq-mon-c:#fde68a;--eq-tab-bg:#2e1065;--eq-tab-c:#c4b5fd;
  --row-rec-bg:#0a2a1a;--row-rec-bdr:#34d399;
}
/* ASG KPI grid */
.asg-wrap{display:flex;flex-direction:column;gap:16px;padding:20px;}
.kpi-grid-asg{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;}
@media(max-width:1400px){.kpi-grid-asg{grid-template-columns:repeat(3,1fr);}}
@media(max-width:700px){.kpi-grid-asg{grid-template-columns:repeat(2,1fr);}}
.asg-kpi{background:var(--bg-card);border:1px solid var(--bdr);border-radius:14px;padding:16px 18px;box-shadow:var(--sh);position:relative;overflow:hidden;transition:transform .2s,background .3s,border-color .3s;}
.asg-kpi:hover{transform:translateY(-2px);box-shadow:var(--sh-md);}
.asg-kpi.k-ok{border-left:4px solid var(--clr-ok);}
.asg-kpi.k-red{border-left:4px solid var(--clr-red);}
.asg-kpi.k-blue{border-left:4px solid var(--clr-blue);}
.asg-kpi.k-warn{border-left:4px solid var(--clr-warn);}
.asg-kpi.k-info{border-left:4px solid var(--clr-info);}
.asg-kpi.k-purple{border-left:4px solid var(--clr-purple);}
.asg-kpi .kl{font-size:10px;text-transform:uppercase;letter-spacing:.6px;color:var(--mut);font-weight:700;margin-bottom:8px;}
.asg-kpi .kv{font-size:28px;font-weight:900;line-height:1;letter-spacing:-1px;color:var(--txt);}
.asg-kpi .kv.sm{font-size:15px;font-weight:700;letter-spacing:0;margin-top:4px;}
.asg-kpi .ki{font-size:28px;opacity:.12;position:absolute;right:14px;top:50%;transform:translateY(-50%);}
.c-ok{color:var(--clr-ok);}.c-red{color:var(--clr-red);}.c-blue{color:var(--clr-blue);}
.c-warn{color:var(--clr-warn);}.c-info{color:var(--clr-info);}.c-purple{color:var(--clr-purple);}
/* ASG charts */
.charts-row-2{display:grid;grid-template-columns:1.7fr 1fr;gap:14px;}
@media(max-width:1100px){.charts-row-2{grid-template-columns:1fr;}}
.asg-card{background:var(--bg-card);border:1px solid var(--bdr);border-radius:14px;overflow:hidden;box-shadow:var(--sh);transition:background .3s,border-color .3s;}
.asg-card-head{padding:13px 18px;background:var(--bg-header);border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;color:var(--mut);}
.asg-card-head .hl{display:flex;align-items:center;gap:7px;}
.asg-card-body{padding:16px;}
.asg-card-body canvas{max-height:225px;}
/* Top list */
.top-list{padding:0;margin:0;list-style:none;}
.top-list-item{display:flex;align-items:center;gap:10px;padding:9px 16px;border-bottom:1px solid var(--bdr);font-size:12px;transition:background .1s;}
.top-list-item:last-child{border-bottom:none;}
.top-list-item:hover{background:var(--hover-row);}
.rank-badge{width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;flex-shrink:0;background:var(--bdr);color:var(--mut);}
.rank-1{background:#ffd700;color:#000;}.rank-2{background:#c0c0c0;color:#000;}.rank-3{background:#cd7f32;color:#fff;}
.top-name{flex:1;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.top-bar-wrap{width:70px;background:var(--bdr);border-radius:4px;height:5px;}
.top-bar{height:5px;border-radius:4px;background:var(--primary);}
.top-count{font-weight:700;font-size:12px;color:var(--txt);min-width:24px;text-align:right;}
/* Pills */
.asg-pills-bar{padding:10px 18px;border-bottom:1px solid var(--bdr);background:var(--bg-card);display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.asg-pills-label{font-size:10px;color:var(--mut);font-weight:700;text-transform:uppercase;letter-spacing:.4px;}
.asg-fpill{padding:4px 13px;border-radius:20px;font-size:11px;font-weight:600;cursor:pointer;border:1.5px solid var(--bdr);background:var(--input-bg);color:var(--mut);transition:all .15s;display:flex;align-items:center;gap:5px;line-height:1.7;}
.asg-fpill:hover{border-color:var(--primary);color:var(--primary);}
.asg-fpill.active{background:var(--primary);color:#fff;border-color:var(--primary);}
.asg-fpill.p-month.active{background:var(--info);border-color:var(--info);}
.asg-fpill.p-multi.active{background:var(--warning);color:#000;border-color:var(--warning);}
/* Table */
.asg-tbl-scroll{overflow:auto;max-height:560px;}
.asg-tbl{width:100%;border-collapse:collapse;font-size:12.5px;}
.asg-tbl thead th{font-size:10px;text-transform:uppercase;color:var(--mut);font-weight:700;padding:10px 14px;background:var(--bg-header);border-bottom:1px solid var(--bdr);white-space:nowrap;position:sticky;top:0;z-index:10;text-align:center;}
.asg-tbl tbody td{padding:11px 14px;border-bottom:1px solid var(--bdr);color:var(--txt);vertical-align:middle;text-align:center;}
.asg-tbl tbody tr:hover td{background:var(--hover-row);}
.asg-tbl tbody tr:last-child td{border-bottom:none;}
.asg-tbl tbody tr.row-recent td{background:var(--row-rec-bg);}
.asg-tbl tbody tr.row-recent td:first-child{border-left:3px solid var(--row-rec-bdr);}
/* Panel head */
.asg-panel-head{padding:13px 18px;background:var(--bg-header);border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
.asg-panel-title{font-size:13px;font-weight:800;color:var(--txt);display:flex;align-items:center;gap:8px;}
.asg-toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.asg-search-wrap{position:relative;}
.asg-search-wrap i.ico{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--mut);font-size:13px;pointer-events:none;}
.asg-search-input{background:var(--input-bg);border:1px solid var(--bdr);color:var(--txt);border-radius:9px;padding:7px 12px 7px 32px;font-size:12.5px;width:260px;outline:none;}
.asg-search-input:focus{border-color:var(--primary);}
/* Badges & pills */
.badge-count{background:var(--info);color:#fff;border-radius:20px;padding:2px 9px;font-size:11px;font-weight:700;}
.asg-pill{display:inline-block;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap;line-height:1.6;}
.ap-blue{background:rgba(59,130,246,.13);color:var(--primary);}
.ap-green{background:rgba(16,185,129,.13);color:var(--success);}
.ap-yellow{background:rgba(245,158,11,.13);color:var(--warning);}
.ap-gray{background:rgba(100,116,139,.10);color:var(--text-muted);}
.ap-purple{background:rgba(139,92,246,.13);color:var(--clr-purple);}
.asg-eq-icon{width:26px;height:26px;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;margin-right:5px;flex-shrink:0;vertical-align:middle;}
.asg-eq-laptop{background:var(--eq-lap-bg);color:var(--eq-lap-c);}
.asg-eq-desktop{background:var(--eq-dsk-bg);color:var(--eq-dsk-c);}
.asg-eq-monitor{background:var(--eq-mon-bg);color:var(--eq-mon-c);}
.asg-eq-tablet{background:var(--eq-tab-bg);color:var(--eq-tab-c);}
.asg-eq-other{background:var(--bdr);color:var(--mut);}
/* Pagination */
.asg-tbl-foot{padding:10px 18px;border-top:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;background:var(--bg-header);}
.asg-tbl-info{font-size:11.5px;color:var(--mut);}
.asg-pag-btns{display:flex;gap:4px;}
.asg-pg-btn{background:var(--bg-card);border:1px solid var(--bdr);color:var(--txt);border-radius:7px;padding:4px 10px;font-size:12px;cursor:pointer;transition:.15s;}
.asg-pg-btn:hover,.asg-pg-btn.active{background:var(--primary);color:#fff;border-color:var(--primary);}
.asg-pg-btn:disabled{opacity:.4;cursor:not-allowed;}
/* Buttons */
.asg-btn-ghost{background:transparent;border:1px solid var(--bdr);color:var(--mut);border-radius:9px;padding:6px 12px;font-size:12px;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:all .15s;}
.asg-btn-ghost:hover{border-color:var(--primary);color:var(--primary);}
.asg-btn-success{background:var(--success);color:#fff;border:none;border-radius:9px;padding:7px 14px;font-size:12.5px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all .2s;}
.asg-btn-success:hover{filter:brightness(1.1);}
.asg-btn-primary{background:var(--primary);color:#fff;border:none;border-radius:9px;padding:7px 14px;font-size:12.5px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all .2s;}
.asg-btn-primary:hover{filter:brightness(1.1);}
/* Autocomplete */
.asg-ac-results{display:none;max-height:200px;overflow-y:auto;border:1px solid var(--bdr);border-radius:9px;margin-top:4px;box-shadow:var(--sh-md);background:var(--bg-card);z-index:9999;position:relative;}
.asg-ac-item{padding:10px 13px;cursor:pointer;border-bottom:1px solid var(--bdr);transition:background .12s;font-size:13px;color:var(--txt);}
.asg-ac-item:hover{background:var(--hover-row);}
.asg-ac-item:last-child{border-bottom:none;}
.asg-ac-name{font-weight:600;display:block;}
.asg-ac-sub{font-size:11px;color:var(--mut);}
/* Modal fields */
.asg-field-input{padding:10px 14px;border:1.5px solid var(--bdr);border-radius:10px;font-size:13px;background:var(--input-bg);color:var(--txt);outline:none;width:100%;transition:all .2s;}
.asg-field-input:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(59,130,246,.10);}
.asg-field-input[readonly]{opacity:.7;cursor:not-allowed;}
.asg-field-input::placeholder{color:var(--text-muted);opacity:.6;}
.asg-form-label{font-weight:700;font-size:11px;color:var(--mut);text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px;display:block;}
.asg-empty{text-align:center;padding:40px 20px;color:var(--text-muted);}
.asg-empty i{font-size:32px;display:block;margin-bottom:10px;opacity:.3;}
.asg-empty p{font-size:13px;}
/* ── EQUIPMENT TABS ── */
.eq-tabs { display:flex; gap:4px; padding:8px 16px; background:var(--bg-card); border-bottom:1px solid var(--border-soft); position:sticky; top:60px; z-index:100; }
.eq-tab-btn { padding:7px 16px; border-radius:8px; font-size:13px; font-weight:600; border:1px solid transparent; cursor:pointer; background:transparent; color:var(--text-muted); transition:all .2s; display:flex; align-items:center; gap:6px; }
.eq-tab-btn.active { background:var(--primary); color:#fff; border-color:var(--primary); }
.eq-tab-btn:hover:not(.active) { background:var(--border-soft); color:var(--text-main); }
.alm-sub-btn { padding:5px 14px; border-radius:7px; font-size:12px; font-weight:600; border:1px solid var(--border-soft); cursor:pointer; background:transparent; color:var(--text-muted); display:inline-flex; align-items:center; gap:5px; transition:all .15s; }
.alm-sub-btn.active { background:var(--primary); color:#fff; border-color:var(--primary); }
.alm-sub-btn:hover:not(.active) { background:var(--border-soft); color:var(--text-main); }
.cfg-nav-btn { display:flex; align-items:center; gap:8px; width:100%; padding:9px 18px; font-size:12px; font-weight:600; color:var(--text-muted); background:transparent; border:none; cursor:pointer; text-align:left; transition:all .15s; border-left:3px solid transparent; }
.cfg-nav-btn.active { color:var(--primary); background:rgba(37,99,235,.07); border-left-color:var(--primary); }
.cfg-nav-btn:hover:not(.active) { background:var(--border-soft); color:var(--text-main); }
.eq-panel { display:none; }
.eq-panel.active { display:block; }
.eq-panel .dashboard-wrapper { margin-top:0; }
/* ── INTUNE ── */
.intune-bar { display:flex; gap:8px; align-items:center; padding:12px 20px; border-bottom:1px solid var(--border-soft); flex-wrap:wrap; }
.intune-bar input { flex:1; min-width:200px; padding:7px 14px; border:1.5px solid var(--border-soft); border-radius:8px; background:var(--bg-card); color:var(--text-main); font-size:13px; }
.intune-bar input:focus { outline:none; border-color:var(--primary); }
.badge-compliant { background:#d1fae5; color:#065f46; border:1px solid #6ee7b7; border-radius:6px; padding:3px 9px; font-size:11px; font-weight:700; white-space:nowrap; }
.badge-noncompliant { background:#fee2e2; color:#991b1b; border:1px solid #fca5a5; border-radius:6px; padding:3px 9px; font-size:11px; font-weight:700; white-space:nowrap; }
.badge-grace { background:#fef3c7; color:#92400e; border:1px solid #fcd34d; border-radius:6px; padding:3px 9px; font-size:11px; font-weight:700; white-space:nowrap; }
.badge-unk { background:var(--bg-header); color:var(--text-muted); border:1px solid var(--border-soft); border-radius:6px; padding:3px 9px; font-size:11px; font-weight:600; white-space:nowrap; }
.badge-enc { background:#dbeafe; color:#1e40af; border:1px solid #93c5fd; border-radius:6px; padding:3px 9px; font-size:11px; font-weight:700; white-space:nowrap; }
.badge-noenc { background:#fef9c3; color:#854d0e; border:1px solid #fde047; border-radius:6px; padding:3px 9px; font-size:11px; font-weight:600; white-space:nowrap; }
.intune-pager { display:flex; align-items:center; gap:8px; padding:10px 20px; justify-content:flex-end; font-size:12px; color:var(--text-muted); border-top:1px solid var(--border-soft); }
.intune-pager button { padding:4px 11px; border-radius:7px; border:1px solid var(--border-soft); background:var(--bg-card); color:var(--text-muted); cursor:pointer; font-size:12px; transition:all .2s; }
.intune-pager button:hover:not(:disabled) { background:var(--primary); color:#fff; border-color:var(--primary); }
.intune-pager button:disabled { opacity:.35; cursor:not-allowed; }
/* ── COMPLIANCE ── */
.comp-kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-bottom:14px; }
@media (max-width:900px) { .comp-kpis { grid-template-columns:repeat(2,1fr); } }
.comp-kpi { background:var(--bg-card); border-radius:12px; border:2px solid var(--border-soft); padding:14px 16px; display:flex; justify-content:space-between; align-items:center; box-shadow:var(--shadow-card); cursor:pointer; transition:all .2s; }
.comp-kpi:hover { transform:translateY(-2px); box-shadow:var(--shadow-hover); }
.comp-kpi.active-filter { border-color:var(--primary) !important; box-shadow:0 0 0 3px rgba(59,130,246,.15); }
.comp-kpi-label { font-size:9px; letter-spacing:.5px; text-transform:uppercase; font-weight:700; color:var(--text-muted); margin-bottom:6px; }
.comp-kpi-val { font-size:28px; font-weight:700; line-height:1; }
.comp-pills { display:flex; gap:6px; margin-bottom:12px; flex-wrap:wrap; }
.comp-pill { padding:6px 14px; border-radius:20px; font-size:12px; font-weight:600; border:1.5px solid var(--border-soft); background:var(--bg-card); color:var(--text-muted); cursor:pointer; transition:all .2s; }
.comp-pill.on { background:var(--primary); color:#fff; border-color:var(--primary); }
