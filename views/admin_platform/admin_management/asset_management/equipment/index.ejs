          <span id="rmmInvName" style="font-weight:700;">—</span>
          <span style="font-size:11px;padding:2px 8px;border-radius:10px;background:var(--bg-soft);color:var(--text-muted);border:1px solid var(--border-soft);" id="rmmInvStatusBadge"></span>
        </span>
        <button onclick="closeRMMInventory()" style="background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.25);color:#f87171;border-radius:7px;padding:4px 12px;font-size:11px;font-weight:700;cursor:pointer;"><i class="bi bi-x-lg"></i> Cerrar</button>
      </div>
      <!-- Tabs -->
      <div style="display:flex;border-bottom:1px solid var(--border-soft);padding:0 16px;gap:4px;">
        <button id="invTab-sys"  class="rmm-inv-tab active" onclick="switchInvTab('sys')"><i class="bi bi-info-circle me-1"></i>Sistema</button>
        <button id="invTab-upd"  class="rmm-inv-tab"        onclick="switchInvTab('upd')"><i class="bi bi-shield-check me-1"></i>Actualizaciones <span id="invBadge-upd" style="display:none;font-size:10px;background:#3b82f6;color:#fff;border-radius:8px;padding:1px 6px;margin-left:4px;"></span></button>
        <button id="invTab-apps" class="rmm-inv-tab"        onclick="switchInvTab('apps')"><i class="bi bi-grid-3x3-gap me-1"></i>Aplicaciones <span id="invBadge-apps" style="display:none;font-size:10px;background:#8b5cf6;color:#fff;border-radius:8px;padding:1px 6px;margin-left:4px;"></span></button>
        <button id="invTab-run"  class="rmm-inv-tab"        onclick="switchInvTab('run')"><i class="bi bi-terminal me-1"></i>Ejecutar Script</button>
      </div>
      <!-- Sistema -->
      <div id="invPanel-sys" class="inv-tab-content">
        <div id="invContent-sys" style="padding:16px;"><div class="text-center py-4"><span class="mini-spin"></span></div></div>
      </div>
      <!-- Actualizaciones -->
      <div id="invPanel-upd" class="inv-tab-content" style="display:none;">
        <div style="padding:12px 16px 0;">
          <input id="invSearch-upd" type="text" class="form-control form-control-sm" placeholder="Buscar actualización (KB, descripción)..." oninput="filterInv('upd')">
        </div>
        <div id="invContent-upd" style="max-height:420px;overflow:auto;"><div class="text-center py-4"><span class="mini-spin"></span></div></div>
      </div>
      <!-- Apps -->
      <div id="invPanel-apps" class="inv-tab-content" style="display:none;">
        <div style="padding:12px 16px 0;">
          <input id="invSearch-apps" type="text" class="form-control form-control-sm" placeholder="Buscar aplicación, publicador..." oninput="filterInv('apps')">
        </div>
        <div id="invContent-apps" style="max-height:420px;overflow:auto;"><div class="text-center py-4"><span class="mini-spin"></span></div></div>
      </div>
      <!-- Ejecutar Script -->
      <div id="invPanel-run" class="inv-tab-content" style="display:none;">
        <div style="padding:16px;">
          <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-bottom:12px;">
            <div style="flex:1;min-width:160px;">
              <label style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:4px;">Colección</label>
              <select id="runScriptCol" class="form-select form-select-sm" onchange="onRunColChange()">
                <option value="">Cargando...</option>
              </select>
            </div>
            <div style="flex:2;min-width:200px;">
              <label style="font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:4px;">Script</label>
              <select id="runScriptSel" class="form-select form-select-sm" onchange="onRunScriptChange()">
                <option value="">— selecciona colección primero —</option>
              </select>
            </div>
            <button onclick="execInvScript()" id="runScriptBtn" class="btn btn-sm btn-primary" style="white-space:nowrap;padding:6px 16px;font-size:12px;" disabled>
              <i class="bi bi-play-fill me-1"></i>Ejecutar
            </button>
          </div>
          <!-- Separador o/y -->
          <div style="display:flex;align-items:center;gap:8px;margin:4px 0 10px;">
            <div style="flex:1;height:1px;background:var(--border-soft);"></div>
            <span style="font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;">ó pega un comando</span>
            <div style="flex:1;height:1px;background:var(--border-soft);"></div>
          </div>
          <textarea id="runCustomCode" rows="4" placeholder="Write-Host 'Hola mundo'&#10;Get-Date&#10;ipconfig /all"
            style="width:100%;font-family:monospace;font-size:12px;background:#0a0f1e;color:#93c5fd;border:1px solid #1e293b;border-radius:8px;padding:10px 12px;resize:vertical;margin-bottom:10px;outline:none;"
            oninput="onCustomCodeInput()"></textarea>
          <!-- Preview código de librería -->
          <div id="runScriptPreview" style="display:none;margin-bottom:10px;">
            <div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;">Vista previa del script seleccionado</div>
            <pre id="runScriptCode" style="background:#0f172a;color:#94a3b8;font-size:11px;padding:10px 14px;border-radius:8px;max-height:120px;overflow:auto;margin:0;border:1px solid #1e293b;white-space:pre-wrap;"></pre>
          </div>
          <!-- Output terminal -->
          <div style="font-size:10px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;">Output</div>
          <div id="runScriptOutput" style="background:#0a0f1e;border:1px solid #1e293b;border-radius:8px;padding:14px;min-height:180px;max-height:380px;overflow:auto;">
            <span style="color:#334155;font-size:12px;font-family:monospace;">Selecciona un script o pega un comando y presiona Ejecutar...</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Panel de alertas RMM -->
<div id="rmmAlertsPanel" style="display:none;padding:0 12px 12px;max-width:1680px;margin:0 auto;">
