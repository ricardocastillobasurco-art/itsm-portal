        <div><label style="font-size:11px;color:var(--text-muted);">Tipo</label><select id="cfType" class="form-control form-control-sm"><option value="exe">EXE</option><option value="msi">MSI</option><option value="ps1">PS1</option><option value="zip">ZIP</option></select></div>
        <div><label style="font-size:11px;color:var(--text-muted);">Categoría</label><input type="text" id="cfCategory" class="form-control form-control-sm" placeholder="General"></div>
        <div><label style="font-size:11px;color:var(--text-muted);">SHA256 (opcional)</label><input type="text" id="cfSha256" class="form-control form-control-sm" placeholder="Verificación de integridad"></div>
      </div>
      <div style="margin-bottom:12px;"><label style="font-size:11px;color:var(--text-muted);">Argumentos silenciosos</label><input type="text" id="cfArgs" class="form-control form-control-sm" placeholder="/S o /qn o -ms"></div>
      <div style="display:flex;gap:8px;">
        <button class="btn btn-sm btn-primary" onclick="saveCatalogItem()" style="font-size:11px;">Guardar</button>
        <button class="btn btn-sm btn-outline-secondary" onclick="closeCatalogForm()" style="font-size:11px;">Cancelar</button>
      </div>
    </div>
  </div>
</div>

