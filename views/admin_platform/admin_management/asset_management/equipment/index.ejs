// ── DISPOSITIVOS INTUNE ───────────────────────────────────────────────────────
var _intuneData = [], _intunePage = 0, _intunePageSize = 25, _intuneQ = '';

function loadIntune(reset) {
    if (reset) { _intunePage = 0; _intuneQ = (document.getElementById('intuneSearch').value || '').trim(); }
    var tbody = document.getElementById('intuneTableBody');
    tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4"><span class="mini-spin"></span></td></tr>';
    var url = '/api/ms/devices?top=200&skip=0';
    if (_intuneQ) url += '&q=' + encodeURIComponent(_intuneQ);
    fetch(url, { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(json) {
            if (!json.success) {
                tbody.innerHTML = _msgMsLogin(7);
                return;
            }
            _intuneData = json.data || [];
            _intunePage = 0;
            document.getElementById('intuneTotal').textContent = _intuneData.length;
            renderIntuneTable();
            document.getElementById('btnExportIntune').onclick = exportIntuneCSV;
        })
        .catch(function(){
            tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-danger">Error al cargar dispositivos</td></tr>';
        });
}

function renderIntuneTable() {
    var tbody = document.getElementById('intuneTableBody');
    var start = _intunePage * _intunePageSize;
    var rows  = _intuneData.slice(start, start + _intunePageSize);
    if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-5 text-muted">Sin resultados</td></tr>';
        document.getElementById('intunePagerInfo').textContent = '0 resultados';
        document.getElementById('intunePrevBtn').disabled = true;
        document.getElementById('intuneNextBtn').disabled = true;
        return;
    }
    tbody.innerHTML = rows.map(function(d) {
        var comp = d.complianceState === 'compliant'    ? '<span class="badge-compliant"><i class="bi bi-shield-check me-1"></i>compliant</span>'
                 : d.complianceState === 'noncompliant' ? '<span class="badge-noncompliant"><i class="bi bi-shield-x me-1"></i>noncompliant</span>'
                 : d.complianceState === 'inGracePeriod'? '<span class="badge-grace"><i class="bi bi-hourglass-split me-1"></i>grace period</span>'
                 : '<span class="badge-unk">' + _esc(d.complianceState || 'unknown') + '</span>';
        var enc  = d.isEncrypted ? '<span class="badge-enc"><i class="bi bi-lock-fill me-1"></i>Cifrado</span>'
                                 : '<span class="badge-noenc"><i class="bi bi-unlock me-1"></i>Sin cifrado</span>';
        var disco = (d.freeGB != null && d.totalGB != null) ? d.freeGB + '/' + d.totalGB + ' GB' : '—';
        return '<tr>'
            + '<td style="text-align:left;">'
            +   '<strong style="font-family:monospace;font-size:12px;">' + _esc(d.deviceName || '—') + '</strong>'
            +   '<div style="font-size:10px;color:var(--text-muted);margin-top:2px;">' + _esc((d.manufacturer||'') + ' ' + (d.model||'')) + '</div></td>'
            + '<td><div style="font-size:12px;font-weight:600;">' + _esc(d.userDisplayName || '—') + '</div>'
            +   '<div style="font-size:10px;color:var(--text-muted);">' + _esc(d.userPrincipalName || '') + '</div></td>'
            + '<td style="font-size:12px;">' + _esc(d.operatingSystem || '—')
            +   '<div style="font-size:10px;color:var(--text-muted);">' + _esc(d.osVersion || '') + '</div></td>'
            + '<td>' + comp + '</td>'
            + '<td>' + enc + '</td>'
            + '<td style="font-size:12px;white-space:nowrap;">' + _esc(disco) + '</td>'
            + '<td style="font-size:11px;white-space:nowrap;color:var(--text-muted);">' + _fmtSync(d.lastSyncDateTime) + '</td>'
            + '</tr>';
    }).join('');
    var total = _intuneData.length;
    var end   = Math.min(start + _intunePageSize, total);
    document.getElementById('intunePagerInfo').textContent = (start+1) + '–' + end + ' de ' + total;
    document.getElementById('intunePrevBtn').disabled = (_intunePage === 0);
    document.getElementById('intuneNextBtn').disabled = (end >= total);
}

function intuneChangePage(dir) {
    _intunePage += dir;
    renderIntuneTable();
    document.getElementById('tab-dispositivos').querySelector('.card-bi-body').scrollTop = 0;
}

function clearIntuneSearch() {
    document.getElementById('intuneSearch').value = '';
    _intuneQ = '';
    loadIntune(true);
}

function exportIntuneCSV() {
    if (!_intuneData.length) return;
    var cols = ['deviceName','userDisplayName','userPrincipalName','operatingSystem','osVersion','complianceState','isEncrypted','totalGB','freeGB','lastSyncDateTime'];
    var hdr  = ['Equipo','Usuario','Email','SO','Version SO','Cumplimiento','Cifrado','Disco Total GB','Disco Libre GB','Ultima Sync'];
    var csv  = [hdr].concat(_intuneData.map(function(d){
        return cols.map(function(c){ var v=String(d[c]==null?'':d[c]); return (v.includes(',')||v.includes('"'))?'"'+v.replace(/"/g,'""')+'"':v; });
    })).map(function(r){ return r.join(','); }).join('\n');
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob(['﻿'+csv], {type:'text/csv;charset=utf-8;'}));
    a.download = 'dispositivos_intune_' + new Date().toISOString().slice(0,10) + '.csv';
    a.click();
}

// ── CUMPLIMIENTO ──────────────────────────────────────────────────────────────
var _compData = [], _compActiveFilter = 'all';

function loadCompliance() {
    document.getElementById('compTableBody').innerHTML = '<tr><td colspan="5" class="text-center py-4"><span class="mini-spin"></span></td></tr>';
    fetch('/api/ms/compliance?top=999', { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(json) {
            if (!json.success) {
                document.getElementById('compTableBody').innerHTML = _msgMsLogin(5);
                return;
            }
            _compData = json.data || [];
            var s = json.summary || {};
            var unkCount = (s.unknown||0) + (s.notApplicable||0) + (s.error||0);
            document.getElementById('compTotal').textContent      = json.total || _compData.length;
            document.getElementById('compCompliant').textContent  = s.compliant    || 0;
            document.getElementById('compNonCompliant').textContent = s.noncompliant || 0;
            document.getElementById('compUnknown').textContent    = unkCount;
            renderCompTable();
            document.getElementById('btnExportComp').onclick = exportCompCSV;
        })
        .catch(function(){
            document.getElementById('compTableBody').innerHTML = '<tr><td colspan="5" class="text-center py-4 text-danger">Error al cargar datos</td></tr>';
        });
}

function compFilter(f) {
    _compActiveFilter = f;
    // pills
    ['All','Compliant','Non','Grace','Unk'].forEach(function(id){
        var el = document.getElementById('cp' + id); if (el) el.classList.remove('on');
    });
    var pillMap = { all:'All', compliant:'Compliant', noncompliant:'Non', inGracePeriod:'Grace', unknown:'Unk' };
    var pill = document.getElementById('cp' + (pillMap[f] || 'All')); if (pill) pill.classList.add('on');
    // kpi highlight
    ['compKpiAll','compKpiCompliant','compKpiNon','compKpiUnk'].forEach(function(id){
        var el = document.getElementById(id); if (el) el.classList.remove('active-filter');
    });
    var kpiMap = { all:'compKpiAll', compliant:'compKpiCompliant', noncompliant:'compKpiNon', unknown:'compKpiUnk' };
    var kpi = document.getElementById(kpiMap[f]); if (kpi) kpi.classList.add('active-filter');
    renderCompTable();
}

function renderCompTable() {
    var rows = _compActiveFilter === 'all'
        ? _compData
        : _compData.filter(function(d){ return d.complianceState === _compActiveFilter; });
    document.getElementById('compTableCount').textContent = rows.length;
    var tbody = document.getElementById('compTableBody');
    if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-5 text-muted">Sin registros para este filtro</td></tr>';
        return;
    }
    tbody.innerHTML = rows.map(function(d) {
        var state = d.complianceState;
        var badge = state === 'compliant'     ? '<span class="badge-compliant"><i class="bi bi-shield-check me-1"></i>Cumple</span>'
                  : state === 'noncompliant'  ? '<span class="badge-noncompliant"><i class="bi bi-shield-x me-1"></i>No Cumple</span>'
                  : state === 'inGracePeriod' ? '<span class="badge-grace"><i class="bi bi-hourglass-split me-1"></i>Periodo Gracia</span>'
                  : '<span class="badge-unk">' + _esc(state || 'unknown') + '</span>';
        return '<tr>'
            + '<td style="text-align:left;">'
            +   '<strong style="font-family:monospace;font-size:12px;">' + _esc(d.deviceName || '—') + '</strong>'
            +   '<div style="font-size:10px;color:var(--text-muted);">' + _esc((d.manufacturer||'') + ' ' + (d.model||'')) + '</div></td>'
            + '<td><div style="font-size:12px;font-weight:600;">' + _esc(d.userDisplayName || '—') + '</div>'
            +   '<div style="font-size:10px;color:var(--text-muted);">' + _esc(d.userPrincipalName || '') + '</div></td>'
            + '<td style="font-size:12px;">' + _esc(d.operatingSystem || '—')
            +   '<div style="font-size:10px;color:var(--text-muted);">' + _esc(d.osVersion || '') + '</div></td>'
            + '<td>' + badge + '</td>'
            + '<td style="font-size:11px;white-space:nowrap;color:var(--text-muted);">' + _fmtSync(d.lastSyncDateTime) + '</td>'
            + '</tr>';
    }).join('');
}

function exportCompCSV() {
    var rows = _compActiveFilter === 'all' ? _compData : _compData.filter(function(d){ return d.complianceState === _compActiveFilter; });
    if (!rows.length) return;
    var cols = ['deviceName','userDisplayName','userPrincipalName','operatingSystem','osVersion','complianceState','lastSyncDateTime'];
    var hdr  = ['Equipo','Usuario','Email','SO','Version SO','Cumplimiento','Ultima Sync'];
    var csv  = [hdr].concat(rows.map(function(d){
        return cols.map(function(c){ var v=String(d[c]==null?'':d[c]); return (v.includes(',')||v.includes('"'))?'"'+v.replace(/"/g,'""')+'"':v; });
    })).map(function(r){ return r.join(','); }).join('\n');
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob(['﻿'+csv], {type:'text/csv;charset=utf-8;'}));
    a.download = 'cumplimiento_' + new Date().toISOString().slice(0,10) + '.csv';
    a.click();
}

// ── APPS POR DISPOSITIVO ──────────────────────────────────────────────────────
var _appsAllData = [], _appsFiltered = [], _appsPage = 0, _appsPageSize = 20;
var _appsDetailData = [], _appsDetailFiltered = [];

function loadAppsTab() {
    var tbody = document.getElementById('appsDeviceBody');
    tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4"><span class="mini-spin"></span></td></tr>';
    if (_intuneData.length > 0) {
        _appsAllData = _intuneData;
        _appsFiltered = _appsAllData;
        document.getElementById('appsDevTotal').textContent = _appsAllData.length;
        renderAppsDeviceList();
        return;
    }
    fetch('/api/ms/devices?top=999&skip=0', { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(json) {
            if (!json.success) { tbody.innerHTML = _msgMsLogin(4); return; }
            _appsAllData = json.data || [];
            _appsFiltered = _appsAllData;
            document.getElementById('appsDevTotal').textContent = _appsAllData.length;
            renderAppsDeviceList();
        })
        .catch(function(){ tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-danger">Error al cargar dispositivos</td></tr>'; });
}

function filterAppsList() {
    var q = (document.getElementById('appsSearch').value || '').toLowerCase().trim();
    _appsFiltered = q ? _appsAllData.filter(function(d){
        return (d.deviceName||'').toLowerCase().includes(q)
            || (d.userDisplayName||'').toLowerCase().includes(q)
            || (d.userPrincipalName||'').toLowerCase().includes(q);
    }) : _appsAllData;
    _appsPage = 0;
    renderAppsDeviceList();
}

function renderAppsDeviceList() {
    var tbody = document.getElementById('appsDeviceBody');
    var start = _appsPage * _appsPageSize;
    var rows  = _appsFiltered.slice(start, start + _appsPageSize);
    if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted">Sin dispositivos</td></tr>';
        document.getElementById('appsPagerInfo').textContent = '0 resultados';
        document.getElementById('appsPrevBtn').disabled = true;
        document.getElementById('appsNextBtn').disabled = true;
        return;
    }
    tbody.innerHTML = rows.map(function(d) {
        return '<tr>'
            + '<td style="text-align:left;"><strong style="font-family:monospace;font-size:12px;">' + _esc(d.deviceName||'—') + '</strong>'
            + '<div style="font-size:10px;color:var(--text-muted);">' + _esc((d.manufacturer||'') + ' ' + (d.model||'')) + '</div></td>'
            + '<td><div style="font-size:12px;">' + _esc(d.userDisplayName||'—') + '</div>'
            + '<div style="font-size:10px;color:var(--text-muted);">' + _esc(d.userPrincipalName||'') + '</div></td>'
            + '<td style="font-size:12px;">' + _esc(d.operatingSystem||'—') + '</td>'
            + '<td><button class="btn btn-sm btn-outline-primary" style="padding:4px 12px;font-size:12px;" data-id="' + _esc(d.id) + '" data-name="' + _esc(d.deviceName||'—') + '" onclick="showDeviceApps(this)"><i class="bi bi-grid-3x3-gap me-1"></i>Ver apps</button></td>'
            + '</tr>';
    }).join('');
    var total = _appsFiltered.length;
    var end   = Math.min(start + _appsPageSize, total);
    document.getElementById('appsPagerInfo').textContent = (start+1) + '–' + end + ' de ' + total;
    document.getElementById('appsPrevBtn').disabled = _appsPage === 0;
    document.getElementById('appsNextBtn').disabled = end >= total;
}

function appsChangePage(dir) { _appsPage += dir; renderAppsDeviceList(); }

function showDeviceApps(btn) {
    var devId   = btn.dataset.id;
    var devName = btn.dataset.name;
    var card = document.getElementById('appsDetailCard');
    var tbody = document.getElementById('appsDetailBody');
    card.style.display = 'flex';
    card.style.flex    = '1';
    document.getElementById('appsDeviceName').textContent = devName;
    document.getElementById('appsCount').textContent = '...';
    document.getElementById('appsDetailSearch').value = '';
    tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4"><span class="mini-spin"></span></td></tr>';
    fetch('/api/ms/devices/' + devId + '/apps', { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(json) {
            _appsDetailData = json.data || [];
            _appsDetailFiltered = _appsDetailData;
            document.getElementById('appsCount').textContent = _appsDetailData.length;
            if (!_appsDetailData.length && json.hint) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center py-5" style="font-size:12px;color:var(--text-muted);"><i class="bi bi-info-circle" style="font-size:20px;display:block;margin-bottom:8px;"></i>' + _esc(json.hint) + '</td></tr>';
                return;
            }
            renderAppsDetail();
        })
        .catch(function(){ tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-danger">Error al cargar apps</td></tr>'; });
}

function filterAppsDetail() {
    var q = (document.getElementById('appsDetailSearch').value || '').toLowerCase();
    _appsDetailFiltered = q ? _appsDetailData.filter(function(a){
        return (a.displayName||'').toLowerCase().includes(q) || (a.version||'').toLowerCase().includes(q);
    }) : _appsDetailData;
    renderAppsDetail();
}

function renderAppsDetail() {
    var tbody = document.getElementById('appsDetailBody');
    if (!_appsDetailFiltered.length) { tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted">Sin aplicaciones</td></tr>'; return; }
    tbody.innerHTML = _appsDetailFiltered.map(function(a) {
        var size = a.sizeInByte ? (a.sizeInByte / 1048576).toFixed(1) + ' MB' : '—';
        var plat = a.platform || (a.deviceCount != null ? 'Windows' : '—');
        return '<tr>'
            + '<td style="text-align:left;font-size:13px;font-weight:600;">' + _esc(a.displayName||'—') + '</td>'
            + '<td style="font-size:12px;color:var(--text-muted);">' + _esc(a.version||'—') + '</td>'
            + '<td style="font-size:12px;">' + _esc(plat) + '</td>'
            + '<td style="font-size:12px;">' + size + '</td>'
            + '</tr>';
    }).join('');
}

// ── BITLOCKER ─────────────────────────────────────────────────────────────────
var _blData = [], _blActiveFilter = 'all';

function loadBitLocker() {
    document.getElementById('blTableBody').innerHTML = '<tr><td colspan="5" class="text-center py-4"><span class="mini-spin"></span></td></tr>';
    if (_intuneData.length > 0) {
        _blData = _intuneData;
        _updateBlKpis();
        blRenderTable();
        document.getElementById('btnExportBL').onclick = exportBlCSV;
        return;
    }
    fetch('/api/ms/devices?top=999&skip=0', { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(json) {
            if (!json.success) { document.getElementById('blTableBody').innerHTML = '<tr><td colspan="5" class="text-center py-5 text-muted"><i class="bi bi-cloud-slash" style="font-size:24px;display:block;margin-bottom:8px;"></i>MS Graph no disponible</td></tr>'; return; }
            _blData = json.data || [];
            _updateBlKpis();
            blRenderTable();
            document.getElementById('btnExportBL').onclick = exportBlCSV;
        })
        .catch(function(){ document.getElementById('blTableBody').innerHTML = '<tr><td colspan="5" class="text-center py-4 text-danger">Error</td></tr>'; });
}

function _updateBlKpis() {
    var enc   = _blData.filter(function(d){ return d.isEncrypted; }).length;
    var unenc = _blData.length - enc;
    var pct   = _blData.length ? Math.round(enc / _blData.length * 100) : 0;
    document.getElementById('blCifrados').textContent  = enc;
    document.getElementById('blSinCifrar').textContent = unenc;
    document.getElementById('blCobertura').textContent = pct + '%';
}

function blFilter(f) {
    _blActiveFilter = f;
    ['blPillAll','blPillEnc','blPillUnenc'].forEach(function(id){ var el=document.getElementById(id); if(el) el.classList.remove('on'); });
    var map = { all:'blPillAll', encrypted:'blPillEnc', unencrypted:'blPillUnenc' };
    var pill = document.getElementById(map[f]); if(pill) pill.classList.add('on');
    ['blKpiEnc','blKpiUnenc'].forEach(function(id){ var el=document.getElementById(id); if(el) el.classList.remove('active-filter'); });
    if(f==='encrypted')   { var k=document.getElementById('blKpiEnc');   if(k) k.classList.add('active-filter'); }
    if(f==='unencrypted') { var k=document.getElementById('blKpiUnenc'); if(k) k.classList.add('active-filter'); }
    blRenderTable();
}

function blRenderTable() {
    var q    = (document.getElementById('blSearch').value || '').toLowerCase().trim();
    var rows = _blData.filter(function(d) {
        if (_blActiveFilter === 'encrypted'   && !d.isEncrypted) return false;
        if (_blActiveFilter === 'unencrypted' &&  d.isEncrypted) return false;
        if (q && !(d.deviceName||'').toLowerCase().includes(q) && !(d.userDisplayName||'').toLowerCase().includes(q)) return false;
        return true;
    });
    document.getElementById('blTableCount').textContent = rows.length;
    var tbody = document.getElementById('blTableBody');
    if (!rows.length) { tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">Sin resultados</td></tr>'; return; }
    tbody.innerHTML = rows.map(function(d) {
        var enc  = d.isEncrypted
            ? '<span class="badge-enc"><i class="bi bi-lock-fill me-1"></i>Cifrado</span>'
            : '<span class="badge-noenc"><i class="bi bi-unlock me-1"></i>Sin cifrar</span>';
        var comp = d.complianceState === 'compliant'
            ? '<span class="badge-compliant">compliant</span>'
            : d.complianceState === 'noncompliant'
            ? '<span class="badge-noncompliant">noncompliant</span>'
            : '<span class="badge-unk">' + _esc(d.complianceState||'—') + '</span>';
        var keyBtn = d.isEncrypted
            ? '<button class="btn btn-sm btn-outline-secondary" style="padding:4px 10px;font-size:11px;" data-id="' + _esc(d.id) + '" data-name="' + _esc(d.deviceName||'—') + '" onclick="showBitLockerKey(this)"><i class="bi bi-key me-1"></i>Ver clave</button>'
            : '<span style="font-size:11px;color:var(--text-muted);">—</span>';
        return '<tr>'
            + '<td style="text-align:left;"><strong style="font-family:monospace;font-size:12px;">' + _esc(d.deviceName||'—') + '</strong>'
            + '<div style="font-size:10px;color:var(--text-muted);">' + _esc((d.manufacturer||'')+' '+(d.model||'')) + '</div></td>'
            + '<td><div style="font-size:12px;">' + _esc(d.userDisplayName||'—') + '</div>'
            + '<div style="font-size:10px;color:var(--text-muted);">' + _esc(d.userPrincipalName||'') + '</div></td>'
            + '<td>' + enc + '</td>'
            + '<td>' + comp + '</td>'
            + '<td>' + keyBtn + '</td>'
            + '</tr>';
    }).join('');
}

function showBitLockerKey(btn) {
    var devId   = btn.dataset.id;
    var devName = btn.dataset.name;
    document.getElementById('blKeyDevName').textContent = devName;
    document.getElementById('blKeyContent').innerHTML = '<div class="text-center py-3"><span class="mini-spin"></span></div>';
    var modal = new bootstrap.Modal(document.getElementById('blKeyModal'));
    modal.show();
    fetch('/api/ms/devices/' + devId + '/bitlocker', { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(json) {
            var keys = json.data || [];
            if (!keys.length) {
                document.getElementById('blKeyContent').innerHTML =
                    '<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;">'
                    + '<i class="bi bi-info-circle" style="font-size:28px;display:block;margin-bottom:10px;"></i>'
                    + 'No se encontraron claves de recuperación BitLocker para este dispositivo.</div>';
                return;
            }
            document.getElementById('blKeyContent').innerHTML = keys.map(function(k) {
                var date = k.createdDateTime ? new Date(k.createdDateTime).toLocaleString('es-PE') : '—';
                return '<div style="background:var(--bg-header);border:1px solid var(--border-soft);border-radius:10px;padding:14px 16px;margin-bottom:8px;">'
                    + '<div style="font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);font-weight:700;margin-bottom:6px;"><i class="bi bi-key-fill me-1"></i>ID de clave de recuperación</div>'
                    + '<div style="font-family:monospace;font-size:12px;font-weight:600;word-break:break-all;color:var(--text-main);background:var(--bg-card);border:1px solid var(--border-soft);border-radius:6px;padding:10px 12px;">' + _esc(k.id) + '</div>'
                    + '<div style="font-size:11px;color:var(--text-muted);margin-top:8px;"><i class="bi bi-calendar3 me-1"></i>Registrada: ' + _esc(date) + '</div>'
                    + '</div>';
            }).join('');
        })
        .catch(function(){ document.getElementById('blKeyContent').innerHTML = '<div class="text-center py-3 text-danger">Error al obtener clave</div>'; });
}

// ── ACCESO REMOTO (MeshCentral RMM) ──────────────────────────────────────────
var _rmmAll = [];

function loadRMM(force) {
    var tbody  = document.getElementById('rmmTableBody');
    var badge  = document.getElementById('rmmStatusBadge');
    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-5"><span class="mini-spin"></span><p class="text-muted mt-2 mb-0" style="font-size:12px;">Consultando MeshCentral...</p></td></tr>';

    // Estado de conexión
    fetch('/api/rmm/status', { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(s){
            if (!s.configured) {
                badge.textContent = 'No configurado';
                badge.style.background = 'rgba(239,68,68,.1)';
                badge.style.color = '#ef4444';
                badge.style.borderColor = 'rgba(239,68,68,.25)';
            } else if (s.connected) {
                badge.textContent = 'Conectado';
                badge.style.background = 'rgba(16,185,129,.1)';
                badge.style.color = '#10b981';
                badge.style.borderColor = 'rgba(16,185,129,.25)';
            } else {
                badge.textContent = 'Conectando...';
                badge.style.background = 'rgba(245,158,11,.1)';
                badge.style.color = '#f59e0b';
                badge.style.borderColor = 'rgba(245,158,11,.25)';
            }
        }).catch(function(){});

    var url = '/api/rmm/devices' + (force ? '?refresh=1' : '');
    fetch(url, { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(json) {
            if (!json.ok) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-5 text-muted" style="font-size:13px;">'
                    + '<i class="bi bi-wifi-off" style="font-size:28px;display:block;margin-bottom:10px;"></i>'
                    + (json.error || 'MeshCentral no disponible') + '</td></tr>';
                return;
            }
            _rmmAll = json.devices || [];
            document.getElementById('rmmTotal').textContent = _rmmAll.length;
            renderRMMTable(_rmmAll);
        })
        .catch(function(e){
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-5 text-danger" style="font-size:13px;">'
                + '<i class="bi bi-exclamation-triangle" style="font-size:28px;display:block;margin-bottom:10px;"></i>'
                + 'Error al conectar con MeshCentral</td></tr>';
        });
}

function filterRMMList() {
    var q = (document.getElementById('rmmSearch').value || '').toLowerCase().trim();
    var filtered = q
        ? _rmmAll.filter(function(d){
            return (d.name||'').toLowerCase().includes(q)
                || (d.host||'').toLowerCase().includes(q)
                || (d.ip||'').toLowerCase().includes(q);
          })
        : _rmmAll;
    renderRMMTable(filtered);
}

function renderRMMTable(devices) {
    var tbody = document.getElementById('rmmTableBody');
    if (!devices.length) {
        tbody.innerHTML = '<tr><td colspan="9" class="text-center py-5 text-muted">No se encontraron dispositivos</td></tr>';
        return;
    }
    var osIcons = { 1: 'bi-windows', 2: 'bi-apple', 3: 'bi-ubuntu', 4: 'bi-android2' };
    tbody.innerHTML = devices.map(function(d){
        var osIcon  = osIcons[d.ostype] || 'bi-laptop';
        var online  = d.online;
        var dot     = online
            ? '<span style="display:inline-block;width:8px;height:8px;background:#10b981;border-radius:50%;margin-right:6px;box-shadow:0 0 6px #10b981;"></span>'
            : '<span style="display:inline-block;width:8px;height:8px;background:#94a3b8;border-radius:50%;margin-right:6px;"></span>';
        var statusTxt = online
            ? '<span style="color:#10b981;font-size:11px;font-weight:700;">En línea</span>'
            : '<span style="color:#94a3b8;font-size:11px;">Fuera de línea</span>';
        var lastStr = d.last ? new Date(d.last).toLocaleString('es-PE', { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' }) : '—';
        var safeId   = (d.nodeId   || '').replace(/\\/g,'\\\\').replace(/'/g,"\\'");
        var safeName = (d.name     || '').replace(/\\/g,'\\\\').replace(/'/g,"\\'");
        var safeIp   = (d.ip||d.host||'').replace(/\\/g,'\\\\').replace(/'/g,"\\'");
        var _c       = _rmmCache[d.nodeId] || {};
        var cpuShort = (_c.cpuName || d.cpu || '').replace(/\(R\)|\(TM\)|CPU|@.*/gi,'').trim() || '—';
        var ramGB    = _c.totalMemMB ? Math.round(_c.totalMemMB/1024) + ' GB'
                     : (d.ram ? (d.ram >= 1024 ? Math.round(d.ram/1024) + ' GB' : d.ram + ' MB') : '—');
        var lanIp    = _esc(_c._lanFirst || d.ip || d.host || '—');
        var pubIp    = (_c.publicIP || d.exip) ? _esc(_c.publicIP || d.exip) : '<span style="color:var(--text-muted);font-size:11px;">—</span>';
        var connectBtn = online
            ? '<button class="btn btn-sm btn-primary" style="padding:4px 10px;font-size:11px;" onclick="connectRMM(\'' + safeId + '\',\'' + safeName + '\',\'' + safeIp + '\')"><i class="bi bi-display me-1"></i>KVM</button>'
            : '';
        var safeExip = (d.exip||'').replace(/'/g,"\\'");
        var invBtn = '<button class="btn btn-sm btn-outline-secondary" style="padding:4px 10px;font-size:11px;" onclick="openRMMInventory(\'' + safeId + '\',\'' + safeName + '\',' + (online?1:0) + ',\'' + safeExip + '\')"><i class="bi bi-cpu me-1"></i>Info</button>';
        var toolsBtn = online
            ? '<button class="btn btn-sm btn-outline-info" style="padding:4px 8px;font-size:11px;" title="Herramientas" onclick="openRMMTools(\'' + safeId + '\',\'' + safeName + '\',\'proc\')"><i class="bi bi-tools"></i></button>'
            : '';
        var btn = '<div style="display:flex;gap:4px;flex-wrap:nowrap;align-items:center;">' + connectBtn + toolsBtn + invBtn + '</div>';
        return '<tr data-nid="' + _esc(d.nodeId||'') + '" oncontextmenu="showRMMCtx(event,\'' + safeId + '\',\'' + safeName + '\',' + (online?'true':'false') + ')" style="cursor:context-menu;">'
            + '<td style="text-align:left;"><div style="display:flex;align-items:center;gap:8px;">' + dot + '<div style="font-weight:700;font-size:13px;">' + _esc(d.name) + '</div></div></td>'
            + '<td><i class="bi ' + osIcon + ' me-1"></i><span style="font-size:11px;color:var(--text-muted);">' + _esc(d.os || '—') + '</span></td>'
            + '<td><span style="font-size:11px;color:var(--text-main);" title="' + _esc(d.cpu||'') + '">' + _esc(cpuShort) + '</span></td>'
            + '<td><span style="font-family:monospace;font-size:12px;font-weight:700;">' + ramGB + '</span></td>'
            + '<td><span style="font-family:monospace;font-size:11px;">' + lanIp + '</span></td>'
            + '<td><span style="font-family:monospace;font-size:11px;">' + pubIp + '</span></td>'
            + '<td>' + statusTxt + '</td>'
            + '<td style="font-size:12px;color:var(--text-muted);">' + lastStr + '</td>'
            + '<td>' + btn + '</td>'
            + '</tr>';
    }).join('');
}

function connectRMM(nodeId, name, ip) {
    // Abre popup semi-maximizado (85% de pantalla, centrado)
    var w = Math.round(screen.width  * 0.85);
    var h = Math.round(screen.height * 0.85);
    var x = Math.round((screen.width  - w) / 2);
    var y = Math.round((screen.height - h) / 2);
    var features = 'width=' + w + ',height=' + h + ',left=' + x + ',top=' + y
                 + ',resizable=yes,scrollbars=no,status=no,toolbar=no,menubar=no,location=no';

    var popup = window.open('about:blank', 'rmm_' + nodeId.slice(-8), features);
    if (!popup) { alert('Permite las ventanas emergentes para abrir el escritorio remoto.'); return; }

    // Página de carga mientras se obtiene la URL
    popup.document.write(
        '<!DOCTYPE html><html><head><meta charset="UTF-8">'
        + '<title>Conectando a ' + name + '...</title>'
        + '<style>body{margin:0;background:#0a0f1e;display:flex;align-items:center;justify-content:center;height:100vh;font-family:sans-serif;color:#94a3b8;flex-direction:column;gap:16px;}'
        + '.spin{width:40px;height:40px;border:3px solid #1e293b;border-top-color:#60a5fa;border-radius:50%;animation:s .7s linear infinite;}'
        + '@keyframes s{to{transform:rotate(360deg)}}</style></head>'
        + '<body><div class="spin"></div><div style="font-size:14px;">Estableciendo sesión remota con <strong style="color:#e2e8f0;">' + name + '</strong>...</div></body></html>'
    );
    popup.document.close();

    fetch('/api/rmm/session', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nodeId: nodeId })
    })
    .then(function(r){ return r.json(); })
    .then(function(json){
        if (!json.ok) throw new Error(json.error || 'Error al crear sesión');
        popup.location.href = json.url;
    })
    .catch(function(e){
        if (!popup.closed) {
            popup.document.body.innerHTML = '<div style="text-align:center;color:#f87171;font-family:sans-serif;padding:40px;">'
                + '<div style="font-size:32px;margin-bottom:12px;">⚠</div>'
                + '<div style="font-size:15px;font-weight:700;">Error al conectar</div>'
                + '<div style="font-size:12px;margin-top:8px;color:#94a3b8;">' + (e.message||'') + '</div>'
                + '<button onclick="window.close()" style="margin-top:20px;background:#334155;border:none;color:#e2e8f0;padding:10px 24px;border-radius:8px;cursor:pointer;font-size:13px;">Cerrar</button></div>';
        }
    });
}

function closeRMMModal() {
    var modal  = document.getElementById('rmmModal');
    var iframe = document.getElementById('rmmIframe');
    iframe.src = 'about:blank';
    modal.style.display = 'none';
    document.body.style.overflow = '';
}

// ── Inventario RMM ─────────────────────────────────────────────────────────
var _rmmCache    = {};   // nodeId → datos de PS_SYSTEM para enriquecer la tabla
var _invNodeId   = null;
var _invExip     = '';   // IP pública del nodo desde MeshCentral
var _invOnline   = false;
var _invUpdates  = [];
var _invApps     = [];
var _invLoaded   = { sys: false, upd: false, apps: false, run: false };
var _invFrontCache = {}; // nodeId → { apps: {data,ts}, upd: {data,ts} }
var _INV_CACHE_TTL = 5 * 60 * 1000; // 5 minutos en frontend

function openRMMInventory(nodeId, name, online, exip) {
    _invNodeId  = nodeId;
    _invExip    = exip || '';
    _invOnline  = !!online;
    _invLoaded  = { sys: false, upd: false, apps: false, run: false };
    _invUpdates = [];
    _invApps    = [];
    _invAppsCachedData = null;

    // Restaurar desde cache frontend si existe y no expiró
    var fc = _invFrontCache[nodeId];
    if (fc) {
        var now = Date.now();
        if (fc.apps && (now - fc.apps.ts) < _INV_CACHE_TTL) {
            _invApps = fc.apps.data.apps || [];
            _invLoaded.apps = true;
            _invAppsCachedData = fc.apps.data;
        }
        if (fc.upd && (now - fc.upd.ts) < _INV_CACHE_TTL) {
            _invUpdates = fc.upd.data.updates || [];
            _invLoaded.upd = true;
        }
    }

    document.getElementById('rmmInvName').textContent = name;
    var badge = document.getElementById('rmmInvStatusBadge');
    badge.textContent = online ? 'En línea' : 'Fuera de línea';
    badge.style.color = online ? '#10b981' : '#94a3b8';
    ['upd','apps'].forEach(function(t){ document.getElementById('invBadge-'+t).style.display='none'; });
    document.getElementById('rmmInventoryPanel').style.display = 'block';
    document.getElementById('rmmInventoryPanel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    switchInvTab('sys');
}

function closeRMMInventory() {
    document.getElementById('rmmInventoryPanel').style.display = 'none';
    _invNodeId = null;
}

function _patchRMMRow(nodeId) {
    var row = document.querySelector('#rmmTableBody tr[data-nid="' + (nodeId||'').replace(/"/g,'') + '"]');
    if (!row) return;
    var c = _rmmCache[nodeId]; if (!c) return;
    var cells = row.querySelectorAll('td');
    if (cells.length < 6) return;
    if (c.cpuName) cells[2].innerHTML = '<span style="font-size:11px;color:var(--text-main);" title="' + _esc(c.cpuName) + '">' + _esc(c.cpuName.replace(/\(R\)|\(TM\)|CPU|@.*/gi,'').trim()) + '</span>';
    if (c.totalMemMB) cells[3].innerHTML = '<span style="font-family:monospace;font-size:12px;font-weight:700;">' + Math.round(c.totalMemMB/1024) + ' GB</span>';
    if (c._lanFirst) cells[4].innerHTML = '<span style="font-family:monospace;font-size:11px;">' + _esc(c._lanFirst) + '</span>';
    if (c.publicIP) cells[5].innerHTML = '<span style="font-family:monospace;font-size:11px;">' + _esc(c.publicIP) + '</span>';
}

function switchInvTab(tab) {
    ['sys','upd','apps','run'].forEach(function(t) {
        document.getElementById('invTab-'+t).classList.toggle('active', t===tab);
        document.getElementById('invPanel-'+t).style.display = t===tab ? 'block' : 'none';
    });
    if (tab==='sys'  && !_invLoaded.sys)  loadInvSys();
    if (tab==='upd')  loadInvUpd();   // maneja cache internamente
    if (tab==='apps') loadInvApps();  // maneja cache internamente
    if (tab==='run'  && !_invLoaded.run)  initRunTab();
}

function _invOfflineMsg(el) {
    el.innerHTML = '<div style="text-align:center;padding:32px;color:var(--text-muted);">'
        + '<i class="bi bi-wifi-off" style="font-size:32px;display:block;margin-bottom:10px;"></i>'
        + 'El dispositivo está fuera de línea. Conéctalo al agente MeshCentral para ver el inventario.</div>';
}

function _invFetch(endpoint, cb, extraBody) {
    if (!_invNodeId) { cb(null, 'Sin dispositivo'); return; }
    if (!_invOnline) { cb(null, 'Dispositivo fuera de línea'); return; }
    var ctrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
    var timer = ctrl ? setTimeout(function(){ ctrl.abort(); }, 90000) : null;
    var body = Object.assign({ nodeId: _invNodeId }, extraBody || {});
    fetch('/api/rmm/' + endpoint, {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        signal: ctrl ? ctrl.signal : undefined
    })
    .then(function(r){ return r.json(); })
    .then(function(j){ clearTimeout(timer); cb(j, null); })
    .catch(function(e){ clearTimeout(timer); cb(null, e.message); });
}

function _cacheBadge(j, refreshFn) {
    if (!j || !j.cached || !j.cachedAt) return '';
    var t = new Date(j.cachedAt);
    var ts = t.toLocaleString('es-PE', { day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' });
    return '<div style="display:flex;align-items:center;gap:8px;padding:5px 14px;background:rgba(245,158,11,.07);border-bottom:1px solid rgba(245,158,11,.2);font-size:11px;color:#92400e;">'
        + '<i class="bi bi-clock-history" style="color:#d97706;"></i>'
        + '<span style="color:var(--text-muted);">Datos en caché del ' + ts + '</span>'
        + '<button onclick="' + refreshFn + '()" style="margin-left:auto;background:none;border:none;cursor:pointer;color:var(--primary);font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;display:flex;align-items:center;gap:3px;"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>'
        + '</div>';
}

function _invScriptUnavailable(el, tab) {
    el.innerHTML = '<div style="text-align:center;padding:40px 20px;">'
        + '<i class="bi bi-terminal-x" style="font-size:36px;color:var(--text-muted);display:block;margin-bottom:12px;"></i>'
        + '<div style="font-size:13px;font-weight:700;color:var(--text-main);margin-bottom:6px;">Scripts no disponibles en este dispositivo</div>'
        + '<div style="font-size:12px;color:var(--text-muted);max-width:340px;margin:0 auto 16px;">El agente no respondió al comando remoto. Puede deberse a políticas de ejecución, antivirus o una restricción del mesh.</div>'
        + '<button onclick="_retryInvTab(\'' + tab + '\')" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-clockwise me-1"></i>Reintentar</button>'
        + '</div>';
}

function _retryInvTab(tab) {
    _invLoaded[tab] = false;
    switchInvTab(tab);
}

function loadInvSys() {
    var el = document.getElementById('invContent-sys');
    if (!_invOnline) { _invOfflineMsg(el); _invLoaded.sys=true; return; }
    el.innerHTML = '<div class="text-center py-4"><span class="mini-spin"></span><p class="text-muted mt-2" style="font-size:12px;">Obteniendo información del sistema...</p></div>';
    _invFetch('device/system', function(j, err) {
        _invLoaded.sys = true;
        if (err || !j || !j.ok) {
            _invScriptUnavailable(el, 'sys'); return;
        }
        var d = j.data || {};

        // Guardar en cache y actualizar fila de la tabla con datos reales
        if (_invNodeId && d.cpuName) {
            var _lanFirst = '';
            try { var _ls = typeof d.lanIPs === 'string' ? JSON.parse(d.lanIPs) : d.lanIPs; if(_ls && _ls.length) _lanFirst = _ls[0].ip; } catch(e) {}
            _rmmCache[_invNodeId] = Object.assign({}, d, { _lanFirst: _lanFirst });
            _patchRMMRow(_invNodeId);
        }

        var totalGB  = d.totalMemMB ? (d.totalMemMB / 1024).toFixed(1) : null;
        var usedMB   = d.totalMemMB && d.freeMemMB ? (d.totalMemMB - d.freeMemMB) : null;
        var usedGB   = usedMB ? (usedMB / 1024).toFixed(1) : null;
        var memPct   = d.totalMemMB && usedMB ? Math.round(usedMB / d.totalMemMB * 100) : null;
        var cpuGHz   = d.cpuSpeedMHz ? (d.cpuSpeedMHz / 1000).toFixed(1) + ' GHz' : '';
        var cpuLabel = d.cpuName ? d.cpuName + (d.cpuCores ? ' · ' + d.cpuCores + ' núcleos' : '') + (cpuGHz ? ' · ' + cpuGHz : '') : '—';

        // LAN IPs
        var lanList = [];
        try {
            var _rawLan = d.lanIPs;
            if (Array.isArray(_rawLan)) lanList = _rawLan;
            else if (typeof _rawLan === 'string' && _rawLan) lanList = JSON.parse(_rawLan);
        } catch(e) {}
        var lanHtml = lanList.length
            ? lanList.map(function(l){ return '<span style="font-family:monospace;font-size:12px;background:var(--bg-header);border:1px solid var(--border-soft);border-radius:5px;padding:2px 8px;margin-right:4px;">' + _esc(l.ip) + '<span style="font-size:10px;color:var(--text-muted);margin-left:4px;">' + _esc(l['if']||'') + '</span></span>'; }).join('')
            : '<span style="color:var(--text-muted);font-size:12px;">—</span>';

        // OS build → versión amigable
        var osBuildNum = parseInt(d.osBuild || 0);
        var osVerName  = _osBuildToVersion(osBuildNum);
        var patchDays  = d.lastPatch ? Math.round((Date.now() - new Date(d.lastPatch).getTime()) / 86400000) : null;
        var patchColor = patchDays === null ? 'var(--text-muted)' : patchDays < 30 ? '#10b981' : patchDays < 90 ? '#f59e0b' : '#ef4444';
        var patchLabel = patchDays === null ? '—' : patchDays + ' días atrás';
        var patchStatus = patchDays === null ? '' : patchDays < 30 ? '✓ Al día' : patchDays < 90 ? '⚠ Revisar' : '✕ Desactualizado';

        el.innerHTML = '<div class="inv-sys-grid">'
            + _invCard('bi-clock-history',  'Último reinicio',  d.lastBoot || '—')
            + _invCard('bi-hourglass-split','Tiempo encendido', d.uptime   || '—')
            + _invCard('bi-pc-display',     'Nombre de equipo', d.computerName || '—')
            + '</div>'

            // CPU
            + '<div style="padding:8px 16px 0;">'
            + '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;display:flex;align-items:center;gap:6px;"><i class="bi bi-cpu"></i>PROCESADOR</div>'
            + '<div style="background:var(--bg-header);border:1px solid var(--border-soft);border-radius:10px;padding:12px 16px;display:flex;flex-wrap:wrap;gap:16px;">'
            + '<div><div style="font-size:10px;color:var(--text-muted);margin-bottom:3px;">Modelo</div><div style="font-size:13px;font-weight:700;">' + _esc(d.cpuName || '—') + '</div></div>'
            + (d.cpuCores ? '<div><div style="font-size:10px;color:var(--text-muted);margin-bottom:3px;">Núcleos / Hilos</div><div style="font-size:13px;font-weight:700;font-family:monospace;">' + d.cpuCores + ' / ' + (d.cpuThreads||'—') + '</div></div>' : '')
            + (d.cpuSpeedMHz ? '<div><div style="font-size:10px;color:var(--text-muted);margin-bottom:3px;">Frecuencia máx.</div><div style="font-size:13px;font-weight:700;font-family:monospace;">' + cpuGHz + '</div></div>' : '')
            + '</div></div>'

            // RAM
            + '<div style="padding:8px 16px 0;">'
            + '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;display:flex;align-items:center;gap:6px;"><i class="bi bi-memory"></i>MEMORIA RAM</div>'
            + '<div style="background:var(--bg-header);border:1px solid var(--border-soft);border-radius:10px;padding:12px 16px;">'
            + (totalGB
                ? (memPct !== null
                    ? ('<div style="display:flex;gap:24px;flex-wrap:wrap;margin-bottom:10px;">'
                        + '<div><div style="font-size:10px;color:var(--text-muted);margin-bottom:2px;">Total</div><div style="font-size:20px;font-weight:900;font-family:monospace;">' + totalGB + ' <span style="font-size:13px;font-weight:600;color:var(--text-muted);">GB</span></div></div>'
                        + '<div><div style="font-size:10px;color:var(--text-muted);margin-bottom:2px;">En uso</div><div style="font-size:20px;font-weight:900;font-family:monospace;">' + usedGB + ' <span style="font-size:13px;font-weight:600;color:var(--text-muted);">GB</span></div></div>'
                        + '<div><div style="font-size:10px;color:var(--text-muted);margin-bottom:2px;">Uso</div><div style="font-size:20px;font-weight:900;font-family:monospace;color:' + (memPct>90?'#ef4444':memPct>70?'#f59e0b':'#10b981') + ';">' + memPct + '<span style="font-size:13px;font-weight:600;"> %</span></div></div>'
                        + '</div>'
                        + '<div style="height:6px;background:var(--border-soft);border-radius:3px;overflow:hidden;"><div style="height:100%;width:' + Math.min(memPct,100) + '%;background:' + (memPct>90?'#ef4444':memPct>70?'#f59e0b':'#10b981') + ';border-radius:3px;transition:width .4s;"></div></div>')
                    : ('<div style="display:flex;align-items:baseline;gap:8px;">'
                        + '<div style="font-size:28px;font-weight:900;font-family:monospace;letter-spacing:-1px;">' + totalGB + '</div>'
                        + '<div style="font-size:14px;font-weight:700;color:var(--text-muted);">GB instalados</div>'
                        + '</div>'))
                : '<span style="color:var(--text-muted);font-size:12px;">—</span>')
            + '</div></div>'

            // Sistema Operativo (clickable para ver build)
            + '<div style="padding:8px 16px 0;">'
            + '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;display:flex;align-items:center;gap:6px;"><i class="bi bi-windows"></i>SISTEMA OPERATIVO</div>'
            + '<div style="background:var(--bg-header);border:1px solid var(--border-soft);border-radius:10px;padding:12px 16px;display:flex;flex-wrap:wrap;gap:20px;align-items:flex-start;">'
            + '<div><div style="font-size:10px;color:var(--text-muted);margin-bottom:3px;">Nombre</div><div style="font-size:13px;font-weight:700;">' + _esc(d.osName || '—') + '</div>' + (d.osBuild ? '<div style="font-size:11px;color:var(--text-muted);margin-top:3px;font-family:monospace;">Build ' + _esc(String(d.osBuild)) + (osVerName ? ' · ' + _esc(osVerName) : '') + '</div>' : '') + '</div>'
            + (d.lastPatch ? '<div><div style="font-size:10px;color:var(--text-muted);margin-bottom:3px;">Último parche</div><div style="font-size:13px;font-weight:700;color:' + patchColor + ';">' + _esc(d.lastPatch) + ' <span style="font-size:10px;">(' + patchLabel + ')</span></div><div style="font-size:10px;font-weight:700;color:' + patchColor + ';">' + patchStatus + '</div></div>' : '')
            + '</div></div>'

            // IPs
            + '<div style="padding:8px 16px 12px;">'
            + '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;display:flex;align-items:center;gap:6px;"><i class="bi bi-hdd-network"></i>RED</div>'
            + '<div style="background:var(--bg-header);border:1px solid var(--border-soft);border-radius:10px;padding:12px 16px;display:flex;flex-wrap:wrap;gap:20px;">'
            + '<div><div style="font-size:10px;color:var(--text-muted);margin-bottom:4px;">LAN (interna)</div><div>' + lanHtml + '</div></div>'
            + ((d.publicIP || _invExip) ? '<div><div style="font-size:10px;color:var(--text-muted);margin-bottom:4px;">IP Pública</div><div><span style="font-family:monospace;font-size:12px;background:rgba(59,130,246,.08);border:1px solid rgba(59,130,246,.2);border-radius:5px;padding:2px 10px;color:var(--primary);">' + _esc(d.publicIP || _invExip) + '</span></div></div>' : '')
            + '</div></div>'

            + '<div id="invDisk-container" style="padding:0 16px 0;"><p class="text-muted" style="font-size:11px;margin:0;"><span class="mini-spin" style="width:10px;height:10px;border-width:2px;"></span> Cargando almacenamiento...</p></div>'

            // Hardware seriales (lazy — carga al hacer clic para no bloquear la cola de scripts)
            + '<div id="invHardware-container" style="padding:8px 16px 8px;">'
            + '<button onclick="loadInvHardware()" style="background:none;border:1px solid var(--border-soft);border-radius:7px;cursor:pointer;color:var(--text-muted);font-size:11px;padding:5px 12px;display:inline-flex;align-items:center;gap:6px;"><i class="bi bi-upc-scan"></i> Ver números de serie de hardware</button>'
            + '</div>'
            // Monitores (lazy)
            + '<div id="invMonitors-container" style="padding:0 16px 16px;">'
            + '<button onclick="loadInvMonitors()" style="background:none;border:1px solid var(--border-soft);border-radius:7px;cursor:pointer;color:var(--text-muted);font-size:11px;padding:5px 12px;display:inline-flex;align-items:center;gap:6px;"><i class="bi bi-display"></i> Ver monitores conectados</button>'
            + '</div>';

        loadInvDisk();
    });
}

function loadInvDisk(refresh) {
    _invFetch('device/disk', function(j, err) {
        var el = document.getElementById('invDisk-container');
        if (!el) return;
        if (err || !j || !j.ok) {
            el.innerHTML = '<div style="padding:8px 16px 0;"><div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;display:flex;align-items:center;gap:6px;"><i class="bi bi-hdd"></i>ALMACENAMIENTO</div><div style="background:var(--bg-header);border:1px solid var(--border-soft);border-radius:10px;padding:12px 16px;display:flex;align-items:center;gap:10px;"><span style="font-size:12px;color:var(--text-muted);">No disponible</span><button onclick="loadInvDisk(true)" style="margin-left:auto;background:none;border:1px solid var(--border-soft);border-radius:6px;cursor:pointer;color:var(--primary);font-size:11px;font-weight:700;padding:3px 10px;">Reintentar</button></div></div>';
            return;
        }

        var disks    = j.disks    || [];
        var physical = j.physical || [];

        if (j.scriptUnavailable && !disks.length && !physical.length) {
            el.innerHTML = '<div style="padding:8px 16px 0;"><div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;display:flex;align-items:center;gap:6px;"><i class="bi bi-hdd"></i>ALMACENAMIENTO</div><div style="background:var(--bg-header);border:1px solid var(--border-soft);border-radius:10px;padding:12px 16px;display:flex;align-items:center;gap:10px;"><span style="font-size:12px;color:var(--text-muted);">Script no ejecutado en este dispositivo</span><button onclick="loadInvDisk(true)" style="margin-left:auto;background:none;border:1px solid var(--border-soft);border-radius:6px;cursor:pointer;color:var(--primary);font-size:11px;font-weight:700;padding:3px 10px;">Reintentar</button></div></div>';
            return;
        }

        if (!disks.length && !physical.length) {
            el.innerHTML = '<div style="padding:8px 16px 0;">'
                + '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;display:flex;align-items:center;gap:6px;"><i class="bi bi-hdd"></i>ALMACENAMIENTO</div>'
                + '<div style="background:var(--bg-header);border:1px solid var(--border-soft);border-radius:10px;padding:12px 16px;font-size:12px;color:var(--text-muted);">Sin datos de almacenamiento</div></div>';
            return;
        }

        var html = '<div style="padding:0 0 16px;">'
            + _cacheBadge(j, '_refreshInvDisk')
            + '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin:8px 0;display:flex;align-items:center;gap:6px;"><i class="bi bi-hdd"></i>ALMACENAMIENTO</div>'
            + '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;">';

        if (disks.length) {
            // Tiles con barra de uso real (RunCommand funcionó)
            html += disks.map(function(dk){
                var pct = dk.p || 0;
                var barColor = pct > 90 ? '#ef4444' : pct > 75 ? '#f59e0b' : '#10b981';
                return '<div style="background:var(--bg-header);border:1px solid var(--border-soft);border-radius:10px;padding:12px;">'
                    + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">'
                    + '<span style="font-size:15px;font-weight:800;font-family:monospace;color:var(--primary);">' + _esc(dk.d||'?') + '</span>'
                    + '<span style="font-size:12px;font-weight:700;color:' + (pct>90?'#ef4444':pct>75?'#f59e0b':'#10b981') + ';background:' + (pct>90?'rgba(239,68,68,.1)':pct>75?'rgba(245,158,11,.1)':'rgba(16,185,129,.1)') + ';border-radius:4px;padding:2px 7px;">' + pct + '%</span>'
                    + '</div>'
                    + '<div style="height:5px;background:var(--border-soft);border-radius:3px;overflow:hidden;margin-bottom:8px;"><div style="height:100%;width:' + Math.min(pct,100) + '%;background:' + barColor + ';border-radius:3px;"></div></div>'
                    + '<div style="font-size:11px;color:var(--text-muted);">'
                    + '<span style="font-size:14px;font-weight:700;color:var(--text-main);font-family:monospace;">' + (dk.f||0) + '</span> GB libres'
                    + '<span style="margin:0 4px;color:var(--border-soft);">·</span>'
                    + (dk.t||0) + ' GB total'
                    + '</div>'
                    + '</div>';
            }).join('');
        } else {
            // Tiles físicos desde deviceInfo (sin barra de uso)
            html += physical.map(function(ph){
                var shortModel = ph.model.length > 28 ? ph.model.slice(0,26) + '…' : ph.model;
                return '<div style="background:var(--bg-header);border:1px solid var(--border-soft);border-radius:10px;padding:14px;">'
                    + '<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">'
                    + '<i class="bi bi-device-hdd" style="font-size:16px;color:var(--primary);"></i>'
                    + '<span style="font-size:11px;font-weight:700;color:var(--text-main);line-height:1.3;" title="' + _esc(ph.model) + '">' + _esc(shortModel) + '</span>'
                    + '</div>'
                    + '<div style="display:flex;align-items:baseline;gap:5px;">'
                    + '<span style="font-size:22px;font-weight:900;font-family:monospace;letter-spacing:-1px;">' + ph.capGB + '</span>'
                    + '<span style="font-size:13px;font-weight:600;color:var(--text-muted);">GB</span>'
                    + '</div>'
                    + '</div>';
            }).join('');
        }

        html += '</div></div>';
        el.innerHTML = html;
    }, refresh ? { refresh: true } : undefined);
}
function _refreshInvDisk() { loadInvDisk(true); }

function _invCard(icon, label, val) {
    return '<div class="inv-sys-card">'
        + '<div class="label"><i class="bi ' + icon + ' me-1"></i>' + label + '</div>'
        + '<div class="val">' + _esc(String(val)) + '</div>'
        + '</div>';
}

// Convierte build number → versión amigable de Windows
function _osBuildToVersion(build) {
    var w11 = { 22000:'21H2', 22621:'22H2', 22631:'23H2', 26100:'24H2' };
    var w10 = { 19041:'2004', 19042:'20H2', 19043:'21H1', 19044:'21H2', 19045:'22H2' };
    if (build >= 22000) return 'Windows 11 ' + (w11[build] || ('Build '+build));
    if (build >= 10000) return 'Windows 10 ' + (w10[build] || ('Build '+build));
    if (build) return 'Build ' + build;
    return '';
}

// Modal detalle de OS (build, parche)
function _showOSDetail(d) {
    var build    = parseInt(d.osBuild || 0);
    var verName  = _osBuildToVersion(build);
    var patchDays = d.lastPatch ? Math.round((Date.now() - new Date(d.lastPatch).getTime()) / 86400000) : null;
    var statusClr = patchDays === null ? 'var(--text-muted)' : patchDays < 30 ? '#10b981' : patchDays < 90 ? '#f59e0b' : '#ef4444';
    var statusTxt = patchDays === null ? 'Sin información' : patchDays < 30 ? 'Al día' : patchDays < 90 ? 'Revisar' : 'Desactualizado';
    var html = '<div style="position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;" id="_osDetailOverlay" onclick="if(event.target===this)this.remove();">'
        + '<div style="background:var(--bg-card,#1e293b);border:1px solid var(--border-soft,#2d3f55);border-radius:16px;width:440px;max-width:95vw;padding:24px;box-shadow:0 20px 60px rgba(0,0,0,.4);">'
        + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;">'
        + '<div style="font-size:16px;font-weight:800;display:flex;align-items:center;gap:8px;"><i class="bi bi-windows" style="color:var(--primary,#3b82f6);"></i>Detalle del sistema operativo</div>'
        + '<button onclick="document.getElementById(\'_osDetailOverlay\').remove()" style="background:none;border:none;font-size:20px;color:var(--text-muted,#64748b);cursor:pointer;padding:0 4px;line-height:1;">&times;</button>'
        + '</div>'
        + '<table style="width:100%;border-collapse:collapse;font-size:13px;">'
        + _osRow('Nombre completo',   d.osName || '—')
        + _osRow('Versión / Edición', verName  || '—')
        + _osRow('Número de build',   d.osBuild ? String(d.osBuild) : '—')
        + _osRow('Versión kernel',     d.osVersion || '—')
        + _osRow('Último parche',      d.lastPatch  || '—')
        + (d.lastPatchKB ? _osRow('KB instalado', d.lastPatchKB) : '')
        + '<tr><td style="padding:10px 0;color:var(--text-muted,#64748b);font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;border-top:1px solid var(--border-soft,#2d3f55);">Estado de actualización</td>'
        + '<td style="padding:10px 0;border-top:1px solid var(--border-soft,#2d3f55);"><span style="font-weight:700;color:' + statusClr + ';font-size:13px;">' + statusTxt + '</span>'
        + (patchDays !== null ? ' <span style="font-size:11px;color:var(--text-muted,#64748b);">(' + patchDays + ' días desde último parche)</span>' : '')
        + '</td></tr>'
        + '</table>'
        + '</div></div>';
    document.body.insertAdjacentHTML('beforeend', html);
}
function _osRow(label, val) {
    return '<tr><td style="padding:8px 0;color:var(--text-muted,#64748b);font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;border-top:1px solid var(--border-soft,#2d3f55);width:45%;">' + label + '</td>'
        + '<td style="padding:8px 0;font-weight:600;font-family:monospace;font-size:12px;border-top:1px solid var(--border-soft,#2d3f55);">' + _esc(String(val)) + '</td></tr>';
}

// Carga números de serie de componentes
function loadInvHardware() {
    var el = document.getElementById('invHardware-container');
    if (!el) return;
    if (!_invOnline) { el.innerHTML = ''; return; }
    el.innerHTML = '<p class="text-muted" style="font-size:11px;margin:0;"><span class="mini-spin" style="width:10px;height:10px;border-width:2px;"></span> Cargando datos de hardware...</p>';
    _invFetch('device/hardware', function(j, err) {
        if (!el) return;
        if (err || !j || !j.ok) {
            el.innerHTML = '<p style="font-size:11px;color:var(--text-muted);padding:8px 0;margin:0;"><i class="bi bi-exclamation-circle me-1"></i>' + _esc(err || (j&&j.error) || 'Error obteniendo hardware') + '</p>';
            return;
        }
        var h = j.data || {};
        var rows = [];

        // Parsear formato deviceinfo de MeshCentral
        var _sys = h['System']      || {};
        var _mb  = h['Motherboard'] || {};
        var _bio = h['BIOS']        || {};
        var _mem = h['Memory']      || {};
        var _sto = h['Storage']     || {};

        // Sistema (serial del equipo completo)
        var _sysSerial = _sys['Serial'] || _bio['Serial'] || '';
        var _sysMfr    = _sys['Manufacturer'] || '';
        var _sysProd   = _sys['Product Name'] || '';
        if (_sysMfr || _sysProd) rows.push(['Sistema', (_sysMfr + ' ' + _sysProd).trim(), _sysSerial || '—', '—']);

        // Placa madre
        var _mbName   = _mb['Name'] || '';
        var _mbSerial = _mb['Serial'] || '';
        var _mbVendor = _mb['Vendor'] || '';
        if (_mbName || _mbSerial) rows.push(['Placa madre', (_mbVendor + ' ' + _mbName).trim(), _mbSerial || '—', '—']);

        // CPU (desde Motherboard)
        if (_mb['CPU']) rows.push(['Procesador', _mb['CPU'], '—', _mbVendor || '—']);

        // GPU
        Object.keys(_mb).filter(function(k){ return k.startsWith('GPU'); }).forEach(function(k){
            rows.push(['GPU', _mb[k], '—', '—']);
        });

        // RAM por banco
        Object.keys(_mem).forEach(function(slot){
            var m = _mem[slot] || {};
            var cs = (m['Capacity/Speed'] || '').replace('Mb','MB');
            var pn = (m['Part Number']    || '').trim();
            if (cs) rows.push(['RAM · ' + slot, cs + (pn ? ' · ' + pn : ''), '—', '—']);
        });

        // Almacenamiento
        Object.keys(_sto).forEach(function(model){
            var s = _sto[model] || {};
            var capMb = parseInt(s['Capacity'] || '0');
            var capStr = capMb ? Math.round(capMb / 1024) + ' GB' : '?';
            rows.push(['Disco', model + ' · ' + capStr, '—', '—']);
        });

        if (!rows.length) {
            el.innerHTML = '<p style="font-size:11px;color:var(--text-muted);padding:8px 0;margin:0;"><i class="bi bi-info-circle me-1"></i>No se obtuvieron datos de hardware del dispositivo.</p>';
            return;
        }

        el.innerHTML = '<div style="margin-top:4px;">'
            + '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;display:flex;align-items:center;gap:6px;"><i class="bi bi-upc-scan"></i>NÚMEROS DE SERIE DE COMPONENTES</div>'
            + '<div style="overflow-x:auto;border:1px solid var(--border-soft);border-radius:10px;">'
            + '<table style="width:100%;border-collapse:collapse;font-size:12px;">'
            + '<thead><tr>'
            + '<th style="padding:8px 14px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);background:var(--bg-header);border-bottom:1px solid var(--border-soft);white-space:nowrap;">Componente</th>'
            + '<th style="padding:8px 14px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);background:var(--bg-header);border-bottom:1px solid var(--border-soft);">Modelo / Descripción</th>'
            + '<th style="padding:8px 14px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);background:var(--bg-header);border-bottom:1px solid var(--border-soft);white-space:nowrap;">Número de serie</th>'
            + '<th style="padding:8px 14px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);background:var(--bg-header);border-bottom:1px solid var(--border-soft);">Fabricante</th>'
            + '</tr></thead><tbody>'
            + rows.map(function(r, i){
                return '<tr style="border-bottom:1px solid var(--border-soft);">'
                    + '<td style="padding:9px 14px;font-weight:700;color:var(--primary);white-space:nowrap;">' + _esc(r[0]) + '</td>'
                    + '<td style="padding:9px 14px;color:var(--text-main);">' + _esc(r[1]) + '</td>'
                    + '<td style="padding:9px 14px;font-family:monospace;font-size:11px;font-weight:700;color:var(--text-main);">' + _esc(r[2]) + '</td>'
                    + '<td style="padding:9px 14px;font-size:11px;color:var(--text-muted);">' + _esc(r[3]) + '</td>'
                    + '</tr>';
            }).join('')
            + '</tbody></table></div></div>';
    });
}

