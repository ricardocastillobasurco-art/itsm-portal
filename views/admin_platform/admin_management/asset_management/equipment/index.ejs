                : '';
            content.innerHTML = '<div class="text-center text-muted py-5" style="font-size:12px;"><i class="bi bi-camera-video" style="font-size:28px;display:block;margin-bottom:8px;opacity:.3;"></i>Sin grabaciones disponibles para este dispositivo.'+meshLink+'</div>';
