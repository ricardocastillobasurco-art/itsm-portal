    }).join('');
    var thS = 'padding:8px 14px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);background:var(--bg-header);border-bottom:1px solid var(--border-soft);';
    el.innerHTML = _cacheBadge(j || _invUpdCachedData, '_refreshInvUpd')
        + '<table style="width:100%;border-collapse:collapse;font-size:12px;">'
        + '<thead><tr><th style="' + thS + 'width:110px;">KB</th><th style="' + thS + '">Categoría / Descripción</th><th style="' + thS + 'width:100px;">Fecha</th></tr></thead>'
