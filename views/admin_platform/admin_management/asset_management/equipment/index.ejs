// dismiss modals on overlay click
['rmmToolsOverlay','rmmPowerOverlay','rmmToastOverlay','rmmChatOverlay','rmmCatalogOverlay'].forEach(function(id){
    var el=document.getElementById(id);
    if(el)el.addEventListener('click',function(e){if(e.target===el)el.classList.remove('show');});
// terminal no cierra al hacer click en el fondo (el iframe consume el click)
