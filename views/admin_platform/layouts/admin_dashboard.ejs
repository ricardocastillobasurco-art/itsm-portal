<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<script>(function(){const t=localStorage.getItem('dashboardTheme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard · IT Platform</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;0,9..40,900&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<style>
/* ══ VARIABLES ══════════════════════════════════════════════ */
:root,[data-theme="light"]{
  --bg:#f1f5f9;--bg-subtle:#e9eef5;--card:#ffffff;
  --border:#e2e8f0;--border-strong:#cbd5e1;
  --text:#0f172a;--text-2:#1e293b;--muted:#64748b;--muted-2:#94a3b8;
  --primary:#2563eb;--primary-dim:rgba(37,99,235,.1);--primary-glow:rgba(37,99,235,.25);
  --success:#059669;--warning:#d97706;--danger:#dc2626;--purple:#7c3aed;--info:#0891b2;
  --sh-xs:0 1px 2px rgba(0,0,0,.06);
  --sh-sm:0 1px 3px rgba(0,0,0,.08),0 4px 12px rgba(0,0,0,.04);
  --sh-md:0 4px 16px rgba(0,0,0,.1),0 16px 40px rgba(0,0,0,.07);
  --nav-bg:rgba(255,255,255,.95);
  --radius-sm:8px;--radius:12px;--radius-lg:16px;
  --sidebar-w:224px;--navbar-h:44px;
  --sidebar-bg:var(--card);
}
[data-theme="dark"]{
  --bg:#080d1c;--bg-subtle:#0d1425;--card:#111827;
  --border:#1e293b;--border-strong:#2d3f55;
  --text:#f1f5f9;--text-2:#e2e8f0;--muted:#94a3b8;--muted-2:#64748b;
  --primary:#3b82f6;--primary-dim:rgba(59,130,246,.14);--primary-glow:rgba(59,130,246,.2);
  --success:#10b981;--warning:#f59e0b;--danger:#ef4444;--purple:#8b5cf6;--info:#06b6d4;
  --sh-xs:0 1px 2px rgba(0,0,0,.4);
  --sh-sm:0 1px 3px rgba(0,0,0,.4),0 4px 12px rgba(0,0,0,.3);
  --sh-md:0 4px 16px rgba(0,0,0,.4),0 16px 40px rgba(0,0,0,.3);
  --nav-bg:rgba(8,13,28,.95);
  --sidebar-bg:var(--bg-subtle);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;overflow:hidden;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',-apple-system,'Segoe UI',sans-serif;font-size:14px;line-height:1.6;-webkit-font-smoothing:antialiased;}
a{text-decoration:none;color:inherit;}
button{font-family:inherit;cursor:pointer;border:none;background:none;}
*::-webkit-scrollbar{width:5px;height:5px;}
*::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:3px;}

/* ══ NAVBAR ═════════════════════════════════════════════════ */
.navbar{position:fixed;top:0;left:0;right:0;z-index:500;height:var(--navbar-h);display:flex;align-items:center;gap:6px;padding:0 16px;background:var(--nav-bg);backdrop-filter:blur(16px) saturate(160%);-webkit-backdrop-filter:blur(16px) saturate(160%);border-bottom:1px solid var(--border);}
.nav-hamburger{width:30px;height:30px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--muted);transition:all .15s;cursor:pointer;flex-shrink:0;}
.nav-hamburger:hover{background:var(--bg-subtle);color:var(--text);}
.nav-brand{display:flex;align-items:center;gap:7px;padding:0 8px;}
.nav-logo{height:18px;width:auto;}
.nav-divider{width:1px;height:16px;background:var(--border);}
.nav-name{font-size:12px;font-weight:700;color:var(--text);}
.nav-badge{font-size:8px;font-weight:800;padding:1px 6px;border-radius:20px;background:linear-gradient(135deg,#7c3aed,#e11d48);color:#fff;letter-spacing:.5px;text-transform:uppercase;}
.nav-space{flex:1;}
.nav-icon-btn{width:30px;height:30px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--muted);transition:all .15s;}
.nav-icon-btn:hover{background:var(--bg-subtle);color:var(--text);}
.nav-user{display:flex;align-items:center;gap:5px;padding:3px 8px 3px 4px;border-radius:20px;background:var(--bg-subtle);border:1px solid var(--border);}
.nav-avatar{width:24px;height:24px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,#7c3aed,#e11d48);display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:800;}
.nav-username{font-size:11px;font-weight:600;color:var(--text-2);max-width:90px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.nav-exit{display:flex;align-items:center;gap:4px;padding:5px 10px;border-radius:5px;font-size:11px;font-weight:600;color:var(--muted);transition:all .15s;cursor:pointer;}
.nav-exit:hover{color:var(--danger);background:rgba(220,38,38,.06);}

/* ══ APP SHELL ══════════════════════════════════════════════ */
.app-shell{display:flex;position:fixed;top:var(--navbar-h);left:0;right:0;bottom:0;overflow:hidden;}

/* ══ SIDEBAR ════════════════════════════════════════════════ */
.sidebar{width:var(--sidebar-w);flex-shrink:0;background:var(--card);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;transition:width .22s cubic-bezier(.4,0,.2,1);position:relative;z-index:200;}
.sidebar.collapsed{width:52px;}
.sb-header{display:flex;align-items:center;gap:8px;padding:0 12px;height:46px;border-bottom:1px solid var(--border);flex-shrink:0;overflow:hidden;}
.sb-logo{height:16px;width:auto;flex-shrink:0;}
.sb-brand{flex:1;min-width:0;overflow:hidden;}
.sb-brand-name{font-size:12px;font-weight:700;color:var(--text);white-space:nowrap;}
.sb-brand-badge{display:inline-block;font-size:8px;font-weight:800;padding:1px 6px;border-radius:4px;background:linear-gradient(135deg,#7c3aed,#e11d48);color:#fff;text-transform:uppercase;letter-spacing:.4px;margin-top:1px;}
.sidebar.collapsed .sb-brand{display:none;}
.sb-nav{flex:1;overflow-y:auto;overflow-x:hidden;padding:6px 0;}
.sb-nav::-webkit-scrollbar{width:3px;}
.sb-section{margin-bottom:2px;}
.sb-section-label{font-size:9px;font-weight:800;letter-spacing:1.1px;text-transform:uppercase;color:var(--muted-2);padding:10px 14px 3px;white-space:nowrap;overflow:hidden;display:block;}
.sidebar.collapsed .sb-section-label{display:none;}
.sb-item{display:flex;align-items:center;gap:10px;padding:7px 14px;cursor:pointer;font-size:12.5px;font-weight:500;color:var(--muted);transition:all .15s;white-space:nowrap;overflow:hidden;border:none;background:none;width:100%;text-align:left;position:relative;}
.sb-item:hover{background:var(--bg-subtle);color:var(--text);}
.sb-item.active{background:var(--primary-dim);color:var(--primary);font-weight:700;}
.sb-item.active::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--primary);border-radius:0 2px 2px 0;}
.sb-icon{font-size:15px;flex-shrink:0;width:18px;text-align:center;}
.sb-label{flex:1;overflow:hidden;text-overflow:ellipsis;}
.sidebar.collapsed .sb-item{justify-content:center;padding:9px 0;}
.sidebar.collapsed .sb-label{display:none;}
.sidebar.collapsed .sb-icon{font-size:17px;width:auto;}
.sb-divider{height:1px;background:var(--border);margin:6px 14px;}
.sidebar.collapsed .sb-divider{margin:6px 8px;}
.sb-sub-menu{overflow:hidden;max-height:0;transition:max-height .25s cubic-bezier(.4,0,.2,1);}
.sb-sub-menu.open{max-height:600px;}
.sidebar.collapsed .sb-sub-menu{display:none;}
.sidebar.collapsed .sb-expand-icon{display:none;}
.sb-sub-item{display:flex;align-items:center;gap:8px;padding:6px 14px 6px 38px;font-size:12px;font-weight:500;color:var(--muted);cursor:pointer;border:none;background:none;width:100%;text-align:left;transition:all .14s;white-space:nowrap;overflow:hidden;}
.sb-sub-item:hover{background:var(--bg-subtle);color:var(--text);}
.sb-sub-item.active{color:var(--primary);font-weight:700;background:var(--primary-dim);}
.sb-sub-icon{font-size:13px;flex-shrink:0;width:16px;text-align:center;}
.sb-expand-icon{margin-left:auto;font-size:10px;transition:transform .22s;flex-shrink:0;color:var(--muted-2);}
.sb-item.sb-expanded .sb-expand-icon{transform:rotate(180deg);}
.sb-footer{border-top:1px solid var(--border);padding:10px 12px;flex-shrink:0;display:flex;align-items:center;gap:8px;overflow:hidden;}
.sb-user-av{width:28px;height:28px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,#7c3aed,#e11d48);display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:800;}
.sb-user-info{flex:1;min-width:0;overflow:hidden;}
.sb-user-name{font-size:11px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.sb-user-role{font-size:10px;color:var(--muted);}
.sidebar.collapsed .sb-user-info{display:none;}
.sidebar.collapsed .sb-footer{justify-content:center;padding:10px 0;}
.sb-theme-btn{width:26px;height:26px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--muted);transition:all .15s;flex-shrink:0;}
.sb-theme-btn:hover{background:var(--bg-subtle);color:var(--text);}
.sidebar.collapsed .sb-theme-btn{display:none;}
.sb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:299;backdrop-filter:blur(2px);}
@media(max-width:768px){
  .sidebar{position:fixed;top:var(--navbar-h);bottom:0;left:0;z-index:300;transform:translateX(-100%);transition:transform .25s cubic-bezier(.4,0,.2,1);}
  .sidebar.mobile-open{transform:translateX(0);}
  .sb-overlay.visible{display:block;}
}

/* ══ CONTENT AREA ═══════════════════════════════════════════ */
.content-area{flex:1;overflow-y:auto;overflow-x:hidden;display:flex;flex-direction:column;background:var(--bg);min-width:0;}
.content-header{background:var(--card);border-bottom:1px solid var(--border);padding:12px 24px;display:flex;align-items:center;gap:14px;flex-shrink:0;position:sticky;top:0;z-index:100;}
.ch-info{display:flex;flex-direction:column;gap:1px;}
.ch-title{font-size:14px;font-weight:800;color:var(--text);}
.ch-sub{font-size:11px;color:var(--muted);}
.ch-actions{display:flex;align-items:center;gap:8px;margin-left:auto;}
.content-body{padding:24px;flex:1;}

/* ══ DASHBOARD CONTENT ══════════════════════════════════════ */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;margin-bottom:24px;}
.kpi-card{background:var(--card);border-radius:var(--radius-lg);padding:20px;border:1px solid var(--border);box-shadow:var(--sh-xs);position:relative;overflow:hidden;transition:transform .15s,box-shadow .15s;}
.kpi-card:hover{transform:translateY(-2px);box-shadow:var(--sh-sm);}
.kpi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;}
.kpi-blue::before{background:var(--primary);}
.kpi-green::before{background:var(--success);}
.kpi-yellow::before{background:var(--warning);}
.kpi-red::before{background:var(--danger);}
.kpi-purple::before{background:var(--purple);}
.kpi-cyan::before{background:var(--info);}
.kpi-label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);margin-bottom:8px;}
.kpi-val{font-size:30px;font-weight:800;line-height:1;margin-bottom:4px;font-variant-numeric:tabular-nums;}
.kpi-sub{font-size:11px;color:var(--muted);}
.kpi-icon{position:absolute;right:16px;top:50%;transform:translateY(-50%);font-size:34px;opacity:.07;}

.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}
.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:16px;}
.grid-main-side{display:grid;grid-template-columns:2fr 1fr;gap:16px;margin-bottom:16px;}
@media(max-width:1100px){.grid-2,.grid-3,.grid-main-side{grid-template-columns:1fr;}}

.card{background:var(--card);border-radius:var(--radius-lg);padding:20px;border:1px solid var(--border);box-shadow:var(--sh-xs);}
.card-title{font-size:13px;font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:8px;color:var(--text);}
.card-title i{font-size:15px;opacity:.7;}

.data-table{width:100%;border-collapse:collapse;font-size:13px;}
.data-table th{background:var(--bg-subtle);padding:9px 12px;text-align:left;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);border-bottom:1px solid var(--border);}
.data-table td{padding:9px 12px;border-bottom:1px solid var(--border);vertical-align:middle;}
.data-table tbody tr:hover{background:var(--bg-subtle);}
.data-table tbody tr:last-child td{border-bottom:none;}
.tbl-wrap{overflow-x:auto;border-radius:10px;border:1px solid var(--border);}

.badge-pill{display:inline-flex;align-items:center;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;gap:4px;}
.bp-blue{background:#dbeafe;color:#1d4ed8;}
.bp-green{background:#d1fae5;color:#065f46;}
.bp-yellow{background:#fef3c7;color:#92400e;}
.bp-red{background:#fee2e2;color:#991b1b;}
.bp-purple{background:#ede9fe;color:#5b21b6;}
.bp-gray{background:#f1f5f9;color:#475569;}
[data-theme="dark"] .bp-blue{background:#1e3a5f;color:#93c5fd;}
[data-theme="dark"] .bp-green{background:#064e3b;color:#6ee7b7;}
[data-theme="dark"] .bp-yellow{background:#451a03;color:#fcd34d;}
[data-theme="dark"] .bp-red{background:#450a0a;color:#fca5a5;}
[data-theme="dark"] .bp-purple{background:#2e1065;color:#c4b5fd;}
[data-theme="dark"] .bp-gray{background:#1e293b;color:#94a3b8;}

.progress-bar-wrap{background:var(--border);border-radius:999px;height:8px;overflow:hidden;flex:1;}
.progress-bar-fill{height:100%;border-radius:999px;transition:width .4s ease;}
.progress-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.progress-label{font-size:12px;min-width:120px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.progress-val{font-size:12px;font-weight:700;min-width:36px;text-align:right;font-variant-numeric:tabular-nums;}

.agent-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);}
.agent-row:last-child{border-bottom:none;}
.agent-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#fff;flex-shrink:0;}
.agent-name{font-size:13px;font-weight:600;}
.agent-meta{font-size:11px;color:var(--muted);}
.agent-stats{margin-left:auto;display:flex;gap:8px;align-items:center;}
.stat-chip{background:var(--bg-subtle);border:1px solid var(--border);border-radius:8px;padding:4px 8px;font-size:11px;font-weight:700;text-align:center;min-width:36px;}
.stat-chip.danger{background:#fee2e2;color:#991b1b;border-color:#fca5a5;}
.stat-chip.warn{background:#fef3c7;color:#92400e;border-color:#fcd34d;}
[data-theme="dark"] .stat-chip.danger{background:#450a0a;color:#fca5a5;border-color:#7f1d1d;}
[data-theme="dark"] .stat-chip.warn{background:#451a03;color:#fcd34d;border-color:#78350f;}

.chart-wrap{position:relative;width:100%;}
.chart-wrap canvas{max-height:250px;}

.refresh-btn{background:var(--primary);color:#fff;border:none;border-radius:var(--radius-sm);padding:7px 14px;font-size:12px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px;transition:opacity .15s;}
.refresh-btn:hover{opacity:.85;}
.refresh-btn.spinning i{animation:spin .7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}

.live-dot{width:7px;height:7px;border-radius:50%;background:var(--success);display:inline-block;margin-right:5px;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

.toast-container{position:fixed;top:60px;right:20px;z-index:9999;display:flex;flex-direction:column;gap:8px;pointer-events:none;}
.toast{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:14px 18px;box-shadow:var(--sh-md);max-width:320px;pointer-events:all;animation:toastIn .3s ease;font-size:13px;}
@keyframes toastIn{from{opacity:0;transform:translateX(40px)}to{opacity:1;transform:none}}
.toast-title{font-weight:700;margin-bottom:4px;}
.toast-body{color:var(--muted);}
</style>
</head>
<body>
<%
  const _name   = user ? (user.full_name || user.name || user.email || 'Admin') : 'Administrador';
  const _parts  = _name.trim().split(/\s+/);
  const _ini    = (_parts[0]?.[0]||'A').toUpperCase() + (_parts[1]?.[0]||'').toUpperCase();
  const _first  = (_parts[0]||'Admin');
  const _role   = user ? (user.role || 'admin') : 'admin';
  const _cfg    = (typeof tenantCfg !== 'undefined' && tenantCfg) ? tenantCfg : {};
  const _tenantName = _cfg.name ?? 'Portal TI';
%>

<!-- ══ NAVBAR ══════════════════════════════════════════════ -->
<nav class="navbar">
  <button class="nav-hamburger" onclick="toggleSidebar()" title="Menú">
    <i class="bi bi-layout-sidebar"></i>
  </button>
  <div class="nav-brand">
    <img src="/images/movistar-logo.png" alt="Logo" class="nav-logo" onerror="this.style.display='none'">
    <span class="nav-divider"></span>
    <span class="nav-name"><%= _tenantName %></span>
    <span class="nav-badge">ADMIN</span>
  </div>
  <div class="nav-space"></div>
  <button class="nav-icon-btn" onclick="toggleTheme()" title="Cambiar tema"><i class="bi bi-moon-stars-fill" id="navThemeIcon"></i></button>
  <div class="nav-user">
    <div class="nav-avatar"><%= _ini %></div>
    <span class="nav-username"><%= _first %></span>
  </div>
  <button class="nav-exit" onclick="location.href='/api/auth/logout'"><i class="bi bi-box-arrow-right"></i><span>Salir</span></button>
</nav>

<!-- ══ APP SHELL ════════════════════════════════════════════ -->
<div class="app-shell">

  <!-- SIDEBAR -->
  <div class="sidebar" id="sidebar">
    <nav class="sb-nav" id="sbNav" style="padding-top:10px;">

      <a class="sb-item" href="/administracion">
        <i class="bi bi-grid-1x2-fill sb-icon" style="color:#2563eb;"></i>
        <span class="sb-label">Inicio</span>
      </a>
      <a class="sb-item active" href="/admin-dashboard">
        <i class="bi bi-bar-chart-line-fill sb-icon" style="color:#059669;"></i>
        <span class="sb-label">Dashboard</span>
      </a>

      <!-- ITSM -->
      <div class="sb-section">
        <span class="sb-section-label">ITSM</span>
        <button class="sb-item" onclick="sbToggle('subItsm', this)">
          <i class="bi bi-headset sb-icon" style="color:#0891b2;"></i>
          <span class="sb-label">ITSM</span>
          <i class="bi bi-chevron-down sb-expand-icon"></i>
        </button>
        <div class="sb-sub-menu" id="subItsm">
          <a class="sb-sub-item" href="/itsm/incidencias/gestion"><i class="bi bi-exclamation-triangle-fill sb-sub-icon" style="color:#dc2626;"></i>Incidencias</a>
          <a class="sb-sub-item" href="/itsm/requerimientos/gestion"><i class="bi bi-clipboard2-check-fill sb-sub-icon" style="color:#7c3aed;"></i>Requerimientos</a>
          <a class="sb-sub-item" href="/cambios"><i class="bi bi-arrow-repeat sb-sub-icon" style="color:#0891b2;"></i>Cambios</a>
          <a class="sb-sub-item" href="/problemas"><i class="bi bi-bug-fill sb-sub-icon" style="color:#d97706;"></i>Problemas</a>
          <a class="sb-sub-item" href="/catalogo"><i class="bi bi-grid-3x3-gap-fill sb-sub-icon" style="color:#6366f1;"></i>Catálogo</a>
        </div>
      </div>

      <!-- ACTIVOS -->
      <div class="sb-section">
        <span class="sb-section-label">Activos</span>
        <button class="sb-item" onclick="sbToggle('subActivos', this)">
          <i class="bi bi-laptop-fill sb-icon" style="color:#d97706;"></i>
          <span class="sb-label">Gestión de Activos</span>
          <i class="bi bi-chevron-down sb-expand-icon"></i>
        </button>
        <div class="sb-sub-menu" id="subActivos">
          <a class="sb-sub-item" href="/equipment"><i class="bi bi-pc-display-horizontal sb-sub-icon" style="color:#d97706;"></i>CMDB</a>
          <a class="sb-sub-item" href="/warranty"><i class="bi bi-shield-check sb-sub-icon" style="color:#059669;"></i>Garantías</a>
          <a class="sb-sub-item" href="/incidencias?tab=devoluciones"><i class="bi bi-box-arrow-in-left sb-sub-icon" style="color:#0891b2;"></i>Devoluciones</a>
          <a class="sb-sub-item" href="/sccm"><i class="bi bi-windows sb-sub-icon" style="color:#0078d4;"></i>SCCM</a>
          <a class="sb-sub-item" href="/soporte"><i class="bi bi-tools sb-sub-icon" style="color:#059669;"></i>Soporte técnico</a>
        </div>
      </div>

      <!-- CONTENIDO -->
