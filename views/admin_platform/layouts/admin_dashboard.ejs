      <!-- REPORTERÍA -->
      <div class="sb-section">
        <span class="sb-section-label">Reportería</span>
        <button class="sb-item" onclick="sbToggle('subReportes', this)">
          <i class="bi bi-graph-up-arrow sb-icon" style="color:#059669;"></i>
          <span class="sb-label">Reportería</span>
          <i class="bi bi-chevron-down sb-expand-icon"></i>
        </button>
        <div class="sb-sub-menu" id="subReportes">
          <a class="sb-sub-item" href="/indicators"><i class="bi bi-bar-chart-line-fill sb-sub-icon" style="color:#059669;"></i>Indicadores KPI</a>
          <a class="sb-sub-item" href="/analytics"><i class="bi bi-bar-chart-fill sb-sub-icon" style="color:#059669;"></i>Reportes</a>
          <a class="sb-sub-item" href="/csi"><i class="bi bi-arrow-up-circle-fill sb-sub-icon" style="color:#0891b2;"></i>CSI</a>
