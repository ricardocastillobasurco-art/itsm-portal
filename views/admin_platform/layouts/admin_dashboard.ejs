        </button>
        <div class="sb-sub-menu" id="subUsuarios">
          <a class="sb-sub-item" href="/colaboradores"><i class="bi bi-person-badge-fill sb-sub-icon" style="color:#0891b2;"></i>Colaboradores</a>
