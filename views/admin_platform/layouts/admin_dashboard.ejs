      <!-- CONFIGURACIÓN -->
      <div class="sb-section">
        <span class="sb-section-label">Configuración</span>
        <button class="sb-item" onclick="sbToggle('subConfig', this)">
          <i class="bi bi-sliders2-vertical sb-icon" style="color:#6366f1;"></i>
          <span class="sb-label">Configuración ITSM</span>
          <i class="bi bi-chevron-down sb-expand-icon"></i>
        </button>
        <div class="sb-sub-menu" id="subConfig">
          <a class="sb-sub-item" href="/itsm/incidencias/gestion?tab=categorias"><i class="bi bi-tags-fill sb-sub-icon" style="color:#7c3aed;"></i>Categorías</a>
          <a class="sb-sub-item" href="/itsm/incidencias/gestion?tab=automaciones"><i class="bi bi-gear-wide-connected sb-sub-icon" style="color:#0891b2;"></i>Automatizaciones</a>
          <a class="sb-sub-item" href="/itsm/incidencias/gestion?tab=especialistas"><i class="bi bi-people-fill sb-sub-icon" style="color:#059669;"></i>Especialistas</a>
        </div>
      </div>

      <!-- MICROSOFT 365 -->
      <div class="sb-section">
        <span class="sb-section-label">Microsoft 365</span>
        <a class="sb-item" href="/microsoft">
          <i class="bi bi-grid-1x2-fill sb-icon" style="color:#0078d4;"></i>
          <span class="sb-label">Panel M365 + Intune</span>
        </a>
        <button class="sb-item" onclick="sbToggle('subMs', this)">
          <i class="bi bi-microsoft sb-icon" style="color:#0078d4;"></i>
          <span class="sb-label">Herramientas MS</span>
          <i class="bi bi-chevron-down sb-expand-icon"></i>
        </button>
        <div class="sb-sub-menu" id="subMs">
          <a class="sb-sub-item" href="/licencias/panel"><i class="bi bi-key-fill sb-sub-icon" style="color:#ca8a04;"></i>Licenciamiento M365</a>
          <a class="sb-sub-item" href="/almacen"><i class="bi bi-box-seam-fill sb-sub-icon" style="color:#0891b2;"></i>Almacén</a>
        </div>
      </div>
    </nav>

    <div class="sb-footer">
      <div class="sb-user-av"><%= _ini %></div>
      <div class="sb-user-info">
        <div class="sb-user-name"><%= _name %></div>
        <div class="sb-user-role"><%= _role %></div>
      </div>
      <button class="sb-theme-btn" onclick="toggleTheme()" title="Cambiar tema">
        <i class="bi bi-moon-stars-fill" id="sbThemeIcon"></i>
      </button>
    </div>
  </div><!-- /sidebar -->

  <div class="sb-overlay" id="sbOverlay" onclick="closeSidebarMobile()"></div>

  <!-- CONTENT AREA -->
  <div class="content-area">
    <div class="content-header">
      <div class="ch-info">
        <div class="ch-title">Dashboard Administrador</div>
        <div class="ch-sub"><span class="live-dot"></span>Datos en tiempo real · Actualizado hace <span id="lastUpdated">—</span></div>
      </div>
      <div class="ch-actions">
        <button class="refresh-btn" id="refreshBtn" onclick="loadAll()">
          <i class="bi bi-arrow-clockwise"></i> Actualizar
        </button>
      </div>
    </div>

    <div class="content-body">

      <!-- KPI Grid -->
      <div class="kpi-grid">
        <div class="kpi-card kpi-red"><div class="kpi-label">Sin Asignar</div><div class="kpi-val" id="k-total">—</div><div class="kpi-sub">Sin asignar en Jira</div><i class="bi bi-person-slash kpi-icon"></i></div>
        <div class="kpi-card kpi-yellow"><div class="kpi-label">Abiertos</div><div class="kpi-val" id="k-open">—</div><div class="kpi-sub">Sin asignar · Jira</div><i class="bi bi-folder2-open kpi-icon"></i></div>
        <div class="kpi-card kpi-blue"><div class="kpi-label">SLA Vencido</div><div class="kpi-val" id="k-breach">—</div><div class="kpi-sub">Superaron el plazo</div><i class="bi bi-alarm kpi-icon"></i></div>
        <div class="kpi-card kpi-green"><div class="kpi-label">Resueltos Hoy</div><div class="kpi-val" id="k-today">—</div><div class="kpi-sub">Cerrados hoy</div><i class="bi bi-check-circle kpi-icon"></i></div>
        <div class="kpi-card kpi-cyan"><div class="kpi-label">% SLA Cumplido</div><div class="kpi-val" id="k-sla-pct">—</div><div class="kpi-sub">Últimos 30 días</div><i class="bi bi-graph-up kpi-icon"></i></div>
        <div class="kpi-card kpi-purple"><div class="kpi-label">Usuarios Portal</div><div class="kpi-val" id="k-portal-users">—</div><div class="kpi-sub">Únicos este mes</div><i class="bi bi-people kpi-icon"></i></div>
        <div class="kpi-card kpi-green"><div class="kpi-label">CSAT Promedio</div><div class="kpi-val" id="k-csat">—</div><div class="kpi-sub">Satisfacción portal</div><i class="bi bi-star-half kpi-icon"></i></div>
        <div class="kpi-card kpi-yellow"><div class="kpi-label">Equipos TI</div><div class="kpi-val" id="k-equip">—</div><div class="kpi-sub">Inventario activo</div><i class="bi bi-laptop kpi-icon"></i></div>
        <div class="kpi-card kpi-blue"><div class="kpi-label">Colaboradores</div><div class="kpi-val" id="k-emp">—</div><div class="kpi-sub">Activos en directorio</div><i class="bi bi-person-badge kpi-icon"></i></div>
      </div>

      <!-- Trends + Status -->
      <div class="grid-main-side">
        <div class="card">
          <div class="card-title"><i class="bi bi-bar-chart-line"></i> Tendencia Diaria (30 días)</div>
          <div class="chart-wrap"><canvas id="trendChart"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title"><i class="bi bi-pie-chart"></i> Por Estado</div>
          <div class="chart-wrap"><canvas id="statusChart"></canvas></div>
        </div>
      </div>

      <div class="grid-3">
        <div class="card">
          <div class="card-title"><i class="bi bi-bar-chart"></i> Por Prioridad</div>
          <div class="chart-wrap"><canvas id="priorityChart"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title"><i class="bi bi-tags"></i> Por Categoría (Top 8)</div>
          <div class="chart-wrap"><canvas id="catChart"></canvas></div>
        </div>
        <div class="card">
          <div class="card-title"><i class="bi bi-shield-check"></i> SLA por Prioridad</div>
          <div id="slaPriorityBars" class="mt-2"></div>
        </div>
      </div>

      <!-- Agent Load + SLA by Agent -->
      <div class="grid-2">
        <div class="card">
          <div class="card-title"><i class="bi bi-people"></i> Carga por Agente</div>
          <div id="agentLoadList"></div>
        </div>
        <div class="card">
          <div class="card-title"><i class="bi bi-person-check"></i> SLA por Agente</div>
          <div id="slaAgentBars" class="mt-2"></div>
        </div>
      </div>

      <!-- Recent Tickets -->
      <div class="card">
        <div class="card-title"><i class="bi bi-clock-history"></i> Tickets Recientes (últimos 20)</div>
        <div class="tbl-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>#</th><th>Asunto</th><th>Prioridad</th><th>Estado</th>
                <th>Asignado a</th><th>Categoría</th><th>SLA</th><th>Creado</th>
              </tr>
            </thead>
            <tbody id="recentTicketsTbody">
              <tr><td colspan="8" style="text-align:center;color:var(--muted);padding:20px;font-size:13px">Cargando...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

    </div><!-- /content-body -->
  </div><!-- /content-area -->
</div><!-- /app-shell -->

<div class="toast-container" id="toastContainer"></div>

<script>
const APP_URL = '<%= (typeof APP_URL !== "undefined" && APP_URL) ? APP_URL : "" %>';
const CURRENT_USER_ID = '<%= user && user.id ? user.id : "" %>';

/* ── Theme ──────────────────────────────────────────── */
(function(){
  const t = localStorage.getItem('dashboardTheme') || 'light';
  document.documentElement.setAttribute('data-theme', t);
  updateThemeIcons(t);
})();
function toggleTheme() {
  const cur  = document.documentElement.getAttribute('data-theme') || 'light';
  const next = cur === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('dashboardTheme', next);
  updateThemeIcons(next);
}
function updateThemeIcons(t) {
  const icon = t === 'dark' ? 'bi-sun-fill' : 'bi-moon-stars-fill';
  ['navThemeIcon','sbThemeIcon'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.className = 'bi ' + icon;
  });
}

/* ── Sidebar ────────────────────────────────────────── */
function toggleSidebar() {
  const sb = document.getElementById('sidebar');
  if (window.innerWidth <= 768) {
    sb.classList.toggle('mobile-open');
    document.getElementById('sbOverlay').classList.toggle('visible');
  } else {
    sb.classList.toggle('collapsed');
    localStorage.setItem('sidebarCollapsed', sb.classList.contains('collapsed') ? '1' : '0');
  }
}
function closeSidebarMobile() {
  document.getElementById('sidebar').classList.remove('mobile-open');
  document.getElementById('sbOverlay').classList.remove('visible');
}
function sbToggle(id, btn) {
  const sub = document.getElementById(id);
  if (!sub) return;
  const isOpen = sub.classList.contains('open');
  sub.classList.toggle('open', !isOpen);
  btn.classList.toggle('sb-expanded', !isOpen);
}
(function(){
  if (localStorage.getItem('sidebarCollapsed') === '1') {
    document.getElementById('sidebar').classList.add('collapsed');
  }
})();

/* ── Socket.io ──────────────────────────────────────── */
const socket = io({ transports: ['websocket', 'polling'] });
socket.on('connect', () => {
  if (CURRENT_USER_ID) socket.emit('join', CURRENT_USER_ID);
  socket.emit('joinAgents');
});
socket.on('new-notification', (n) => showToast(n.title, n.body));

/* ── Chart refs ─────────────────────────────────────── */
let trendChart, statusChart, priorityChart, catChart;
function isDark()    { return document.documentElement.getAttribute('data-theme') === 'dark'; }
function gridColor() { return isDark() ? 'rgba(255,255,255,.07)' : 'rgba(0,0,0,.06)'; }
function textColor() { return isDark() ? '#94a3b8' : '#64748b'; }
function set(id, v)  { const el = document.getElementById(id); if (el) el.textContent = v; }

/* ── Load all ───────────────────────────────────────── */
async function loadAll() {
  const btn = document.getElementById('refreshBtn');
  if (btn) btn.classList.add('spinning');
  try {
    await Promise.all([loadItsm(), loadAgentLoad(), loadPortal(), loadAssets(), loadRecentTickets()]);
    set('lastUpdated', new Date().toLocaleTimeString('es', { hour: '2-digit', minute: '2-digit' }));
  } finally { if (btn) btn.classList.remove('spinning'); }
}

/* ── ITSM KPIs + charts ─────────────────────────────── */
async function loadItsm() {
  try {
    const base  = APP_URL || '';
    const today = new Date().toISOString().slice(0, 10);
    const closed = '"Cerrado","Closed","Cancelado","Cancelled","Resuelto","Resolved"';

    // Mismo approach que /administracion: POST a search/jql, contar issues.length
    function jiraCount(jql) {
      return fetch(base + '/api/jira/rest/api/3/search/jql', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ jql, fields: ['id'], maxResults: 500 })
      }).then(r => r.json())
        .then(d => Array.isArray(d.issues) ? d.issues.length : '—')
        .catch(() => '—');
    }

    const [jOpen, jToday, jBreach, sRaw, tRaw] = await Promise.all([
      jiraCount(`project = INC AND status not in (${closed}) AND assignee is EMPTY`),
      jiraCount(`project = INC AND resolutiondate >= startOfDay()`),
      jiraCount(`project = INC AND status not in (${closed}) AND created <= -8h`),
      fetch(base + '/api/reports-itsm/sla-compliance', { credentials: 'include' }).then(r => r.json()).catch(() => ({})),
      fetch(base + '/api/reports-itsm/trends', { credentials: 'include' }).then(r => r.json()).catch(() => ({}))
    ]);

    set('k-total',  jOpen   !== '—' ? jOpen   : '—');
    set('k-open',   jOpen   !== '—' ? jOpen   : '—');
    set('k-breach', jBreach !== '—' ? jBreach : '—');
    set('k-today',  jToday  !== '—' ? jToday  : '—');

    const sRes = sRaw.data || {};
    let slaOk = 0, slaTotal = 0;
    (sRes.byPriority || []).forEach(p => {
      slaTotal += parseInt(p.total)     || 0;
      slaOk    += parseInt(p.cumplidos) || 0;
    });
    set('k-sla-pct', slaTotal ? Math.round(slaOk / slaTotal * 100) + '%' : '—');

    const tRes = tRaw.data || {};
    renderStatusChart(tRes.byStatus    || []);
    renderPriorityChart(tRes.byPriority || []);
    renderCatChart(tRes.byCat          || []);
    renderTrendChart(tRes.daily        || []);
    renderSlaPriorityBars(sRes.byPriority || []);
    renderSlaAgentBars(sRes.byAgent    || []);
  } catch (e) { console.error('loadItsm:', e); }
}

/* ── Agent load ─────────────────────────────────────── */
async function loadAgentLoad() {
  try {
    const base   = APP_URL || '';
    const raw    = await fetch(base + '/api/reports-itsm/agent-load').then(r => r.json());
    const agents = Array.isArray(raw.data) ? raw.data : [];
    const el     = document.getElementById('agentLoadList');
    if (!agents.length) { el.innerHTML = '<p style="font-size:13px;color:var(--muted);text-align:center;padding:16px 0">Sin agentes activos</p>'; return; }
    const colors = ['#3b82f6','#10b981','#8b5cf6','#f59e0b','#ef4444','#06b6d4','#f97316','#ec4899'];
    el.innerHTML = agents.slice(0,10).map((a, i) => {
      const name    = a.agente || '—';
      const total   = parseInt(a.total_abiertos) || 0;
      const riesgo  = parseInt(a.en_riesgo)      || 0;
      const critico = parseInt(a.criticos)        || 0;
      const initials = name.split(' ').map(w => w[0]).join('').slice(0,2).toUpperCase();
      return `<div class="agent-row">
        <div class="agent-avatar" style="background:${colors[i%colors.length]}">${initials}</div>
        <div><div class="agent-name">${name}</div><div class="agent-meta">${total} ticket${total!==1?'s':''} · avg ${Math.round(parseFloat(a.avg_horas)||0)}h</div></div>
        <div class="agent-stats">
          ${critico > 0 ? `<div class="stat-chip danger">${critico}🔴</div>` : ''}
          ${riesgo  > 0 ? `<div class="stat-chip warn">${riesgo}⚠</div>` : ''}
          <div class="stat-chip">${total}</div>
        </div></div>`;
    }).join('');
  } catch(e) { console.error('loadAgentLoad:', e); }
}

/* ── Portal metrics ─────────────────────────────────── */
async function loadPortal() {
  try {
    const base = APP_URL || '';
    const [mRaw, sRaw] = await Promise.all([
      fetch(base + '/api/portal/activity-metrics').then(r => r.json()).catch(() => ({})),
      fetch(base + '/api/portal/survey-general/results').then(r => r.json()).catch(() => ({}))
    ]);
    set('k-portal-users', (mRaw.totals || {}).unique_users ?? '—');
    const surveys = sRaw.data || [];
    if (surveys.length) {
      const avg = surveys.reduce((s, r) => s + (parseInt(r.rating) || 0), 0) / surveys.length;
      set('k-csat', avg.toFixed(1) + ' ★');
    }
  } catch(e) { console.error('loadPortal:', e); }
}

/* ── Asset stats ────────────────────────────────────── */
async function loadAssets() {
  try {
    const base = APP_URL || '';
    // /tickets/cmdb/quick-stats devuelve {empleados, equipos} — mismo que /administracion
    const raw  = await fetch(base + '/tickets/cmdb/quick-stats', { credentials: 'include' }).then(r => r.json()).catch(() => ({}));
    set('k-equip', raw.equipos   ?? '—');
    set('k-emp',   raw.empleados ?? '—');
  } catch(e) { console.error('loadAssets:', e); }
}

/* ── Recent tickets ─────────────────────────────────── */
async function loadRecentTickets() {
  try {
    const base = APP_URL || '';
    const raw  = await fetch(base + '/api/reports-itsm/recent-tickets').then(r => r.json());
    renderRecentTickets(raw.data || []);
  } catch(e) { console.error('loadRecentTickets:', e); }
}

/* ── Chart renderers ────────────────────────────────── */
function renderTrendChart(daily) {
  const labels    = daily.map(r => { const d = new Date(r.fecha || r.day); return d.toLocaleDateString('es', { month:'short', day:'numeric' }); });
  const creados   = daily.map(r => parseInt(r.creados)   || 0);
  const resueltos = daily.map(r => parseInt(r.resueltos) || 0);
  if (trendChart) trendChart.destroy();
  trendChart = new Chart(document.getElementById('trendChart'), {
    type: 'line',
    data: { labels, datasets: [
      { label:'Creados',   data:creados,   borderColor:'#3b82f6', backgroundColor:'rgba(59,130,246,.1)', fill:true, tension:0.4, pointRadius:2 },
      { label:'Resueltos', data:resueltos, borderColor:'#10b981', backgroundColor:'rgba(16,185,129,.1)', fill:true, tension:0.4, pointRadius:2 }
    ]},
    options: { responsive:true, maintainAspectRatio:true, plugins:{ legend:{ labels:{ color:textColor(), font:{ size:11 } } } }, scales:{ x:{ grid:{ color:gridColor() }, ticks:{ color:textColor(), maxTicksLimit:10 } }, y:{ grid:{ color:gridColor() }, ticks:{ color:textColor() }, beginAtZero:true } } }
  });
}
function renderStatusChart(data) {
  const statusLabel = { abierto:'Abierto', en_progreso:'En progreso', pendiente:'Pendiente', resuelto:'Resuelto', cerrado:'Cerrado' };
  if (statusChart) statusChart.destroy();
  statusChart = new Chart(document.getElementById('statusChart'), {
    type:'doughnut',
    data:{ labels:data.map(d=>statusLabel[d.status]||d.status||'?'), datasets:[{ data:data.map(d=>parseInt(d.total)||0), backgroundColor:['#3b82f6','#f59e0b','#8b5cf6','#10b981','#64748b','#ef4444'], borderWidth:2, borderColor:'var(--card)' }] },
    options:{ responsive:true, maintainAspectRatio:true, plugins:{ legend:{ position:'bottom', labels:{ color:textColor(), padding:10, font:{ size:11 } } } } }
  });
}
function renderPriorityChart(data) {
  const prioLabel = { P1:'P1 Crítica', P2:'P2 Alta', P3:'P3 Media', P4:'P4 Baja', critica:'Crítica', alta:'Alta', media:'Media', baja:'Baja' };
  const bg = data.map(d => (d.priority==='P1'||d.priority==='critica')?'#ef4444':(d.priority==='P2'||d.priority==='alta')?'#f97316':(d.priority==='P3'||d.priority==='media')?'#f59e0b':'#10b981');
  if (priorityChart) priorityChart.destroy();
  priorityChart = new Chart(document.getElementById('priorityChart'), {
    type:'bar',
    data:{ labels:data.map(d=>prioLabel[d.priority]||d.priority||'?'), datasets:[{ label:'Tickets', data:data.map(d=>parseInt(d.total)||0), backgroundColor:bg, borderRadius:8 }] },
    options:{ responsive:true, maintainAspectRatio:true, plugins:{ legend:{ display:false } }, scales:{ x:{ grid:{ display:false }, ticks:{ color:textColor() } }, y:{ grid:{ color:gridColor() }, ticks:{ color:textColor() }, beginAtZero:true } } }
  });
}
function renderCatChart(data) {
  const sorted = [...data].sort((a,b)=>(parseInt(b.total)||0)-(parseInt(a.total)||0)).slice(0,8);
  if (catChart) catChart.destroy();
  catChart = new Chart(document.getElementById('catChart'), {
    type:'bar',
    data:{ labels:sorted.map(d=>d.categoria||'?'), datasets:[{ data:sorted.map(d=>parseInt(d.total)||0), backgroundColor:'#8b5cf6', borderRadius:6 }] },
    options:{ indexAxis:'y', responsive:true, maintainAspectRatio:true, plugins:{ legend:{ display:false } }, scales:{ x:{ grid:{ color:gridColor() }, ticks:{ color:textColor() }, beginAtZero:true }, y:{ grid:{ display:false }, ticks:{ color:textColor(), font:{ size:11 } } } } }
  });
}
function renderSlaPriorityBars(data) {
  const el = document.getElementById('slaPriorityBars');
  if (!data.length) { el.innerHTML = '<p style="font-size:13px;color:var(--muted)">Sin datos SLA</p>'; return; }
  const prioLabel = { P1:'P1 Crítica', P2:'P2 Alta', P3:'P3 Media', P4:'P4 Baja', critica:'Crítica', alta:'Alta', media:'Media', baja:'Baja' };
  el.innerHTML = data.map(r => {
    const pct   = parseFloat(r.pct_cumplimiento) || 0;
    const color = pct >= 90 ? '#10b981' : pct >= 70 ? '#f59e0b' : '#ef4444';
    return `<div class="progress-row">
      <span class="progress-label">${prioLabel[r.priority]||r.priority||'?'}</span>
      <div class="progress-bar-wrap"><div class="progress-bar-fill" style="width:${pct}%;background:${color}"></div></div>
      <span class="progress-val">${Math.round(pct)}%</span>
    </div><div style="font-size:10px;color:var(--muted);margin:-4px 0 10px 130px">${r.cumplidos||0}/${r.total||0} dentro del SLA</div>`;
  }).join('');
}
function renderSlaAgentBars(data) {
  const el = document.getElementById('slaAgentBars');
  if (!data.length) { el.innerHTML = '<p style="font-size:13px;color:var(--muted)">Sin datos</p>'; return; }
  el.innerHTML = data.slice(0,10).map(r => {
    const pct   = parseFloat(r.pct) || 0;
    const color = pct >= 90 ? '#10b981' : pct >= 70 ? '#f59e0b' : '#ef4444';
    return `<div class="progress-row">
      <span class="progress-label" title="${r.agente||''}">${r.agente||'—'}</span>
      <div class="progress-bar-wrap"><div class="progress-bar-fill" style="width:${pct}%;background:${color}"></div></div>
      <span class="progress-val">${Math.round(pct)}%</span>
    </div>`;
  }).join('');
}
function renderRecentTickets(tickets) {
  const tbody = document.getElementById('recentTicketsTbody');
  if (!tickets.length) { tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;color:var(--muted);padding:20px;font-size:13px">Sin tickets recientes</td></tr>'; return; }
  const prioBadge = p => { const m={P1:'bp-red',P2:'bp-yellow',P3:'bp-blue',P4:'bp-gray',critica:'bp-red',alta:'bp-yellow',media:'bp-blue',baja:'bp-gray'}; return `<span class="badge-pill ${m[p]||'bp-gray'}">${p||'—'}</span>`; };
  const estadoBadge = s => { const m={abierto:'bp-blue',en_progreso:'bp-purple',pendiente:'bp-yellow',resuelto:'bp-green',cerrado:'bp-gray'}; return `<span class="badge-pill ${m[s]||'bp-gray'}">${(s||'—').replace('_',' ')}</span>`; };
  const slaBadge = s => (!s||s==='ok'||s==='normal') ? '' : `<span class="badge-pill ${s==='vencido'?'bp-red':'bp-yellow'}">${s}</span>`;
  tbody.innerHTML = tickets.map(t => {
    const created = t.createdAt ? new Date(t.createdAt).toLocaleDateString('es',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '—';
    return `<tr>
      <td style="font-size:11px;color:var(--primary);font-variant-numeric:tabular-nums">${t.ticket_key||('#'+t.id)}</td>
      <td style="max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${t.titulo||'—'}</td>
      <td>${prioBadge(t.prioridad)}</td><td>${estadoBadge(t.estado)}</td>
      <td style="font-size:12px">${t.agente||'—'}</td>
      <td style="font-size:12px;color:var(--muted)">${t.categoria||'—'}</td>
      <td>${slaBadge(t.sla_status)}</td>
      <td style="font-size:11px;color:var(--muted);white-space:nowrap">${created}</td>
    </tr>`;
  }).join('');
}

/* ── Toast ──────────────────────────────────────────── */
function showToast(title, body) {
  const el = document.createElement('div');
  el.className = 'toast';
  el.innerHTML = `<div class="toast-title">${title}</div>${body?`<div class="toast-body">${body}</div>`:''}`;
  document.getElementById('toastContainer').appendChild(el);
  setTimeout(() => el.remove(), 5000);
}

/* ── Init ───────────────────────────────────────────── */
loadAll();
setInterval(loadAll, 5 * 60 * 1000);
</script>
</body>
