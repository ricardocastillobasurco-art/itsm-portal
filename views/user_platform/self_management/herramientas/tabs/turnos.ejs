<!-- ─── TAB 11: CALENDARIO DE TURNOS ──────────────────────────────────────────── -->
<div class="section-tab" id="toolTab11">
  <div class="card-ui">
    <div class="card-head" style="flex-wrap:wrap;gap:8px;">
      <span class="title"><i class="bi bi-calendar2-week-fill" style="color:#0ea5e9;"></i> Calendario de Turnos</span>
      <div style="display:flex;gap:6px;align-items:center;margin-left:auto;flex-wrap:wrap;">
        <button class="btn-sm btn-outline" onclick="calPrevWeek()"><i class="bi bi-chevron-left"></i></button>
        <span id="calWeekLabel" style="font-size:13px;font-weight:700;color:var(--text);min-width:180px;text-align:center;"></span>
        <button class="btn-sm btn-outline" onclick="calNextWeek()"><i class="bi bi-chevron-right"></i></button>
        <button class="btn-sm btn-outline" onclick="calGoToday()" style="margin-left:4px;">Hoy</button>
        <button class="btn-sm" style="background:#0ea5e9;color:#fff;border:none;" onclick="calOpenNewShift()"><i class="bi bi-plus-lg"></i> Turno</button>
        <button class="btn-sm btn-outline" onclick="calOpenNewAgent()"><i class="bi bi-person-plus"></i> Agente</button>
      </div>
    </div>
    <div style="padding:12px;display:flex;gap:12px;">
      <!-- Sidebar agentes -->
      <div style="width:160px;flex-shrink:0;">
        <div style="font-size:11px;font-weight:800;text-transform:uppercase;color:var(--muted);letter-spacing:.6px;margin-bottom:8px;">Agentes</div>
        <div id="calAgentList" style="display:flex;flex-direction:column;gap:5px;"></div>
      </div>
      <!-- Grid semanal -->
      <div style="flex:1;overflow-x:auto;">
        <div id="calGrid" style="min-width:560px;"></div>
      </div>
    </div>
  </div>

  <!-- Ruleta de turnos -->
  <div class="card-ui">
    <div class="card-head">
      <span class="title"><i class="bi bi-arrow-repeat" style="color:#8b5cf6;"></i> Sorteador de Turnos</span>
      <span style="font-size:11px;color:var(--muted);margin-left:8px;">Escribe nombres (uno por línea) y gira la ruleta</span>
    </div>
    <div style="display:flex;gap:20px;padding:16px;flex-wrap:wrap;align-items:flex-start;">
      <!-- Input + controls -->
      <div style="flex:1;min-width:200px;display:flex;flex-direction:column;gap:10px;">
        <label class="form-lbl">Lista de participantes</label>
        <textarea id="wheelNames" class="form-ctrl" rows="9"
          placeholder="Ana García&#10;Carlos López&#10;María Torres&#10;Pedro Díaz&#10;Sofía Mendez&#10;Luis Ramos"
          style="resize:vertical;font-size:13px;line-height:1.8;"
          oninput="wheelDraw()"></textarea>
        <button class="btn-sm btn-primary" id="wheelSpinBtn" onclick="wheelSpin()"
          style="width:100%;justify-content:center;font-size:14px;padding:11px 0;letter-spacing:.3px;">
          <i class="bi bi-arrow-repeat"></i> ¡Girar ruleta!
        </button>
        <button class="btn-sm btn-outline" onclick="wheelReset()" style="width:100%;justify-content:center;">
          <i class="bi bi-x-circle"></i> Reiniciar
        </button>
        <div id="wheelWinner" style="display:none;" class="wheel-winner-banner">
          <div style="font-size:11px;font-weight:800;opacity:.8;text-transform:uppercase;letter-spacing:.7px;">¡El turno es para!</div>
          <div id="wheelWinnerName" style="font-size:24px;font-weight:900;margin-top:5px;"></div>
          <div style="font-size:28px;margin-top:4px;">🎉</div>
        </div>
        <div id="wheelHistory" style="display:flex;flex-direction:column;gap:4px;max-height:110px;overflow-y:auto;"></div>
      </div>
      <!-- Canvas wheel -->
      <div style="display:flex;flex-direction:column;align-items:center;gap:14px;flex-shrink:0;">
        <div style="position:relative;display:inline-flex;align-items:center;">
          <canvas id="wheelCanvas" width="300" height="300"></canvas>
          <!-- Arrow pointer on right side -->
          <div style="position:absolute;right:-20px;top:50%;transform:translateY(-50%);
            width:0;height:0;
            border-top:15px solid transparent;border-bottom:15px solid transparent;
            border-right:24px solid #1e293b;
            filter:drop-shadow(-2px 0 4px rgba(0,0,0,.35));"></div>
        </div>
        <div style="font-size:11px;color:var(--muted);text-align:center;">
          <i class="bi bi-info-circle"></i> La flecha indica el ganador
        </div>
      </div>
    </div>
  </div>

  <!-- Modal nuevo turno -->
  <div id="calModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:3000;align-items:center;justify-content:center;">
    <div style="background:var(--card);border-radius:16px;padding:24px;width:340px;box-shadow:0 20px 60px rgba(0,0,0,.3);">
      <div style="font-size:15px;font-weight:800;color:var(--text);margin-bottom:16px;" id="calModalTitle">Nuevo Turno</div>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <div>
          <label style="font-size:11px;font-weight:700;color:var(--muted);">Agente</label>
          <select id="calModalAgent" class="cal-input"></select>
        </div>
        <div style="display:flex;gap:8px;">
          <div style="flex:1;">
            <label style="font-size:11px;font-weight:700;color:var(--muted);">Inicio</label>
            <input type="datetime-local" id="calModalStart" class="cal-input">
          </div>
          <div style="flex:1;">
            <label style="font-size:11px;font-weight:700;color:var(--muted);">Fin</label>
            <input type="datetime-local" id="calModalEnd" class="cal-input">
          </div>
        </div>
        <div>
          <label style="font-size:11px;font-weight:700;color:var(--muted);">Tipo</label>
          <select id="calModalType" class="cal-input">
            <option value="normal">Normal</option>
            <option value="guardia">Guardia / On-Call</option>
            <option value="extra">Extra</option>
            <option value="libre">Libre / Descanso</option>
          </select>
        </div>
        <div>
          <label style="font-size:11px;font-weight:700;color:var(--muted);">Nota (opcional)</label>
          <input type="text" id="calModalNote" class="cal-input" placeholder="Ej: Turno noche, cobertura sur…">
        </div>
      </div>
      <div style="display:flex;gap:8px;margin-top:18px;justify-content:flex-end;">
        <button class="btn-sm btn-outline" onclick="calCloseModal()">Cancelar</button>
        <button id="calModalDelBtn" class="btn-sm" style="background:#ef4444;color:#fff;border:none;display:none;" onclick="calDeleteShift()">Eliminar</button>
        <button class="btn-sm" style="background:#0ea5e9;color:#fff;border:none;" onclick="calSaveShift()">Guardar</button>
      </div>
    </div>
  </div>
  <!-- Modal nuevo agente -->
  <div id="calAgentModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:3000;align-items:center;justify-content:center;">
    <div style="background:var(--card);border-radius:16px;padding:24px;width:300px;box-shadow:0 20px 60px rgba(0,0,0,.3);">
      <div style="font-size:15px;font-weight:800;color:var(--text);margin-bottom:16px;">Agregar Agente</div>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <div><label style="font-size:11px;font-weight:700;color:var(--muted);">Nombre</label><input type="text" id="calAgentName" class="cal-input" placeholder="Juan Pérez"></div>
        <div><label style="font-size:11px;font-weight:700;color:var(--muted);">Rol</label><input type="text" id="calAgentRole" class="cal-input" placeholder="Técnico N2"></div>
        <div><label style="font-size:11px;font-weight:700;color:var(--muted);">Color</label>
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:4px;" id="calColorPicker">
            <% ['#0ea5e9','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899','#14b8a6','#f97316'].forEach(c => { %>
              <div class="cal-color-dot" data-color="<%=c%>" style="background:<%=c%>;" onclick="calPickColor(this)"></div>
            <% }); %>
          </div>
          <input type="hidden" id="calAgentColor" value="#0ea5e9">
        </div>
      </div>
      <div style="display:flex;gap:8px;margin-top:18px;justify-content:flex-end;">
        <button class="btn-sm btn-outline" onclick="document.getElementById('calAgentModal').style.display='none'">Cancelar</button>
        <button class="btn-sm" style="background:#0ea5e9;color:#fff;border:none;" onclick="calSaveAgent()">Agregar</button>
      </div>
    </div>
  </div>
</div>
