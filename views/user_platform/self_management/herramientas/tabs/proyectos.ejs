  <!-- ─── TAB 2: PROYECTOS (GANTT) ─────────────────────────────────────────── -->
  <style>
  @media(max-width:768px){
    /* Mobile: hide Gantt timeline, show task list full-width */
    #ganttHeaderWrap { display:none !important; }
    #ganttScrollWrap { display:none !important; }
    #ganttContainer > div:first-child > div:first-child { width:100% !important; border-right:none !important; }
    #ganttTaskList { width:100% !important; border-right:none !important; max-height:60vh; overflow-y:auto; }
    #ganttContainer > div:last-child { max-height:none; min-height:unset; }
    /* Header: wrap buttons vertically on mobile */
    #toolTab2 .card-head > div { width:100%; justify-content:flex-start; }
    #ganttPeriodLabel { min-width:unset !important; font-size:11px !important; }
  }
  @media(max-width:480px){
    #toolTab2 .card-head { flex-direction:column; align-items:flex-start; }
    #toolTab2 .card-head > div { flex-wrap:wrap; }
  }
  </style>
  <div class="section-tab" id="toolTab2">
    <div class="card-ui" style="margin-bottom:12px;">
      <div class="card-head" style="flex-wrap:wrap;gap:8px;">
        <span class="title"><i class="bi bi-diagram-3-fill" style="color:#8b5cf6;"></i> Proyectos — Gantt</span>
        <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-left:auto;">
          <button class="btn-sm btn-outline" onclick="ganttPrevPeriod()" title="Mes anterior"><i class="bi bi-chevron-left"></i></button>
          <span id="ganttPeriodLabel" style="font-size:12px;font-weight:700;color:var(--text);min-width:160px;text-align:center;"></span>
          <button class="btn-sm btn-outline" onclick="ganttNextPeriod()" title="Mes siguiente"><i class="bi bi-chevron-right"></i></button>
          <button class="btn-sm btn-outline" onclick="ganttGoToday()"><i class="bi bi-calendar-check"></i> Hoy</button>
          <button class="btn-sm btn-primary" onclick="ganttOpenAdd()"><i class="bi bi-plus-lg"></i> Nueva tarea</button>
          <button class="btn-sm btn-outline" onclick="ganttExport()"><i class="bi bi-download"></i> Exportar</button>
        </div>
      </div>
    </div>
    <div class="card-ui" style="overflow:hidden;" id="ganttContainer">
      <div style="display:flex;border-bottom:2px solid var(--border);">
        <div style="width:262px;flex-shrink:0;border-right:1px solid var(--border);padding:9px 14px;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.3px;background:var(--hdr);">Tarea / Responsable</div>
        <div id="ganttHeaderWrap" style="flex:1;overflow:hidden;background:var(--hdr);">
          <div id="ganttHeader"></div>
        </div>
      </div>
      <div style="display:flex;max-height:65vh;min-height:320px;">
        <div id="ganttTaskList" style="width:262px;flex-shrink:0;border-right:1px solid var(--border);overflow-y:auto;"></div>
        <div id="ganttScrollWrap" style="flex:1;overflow:auto;">
          <div id="ganttTimeline" style="position:relative;"></div>
        </div>
      </div>
    </div>
    <!-- Add/Edit modal -->
    <div id="ganttModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.52);z-index:10000;align-items:center;justify-content:center;">
      <div style="background:var(--card);border-radius:18px;padding:24px;width:100%;max-width:440px;box-shadow:0 20px 60px rgba(0,0,0,.3);margin:16px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
          <h3 id="ganttModalTitle" style="margin:0;font-size:16px;font-weight:800;color:var(--text);">Nueva tarea</h3>
          <button onclick="ganttCloseModal()" style="background:none;border:none;cursor:pointer;font-size:22px;color:var(--muted);line-height:1;">×</button>
        </div>
        <div class="form-group">
          <label class="form-lbl">Nombre *</label>
          <input type="text" id="ganttFName" class="form-ctrl" placeholder="Ej. Diseño de interfaz">
        </div>
        <div class="form-group">
          <label class="form-lbl">Responsable</label>
          <input type="text" id="ganttFResp" class="form-ctrl" placeholder="Nombre del responsable">
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <div class="form-group"><label class="form-lbl">Inicio *</label><input type="date" id="ganttFStart" class="form-ctrl"></div>
          <div class="form-group"><label class="form-lbl">Fin *</label><input type="date" id="ganttFEnd" class="form-ctrl"></div>
        </div>
        <div class="form-group">
          <label class="form-lbl">Progreso: <span id="ganttProgVal">0</span>%</label>
          <input type="range" id="ganttFProg" min="0" max="100" value="0" oninput="document.getElementById('ganttProgVal').textContent=this.value" style="width:100%;accent-color:var(--primary);">
        </div>
        <div class="form-group">
          <label class="form-lbl">Color</label>
          <div id="ganttColorPicker" style="display:flex;gap:8px;flex-wrap:wrap;"></div>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:18px;">
          <button id="ganttDelBtn" class="btn-sm btn-danger" style="display:none;margin-right:auto;" onclick="ganttConfirmDelete()"><i class="bi bi-trash"></i> Eliminar</button>
          <button class="btn-sm btn-outline" onclick="ganttCloseModal()">Cancelar</button>
          <button class="btn-sm btn-primary" onclick="ganttSaveTask()">Guardar</button>
        </div>
      </div>
    </div>
  </div>
