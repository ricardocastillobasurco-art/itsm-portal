<style>
@media(max-width:768px){
  /* Stack 3 columns vertically: left tools → canvas → right send */
  #evtLayout{flex-direction:column !important;}
  #evtLeft,#evtRight{width:100% !important;}
  /* Left tools: lay out cards side by side where possible */
  #evtLeft{flex-direction:row !important;flex-wrap:wrap !important;align-items:flex-start;}
  #evtLeft > .card-ui{flex:1 1 140px;min-width:0;}
  /* Toolbar card: overflow visible para que las filas wrapped (color dots) no se corten */
  #evtCenter > .card-ui:first-child{overflow:visible !important;}
  #evtCenter > .card-ui:first-child > div{row-gap:6px !important;}
  /* Selects más compactos */
  #evtCenter > .card-ui:first-child select{max-width:80px;}
  /* Canvas card: right panel full width */
  #evtRight{width:100% !important;}
  #evtRight > .card-ui{width:100%;}
}
@media(max-width:600px){
  /* Canvas: escalar para encuadrar en pantalla mobile (520→338, 360→234) */
  #evtCanvasCard{
    overflow:visible !important;
    padding:12px !important;
    justify-content:flex-start !important;
    align-items:flex-start !important;
  }
  #evtCanvasCard > div{
    width:338px !important;
    height:234px !important;
    overflow:visible !important;
  }
  #evtCanvas{
    transform:scale(0.65);
    transform-origin:top left;
  }
}
@media(max-width:480px){
  /* On very small screens, keep left tools stacked vertically */
  #evtLeft{flex-direction:column !important;}
  #evtLeft > .card-ui{flex:none !important;width:100% !important;}
  /* Color dots más pequeños */
  .evt-clr-dot{width:16px !important;height:16px !important;}
}
</style>
