           '<div style="position:absolute;top:0;right:0;font-size:54px;line-height:1;opacity:.82;transform:scaleX(-1);">🎀</div>' +
           '<div style="position:absolute;bottom:0;left:0;font-size:38px;line-height:1;opacity:.65;transform:rotate(30deg);">🎀</div>' +
           '<div style="position:absolute;bottom:0;right:0;font-size:38px;line-height:1;opacity:.65;transform:rotate(-30deg) scaleX(-1);">🎀</div>';
  }},
];

var _evtStickers = [
  '🎂','🎉','🎊','🎈','🎁','🎀','🥳','🍰','🎆','🎇',
  '⭐','🌟','✨','💫','🌠','🏆','🥇','👑','💎','🎖️',
  '❤️','💕','💖','💗','🌹','🌺','🌸','🌻','🍀','🌈',
  '🤝','👏','🙌','💪','✅','🎯','💡','🚀','🔥','⚡',
  '🎵','🎶','🍾','🥂','🎸','🎤','☀️','🌙','🦋','🌊',
];

// ── Init ────────────────────────────────────────────────────────────────────
function evtUpdatePreview() {} // stub — replaced below, called by switchToolTab

function evtInit() {
  // BG grid
  var bgGrid = document.getElementById('evtBgGrid');
  if (bgGrid) {
    bgGrid.innerHTML = _evtBgs.map(function(b,i){
      return '<div class="evt-bg-thumb'+(i===0?' active':'')+'" data-i="'+i+'" onclick="evtSetBg('+i+')" style="background:'+b.g+';">'+b.e+'</div>';
    }).join('');
  }

  // Frame grid
  var fgrid = document.getElementById('evtFrameGrid');
  if (fgrid) {
    fgrid.innerHTML = _evtFrameDefs.map(function(f,i){
      return '<div class="evt-frame-thumb'+(i===0?' active':'')+'" onclick="evtSetFrame('+i+')">'+f.l+'</div>';
    }).join('');
  }

  // Stickers
  var sbar = document.getElementById('evtStickerBar');
  if (sbar) {
    sbar.innerHTML = _evtStickers.map(function(e){
      return '<button class="evt-sticker-btn" onclick="evtAddSticker(\''+e+'\')">'+e+'</button>';
    }).join('');
  }

  // Default color selection
  var firstDot = document.querySelector('.evt-clr-dot[data-clr="#ffffff"]');
  if (firstDot) firstDot.style.boxShadow = '0 0 0 2px #1e293b, 0 0 0 4px rgba(255,255,255,.8)';
}

// ── Background ──────────────────────────────────────────────────────────────
function evtSetBg(i) {
  _evtSt.bgIdx = i;
  var cv = document.getElementById('evtCanvas');
  if (cv) cv.style.background = _evtBgs[i].g;
  document.querySelectorAll('.evt-bg-thumb').forEach(function(el,j){ el.classList.toggle('active', j===i); });
}

// ── Frames ──────────────────────────────────────────────────────────────────
function evtSetFrame(i) {
  _evtSt.frameIdx = i;
  var fl = document.getElementById('evtFrameLayer');
  if (fl) fl.innerHTML = _evtFrameDefs[i].fn();
  document.querySelectorAll('.evt-frame-thumb').forEach(function(el,j){ el.classList.toggle('active', j===i); });
}

// ── Add elements ─────────────────────────────────────────────────────────────
function evtAddSticker(emoji) {
  var cv = document.getElementById('evtCanvas');
  if (!cv) return;
  var id = 'eve_'+(++_evtSt.nextId);
  var el = document.createElement('div');
  el.id = id; el.className = 'evt-el';
  el.setAttribute('data-t','sticker');
  el.style.cssText = 'position:absolute;font-size:46px;line-height:1;cursor:move;user-select:none;z-index:10;' +
    'left:'+(40+Math.random()*380)+'px;top:'+(20+Math.random()*270)+'px;';
  el.textContent = emoji;
  el.addEventListener('mousedown', function(e){ evtElDown(e, id); });
  cv.insertBefore(el, document.getElementById('evtFrameLayer'));
  evtSelect(id);
}

function evtAddText() {
  var cv = document.getElementById('evtCanvas');
  if (!cv) return;
  var id = 'eve_'+(++_evtSt.nextId);
  var el = document.createElement('div');
  el.id = id; el.className = 'evt-el';
  el.setAttribute('data-t','text');
  el.contentEditable = 'true';
  el.spellcheck = false;
  el.style.cssText = 'position:absolute;left:40px;top:140px;' +
    'font-size:'+_evtSt.size+'px;font-weight:'+(_evtSt.bold?'800':'400')+';' +
    'color:'+_evtSt.color+';font-family:'+_evtSt.font+';' +
    'text-shadow:'+(_evtSt.shadow?'0 2px 10px rgba(0,0,0,.7),0 0 20px rgba(0,0,0,.3)':'none')+';' +
    'cursor:move;user-select:none;z-index:10;outline:none;min-width:80px;' +
    'white-space:nowrap;line-height:1.2;';
  el.textContent = 'Escribe aquí';
  el.addEventListener('mousedown', function(e){ evtElDown(e, id); });
  el.addEventListener('dblclick', function(e){
    e.stopPropagation();
    el.style.cursor = 'text'; el.style.userSelect = 'text';
    el.focus(); document.execCommand('selectAll', false, null);
  });
  el.addEventListener('blur', function(){
    el.style.cursor = 'move'; el.style.userSelect = 'none';
  });
  cv.insertBefore(el, document.getElementById('evtFrameLayer'));
  evtSelect(id);
  setTimeout(function(){ el.focus(); document.execCommand('selectAll',false,null); }, 60);
}

function evtAddImg(input) {
  var file = input.files[0]; if (!file) return;
  var reader = new FileReader();
  reader.onload = function(ev) {
    var cv = document.getElementById('evtCanvas'); if (!cv) return;
    var id = 'eve_'+(++_evtSt.nextId);
    var img = document.createElement('img');
    img.id = id; img.className = 'evt-el';
    img.setAttribute('data-t','image');
    img.src = ev.target.result;
    img.draggable = false;
    img.style.cssText = 'position:absolute;left:130px;top:60px;width:260px;height:auto;' +
      'cursor:move;border-radius:10px;z-index:10;box-shadow:0 6px 24px rgba(0,0,0,.4);';
    img.addEventListener('mousedown', function(e){ evtElDown(e, id); });
    cv.insertBefore(img, document.getElementById('evtFrameLayer'));
    evtSelect(id);
  };
  reader.readAsDataURL(file);
  input.value = '';
}

function evtImgDrop(e) {
  e.preventDefault();
  document.getElementById('evtImgDropZone').classList.remove('drag-over');
  var file = e.dataTransfer.files[0];
  if (file && file.type.startsWith('image/')) {
    var fakeInput = { files: [file] };
    evtAddImg(fakeInput);
  }
}

// ── Selection & drag ────────────────────────────────────────────────────────
function evtSelect(id) {
  _evtSt.selId = id;
  document.querySelectorAll('.evt-el').forEach(function(el){
    el.style.outline = (el.id===id) ? '2px dashed rgba(255,255,255,.9)' : 'none';
    el.style.outlineOffset = '4px';
  });
  var db = document.getElementById('evtDelBtn');
  if (db) db.style.display = id ? 'inline-flex' : 'none';
  // Sync toolbar to selected text element
  if (id) {
    var el = document.getElementById(id);
    if (el && el.getAttribute('data-t')==='text') {
      _evtSt.color = el.style.color || _evtSt.color;
      _evtSt.size  = parseInt(el.style.fontSize) || _evtSt.size;
    }
  }
}

function evtDeleteSelected() {
  if (!_evtSt.selId) return;
  var el = document.getElementById(_evtSt.selId);
  if (el) el.remove();
  evtSelect(null);
}

function evtElDown(e, id) {
  e.stopPropagation();
  evtSelect(id);
  var el = document.getElementById(id);
  if (!el || (el.getAttribute('data-t')==='text' && e.detail>=2)) return;
  e.preventDefault();
  _evtSt.drag = { on:true, id:id, sx:e.clientX, sy:e.clientY, sl:el.offsetLeft, st:el.offsetTop };
}

function evtCanvasDown(e) {
  if (e.target.id === 'evtCanvas' || e.target.id === 'evtFrameLayer') evtSelect(null);
}

function evtCanvasMove(e) {
  if (!_evtSt.drag.on) return;
  var el = document.getElementById(_evtSt.drag.id); if (!el) return;
  var cv = document.getElementById('evtCanvas');
  var tm = window.getComputedStyle(cv).transform;
  var scale = 1;
  if (tm && tm !== 'none') { var m = tm.match(/matrix\(([^,]+)/); if (m) scale = parseFloat(m[1]) || 1; }
  var dx = (e.clientX - _evtSt.drag.sx) / scale;
  var dy = (e.clientY - _evtSt.drag.sy) / scale;
  var nx = _evtSt.drag.sl + dx;
  var ny = _evtSt.drag.st + dy;
  // Soft clamp
  nx = Math.max(-20, Math.min(cv.offsetWidth  - 20, nx));
  ny = Math.max(-20, Math.min(cv.offsetHeight - 20, ny));
  el.style.left = nx+'px'; el.style.top = ny+'px'; el.style.transform = '';
}

function evtCanvasUp() { _evtSt.drag.on = false; }

// ── Toolbar ─────────────────────────────────────────────────────────────────
function evtTbToggle(prop) {
  if (prop === 'bold') {
    _evtSt.bold = !_evtSt.bold;
    document.getElementById('evtTbBold').classList.toggle('active', _evtSt.bold);
  } else {
    _evtSt.shadow = !_evtSt.shadow;
    document.getElementById('evtTbShadow').classList.toggle('active', _evtSt.shadow);
  }
  evtTbApply();
}

function evtTbApply() {
  _evtSt.size = parseInt(document.getElementById('evtTbSize').value) || 26;
  _evtSt.font = document.getElementById('evtTbFont').value;
  if (!_evtSt.selId) return;
  var el = document.getElementById(_evtSt.selId);
  if (!el || el.getAttribute('data-t') !== 'text') return;
  el.style.fontSize   = _evtSt.size+'px';
  el.style.fontWeight = _evtSt.bold ? '800' : '400';
  el.style.fontFamily = _evtSt.font;
  el.style.color      = _evtSt.color;
  el.style.textShadow = _evtSt.shadow ? '0 2px 10px rgba(0,0,0,.7),0 0 20px rgba(0,0,0,.3)' : 'none';
}

function evtSetColor(dotEl) {
  _evtSt.color = dotEl.getAttribute('data-clr');
  document.querySelectorAll('.evt-clr-dot').forEach(function(d){ d.style.boxShadow=''; });
  dotEl.style.boxShadow = '0 0 0 2px #1e293b, 0 0 0 4px '+_evtSt.color;
  evtTbApply();
}

// ── Clear / Download / Send ──────────────────────────────────────────────────
function evtClear() {
  document.querySelectorAll('#evtCanvas .evt-el').forEach(function(el){ el.remove(); });
  evtSelect(null);
}

function evtDownload() {
  if (typeof html2canvas === 'undefined') { showToast('html2canvas no cargado','error'); return; }
  evtSelect(null);
  html2canvas(document.getElementById('evtCanvas'), { scale:2.5, useCORS:true, logging:false }).then(function(c){
    var a = document.createElement('a'); a.download='tarjeta-evento.png';
    a.href = c.toDataURL('image/png'); a.click();
    showToast('Tarjeta descargada','success');
  });
}

async function evtSendEmail() {
  var subject  = (document.getElementById('evtSubject')||{}).value || '';
  var recText  = (document.getElementById('evtRecipients2')||{}).value || '';
  var extraMsg = (document.getElementById('evtExtraMsg')||{}).value || '';
  var recipients = recText.split(/[\n,]/).map(function(s){return s.trim();}).filter(function(s){return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s);});
  if (!recipients.length) { showToast('Ingresa al menos un correo válido','warn'); return; }
  if (!subject) { showToast('Escribe un asunto para el correo','warn'); return; }
  if (typeof html2canvas === 'undefined') { showToast('html2canvas no cargado','error'); return; }

  var btns = [document.getElementById('evtSendBtn'), document.getElementById('evtSendBtn2')];
  btns.forEach(function(b){ if(b){b.style.opacity='.5';b.style.pointerEvents='none';} });
  var statusEl = document.getElementById('evtStatus');
  statusEl.style.display='none';

  try {
    evtSelect(null);
    var c = await html2canvas(document.getElementById('evtCanvas'), { scale:2.5, useCORS:true, logging:false });
    var imageBase64 = c.toDataURL('image/png').split(',')[1];

    var resp = await fetch('/api/events/send-invite', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ subject, recipients, extraMsg, imageBase64 })
    });
    var data = await resp.json();
    if (data.success) {
      showToast('¡Enviado a '+recipients.length+' destinatario(s)!','success');
      statusEl.style.display='block';
      statusEl.innerHTML = '<div style="background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:10px;padding:12px 14px;font-size:12px;color:#065f46;display:flex;align-items:flex-start;gap:8px;">' +
        '<i class="bi bi-check-circle-fill" style="color:#10b981;font-size:15px;margin-top:1px;flex-shrink:0;"></i>' +
        '<div><strong>¡Enviado!</strong><br>A: '+recipients.join(', ')+'</div></div>';
    } else {
      showToast(data.error||'Error al enviar','error');
    }
  } catch(err) {
    showToast('Error: '+err.message,'error');
  } finally {
    btns.forEach(function(b){ if(b){b.style.opacity='1';b.style.pointerEvents='';} });
  }
}

evtInit();
</script>

