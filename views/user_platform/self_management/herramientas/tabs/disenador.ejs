<!-- ─── WHEEL SPINNER JS ──────────────────────────────────────────────────────── -->
<script>
var _wheel = {
  angle: 0, spinning: false,
  targetAngle: 0, startAngle: 0,
  startTime: null, duration: 4000,
  winner: -1, history: []
};
var _WHEEL_COLORS = [
  '#3b82f6','#10b981','#f59e0b','#ef4444','#8b5cf6',
  '#ec4899','#14b8a6','#f97316','#0ea5e9','#84cc16',
  '#a855f7','#06b6d4','#f43f5e','#22c55e','#eab308'
];

function wheelGetNames() {
  var ta = document.getElementById('wheelNames');
  if (!ta) return [];
  return ta.value.split('\n').map(function(s){return s.trim();}).filter(Boolean);
}

function wheelDraw() {
  var canvas = document.getElementById('wheelCanvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var W = canvas.width, H = canvas.height;
  var cx = W/2, cy = H/2, r = Math.min(cx,cy) - 8;
  ctx.clearRect(0,0,W,H);
  var names = wheelGetNames();
  if (!names.length) {
    ctx.beginPath(); ctx.arc(cx,cy,r,0,2*Math.PI);
    ctx.fillStyle = '#e2e8f0'; ctx.fill();
    ctx.fillStyle = '#94a3b8'; ctx.font = '14px DM Sans,sans-serif';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('Añade nombres arriba', cx, cy);
    return;
  }
  var n = names.length;
  var segSize = 2 * Math.PI / n;
  ctx.save(); ctx.translate(cx, cy); ctx.rotate(_wheel.angle);
  for (var i = 0; i < n; i++) {
    var sA = i * segSize, eA = sA + segSize;
    ctx.beginPath(); ctx.moveTo(0,0); ctx.arc(0,0,r,sA,eA); ctx.closePath();
    ctx.fillStyle = _WHEEL_COLORS[i % _WHEEL_COLORS.length]; ctx.fill();
    ctx.strokeStyle = '#fff'; ctx.lineWidth = 2.5; ctx.stroke();
    ctx.save(); ctx.rotate(sA + segSize/2);
    ctx.textAlign = 'right'; ctx.fillStyle = '#fff';
    var fs = Math.max(9, Math.min(14, 180/n));
    ctx.font = 'bold ' + fs + 'px DM Sans,sans-serif';
    ctx.shadowColor = 'rgba(0,0,0,.5)'; ctx.shadowBlur = 3;
    var label = names[i].length > 15 ? names[i].substring(0,13)+'…' : names[i];
    ctx.fillText(label, r - 10, 4.5);
    ctx.restore();
  }
  // Center hub
  ctx.beginPath(); ctx.arc(0,0,20,0,2*Math.PI);
  ctx.fillStyle = '#1e293b'; ctx.fill();
  ctx.strokeStyle = '#fff'; ctx.lineWidth = 3; ctx.stroke();
  ctx.restore();
}

function wheelSpin() {
  if (_wheel.spinning) return;
  var names = wheelGetNames();
  if (names.length < 2) { showToast('Añade al menos 2 participantes', 'warn'); return; }
  _wheel.winner = Math.floor(Math.random() * names.length);
  var segSize = 2 * Math.PI / names.length;
  var baseTarget = -((_wheel.winner + 0.5) * segSize);
  var minRot = 6 * 2 * Math.PI;
  var k = Math.ceil((_wheel.angle + minRot - baseTarget) / (2 * Math.PI));
  _wheel.targetAngle = baseTarget + k * 2 * Math.PI;
  _wheel.startAngle = _wheel.angle;
  _wheel.startTime = null;
  _wheel.spinning = true;
  _wheel.duration = 3800 + Math.random() * 1500;
  document.getElementById('wheelSpinBtn').disabled = true;
  document.getElementById('wheelWinner').style.display = 'none';
  requestAnimationFrame(wheelAnimate);
}

function wheelAnimate(ts) {
  if (_wheel.startTime === null) _wheel.startTime = ts;
  var t = Math.min((ts - _wheel.startTime) / _wheel.duration, 1);
  var ease = 1 - Math.pow(1 - t, 4);
  _wheel.angle = _wheel.startAngle + (_wheel.targetAngle - _wheel.startAngle) * ease;
  wheelDraw();
  if (t < 1) { requestAnimationFrame(wheelAnimate); return; }
  _wheel.angle = _wheel.targetAngle;
  _wheel.spinning = false;
  wheelDraw();
  document.getElementById('wheelSpinBtn').disabled = false;
  var names = wheelGetNames();
  var winnerName = names[_wheel.winner] || '—';
  document.getElementById('wheelWinnerName').textContent = winnerName;
  var wb = document.getElementById('wheelWinner');
  wb.style.display = 'block';
  wb.className = 'wheel-winner-banner';
  _wheel.history.unshift({ name: winnerName, time: new Date().toLocaleTimeString('es-PE') });
  wheelRenderHistory();
  showToast('¡' + winnerName + ' fue seleccionado/a!', 'success');
}

function wheelRenderHistory() {
  var el = document.getElementById('wheelHistory');
  if (!el || !_wheel.history.length) return;
  el.innerHTML = '<div style="font-size:10px;font-weight:800;text-transform:uppercase;color:var(--muted);letter-spacing:.5px;margin-bottom:3px;">Historial</div>' +
    _wheel.history.slice(0,6).map(function(h,i){
      return '<div style="display:flex;justify-content:space-between;background:var(--hover);border-radius:6px;padding:5px 10px;font-size:11px;">' +
        '<span style="font-weight:700;color:var(--text);">#'+(i+1)+' '+h.name+'</span>' +
        '<span style="color:var(--muted);">'+h.time+'</span></div>';
    }).join('');
}

function wheelReset() {
  _wheel.history = []; _wheel.angle = 0;
  document.getElementById('wheelWinner').style.display = 'none';
  var el = document.getElementById('wheelHistory');
  if (el) el.innerHTML = '';
  wheelDraw();
}

wheelDraw();
</script>

