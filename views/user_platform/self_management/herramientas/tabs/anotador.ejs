<!-- ─── TAB 13: ANOTADOR DE DOCUMENTOS ───────────────────────────────────────── -->
<div class="section-tab" id="toolTab13">
  <div id="annoUploadPanel" class="card-ui">
    <div class="card-head">
      <span class="title"><i class="bi bi-pencil-square" style="color:#f59e0b;"></i> Anotador de Documentos</span>
      <span style="font-size:11px;color:var(--muted);margin-left:8px;">Sube un PDF o PPTX, anota sobre él y descarga la versión editada</span>
    </div>
    <div style="padding:40px 24px;display:flex;flex-direction:column;align-items:center;gap:16px;">
      <div id="annoDropZone" class="anno-drop" ondragover="event.preventDefault();this.classList.add('drag-over')" ondragleave="this.classList.remove('drag-over')" ondrop="annoOnDrop(event)" style="position:relative;">
        <i class="bi bi-cloud-upload-fill" style="font-size:40px;color:#f59e0b;"></i>
        <div style="font-size:16px;font-weight:700;color:var(--text);">Arrastra tu PDF o PPTX aquí</div>
        <div style="font-size:12px;color:var(--muted);">o haz clic para seleccionar</div>
        <div style="display:flex;gap:8px;margin-top:6px;">
          <span style="background:rgba(245,158,11,.12);color:#f59e0b;border:1px solid rgba(245,158,11,.3);border-radius:6px;padding:2px 10px;font-size:11px;font-weight:700;">PDF</span>
          <span style="background:rgba(245,158,11,.12);color:#f59e0b;border:1px solid rgba(245,158,11,.3);border-radius:6px;padding:2px 10px;font-size:11px;font-weight:700;">PPTX</span>
        </div>
        <input type="file" id="annoFileInput" accept=".pdf,.pptx" style="position:absolute;inset:0;opacity:0;cursor:pointer;" onchange="annoLoadFile(this.files[0])">
      </div>
      <div id="annoLoadingBar" style="display:none;gap:10px;align-items:center;text-align:center;color:var(--muted);font-size:13px;">
        <div class="anno-spinner"></div> Procesando archivo…
      </div>
    </div>
  </div>

  <div id="annoEditorPanel" style="display:none;">
    <div class="card-ui" style="margin-bottom:8px;">
      <div class="card-head" style="flex-wrap:wrap;gap:5px;">
        <span class="title"><i class="bi bi-pencil-square" style="color:#f59e0b;"></i> <span id="annoDocName">documento</span></span>
        <!-- Navegación de páginas -->
        <div style="display:flex;gap:5px;align-items:center;margin-left:8px;">
          <button class="btn-sm btn-outline" onclick="annoChangePage(-1)"><i class="bi bi-chevron-left"></i></button>
          <span style="font-size:12px;font-weight:700;color:var(--text);white-space:nowrap;">Pág <span id="annoCurPage">1</span> / <span id="annoTotalPages">1</span></span>
          <button class="btn-sm btn-outline" onclick="annoChangePage(1)"><i class="bi bi-chevron-right"></i></button>
        </div>
        <!-- Herramientas -->
        <div style="display:flex;gap:3px;align-items:center;flex-wrap:wrap;margin-left:auto;">
          <button class="anno-tool active" id="annoT-pen"       onclick="annoSetTool('pen')"       title="Lápiz libre"><i class="bi bi-pencil-fill"></i></button>
          <button class="anno-tool"        id="annoT-highlight" onclick="annoSetTool('highlight')"  title="Resaltador"><i class="bi bi-highlighter"></i></button>
          <button class="anno-tool"        id="annoT-circle"    onclick="annoSetTool('circle')"    title="Círculo/Encerrar"><i class="bi bi-circle"></i></button>
          <button class="anno-tool"        id="annoT-rect"      onclick="annoSetTool('rect')"      title="Rectángulo"><i class="bi bi-square"></i></button>
          <button class="anno-tool"        id="annoT-arrow"     onclick="annoSetTool('arrow')"     title="Flecha"><i class="bi bi-arrow-up-right"></i></button>
          <button class="anno-tool"        id="annoT-text"      onclick="annoSetTool('text')"      title="Agregar texto"><i class="bi bi-fonts"></i></button>
          <button class="anno-tool"        id="annoT-eraser"    onclick="annoSetTool('eraser')"    title="Borrador"><i class="bi bi-eraser-fill"></i></button>
          <div style="width:1px;height:20px;background:var(--border);margin:0 2px;flex-shrink:0;"></div>
          <!-- Colores -->
          <% ['#ef4444','#f59e0b','#22c55e','#3b82f6','#8b5cf6','#000000','#ffffff'].forEach(function(c){ %>
          <div class="anno-clr" data-color="<%=c%>" style="background:<%=c%>;<%= c==='#ef4444'?'box-shadow:0 0 0 2px var(--text),0 0 0 3px transparent;':'' %>" onclick="annoSetColor(this)" title="<%=c%>"></div>
          <% }); %>
          <div style="width:1px;height:20px;background:var(--border);margin:0 2px;flex-shrink:0;"></div>
          <!-- Grosor -->
          <select class="anno-wsel" onchange="_annoWidth=+this.value" title="Grosor del trazo">
            <option value="2">Fino</option>
            <option value="4" selected>Normal</option>
            <option value="7">Grueso</option>
            <option value="12">Muy grueso</option>
          </select>
          <div style="width:1px;height:20px;background:var(--border);margin:0 2px;flex-shrink:0;"></div>
          <button class="btn-sm btn-outline" onclick="annoUndo()" title="Deshacer"><i class="bi bi-arrow-counterclockwise"></i></button>
          <button class="btn-sm btn-outline" onclick="annoClearPage()" title="Limpiar anotaciones de esta página"><i class="bi bi-trash"></i></button>
          <button class="btn-sm btn-outline" onclick="annoNewDoc()" title="Cargar otro documento"><i class="bi bi-folder2-open"></i></button>
          <button class="btn-sm" style="background:#f59e0b;color:#fff;border:none;" onclick="annoDownload()"><i class="bi bi-download"></i> Descargar</button>
        </div>
      </div>
    </div>
    <!-- Canvas -->
    <div id="annoCanvasWrap" style="overflow:auto;background:var(--hdr);border-radius:14px;padding:16px;display:flex;justify-content:center;align-items:flex-start;min-height:400px;max-height:68vh;">
      <div style="position:relative;display:inline-block;box-shadow:0 6px 32px rgba(0,0,0,.25);">
        <canvas id="annoBase" style="display:block;"></canvas>
        <canvas id="annoLayer" style="position:absolute;top:0;left:0;cursor:crosshair;touch-action:none;"
          onmousedown="annoDown(event)"
          onmousemove="annoMove(event)"
          onmouseup="annoUp(event)"
          onmouseleave="annoUp()"
          ontouchstart="event.preventDefault();annoDown(event.touches[0])"
          ontouchmove="event.preventDefault();annoMove(event.touches[0])"
          ontouchend="annoUp()"></canvas>
      </div>
    </div>
  </div>
</div>

<!-- Panel flotante de texto (position:fixed, fuera del canvas) -->
<div id="annoTextBox" style="position:fixed;display:none;z-index:9999;background:var(--card);border:2px solid #f59e0b;border-radius:10px;padding:12px;box-shadow:0 8px 32px rgba(0,0,0,.25);min-width:240px;">
  <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:6px;"><i class="bi bi-fonts"></i> Texto a insertar</div>
  <textarea id="annoTextArea" rows="3"
    style="width:100%;border:1.5px solid var(--border);border-radius:6px;padding:6px 8px;font-size:15px;resize:vertical;outline:none;background:var(--bg);color:var(--text);font-family:inherit;box-sizing:border-box;"
    placeholder="Escribe aquí…"
    onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();annoTextConfirm();}if(event.key==='Escape')annoTextCancel();"></textarea>
  <div style="display:flex;gap:6px;margin-top:8px;justify-content:flex-end;align-items:center;">
    <select id="annoTextSize" style="font-size:11px;border:1.5px solid var(--border);border-radius:6px;padding:3px 6px;background:var(--bg);color:var(--text);">
      <option value="14">Pequeño</option>
      <option value="18" selected>Normal</option>
      <option value="24">Grande</option>
      <option value="32">Muy grande</option>
    </select>
    <button onclick="annoTextCancel()" style="padding:5px 12px;border:1.5px solid var(--border);border-radius:6px;cursor:pointer;font-size:12px;background:var(--bg);color:var(--text);">Cancelar</button>
    <button onclick="annoTextConfirm()" style="padding:5px 14px;background:#f59e0b;color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:12px;font-weight:700;">Insertar</button>
  </div>
</div>

<!-- ─── ESTILOS: Notas + Anotador ────────────────────────────────────────────── -->
<style>
/* ── Notas ──────────────────────────────────── */
.nfmt{padding:3px 7px;border:1.5px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text);cursor:pointer;font-size:12px;transition:all .15s;line-height:1.4;}
.nfmt:hover{border-color:#6366f1;color:#6366f1;}
.nfmt-sep{width:1px;height:16px;background:var(--border);margin:0 2px;flex-shrink:0;}
.note-item{padding:8px 10px;border-radius:8px;cursor:pointer;transition:background .15s;border:1.5px solid transparent;}
.note-item:hover{background:var(--hover);}
.note-item.active{background:rgba(99,102,241,.1);border-color:rgba(99,102,241,.3);}
.note-item-title{font-size:12px;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.note-item-date{font-size:10px;color:var(--muted);margin-top:2px;}
#noteEditor[contenteditable]:empty:before{content:"Empieza a escribir…";color:var(--muted);pointer-events:none;}
#noteEditor h2{font-size:20px;font-weight:800;margin:12px 0 6px;}
#noteEditor h3{font-size:16px;font-weight:700;margin:10px 0 4px;}
/* ── Anotador ───────────────────────────────── */
.anno-drop{display:flex;flex-direction:column;align-items:center;gap:10px;padding:40px 60px;border:2.5px dashed var(--border);border-radius:16px;cursor:pointer;transition:all .2s;background:var(--bg);}
.anno-drop:hover,.anno-drop.drag-over{border-color:#f59e0b;background:rgba(245,158,11,.05);}
.anno-tool{width:32px;height:32px;border-radius:7px;border:1.5px solid var(--border);background:var(--bg);color:var(--text);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;transition:all .15s;}
.anno-tool:hover{border-color:#f59e0b;color:#f59e0b;}
.anno-tool.active{background:#f59e0b;border-color:#f59e0b;color:#fff;}
.anno-clr{width:18px;height:18px;border-radius:50%;cursor:pointer;border:2px solid transparent;transition:transform .15s;flex-shrink:0;}
.anno-clr:hover,.anno-clr.sel{transform:scale(1.3);box-shadow:0 0 0 2px var(--text);}
