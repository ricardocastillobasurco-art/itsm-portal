@keyframes annoSpin{to{transform:rotate(360deg)}}
</style>

<!-- ─── JS: Notas ─────────────────────────────────────────────────────────────── -->
<script>
var _notesData = JSON.parse(localStorage.getItem('ht_notes_v1') || '[]');
var _activeNoteId = null;
var _notesSaveTimer = null;

function notesInit() {
  if (!_notesData.length) notesNew();
  else { notesRenderList(); notesSelect(_notesData[0].id); }
  _notesInited = true;
}

function notesNew() {
  const note = { id: 'n'+Date.now(), title: 'Nueva nota', content: '', updatedAt: new Date().toISOString() };
  _notesData.unshift(note);
  notesPersist();
  notesRenderList();
  notesSelect(note.id);
  setTimeout(() => { const t = document.getElementById('noteTitleInput'); if(t){t.select();} }, 50);
}

function notesSelect(id) {
  _activeNoteId = id;
  const note = _notesData.find(n => n.id === id);
  if (!note) return;
  document.getElementById('noteTitleInput').value = note.title;
  document.getElementById('noteEditor').innerHTML = note.content;
  notesRenderList();
}

function notesAutoSave() {
  clearTimeout(_notesSaveTimer);
  _notesSaveTimer = setTimeout(() => {
    const note = _notesData.find(n => n.id === _activeNoteId);
    if (!note) return;
    note.title = document.getElementById('noteTitleInput').value.trim() || 'Sin título';
    note.content = document.getElementById('noteEditor').innerHTML;
    note.updatedAt = new Date().toISOString();
    notesPersist();
    notesRenderList();
    document.getElementById('notesSavedLabel').textContent = 'Guardado ' + new Date().toLocaleTimeString('es-PE',{hour:'2-digit',minute:'2-digit'});
  }, 600);
}

function notesDelete() {
  if (!_activeNoteId || !confirm('¿Eliminar esta nota?')) return;
  _notesData = _notesData.filter(n => n.id !== _activeNoteId);
  _activeNoteId = null;
  notesPersist();
  notesRenderList();
  document.getElementById('noteTitleInput').value = '';
  document.getElementById('noteEditor').innerHTML = '';
  if (_notesData.length) notesSelect(_notesData[0].id);
}

function notesRenderList() {
  const q = (document.getElementById('notesSearch')?.value || '').toLowerCase();
  const list = document.getElementById('notesList');
  if (!list) return;
  const filtered = _notesData.filter(n => !q || n.title.toLowerCase().includes(q) || (n.content||'').toLowerCase().includes(q));
  if (!filtered.length) { list.innerHTML = '<div style="font-size:11px;color:var(--muted);padding:8px 10px;">Sin notas.</div>'; return; }
  list.innerHTML = filtered.map(n => `
    <div class="note-item ${n.id===_activeNoteId?'active':''}" onclick="notesSelect('${n.id}')">
      <div class="note-item-title">${n.title||'Sin título'}</div>
      <div class="note-item-date">${n.updatedAt?new Date(n.updatedAt).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}):''}</div>
    </div>`).join('');
}

function notesFmt(cmd, val) {
  document.getElementById('noteEditor').focus();
  document.execCommand(cmd, false, val || null);
}

function notesPersist() {
  localStorage.setItem('ht_notes_v1', JSON.stringify(_notesData));
}

function notesDownloadPNG() {
  if (typeof html2canvas === 'undefined') { showToast('html2canvas no cargado aún.','error'); return; }
  const el = document.getElementById('noteEditorWrap');
  html2canvas(el, { scale: 2, useCORS: true }).then(canvas => {
    const a = document.createElement('a');
    a.download = (document.getElementById('noteTitleInput').value || 'nota') + '.png';
    a.href = canvas.toDataURL('image/png');
    a.click();
  });
}

function notesDownloadTXT() {
  const title = document.getElementById('noteTitleInput').value || 'nota';
  const text = document.getElementById('noteEditor').innerText;
  const a = document.createElement('a');
  a.download = title + '.txt';
  a.href = 'data:text/plain;charset=utf-8,' + encodeURIComponent(title + '\n\n' + text);
  a.click();
}
</script>

<!-- ─── JS: Anotador ─────────────────────────────────────────────────────────── -->
<script>
var _annoPdfDoc   = null;
var _annoPageNum  = 1;
var _annoPageCount= 1;
var _annoSlides   = [];
var _annoType     = null;
var _annoTool     = 'pen';
var _annoColor    = '#ef4444';
var _annoWidth    = 4;
var _annoDrawing  = false;
var _annoStart    = null;
var _annoPreviewSnap = null;
var _annoUndoStack   = [];
var _annoUndoStacks  = {};
var _annoAnnotations = {};
var _annoCtx      = null;

function annoInit() { /* eventos definidos inline en el canvas */ }

function annoGetPos(e) {
  const r = document.getElementById('annoLayer').getBoundingClientRect();
  return { x: (e.clientX||e.pageX) - r.left, y: (e.clientY||e.pageY) - r.top };
}

function _ac() {
  const layer = document.getElementById('annoLayer');
  if (!layer || !layer.width || !layer.height) return null;
  _annoCtx = layer.getContext('2d');
  return _annoCtx;
}

function annoDown(e) {
  const ctx = _ac(); if (!ctx) return;
  const pos = annoGetPos(e);
  if (_annoTool === 'text') { annoPlaceText(pos); return; }
  const layer = document.getElementById('annoLayer');
  try { _annoUndoStack.push(layer.toDataURL()); } catch(_) {}
  if (_annoUndoStack.length > 30) _annoUndoStack.shift();
  _annoUndoStacks[_annoPageNum] = _annoUndoStack.slice();
  _annoDrawing = true;
  _annoStart   = pos;
  if (_annoTool === 'pen' || _annoTool === 'eraser') {
    ctx.beginPath(); ctx.moveTo(pos.x, pos.y);
  }
  if (['circle','rect','arrow','highlight'].includes(_annoTool)) {
    try { _annoPreviewSnap = ctx.getImageData(0, 0, layer.width, layer.height); } catch(_) {}
  }
}

function annoMove(e) {
  if (!_annoDrawing) return;
  const ctx = _ac(); if (!ctx) return;
  const pos = annoGetPos(e);
  ctx.lineWidth   = _annoWidth;
  ctx.strokeStyle = _annoColor;
  ctx.lineCap     = 'round';
  ctx.lineJoin    = 'round';
  if (_annoTool === 'pen') {
    ctx.globalAlpha = 1;
    ctx.globalCompositeOperation = 'source-over';
    ctx.lineTo(pos.x, pos.y); ctx.stroke();
  } else if (_annoTool === 'eraser') {
    ctx.globalCompositeOperation = 'destination-out';
    ctx.lineWidth = _annoWidth * 5;
    ctx.lineTo(pos.x, pos.y); ctx.stroke();
    ctx.globalCompositeOperation = 'source-over';
  } else if (['circle','rect','arrow','highlight'].includes(_annoTool)) {
    if (_annoPreviewSnap) ctx.putImageData(_annoPreviewSnap, 0, 0);
    annoDrawShape(_annoTool, _annoStart, pos);
  }
}

function annoUp(e) {
  if (!_annoDrawing) return;
  _annoDrawing = false;
  const ctx = _ac(); if (!ctx) return;
  if (_annoTool === 'pen' || _annoTool === 'eraser') { ctx.closePath(); }
  ctx.globalCompositeOperation = 'source-over';
  ctx.globalAlpha = 1;
}

function annoDrawShape(tool, s, e) {
  const ctx = _ac(); if (!ctx) return;
  ctx.strokeStyle = _annoColor;
  ctx.lineWidth   = _annoWidth;
  ctx.lineCap     = 'round';
  ctx.globalCompositeOperation = 'source-over';
  if (tool === 'circle') {
    ctx.globalAlpha = 1;
    const rx = (e.x-s.x)/2, ry = (e.y-s.y)/2;
    ctx.beginPath();
    ctx.ellipse(s.x+rx, s.y+ry, Math.abs(rx)||1, Math.abs(ry)||1, 0, 0, Math.PI*2);
    ctx.stroke();
  } else if (tool === 'rect') {
    ctx.globalAlpha = 1;
    ctx.beginPath();
    ctx.strokeRect(s.x, s.y, e.x-s.x, e.y-s.y);
  } else if (tool === 'highlight') {
    ctx.globalAlpha = 0.35;
    ctx.fillStyle = _annoColor;
    ctx.fillRect(s.x, s.y, e.x-s.x, e.y-s.y);
    ctx.globalAlpha = 1;
  } else if (tool === 'arrow') {
    ctx.globalAlpha = 1;
    ctx.beginPath(); ctx.moveTo(s.x,s.y); ctx.lineTo(e.x,e.y); ctx.stroke();
    const angle = Math.atan2(e.y-s.y, e.x-s.x);
    const hl = Math.max(14, _annoWidth*4);
    ctx.beginPath();
    ctx.moveTo(e.x, e.y);
    ctx.lineTo(e.x - hl*Math.cos(angle-Math.PI/6), e.y - hl*Math.sin(angle-Math.PI/6));
    ctx.moveTo(e.x, e.y);
    ctx.lineTo(e.x - hl*Math.cos(angle+Math.PI/6), e.y - hl*Math.sin(angle+Math.PI/6));
    ctx.stroke();
  }
}

var _annoTextPos = null;

function annoPlaceText(pos) {
  _annoTextPos = pos;
  const box = document.getElementById('annoTextBox');
  const ta  = document.getElementById('annoTextArea');

  // Posición: cerca del click pero dentro del viewport
  const layer = document.getElementById('annoLayer');
  const rect  = layer.getBoundingClientRect();
  let bx = rect.left + pos.x + 10;
  let by = rect.top  + pos.y + 10;
  if (bx + 260 > window.innerWidth)  bx = Math.max(8, rect.left + pos.x - 270);
  if (by + 180 > window.innerHeight) by = Math.max(8, rect.top  + pos.y - 185);

  box.style.left    = bx + 'px';
  box.style.top     = by + 'px';
  box.style.display = 'block';
  ta.value = '';
  ta.style.color = _annoColor;
  setTimeout(() => ta.focus(), 30);
}

function annoTextConfirm() {
  const ta   = document.getElementById('annoTextArea');
  const text = ta.value.trim();
  if (text && _annoTextPos) {
    const layer = document.getElementById('annoLayer');
    try { _annoUndoStack.push(layer.toDataURL()); } catch(_) {}
    const ctx  = _ac();
    const size = parseInt(document.getElementById('annoTextSize').value) || 18;
    if (ctx) {
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = _annoColor;
      ctx.font = `bold ${size}px sans-serif`;
      const lineH = size * 1.35;
      text.split('\n').forEach((line, i) => {
        ctx.fillText(line, _annoTextPos.x, _annoTextPos.y + size + i * lineH);
      });
    }
  }
  document.getElementById('annoTextBox').style.display = 'none';
  _annoTextPos = null;
}

function annoTextCancel() {
  document.getElementById('annoTextBox').style.display = 'none';
  _annoTextPos = null;
}

function annoSetTool(t) {
  _annoTool = t;
  document.querySelectorAll('.anno-tool').forEach(b => b.classList.toggle('active', b.id==='annoT-'+t));
  document.getElementById('annoLayer').style.cursor = t==='eraser' ? 'cell' : t==='text' ? 'text' : 'crosshair';
}

function annoSetColor(el) {
  _annoColor = el.dataset.color;
  document.querySelectorAll('.anno-clr').forEach(c => c.classList.remove('sel'));
  el.classList.add('sel');
}

function annoUndo() {
  if (!_annoUndoStack.length) return;
  const prev = _annoUndoStack.pop();
  _annoUndoStacks[_annoPageNum] = _annoUndoStack.slice();
  const layer = document.getElementById('annoLayer');
  const ctx = _ac(); if (!ctx) return;
  ctx.clearRect(0, 0, layer.width, layer.height);
  if (prev) { const img = new Image(); img.onload = () => ctx.drawImage(img,0,0); img.src = prev; }
}

function annoClearPage() {
  if (!confirm('¿Limpiar todas las anotaciones de esta página?')) return;
  const layer = document.getElementById('annoLayer');
  const ctx = _ac(); if (!ctx) return;
  try { _annoUndoStack.push(layer.toDataURL()); } catch(_) {}
  ctx.clearRect(0, 0, layer.width, layer.height);
  delete _annoAnnotations[_annoPageNum];
}

async function annoChangePage(delta) {
  const next = _annoPageNum + delta;
  if (next < 1 || next > _annoPageCount) return;
  // Guardar anotaciones actuales
  _annoAnnotations[_annoPageNum] = document.getElementById('annoLayer').toDataURL();
  _annoUndoStacks[_annoPageNum]  = _annoUndoStack.slice();
  await annoRenderPage(next);
}

async function annoRenderPage(n) {
  _annoPageNum = n;
  document.getElementById('annoCurPage').textContent = n;
  const base = document.getElementById('annoBase');
  const layer = document.getElementById('annoLayer');
  const bCtx  = base.getContext('2d');

  if (_annoType === 'pdf' && _annoPdfDoc) {
    const page     = await _annoPdfDoc.getPage(n);
    const wrapW = document.getElementById('annoCanvasWrap').clientWidth - 48;
    const baseVp = page.getViewport({ scale: 1 });
    const scale  = Math.min(1.5, Math.max(0.8, wrapW / baseVp.width));
    const viewport = page.getViewport({ scale });
    base.width  = layer.width  = viewport.width;
    base.height = layer.height = viewport.height;
    await page.render({ canvasContext: bCtx, viewport }).promise;
  } else if (_annoType === 'pptx') {
    await new Promise(res => {
      const img = new Image();
      img.onload = () => {
        base.width  = layer.width  = img.width;
        base.height = layer.height = img.height;
        bCtx.drawImage(img, 0, 0);
        res();
      };
      img.src = _annoSlides[n-1];
    });
  }

  _annoCtx = layer.getContext('2d');
  _annoCtx.clearRect(0, 0, layer.width, layer.height);
  _annoUndoStack = (_annoUndoStacks[n] || []);
  if (_annoAnnotations[n]) {
    const img = new Image();
    img.onload = () => _annoCtx.drawImage(img, 0, 0);
    img.src = _annoAnnotations[n];
  }
}

async function annoLoadFile(file) {
  if (!file) return;
  const lb  = document.getElementById('annoLoadingBar');
  const dz  = document.getElementById('annoDropZone');
  lb.style.display = 'flex'; dz.style.opacity = '0.5';
  try {
    const fd = new FormData();
    fd.append('file', file);
    const resp = await fetch('/api/print-queue/render-slides', { method:'POST', body:fd });
    const data = await resp.json();
    if (!data.success) { showToast(data.error || 'Error al procesar.', 'error'); return; }

    _annoAnnotations = {}; _annoUndoStacks = {}; _annoUndoStack = [];
    document.getElementById('annoDocName').textContent = file.name;

    if (data.type === 'pdf') {
      _annoType = 'pdf';
      if (typeof pdfjsLib === 'undefined') { showToast('PDF.js no disponible.','error'); return; }
      const arr = new Uint8Array(atob(data.pdfBase64).split('').map(c => c.charCodeAt(0)));
      _annoPdfDoc    = await pdfjsLib.getDocument({ data: arr }).promise;
      _annoPageCount = _annoPdfDoc.numPages;
      _annoSlides    = [];
    } else {
      _annoType = 'pptx'; _annoPdfDoc = null;
      _annoSlides    = data.slides;
      _annoPageCount = data.slides.length;
    }

    document.getElementById('annoTotalPages').textContent = _annoPageCount;
    document.getElementById('annoUploadPanel').style.display = 'none';
    document.getElementById('annoEditorPanel').style.display = 'block';
    await annoRenderPage(1);
  } catch(err) {
    console.error(err);
    showToast('Error de conexión.', 'error');
  } finally {
    lb.style.display = 'none'; dz.style.opacity = '1';
    document.getElementById('annoFileInput').value = '';
  }
}


function annoOnDrop(e) {
  e.preventDefault();
  document.getElementById('annoDropZone').classList.remove('drag-over');
  const file = e.dataTransfer.files[0];
  if (file) annoLoadFile(file);
}

function annoNewDoc() {
  document.getElementById('annoEditorPanel').style.display = 'none';
  document.getElementById('annoUploadPanel').style.display = 'block';
  _annoPdfDoc = null; _annoSlides = []; _annoAnnotations = {}; _annoUndoStacks = {};
}

function annoDownload() {
  _annoAnnotations[_annoPageNum] = document.getElementById('annoLayer').toDataURL();
  const base  = document.getElementById('annoBase');
  const layer = document.getElementById('annoLayer');
  const out   = document.createElement('canvas');
  out.width   = base.width; out.height = base.height;
  const ctx   = out.getContext('2d');
  ctx.drawImage(base, 0, 0);
  ctx.drawImage(layer, 0, 0);
  const a = document.createElement('a');
  a.download = (document.getElementById('annoDocName').textContent||'anotacion').replace(/\.[^.]+$/,'') + '_pag' + _annoPageNum + '.png';
  a.href = out.toDataURL('image/png');
  a.click();
}
</script>

