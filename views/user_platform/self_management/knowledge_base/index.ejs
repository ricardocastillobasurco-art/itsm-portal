<!-- TOAST -->
<div id="toastCont" style="position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:8px;"></div>

<script>
// ── Datos del usuario desde servidor ──────────────────────────────────────────
const _user = <%- JSON.stringify({
  id:       user ? user.id : null,
  username: user ? (user.username || '') : '',
  full_name: user ? (user.full_name || user.nombre || user.username || '') : '',
  role:     user ? (user.role || user.rol || '') : '',
  email:    user ? (user.email || '') : ''
}) %>;
const _isAdmin = <%- JSON.stringify(user && ['administrador','especialista'].includes(user.role || user.rol || '')) %>;
// Portal autogestion identity passed from server via query params (same pattern as faq.ejs)
const _reporterEmail = <%- JSON.stringify(reporterEmail || '') %>;
const _reporterName  = <%- JSON.stringify(reporterName  || '') %>;

// ── Init avatar — prioriza identidad del portal autogestion (como faq.ejs) ────
(function(){
  // Priority: 1. server query params, 2. localStorage, 3. JWT user
  var name  = _reporterName  || localStorage.getItem('portal_user_name')  || '';
  var email = _reporterEmail || localStorage.getItem('portal_user_email') || '';
  if (!name) name = email || _user.full_name || _user.username || '?';
  // Persist to localStorage so chip stays consistent within session
  if (_reporterName)  localStorage.setItem('portal_user_name',  _reporterName);
  if (_reporterEmail) localStorage.setItem('portal_user_email', _reporterEmail);
  var parts = name.trim().split(/\s+/);
  var ini = parts.length >= 2 ? (parts[0][0]+parts[parts.length-1][0]).toUpperCase() : name.slice(0,2).toUpperCase();
  const _av = document.getElementById('userAvatar');
  const _nc = document.getElementById('userNameChip');
  if (_av) _av.textContent = ini;
  if (_nc) _nc.textContent = name;
})();

// ── Variables ─────────────────────────────────────────────────────────────────
let allCats = [], activeCatId = '', activeArticleId = '', searchTimer = null;
let _procFileB64 = '', _procFileName = '', _activeProcCat = '';

// ── Toast ──────────────────────────────────────────────────────────────────────
function toast(msg, type='info'){
  const el = document.createElement('div');
  el.style.cssText = `background:${type==='success'?'#059669':type==='error'?'#dc2626':'#1d4ed8'};color:#fff;padding:10px 16px;border-radius:10px;font-size:13px;font-weight:600;box-shadow:0 4px 12px rgba(0,0,0,.2);max-width:340px;`;
  el.textContent = msg;
  document.getElementById('toastCont').appendChild(el);
  setTimeout(()=>el.remove(), 3500);
}

// ── Tema ───────────────────────────────────────────────────────────────────────
function _syncThemeIcon(t){
  const lbl=document.getElementById('kbToggleLabel');
  if(lbl) lbl.textContent=t==='dark'?'Claro':'Oscuro';
  const dark=t==='dark';
  const icon=document.getElementById('toggleIcon'),label=document.getElementById('toggleLabel'),track=document.getElementById('themeTrack'),knob=document.getElementById('themeKnob');
  if(icon)icon.className=dark?'bi bi-sun-fill':'bi bi-moon-stars-fill';
  if(label)label.textContent=dark?'Claro':'Oscuro';
  if(track)track.style.background=dark?'#3b82f6':'#cbd5e1';
  if(knob)knob.style.transform=dark?'translateX(15px)':'translateX(0)';
}
function toggleTheme(){
  const h=document.documentElement, t=h.getAttribute('data-theme')==='dark'?'light':'dark';
  h.setAttribute('data-theme',t); localStorage.setItem('dashboardTheme',t); _syncThemeIcon(t);
}
document.addEventListener('DOMContentLoaded',function(){_syncThemeIcon(document.documentElement.getAttribute('data-theme')||'light');});

// ── Modales ───────────────────────────────────────────────────────────────────
function openModal(id){ document.getElementById(id).classList.add('open'); }
function closeModal(id){ document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(m => m.addEventListener('click',function(e){ if(e.target===this) closeModal(this.id); }));

// ── Tabs principales ──────────────────────────────────────────────────────────
// mapear IDs de tabs
const _tabSections = {articulos:'tabArticulos',procedimientos:'tabProcedimientos',learning:'tabLearning',aportes:'tabAportes',solicitudes:'tabSolicitudes'};
const _tabBtns = {articulos:'tabBtnArticulos',procedimientos:'tabBtnProc',learning:'tabBtnLearning',aportes:'tabBtnAportes',solicitudes:'tabBtnSolicitudes'};
function switchTab(tab){
  document.querySelectorAll('.section-tab').forEach(el=>el.classList.remove('active'));
  document.querySelectorAll('.kb-tab').forEach(el=>el.classList.remove('active'));
  const sec = _tabSections[tab]; if(sec) document.getElementById(sec)?.classList.add('active');
  const btn = _tabBtns[tab];    if(btn) document.getElementById(btn)?.classList.add('active');
  if(tab==='solicitudes')    loadProcRequests();
  if(tab==='procedimientos') loadProcedures(_activeProcCat);
  if(tab==='learning')       loadLearning(_activeLearnCat);
  if(tab==='aportes')        loadKbContribs();
}

// ── Esc ──────────────────────────────────────────────────────────────────────
function esc(t){ return String(t||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// ═══════════════ ARTÍCULOS ═══════════════════════════════════════════════════

async function init(){
  await Promise.all([loadCats(), loadArticles(), loadPopular()]);
  if(_isAdmin){ loadNoResults(); checkKbPendingBadge(); }
}

async function loadCats(){
  try {
    const d = await apiFetch('/api/kb/categories');
    allCats = d.data||[];
    const list = document.getElementById('catList');
    const sel  = document.getElementById('artCatId');
    if(sel) sel.innerHTML = '<option value="">Sin categoría</option>'+allCats.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join('');
    list.innerHTML = `<div class="cat-item ${!activeCatId?'active':''}" onclick="selectCat('')"><span class="cat-icon"><i class="bi bi-grid-3x3-gap"></i></span> Todos</div>`+
      allCats.map(c=>`<div class="cat-item ${activeCatId===c.id?'active':''}" onclick="selectCat('${c.id}')">
        <span class="cat-icon"><i class="bi bi-${esc(c.icon||'folder')}"></i></span>${esc(c.name)}
        <span style="margin-left:auto;font-size:11px;color:var(--muted);">${c.articulos?.length||0}</span></div>`).join('');
  } catch(e){ console.error(e); }
}

async function loadArticles(catId=''){
  activeCatId = catId;
  const params = new URLSearchParams({ status:'publicado', limit:50 });
  if(catId) params.set('categoryId',catId);
  try {
    const d    = await apiFetch(`/api/kb?${params}`);
    const rows = d.data||[];
    document.getElementById('artCount').textContent = `${rows.length} artículo${rows.length!==1?'s':''}`;
    const list = document.getElementById('artList');
    if(!rows.length){ list.innerHTML='<div class="empty-state"><i class="bi bi-inbox"></i> Sin artículos</div>'; return; }
    list.innerHTML = rows.map(a=>`<div class="art-item" onclick="openArticle('${a.id}')">
      <div class="art-title">${esc(a.title)}</div>
      <div class="art-excerpt">${esc(a.excerpt||'')}</div>
      <div class="art-meta">
        <span><i class="bi bi-eye"></i> ${a.views}</span>
        <span><i class="bi bi-hand-thumbs-up"></i> ${a.helpfulYes||0}</span>
        ${a.tags?`<span><i class="bi bi-tags"></i> ${esc(a.tags.split(',').slice(0,3).join(', '))}</span>`:''}
      </div></div>`).join('');
  } catch(e){ console.error(e); }
}

function selectCat(id){ loadCats().then(()=>{}); loadArticles(id); }

async function loadPopular(){
  try {
    const d    = await apiFetch('/api/kb/popular');
    const rows = d.data||[];
    const list = document.getElementById('popList');
    if(!rows.length){ list.innerHTML='<div class="empty-state">Sin datos</div>'; return; }
    list.innerHTML = rows.map((a,i)=>`<div class="pop-item" onclick="openArticle('${a.id}')">
      <div class="pop-rank">${i+1}</div>
      <div style="flex:1;font-size:13px;font-weight:600;">${esc(a.title)}</div>
      <span style="font-size:11px;color:var(--muted);">${a.views} vistas</span></div>`).join('');
  } catch(e){}
}

async function loadNoResults(){
  try {
    const d    = await apiFetch('/api/kb/no-results');
    const rows = d.data||[];
    const list = document.getElementById('noResultsList');
    if(!rows.length){ list.innerHTML='<div class="empty-state" style="padding:16px;">Sin búsquedas sin resultado</div>'; return; }
    list.innerHTML = rows.slice(0,8).map(r=>`<div class="no-res-item">
      <span>"${esc(r.query)}"</span>
      <span style="color:var(--danger);font-weight:700;">${r.searches}x</span></div>`).join('');
  } catch(e){}
}

async function openArticle(id){
  try {
    const d = await apiFetch(`/api/kb/${id}`);
    if(!d.success) return toast('Error cargando artículo','error');
    activeArticleId = id;
    const a = d.data;
    document.getElementById('articleTitle').textContent = a.title;
    document.getElementById('articleContent').innerHTML = a.content +
      (a.tags?`<div style="margin-top:16px;padding-top:16px;border-top:1px solid var(--border);">
        <strong>Tags:</strong> ${a.tags.split(',').map(t=>`<span style="background:var(--hover);padding:2px 8px;border-radius:12px;font-size:12px;margin-right:4px;">${esc(t.trim())}</span>`).join('')}</div>`:'');
    document.getElementById('articleView').classList.add('open');
    document.getElementById('mainTabs').style.display='none';
    document.querySelectorAll('.section-tab').forEach(el=>el.style.display='none');
    document.getElementById('searchResults').style.display='none';
  } catch(e){ toast('Error cargando artículo','error'); }
}

function closeArticle(){
  document.getElementById('articleView').classList.remove('open');
  document.getElementById('mainTabs').style.display='';
  document.querySelectorAll('.section-tab').forEach(el=>el.style.display='');
  // solo el tab activo queda visible
  document.querySelectorAll('.section-tab:not(.active)').forEach(el=>el.style.display='none');
  document.getElementById('tabArticulos').style.display='';
  activeArticleId='';
}

async function vote(v){
  if(!activeArticleId) return;
  await apiFetch(`/api/kb/${activeArticleId}/helpful`,{method:'POST',body:{vote:v}});
  toast(v==='yes'?'¡Gracias por tu feedback! 👍':'Gracias. Mejoraremos este artículo.','success');
}

// ─ Búsqueda ────────────────────────────────────────────────────────────────
function debounceSearch(){ clearTimeout(searchTimer); searchTimer=setTimeout(doSearch,400); }

async function doSearch(){
  const q = document.getElementById('searchInput').value.trim();
  const box = document.getElementById('searchResults');
  if(!q){ box.style.display='none'; return; }
  try {
    const d    = await apiFetch(`/api/kb/search?q=${encodeURIComponent(q)}`);
    const rows = d.data||[];
    box.style.display='block';
    if(!rows.length){
      box.innerHTML=`<div class="empty-state" style="padding:20px;">
        <i class="bi bi-search" style="font-size:24px;display:block;margin-bottom:8px;"></i>
        Sin resultados para <strong>"${esc(q)}"</strong>
        <div style="margin-top:12px;font-size:12px;">
          ${!_isAdmin ? `<button class="btn-sm btn-purple" onclick="document.getElementById('reqQuery').value='${esc(q)}';openModal('modalRequest')"><i class="bi bi-send"></i> Solicitar este procedimiento</button>` : ''}
        </div></div>`;
      return;
    }
    box.innerHTML=`<div style="padding:10px 18px;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;">${rows.length} resultado${rows.length!==1?'s':''} para "${esc(q)}"</div>`+
      rows.map(a=>`<div class="search-result-item" onclick="openArticle('${a.id}')">
        <div class="sr-title">${esc(a.title)}</div>
        <div class="sr-excerpt">${esc(a.excerpt||'')}</div></div>`).join('');
  } catch(e){}
}

async function crearArticulo(){
  const title=document.getElementById('artTitle').value.trim();
  const content=document.getElementById('artContent').value.trim();
  if(!title||!content){ toast('Título y contenido son requeridos','error'); return; }
  const d = await apiFetch('/api/kb',{method:'POST',body:{title,content,
    kbCategoryId:document.getElementById('artCatId').value||null,
    tags:document.getElementById('artTags').value,
    status:document.getElementById('artStatus').value}});
  if(!d.success){ toast(d.error||'Error','error'); return; }
  toast('Artículo creado','success');
  closeModal('modalArt');
  init();
}

// ═══════════════ PROCEDIMIENTOS ══════════════════════════════════════════════

const _procCatLabels = {
  acceso_seguridad: {label:'Acceso y Seguridad', icon:'shield-lock', color:'#3b82f6'},
  microsoft365:     {label:'Microsoft 365',      icon:'microsoft',   color:'#0078d4'},
  onboarding:       {label:'Onboarding / RRHH',  icon:'person-plus', color:'#10b981'},
  equipos:          {label:'Equipos',             icon:'laptop',      color:'#8b5cf6'},
  general:          {label:'General',             icon:'folder',      color:'#64748b'},
};

const _procTypeInfo = {
  text:  {icon:'file-text',        cls:'proc-type-text',  label:'Texto'},
  pdf:   {icon:'file-pdf',         cls:'proc-type-pdf',   label:'PDF'},
  image: {icon:'image',            cls:'proc-type-image', label:'Imagen'},
  ppt:   {icon:'file-earmark-ppt', cls:'proc-type-ppt',   label:'PPT'},
};

async function loadProcedures(cat=''){
  _activeProcCat = cat;
  const url = '/api/kb/procedures' + (cat ? `?category=${encodeURIComponent(cat)}` : '');
  try {
    const d    = await apiFetch(url);
    const rows = d.data||[];
    const grid = document.getElementById('procGrid');

    // Mostrar procedimientos predefinidos de ejemplo si no hay ninguno cargado
    if(!rows.length){
      grid.innerHTML=`<div class="empty-state" style="grid-column:1/-1;padding:40px;">
        <i class="bi bi-diagram-3" style="font-size:32px;display:block;margin-bottom:12px;"></i>
        <div style="font-size:15px;font-weight:700;margin-bottom:6px;">Sin procedimientos ${cat?'en esta categoría':''}</div>
        <div style="font-size:13px;">${_isAdmin?'Usa el botón "Agregar procedimiento" para subir el primero.':'Puedes solicitar un procedimiento al equipo de soporte.'}</div>
      </div>`;
      return;
    }

    grid.innerHTML = rows.map(p => {
      const cat2 = _procCatLabels[p.procedure_category]||{label:p.procedure_category,icon:'folder',color:'#64748b'};
      const ti  = _procTypeInfo[p.content_type]||{icon:'file',cls:'proc-type-text',label:'Texto'};
      return `<div class="proc-card">
        <div style="display:flex;align-items:flex-start;gap:12px;">
          <div class="proc-card-icon" style="background:${cat2.color}20;">
            <i class="bi bi-${cat2.icon}" style="color:${cat2.color};"></i>
          </div>
          <div style="flex:1;">
            <div class="proc-card-title">${esc(p.title)}</div>
            <div style="font-size:11px;color:var(--muted);margin-top:2px;">${esc(cat2.label)}</div>
          </div>
        </div>
        <div class="proc-card-desc">${esc(p.description||'')}</div>
        <div class="proc-card-meta">
          <span class="proc-type-badge ${ti.cls}"><i class="bi bi-${ti.icon}"></i> ${ti.label}</span>
          <div style="display:flex;gap:6px;">
            <button class="btn-sm btn-primary" onclick="verProcedimiento(${p.id})"><i class="bi bi-eye"></i> Ver</button>
            ${_isAdmin?`<button class="btn-sm btn-outline" style="color:var(--danger);border-color:var(--danger);" onclick="eliminarProc(${p.id})"><i class="bi bi-trash"></i></button>`:''}
          </div>
        </div>
      </div>`;
    }).join('');
  } catch(e){ console.error(e); }
}

function filterProcs(cat){
  _activeProcCat = cat;
  document.querySelectorAll('.proc-cat-btn').forEach(b=>b.classList.remove('active'));
  event.target.classList.add('active');
  loadProcedures(cat);
}

async function verProcedimiento(id){
  document.getElementById('viewProcTitle').textContent = 'Cargando...';
  document.getElementById('viewProcBody').innerHTML='<div class="empty-state"><i class="bi bi-arrow-clockwise"></i> Cargando...</div>';
  openModal('modalViewProc');
  try {
    const d = await apiFetch(`/api/kb/procedures/${id}`);
    if(!d.success){ document.getElementById('viewProcBody').innerHTML='<div class="empty-state">Error al cargar</div>'; return; }
    const p = d.data;
    const cat2 = _procCatLabels[p.procedure_category]||{label:p.procedure_category};
    document.getElementById('viewProcTitle').textContent = p.title;
    document.getElementById('viewProcMeta').textContent  = `${cat2.label} · Por ${p.created_by||'Soporte TI'}`;

    let bodyHtml = '';
    if(p.content_type === 'text'){
      bodyHtml = `<div class="proc-viewer-text">${p.content_data||'Sin contenido'}</div>`;
    } else if(p.content_type === 'image'){
      bodyHtml = `<div style="text-align:center;"><img src="${p.content_data}" class="proc-viewer-img" alt="${esc(p.title)}"></div>`;
    } else if(p.content_type === 'pdf'){
      bodyHtml = `<embed src="${p.content_data}" type="application/pdf" class="proc-viewer-embed">
        <div style="margin-top:10px;text-align:center;">
          <a href="${p.content_data}" download="${esc(p.file_name||'procedimiento.pdf')}" class="btn-sm btn-primary" style="text-decoration:none;">
            <i class="bi bi-download"></i> Descargar PDF
          </a>
        </div>`;
    } else if(p.content_type === 'ppt'){
      bodyHtml = `<div style="text-align:center;padding:40px 20px;">
        <i class="bi bi-file-earmark-ppt" style="font-size:48px;color:#d97706;"></i>
        <div style="font-size:15px;font-weight:700;margin:12px 0 8px;">${esc(p.file_name||'Presentación')}</div>
        <div style="font-size:13px;color:var(--muted);margin-bottom:16px;">Los archivos PPT/PPTX no se pueden previsualizar en el navegador</div>
        <a href="${p.content_data}" download="${esc(p.file_name||'presentacion.pptx')}" class="btn-sm btn-warning" style="text-decoration:none;">
          <i class="bi bi-download"></i> Descargar presentación
        </a>
      </div>`;
    }
    document.getElementById('viewProcBody').innerHTML = bodyHtml;
  } catch(e){
    document.getElementById('viewProcBody').innerHTML='<div class="empty-state">Error al cargar el procedimiento</div>';
  }
}

async function eliminarProc(id){
  if(!confirm('¿Eliminar este procedimiento?')) return;
  const d = await apiFetch(`/api/kb/procedures/${id}`,{method:'DELETE'});
  if(d.success){ toast('Procedimiento eliminado','success'); loadProcedures(_activeProcCat); }
  else toast(d.error||'Error','error');
}

// ── Upload de archivo ─────────────────────────────────────────────────────────
function onProcTypeChange(type){
  const textArea = document.getElementById('procTextArea');
  const fileArea = document.getElementById('procFileArea');
  const fileInput = document.getElementById('procFile');
  const hint = document.getElementById('procFileHint');
  if(type === 'text'){
    textArea.style.display=''; fileArea.style.display='none';
  } else {
    textArea.style.display='none'; fileArea.style.display='';
    _procFileB64=''; _procFileName='';
    document.getElementById('procFilePreview').style.display='none';
    if(type==='pdf')   { fileInput.accept='application/pdf'; hint.textContent='(PDF — máx. 8MB)'; }
    if(type==='image') { fileInput.accept='image/*';         hint.textContent='(PNG, JPG, WEBP — máx. 8MB)'; }
    if(type==='ppt')   { fileInput.accept='.ppt,.pptx,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation'; hint.textContent='(PPT, PPTX — máx. 8MB)'; }
    fileInput.value='';
  }
}

function onProcFileChange(input){
  const file = input.files[0];
  if(!file) return;
  if(file.size > 8*1024*1024){ toast('El archivo no debe superar 8MB','error'); input.value=''; return; }
  _procFileName = file.name;
  const reader = new FileReader();
  reader.onload = e => {
    _procFileB64 = e.target.result; // data URL completa con prefijo
    const type  = document.querySelector('input[name="procType"]:checked').value;
    const prev  = document.getElementById('procFilePreview');
    prev.style.display='block';
    if(type==='image'){
      prev.innerHTML=`<img src="${_procFileB64}" style="max-width:100%;border-radius:8px;max-height:200px;object-fit:contain;">`;
    } else {
      prev.innerHTML=`<div style="background:var(--hover);border-radius:8px;padding:10px 14px;font-size:13px;display:flex;align-items:center;gap:8px;">
        <i class="bi bi-check-circle-fill" style="color:var(--success);"></i> <strong>${esc(file.name)}</strong>
        <span style="color:var(--muted);">(${(file.size/1024).toFixed(0)} KB)</span></div>`;
    }
  };
  reader.readAsDataURL(file);
}

async function guardarProcedimiento(){
  const title = document.getElementById('procTitle').value.trim();
  if(!title){ toast('El título es requerido','error'); return; }
  const type = document.querySelector('input[name="procType"]:checked').value;
  let content_data='', file_name='';
  if(type==='text'){
    content_data = document.getElementById('procContent').value.trim();
    if(!content_data){ toast('El contenido es requerido','error'); return; }
  } else {
    if(!_procFileB64){ toast('Selecciona un archivo','error'); return; }
    content_data = _procFileB64;
    file_name    = _procFileName;
  }
  const body = {
    title,
    description: document.getElementById('procDesc').value.trim(),
    procedure_category: document.getElementById('procCategory').value,
    content_type: type,
    content_data,
    file_name,
  };
  const d = await apiFetch('/api/kb/procedures',{method:'POST',body});
  if(!d.success){ toast(d.error||'Error al guardar','error'); return; }
  toast('Procedimiento guardado','success');
  closeModal('modalProc');
  // reset
  document.getElementById('procTitle').value='';
  document.getElementById('procDesc').value='';
  document.getElementById('procContent').value='';
  document.getElementById('procFile').value='';
  _procFileB64=''; _procFileName='';
  document.getElementById('procFilePreview').style.display='none';
  loadProcedures(_activeProcCat);
}

// ═══════════════ SOLICITUDES DE PROCEDIMIENTO ════════════════════════════════

async function enviarSolicitud(){
  const query = document.getElementById('reqQuery').value.trim();
  const desc  = document.getElementById('reqDesc').value.trim();
  if(!query){ toast('Describe qué procedimiento necesitas','error'); return; }
  // Priority: server query params > localStorage > JWT user
  const portalName  = _reporterName  || localStorage.getItem('portal_user_name')  || '';
  const portalEmail = _reporterEmail || localStorage.getItem('portal_user_email') || '';
  const d = await apiFetch('/api/kb/procedure-requests',{method:'POST',body:{
    query, description:desc,
    user_name:  portalName  || _user.full_name || _user.username || '',
    user_email: portalEmail || _user.email     || '',
  }});
  if(!d.success){ toast(d.error||'Error','error'); return; }
  toast('¡Solicitud enviada! El equipo de soporte la revisará pronto.','success');
  closeModal('modalRequest');
  document.getElementById('reqQuery').value='';
  document.getElementById('reqDesc').value='';
}

async function loadProcRequests(){
  try {
    const d    = await apiFetch('/api/kb/procedure-requests');
    const rows = d.data||[];
    const tbody = document.getElementById('reqTableBody');
    if(!rows.length){ tbody.innerHTML='<tr><td colspan="8" class="empty-state">Sin solicitudes</td></tr>'; return; }

    // Badge contador de pendientes
    const pending = rows.filter(r=>r.status==='pendiente').length;
    const badge = document.getElementById('solBadge');
    if(badge){ badge.style.display = pending>0?'':'none'; badge.textContent=pending; }

    tbody.innerHTML = rows.map(r=>`<tr>
      <td style="font-weight:700;color:var(--muted);">#${r.id}</td>
      <td style="font-weight:600;">${esc(r.user_name||'—')}</td>
      <td style="color:var(--muted);font-size:12px;">${esc(r.user_email||'—')}</td>
      <td style="font-weight:700;max-width:220px;">${esc(r.query)}</td>
      <td style="font-size:12px;color:var(--muted);max-width:180px;">${esc(r.description||'—')}</td>
      <td style="font-size:12px;color:var(--muted);white-space:nowrap;">${new Date(r.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'})}</td>
      <td><span class="status-badge status-${r.status}">${r.status.replace('_',' ')}</span></td>
      <td>
        <div style="display:flex;gap:4px;">
          ${r.status!=='resuelto'?`<button class="btn-sm btn-success" style="padding:4px 10px;" onclick="updateReqStatus(${r.id},'resuelto')"><i class="bi bi-check2"></i></button>`:''}
          ${r.status==='pendiente'?`<button class="btn-sm btn-primary" style="padding:4px 10px;" onclick="updateReqStatus(${r.id},'en_progreso')"><i class="bi bi-play-fill"></i></button>`:''}
        </div>
      </td>
    </tr>`).join('');
  } catch(e){ console.error(e); }
}

async function updateReqStatus(id, status){
  const d = await apiFetch(`/api/kb/procedure-requests/${id}/status`,{method:'PATCH',body:{status}});
  if(d.success){ toast('Estado actualizado','success'); loadProcRequests(); }
  else toast(d.error||'Error','error');
}

// ═══════════════ FETCH HELPER ════════════════════════════════════════════════
async function apiFetch(url, opts={}){
  const res = await fetch(url, {
    method:  opts.method||'GET',
    credentials: 'include',
    headers: opts.body ? {'Content-Type':'application/json'} : {},
    body:    opts.body ? JSON.stringify(opts.body) : undefined,
  });
  return res.json();
}

