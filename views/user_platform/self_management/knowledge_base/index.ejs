function filterKbContribs(cat, btn){
  _kbContribFilter = cat;
  document.querySelectorAll('#kbContribFilterBar .learn-cat-btn').forEach(b=>b.classList.remove('active'));
  if(btn) btn.classList.add('active');
  renderKbContribs();
}

function renderKbContribs(){
  const grid = document.getElementById('kbContribGrid');
  let list = _kbContribAll;
  if(_kbContribFilter && _kbContribFilter !== 'all') list = list.filter(c => c.category === _kbContribFilter);
  if(!list.length){
    grid.innerHTML = `<div class="empty-state" style="grid-column:1/-1;padding:40px;">
      <i class="bi bi-people" style="font-size:32px;display:block;margin-bottom:12px;"></i>
      <div style="font-size:15px;font-weight:700;margin-bottom:6px;">Sin aportes todavía</div>
      <div style="font-size:13px;">Sé el primero en compartir tu conocimiento con la comunidad.</div>
    </div>`;
    return;
  }
  const meta = _learnCatMeta;
  grid.innerHTML = list.map(c => {
    const catMeta = meta[c.category] || meta['general'];
    const typeIcon = c.content_type==='pdf'?'📄':c.content_type==='video'?'▶️':'🔗';
    const date = c.created_at ? new Date(c.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}) : '';
    return `<div class="contrib-card">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;flex-wrap:wrap;">
        <span class="contrib-cat-badge" style="background:${catMeta.bg};color:${catMeta.color};">${esc(c.category||'general')}</span>
        <span style="font-size:11px;color:var(--muted);">${typeIcon} ${date}</span>
      </div>
      <div style="font-size:15px;font-weight:800;color:var(--text);line-height:1.4;">${esc(c.title)}</div>
      ${c.description?`<div style="font-size:12px;color:var(--muted);line-height:1.6;flex:1;">${esc(c.description.slice(0,180))}${c.description.length>180?'…':''}</div>`:''}
      <div class="contrib-author"><i class="bi bi-person-circle"></i> ${esc(c.author||'Anónimo')}</div>
      <div style="margin-top:6px;">
        ${c.content_type==='text'
          ? `<button class="btn-sm btn-outline" style="font-size:11px;" onclick="viewKbAporte(${c.id})"><i class="bi bi-eye"></i> Leer</button>`
          : `<button class="btn-sm btn-outline" style="font-size:11px;" onclick="accessLearn(${c.id},'${c.content_type}',this)"><i class="bi bi-play-circle"></i> Ver recurso</button>`}
      </div>
    </div>`;
  }).join('');
}

async function sendContribKb(btn){
  const title    = document.getElementById('kbContribTitle').value.trim();
  const category = document.getElementById('kbContribCategory').value;
  const name     = document.getElementById('kbContribName').value.trim();
  const desc     = document.getElementById('kbContribDesc').value.trim();
  const type     = document.querySelector('input[name="kbContribType"]:checked').value;
  const body     = type === 'text'
    ? document.getElementById('kbContribBody').value.trim()
    : document.getElementById('kbContribUrl').value.trim();
  if(!title){ toast('El título es requerido','error'); return; }
  if(!body){  toast(type==='text'?'El contenido es requerido':'La URL es requerida','error'); return; }
  const email = _kbUserEmail();
  const author = name || email || 'Colaborador';
  if(btn) btn.disabled = true;
  const d = await apiFetch('/api/kb/learning',{method:'POST',body:{
    title, category, author,
    description: desc,
    content_type: type === 'text' ? 'text' : 'url',
    content_data: body,
  }});
  if(btn) btn.disabled = false;
  if(!d.success){ toast(d.error||'Error al enviar','error'); return; }
  toast('¡Gracias! Tu aporte fue enviado y será revisado por el equipo.','success');
  closeModal('modalContribKb');
  document.getElementById('kbContribTitle').value = '';
  document.getElementById('kbContribBody').value  = '';
  document.getElementById('kbContribUrl').value   = '';
  document.getElementById('kbContribName').value  = '';
  document.getElementById('kbContribDesc').value  = '';
}

async function checkKbPendingBadge(){
  if(!_isAdmin) return;
  try {
    const d = await apiFetch('/api/kb/learning');
    const pending = (d.data||[]).filter(c => c.status === 'pendiente').length;
    const badge = document.getElementById('kbAportesBadge');
    const cnt   = document.getElementById('kbPendingCount');
    if(badge){ badge.style.display = pending>0?'':'none'; badge.textContent = pending; }
    if(cnt){   cnt.style.display   = pending>0?'':'none'; cnt.textContent   = pending; }
  } catch(e){}
}

async function loadKbPendingAportes(){
  if(!_isAdmin) return;
  const wrap = document.getElementById('kbPendingWrap');
  if(!wrap) return;
  try {
    const d = await apiFetch('/api/kb/learning');
    const rows = (d.data||[]).filter(c => c.status === 'pendiente');
    const badge = document.getElementById('kbAportesBadge');
    const cnt   = document.getElementById('kbPendingCount');
    if(badge){ badge.style.display = rows.length>0?'':'none'; badge.textContent = rows.length; }
    if(cnt){   cnt.style.display   = rows.length>0?'':'none'; cnt.textContent   = rows.length; }
    if(!rows.length){
      wrap.innerHTML = '<div class="empty-state" style="padding:24px;"><i class="bi bi-inbox"></i> Sin aportes pendientes</div>';
      return;
    }
    _kbPendingMap = {};
    rows.forEach(c => _kbPendingMap[c.id] = c);
    wrap.innerHTML = rows.map(c => `
      <div class="contrib-pending-row" id="kb-pending-${c.id}">
        <div style="flex:1;min-width:200px;">
          <div style="font-size:13px;font-weight:800;margin-bottom:3px;">${esc(c.title)}</div>
          <div style="font-size:11px;color:var(--muted);">Por ${esc(c.author||'Anónimo')} · ${esc(c.category||'general')} · ${c.content_type||'text'} · ${new Date(c.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'})}</div>
          ${c.description?`<div style="font-size:12px;color:var(--muted);margin-top:5px;">${esc(c.description)}</div>`:''}
        </div>
        <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
          <button class="btn-sm btn-outline" style="font-size:11px;" onclick="viewKbAporte(${c.id})"><i class="bi bi-eye"></i> Ver</button>
          <button class="btn-sm btn-success" style="font-size:11px;" onclick="approveKbAporte(${c.id},this)"><i class="bi bi-check2-circle"></i> Aprobar</button>
          <button class="btn-sm" style="font-size:11px;background:#fef3c7;color:#92400e;border:none;cursor:pointer;" onclick="openRespKbAporte(${c.id},'${esc(c.title).replace(/'/g,"\\'")}')"><i class="bi bi-reply-fill"></i> Responder</button>
          <button class="btn-sm btn-danger" style="font-size:11px;" onclick="rejectKbAporte(${c.id},this)"><i class="bi bi-x-circle"></i> Denegar</button>
        </div>
      </div>`).join('');
  } catch(e){ wrap.innerHTML='<div class="empty-state" style="padding:24px;">Error al cargar</div>'; }
}

async function viewKbAporte(id){
  const c = _kbPendingMap[id] || (_kbContribAll||[]).find(x=>x.id===id) || null;
  if(!c){ toast('No se pudo cargar el detalle','error'); return; }
  document.getElementById('kbAporteViewTitle').textContent = c.title||'Aporte';
  const date = c.created_at ? new Date(c.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}) : '';
  const meta = `<p style="font-size:12px;color:var(--muted);margin-bottom:10px;">${esc(c.category||'general')} · Por ${esc(c.author||'Anónimo')} · ${date}</p>
    ${c.description?`<p style="font-size:13px;margin-bottom:12px;">${esc(c.description)}</p>`:''}`;
  document.getElementById('kbAporteViewBody').innerHTML = meta + '<div class="empty-state" style="padding:20px;"><i class="bi bi-arrow-clockwise"></i> Cargando...</div>';
  openModal('modalViewKbAporte');
  try {
    const d = await apiFetch(`/api/kb/learning/${id}/content`);
    let bodyHtml = '';
    if(d.blocked){
      bodyHtml = `<div style="padding:14px;background:var(--hover);border-radius:10px;font-size:13px;color:var(--muted);">${d.admin_response?`<strong>Nota:</strong> ${esc(d.admin_response)}`:'Pendiente de aprobación'}</div>`;
    } else if(c.content_type === 'text'){
      bodyHtml = `<div style="font-size:14px;line-height:1.8;white-space:pre-wrap;background:var(--hover);padding:16px;border-radius:10px;">${esc(d.data||'')}</div>`;
    } else {
      bodyHtml = `<div style="font-size:13px;margin-top:4px;"><a href="${esc(d.data||'#')}" target="_blank" style="color:var(--primary);font-weight:600;"><i class="bi bi-box-arrow-up-right"></i> Abrir recurso</a></div>`;
    }
    document.getElementById('kbAporteViewBody').innerHTML = meta + bodyHtml;
  } catch(e){
    document.getElementById('kbAporteViewBody').innerHTML = meta + '<div class="empty-state">No se pudo cargar el contenido</div>';
  }
}

function openRespKbAporte(id, titleSnippet){
  _kbRespAporteId = id;
  document.getElementById('kbRespAporteMeta').textContent = `Aporte: "${titleSnippet}"`;
  document.getElementById('kbRespAporteText').value = '';
  openModal('modalRespKbAporte');
}

async function sendRespKbAporte(btn){
  if(!_kbRespAporteId) return;
  const response = document.getElementById('kbRespAporteText').value.trim();
  if(!response){ toast('Escribe un mensaje','error'); return; }
  if(btn) btn.disabled = true;
  const d = await apiFetch(`/api/kb/learning/${_kbRespAporteId}/response`,{method:'PATCH',body:{response}});
  if(btn) btn.disabled = false;
  if(!d.success){ toast(d.error||'Error','error'); return; }
  toast('Respuesta enviada','success');
  closeModal('modalRespKbAporte');
  _kbRespAporteId = null;
  loadKbPendingAportes();
}

async function approveKbAporte(id, btn){
  if(!confirm('¿Aprobar y publicar este aporte?')) return;
  if(btn) btn.disabled = true;
  const d = await apiFetch(`/api/kb/learning/${id}/status`,{method:'PATCH',body:{status:'publicado'}});
  if(btn) btn.disabled = false;
  if(!d.success){ toast(d.error||'Error','error'); return; }
  toast('Aporte aprobado y publicado','success');
  document.getElementById(`kb-pending-${id}`)?.remove();
  delete _kbPendingMap[id];
  checkKbPendingBadge();
  loadKbContribs();
}

async function rejectKbAporte(id, btn){
  if(!confirm('¿Denegar este aporte?')) return;
  if(btn) btn.disabled = true;
  const d = await apiFetch(`/api/kb/learning/${id}/status`,{method:'PATCH',body:{status:'rechazado'}});
  if(btn) btn.disabled = false;
  if(!d.success){ toast(d.error||'Error','error'); return; }
  toast('Aporte denegado','success');
  document.getElementById(`kb-pending-${id}`)?.remove();
  delete _kbPendingMap[id];
  checkKbPendingBadge();
}

// ── Arranque ──────────────────────────────────────────────────────────────────
init().then(() => {
  const urlTab = new URLSearchParams(location.search).get('tab');
  if (urlTab && _tabSections[urlTab]) switchTab(urlTab);
});
</script>
