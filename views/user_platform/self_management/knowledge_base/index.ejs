<!-- ═══════ MODAL: SUBIR RECURSO DE APRENDIZAJE ══════════════════════════════ -->
<div class="modal-overlay" id="modalLearn">
  <div class="modal-box" style="width:580px;">
    <div class="modal-hdr">
      <h3><i class="bi bi-mortarboard-fill" style="color:var(--purple)"></i> Subir recurso de aprendizaje</h3>
      <button class="btn-sm btn-outline" onclick="closeModal('modalLearn')">✕</button>
    </div>
    <div class="modal-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div class="form-group" style="grid-column:1/-1;">
          <label class="form-lbl">Título *</label>
          <input type="text" id="learnTitle" class="form-ctrl" placeholder="Ej: Curso de Excel avanzado para el trabajo">
        </div>
        <div class="form-group">
          <label class="form-lbl">Categoría</label>
          <select id="learnCategory" class="form-ctrl">
            <option value="ofimática">Ofimática</option>
            <option value="seguridad">Seguridad</option>
            <option value="redes">Redes</option>
            <option value="desarrollo">Desarrollo</option>
            <option value="itsm">ITSM</option>
            <option value="general">General</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-lbl">Duración</label>
          <input type="text" id="learnDuration" class="form-ctrl" placeholder="Ej: 2h 30min">
        </div>
        <div class="form-group" style="grid-column:1/-1;">
          <label class="form-lbl">Autor / Instructor</label>
          <input type="text" id="learnAuthor" class="form-ctrl" placeholder="Nombre del autor o plataforma">
        </div>
        <div class="form-group" style="grid-column:1/-1;">
          <label class="form-lbl">Descripción</label>
          <textarea id="learnDesc" class="form-ctrl" rows="3" placeholder="Describe brevemente el contenido del recurso…"></textarea>
        </div>
        <div class="form-group" style="grid-column:1/-1;">
          <label class="form-lbl">Tipo de acceso</label>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;font-weight:600;padding:8px 14px;border:1.5px solid var(--border);border-radius:8px;">
              <input type="radio" name="learnType" value="link" checked onchange="onLearnTypeChange(this.value)"> <i class="bi bi-link-45deg"></i> URL / Enlace
            </label>
            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;font-weight:600;padding:8px 14px;border:1.5px solid var(--border);border-radius:8px;">
              <input type="radio" name="learnType" value="pdf" onchange="onLearnTypeChange(this.value)"> <i class="bi bi-file-pdf" style="color:#dc2626;"></i> PDF
            </label>
            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;font-weight:600;padding:8px 14px;border:1.5px solid var(--border);border-radius:8px;">
              <input type="radio" name="learnType" value="video" onchange="onLearnTypeChange(this.value)"> <i class="bi bi-play-circle" style="color:#ef4444;"></i> Video
            </label>
          </div>
        </div>
        <div class="form-group" style="grid-column:1/-1;" id="learnLinkArea">
          <label class="form-lbl">URL del recurso *</label>
          <input type="url" id="learnUrl" class="form-ctrl" placeholder="https://…">
        </div>
        <div class="form-group" style="grid-column:1/-1;display:none;" id="learnFileArea">
          <label class="form-lbl">Archivo (PDF — máx. 8MB)</label>
          <input type="file" id="learnFile" class="form-ctrl" accept="application/pdf" onchange="onLearnFileChange(this)">
          <div id="learnFilePreview" style="margin-top:8px;display:none;"></div>
        </div>
      </div>
    </div>
    <div class="modal-ftr">
      <button class="btn-sm btn-outline" onclick="closeModal('modalLearn')">Cancelar</button>
      <button class="btn-sm btn-purple" onclick="guardarLearn()"><i class="bi bi-cloud-upload"></i> Publicar recurso</button>
    </div>
  </div>
</div>

<!-- ═══════ MODAL: COMPARTIR CONOCIMIENTO KB ═════════════════════════════════ -->
<div class="modal-overlay" id="modalContribKb">
  <div class="modal-box" style="width:600px;">
    <div class="modal-hdr">
      <h3><i class="bi bi-lightbulb-fill" style="color:var(--warning)"></i> Compartir conocimiento</h3>
      <button class="btn-sm btn-outline" onclick="closeModal('modalContribKb')">✕</button>
    </div>
    <div class="modal-body">
      <p style="font-size:13px;color:var(--muted);margin-bottom:16px;">
        Comparte un recurso, artículo o tip técnico con la comunidad. El equipo lo revisará antes de publicarlo.
      </p>
