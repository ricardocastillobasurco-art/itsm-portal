async function accessLearn(id, type, btn) {
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i>'; }
  const d = await apiFetch(`/api/kb/learning/${id}/content`);
  // Bloqueo si no está publicado
  if (d.blocked) {
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-play-circle-fill"></i> Acceder'; }
    const st     = d.status === 'rechazado' ? 'Rechazado' : 'Pendiente de aprobación';
    const stClr  = d.status === 'rechazado' ? '#dc2626' : '#d97706';
    const msgHtml = d.admin_response
      ? `<div style="margin-top:12px;padding:12px 14px;background:#f8fafc;border-left:4px solid ${stClr};border-radius:8px;font-size:13px;">
           <div style="font-weight:700;margin-bottom:4px;color:${stClr};"><i class="bi bi-reply-fill"></i> Respuesta del administrador</div>
           <div>${esc(d.admin_response)}</div>
         </div>`
      : `<div style="margin-top:10px;font-size:12px;color:#64748b;">Aún no hay comentarios del administrador. Vuelve más tarde.</div>`;
    // Modal inline de bloqueo
    let overlay = document.getElementById('_learnBlockOverlay');
    if(!overlay){
      overlay = document.createElement('div');
      overlay.id = '_learnBlockOverlay';
      overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;display:flex;align-items:center;justify-content:center;padding:16px;';
      overlay.onclick = e => { if(e.target===overlay) overlay.remove(); };
      document.body.appendChild(overlay);
    }
    overlay.innerHTML = `<div style="background:#fff;border-radius:16px;padding:28px;max-width:440px;width:100%;box-shadow:0 24px 60px rgba(0,0,0,.25);">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
        <div style="width:38px;height:38px;border-radius:50%;background:${d.status==='rechazado'?'#fee2e2':'#fef3c7'};display:flex;align-items:center;justify-content:center;font-size:18px;color:${stClr};">
          <i class="bi ${d.status==='rechazado'?'bi-x-circle-fill':'bi-clock-fill'}"></i>
        </div>
        <div>
          <div style="font-size:15px;font-weight:800;color:#1e293b;">Recurso no disponible</div>
          <div style="font-size:12px;color:${stClr};font-weight:700;">${st}</div>
        </div>
      </div>
      <p style="font-size:13px;color:#64748b;margin:0 0 4px;">Este recurso está pendiente de aprobación por el administrador antes de poder ser accedido.</p>
      ${msgHtml}
      <div style="margin-top:18px;text-align:right;">
        <button onclick="document.getElementById('_learnBlockOverlay').remove()" style="padding:8px 20px;border-radius:8px;background:#f1f5f9;border:none;font-weight:700;cursor:pointer;font-size:13px;">Cerrar</button>
      </div>
    </div>`;
    overlay.style.display = 'flex';
    return;
  }
  apiFetch(`/api/kb/learning/${id}/view`, { method: 'POST' }).catch(() => {});
  if (type !== 'pdf') {
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-play-circle-fill"></i> Acceder'; }
    if (d.success && d.data) window.open(d.data, '_blank');
    return;
  }
  // PDF: usar d.data ya obtenido arriba
  try {
    if (!d.success || !d.data) { toast('No se pudo cargar el PDF', 'error'); if(btn){btn.disabled=false;btn.innerHTML='<i class="bi bi-play-circle-fill"></i> Acceder';} return; }
    const b64 = d.data.includes(',') ? d.data.split(',')[1] : d.data;
    const bytes = Uint8Array.from(atob(b64), c => c.charCodeAt(0));
    const blob  = new Blob([bytes], { type: 'application/pdf' });
    const blobUrl = URL.createObjectURL(blob);
    const win = window.open(blobUrl, '_blank');
    // Revoke after 60s to free memory
    setTimeout(() => URL.revokeObjectURL(blobUrl), 60000);
    if (!win) toast('Permite las ventanas emergentes para ver el PDF', 'warn');
  } catch(e) {
    toast('Error al abrir el PDF', 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-play-circle-fill"></i> Acceder'; }
  }
}

async function deleteLearn(id) {
  if (!confirm('¿Eliminar este recurso de aprendizaje?')) return;
  const d = await apiFetch(`/api/kb/learning/${id}`, { method: 'DELETE' });
  if (d.success) { toast('Recurso eliminado', 'success'); loadLearning(_activeLearnCat); }
  else toast(d.error || 'Error', 'error');
}

function onLearnTypeChange(type) {
  document.getElementById('learnLinkArea').style.display = type !== 'pdf' ? '' : 'none';
  document.getElementById('learnFileArea').style.display = type === 'pdf' ? '' : 'none';
  _learnFileB64 = ''; _learnFileName = '';
  document.getElementById('learnFilePreview').style.display = 'none';
}

function onLearnFileChange(input) {
  const file = input.files[0];
  if (!file) return;
  if (file.size > 8 * 1024 * 1024) { toast('El archivo no debe superar 8MB', 'error'); input.value = ''; return; }
  _learnFileName = file.name;
  const reader = new FileReader();
  reader.onload = e => {
    _learnFileB64 = e.target.result;
    const prev = document.getElementById('learnFilePreview');
    prev.style.display = 'block';
    prev.innerHTML = `<div style="background:var(--hover);border-radius:8px;padding:10px 14px;font-size:13px;display:flex;align-items:center;gap:8px;">
      <i class="bi bi-check-circle-fill" style="color:var(--success);"></i>
      <strong>${esc(file.name)}</strong>
      <span style="color:var(--muted);">(${(file.size / 1024).toFixed(0)} KB)</span>
    </div>`;
  };
  reader.readAsDataURL(file);
}

async function guardarLearn() {
  const title    = document.getElementById('learnTitle').value.trim();
  const category = document.getElementById('learnCategory').value;
  const author   = document.getElementById('learnAuthor').value.trim();
  const duration = document.getElementById('learnDuration').value.trim();
  const desc     = document.getElementById('learnDesc').value.trim();
  const type     = document.querySelector('input[name="learnType"]:checked').value;
  if (!title) { toast('El título es requerido', 'error'); return; }
  let content_data = '', file_name = '';
  if (type === 'pdf') {
    if (!_learnFileB64) { toast('Selecciona un archivo PDF', 'error'); return; }
    content_data = _learnFileB64;
    file_name    = _learnFileName;
  } else {
    content_data = document.getElementById('learnUrl').value.trim();
    if (!content_data) { toast('Ingresa la URL del recurso', 'error'); return; }
  }
  const d = await apiFetch('/api/kb/learning', { method: 'POST', body: {
    title, category, author, duration, description: desc,
    content_type: type, content_data, file_name,
  }});
  if (!d.success) { toast(d.error || 'Error al guardar', 'error'); return; }
  toast(d.pendiente ? 'Recurso enviado — quedará pendiente de aprobación por el administrador' : 'Recurso publicado con éxito', 'success');
  closeModal('modalLearn');
  document.getElementById('learnTitle').value    = '';
  document.getElementById('learnAuthor').value   = '';
  document.getElementById('learnDuration').value = '';
  document.getElementById('learnDesc').value     = '';
  document.getElementById('learnUrl').value      = '';
  document.getElementById('learnFile').value     = '';
  _learnFileB64 = ''; _learnFileName = '';
  document.getElementById('learnFilePreview').style.display = 'none';
  loadLearning(_activeLearnCat);
}

