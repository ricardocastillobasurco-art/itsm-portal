let _activeLearnCat = '', _learnFileB64 = '', _learnFileName = '';

const _learnCatMeta = {
  'ofimática':  { icon: '📊', color: '#0078d4', bg: '#e6f2ff' },
  'seguridad':  { icon: '🔒', color: '#10b981', bg: '#d1fae5' },
  'redes':      { icon: '🌐', color: '#8b5cf6', bg: '#ede9fe' },
  'desarrollo': { icon: '💻', color: '#f59e0b', bg: '#fef3c7' },
  'itsm':       { icon: '🎧', color: '#ef4444', bg: '#fee2e2' },
  'general':    { icon: '📚', color: '#64748b', bg: '#f1f5f9' },
};

async function loadLearning(cat = '') {
  _activeLearnCat = cat;
  // Siempre filtra solo publicados en el portal de usuario
  const params = new URLSearchParams({ status: 'publicado' });
  if (cat) params.set('category', cat);
  const url = '/api/kb/learning?' + params.toString();
  const grid = document.getElementById('learnGrid');
  try {
    const d = await apiFetch(url);
    const rows = d.data || [];
    if (!rows.length) {
      grid.innerHTML = `<div class="empty-state" style="grid-column:1/-1;padding:40px;">
        <i class="bi bi-mortarboard" style="font-size:32px;display:block;margin-bottom:12px;"></i>
        <div style="font-size:15px;font-weight:700;margin-bottom:6px;">Sin recursos${cat ? ' en esta categoría' : ''}</div>
        <div style="font-size:13px;">Sube el primer recurso usando el botón "Subir recurso".</div>
      </div>`;
      return;
    }
    grid.innerHTML = rows.map(r => renderLearnCard(r)).join('');
  } catch(e) {
    grid.innerHTML = `<div class="empty-state" style="grid-column:1/-1;padding:40px;">
      <i class="bi bi-exclamation-circle" style="font-size:32px;display:block;margin-bottom:12px;"></i>
      <div style="font-size:13px;">No se pudieron cargar los recursos.</div>
    </div>`;
  }
  // Cargar también los envíos propios del usuario
  loadMisEnvios();
}

async function loadMisEnvios() {
  const section = document.getElementById('misEnviosSection');
  const grid    = document.getElementById('misEnviosGrid');
  try {
    const d = await apiFetch('/api/kb/learning?mine=1');
    const rows = (d.data || []).filter(r => r.status !== 'publicado');
    if (!rows.length) { section.style.display = 'none'; return; }
    section.style.display = 'block';
    grid.innerHTML = rows.map(r => {
      const stColor = r.status === 'rechazado' ? '#dc2626' : '#d97706';
      const stBg    = r.status === 'rechazado' ? '#fee2e2' : '#fef3c7';
      const stIcon  = r.status === 'rechazado' ? 'bi-x-circle-fill' : 'bi-clock-fill';
      const stLabel = r.status === 'rechazado' ? 'Rechazado' : 'Pendiente de aprobación';
      return `<div style="background:var(--bg-card,#fff);border:1.5px solid ${stBg};border-left:4px solid ${stColor};border-radius:10px;padding:14px 16px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <div style="font-size:13px;font-weight:700;color:var(--text,#1e293b);">${esc(r.title)}</div>
          <div style="font-size:11px;color:var(--muted,#64748b);margin-top:3px;">${r.category||'general'} · ${r.content_type||'url'} · ${_fmtLearnDate(r.created_at)}</div>
          ${r.admin_response ? `<div style="margin-top:8px;padding:8px 12px;background:${stBg};border-radius:7px;font-size:12px;color:${stColor};"><i class="bi bi-reply-fill"></i> <strong>Respuesta del administrador:</strong> ${esc(r.admin_response)}</div>` : ''}
        </div>
        <span style="display:inline-flex;align-items:center;gap:5px;padding:4px 11px;border-radius:20px;font-size:11px;font-weight:700;background:${stBg};color:${stColor};white-space:nowrap;"><i class="bi ${stIcon}"></i> ${stLabel}</span>
      </div>`;
    }).join('');
  } catch(e) { section.style.display = 'none'; }
}

function _fmtLearnDate(d){ if(!d) return ''; try{ return new Date(d).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}); }catch(e){ return d; } }

function renderLearnCard(r) {
  const meta  = _learnCatMeta[r.category] || _learnCatMeta['general'];
  const type  = r.content_type || 'link';
  const typeIcon = type === 'pdf' ? '📄' : type === 'video' ? '▶️' : '🔗';
  const typeLabel = type === 'pdf' ? 'PDF' : type === 'video' ? 'Video' : 'Enlace';
  const typeColor = type === 'pdf' ? '#dc2626' : type === 'video' ? '#ef4444' : '#3b82f6';
  const adminBtns = _isAdmin ? `<button class="btn-sm btn-outline" style="padding:4px 8px;color:var(--danger);border-color:var(--danger);" onclick="deleteLearn(${r.id})" title="Eliminar"><i class="bi bi-trash"></i></button>` : '';
  return `
    <div class="learn-card">
      <div class="learn-card-cover" style="background:${meta.bg};">${meta.icon}</div>
      <div class="learn-card-body">
        <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
          <span class="learn-cat-badge" style="background:${meta.bg};color:${meta.color};">${esc(r.category || 'general')}</span>
          <span style="font-size:10px;font-weight:700;color:${typeColor};background:${typeColor}18;border-radius:6px;padding:2px 7px;">${typeIcon} ${typeLabel}</span>
        </div>
        <div class="learn-card-title">${esc(r.title)}</div>
        ${r.description ? `<div style="font-size:12px;color:var(--muted);line-height:1.5;flex:1;">${esc(r.description)}</div>` : ''}
        <div class="learn-card-meta">
          ${r.author ? `<span><i class="bi bi-person-fill"></i> ${esc(r.author)}</span>` : ''}
          ${r.duration ? `<span><i class="bi bi-clock"></i> ${esc(r.duration)}</span>` : ''}
          <span><i class="bi bi-eye"></i> ${r.views || 0} vistas</span>
        </div>
      </div>
      <div class="learn-card-footer">
        ${adminBtns}
        <button class="btn-sm btn-purple" onclick="accessLearn(${r.id},'${type}',this)">
          <i class="bi bi-play-circle-fill"></i> Acceder
        </button>
      </div>
    </div>`;
}

function filterLearn(cat, btn) {
  _activeLearnCat = cat;
  document.querySelectorAll('.learn-cat-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  loadLearning(cat);
}

