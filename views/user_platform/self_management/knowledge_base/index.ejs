        <button class="proc-cat-btn active" onclick="filterProcs('')">Todos</button>
        <button class="proc-cat-btn" onclick="filterProcs('acceso_seguridad')"><i class="bi bi-shield-lock"></i> Acceso y Seguridad</button>
        <button class="proc-cat-btn" onclick="filterProcs('microsoft365')"><i class="bi bi-microsoft"></i> Microsoft 365</button>
        <button class="proc-cat-btn" onclick="filterProcs('onboarding')"><i class="bi bi-person-plus"></i> Onboarding / RRHH</button>
        <button class="proc-cat-btn" onclick="filterProcs('equipos')"><i class="bi bi-laptop"></i> Equipos</button>
        <button class="proc-cat-btn" onclick="filterProcs('general')"><i class="bi bi-folder"></i> General</button>
      </div>
      <div style="display:flex;align-items:center;gap:8px;">
        <button id="procRefreshBtn" onclick="refreshProcedures()" title="Actualizar" style="display:inline-flex;align-items:center;gap:5px;padding:7px 13px;border-radius:20px;border:1.5px solid var(--border,#e2e8f0);background:var(--bg-card,#fff);color:var(--muted,#64748b);font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;">
          <i class="bi bi-arrow-clockwise" id="procRefreshIcon"></i> Actualizar
        </button>
        <% if (!['administrador','especialista'].includes(user?.role)) { %>
        <button class="btn-sm btn-purple" onclick="openModal('modalRequest')">
          <i class="bi bi-send"></i> Solicitar procedimiento
        </button>
        <% } else { %>
        <button class="btn-sm btn-primary" onclick="openModal('modalProc')">
          <i class="bi bi-plus-lg"></i> Agregar procedimiento
        </button>
        <% } %>
      </div>
    </div>

    <!-- Procedimientos predefinidos destacados (solo si no hay filtro activo o es general) -->
    <div id="procDefaultCards" style="margin-bottom:20px;"></div>

    <div class="proc-grid" id="procGrid">
      <div class="empty-state" style="grid-column:1/-1;padding:40px;"><i class="bi bi-arrow-clockwise" style="font-size:24px;"></i><br>Cargando procedimientos...</div>
    </div>
  </div>

  <!-- ─── TAB: LEARNING ────────────────────────────────────────────────── -->
  <div class="section-tab" id="tabLearning">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px;">
      <div class="learn-cats" id="learnCatFilter">
        <button class="learn-cat-btn active" onclick="filterLearn('',this)"><i class="bi bi-grid"></i> Todos</button>
        <button class="learn-cat-btn" onclick="filterLearn('ofimática',this)"><i class="bi bi-microsoft"></i> Ofimática</button>
        <button class="learn-cat-btn" onclick="filterLearn('seguridad',this)"><i class="bi bi-shield-lock"></i> Seguridad</button>
        <button class="learn-cat-btn" onclick="filterLearn('redes',this)"><i class="bi bi-diagram-2"></i> Redes</button>
        <button class="learn-cat-btn" onclick="filterLearn('desarrollo',this)"><i class="bi bi-code-slash"></i> Desarrollo</button>
        <button class="learn-cat-btn" onclick="filterLearn('itsm',this)"><i class="bi bi-headset"></i> ITSM</button>
        <button class="learn-cat-btn" onclick="filterLearn('general',this)"><i class="bi bi-book"></i> General</button>
      </div>
      <div style="display:flex;align-items:center;gap:8px;">
        <button id="learnRefreshBtn" onclick="refreshLearning()" title="Actualizar" style="display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:20px;border:1.5px solid var(--border,#e2e8f0);background:var(--bg-card,#fff);color:var(--muted,#64748b);font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;">
          <i class="bi bi-arrow-clockwise" id="learnRefreshIcon"></i> Actualizar
        </button>
        <button class="btn-sm btn-purple" onclick="openModal('modalLearn')">
          <i class="bi bi-cloud-upload"></i> Subir recurso
        </button>
      </div>
    </div>
    <div class="learn-grid" id="learnGrid">
      <div class="empty-state" style="grid-column:1/-1;padding:40px;">
        <i class="bi bi-arrow-clockwise" style="font-size:24px;"></i><br>Cargando recursos...
      </div>
    </div>
    <!-- Mis envíos -->
    <div id="misEnviosSection" style="display:none;margin-top:28px;">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <i class="bi bi-send-fill" style="color:var(--primary);"></i>
        <span style="font-size:13px;font-weight:800;color:var(--text);letter-spacing:.3px;">MIS ENVÍOS</span>
        <span style="font-size:11px;color:var(--muted);">— recursos que has subido pendientes de revisión o rechazados</span>
      </div>
      <div id="misEnviosGrid" style="display:flex;flex-direction:column;gap:10px;"></div>
    </div>
  </div>

  <!-- ─── TAB: APORTES DE LA COMUNIDAD ────────────────────────────────── -->
  <div class="section-tab" id="tabAportes">
    <!-- Toolbar -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px;">
      <div style="display:flex;gap:6px;flex-wrap:wrap;" id="kbContribFilterBar">
        <button class="learn-cat-btn active" onclick="filterKbContribs('all',this)"><i class="bi bi-grid"></i> Todos</button>
        <button class="learn-cat-btn" onclick="filterKbContribs('ofimática',this)"><i class="bi bi-microsoft"></i> Ofimática</button>
        <button class="learn-cat-btn" onclick="filterKbContribs('seguridad',this)"><i class="bi bi-shield-lock"></i> Seguridad</button>
        <button class="learn-cat-btn" onclick="filterKbContribs('redes',this)"><i class="bi bi-diagram-2"></i> Redes</button>
        <button class="learn-cat-btn" onclick="filterKbContribs('general',this)"><i class="bi bi-book"></i> General</button>
      </div>
      <div style="display:flex;align-items:center;gap:8px;">
        <button onclick="loadKbContribs()" title="Actualizar" style="display:inline-flex;align-items:center;gap:5px;padding:7px 13px;border-radius:20px;border:1.5px solid var(--border);background:var(--card);color:var(--muted);font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;">
          <i class="bi bi-arrow-clockwise"></i> Actualizar
        </button>
        <button class="btn-sm btn-purple" onclick="openModal('modalContribKb')">
          <i class="bi bi-lightbulb-fill"></i> Compartir conocimiento
        </button>
      </div>
    </div>

    <!-- Grid de aportes aprobados -->
    <div class="contrib-grid" id="kbContribGrid">
      <div class="empty-state" style="grid-column:1/-1;padding:40px;">
        <i class="bi bi-arrow-clockwise" style="font-size:24px;"></i><br>Cargando aportes...
      </div>
    </div>

    <!-- Sección revisión admin -->
    <% if (['administrador','especialista'].includes(user?.role)) { %>
    <div id="kbAdminAportesSection" style="margin-top:32px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;flex-wrap:wrap;gap:8px;">
        <div style="display:flex;align-items:center;gap:8px;">
          <i class="bi bi-clipboard2-check-fill" style="color:var(--warning);"></i>
          <span style="font-size:13px;font-weight:800;color:var(--text);letter-spacing:.3px;">REVISIÓN DE APORTES PENDIENTES</span>
          <span id="kbPendingCount" style="background:var(--danger);color:#fff;border-radius:10px;padding:1px 8px;font-size:11px;font-weight:700;display:none;"></span>
        </div>
        <button class="btn-sm btn-outline" onclick="loadKbPendingAportes()"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
      </div>
      <div id="kbPendingWrap">
        <div class="empty-state" style="padding:24px;"><i class="bi bi-inbox"></i> Sin aportes pendientes</div>
      </div>
    </div>
    <% } %>
  </div>

  <!-- ─── TAB: SOLICITUDES (solo admin) ─────────────────────────────────── -->
  <% if (['administrador','especialista'].includes(user?.role)) { %>
  <div class="section-tab" id="tabSolicitudes">
    <div class="card-ui">
      <div class="card-head">
        <span class="title"><i class="bi bi-inbox"></i> Solicitudes de Procedimientos</span>
        <button class="btn-sm btn-outline" onclick="loadProcRequests()"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
      </div>
      <div style="overflow-x:auto;">
        <table class="req-table" id="reqTable">
          <thead>
            <tr>
              <th>#</th><th>Usuario</th><th>Correo</th><th>Solicitud</th><th>Descripción</th><th>Fecha</th><th>Estado</th><th>Acción</th>
            </tr>
          </thead>
          <tbody id="reqTableBody">
            <tr><td colspan="8" class="empty-state">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <% } %>

</div><!-- /.pg -->

<!-- ═══════ MODAL: NUEVO ARTÍCULO (admin) ═══════════════════════════════════ -->
<div class="modal-overlay" id="modalArt">
  <div class="modal-box">
    <div class="modal-hdr">
      <h3><i class="bi bi-file-earmark-plus" style="color:var(--primary)"></i> Nuevo Artículo</h3>
      <button class="btn-sm btn-outline" onclick="closeModal('modalArt')">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-lbl">Categoría</label>
        <select id="artCatId" class="form-ctrl"><option value="">Sin categoría</option></select>
      </div>
      <div class="form-group">
        <label class="form-lbl">Título *</label>
        <input type="text" id="artTitle" class="form-ctrl" placeholder="Ej: Cómo restablecer contraseña en Active Directory">
      </div>
      <div class="form-group">
        <label class="form-lbl">Tags (separados por coma)</label>
        <input type="text" id="artTags" class="form-ctrl" placeholder="contraseña, AD, usuario, acceso">
      </div>
      <div class="form-group">
        <label class="form-lbl">Contenido * (HTML permitido)</label>
        <textarea id="artContent" class="form-ctrl" rows="9" placeholder="Redacta el artículo..."></textarea>
      </div>
      <div class="form-group">
        <label class="form-lbl">Estado</label>
        <select id="artStatus" class="form-ctrl">
          <option value="borrador">Borrador</option>
          <option value="publicado">Publicado</option>
        </select>
      </div>
    </div>
    <div class="modal-ftr">
      <button class="btn-sm btn-outline" onclick="closeModal('modalArt')">Cancelar</button>
      <button class="btn-sm btn-primary" onclick="crearArticulo()"><i class="bi bi-save"></i> Guardar</button>
    </div>
  </div>
</div>

<!-- ═══════ MODAL: AGREGAR PROCEDIMIENTO (admin) ═══════════════════════════ -->
<div class="modal-overlay" id="modalProc">
  <div class="modal-box" style="width:760px;">
    <div class="modal-hdr">
      <h3><i class="bi bi-diagram-3" style="color:var(--purple)"></i> Agregar Procedimiento</h3>
      <button class="btn-sm btn-outline" onclick="closeModal('modalProc')">✕</button>
    </div>
    <div class="modal-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div class="form-group">
          <label class="form-lbl">Título *</label>
          <input type="text" id="procTitle" class="form-ctrl" placeholder="Ej: Cómo solicitar acceso VPN">
        </div>
        <div class="form-group">
          <label class="form-lbl">Categoría</label>
          <select id="procCategory" class="form-ctrl">
            <option value="acceso_seguridad">Acceso y Seguridad</option>
            <option value="microsoft365">Microsoft 365</option>
            <option value="onboarding">Onboarding / RRHH</option>
            <option value="equipos">Equipos</option>
            <option value="general">General</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-lbl">Descripción breve</label>
        <input type="text" id="procDesc" class="form-ctrl" placeholder="Describe brevemente el procedimiento">
      </div>
      <div class="form-group">
        <label class="form-lbl">Tipo de contenido</label>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;font-weight:600;padding:8px 14px;border:1.5px solid var(--border);border-radius:8px;">
            <input type="radio" name="procType" value="text" checked onchange="onProcTypeChange(this.value)"> <i class="bi bi-file-text"></i> Texto/HTML
          </label>
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;font-weight:600;padding:8px 14px;border:1.5px solid var(--border);border-radius:8px;">
            <input type="radio" name="procType" value="pdf" onchange="onProcTypeChange(this.value)"> <i class="bi bi-file-pdf" style="color:#dc2626;"></i> PDF
          </label>
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;font-weight:600;padding:8px 14px;border:1.5px solid var(--border);border-radius:8px;">
            <input type="radio" name="procType" value="image" onchange="onProcTypeChange(this.value)"> <i class="bi bi-image" style="color:#059669;"></i> Imagen
          </label>
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;font-weight:600;padding:8px 14px;border:1.5px solid var(--border);border-radius:8px;">
            <input type="radio" name="procType" value="ppt" onchange="onProcTypeChange(this.value)"> <i class="bi bi-file-earmark-ppt" style="color:#d97706;"></i> PPT/PPTX
          </label>
        </div>
      </div>
      <!-- Contenido texto -->
      <div id="procTextArea" class="form-group">
        <label class="form-lbl">Contenido (HTML permitido)</label>
        <textarea id="procContent" class="form-ctrl" rows="8" placeholder="Redacta el procedimiento paso a paso..."></textarea>
      </div>
      <!-- Upload archivo -->
      <div id="procFileArea" class="form-group" style="display:none;">
        <label class="form-lbl">Archivo <span id="procFileHint" style="color:var(--muted);font-weight:400;">(PDF, imagen o PPT — máx. 8MB)</span></label>
        <input type="file" id="procFile" class="form-ctrl" onchange="onProcFileChange(this)" accept="">
        <div id="procFilePreview" style="margin-top:10px;display:none;"></div>
      </div>
    </div>
    <div class="modal-ftr">
      <button class="btn-sm btn-outline" onclick="closeModal('modalProc')">Cancelar</button>
      <button class="btn-sm btn-purple" onclick="guardarProcedimiento()"><i class="bi bi-save"></i> Guardar procedimiento</button>
    </div>
  </div>
</div>

<!-- ═══════ MODAL: SOLICITAR PROCEDIMIENTO (usuario) ════════════════════════ -->
<div class="modal-overlay" id="modalRequest">
  <div class="modal-box" style="width:500px;">
    <div class="modal-hdr">
      <h3><i class="bi bi-send" style="color:var(--purple)"></i> Solicitar un procedimiento</h3>
      <button class="btn-sm btn-outline" onclick="closeModal('modalRequest')">✕</button>
    </div>
    <div class="modal-body">
      <p style="font-size:13px;color:var(--muted);margin-bottom:16px;">
        Describe qué procedimiento necesitas. El equipo de soporte lo creará y te notificará cuando esté disponible.
      </p>
      <div class="form-group">
        <label class="form-lbl">¿Qué procedimiento necesitas? *</label>
        <input type="text" id="reqQuery" class="form-ctrl" placeholder="Ej: Cómo solicitar acceso a buzón genérico de área">
      </div>
      <div class="form-group">
        <label class="form-lbl">Descripción adicional (opcional)</label>
        <textarea id="reqDesc" class="form-ctrl" rows="4" placeholder="Agrega contexto adicional sobre lo que necesitas..."></textarea>
      </div>
    </div>
    <div class="modal-ftr">
      <button class="btn-sm btn-outline" onclick="closeModal('modalRequest')">Cancelar</button>
      <button class="btn-sm btn-purple" onclick="enviarSolicitud()"><i class="bi bi-send"></i> Enviar solicitud</button>
    </div>
  </div>
</div>

<!-- ═══════ MODAL: VER PROCEDIMIENTO ════════════════════════════════════════ -->
<div class="modal-overlay" id="modalViewProc">
