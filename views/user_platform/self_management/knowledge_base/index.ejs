<!DOCTYPE html>
<html lang="es">
<head>
<script>(function(){document.documentElement.setAttribute('data-theme',localStorage.getItem('dashboardTheme')||'light');})();</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Base de Conocimiento</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<style>
:root,[data-theme="light"]{
  --bg:#f0f4f8;--card:#fff;--hdr:#f8fafc;--border:#e2e8f0;
  --text:#1e293b;--muted:#64748b;--primary:#3b82f6;--success:#10b981;
  --warning:#f59e0b;--danger:#ef4444;--purple:#8b5cf6;
  --hover:#f1f5f9;--sh-sm:0 1px 3px rgba(0,0,0,.06);--sh-md:0 4px 12px rgba(0,0,0,.08);
}
[data-theme="dark"]{
  --bg:#0b1120;--card:#131f35;--hdr:#0f1c2f;--border:#1e3050;
  --text:#e2e8f0;--muted:#94a3b8;--primary:#60a5fa;--success:#34d399;
  --warning:#fbbf24;--danger:#f87171;--purple:#a78bfa;--hover:#1a2d4a;
}
*{box-sizing:border-box;}
body{margin:0;background:var(--bg);color:var(--text);font-family:'DM Sans',-apple-system,sans-serif;}
.pg{max-width:1700px;margin:0 auto;padding:24px 20px;}

/* HEADER */
.page-hdr{display:flex;align-items:center;gap:16px;margin-bottom:20px;flex-wrap:wrap;}
.page-hdr-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;box-shadow:var(--sh-md);}
.page-hdr h1{font-size:22px;font-weight:800;margin:0;}
.page-hdr p{margin:3px 0 0;font-size:13px;color:var(--muted);}
.page-hdr-right{margin-left:auto;display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
.user-chip{background:var(--hover);border:1px solid var(--border);border-radius:20px;padding:5px 12px 5px 8px;display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:var(--text);}
.user-chip-av{width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#8b5cf6);color:#fff;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;}

/* TABS */
.kb-tabs{display:flex;gap:6px;margin-bottom:20px;border-bottom:2px solid var(--border);padding-bottom:0;}
.kb-tab{padding:10px 20px;font-size:13px;font-weight:700;border:none;background:none;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .2s;border-radius:8px 8px 0 0;display:flex;align-items:center;gap:7px;}
.kb-tab:hover{color:var(--text);background:var(--hover);}
.kb-tab.active{color:var(--primary);border-bottom-color:var(--primary);background:transparent;}

/* SEARCH HERO */
.search-hero{background:linear-gradient(135deg,#3b82f6,#8b5cf6);border-radius:16px;padding:28px 32px;text-align:center;margin-bottom:20px;color:#fff;}
.search-hero h2{font-size:22px;font-weight:800;margin-bottom:6px;}
.search-hero p{font-size:13px;opacity:.85;margin-bottom:18px;}
.search-box{display:flex;max-width:560px;margin:0 auto;gap:0;}
.search-box input{flex:1;border:none;border-radius:10px 0 0 10px;padding:12px 18px;font-size:14px;outline:none;color:#1e293b;}
.search-box button{background:#fff;color:var(--primary);border:none;border-radius:0 10px 10px 0;padding:12px 20px;font-size:16px;cursor:pointer;font-weight:700;}
.search-not-found-bar{margin-top:14px;font-size:13px;opacity:.9;}
.search-not-found-bar button{background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.5);color:#fff;border-radius:8px;padding:6px 16px;font-size:12px;font-weight:700;cursor:pointer;margin-left:8px;}
.search-not-found-bar button:hover{background:rgba(255,255,255,.35);}

/* SEARCH RESULTS */
.search-results{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:20px;display:none;}
.search-result-item{padding:14px 18px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .15s;}
.search-result-item:last-child{border-bottom:none;}
.search-result-item:hover{background:var(--hover);}
.search-result-item .sr-title{font-weight:700;margin-bottom:3px;}
.search-result-item .sr-excerpt{font-size:12px;color:var(--muted);}

/* LAYOUT ARTÍCULOS */
.three-col{display:grid;grid-template-columns:260px 1fr 300px;gap:16px;}
@media(max-width:1200px){.three-col{grid-template-columns:1fr 1fr;}}
@media(max-width:800px){.three-col{grid-template-columns:1fr;}}

/* CARDS */
.card-ui{background:var(--card);border:1px solid var(--border);border-radius:14px;box-shadow:var(--sh-sm);overflow:hidden;margin-bottom:16px;}
.card-head{padding:13px 18px;background:var(--hdr);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
.card-head .title{font-size:13px;font-weight:700;color:var(--text);display:flex;align-items:center;gap:8px;}
.cat-item{display:flex;align-items:center;gap:10px;padding:11px 16px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .15s;font-size:13px;font-weight:600;}
.cat-item:last-child{border-bottom:none;}
.cat-item:hover,.cat-item.active{background:var(--hover);}
.cat-item.active{color:var(--primary);border-left:3px solid var(--primary);}
.cat-icon{font-size:16px;width:24px;text-align:center;}
.art-item{padding:14px 18px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .15s;}
.art-item:last-child{border-bottom:none;}
.art-item:hover{background:var(--hover);}
.art-title{font-weight:700;font-size:14px;margin-bottom:4px;}
.art-excerpt{font-size:12px;color:var(--muted);line-height:1.5;}
.art-meta{display:flex;gap:10px;align-items:center;margin-top:6px;font-size:11px;color:var(--muted);}
.pop-item{display:flex;align-items:center;gap:10px;padding:10px 16px;border-bottom:1px solid var(--border);cursor:pointer;font-size:13px;}
.pop-item:last-child{border-bottom:none;}
.pop-item:hover{background:var(--hover);}
.pop-rank{width:22px;height:22px;border-radius:50%;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0;}

/* ARTÍCULO DETALLE */
.article-view{display:none;}
.article-view.open{display:block;}
.article-content{padding:24px 28px;line-height:1.8;font-size:14px;}
.article-content h2,.article-content h3{font-weight:700;margin:20px 0 10px;}
.article-content pre{background:var(--hdr);border-radius:8px;padding:12px;overflow:auto;font-size:12px;}
.helpful-bar{padding:16px 28px;border-top:1px solid var(--border);display:flex;align-items:center;gap:12px;background:var(--hdr);}

/* BOTONES */
.btn-sm{padding:6px 14px;font-size:12px;font-weight:600;border-radius:8px;border:none;cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;gap:6px;}
.btn-primary{background:var(--primary);color:#fff;}
.btn-primary:hover{opacity:.88;}
.btn-outline{background:transparent;border:1px solid var(--border);color:var(--muted);}
.btn-outline:hover{background:var(--hover);}
.btn-success{background:var(--success);color:#fff;}
.btn-warning{background:var(--warning);color:#fff;}
.btn-danger{background:var(--danger);color:#fff;}
.btn-purple{background:var(--purple);color:#fff;}

/* FORMULARIOS */
.form-ctrl{width:100%;border:1px solid var(--border);border-radius:8px;padding:9px 12px;font-size:13px;background:var(--card);color:var(--text);outline:none;}
.form-ctrl:focus{border-color:var(--primary);}
.form-group{margin-bottom:14px;}
.form-lbl{font-size:12px;font-weight:700;color:var(--muted);margin-bottom:5px;display:block;}

/* PROCEDIMIENTOS */
.proc-cats{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;}
.proc-cat-btn{padding:6px 14px;border-radius:20px;font-size:12px;font-weight:700;border:1.5px solid var(--border);background:var(--card);color:var(--muted);cursor:pointer;transition:all .2s;}
.proc-cat-btn:hover,.proc-cat-btn.active{background:var(--primary);color:#fff;border-color:var(--primary);}
.proc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;}
.proc-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:20px;box-shadow:var(--sh-sm);transition:box-shadow .2s;display:flex;flex-direction:column;gap:10px;}
.proc-card:hover{box-shadow:var(--sh-md);}
.proc-card-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
.proc-card-title{font-size:15px;font-weight:800;color:var(--text);margin:0;}
.proc-card-desc{font-size:12px;color:var(--muted);line-height:1.5;flex:1;}
.proc-card-meta{display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--muted);}
.proc-type-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:8px;font-size:10px;font-weight:700;}
.proc-type-pdf{background:#fee2e2;color:#dc2626;}
.proc-type-image{background:#d1fae5;color:#059669;}
.proc-type-ppt{background:#fef3c7;color:#d97706;}
.proc-type-text{background:#dbeafe;color:#1d4ed8;}

/* SOLICITUDES TABLA */
.req-table{width:100%;border-collapse:collapse;font-size:13px;}
.req-table th{background:var(--hdr);padding:10px 14px;font-weight:700;font-size:11px;text-transform:uppercase;color:var(--muted);border-bottom:2px solid var(--border);text-align:left;}
.req-table td{padding:10px 14px;border-bottom:1px solid var(--border);vertical-align:middle;}
.req-table tr:hover td{background:var(--hover);}
.status-badge{padding:3px 10px;border-radius:10px;font-size:10px;font-weight:700;}
.status-pendiente{background:#fef3c7;color:#92400e;}
.status-en_progreso{background:#dbeafe;color:#1e40af;}
.status-resuelto{background:#d1fae5;color:#065f46;}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(15,23,42,.5);backdrop-filter:blur(4px);z-index:1000;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s;}
.modal-overlay.open{opacity:1;pointer-events:all;}
.modal-box{background:var(--card);border-radius:20px;width:720px;max-width:95vw;max-height:90vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 24px 60px rgba(0,0,0,.25);transform:translateY(20px);transition:transform .2s;}
.modal-overlay.open .modal-box{transform:translateY(0);}
.modal-hdr{padding:18px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
.modal-hdr h3{margin:0;font-size:16px;font-weight:800;}
.modal-body{padding:20px 24px;overflow-y:auto;flex:1;}
.modal-ftr{padding:14px 24px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;}

/* VISOR PROCEDIMIENTO */
.proc-viewer-embed{width:100%;height:500px;border:none;border-radius:8px;background:#000;}
.proc-viewer-img{max-width:100%;border-radius:8px;}
.proc-viewer-text{line-height:1.8;font-size:14px;}
.proc-viewer-text h2,.proc-viewer-text h3{font-weight:700;margin:16px 0 8px;}

/* NO RESULTS ADMIN */
.no-res-item{display:flex;align-items:center;justify-content:space-between;padding:8px 16px;border-bottom:1px solid var(--border);font-size:12px;}
.no-res-item:last-child{border-bottom:none;}

.theme-toggle{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none;}
.toggle-track{width:38px;height:22px;border-radius:11px;background:var(--border);position:relative;transition:background .3s;flex-shrink:0;}
[data-theme="dark"] .toggle-track{background:var(--primary);}
.toggle-knob{width:16px;height:16px;background:#fff;border-radius:50%;position:absolute;top:3px;left:3px;transition:transform .3s cubic-bezier(.4,0,.2,1);box-shadow:0 1px 4px rgba(0,0,0,.3);}
[data-theme="dark"] .toggle-knob{transform:translateX(16px);}
.toggle-label{font-size:12px;font-weight:600;color:var(--muted);white-space:nowrap;}
.empty-state{text-align:center;padding:32px 20px;color:var(--muted);}
.section-tab{display:none;}
.section-tab.active{display:block;}

/* LEARNING */
.learn-cats{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;}
.learn-cat-btn{padding:6px 14px;border-radius:20px;font-size:12px;font-weight:700;border:1.5px solid var(--border);background:var(--card);color:var(--muted);cursor:pointer;transition:all .2s;}
.learn-cat-btn:hover,.learn-cat-btn.active{background:var(--primary);color:#fff;border-color:var(--primary);}
.learn-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;}
.learn-card{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;box-shadow:var(--sh-sm);transition:box-shadow .2s;display:flex;flex-direction:column;}
.learn-card:hover{box-shadow:var(--sh-md);}
.learn-card-cover{height:96px;display:flex;align-items:center;justify-content:center;font-size:38px;}
.learn-card-body{padding:14px 16px;flex:1;display:flex;flex-direction:column;gap:6px;}
.learn-card-title{font-size:14px;font-weight:800;color:var(--text);line-height:1.4;}
.learn-card-meta{display:flex;flex-wrap:wrap;gap:8px;font-size:11px;color:var(--muted);align-items:center;}
.learn-cat-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 9px;border-radius:8px;font-size:10px;font-weight:700;}
.learn-card-footer{padding:10px 16px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}

/* APORTES DE LA COMUNIDAD */
.contrib-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px;}
.contrib-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:20px;box-shadow:var(--sh-sm);transition:box-shadow .2s;display:flex;flex-direction:column;gap:10px;}
.contrib-card:hover{box-shadow:var(--sh-md);}
.contrib-cat-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 10px;border-radius:10px;font-size:10px;font-weight:700;background:#dbeafe;color:#1d4ed8;}
.contrib-author{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:5px;}
.star-row{display:flex;align-items:center;gap:3px;margin-top:4px;}
.star{font-size:17px;cursor:pointer;transition:color .1s;line-height:1;}
.contrib-pending-row{background:var(--card);border:1.5px solid var(--border);border-left:4px solid var(--warning);border-radius:10px;padding:14px 16px;display:flex;align-items:flex-start;gap:14px;flex-wrap:wrap;}
</style>
</head>
<body>
<style>
.kb-topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 20px;background:var(--card,#fff);border-bottom:1px solid var(--border,#e2e8f0);position:sticky;top:0;z-index:999;}
.kb-back{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--muted,#64748b);background:var(--hover,#f0f4f8);border:1px solid var(--border,#e2e8f0);border-radius:20px;padding:5px 12px;text-decoration:none;transition:color .2s;}
.kb-back:hover{color:var(--primary,#3b82f6);}
.kb-bc{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted,#64748b);}
.kb-bc a{color:var(--muted,#64748b);text-decoration:none;font-weight:500;transition:color .2s;}
.kb-bc a:hover{color:var(--primary,#3b82f6);}
.kb-bc .sep{opacity:.4;}
.kb-bc .current{color:var(--text,#1e293b);font-weight:700;}
</style>
<div class="kb-topbar">
  <div style="display:flex;align-items:center;gap:12px;">
    <a href="/home" class="kb-back"><i class="bi bi-arrow-left"></i> Inicio</a>
    <div class="kb-bc">
      <a href="/home"><i class="bi bi-house-fill"></i> Inicio</a>
      <span class="sep">/</span>
      <span class="current"><i class="bi bi-book-half"></i> Base de Conocimiento</span>
    </div>
  </div>
  <button onclick="toggleTheme()" style="display:flex;align-items:center;gap:6px;background:none;border:none;cursor:pointer;padding:4px 8px;border-radius:8px;">
    <div id="themeTrack" style="width:32px;height:18px;border-radius:9px;background:#cbd5e1;position:relative;transition:background .3s;">
      <div id="themeKnob" style="width:14px;height:14px;border-radius:50%;background:#fff;position:absolute;top:2px;left:2px;transition:transform .3s;"></div>
    </div>
    <i id="toggleIcon" class="bi bi-moon-stars-fill" style="font-size:14px;color:var(--muted,#64748b);"></i>
    <span id="toggleLabel" style="font-size:12px;color:var(--muted,#64748b);font-weight:500;">Oscuro</span>
  </button>
</div>
<div class="pg" style="padding-top:16px;">

  <!-- HEADER -->
  <div class="page-hdr">
    <div class="page-hdr-icon" style="background:linear-gradient(135deg,#06b6d4,#0891b2);">
      <i class="bi bi-book-half" style="color:#fff;"></i>
    </div>
    <div>
      <h1>Base de Conocimiento</h1>
      <p>Artículos, guías, procedimientos y soluciones del equipo de soporte</p>
    </div>
    <div class="page-hdr-right">
      <!-- Botón solo admin -->
      <% if (user && ['administrador','especialista'].includes(user.role)) { %>
      <button class="btn-sm btn-primary" onclick="openModal('modalArt')">
        <i class="bi bi-plus-lg"></i> Nuevo Artículo
      </button>
      <% } %>
    </div>
  </div>

  <!-- HERO BUSCADOR -->
  <div class="search-hero">
    <h2><i class="bi bi-search"></i> ¿Qué necesitas saber?</h2>
    <p>Busca artículos técnicos, guías y procedimientos de gestión</p>
    <div class="search-box">
      <input type="text" id="searchInput" placeholder="Buscar..." oninput="debounceSearch()">
      <button onclick="doSearch()"><i class="bi bi-search"></i></button>
    </div>
    <!-- Botón solicitar procedimiento (solo usuarios no admin) -->
    <% if (!['administrador','especialista'].includes(user?.role)) { %>
    <div class="search-not-found-bar">
      ¿No encontraste lo que buscabas?
      <button onclick="openModal('modalRequest')"><i class="bi bi-send"></i> Solicitar procedimiento</button>
    </div>
    <% } %>
  </div>

  <!-- RESULTADOS DE BÚSQUEDA -->
  <div class="search-results" id="searchResults"></div>

  <!-- ARTÍCULO DETALLE -->
  <div class="article-view card-ui" id="articleView">
    <div class="card-head" id="articleHead">
      <span class="title" id="articleTitle">Artículo</span>
      <button class="btn-sm btn-outline" onclick="closeArticle()"><i class="bi bi-arrow-left"></i> Volver</button>
    </div>
    <div class="article-content" id="articleContent"></div>
    <div class="helpful-bar">
      <span style="font-size:13px;color:var(--muted);">¿Fue útil este artículo?</span>
      <button class="btn-sm btn-success" onclick="vote('yes')"><i class="bi bi-hand-thumbs-up"></i> Sí</button>
      <button class="btn-sm btn-outline" onclick="vote('no')"><i class="bi bi-hand-thumbs-down"></i> No</button>
    </div>
  </div>

  <!-- TABS PRINCIPALES -->
  <div class="kb-tabs" id="mainTabs">
    <button class="kb-tab active" id="tabBtnArticulos" onclick="switchTab('articulos')">
      <i class="bi bi-file-text"></i> Artículos Técnicos
    </button>
    <button class="kb-tab" id="tabBtnProc" onclick="switchTab('procedimientos')">
      <i class="bi bi-diagram-3"></i> Gestión de Procedimientos
    </button>
    <button class="kb-tab" id="tabBtnLearning" onclick="switchTab('learning')">
      <i class="bi bi-mortarboard-fill"></i> Learning
    </button>
    <button class="kb-tab" id="tabBtnAportes" onclick="switchTab('aportes')">
      <i class="bi bi-people-fill"></i> Aportes de la Comunidad
      <span id="kbAportesBadge" style="display:none;background:var(--danger);color:#fff;border-radius:10px;padding:1px 7px;font-size:10px;margin-left:4px;"></span>
    </button>
    <% if (['administrador','especialista'].includes(user?.role)) { %>
    <button class="kb-tab" id="tabBtnSolicitudes" onclick="switchTab('solicitudes')">
      <i class="bi bi-inbox"></i> Solicitudes <span id="solBadge" style="display:none;background:var(--danger);color:#fff;border-radius:10px;padding:1px 7px;font-size:10px;margin-left:4px;"></span>
    </button>
    <% } %>
  </div>

  <!-- ─── TAB: ARTÍCULOS ─────────────────────────────────────────────────── -->
  <div class="section-tab active" id="tabArticulos">
    <div class="three-col" id="mainLayout">
      <!-- Categorías -->
      <div class="card-ui">
        <div class="card-head"><span class="title"><i class="bi bi-grid"></i> Categorías</span></div>
        <div id="catList"><div style="padding:16px;text-align:center;color:var(--muted);font-size:13px;">Cargando...</div></div>
      </div>

      <!-- Lista artículos -->
      <div class="card-ui">
        <div class="card-head">
          <span class="title" id="artListTitle"><i class="bi bi-file-text"></i> Artículos</span>
          <span id="artCount" style="font-size:12px;color:var(--muted);">—</span>
          <button id="artRefreshBtn" onclick="refreshArticles()" title="Actualizar" style="margin-left:auto;display:inline-flex;align-items:center;gap:5px;padding:5px 11px;border-radius:20px;border:1.5px solid var(--border,#e2e8f0);background:transparent;color:var(--muted,#64748b);font-size:11px;font-weight:600;cursor:pointer;transition:all .2s;">
            <i class="bi bi-arrow-clockwise" id="artRefreshIcon"></i> Actualizar
          </button>
        </div>
        <div id="artList"><div class="empty-state"><i class="bi bi-arrow-clockwise"></i> Cargando...</div></div>
      </div>

      <!-- Panel derecho -->
      <div>
        <div class="card-ui">
          <div class="card-head"><span class="title"><i class="bi bi-fire"></i> Más Populares</span></div>
          <div id="popList"><div class="empty-state"><i class="bi bi-arrow-clockwise"></i></div></div>
