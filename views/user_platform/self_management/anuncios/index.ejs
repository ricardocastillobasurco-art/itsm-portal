<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Anuncios Corporativos</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<style>
:root,[data-theme="light"]{
  --bg:#f0f4f9;--card:#fff;--border:#e2e8f0;
  --text:#1e293b;--muted:#64748b;--primary:#3b82f6;
  --grid:rgba(59,130,246,.07);--shine:rgba(255,255,255,.55);
  --shadow:0 2px 8px rgba(0,0,0,.06);--shadow-h:0 8px 24px rgba(59,130,246,.15);
}
[data-theme="dark"]{
  --bg:#0b1120;--card:#131f35;--border:#1e3050;
  --text:#e2e8f0;--muted:#94a3b8;--primary:#60a5fa;
  --grid:rgba(96,165,250,.06);--shine:rgba(255,255,255,.04);
  --shadow:0 2px 12px rgba(0,0,0,.4);--shadow-h:0 8px 28px rgba(96,165,250,.18);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{min-height:100%;font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden;}
body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:48px 48px;pointer-events:none;z-index:0;}

/* THEME TOGGLE */
.theme-toggle{position:fixed;top:14px;right:16px;z-index:9999;display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--border);border-radius:30px;padding:6px 14px 6px 10px;box-shadow:var(--shadow);cursor:pointer;user-select:none;}
.toggle-track{width:40px;height:22px;background:var(--border);border-radius:11px;position:relative;flex-shrink:0;}
.toggle-knob{width:16px;height:16px;background:#fff;border-radius:50%;position:absolute;top:3px;left:3px;transition:transform .3s;box-shadow:0 1px 4px rgba(0,0,0,.3);}
[data-theme="dark"] .toggle-knob{transform:translateX(18px);}
[data-theme="dark"] .toggle-track{background:var(--primary);}
.toggle-label{font-size:12px;font-weight:600;color:var(--muted);}

/* LAYOUT */
.wrapper{position:relative;z-index:1;max-width:680px;margin:0 auto;padding:0 16px 80px;}

/* HEADER */
.page-header{background:linear-gradient(135deg,#1e3a5f,#2563eb,#0ea5e9);border-radius:0 0 24px 24px;padding:28px 28px 32px;margin-bottom:24px;position:relative;overflow:hidden;color:#fff;}
.page-header::after{content:'';position:absolute;top:-40px;right:-40px;width:180px;height:180px;background:rgba(255,255,255,.07);border-radius:50%;}
.page-header::before{content:'';position:absolute;bottom:-30px;left:-20px;width:120px;height:120px;background:rgba(255,255,255,.05);border-radius:50%;}
.ph-welcome{font-size:13px;font-weight:600;letter-spacing:.4px;opacity:.8;text-transform:uppercase;margin-bottom:4px;}
.ph-name{font-size:24px;font-weight:800;letter-spacing:-.5px;margin-bottom:2px;}
.ph-sub{font-size:13px;opacity:.75;display:flex;align-items:center;gap:6px;}
.ph-back{position:absolute;top:16px;left:20px;color:rgba(255,255,255,.8);text-decoration:none;display:flex;align-items:center;gap:5px;font-size:13px;font-weight:600;transition:color .2s;}
.ph-back:hover{color:#fff;}
.ph-badge{position:absolute;top:16px;right:70px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);border-radius:20px;padding:4px 12px;font-size:11px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;}

/* COMPOSE */
.compose-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:18px;margin-bottom:20px;box-shadow:var(--shadow);}
.compose-header{display:flex;align-items:center;gap:12px;margin-bottom:14px;}
.compose-avatar{width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;color:#fff;flex-shrink:0;}
.compose-placeholder{flex:1;background:var(--bg);border:1.5px solid var(--border);border-radius:22px;padding:10px 16px;font-size:14px;color:var(--muted);cursor:pointer;transition:border-color .2s;}
.compose-placeholder:hover{border-color:var(--primary);}
.compose-form{display:none;flex-direction:column;gap:10px;}
.compose-form.open{display:flex;}
.cf-title{padding:9px 13px;border-radius:10px;border:1.5px solid var(--border);background:var(--bg);color:var(--text);font-size:14px;font-weight:600;}
.cf-title:focus{outline:none;border-color:var(--primary);}
.cf-body{padding:9px 13px;border-radius:10px;border:1.5px solid var(--border);background:var(--bg);color:var(--text);font-size:14px;resize:vertical;min-height:90px;}
.cf-body:focus{outline:none;border-color:var(--primary);}
.cf-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;}
.cf-audience{padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--text);font-size:13px;}
.cf-actions{display:flex;gap:8px;}
.btn-cancel{padding:7px 16px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--muted);font-size:13px;font-weight:600;cursor:pointer;}
.btn-publish{padding:7px 20px;border-radius:8px;border:none;background:var(--primary);color:#fff;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px;}
.btn-publish:disabled{opacity:.6;cursor:not-allowed;}

/* FEED */
.feed{display:flex;flex-direction:column;gap:16px;}
.post-card{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;box-shadow:var(--shadow);transition:box-shadow .25s;}
.post-card:hover{box-shadow:var(--shadow-h);}

.post-head{padding:16px 18px 0;display:flex;align-items:flex-start;gap:12px;}
.post-avatar{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;color:#fff;flex-shrink:0;}
.post-meta{flex:1;}
.post-author{font-size:14px;font-weight:700;color:var(--text);}
.post-email{font-size:12px;color:var(--muted);}
.post-time{font-size:11px;color:var(--muted);margin-top:1px;}
.post-pin{display:inline-flex;align-items:center;gap:4px;background:rgba(245,158,11,.12);color:#d97706;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;margin-left:6px;}

.post-body{padding:12px 18px 14px 74px;}
.post-title{font-size:16px;font-weight:800;color:var(--text);margin-bottom:6px;line-height:1.3;}
.post-text{font-size:14px;color:var(--text);line-height:1.6;white-space:pre-wrap;}
.post-audience-tag{display:inline-flex;align-items:center;gap:4px;margin-top:10px;background:rgba(59,130,246,.08);color:var(--primary);border:1px solid rgba(59,130,246,.2);border-radius:10px;padding:3px 10px;font-size:11px;font-weight:600;}

/* REACTIONS BAR */
.reactions-bar{padding:10px 18px;border-top:1px solid var(--border);display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
.react-summary{display:flex;align-items:center;gap:4px;font-size:12px;color:var(--muted);flex:1;}
.react-pill{display:inline-flex;align-items:center;gap:3px;font-size:12px;}

.post-actions{display:flex;gap:4px;padding:0 14px 12px;border-top:none;}
.action-btn{flex:1;padding:8px 6px;border:none;border-radius:10px;background:transparent;color:var(--muted);font-size:12.5px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;transition:background .2s,color .2s;}
.action-btn:hover{background:rgba(59,130,246,.08);color:var(--primary);}
.action-btn.reacted{color:var(--primary);}
.action-btn.liked{color:#ef4444;}
.action-btn.loved{color:#ef4444;}
.action-btn.clapped{color:#f59e0b;}
.action-btn.insighted{color:#8b5cf6;}

/* REACTION PICKER */
.react-picker{display:none;position:absolute;background:var(--card);border:1px solid var(--border);border-radius:30px;padding:6px 10px;box-shadow:0 8px 24px rgba(0,0,0,.15);z-index:100;gap:4px;bottom:calc(100% + 8px);left:0;}
.react-picker.open{display:flex;}
.rp-btn{width:36px;height:36px;border:none;background:transparent;font-size:20px;cursor:pointer;border-radius:50%;transition:transform .15s,background .15s;display:flex;align-items:center;justify-content:center;}
.rp-btn:hover{transform:scale(1.3);background:rgba(59,130,246,.08);}
.rp-wrap{position:relative;}

/* COMMENTS */
.comments-section{display:none;padding:0 18px 14px;border-top:1px solid var(--border);}
.comments-section.open{display:block;}
.comment-list{display:flex;flex-direction:column;gap:10px;margin-bottom:12px;margin-top:12px;}
.comment-item{display:flex;gap:10px;}
.c-avatar{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#fff;flex-shrink:0;}
.c-bubble{flex:1;background:var(--bg);border-radius:0 12px 12px 12px;padding:8px 12px;}
.c-author{font-size:12px;font-weight:700;color:var(--text);}
.c-email{font-size:11px;color:var(--muted);}
.c-text{font-size:13px;color:var(--text);margin-top:3px;line-height:1.5;}
.c-time{font-size:10px;color:var(--muted);margin-top:2px;}
.comment-input-row{display:flex;gap:8px;align-items:flex-end;}
.comment-input{flex:1;padding:9px 13px;border-radius:22px;border:1.5px solid var(--border);background:var(--bg);color:var(--text);font-size:13px;resize:none;min-height:38px;max-height:100px;}
.comment-input:focus{outline:none;border-color:var(--primary);}
.c-send{width:36px;height:36px;border-radius:50%;border:none;background:var(--primary);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;}

/* EMPTY STATE */
.empty-feed{text-align:center;padding:60px 20px;color:var(--muted);}
.empty-feed i{font-size:48px;opacity:.3;display:block;margin-bottom:12px;}

/* LOADING */
.skeleton{background:linear-gradient(90deg,var(--border) 25%,var(--bg) 50%,var(--border) 75%);background-size:200% 100%;animation:sk .8s infinite;border-radius:8px;}
@keyframes sk{0%{background-position:200% 0}100%{background-position:-200% 0}}

/* TOAST */
.toast-container{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);z-index:9999;display:flex;flex-direction:column;gap:6px;align-items:center;}
.toast{background:#1e293b;color:#fff;padding:10px 20px;border-radius:10px;font-size:13px;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,.2);animation:fadeUp .3s ease both;}
.toast.success{background:#065f46;}.toast.error{background:#991b1b;}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeDown{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}
</style>
</head>
<body>
<div class="toast-container" id="toastCont"></div>

<!-- Theme toggle -->
<div class="theme-toggle" onclick="toggleTheme()">
  <div class="toggle-track"><div class="toggle-knob"></div></div>
  <span class="toggle-label" id="thLbl">Oscuro</span>
</div>

<div class="wrapper">
  <!-- HEADER -->
  <div class="page-header" style="animation:fadeDown .5s ease both;">
    <a href="/autogestion" class="ph-back"><i class="bi bi-arrow-left-circle-fill"></i> Portal</a>
    <div class="ph-badge"><i class="bi bi-megaphone-fill"></i> Corporativo</div>
    <div style="margin-top:8px;">
      <div class="ph-welcome">Bienvenido/a</div>
      <div class="ph-name" id="welcomeName">—</div>
      <div class="ph-sub"><i class="bi bi-envelope-fill" style="font-size:11px;"></i> <span id="welcomeEmail">—</span></div>
    </div>
  </div>

  <!-- COMPOSE -->
  <div class="compose-card" id="composeCard">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
      <div class="compose-avatar" id="composeAvatar" style="background:#3b82f6;">?</div>
      <div>
        <div style="font-size:13px;font-weight:700;color:var(--text);" id="composeName">Publicar anuncio</div>
        <div style="font-size:11px;color:var(--muted);">Tu comunicado será visible para todos los colaboradores</div>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;">
      <input type="text" class="cf-title" id="cfTitle" placeholder="📌 Título del anuncio (ej: Mantenimiento programado)">
      <textarea class="cf-body" id="cfBody" placeholder="✍️  Escribe el comunicado corporativo aquí..." style="min-height:100px;"></textarea>

      <!-- Image upload -->
      <div id="cfImagePreviewWrap" style="display:none;position:relative;border-radius:10px;overflow:hidden;">
        <img id="cfImagePreview" src="" alt="" style="width:100%;max-height:260px;object-fit:cover;border-radius:10px;">
        <button onclick="removeImage()" style="position:absolute;top:8px;right:8px;background:rgba(0,0,0,.6);color:#fff;border:none;border-radius:50%;width:28px;height:28px;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;"><i class="bi bi-x"></i></button>
      </div>
      <input type="file" id="cfImageFile" accept="image/*" style="display:none;" onchange="previewImage(this)">

      <div class="cf-footer">
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <button onclick="document.getElementById('cfImageFile').click()" style="padding:7px 12px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--muted);font-size:12px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:5px;"><i class="bi bi-image"></i> Imagen</button>
          <select class="cf-audience" id="cfAudience">
            <option value="todos">🌐 Todos</option>
            <option value="TI">💻 Equipo TI</option>
            <option value="gerencia">👔 Gerencia</option>
            <option value="operaciones">⚙️ Operaciones</option>
          </select>
        </div>
        <button class="btn-publish" id="btnPublish" onclick="publishPost()"><i class="bi bi-send-fill"></i> Publicar</button>
      </div>
    </div>
  </div>

  <!-- SEARCH BAR -->
  <div style="position:relative;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:10px 14px;margin-bottom:16px;display:flex;align-items:center;gap:10px;box-shadow:var(--shadow);">
    <i class="bi bi-search" style="color:var(--muted);font-size:15px;flex-shrink:0;"></i>
    <input id="searchAuthor" type="text" placeholder="Buscar publicaciones por correo del autor..."
      autocomplete="off"
      style="flex:1;border:none;background:transparent;color:var(--text);font-size:13px;outline:none;"
      oninput="onSearchInput()" onkeydown="onSearchKey(event)" onfocus="onSearchInput()">
    <button id="btnClearSearch" onclick="clearSearch()" title="Limpiar búsqueda"
      style="display:none;border:none;background:var(--border);color:var(--muted);border-radius:50%;width:22px;height:22px;font-size:14px;cursor:pointer;line-height:1;padding:0;flex-shrink:0;">×</button>
    <!-- Autocomplete dropdown -->
    <div id="authorDropdown"
      style="display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--card);border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:200;max-height:220px;overflow-y:auto;">
    </div>
  </div>

  <!-- FEED -->
  <div class="feed" id="feed">
    <div style="text-align:center;padding:40px;color:var(--muted);">
      <div class="skeleton" style="height:120px;margin-bottom:12px;border-radius:16px;"></div>
      <div class="skeleton" style="height:120px;margin-bottom:12px;border-radius:16px;"></div>
    </div>
  </div>
</div>

<script>
// ── SESSION ─────────────────────────────────────────────────────────────────
// Helpers defined first so they can be used immediately
function avatarInitials(name){
  const n = (name||'?').trim();
  const parts = n.split(/\s+/).filter(Boolean);
  if(parts.length>=2) return (parts[0][0]+(parts[parts.length-1][0])).toUpperCase();
  return n.slice(0,2).toUpperCase();
}
function avatarColor(str){
  const colors=['#3b82f6','#10b981','#8b5cf6','#f59e0b','#ef4444','#06b6d4','#ec4899'];
  let h=0; for(let c of (str||'X')) h=(h<<5)-h+c.charCodeAt(0)|0;
  return colors[Math.abs(h)%colors.length];
}

// Priority: EJS server values → URL params → localStorage
let _userEmail = <%- JSON.stringify(reporterEmail || '') %>;
let _userName  = <%- JSON.stringify(reporterName  || '') %>;
<% if (user) { %>
_userEmail = <%- JSON.stringify(user.email        || '') %>;
_userName  = <%- JSON.stringify(user.full_name || user.name || user.email || '') %>;
<% } %>
// Fallback to URL params if server didn't provide
if(!_userEmail){ const p=new URLSearchParams(window.location.search); _userEmail=p.get('reporter')||''; }
if(!_userName) { const p=new URLSearchParams(window.location.search); _userName =p.get('name')    ||''; }
// Final fallback: localStorage
if(!_userEmail) _userEmail = localStorage.getItem('portal_user_email') || '';
if(!_userName)  _userName  = localStorage.getItem('portal_user_name')  || '';

// Persist for cross-page use
if(_userEmail) localStorage.setItem('portal_user_email', _userEmail);
if(_userName)  localStorage.setItem('portal_user_name',  _userName);

// Welcome header
document.getElementById('welcomeName').textContent  = _userName  || 'Usuario';
document.getElementById('welcomeEmail').textContent = _userEmail || '';

// Compose avatar init
function updateComposeAvatar(){
  const el = document.getElementById('composeAvatar');
  if(!el) return;
  el.textContent   = avatarInitials(_userName || _userEmail || '?');
  el.style.background = avatarColor(_userEmail || '');
}
updateComposeAvatar();

// ── THEME ───────────────────────────────────────────────────────────────────
function toggleTheme(){ const t=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark'; document.documentElement.setAttribute('data-theme',t); localStorage.setItem('theme',t); document.getElementById('thLbl').textContent=t==='dark'?'Claro':'Oscuro'; }
(function(){ const t=localStorage.getItem('theme')||'light'; document.documentElement.setAttribute('data-theme',t); document.getElementById('thLbl').textContent=t==='dark'?'Claro':'Oscuro'; })();

// ── TOAST ───────────────────────────────────────────────────────────────────
function toast(msg, type='info'){ const el=document.createElement('div'); el.className='toast '+type; el.textContent=msg; document.getElementById('toastCont').appendChild(el); setTimeout(()=>el.remove(),3200); }

// ── COMPOSE ──────────────────────────────────────────────────────────────────
// Update compose name display
(function(){ const el=document.getElementById('composeName'); if(el&&_userName) el.textContent=_userName; })();

let _cfImageBase64 = null;
function previewImage(input){
  const file = input.files[0];
  if(!file) return;
  if(file.size > 8*1024*1024){ toast('La imagen no debe superar 8MB','error'); return; }
  const reader = new FileReader();
  reader.onload = e => {
    const img = new Image();
    img.onload = () => {
      // Compress: max 900px wide, quality 0.80
      const MAX = 900;
      let w = img.width, h = img.height;
      if(w > MAX){ h = Math.round(h * MAX / w); w = MAX; }
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      canvas.getContext('2d').drawImage(img, 0, 0, w, h);
      _cfImageBase64 = canvas.toDataURL('image/jpeg', 0.80);
      document.getElementById('cfImagePreview').src = _cfImageBase64;
      document.getElementById('cfImagePreviewWrap').style.display = 'block';
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}
function removeImage(){
  _cfImageBase64 = null;
  document.getElementById('cfImageFile').value = '';
  document.getElementById('cfImagePreviewWrap').style.display = 'none';
  document.getElementById('cfImagePreview').src = '';
}

async function publishPost(){
  const body = document.getElementById('cfBody').value.trim();
  if(!body){ toast('Escribe el contenido del anuncio','error'); return; }
  if(!_userEmail){ toast('Regresa a /autogestion e identifícate primero','error'); return; }
  const btn = document.getElementById('btnPublish');
  btn.disabled = true; btn.innerHTML='<i class="bi bi-hourglass-split"></i> Publicando...';
  try {
    const r = await fetch('/api/portal/announcements', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        title:        document.getElementById('cfTitle').value.trim() || null,
        body,
        image_data:   _cfImageBase64 || null,
        audience:     document.getElementById('cfAudience').value,
        author_email: _userEmail,
        author_name:  _userName || _userEmail,
      })
    });
    const d = await r.json();
    if(d.success){
      document.getElementById('cfTitle').value = '';
      document.getElementById('cfBody').value  = '';
      removeImage();
      prependPost(d.data);
      toast('✅ Anuncio publicado correctamente','success');
    } else toast(d.error||'Error al publicar','error');
  } catch(e){ toast('Error de conexión','error'); }
  finally{ btn.disabled=false; btn.innerHTML='<i class="bi bi-send-fill"></i> Publicar'; }
}

// ── FEED ─────────────────────────────────────────────────────────────────────
const _reactionEmoji = { like:'👍', love:'❤️', clap:'👏', insight:'💡' };
const _reactionLabel = { like:'Me gusta', love:'Me encanta', clap:'Aplauso', insight:'Interesante' };

function timeAgo(dateStr){
  const d = new Date(dateStr), now = new Date();
  const s = Math.floor((now-d)/1000);
  if(s<60) return 'ahora';
  if(s<3600) return Math.floor(s/60)+'m';
  if(s<86400) return Math.floor(s/3600)+'h';
  if(s<604800) return Math.floor(s/86400)+'d';
  return d.toLocaleDateString('es-PE',{day:'2-digit',month:'short'});
}

function buildPost(p){
  const initials = avatarInitials(p.author_name||p.author_email||'?');
  const color    = avatarColor(p.author_email||'');
  const reactions = Object.entries(_reactionEmoji).filter(([k])=>(p['r_'+k]||0)>0)
    .map(([k])=>`<span class="react-pill">${_reactionEmoji[k]} ${p['r_'+k]}</span>`).join(' ');
  const myReact  = p.my_reaction || '';
  const reactClass = myReact ? (myReact==='like'?'liked':myReact==='love'?'loved':myReact==='clap'?'clapped':'insighted') : '';
  const pinTag = p.pinned ? `<span class="post-pin"><i class="bi bi-pin-fill"></i> Destacado</span>` : '';
  const audTag = p.audience && p.audience!=='todos' ? `<span class="post-audience-tag"><i class="bi bi-people-fill"></i> ${p.audience}</span>` : '';
  const titleHtml = p.title ? `<div class="post-title">${escHtml(p.title)}</div>` : '';
  const imageHtml = p.image_data ? `<div style="margin-top:10px;border-radius:12px;overflow:hidden;"><img src="${p.image_data}" alt="imagen" style="width:100%;max-height:320px;object-fit:cover;display:block;"></div>` : '';
  const totalReacts = (p.r_like||0)+(p.r_love||0)+(p.r_clap||0)+(p.r_insight||0);

  return `<div class="post-card" id="post-${p.id}" data-id="${p.id}">
    <div class="post-head">
      <div class="post-avatar" style="background:${color};">${initials}</div>
      <div class="post-meta">
        <div class="post-author">${escHtml(p.author_name||p.author_email||'Anónimo')}${pinTag}</div>
        <div class="post-email">${escHtml(p.author_email||'')}</div>
        <div class="post-time">${timeAgo(p.created_at)}</div>
      </div>
    </div>
    <div class="post-body">
      ${titleHtml}
      <div class="post-text">${escHtml(p.body)}</div>
      ${imageHtml}
      ${audTag}
    </div>
    <div class="reactions-bar">
      <div class="react-summary">${totalReacts>0?reactions:'<span style="font-size:11px;">Sé el primero en reaccionar</span>'}</div>
      <span style="font-size:12px;color:var(--muted);">${p.comment_count||0} comentario${(p.comment_count||0)!==1?'s':''}</span>
    </div>
    <div class="post-actions">
      <div class="rp-wrap">
        <div class="react-picker" id="rp-${p.id}">
          <button class="rp-btn" onclick="react(${p.id},'like')"   title="Me gusta">👍</button>
          <button class="rp-btn" onclick="react(${p.id},'love')"    title="Me encanta">❤️</button>
          <button class="rp-btn" onclick="react(${p.id},'clap')"    title="Aplauso">👏</button>
          <button class="rp-btn" onclick="react(${p.id},'insight')" title="Interesante">💡</button>
        </div>
        <button class="action-btn ${reactClass}" id="rbtn-${p.id}" onclick="togglePicker(${p.id})" onmouseleave="scheduleClosePicker(${p.id})">
          ${myReact?_reactionEmoji[myReact]+' '+_reactionLabel[myReact]:'👍 Reaccionar'}
        </button>
      </div>
      <button class="action-btn" onclick="toggleComments(${p.id})">
        <i class="bi bi-chat-dots"></i> Comentar
      </button>
    </div>
    <div class="comments-section" id="cs-${p.id}">
      <div class="comment-list" id="cl-${p.id}"></div>
      <div class="comment-input-row">
        <div class="c-avatar" style="background:${avatarColor(_userEmail)};">${avatarInitials(_userName||_userEmail)}</div>
        <textarea class="comment-input" id="ci-${p.id}" placeholder="Escribe un comentario..." rows="1" oninput="autoResize(this)" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendComment(${p.id});}"></textarea>
        <button class="c-send" onclick="sendComment(${p.id})"><i class="bi bi-send-fill" style="font-size:13px;"></i></button>
      </div>
    </div>
  </div>`;
}

function escHtml(s){ const d=document.createElement('div');d.textContent=s||'';return d.innerHTML; }
function autoResize(el){ el.style.height='auto'; el.style.height=el.scrollHeight+'px'; }

// ── AUTHOR SEARCH / AUTOCOMPLETE ─────────────────────────────────────────────
let _allAuthors = [];
let _activeAuthorFilter = '';

async function loadAuthors(){
  try {
    const r = await fetch('/api/portal/announcements/authors');
    const d = await r.json();
    if(d.success) _allAuthors = d.data || [];
  } catch(e) {}
}

function onSearchInput(){
  const val = (document.getElementById('searchAuthor').value || '').toLowerCase().trim();
  const dd = document.getElementById('authorDropdown');
  document.getElementById('btnClearSearch').style.display = (val || _activeAuthorFilter) ? 'block' : 'none';
  if(!val){
    dd.style.display = 'none';
    if(_activeAuthorFilter){ _activeAuthorFilter = ''; loadFeed(); }
    return;
  }
  const matches = _allAuthors.filter(function(a){
    return (a.author_email||'').toLowerCase().includes(val) || (a.author_name||'').toLowerCase().includes(val);
  }).slice(0, 8);
  if(!matches.length){ dd.style.display = 'none'; return; }
  dd.innerHTML = matches.map(function(a){ return `
    <div onclick="selectAuthor(this.dataset.email,this.dataset.name)"
      data-email="${escHtml(a.author_email||'')}" data-name="${escHtml(a.author_name||'')}"
      style="padding:10px 14px;cursor:pointer;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--border);font-size:13px;"
      onmouseover="this.style.background='rgba(59,130,246,.08)'" onmouseout="this.style.background=''">
      <div style="width:30px;height:30px;border-radius:50%;background:${avatarColor(a.author_email||'')};display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#fff;flex-shrink:0;">${avatarInitials(a.author_name||a.author_email)}</div>
      <div>
        <div style="font-weight:600;color:var(--text);">${escHtml(a.author_name||a.author_email)}</div>
        <div style="font-size:11px;color:var(--muted);">${escHtml(a.author_email)}</div>
      </div>
    </div>`; }).join('');
  dd.style.display = 'block';
}

function onSearchKey(e){
  if(e.key === 'Escape'){ clearSearch(); return; }
  if(e.key === 'Enter'){
    const val = (document.getElementById('searchAuthor').value || '').trim();
    if(val){ selectAuthor(val, val); }
  }
}

function selectAuthor(email, name){
  document.getElementById('searchAuthor').value = email;
  document.getElementById('authorDropdown').style.display = 'none';
  document.getElementById('btnClearSearch').style.display = 'block';
  _activeAuthorFilter = email;
  loadFeed(email);
}

function clearSearch(){
  document.getElementById('searchAuthor').value = '';
  document.getElementById('authorDropdown').style.display = 'none';
  document.getElementById('btnClearSearch').style.display = 'none';
  _activeAuthorFilter = '';
  loadFeed();
}

document.addEventListener('click', function(e){
  if(!e.target.closest('#searchAuthor') && !e.target.closest('#authorDropdown')){
    document.getElementById('authorDropdown').style.display = 'none';
  }
});

async function loadFeed(authorFilter){
  const feed = document.getElementById('feed');
  const author = authorFilter !== undefined ? authorFilter : _activeAuthorFilter;
  try {
    let url = `/api/portal/announcements?email=${encodeURIComponent(_userEmail)}&limit=30`;
    if(author) url += `&author=${encodeURIComponent(author)}`;
    const r = await fetch(url);
    const d = await r.json();
    if(!d.success||!d.data?.length){
      const msg = author ? `No se encontraron publicaciones de <strong>${escHtml(author)}</strong>` : '¡Sé el primero en publicar un comunicado!';
      feed.innerHTML=`<div class="empty-feed"><i class="bi bi-megaphone"></i><div style="font-size:15px;font-weight:600;margin-bottom:4px;">${author?'Sin resultados':'Aún no hay anuncios'}</div><div style="font-size:13px;">${msg}</div></div>`;
      return;
    }
    feed.innerHTML = d.data.map(buildPost).join('');
  } catch(e){ feed.innerHTML=`<div class="empty-feed"><i class="bi bi-wifi-off"></i><div>Error al cargar el feed</div></div>`; }
}

function prependPost(p){
  const feed = document.getElementById('feed');
  const emptyState = feed.querySelector('.empty-feed');
  if(emptyState) feed.innerHTML='';
  feed.insertAdjacentHTML('afterbegin', buildPost(p));
}

// ── REACTIONS ────────────────────────────────────────────────────────────────
let _pickerTimer = {};
function togglePicker(id){
  const picker = document.getElementById('rp-'+id);
  const isOpen = picker.classList.contains('open');
  document.querySelectorAll('.react-picker.open').forEach(el=>el.classList.remove('open'));
  if(!isOpen) picker.classList.add('open');
}
function scheduleClosePicker(id){ _pickerTimer[id]=setTimeout(()=>{ const el=document.getElementById('rp-'+id); if(el) el.classList.remove('open'); },400); }
document.addEventListener('click', e=>{ if(!e.target.closest('.rp-wrap')) document.querySelectorAll('.react-picker.open').forEach(el=>el.classList.remove('open')); });

async function react(postId, reaction){
  if(!_userEmail){ toast('Identifícate primero','error'); return; }
  document.getElementById('rp-'+postId)?.classList.remove('open');
  try {
    const r = await fetch(`/api/portal/announcements/${postId}/react`, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ email: _userEmail, reaction })
    });
    const d = await r.json();
    if(d.success) refreshPost(postId);
  } catch(e) {}
}

async function refreshPost(postId){
  try {
    const r = await fetch(`/api/portal/announcements?email=${encodeURIComponent(_userEmail)}&limit=50`);
    const d = await r.json();
    const p = d.data?.find(x=>x.id===postId);
    if(!p) return;
    const card = document.getElementById('post-'+postId);
    if(!card) return;
    const commentsOpen = document.getElementById('cs-'+postId)?.classList.contains('open');
    card.outerHTML = buildPost(p);
    if(commentsOpen) document.getElementById('cs-'+postId)?.classList.add('open');
  } catch(e) {}
}

// ── COMMENTS ─────────────────────────────────────────────────────────────────
async function toggleComments(postId){
  const cs = document.getElementById('cs-'+postId);
  if(!cs) return;
  const isOpen = cs.classList.toggle('open');
  if(isOpen) await loadComments(postId);
}

async function loadComments(postId){
  const list = document.getElementById('cl-'+postId);
  if(!list) return;
  try {
    const r = await fetch(`/api/portal/announcements/${postId}/comments`);
    const d = await r.json();
    if(!d.data?.length){ list.innerHTML='<div style="font-size:12px;color:var(--muted);padding:6px 0;">Aún no hay comentarios. ¡Sé el primero!</div>'; return; }
    list.innerHTML = d.data.map(c=>{
      const ini = avatarInitials(c.author_name||c.email);
      const col = avatarColor(c.email||'');
      return `<div class="comment-item">
        <div class="c-avatar" style="background:${col};">${ini}</div>
        <div class="c-bubble">
          <div><span class="c-author">${escHtml(c.author_name||c.email)}</span> <span class="c-email">${escHtml(c.email)}</span></div>
          <div class="c-text">${escHtml(c.body)}</div>
          <div class="c-time">${timeAgo(c.created_at)}</div>
        </div>
      </div>`;
    }).join('');
  } catch(e) {}
}

async function sendComment(postId){
  if(!_userEmail){ toast('Identifícate primero','error'); return; }
  const input = document.getElementById('ci-'+postId);
  const body  = input?.value.trim();
  if(!body) return;
  input.value=''; input.style.height='';
  try {
    const r = await fetch(`/api/portal/announcements/${postId}/comments`, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ email: _userEmail, author_name: _userName||_userEmail, body })
    });
    const d = await r.json();
    if(d.success){ await loadComments(postId); toast('Comentario publicado','success'); }
  } catch(e){ toast('Error al comentar','error'); }
}

// ── INIT ─────────────────────────────────────────────────────────────────────
loadAuthors();
loadFeed();
</script>
</body>
</html>
