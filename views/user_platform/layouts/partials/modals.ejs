        </div>
        <!-- Create form (expands inline) -->
        <div id="anuncioCreateForm" style="display:none;background:var(--bg-main);border:1px solid var(--border-soft);border-radius:12px;padding:16px;margin-bottom:12px;">
          <div style="font-size:13px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:8px;"><i class="bi bi-megaphone" style="color:#ea580c;"></i> Nuevo anuncio</div>
          <input type="text" id="newAnuncioTitle" placeholder="Título del anuncio *" style="width:100%;border:1.5px solid var(--border-soft);border-radius:8px;padding:8px 12px;font-size:13px;background:var(--bg-card);color:var(--text-main);outline:none;margin-bottom:8px;box-sizing:border-box;">
          <textarea id="newAnuncioBody" rows="3" placeholder="Mensaje *" style="width:100%;border:1.5px solid var(--border-soft);border-radius:8px;padding:8px 12px;font-size:13px;background:var(--bg-card);color:var(--text-main);outline:none;resize:vertical;font-family:inherit;box-sizing:border-box;margin-bottom:8px;"></textarea>
          <label style="display:flex;align-items:center;gap:8px;border:1.5px dashed var(--border-soft);border-radius:8px;padding:8px 12px;cursor:pointer;margin-bottom:8px;font-size:12px;color:var(--text-muted);" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--border-soft)'">
            <i class="bi bi-image" style="font-size:16px;"></i> <span id="newAnuncioImgLabel">Adjuntar imagen (opcional)</span>
            <input type="file" id="newAnuncioImg" accept="image/*" style="display:none;" onchange="document.getElementById('newAnuncioImgLabel').textContent=this.files[0]?this.files[0].name:'Adjuntar imagen (opcional)'">
          </label>
          <div style="display:flex;gap:8px;justify-content:flex-end;">
            <button onclick="document.getElementById('anuncioCreateForm').style.display='none';document.getElementById('newAnuncioImgLabel').textContent='Adjuntar imagen (opcional)';" style="padding:7px 16px;border-radius:7px;border:1.5px solid var(--border-soft);background:transparent;color:var(--text-muted);font-size:12px;font-weight:600;cursor:pointer;">Cancelar</button>
            <button onclick="publicarAnuncio()" style="padding:7px 18px;border-radius:7px;border:none;background:#ea580c;color:#fff;font-size:12px;font-weight:700;cursor:pointer;"><i class="bi bi-megaphone-fill"></i> Publicar</button>
          </div>
        </div>
        <div style="border-top:1px solid var(--border-soft);margin-bottom:12px;"></div>
        <!-- Feed -->
        <div id="anunciosList">
          <div style="text-align:center;padding:28px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i> Cargando anuncios...</div>
        </div>
      </div>

      <!-- TAB: Comunidad -->
      <div class="anuncios-tab-panel" id="tap-comunidad">
        <!-- LIST VIEW -->
        <div id="comunListView">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
            <div style="font-size:13px;font-weight:700;color:var(--text-main);">Comunidades del equipo</div>
            <button onclick="toggleCrearComunForm()" style="padding:6px 14px;border-radius:8px;border:none;background:var(--primary);color:#fff;font-size:12px;font-weight:700;cursor:pointer;"><i class="bi bi-plus-lg"></i> Crear</button>
          </div>
          <div id="crearComunForm" style="display:none;background:var(--bg-main);border:1px solid var(--border-soft);border-radius:12px;padding:14px;margin-bottom:12px;">
            <div style="font-size:13px;font-weight:700;margin-bottom:10px;">Nueva comunidad</div>
            <input type="text" id="comunNombre" placeholder="Nombre *" style="width:100%;border:1.5px solid var(--border-soft);border-radius:8px;padding:8px 12px;font-size:13px;background:var(--bg-card);color:var(--text-main);outline:none;margin-bottom:8px;box-sizing:border-box;">
            <textarea id="comunDesc" rows="2" placeholder="Descripción breve *" style="width:100%;border:1.5px solid var(--border-soft);border-radius:8px;padding:8px 12px;font-size:13px;background:var(--bg-card);color:var(--text-main);outline:none;resize:vertical;font-family:inherit;box-sizing:border-box;margin-bottom:10px;"></textarea>
            <div style="display:flex;gap:8px;justify-content:flex-end;">
              <button onclick="toggleCrearComunForm()" style="padding:7px 14px;border-radius:7px;border:1.5px solid var(--border-soft);background:transparent;color:var(--text-muted);font-size:12px;font-weight:600;cursor:pointer;">Cancelar</button>
              <button onclick="crearComunidad()" style="padding:7px 18px;border-radius:7px;border:none;background:var(--primary);color:#fff;font-size:12px;font-weight:700;cursor:pointer;"><i class="bi bi-people-fill"></i> Crear comunidad</button>
            </div>
          </div>
          <div id="comunidadList"><div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i> Cargando...</div></div>
        </div>
        <!-- FEED VIEW -->
        <div id="comunFeedView" style="display:none;">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
            <button onclick="salirComunFeed()" style="padding:6px 12px;border-radius:8px;border:1.5px solid var(--border-soft);background:transparent;color:var(--text-muted);font-size:12px;font-weight:700;cursor:pointer;"><i class="bi bi-arrow-left"></i> Volver</button>
            <div id="comunFeedNombre" style="flex:1;font-size:14px;font-weight:800;color:var(--text-main);"></div>
            <button id="comunInviteBtn" onclick="toggleComunInvite()" style="padding:6px 12px;border-radius:8px;border:none;background:rgba(59,130,246,.1);color:var(--primary);font-size:12px;font-weight:700;cursor:pointer;"><i class="bi bi-person-plus-fill"></i> Invitar</button>
          </div>
          <div id="comunInviteForm" style="display:none;background:var(--bg-main);border:1px solid var(--border-soft);border-radius:10px;padding:12px;margin-bottom:12px;">
            <div style="font-size:12px;font-weight:700;margin-bottom:8px;">Invitar a esta comunidad</div>
            <div style="display:flex;gap:8px;">
              <input type="text" id="comunInviteEmail" placeholder="correo@empresa.com" style="flex:1;border:1.5px solid var(--border-soft);border-radius:8px;padding:7px 11px;font-size:13px;background:var(--bg-card);color:var(--text-main);outline:none;">
              <button onclick="enviarInvitacion()" style="padding:7px 16px;border-radius:8px;border:none;background:var(--primary);color:#fff;font-size:12px;font-weight:700;cursor:pointer;">Enviar</button>
            </div>
          </div>
          <div id="comunFeedList"><div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i> Cargando feed...</div></div>
        </div>
      </div>

      <!-- TAB: Iniciativas -->
      <div class="anuncios-tab-panel" id="tap-iniciativas" style="padding-bottom:16px;">
        <div id="iniciativasList" style="margin-bottom:16px;"></div>
        <button onclick="toggleIniciativaForm()" style="width:100%;margin-bottom:12px;padding:10px;border:1.5px dashed var(--border-soft);border-radius:10px;background:transparent;color:var(--text-muted);font-size:13px;font-weight:600;cursor:pointer;">
          <i class="bi bi-plus-lg"></i> Crear iniciativa
        </button>
        <div id="iniciativaForm" style="display:none;background:var(--bg-main);border:1px solid var(--border-soft);border-radius:12px;padding:16px;">
          <div style="font-size:13px;font-weight:800;margin-bottom:14px;">Nueva Iniciativa</div>
          <div class="iniciativa-field"><label>Título *</label><input type="text" id="inTitulo" placeholder="Título de la iniciativa"></div>
          <div class="iniciativa-field"><label>Descripción *</label><textarea id="inDesc" rows="3" placeholder="Describe la iniciativa..."></textarea></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
            <div class="iniciativa-field"><label>¿Para qué área?</label><input type="text" id="inArea" placeholder="Ej: TI, RRHH, Ventas"></div>
            <div class="iniciativa-field"><label>¿Para qué sirve?</label><input type="text" id="inParaSirve" placeholder="Objetivo principal"></div>
          </div>
          <div class="iniciativa-field"><label>¿En qué mejora?</label><input type="text" id="inMejora" placeholder="Impacto esperado"></div>
          <div class="iniciativa-field"><label>Observación / Oportunidad de mejora</label><textarea id="inObservacion" rows="2" placeholder="¿Qué problema resuelve?"></textarea></div>
          <div class="iniciativa-field"><label>¿Cómo llegaste a esa conclusión?</label><textarea id="inConcl" rows="2" placeholder="Contexto o evidencia..."></textarea></div>
          <div class="iniciativa-field"><label>Visibilidad</label>
            <div class="visib-row" id="visibRow">
              <div class="visib-opt sel" onclick="selVisib(this,'publico')">🌍 Público</div>
              <div class="visib-opt" onclick="selVisib(this,'comunidad')">👥 Mi comunidad</div>
              <div class="visib-opt" onclick="selVisib(this,'especificos')">🎯 Usuarios específicos</div>
            </div>
          </div>
          <div class="iniciativa-field" id="visibUsuariosField" style="display:none;">
            <label>Usuarios específicos (correos separados por coma)</label>
            <input type="text" id="inUsuarios" placeholder="usuario@empresa.com, otro@empresa.com">
          </div>
          <div class="iniciativa-field"><label>Imagen adjunta (opcional)</label>
            <input type="file" id="inImagen" accept="image/*" style="width:100%;font-size:13px;color:var(--text-muted);">
          </div>
          <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:12px;">
            <button onclick="toggleIniciativaForm()" style="padding:8px 16px;border-radius:8px;border:1.5px solid var(--border-soft);background:transparent;color:var(--text-muted);font-size:13px;font-weight:600;cursor:pointer;">Cancelar</button>
            <button onclick="submitIniciativa()" style="padding:8px 20px;border-radius:8px;border:none;background:var(--primary);color:#fff;font-size:13px;font-weight:700;cursor:pointer;"><i class="bi bi-send-fill"></i> Publicar</button>
          </div>
        </div>
      </div>

      <!-- TAB: Solicitudes -->
      <div class="anuncios-tab-panel" id="tap-solicitudes" style="padding-bottom:16px;">
        <div style="display:flex;gap:6px;margin-bottom:14px;">
          <button id="solTab-recv" class="sol-subtab active" onclick="switchSolTab('recv')">Recibidas</button>
          <button id="solTab-sent" class="sol-subtab" onclick="switchSolTab('sent')">Enviadas</button>
        </div>
        <div id="solRecv"><div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i></div></div>
        <div id="solSent" style="display:none;"></div>
      </div>

      <!-- TAB: Buscar -->
      <div class="anuncios-tab-panel" id="tap-buscar" style="padding-bottom:16px;">
        <div style="margin:12px 0 14px;position:relative;">
          <i class="bi bi-search" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:14px;pointer-events:none;"></i>
          <input type="text" id="buscarQuery"
            placeholder="Buscar publicaciones, personas o comunidades…"
            style="width:100%;box-sizing:border-box;border:1.5px solid var(--border-soft);border-radius:12px;padding:11px 14px 11px 38px;font-size:13px;background:var(--bg-main);color:var(--text-main);outline:none;transition:border-color .2s;"
            oninput="debounceBuscar(this.value)"
            onkeydown="if(event.key==='Enter')buscarEntidad()"
            onfocus="this.style.borderColor='var(--primary)'"
            onblur="this.style.borderColor='var(--border-soft)'">
        </div>
        <div id="buscarResult"></div>
      </div>
    </div>
  </div>
</div>

<!-- CHATBOT -->
<div class="cb-container" id="cbContainer">
  <div class="cb-window" id="cbWindow">
    <div class="cb-header">
      <div class="cb-hinfo">
        <div class="cb-avatar"><i class="bi bi-stars"></i></div>
        <div class="cb-htitle">
          <h4>ARIA · Asistente TI</h4>
          <p><span class="cb-online-dot"></span> En línea · <span id="cbHeaderUser"></span></p>
        </div>
      </div>
      <button class="cb-x" id="cbClose"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="cb-msgs" id="cbMsgs"></div>
    <div class="cb-suggestions" id="cbSuggestions"></div>
    <div class="cb-input-area">
      <input type="file" id="cbFileInput" accept="image/jpeg,image/png,image/webp" style="display:none">
      <button type="button" class="cb-attach" id="cbAttach" title="Adjuntar imagen del error"><i class="bi bi-paperclip"></i></button>
      <button type="button" class="cb-mic" id="cbMic" title="Dictado por voz"><i class="bi bi-mic"></i></button>
      <input type="text" class="cb-input" id="cbInput" placeholder="Pregúntame algo…" autocomplete="off">
      <button class="cb-send" id="cbSend"><i class="bi bi-send-fill"></i></button>
    </div>
  </div>
  <button class="cb-btn" id="cbToggle">
