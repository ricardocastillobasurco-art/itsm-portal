<!-- WHATSAPP REGISTER MODAL -->
<div class="portal-modal-overlay" id="wspModalOverlay">
  <div class="portal-modal" style="max-width:440px;">
    <button class="pm-close" onclick="closePModal('wspModalOverlay')"><i class="bi bi-x-lg"></i></button>
    <div id="wspForm">
      <h3><i class="bi bi-whatsapp" style="color:#25d366;font-size:22px;"></i> Registrar WhatsApp Bot</h3>
      <p style="font-size:13px;color:var(--text-muted,#64748b);margin-bottom:18px;">Una vez aprobado podrás gestionar incidencias, requerimientos y consultar el estado de tus tickets directamente desde WhatsApp.</p>

      <label>Usuario</label>
      <input type="text" id="wspUserDisplay" readonly style="background:var(--bg-main,#f5f7fa);cursor:default;">

      <label>Correo corporativo</label>
      <input type="text" id="wspEmailDisplay" readonly style="background:var(--bg-main,#f5f7fa);cursor:default;">

      <label>Número de celular *</label>
      <div style="display:flex;align-items:center;border:1.5px solid #e2e8f0;border-radius:8px;overflow:hidden;background:var(--bg-main,#f5f7fa);" id="wspPhoneWrap">
        <span style="padding:9px 12px;font-size:13px;color:#64748b;border-right:1.5px solid #e2e8f0;white-space:nowrap;background:#fff;">+51</span>
        <input type="tel" id="wspPhone" maxlength="9" placeholder="999 999 999" style="border:none;background:transparent;flex:1;padding:9px 12px;font-size:13px;color:var(--text-main,#1e293b);outline:none;"
               oninput="this.value=this.value.replace(/\D/g,'')">
      </div>
      <div id="wspPhoneErr" style="display:none;font-size:11px;color:#dc2626;margin-top:4px;"></div>

      <label>¿Por qué deseas acceder al bot?</label>
      <textarea id="wspReason" rows="2" placeholder="Ej: Trabajo en campo y necesito reportar incidencias sin acceso al portal web…" style="resize:none;"></textarea>

      <div class="pm-actions">
        <button class="pm-btn pm-btn-secondary" onclick="closePModal('wspModalOverlay')">Cancelar</button>
        <button class="pm-btn pm-btn-primary" id="btnWspSend" onclick="submitWsp()" style="background:#25d366;"><i class="bi bi-send-fill"></i> Solicitar registro</button>
      </div>
    </div>
    <div id="wspSuccess" style="display:none;text-align:center;padding:24px 8px 8px;">
      <div style="width:64px;height:64px;background:linear-gradient(135deg,#d1fae5,#a7f3d0);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:30px;">✅</div>
      <p style="font-weight:800;font-size:16px;color:#064e3b;margin-bottom:10px;">¡Número registrado!</p>
      <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:14px 18px;margin-bottom:16px;">
        <div style="font-size:12px;color:#6b7280;margin-bottom:4px;">Has registrado el número</div>
        <div id="wspSuccessPhone" style="font-size:22px;font-weight:800;color:#059669;letter-spacing:1px;"></div>
        <div style="font-size:12px;color:#6b7280;margin-top:4px;">para el uso del chatbot de WhatsApp</div>
      </div>
      <p style="font-size:12px;color:#6b7280;margin-bottom:20px;">Tu solicitud está <strong>pendiente de aprobación</strong>. El equipo de TI la revisará y te notificará cuando sea activado.</p>
      <div class="pm-actions" style="justify-content:center;gap:10px;">
        <button class="pm-btn pm-btn-secondary" onclick="document.getElementById('wspForm').style.display='block';document.getElementById('wspSuccess').style.display='none';">
          <i class="bi bi-pencil"></i> Editar
        </button>
        <button class="pm-btn pm-btn-primary" style="background:#25d366;" onclick="closePModal('wspModalOverlay')">
          <i class="bi bi-check2-circle"></i> Confirmar
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════════
     MODAL: DEVOLUCIÓN (rediseñado)
══════════════════════════════════════════════════════════════ -->
<div class="dev-overlay" id="devModalOverlay">
  <div class="dev-box">
    <!-- Header gradient -->
    <div class="dev-header">
      <button class="dev-hclose" onclick="closePModal('devModalOverlay')"><i class="bi bi-x-lg"></i></button>
      <div class="dev-hicon"><i class="bi bi-box-arrow-in-left"></i></div>
      <div class="dev-htitle">Devolución de Equipos</div>
      <div class="dev-hsub">Registra la entrega de equipos y activos tecnológicos asignados</div>
      <!-- Steps -->
      <div class="dev-steps-bar">
        <div class="dev-step-item"><div class="dev-step-circle active" id="dsc0">1</div><div class="dev-step-label">Equipos</div></div>
        <div class="dev-connector" id="dcon0"></div>
        <div class="dev-step-item"><div class="dev-step-circle" id="dsc1">2</div><div class="dev-step-label">Checklist</div></div>
        <div class="dev-connector" id="dcon1"></div>
        <div class="dev-step-item"><div class="dev-step-circle" id="dsc2">3</div><div class="dev-step-label">Firma</div></div>
        <div class="dev-connector" id="dcon2"></div>
        <div class="dev-step-item"><div class="dev-step-circle" id="dsc3">4</div><div class="dev-step-label">Confirmar</div></div>
      </div>
    </div>
    <!-- Body -->
    <div class="dev-body">
      <!-- Paso 1: Equipos -->
      <div class="dev-panel active" id="devPanel0">
        <div id="devUserCard" style="display:none;"></div>
        <div style="font-size:13px;font-weight:700;color:var(--text-main);margin-bottom:10px;display:flex;align-items:center;gap:6px;"><i class="bi bi-laptop-fill" style="color:#ec4899;"></i> Equipos asignados</div>
        <div id="devEquipList2"><div style="text-align:center;padding:24px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i> Cargando...</div></div>
        <div class="dev-wrong-check">
          <input type="checkbox" id="devWrongEquip">
          <div>
            <div style="font-size:12px;font-weight:700;color:#92400e;">¿El equipo mostrado no es el tuyo o hay un error en la asignación?</div>
            <div style="font-size:11px;color:#b45309;margin-top:2px;">Marca esta casilla para reportar una incidencia y que TI corrija la asignación.</div>
          </div>
        </div>
      </div>
      <!-- Paso 2: Checklist -->
      <div class="dev-panel" id="devPanel1">
        <div style="font-size:14px;font-weight:800;color:var(--text-main);margin-bottom:4px;">Checklist de devolución</div>
        <div style="font-size:12px;color:var(--text-muted);margin-bottom:16px;">Selecciona los elementos que estás devolviendo</div>
        <div class="dev-check-item" onclick="toggleDevCheck('celular',this)">
          <div class="dev-check-icon">📱</div>
          <div style="flex:1;"><div style="font-size:13px;font-weight:700;color:var(--text-main);">Celular corporativo</div><div style="font-size:11px;color:var(--text-muted);">Teléfono móvil asignado por la empresa</div></div>
          <div class="dev-check-box"><i class="bi bi-check-lg" style="font-size:11px;"></i></div>
        </div>
        <div class="dev-check-item" onclick="toggleDevCheck('fotocheck',this)">
          <div class="dev-check-icon">🪪</div>
          <div style="flex:1;"><div style="font-size:13px;font-weight:700;color:var(--text-main);">Fotocheck / Credencial</div><div style="font-size:11px;color:var(--text-muted);">Credencial corporativa de identificación</div></div>
          <div class="dev-check-box"><i class="bi bi-check-lg" style="font-size:11px;"></i></div>
        </div>
        <div class="dev-check-item" onclick="toggleDevCheck('llaves',this)">
          <div class="dev-check-icon">🔑</div>
          <div style="flex:1;"><div style="font-size:13px;font-weight:700;color:var(--text-main);">Llaves de acceso</div><div style="font-size:11px;color:var(--text-muted);">Llaves de oficina, casillero o vehículo</div></div>
          <div class="dev-check-box"><i class="bi bi-check-lg" style="font-size:11px;"></i></div>
        </div>
        <div class="dev-check-item" onclick="toggleDevCheck('mochila',this)">
          <div class="dev-check-icon">🎒</div>
          <div style="flex:1;"><div style="font-size:13px;font-weight:700;color:var(--text-main);">Mochila corporativa</div><div style="font-size:11px;color:var(--text-muted);">Mochila o bolso proporcionado por la empresa</div></div>
          <div class="dev-check-box"><i class="bi bi-check-lg" style="font-size:11px;"></i></div>
        </div>
      </div>
      <!-- Paso 3: Firma + Foto -->
      <div class="dev-panel" id="devPanel2">
        <div style="font-size:14px;font-weight:800;color:var(--text-main);margin-bottom:4px;">Firma digital</div>
        <div style="font-size:12px;color:var(--text-muted);margin-bottom:10px;">Firma con tu dedo o mouse en el recuadro</div>
        <div class="dev-canvas-wrap">
          <canvas id="devCanvas" class="dev-canvas"></canvas>
          <button class="dev-canvas-clear" onclick="clearDevCanvas()">Borrar</button>
        </div>
        <div style="font-size:14px;font-weight:800;color:var(--text-main);margin:14px 0 4px;">Foto del equipo <span style="font-size:11px;font-weight:400;color:var(--text-muted);">(opcional)</span></div>
        <div style="font-size:12px;color:var(--text-muted);margin-bottom:10px;">Adjunta una foto del estado del equipo</div>
        <div class="dev-photo-wrap">
          <img id="devPhotoPreview" class="dev-photo-preview" src="" alt="">
          <div id="devPhotoActions" style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
            <label style="padding:9px 16px;background:linear-gradient(135deg,#be185d,#ec4899);color:#fff;border-radius:10px;font-size:12px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;">
              <i class="bi bi-image"></i> Adjuntar foto
              <input type="file" id="devPhotoFile" accept="image/*" style="display:none;" onchange="devPhotoFileChange(event)">
            </label>
            <button onclick="openDevCamera()" style="padding:9px 16px;background:var(--bg-main);border:1.5px solid var(--border-soft);color:var(--text-main);border-radius:10px;font-size:12px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;">
              <i class="bi bi-camera-fill"></i> Activar cámara
            </button>
          </div>
        </div>
        <!-- Camera inline -->
        <div id="devCameraWrap" style="display:none;background:var(--bg-main);border-radius:12px;overflow:hidden;margin-bottom:12px;">
          <video id="devCameraVideo" style="width:100%;max-height:220px;object-fit:cover;display:block;" autoplay playsinline></video>
          <div style="display:flex;gap:8px;padding:10px;justify-content:center;">
            <button onclick="captureDevPhoto()" style="padding:9px 22px;background:linear-gradient(135deg,#be185d,#ec4899);color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;"><i class="bi bi-camera-fill"></i> Capturar</button>
