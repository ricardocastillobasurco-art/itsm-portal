<!-- MODAL: Gestión de Marquesina -->
<div class="portal-modal-overlay" id="marqueeModalOverlay">
  <div class="portal-modal" style="max-width:600px;width:95%;">
    <button class="pm-close" onclick="closePModal('marqueeModalOverlay')"><i class="bi bi-x-lg"></i></button>
    <h3><i class="bi bi-megaphone-fill" style="color:#ea580c"></i> Publicar Marquesina</h3>
    <p style="font-size:12px;color:var(--text-muted);margin-bottom:16px;">Los mensajes activos se muestran en el banner deslizante del portal de autogestión.</p>

    <!-- Formulario nuevo aviso -->
    <div style="background:var(--bg-main);border-radius:10px;padding:14px 16px;margin-bottom:18px;border:1px solid var(--border-soft);">
      <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:10px;">Nuevo aviso</div>
      <div style="display:grid;grid-template-columns:1fr auto;gap:8px;margin-bottom:8px;">
        <input type="text" id="mqMsg" placeholder="Texto del aviso (ej: Interrupción en SAP — en atención)" maxlength="200"
               style="padding:8px 12px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-card);color:var(--text-main);font-size:13px;width:100%;">
        <select id="mqSeverity" style="padding:8px 10px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-card);color:var(--text-main);font-size:13px;">
          <option value="critical">🔴 Crítico</option>
          <option value="warning" selected>🟡 Advertencia</option>
          <option value="info">🔵 Informativo</option>
          <option value="success">🟢 Resuelto</option>
        </select>
      </div>
      <div style="display:flex;gap:8px;align-items:center;">
        <input type="datetime-local" id="mqExpires" title="Fecha de expiración (opcional)"
               style="padding:7px 10px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-card);color:var(--text-main);font-size:12px;flex:1;">
        <span style="font-size:11px;color:var(--text-muted);white-space:nowrap;">Expira (opcional)</span>
        <button onclick="submitBanner()" style="padding:8px 18px;border-radius:8px;border:none;background:#ea580c;color:#fff;font-size:13px;font-weight:700;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:6px;"><i class="bi bi-send-fill"></i> Publicar</button>
      </div>
    </div>

    <!-- Lista de avisos activos -->
    <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted);margin-bottom:8px;">Avisos activos</div>
    <div id="mqList" style="display:flex;flex-direction:column;gap:8px;max-height:260px;overflow-y:auto;">
      <div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i> Cargando...</div>
    </div>
  </div>
</div>

<!-- MODAL: Encuesta de Satisfacción -->
<div class="portal-modal-overlay" id="surveyModalOverlay">
  <div class="portal-modal" style="max-width:460px;overflow:hidden;">
    <button class="pm-close" onclick="closePModal('surveyModalOverlay')"><i class="bi bi-x-lg"></i></button>
    <div id="surveyForm" style="max-height:82vh;overflow-y:auto;padding-right:2px;">
      <div style="text-align:center;margin-bottom:16px;">
        <div style="width:56px;height:56px;background:linear-gradient(135deg,#fef3c7,#fde68a);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;font-size:26px;">⭐</div>
        <div id="surveyGreeting" style="font-size:17px;font-weight:800;color:var(--text-main,#1e293b);">Encuesta de Satisfacción</div>
        <div style="font-size:12px;color:#64748b;margin-top:3px;">Comparte tu experiencia con el servicio TI</div>
      </div>

      <!-- Sección 1: Plataforma -->
      <div style="background:var(--bg-card,#f8fafc);border:1px solid var(--border-soft,#e2e8f0);border-radius:10px;padding:14px 16px;margin-bottom:12px;">
        <div style="font-size:12px;font-weight:700;color:#2563eb;margin-bottom:8px;display:flex;align-items:center;gap:6px;"><i class="bi bi-laptop-fill"></i> Experiencia con la plataforma</div>
        <div class="star-row" id="starRow" style="justify-content:center;">
          <button class="star-btn" onclick="setStar('platform',1,this)">★</button>
          <button class="star-btn" onclick="setStar('platform',2,this)">★</button>
          <button class="star-btn" onclick="setStar('platform',3,this)">★</button>
          <button class="star-btn" onclick="setStar('platform',4,this)">★</button>
          <button class="star-btn" onclick="setStar('platform',5,this)">★</button>
        </div>
        <div id="surveyStarLabel" style="text-align:center;font-size:12px;font-weight:600;color:#f59e0b;min-height:18px;margin-top:4px;transition:all .2s;"></div>
      </div>

      <!-- Sección 2: Equipo corporativo -->
      <div style="background:var(--bg-card,#f8fafc);border:1px solid var(--border-soft,#e2e8f0);border-radius:10px;padding:14px 16px;margin-bottom:12px;">
        <div style="font-size:12px;font-weight:700;color:#7c3aed;margin-bottom:8px;display:flex;align-items:center;gap:6px;"><i class="bi bi-pc-display-horizontal"></i> Experiencia con tu equipo corporativo</div>
        <div class="star-row" id="starRowEquip" style="justify-content:center;">
          <button class="star-btn" onclick="setStar('equip',1,this)">★</button>
          <button class="star-btn" onclick="setStar('equip',2,this)">★</button>
          <button class="star-btn" onclick="setStar('equip',3,this)">★</button>
          <button class="star-btn" onclick="setStar('equip',4,this)">★</button>
          <button class="star-btn" onclick="setStar('equip',5,this)">★</button>
        </div>
        <div id="surveyStarLabelEquip" style="text-align:center;font-size:12px;font-weight:600;color:#f59e0b;min-height:18px;margin-top:4px;transition:all .2s;"></div>
      </div>

      <!-- Sección 3: Aplicaciones -->
      <div style="background:var(--bg-card,#f8fafc);border:1px solid var(--border-soft,#e2e8f0);border-radius:10px;padding:14px 16px;margin-bottom:12px;">
        <div style="font-size:12px;font-weight:700;color:#0891b2;margin-bottom:8px;display:flex;align-items:center;gap:6px;"><i class="bi bi-grid-3x3-gap-fill"></i> Experiencia con aplicaciones</div>
        <input id="surveyAppName" type="text" placeholder="¿Qué aplicación? (ej. Teams, SAP, ERP...)" style="width:100%;padding:7px 10px;border:1px solid var(--border-soft,#e2e8f0);border-radius:7px;font-size:12px;background:var(--bg-main,#fff);color:var(--text-main,#1e293b);margin-bottom:8px;box-sizing:border-box;">
        <div class="star-row" id="starRowApp" style="justify-content:center;">
          <button class="star-btn" onclick="setStar('app',1,this)">★</button>
          <button class="star-btn" onclick="setStar('app',2,this)">★</button>
          <button class="star-btn" onclick="setStar('app',3,this)">★</button>
          <button class="star-btn" onclick="setStar('app',4,this)">★</button>
          <button class="star-btn" onclick="setStar('app',5,this)">★</button>
        </div>
        <div id="surveyStarLabelApp" style="text-align:center;font-size:12px;font-weight:600;color:#f59e0b;min-height:18px;margin-top:4px;transition:all .2s;"></div>
      </div>

      <label style="font-size:12px;font-weight:600;color:var(--text-muted,#64748b);">Comentario general (opcional)</label>
      <textarea id="surveyComment" rows="2" placeholder="Cuéntanos tu experiencia..." style="margin-top:4px;"></textarea>
      <div class="pm-actions">
        <button class="pm-btn pm-btn-secondary" onclick="closePModal('surveyModalOverlay')">Cancelar</button>
        <button class="pm-btn pm-btn-primary" onclick="submitSurvey()"><i class="bi bi-send-fill"></i> Enviar calificación</button>
      </div>
    </div>
    <div class="pm-success" id="surveySuccess" style="display:none;padding:28px 16px 16px;text-align:center;">
      <div id="surveySuccessEmoji" style="font-size:52px;margin-bottom:8px;">🎉</div>
      <div id="surveyThanksTitle" style="font-size:18px;font-weight:800;color:var(--text-main,#1e293b);margin-bottom:6px;"></div>
      <p id="surveyThanksMsg" style="font-size:13px;color:#64748b;margin:0 0 6px;"></p>
      <div id="surveyStarsDisplay" style="font-size:28px;letter-spacing:2px;margin-bottom:18px;"></div>
      <div class="pm-actions" style="justify-content:center;">
        <button class="pm-btn pm-btn-secondary" onclick="closePModal('surveyModalOverlay')">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL: Recomendaciones -->
