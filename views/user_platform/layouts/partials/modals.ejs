    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════════
     MODAL: CATÁLOGO DE SOFTWARE
══════════════════════════════════════════════════════════════ -->
<div class="portal-modal-overlay" id="swCatalogOverlay" style="align-items:flex-start;padding:30px 16px;">
  <div class="portal-modal" style="max-width:760px;max-height:90vh;overflow:hidden;padding:0;">

    <!-- Header -->
    <div style="padding:18px 22px 14px;border-bottom:1px solid var(--border-soft);display:flex;align-items:center;gap:12px;">
      <div style="width:38px;height:38px;background:linear-gradient(135deg,#65a30d,#84cc16);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <i class="bi bi-grid-3x3-gap-fill" style="color:#fff;font-size:17px;"></i>
      </div>
      <div style="flex:1;">
        <div style="font-size:15px;font-weight:800;color:var(--text-main);">Catálogo de Software</div>
        <div style="font-size:11px;color:var(--text-muted);">Solicita instalación, permisos o consulta disponibilidad</div>
      </div>
      <button class="pm-close" onclick="closePModal('swCatalogOverlay')" style="position:static;"><i class="bi bi-x-lg"></i></button>
    </div>

    <!-- Buscador + filtros -->
    <div style="padding:12px 22px;border-bottom:1px solid var(--border-soft);background:var(--bg-main);">
      <div style="position:relative;margin-bottom:10px;">
        <i class="bi bi-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:13px;pointer-events:none;"></i>
        <input type="text" id="swSearch" placeholder="Buscar software…"
          oninput="filterSoftware()"
          style="width:100%;box-sizing:border-box;padding:9px 12px 9px 34px;border:1.5px solid var(--border-soft);border-radius:10px;font-size:13px;background:var(--bg-card);color:var(--text-main);outline:none;">
      </div>
      <div id="swCatPills" style="display:flex;gap:6px;flex-wrap:wrap;">
        <button class="sw-pill active" onclick="setSWCat('',this)">Todos</button>
        <button class="sw-pill" onclick="setSWCat('Ofimática',this)">📄 Ofimática</button>
        <button class="sw-pill" onclick="setSWCat('Comunicación',this)">💬 Comunicación</button>
        <button class="sw-pill" onclick="setSWCat('Seguridad',this)">🔒 Seguridad</button>
        <button class="sw-pill" onclick="setSWCat('Desarrollo',this)">💻 Desarrollo</button>
        <button class="sw-pill" onclick="setSWCat('Diseño',this)">🎨 Diseño</button>
        <button class="sw-pill" onclick="setSWCat('Gestión',this)">📊 Gestión</button>
        <button class="sw-pill" onclick="setSWCat('Utilidades',this)">🔧 Utilidades</button>
      </div>
    </div>

    <!-- Grid de software -->
    <div id="swGrid" style="padding:16px 22px;overflow-y:auto;max-height:calc(90vh - 180px);display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px;">
    </div>

    <!-- Panel de solicitud (oculto por defecto) -->
    <div id="swRequestPanel" style="display:none;position:absolute;inset:0;background:var(--bg-card);border-radius:inherit;overflow-y:auto;padding:22px;">
      <button onclick="closeSWRequest()" style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:20px;border:1.5px solid var(--border-soft);background:transparent;color:var(--text-muted);font-size:12px;font-weight:700;cursor:pointer;margin-bottom:16px;">
        <i class="bi bi-arrow-left"></i> Volver al catálogo
      </button>
      <div id="swRequestContent"></div>
    </div>
  </div>
</div>

<!-- PAGE IFRAME MODAL (Incidencias / Requerimientos / Herramientas) -->
<div id="pfModalOverlay" style="position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:10001;display:none;align-items:center;justify-content:center;padding:12px;">
