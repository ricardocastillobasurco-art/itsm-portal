      <div><div style="font-size:16px;font-weight:800;color:var(--text-main);">¡Bienvenido al Portal TI!</div><div style="font-size:12px;color:var(--text-muted);margin-top:2px;">Esto es lo que puedes hacer desde aquí</div></div>
    </div>
