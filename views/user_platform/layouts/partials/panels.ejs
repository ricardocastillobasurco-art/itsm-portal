      <div class="mx-kpi" id="kpi-logins"><div class="mx-kpi-val">—</div><div class="mx-kpi-lbl"><i class="bi bi-box-arrow-in-right"></i> Accesos</div></div>
      <div class="mx-kpi" id="kpi-inc"><div class="mx-kpi-val">—</div><div class="mx-kpi-lbl"><i class="bi bi-exclamation-triangle-fill" style="color:var(--danger)"></i> Incidencias</div></div>
      <div class="mx-kpi" id="kpi-req"><div class="mx-kpi-val">—</div><div class="mx-kpi-lbl"><i class="bi bi-clipboard2-plus-fill" style="color:var(--primary)"></i> Requerimientos</div></div>
      <div class="mx-kpi" id="kpi-total"><div class="mx-kpi-val">—</div><div class="mx-kpi-lbl"><i class="bi bi-activity"></i> Acciones totales</div></div>
    </div>

    <!-- Tabla por usuario -->
