        <input type="date" id="mxTo" class="form-control" style="font-size:13px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-card);color:var(--text-main);padding:6px 10px;">
      </div>
      <div>
        <div style="font-size:11px;font-weight:600;color:var(--text-muted);margin-bottom:4px;text-transform:uppercase;">Correo</div>
        <input type="text" id="mxEmail" placeholder="Filtrar por correo..." style="font-size:13px;border-radius:8px;border:1px solid var(--border-soft);background:var(--bg-card);color:var(--text-main);padding:6px 10px;width:220px;">
      </div>
