let _swActiveCat = '';

function openSoftwareCatalog(){
  document.getElementById('swCatalogOverlay').classList.add('show');
  document.getElementById('swSearch').value = '';
  document.getElementById('swRequestPanel').style.display = 'none';
  _swActiveCat = '';
  document.querySelectorAll('.sw-pill').forEach((p,i)=>p.classList.toggle('active',i===0));
  renderSWGrid(_SW_CATALOG);
}

function setSWCat(cat, btn){
  _swActiveCat = cat;
  document.querySelectorAll('.sw-pill').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('swSearch').value = '';
  filterSoftware();
}

function filterSoftware(){
  const q = (document.getElementById('swSearch').value||'').toLowerCase().trim();
  let list = _swActiveCat ? _SW_CATALOG.filter(s=>s.cat===_swActiveCat) : _SW_CATALOG;
  if(q) list = list.filter(s=>s.name.toLowerCase().includes(q)||s.desc.toLowerCase().includes(q)||s.cat.toLowerCase().includes(q));
  renderSWGrid(list);
}

function renderSWGrid(list){
  const grid = document.getElementById('swGrid');
  if(!list.length){
    grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted);font-size:13px;"><i class="bi bi-search" style="font-size:28px;opacity:.25;display:block;margin-bottom:8px;"></i>Sin resultados.</div>';
    return;
  }
  const badgeMap = { free:'<span class="sw-badge-free">Disponible</span>', license:'<span class="sw-badge-license">Licencia</span>', restricted:'<span class="sw-badge-restricted">Restringido</span>' };
  grid.innerHTML = list.map(s => {
    const badge = badgeMap[s.type]||'';
    const canInstall = s.type !== 'restricted';
    return `<div class="sw-card">
      <div style="display:flex;align-items:flex-start;gap:10px;">
        <div class="sw-icon" style="background:${s.bg}22;">${s.icon}</div>
        <div style="flex:1;min-width:0;">
          <div class="sw-name">${s.name}</div>
          <div class="sw-cat">${s.cat}</div>
        </div>
      </div>
      ${badge}
      <div class="sw-desc">${s.desc}</div>
      <div class="sw-actions">
        ${canInstall
          ? `<button class="sw-btn sw-btn-install" onclick="openSWRequest('${s.id}','install')"><i class="bi bi-download"></i> Instalar</button>`
          : `<button class="sw-btn sw-btn-install" onclick="openSWRequest('${s.id}','install')" style="background:#94a3b8;"><i class="bi bi-lock-fill"></i> Solicitar acceso</button>`
        }
        <button class="sw-btn sw-btn-permit" onclick="openSWRequest('${s.id}','permit')"><i class="bi bi-shield-check"></i> Solicitar permiso</button>
        <button class="sw-btn sw-btn-info"   onclick="openSWInfo('${s.id}')"><i class="bi bi-info-circle"></i> Consultar</button>
      </div>
    </div>`;
  }).join('');
}

function openSWRequest(id, action){
  const sw = _SW_CATALOG.find(s=>s.id===id);
  if(!sw) return;
  const panel = document.getElementById('swRequestPanel');
  const content = document.getElementById('swRequestContent');
  const isInstall = action==='install';
  const title = isInstall ? `Solicitar instalación: ${sw.name}` : `Solicitar permiso: ${sw.name}`;
  const icon  = isInstall ? 'bi-download' : 'bi-shield-check';
  const color = isInstall ? '#65a30d' : '#2563eb';

  content.innerHTML = `
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <div style="width:44px;height:44px;border-radius:12px;background:${sw.bg}22;display:flex;align-items:center;justify-content:center;font-size:22px;">${sw.icon}</div>
      <div>
        <div style="font-size:15px;font-weight:800;color:var(--text-main);">${title}</div>
        <div style="font-size:12px;color:var(--text-muted);">${sw.cat} · ${sw.name}</div>
      </div>
    </div>
    ${sw.type==='restricted'?`<div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:10px 14px;margin-bottom:16px;font-size:12px;color:#dc2626;display:flex;gap:8px;align-items:flex-start;"><i class="bi bi-exclamation-triangle-fill" style="flex-shrink:0;margin-top:1px;"></i><span>Este software tiene acceso <strong>restringido</strong>. Tu solicitud pasará por aprobación del área TI y tu jefatura.</span></div>`:''}
    <div class="sw-req-field"><label>Motivo / justificación ${sw.requiresJustification?'*':''}</label>
      <textarea id="swReqMotivo" rows="3" placeholder="¿Para qué necesitas este software? ¿Qué tarea realizarás con él?"></textarea>
    </div>
    <div class="sw-req-field"><label>Equipo / hostname</label>
      <input type="text" id="swReqHostname" placeholder="Ej: PC-JGOMEZ-001 o déjalo en blanco si no lo sabes">
    </div>
    ${isInstall?`<div class="sw-req-field"><label>Urgencia</label>
      <select id="swReqUrgencia">
        <option value="normal">Normal (2-3 días hábiles)</option>
        <option value="urgente">Urgente (mismo día)</option>
      </select>
    </div>`:''}
    <div style="display:flex;gap:8px;margin-top:4px;">
      <button onclick="closeSWRequest()" style="flex:1;padding:10px;border-radius:10px;border:1.5px solid var(--border-soft);background:transparent;color:var(--text-muted);font-size:13px;font-weight:700;cursor:pointer;">Cancelar</button>
      <button onclick="submitSWRequest('${id}','${action}')" style="flex:2;padding:10px;border-radius:10px;border:none;background:${color};color:#fff;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;">
        <i class="bi ${icon}"></i> Enviar solicitud
      </button>
    </div>
    <div id="swReqResult" style="margin-top:12px;"></div>`;

  panel.style.display = 'block';
}

async function submitSWRequest(id, action){
  const sw = _SW_CATALOG.find(s=>s.id===id);
  if(!sw) return;
  const motivo   = document.getElementById('swReqMotivo')?.value.trim();
  const hostname = document.getElementById('swReqHostname')?.value.trim();
  const urgencia = document.getElementById('swReqUrgencia')?.value || 'normal';
  const email    = localStorage.getItem('portal_user_email') || '';
  const name     = localStorage.getItem('portal_user_name')  || email;
  const res      = document.getElementById('swReqResult');

  if(sw.requiresJustification && !motivo){ res.innerHTML='<div style="color:#dc2626;font-size:12px;">La justificación es obligatoria para este software.</div>'; return; }
  if(!email){ res.innerHTML='<div style="color:#dc2626;font-size:12px;">Identifícate primero en el portal.</div>'; return; }

  const isInstall = action==='install';
  const tipo = isInstall ? 'Instalación de Software' : 'Solicitud de Permiso de Software';
  const body = `*${tipo}*\nSoftware: ${sw.name} (${sw.cat})\nTipo: ${sw.type}\nEquipo: ${hostname||'No especificado'}\nUrgencia: ${urgencia}\nMotivo: ${motivo||'Sin motivo especificado'}\nSolicitante: ${name} <${email}>`;

  res.innerHTML = '<div style="color:var(--text-muted);font-size:12px;"><i class="bi bi-hourglass-split"></i> Enviando...</div>';
  try {
    const r = await fetch('/api/jira/requirement', {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        summary: `[${tipo}] ${sw.name}${hostname?' - '+hostname:''}`,
        description: body,
        reporter: email,
        tipo,
        priority: urgencia==='urgente' ? 'P1' : 'P3',
      })
    });
    const data = await r.json();
    if(!r.ok || !data.success) throw new Error(data.message || 'Error');
    const reqKey = data.data?.key ? `<div style="font-size:11px;color:#6b7280;margin-top:2px;">Ticket: ${data.data.key}</div>` : '';
    res.innerHTML = `<div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:14px;text-align:center;">
      <i class="bi bi-check-circle-fill" style="color:#059669;font-size:22px;display:block;margin-bottom:6px;"></i>
      <div style="font-size:13px;font-weight:700;color:#065f46;">¡Solicitud enviada!</div>
      ${reqKey}
      <div style="font-size:12px;color:#6b7280;margin-top:4px;">El equipo TI la atenderá en el tiempo indicado.</div>
    </div>`;
    setTimeout(()=>closeSWRequest(), 3000);
  } catch(e) {
    res.innerHTML=`<div style="color:#dc2626;font-size:12px;"><i class="bi bi-exclamation-triangle-fill"></i> ${e.message||'Error al enviar. Intenta nuevamente.'}</div>`;
  }
}

