// ── Autocomplete correo en tab Buscar ────────────────────────────────────────
var _mtktAcTimer = null;
function mtktAcEmail(q){
  clearTimeout(_mtktAcTimer);
  const drop = document.getElementById('mtktSearchAcDrop');
  if(!drop) return;
  if(!q || q.length < 2 || q.includes('@')){drop.style.display='none';drop.innerHTML='';return;}
  _mtktAcTimer = setTimeout(async()=>{
    try{
      const _identUrl = (_PORTAL_TENANT_ID && _PORTAL_TENANT_ID != 1)
        ? `/api/portal/users/search?q=${encodeURIComponent(q)}`
        : `/api/employees/search-emails?q=${encodeURIComponent(q)}`;
      const r = await fetch(_identUrl, {credentials:'include'}).then(x=>x.json());
      const list = (r.data||[]).filter(u=>u.email).slice(0,8);
      if(!list.length){drop.style.display='none';return;}
      drop.innerHTML = list.map(u=>`<div onclick="mtktPickEmail('${u.email}')"
        style="padding:9px 14px;cursor:pointer;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--border-soft);"
        onmouseover="this.style.background='var(--bg-main)'" onmouseout="this.style.background=''">
        <i class="bi bi-person-circle" style="color:var(--primary);font-size:15px;flex-shrink:0;"></i>
        <div><div style="font-size:12px;font-weight:700;color:var(--text-main);">${u.email}</div>
        ${u.full_name?`<div style="font-size:11px;color:var(--text-muted);">${u.full_name}</div>`:''}
        </div></div>`).join('');
      drop.style.display='block';
    }catch{drop.style.display='none';}
  }, 280);
}
function mtktPickEmail(email){
  const inp = document.getElementById('mtktSearchInput');
  if(inp) inp.value = email;
  hideMtktAc();
  mtktDoSearch();
}
function hideMtktAc(){
  const d = document.getElementById('mtktSearchAcDrop');
  if(d){d.style.display='none';d.innerHTML='';}
}
document.addEventListener('click', e=>{
  if(!e.target.closest('#mtktPanel-srch')) hideMtktAc();
});

// ── Buscar ticket en modal ────────────────────────────────────────────────────
async function mtktDoSearch(){
  const input = document.getElementById('mtktSearchInput');
  const q     = (input?.value || '').trim();
  const resEl = document.getElementById('mtktSearchResults');
  if(!resEl) return;
  if(!q){
    resEl.innerHTML = '<div style="text-align:center;padding:20px;color:var(--muted-2);font-size:13px;">Escribe algo para buscar.</div>';
    return;
  }
  resEl.innerHTML = '<div style="text-align:center;padding:24px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i> Buscando...</div>';
  try {
    let data = [];
    const isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(q);
    const reporterEmail = localStorage.getItem('portal_user_email') || (typeof _cbPrivEmail !== 'undefined' ? _cbPrivEmail : '') || '';
    if(isEmail){
      // Buscar por correo del solicitante en Jira
      const r = await fetch('/api/jira/my-tickets?reporter='+encodeURIComponent(q)+'&days=0', {credentials:'include'});
      const d = await r.json();
      data = d.data || [];
    } else if(reporterEmail) {
      // Buscar por N° ticket INC o palabras clave dentro de los tickets Jira del usuario
      const r = await fetch('/api/jira/my-tickets?reporter='+encodeURIComponent(reporterEmail)+'&days=0', {credentials:'include'});
      const d = await r.json();
      const all = d.data || [];
      const ql = q.toLowerCase();
      data = all.filter(t =>
        (t.id||'').toLowerCase().includes(ql) ||
        (t.titulo||'').toLowerCase().includes(ql)
      );
    }
    if(!data.length){
      resEl.innerHTML = `<div style="text-align:center;padding:36px 20px;color:var(--text-muted);font-size:13px;">
        <i class="bi bi-search" style="font-size:28px;display:block;margin-bottom:8px;opacity:.35;"></i>
        No se encontraron tickets con <strong>"${q.replace(/</g,'&lt;')}"</strong>.<br>
        <span style="font-size:11px;color:var(--muted-2);margin-top:6px;display:block;">Prueba con el número exacto (INC-XXXXX) o un correo diferente.</span>
      </div>`;
      return;
    }
    const accentMap = {abierto:'#3b82f6',asignado:'#8b5cf6',en_progreso:'#f59e0b',pendiente:'#f97316',resuelto:'#10b981',cerrado:'#64748b'};
    resEl.innerHTML = `<div style="font-size:11px;font-weight:700;color:var(--text-muted);margin-bottom:10px;text-transform:uppercase;letter-spacing:.4px;">
      <i class="bi bi-list-check"></i> ${data.length} resultado${data.length!==1?'s':''} encontrado${data.length!==1?'s':''}
    </div>` + data.slice(0,15).map(t => {
      const clr = accentMap[(t.status||'').toLowerCase()] || '#64748b';
      const dt  = t.createdAt ? new Date(t.createdAt).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'2-digit'}) : '—';
      const stLabel = {abierto:'Abierto',asignado:'Asignado',en_progreso:'En progreso',pendiente:'Pendiente',resuelto:'Resuelto',cerrado:'Cerrado'}[(t.status||'').toLowerCase()] || t.status || 'Abierto';
      return `<div onclick="openTktTracking('${(t.id||'').replace(/'/g,'')}');document.getElementById('misTicketsOverlay').classList.remove('show');"
          style="background:var(--bg-main);border:1.5px solid var(--border-soft);border-left:4px solid ${clr};border-radius:10px;padding:12px 14px;margin-bottom:8px;cursor:pointer;transition:box-shadow .15s;"
          onmouseover="this.style.boxShadow='0 2px 12px rgba(0,0,0,.08)'" onmouseout="this.style.boxShadow=''">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;flex-wrap:wrap;">
          <span style="font-family:monospace;font-size:11.5px;font-weight:800;color:${clr};">${t.id||'—'}</span>
          <span style="font-size:10px;font-weight:700;color:${clr};background:${clr}18;padding:2px 8px;border-radius:6px;">${stLabel}</span>
          <span style="font-size:10px;font-weight:700;color:#64748b;background:#f1f5f9;padding:2px 7px;border-radius:6px;">${t.priority||'P3'}</span>
          <span style="font-size:10px;color:var(--text-muted);margin-left:auto;"><i class="bi bi-calendar3"></i> ${dt}</span>
        </div>
        <div style="font-size:13px;font-weight:700;color:var(--text-main);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${(t.titulo||'Sin título').replace(/</g,'&lt;')}</div>
        ${t.assigned_to_name ? `<div style="font-size:11px;color:var(--text-muted);margin-top:3px;"><i class="bi bi-person-fill"></i> ${t.assigned_to_name.replace(/</g,'&lt;')}</div>` : ''}
      </div>`;
    }).join('');
  } catch(e){
    resEl.innerHTML = '<div style="text-align:center;padding:24px;color:var(--danger);font-size:13px;"><i class="bi bi-wifi-off"></i> Error al buscar. Verifica tu conexión.</div>';
  }
}

// ── Tracking detail modal ────────────────────────────────────────────────────
var _tktCurrentKey  = null;

async function openTktTracking(id){
  const overlay = document.getElementById('tktTrackOverlay');
  const loading = document.getElementById('tktTrkLoading');
  const content = document.getElementById('tktTrkContent');
  loading.style.display = 'block'; content.style.display = 'none';
  document.getElementById('tktClosePanel').style.display = 'none';
  document.getElementById('tktCloseStatus').textContent = '';
  document.getElementById('tktCloseComment').value = '';
  overlay.classList.add('show');
  _tktCurrentKey = id;

  try {
    const _pEmail = localStorage.getItem('portal_user_email') || _cbPrivEmail || '';
    const r = await fetch('/api/jira/my-tickets/'+encodeURIComponent(id)+'?reporter='+encodeURIComponent(_pEmail), { credentials:'include' });
    const d = await r.json();
    if(!d.success) throw new Error(d.error||'Error');
    const t = d.data;

    // Header — ID completo + estado real de Jira
    document.getElementById('tktTrkId').textContent = t.id;
    document.getElementById('tktTrkBadge').innerHTML =
      `<span class="tkt-badge ${statusTktClass(t.status)}">${t.jiraStatus || statusTktLabel(t.status)}</span>`;
    document.getElementById('tktTrkPriority').innerHTML = `<span class="tkt-badge ${priorityTktClass(t.priority)}">${t.priority||'P3'}</span>`;
    document.getElementById('tktTrkType').textContent = t.tipo||'';
    document.getElementById('tktTrkTitle').textContent = t.titulo;
    const cat = t.categoria ? '📂 '+t.categoria.nombre : '';
    document.getElementById('tktTrkCategory').textContent = cat;

    // Botón cerrar en Jira (solo si ticket activo)
    const closeBtn = document.getElementById('tktCloseBtn');
    closeBtn.style.display = t.canClose ? 'inline-flex' : 'none';

    // SLA
    const slaEl = document.getElementById('tktTrkSla');
    if(t.slaDueAt){
      const due = new Date(t.slaDueAt);
      const now = new Date();
      const diff = due - now;
      const hrs = Math.round(diff / 36e5);
      const clr = t.slaStatus==='vencido'?'#dc2626':t.slaStatus==='riesgo'?'#d97706':'#059669';
      const icon = t.slaStatus==='vencido'?'bi-exclamation-triangle-fill':t.slaStatus==='riesgo'?'bi-clock-fill':'bi-check-circle-fill';
      slaEl.innerHTML = `<div style="display:flex;align-items:center;gap:7px;background:${clr}1a;border:1px solid ${clr}33;border-radius:8px;padding:8px 12px;">
        <i class="bi ${icon}" style="color:${clr};font-size:14px;"></i>
        <div>
          <div style="font-size:11px;font-weight:800;color:${clr};">SLA: ${t.slaStatus==='vencido'?'Vencido':t.slaStatus==='riesgo'?'En riesgo':'Dentro del plazo'}</div>
          <div style="font-size:10px;color:var(--text-muted);">Vence: ${due.toLocaleDateString('es-PE',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'})}${diff>0?' ('+Math.abs(hrs)+' h '+( diff>0?'restantes':'excedidas')+')'  :' ('+Math.abs(hrs)+' h excedidas)'}</div>
        </div>
      </div>`;
      slaEl.style.display = 'block';
    } else { slaEl.style.display = 'none'; }

    // Build timeline from state-change comments + milestone dates
    const allComments = t.comentarios || [];
    const stateChanges = allComments.filter(c => c.tipo === 'cambio_estado' || c.tipo === 'asignacion');
    const steps = buildTrkTimeline(t, stateChanges);
    document.getElementById('tktTrkTimeline').innerHTML = steps;

    // All human comments (from Jira, chronological)
    const humanComments = allComments.filter(c => c.tipo === 'comentario');
    const cmtWrap = document.getElementById('tktTrkCommentWrap');
    const cmtContainer = document.getElementById('tktTrkAllComments');
    if(humanComments.length){
      cmtContainer.innerHTML = humanComments.map(c => {
        const txt = (c.contenido||'').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        const ago = tktTimeAgo(new Date(c.createdAt));
        return `<div style="background:var(--bg-main);border:1px solid var(--border-soft);border-radius:8px;padding:10px 12px;">
          <div style="font-size:11px;color:var(--text-muted);margin-bottom:5px;display:flex;gap:6px;align-items:center;">
            <i class="bi bi-chat-left-dots" style="font-size:10px;"></i>
            <span>${ago}</span>
          </div>
          <div style="font-size:12px;color:var(--text-main);line-height:1.55;white-space:pre-wrap;">${txt}</div>
        </div>`;
      }).join('');
      cmtWrap.style.display = 'block';
    } else { cmtWrap.style.display = 'none'; }

    loading.style.display = 'none'; content.style.display = 'block';
  } catch(err) {
    loading.innerHTML = `<div style="color:var(--danger);font-size:13px;"><i class="bi bi-exclamation-triangle-fill"></i> ${err.message}</div>`;
  }
}

function buildTrkTimeline(t, stateChanges){
  const STATUS_META = {
    abierto:    { label:'Ticket abierto',       icon:'bi-folder-plus',    cls:'trk-done' },
    asignado:   { label:'Asignado al equipo',   icon:'bi-person-check',   cls:'trk-done' },
    en_progreso:{ label:'En progreso',           icon:'bi-tools',          cls:'trk-curr' },
    pendiente:  { label:'Pendiente respuesta',  icon:'bi-hourglass-split', cls:'trk-curr' },
    resuelto:   { label:'Resuelto',             icon:'bi-check-circle',    cls:'trk-done' },
    cerrado:    { label:'Cerrado',              icon:'bi-lock',             cls:'trk-done' },
  };
  const order = ['abierto','asignado','en_progreso','pendiente','resuelto','cerrado'];
  const curIdx = order.indexOf(t.status);

  // Build steps list: always start with 'abierto', then derive from state changes + current status
  const steps = [];

  // Step 1: creation
  steps.push({ s:'abierto', date: t.createdAt, note: null });

  // Steps from comments (cambio_estado/asignacion)
  stateChanges.forEach(c => {
    const meta = c.metadata || {};
    const toStatus = meta.to || meta.newStatus || null;
    if(toStatus && toStatus !== 'abierto') {
      steps.push({ s: toStatus, date: c.createdAt, note: c.contenido || null });
    }
  });

  // Ensure current status is represented
  const hasCurrentStatus = steps.some(s => s.s === t.status);
  if(!hasCurrentStatus) {
    const dateField = t.status==='resuelto'? t.resolvedAt : t.status==='cerrado'? t.closedAt : t.updatedAt;
    steps.push({ s: t.status, date: dateField || t.updatedAt, note: null });
  }

  // Remove duplicates, keep last occurrence, sort by date
  const seen = new Set();
  const unique = steps.filter(s => { if(seen.has(s.s)) return false; seen.add(s.s); return true; });

  return unique.map((step, i) => {
    const m = STATUS_META[step.s] || { label: step.s, icon:'bi-circle', cls:'trk-pend' };
    const isCurr = step.s === t.status;
    const isDone = !isCurr && order.indexOf(step.s) < curIdx;
    const dotCls = isDone ? 'trk-done' : isCurr ? 'trk-curr' : 'trk-pend';
    const dateStr = step.date ? tktFmtDate(new Date(step.date)) : '';
    return `<div class="tkt-trk-step">
      <div class="tkt-trk-dot ${dotCls}">
        ${isDone ? '<i class="bi bi-check-lg"></i>' : '<i class="bi '+m.icon+'"></i>'}
      </div>
      <div style="flex:1;min-width:0;">
        <div style="font-size:13px;font-weight:${isCurr?'800':'600'};color:${isCurr?'var(--primary,#6366f1)':'var(--text-main)'};">${m.label}</div>
        ${dateStr?`<div style="font-size:11px;color:var(--text-muted);margin-top:1px;">${dateStr}</div>`:''}
        ${step.note&&!isCurr?`<div style="font-size:11px;color:var(--text-muted);font-style:italic;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:300px;">"${step.note}"</div>`:''}
        ${isCurr?`<div style="font-size:11px;color:var(--primary,#6366f1);font-weight:700;margin-top:1px;">← Estado actual</div>`:''}
      </div>
    </div>`;
  }).join('');
}


