// FEATURE 5 — Garantías modal (wizard verde Movistar)
// ═══════════════════════════════════════════════════════════════════════════
let _garStep=0, _garFlow='tecnica', _garPieza='';
let _garEquipId=null, _garEmpId=null, _garEquipName='';
let _garPhotoData='', _garDenunciaData='';
let _garCanvasCtx=null, _garCanvasDrawing=false;

async function openGarantiasModal(){
  _garStep=0; _garFlow='tecnica'; _garPieza=''; _garPhotoData=''; _garDenunciaData='';
  _garEquipId=null; _garEmpId=null; _garEquipName=''; _garCanvasCtx=null;
  document.querySelectorAll('.gar-part-card').forEach(c=>c.classList.remove('sel'));
  document.querySelectorAll('.gar-flow-opt').forEach(c=>c.classList.remove('sel'));
  document.querySelector('.gar-flow-opt[data-flow="tecnica"]')?.classList.add('sel');
  const pp=document.getElementById('garPhotoPreview'); if(pp){pp.style.display='none';pp.src='';}
  const cv=document.getElementById('garCanvas'); if(cv&&_garCanvasCtx){_garCanvasCtx.clearRect(0,0,cv.width,cv.height); _garCanvasCtx=null;}
  const dn=document.getElementById('garDenunciaName'); if(dn) dn.textContent='';
  document.getElementById('garModalOverlay').classList.add('show');
  renderGarStep();
  const email=localStorage.getItem('portal_user_email')||'';
  const name=localStorage.getItem('portal_user_name')||'';
  const uc=document.getElementById('garUserCard');
  if(uc){
    const init=(name||email||'?')[0].toUpperCase();
    uc.innerHTML=`<div class="gar-user-card"><div class="gar-user-init">${init}</div><div><div style="font-size:14px;font-weight:800;color:var(--text-main);">${escHtml(name||email)}</div><div style="font-size:12px;color:var(--text-muted);">${escHtml(email)}</div></div></div>`;
  }
  if(!email) return;
  try{
    const r=await fetch(`/api/portal/devolucion/equipment?email=${encodeURIComponent(email)}`,{credentials:'include'});
    const d=await r.json();
    const equips=d.equipment||d.data||[];
    _garEmpId=d.employeeId||null;
    const ei=document.getElementById('garEquipInfo');
    if(!equips.length){ if(ei) ei.innerHTML='<p style="color:var(--text-muted);font-size:13px;text-align:center;padding:12px;">No tienes equipos asignados actualmente.</p>'; return; }
    const eq=equips[0];
    _garEquipId=eq.id;
    _garEquipName=`${eq.brand||''} ${eq.model||''}`.trim();
    const asig=eq.assignment_date?new Date(eq.assignment_date):null;
    const gFin=asig?new Date(asig.getTime()+365*24*60*60*1000):null;
    const hoy=new Date();
    const enG=gFin&&gFin>hoy;
    const dias=gFin?Math.ceil((gFin-hoy)/(1000*60*60*24)):0;
    const cls=enG?(dias<30?'gs-warn':'gs-ok'):'gs-expired';
    const txt=enG?(dias<30?`⚠️ Vence en ${dias} días`:`✅ En garantía (${dias} días rest.)`): '❌ Garantía vencida';
    if(ei) ei.innerHTML=`<div class="gar-equip-info"><div style="display:flex;align-items:center;gap:10px;"><div style="width:36px;height:36px;border-radius:10px;background:rgba(5,150,105,.1);display:flex;align-items:center;justify-content:center;font-size:18px;"><i class="bi bi-laptop-fill" style="color:#059669;"></i></div><div><div style="font-size:13px;font-weight:800;color:var(--text-main);">${escHtml(_garEquipName||'—')}</div><div style="font-size:11px;color:var(--text-muted);">S/N: ${escHtml(eq.serial_number||'—')} · ${escHtml(eq.device_code||'—')}</div><span class="gar-status-badge ${cls}">${txt}</span></div></div></div>`;
  }catch(e){}
}

function selectGarFlow(flow, el){
  _garFlow=flow;
  document.querySelectorAll('.gar-flow-opt').forEach(c=>c.classList.remove('sel'));
  el.classList.add('sel');
}

function selectGarPieza(pieza, el){
  _garPieza=pieza;
  document.querySelectorAll('.gar-part-card').forEach(c=>c.classList.remove('sel'));
  el.classList.add('sel');
}

function renderGarStep(){
  [0,1,2,3].forEach(i=>{
    const el=document.getElementById('garPanel'+i);
    if(el) el.classList.toggle('active', i===_garStep);
  });
  if(_garStep===1){
    const pt=document.getElementById('garPanelTecnica');
    const pr=document.getElementById('garPanelRobo');
    if(pt) pt.style.display=_garFlow==='tecnica'?'':'none';
    if(pr) pr.style.display=_garFlow==='robo'?'':'none';
  }
  [0,1,2,3].forEach(i=>{
    const el=document.getElementById('gsc'+i);
    if(!el) return;
    el.className='gar-step-circle'+(i<_garStep?' done':i===_garStep?' active':'');
    el.style.opacity=(_garFlow==='robo'&&i===2)?'0.35':'';
  });
  [0,1,2].forEach(i=>{
    const el=document.getElementById('gcon'+i);
    if(!el) return;
    el.classList.toggle('done', (_garFlow==='robo'&&i>=1&&_garStep===3)?true:i<_garStep);
  });
  const back=document.getElementById('garBtnBack');
  if(back) back.style.display=_garStep>0?'':'none';
  const next=document.getElementById('garBtnNext');
  if(next){
    if(_garStep===3){ next.innerHTML='<i class="bi bi-check-circle-fill"></i> Confirmar y enviar'; next.onclick=submitGarantia; }
    else { next.innerHTML='Continuar <i class="bi bi-arrow-right"></i>'; next.onclick=()=>garNav(1); }
  }
  if(_garStep===2) setTimeout(initGarCanvas, 50);
  if(_garStep===3) buildGarSummary();
}

function garNav(dir){
  let next=_garStep+dir;
  if(_garFlow==='robo'){ if(dir>0&&next===2) next=3; if(dir<0&&next===2) next=1; }
  _garStep=Math.max(0,Math.min(3,next));
  renderGarStep();
}

function initGarCanvas(){
  const canvas=document.getElementById('garCanvas');
  if(!canvas||_garCanvasCtx) return;
  canvas.width=canvas.offsetWidth; canvas.height=canvas.offsetHeight||170;
  _garCanvasCtx=canvas.getContext('2d');
  _garCanvasCtx.strokeStyle='#065f46'; _garCanvasCtx.lineWidth=2.5; _garCanvasCtx.lineCap='round';
  const getP=e=>{const rect=canvas.getBoundingClientRect(),t=e.touches?.[0]||e;return{x:t.clientX-rect.left,y:t.clientY-rect.top};};
  canvas.addEventListener('mousedown',e=>{_garCanvasDrawing=true;const p=getP(e);_garCanvasCtx.beginPath();_garCanvasCtx.moveTo(p.x,p.y);});
  canvas.addEventListener('mousemove',e=>{if(!_garCanvasDrawing)return;const p=getP(e);_garCanvasCtx.lineTo(p.x,p.y);_garCanvasCtx.stroke();});
  canvas.addEventListener('mouseup',()=>_garCanvasDrawing=false);
  canvas.addEventListener('touchstart',e=>{e.preventDefault();_garCanvasDrawing=true;const p=getP(e);_garCanvasCtx.beginPath();_garCanvasCtx.moveTo(p.x,p.y);},{passive:false});
  canvas.addEventListener('touchmove',e=>{e.preventDefault();if(!_garCanvasDrawing)return;const p=getP(e);_garCanvasCtx.lineTo(p.x,p.y);_garCanvasCtx.stroke();},{passive:false});
  canvas.addEventListener('touchend',()=>_garCanvasDrawing=false);
}

function clearGarCanvas(){
  const cv=document.getElementById('garCanvas');
  if(cv&&_garCanvasCtx) _garCanvasCtx.clearRect(0,0,cv.width,cv.height);
}

function garPhotoFileChange(e){
  const f=e.target.files[0]; if(!f) return;
  const fr=new FileReader(); fr.onload=ev=>{_garPhotoData=ev.target.result;const pp=document.getElementById('garPhotoPreview');if(pp){pp.src=_garPhotoData;pp.style.display='block';}};
  fr.readAsDataURL(f);
}

function garDenunciaFileChange(e){
  const f=e.target.files[0]; if(!f) return;
  const dn=document.getElementById('garDenunciaName'); if(dn) dn.textContent=f.name;
  const fr=new FileReader(); fr.onload=ev=>_garDenunciaData=ev.target.result; fr.readAsDataURL(f);
}

function buildGarSummary(){
  const el=document.getElementById('garSummary'); if(!el) return;
  if(_garFlow==='tecnica'){
    const canvas=document.getElementById('garCanvas');
    const hasSig=canvas&&!isCanvasBlank(canvas);
    el.innerHTML=`
      <div class="gar-summary-row"><span class="gar-summary-label">Tipo</span><span class="gar-summary-val">🔧 Garantía Técnica</span></div>
      <div class="gar-summary-row"><span class="gar-summary-label">Equipo</span><span class="gar-summary-val">${escHtml(_garEquipName||'—')}</span></div>
      <div class="gar-summary-row"><span class="gar-summary-label">Pieza</span><span class="gar-summary-val">${escHtml(_garPieza||'—')}</span></div>
      <div class="gar-summary-row"><span class="gar-summary-label">Descripción</span><span class="gar-summary-val">${escHtml((document.getElementById('garDescTecnica')?.value||'').trim()||'—')}</span></div>
      <div class="gar-summary-row"><span class="gar-summary-label">Urgencia</span><span class="gar-summary-val">${document.getElementById('garUrgencia')?.value||'normal'}</span></div>
      <div class="gar-summary-row"><span class="gar-summary-label">Firma digital</span><span class="gar-summary-val">${hasSig?'✅ Firmado':'—'}</span></div>
      <div class="gar-summary-row"><span class="gar-summary-label">Foto adjunta</span><span class="gar-summary-val">${_garPhotoData?'✅ Sí':'—'}</span></div>`;
  } else {
    el.innerHTML=`
      <div class="gar-summary-row"><span class="gar-summary-label">Tipo</span><span class="gar-summary-val">🚨 Pérdida / Robo</span></div>
      <div class="gar-summary-row"><span class="gar-summary-label">Equipo</span><span class="gar-summary-val">${escHtml(_garEquipName||'—')}</span></div>
      <div class="gar-summary-row"><span class="gar-summary-label">¿Cuándo?</span><span class="gar-summary-val">${escHtml(document.getElementById('garCuando')?.value||'—')}</span></div>
      <div class="gar-summary-row"><span class="gar-summary-label">¿Dónde?</span><span class="gar-summary-val">${escHtml(document.getElementById('garDonde')?.value||'—')}</span></div>
      <div class="gar-summary-row"><span class="gar-summary-label">¿Hora?</span><span class="gar-summary-val">${escHtml(document.getElementById('garHora')?.value||'—')}</span></div>
      <div class="gar-summary-row"><span class="gar-summary-label">Denuncia policial</span><span class="gar-summary-val">${_garDenunciaData?'✅ Adjunta':'—'}</span></div>`;
  }
}

async function submitGarantia(){
  const btn=document.getElementById('garBtnNext'); if(btn) btn.disabled=true;
  const email=localStorage.getItem('portal_user_email')||'';
  const name=localStorage.getItem('portal_user_name')||'';
  try{
    const canvas=document.getElementById('garCanvas');
    const firma=(_garFlow==='tecnica'&&canvas&&!isCanvasBlank(canvas))?canvas.toDataURL('image/png'):null;
    const body={
      portalEmail:email, portalName:name, employeeId:_garEmpId, equipmentId:_garEquipId, equipmentName:_garEquipName,
      tipo:_garFlow,
      pieza:_garFlow==='tecnica'?_garPieza:'',
      descripcion:_garFlow==='tecnica'?(document.getElementById('garDescTecnica')?.value||'').trim():'',
      urgencia:_garFlow==='tecnica'?(document.getElementById('garUrgencia')?.value||'normal'):'',
      cuando_ocurrio:_garFlow==='robo'?(document.getElementById('garCuando')?.value||''):'',
      donde_ocurrio:_garFlow==='robo'?(document.getElementById('garDonde')?.value||''):'',
      hora_ocurrio:_garFlow==='robo'?(document.getElementById('garHora')?.value||''):'',
      denuncia_data:_garDenunciaData||null, firma_digital:firma, foto_data:_garPhotoData||null,
    };
    const r=await fetch('/api/portal/garantia',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    const d=await r.json();
    if(!d.success) throw new Error(d.error||'Error');
    document.getElementById('garModalOverlay').classList.remove('show');
    const t=document.createElement('div');
    t.style.cssText='position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#064e3b,#059669);color:#fff;padding:12px 24px;border-radius:12px;font-size:13px;font-weight:700;z-index:99999;box-shadow:0 8px 24px rgba(0,0,0,.3);';
    t.textContent=_garFlow==='robo'?'🚨 Incidencia de pérdida/robo registrada. Pendiente de revisión.':'✅ Solicitud de garantía registrada. Pendiente de aprobación.';
    document.body.appendChild(t); setTimeout(()=>t.remove(),4000);
  }catch(e){ alert('Error al enviar: '+e.message); }
  finally{ if(btn) btn.disabled=false; }
}

