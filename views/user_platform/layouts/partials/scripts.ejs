// ── PAGE IFRAME MODAL ─────────────────────────────────────────────────────
function openPageModal(baseUrl, opts){
  const email = localStorage.getItem('portal_user_email')||'';
  const name  = localStorage.getItem('portal_user_name')||email;
  const theme = localStorage.getItem('dashboardTheme')||'light';
  const sep   = baseUrl.includes('?')? '&':'?';
  let url = email ? baseUrl+sep+'reporter='+encodeURIComponent(email)+'&name='+encodeURIComponent(name) : baseUrl+sep+'_=1';
  url += '&theme='+theme;
  document.getElementById('pfModalFrame').src = url;
  const overlay = document.getElementById('pfModalOverlay');
  const box     = document.getElementById('pfModalBox');
  if(opts && opts.full && box){
    overlay.style.padding    = '0';
    box.style.maxWidth       = '100%';
    box.style.width          = '100%';
    box.style.height         = '100vh';
    box.style.borderRadius   = '0';
  } else if(box){
    overlay.style.padding    = '16px';
    box.style.maxWidth       = (opts && opts.wide) ? '940px' : '700px';
    box.style.width          = '100%';
    box.style.height         = 'min(93vh,860px)';
    box.style.borderRadius   = '16px';
  }
  overlay.style.display = 'flex';
}
function closePageModal(){
  document.getElementById('pfModalOverlay').style.display = 'none';
  document.getElementById('pfModalFrame').src = '';
}

