function _cbInferPriority(text) {
  const t = text.toLowerCase();
  if (/sin internet|caído|caido|todos sin|producción|produccion|bloqueado.*todos|sistema.*caído|urgente|critico|crítico/.test(t)) return 'P1';
  if (/no funciona|sin acceso|bloqueado|no puedo|no logro|no enciende|no arranca|error grave|falla total/.test(t)) return 'P2';
  return 'P3';
}
