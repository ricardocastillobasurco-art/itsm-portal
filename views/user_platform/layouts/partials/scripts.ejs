      return;
    }
    const stMap = {pendiente:{lbl:'⏳ Pendiente',clr:'#d97706'},imprimiendo:{lbl:'🖨️ Imprimiendo',clr:'#2563eb'},completado:{lbl:'✅ Completado',clr:'#059669'},cancelado:{lbl:'⛔ Cancelado',clr:'#64748b'},error:{lbl:'❌ Error',clr:'#dc2626'}};
    el.innerHTML = items.map(p => {
      const st = stMap[p.status] || {lbl:p.status||'—',clr:'#64748b'};
      const fname = p.file_original || p.file_name || '—';
      const dt = p.queued_at ? new Date(p.queued_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—';
      return `<div style="background:var(--bg-main);border:1px solid var(--border-soft);border-radius:10px;padding:12px 14px;margin-bottom:8px;display:flex;align-items:center;gap:12px;">
        <i class="bi bi-file-earmark-text" style="font-size:20px;color:var(--muted);flex-shrink:0;"></i>
        <div style="flex:1;min-width:0;">
          <div style="font-size:13px;font-weight:700;color:var(--text-main);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${fname}</div>
          <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">${dt}${p.num_pages ? ' · ' + p.num_pages + ' pág.' : ''}</div>
        </div>
        <span style="font-size:11px;font-weight:700;color:${st.clr};white-space:nowrap;background:${st.clr}18;padding:3px 8px;border-radius:6px;">${st.lbl}</span>
