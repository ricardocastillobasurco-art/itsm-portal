async function submitTktClose(){
  const comment  = document.getElementById('tktCloseComment').value.trim();
  const reporter = localStorage.getItem('portal_user_email') || _cbPrivEmail || '';
  const statusEl = document.getElementById('tktCloseStatus');
  const btn      = document.getElementById('tktCloseSendBtn');
  if(!comment){ statusEl.style.color='var(--danger)'; statusEl.textContent='El comentario es obligatorio.'; return; }
  btn.disabled = true; btn.textContent = 'Cerrando…';
  statusEl.textContent = '';
  try {
    const r = await fetch('/api/jira/my-tickets/'+encodeURIComponent(_tktCurrentKey)+'/close', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ reporter, comment })
    });
    const d = await r.json();
    if(d.jiraClosed){
      statusEl.style.color = 'var(--success,#10b981)';
      statusEl.textContent = '✓ Ticket cerrado en Jira correctamente.';
      document.getElementById('tktCloseBtn').style.display = 'none';
      document.getElementById('tktTrkBadge').innerHTML = '<span class="tkt-badge tkt-closed">Cerrado</span>';
      setTimeout(()=>{ document.getElementById('tktClosePanel').style.display='none'; }, 2200);
    } else {
      statusEl.style.color = 'var(--danger)';
      statusEl.textContent = d.message || 'Error al cerrar en Jira.';
    }
  } catch(e){
    statusEl.style.color = 'var(--danger)';
    statusEl.textContent = 'Error de conexión.';
  } finally {
    btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Confirmar cierre';
  }
}

function tktFmtDate(d){
  if(!d||isNaN(d)) return '';
  return d.toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'2-digit',hour:'2-digit',minute:'2-digit'});
}
function tktTimeAgo(d){
  if(!d||isNaN(d)) return '';
  const diff = Date.now()-d;
  const m=Math.floor(diff/6e4),h=Math.floor(diff/36e5),dd=Math.floor(diff/864e5);
  if(dd>0) return 'hace '+dd+' día'+(dd>1?'s':'');
  if(h>0)  return 'hace '+h+' hora'+(h>1?'s':'');
  if(m>0)  return 'hace '+m+' min';
  return 'ahora mismo';
}
function statusTktClass(s){
  return {abierto:'tkt-open',asignado:'tkt-prog',en_progreso:'tkt-prog',pendiente:'tkt-pend',pendiente_usuario:'tkt-pend',resuelto:'tkt-done',cerrado:'tkt-closed'}[s]||'tkt-closed';
}
function statusTktLabel(s){
  return {abierto:'Abierto',asignado:'Asignado',en_progreso:'En progreso',pendiente:'Pendiente',pendiente_usuario:'Pendiente usuario',resuelto:'Resuelto',cerrado:'Cerrado'}[s]||s;
}
function priorityTktClass(p){
  return {P1:'tkt-p1',P2:'tkt-p2',P3:'tkt-p3',P4:'tkt-p4'}[p]||'tkt-p4';
}

