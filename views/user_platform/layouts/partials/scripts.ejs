  document.getElementById('comunListView').style.display = 'block';
}

function toggleComunInvite(){
  const f = document.getElementById('comunInviteForm');
  f.style.display = f.style.display === 'none' ? 'block' : 'none';
}

async function enviarInvitacion(){
  const target = document.getElementById('comunInviteEmail').value.trim();
  if(!target){ alert('Ingresa un correo'); return; }
  const email = localStorage.getItem('portal_user_email') || '';
  try {
    const r = await fetch(`/api/portal/communities/${_currentComunId}/invite`, {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ inviter_email: email, target_email: target })
    });
    const d = await r.json();
    if(!d.success) throw new Error(d.error);
    document.getElementById('comunInviteEmail').value = '';
    document.getElementById('comunInviteForm').style.display = 'none';
    alert('✅ Invitación enviada');
  } catch(e) { alert('Error: ' + e.message); }
}

async function loadComunFeed(comunId){
  const list = document.getElementById('comunFeedList');
  list.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i></div>';
  const email = localStorage.getItem('portal_user_email') || '';
  try {
    const r = await fetch(`/api/portal/communities/${comunId}/feed?email=${encodeURIComponent(email)}`, {credentials:'include'});
    const d = await r.json();
    if(!d.success){ list.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;">Únete a esta comunidad para ver su feed.</div>'; return; }
    const items = d.data || [];
    if(!items.length){ list.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;">No hay publicaciones en esta comunidad aún.</div>'; return; }
    const _REACT_MAP = [{r:'like',e:'👍'},{r:'love',e:'❤️'},{r:'clap',e:'👏'},{r:'insight',e:'💡'}];
    list.innerHTML = items.map(a => {
      const dateStr = a.created_at ? new Date(a.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short'}) : '';
      const init = (a.author_name||a.author_email||'?')[0].toUpperCase();
      const reacts = _REACT_MAP.map(({r,e}) => {
        const n = a['r_'+r]||0;
        return `<button class="ig-react-btn${a.my_reaction===r?' active':''}" onclick="reactAnuncioIg(${a.id},'${r}',this)">${e}</button><span class="ig-react-count">${n||''}</span>`;
      }).join('');
      return `<div class="ig-post">
        <div class="ig-post-header"><div class="ig-avatar">${init}</div>
          <div style="flex:1"><div class="ig-author-name">${escHtml(a.author_name||a.author_email||'?')}</div><div class="ig-post-date">${dateStr}</div></div>
        </div>
        ${a.title?`<div class="ig-post-body"><div class="ig-post-title">${escHtml(a.title)}</div></div>`:''}
        ${a.body?`<div class="ig-post-body" style="padding-top:0">${escHtml(a.body)}</div>`:''}
        ${a.image_data?`<img class="ig-post-img" src="${a.image_data}" alt="" loading="lazy">`:''}
        <div class="ig-reactions">${reacts}</div>
      </div>`;
    }).join('');
  } catch(e) { list.innerHTML = '<div style="color:var(--danger);text-align:center;padding:16px;font-size:13px;">Error al cargar.</div>'; }
}

async function crearComunidad(){
  const nombre = document.getElementById('comunNombre').value.trim();
  const desc   = document.getElementById('comunDesc').value.trim();
  if(!nombre||!desc){ alert('Completa nombre y descripción'); return; }
  const email = localStorage.getItem('portal_user_email') || '';
  const name  = localStorage.getItem('portal_user_name')  || '';
  if(!email){ alert('Identifícate primero'); return; }
  try {
    await fetch('/api/portal/communities', {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ nombre, descripcion: desc, email, name })
    });
    document.getElementById('comunNombre').value = '';
    document.getElementById('comunDesc').value   = '';
    document.getElementById('crearComunForm').style.display = 'none';
    loadComunidades();
  } catch(e) { alert('Error al crear'); }
}

// ── SOLICITUDES ───────────────────────────────────────────────────────────────
let _solTab = 'recv';

function switchSolTab(tab){
  _solTab = tab;
  document.getElementById('solTab-recv').classList.toggle('active', tab==='recv');
  document.getElementById('solTab-sent').classList.toggle('active', tab==='sent');
  document.getElementById('solRecv').style.display = tab==='recv' ? 'block' : 'none';
  document.getElementById('solSent').style.display = tab==='sent' ? 'block' : 'none';
  loadSolicitudesTab(tab);
}

async function loadSolicitudes(){
  await Promise.all([loadSolicitudesTab('recv'), loadSolicitudesTab('sent')]);
}

async function loadSolicitudesTab(tab){
  const el = document.getElementById(tab==='recv'?'solRecv':'solSent');
  el.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i></div>';
  const email = localStorage.getItem('portal_user_email') || '';
  if(!email){ el.innerHTML='<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;">Identifícate para ver solicitudes.</div>'; return; }
  const endpoint = tab==='recv' ? `/api/portal/solicitudes/received?email=${encodeURIComponent(email)}` : `/api/portal/solicitudes/sent?email=${encodeURIComponent(email)}`;
  try {
    const r = await fetch(endpoint, {credentials:'include'});
    const d = await r.json();
    const items = d.data || [];
    if(!items.length){
      el.innerHTML = `<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;">${tab==='recv'?'No tienes solicitudes pendientes.':'No has enviado solicitudes.'}</div>`;
      return;
    }
    if(tab === 'recv'){
      el.innerHTML = items.map(s => `
        <div class="sol-row">
          <div class="sol-row-avatar">${(s.name||s.email||'?')[0].toUpperCase()}</div>
          <div style="flex:1;min-width:0;">
            <div style="font-size:13px;font-weight:700;color:var(--text-main);">${escHtml(s.name||s.email)}</div>
            <div style="font-size:11px;color:var(--text-muted);">${escHtml(s.email)} · <b>${escHtml(s.community_name)}</b> · ${new Date(s.created_at).toLocaleDateString('es-PE')}</div>
          </div>
          <div style="display:flex;gap:6px;flex-shrink:0;">
            <button onclick="responderSolicitud(${s.id},'accept')" style="padding:6px 12px;border-radius:7px;border:none;background:#d1fae5;color:#047857;font-size:12px;font-weight:700;cursor:pointer;">Aceptar</button>
            <button onclick="responderSolicitud(${s.id},'reject')" style="padding:6px 12px;border-radius:7px;border:none;background:#fee2e2;color:#b91c1c;font-size:12px;font-weight:700;cursor:pointer;">Rechazar</button>
          </div>
        </div>`).join('');
    } else {
      const statusMap = {pending:'sol-status-pending',accepted:'sol-status-accepted',rejected:'sol-status-rejected'};
      const statusLabel = {pending:'Pendiente',accepted:'Aceptado',rejected:'Rechazado'};
      el.innerHTML = items.map(s => `
        <div class="sol-row">
          <div class="comun-avatar" style="width:36px;height:36px;border-radius:8px;font-size:14px;"><i class="bi bi-people-fill"></i></div>
          <div style="flex:1;min-width:0;">
            <div style="font-size:13px;font-weight:700;color:var(--text-main);">${escHtml(s.community_name)}</div>
            <div style="font-size:11px;color:var(--text-muted);">${new Date(s.created_at).toLocaleDateString('es-PE')}</div>
          </div>
          <span class="sol-status ${statusMap[s.status]||''}">${statusLabel[s.status]||s.status}</span>
        </div>`).join('');
    }
  } catch(e){ el.innerHTML='<div style="color:var(--danger);text-align:center;padding:16px;font-size:13px;">Error al cargar.</div>'; }
}

async function responderSolicitud(id, action){
  const email = localStorage.getItem('portal_user_email') || '';
  try {
    const r = await fetch(`/api/portal/solicitudes/${id}/${action}`, {
      method:'PUT', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ admin_email: email })
    });
    const d = await r.json();
    if(!d.success) throw new Error(d.error);
    loadSolicitudesTab('recv');
  } catch(e){ alert('Error: ' + e.message); }
}

// ── BUSCAR ────────────────────────────────────────────────────────────────────
let _buscarTimer = null;
function debounceBuscar(val){
  clearTimeout(_buscarTimer);
  if(!val.trim()){ loadBuscarDefault(); return; }
  _buscarTimer = setTimeout(() => buscarEntidad(), 320);
}

async function loadBuscarDefault(){
  const res = document.getElementById('buscarResult');
  const email = localStorage.getItem('portal_user_email') || '';
  res.innerHTML = '<div style="font-size:12px;font-weight:700;color:var(--text-muted);margin-bottom:10px;text-transform:uppercase;letter-spacing:.5px;">Comunidades disponibles</div>';
  try {
    const r = await fetch(`/api/portal/communities?email=${encodeURIComponent(email)}`, {credentials:'include'});
    const d = await r.json();
    const items = d.data || [];
    if(!items.length){ res.innerHTML += '<div style="text-align:center;padding:16px;color:var(--text-muted);font-size:13px;">No hay comunidades aún.</div>'; return; }
    res.innerHTML += items.map(c => {
      const isMember = !!c.my_role;
      const pending  = c.pending_request === 'pending';
      const btn = isMember
        ? `<span class="badge-member">${c.my_role==='admin'?'👑 Admin':'✅ Integrante'}</span>`
        : pending
          ? `<span class="badge-pending">⏳ Pendiente</span>`
          : `<button onclick="solicitarUnirse(${c.id})" style="padding:5px 12px;border-radius:7px;border:none;background:var(--primary);color:#fff;font-size:11px;font-weight:700;cursor:pointer;">Unirse</button>`;
      return `<div class="comun-card">
        <div class="comun-avatar"><i class="bi bi-people-fill"></i></div>
        <div style="flex:1;min-width:0;">
          <div style="font-size:13px;font-weight:700;color:var(--text-main);">${escHtml(c.nombre)}</div>
          <div style="font-size:11px;color:var(--text-muted);">${c.member_count||0} miembro${c.member_count!==1?'s':''}</div>
        </div>
        ${btn}
      </div>`;
    }).join('');
  } catch(e) {}
}

async function buscarEntidad(){
  const q = document.getElementById('buscarQuery').value.trim();
  const res = document.getElementById('buscarResult');
  if(!q){ loadBuscarDefault(); return; }
  res.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i> Buscando…</div>';
  const email = localStorage.getItem('portal_user_email') || '';
  const q2 = q.replace(/^@/,'');
  try {
    const [usersRes, comsRes] = await Promise.all([
      fetch(`/api/employees/search-emails?q=${encodeURIComponent(q2)}`, {credentials:'include'}),
      fetch(`/api/portal/communities?email=${encodeURIComponent(email)}`, {credentials:'include'})
    ]);
    const users   = (await usersRes.json()).data || [];
    const allComs = (await comsRes.json()).data  || [];
    const coms    = allComs.filter(c => c.nombre.toLowerCase().includes(q2.toLowerCase()));

    // Filtrar publicaciones del caché client-side (instantáneo, sin depender del backend)
    const ql = q2.toLowerCase();
    let anns = _anuncioCache.filter(a =>
      (a.title||'').toLowerCase().includes(ql) ||
      (a.body||'').toLowerCase().includes(ql)  ||
      (a.author_name||'').toLowerCase().includes(ql)
    ).slice(0,5);
    // Si el caché está vacío, intentar backend
    if(!anns.length && _anuncioCache.length === 0){
      try {
        const ar = await fetch(`/api/portal/announcements?email=${encodeURIComponent(email)}&q=${encodeURIComponent(q2)}&limit=5`, {credentials:'include'});
        anns = (await ar.json()).data || [];
      } catch(e) {}
    }

    if(!users.length && !coms.length && !anns.length){
      res.innerHTML = `<div style="text-align:center;padding:32px 16px;">
        <i class="bi bi-search" style="font-size:28px;opacity:.25;display:block;margin-bottom:8px;"></i>
        <div style="font-size:13px;color:var(--text-muted);">Sin resultados para "<strong>${escHtml(q2)}</strong>"</div>
      </div>`;
      return;
    }

    let html = '';

    // ── Publicaciones ──────────────────────────────────────────
    if(anns.length){
      html += `<div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.6px;margin-bottom:10px;display:flex;align-items:center;gap:6px;"><i class="bi bi-megaphone-fill" style="color:#ea580c;"></i> Publicaciones</div>`;
      html += anns.map(a => {
        const init = (a.author_name||a.author_email||'?')[0].toUpperCase();
        const dt   = a.created_at ? new Date(a.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short'}) : '';
        const snippet = (a.body||'').replace(/</g,'&lt;').substring(0,120);
        const _REACT_MAP = [{r:'like',e:'👍'},{r:'love',e:'❤️'},{r:'clap',e:'👏'},{r:'insight',e:'💡'}];
        const reactBtns = _REACT_MAP.map(({r,e}) => {
          const n = a['r_'+r]||0;
          const active = a.my_reaction===r ? ' active' : '';
          return `<button class="ig-react-btn${active}" onclick="reactAnuncioIg(${a.id},'${r}',this)" title="${r}">${e}</button><span class="ig-react-count">${n||''}</span>`;
        }).join('');
        return `<div class="ig-post" id="igpost-${a.id}" style="margin-bottom:10px;">
          <div class="ig-post-header">
            <div class="ig-avatar">${init}</div>
            <div style="flex:1;">
              <div class="ig-author-name">${escHtml(a.author_name||a.author_email||'Soporte TI')}</div>
              <div class="ig-post-date">${dt}</div>
            </div>
            ${a.pinned?'<span style="font-size:11px;font-weight:700;color:#f59e0b;"><i class="bi bi-pin-fill"></i> Fijado</span>':''}
          </div>
          ${a.title?`<div class="ig-post-body"><div class="ig-post-title">${escHtml(a.title)}</div></div>`:''}
          <div class="ig-post-body" style="padding-top:0;color:var(--text-muted);font-size:12px;">${snippet}${(a.body||'').length>120?'…':''}</div>
          ${a.image_data?`<img class="ig-post-img" src="${a.image_data}" alt="" loading="lazy" style="max-height:200px;">` : ''}
          <div class="ig-reactions">${reactBtns}
            <button class="ig-comments-toggle" onclick="toggleIgComments(${a.id},this)"><i class="bi bi-chat"></i> ${a.comment_count||'Comentar'}</button>
          </div>
          <div class="ig-comments-section" id="igcomments-${a.id}">
            <div id="igclist-${a.id}"></div>
            <div class="ig-comment-input-row">
              <div class="ig-comment-avatar">${(localStorage.getItem('portal_user_name')||'U')[0].toUpperCase()}</div>
              <input class="ig-comment-input" id="igcinput-${a.id}" placeholder="Escribe un comentario..." onkeydown="if(event.key==='Enter')submitIgComment(${a.id})">
              <button class="ig-comment-send" onclick="submitIgComment(${a.id})"><i class="bi bi-send-fill" style="font-size:12px;"></i></button>
            </div>
          </div>
        </div>`;
      }).join('');
    }

    // ── Comunidades ────────────────────────────────────────────
    if(coms.length){
      html += `<div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.6px;margin:${anns.length?'14px':0} 0 10px;display:flex;align-items:center;gap:6px;"><i class="bi bi-people-fill" style="color:var(--primary);"></i> Comunidades</div>`;
      html += coms.map(c => {
        const isMember = !!c.my_role;
        const btn = isMember
          ? `<span class="badge-member">${c.my_role==='admin'?'👑 Admin':'✅ Integrante'}</span>`
          : `<button onclick="solicitarUnirse(${c.id})" style="padding:5px 14px;border-radius:20px;border:none;background:var(--primary);color:#fff;font-size:11px;font-weight:700;cursor:pointer;">Unirse</button>`;
        return `<div class="comun-card">
          <div class="comun-avatar"><i class="bi bi-people-fill"></i></div>
          <div style="flex:1;"><div style="font-size:13px;font-weight:700;">${escHtml(c.nombre)}</div>
          <div style="font-size:11px;color:var(--text-muted);">${c.member_count||0} miembros</div></div>
          ${btn}</div>`;
      }).join('');
    }

    // ── Personas ───────────────────────────────────────────────
    if(users.length){
      html += `<div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.6px;margin:${(anns.length||coms.length)?'14px':0} 0 10px;display:flex;align-items:center;gap:6px;"><i class="bi bi-person-fill" style="color:#8b5cf6;"></i> Personas</div>`;
      html += users.slice(0,6).map(it => {
        const init = (it.full_name||it.email||'?')[0].toUpperCase();
        const colors = ['#3b82f6','#8b5cf6','#ec4899','#f59e0b','#10b981','#06b6d4'];
        const col = colors[init.charCodeAt(0)%colors.length];
        return `<div onclick="verPerfilUsuario('${it.email.replace(/'/g,"\\'")}','${(it.full_name||it.email).replace(/'/g,"\\'")}','${col}')"
          style="background:var(--bg-main);border:1px solid var(--border-soft);border-radius:12px;padding:12px 14px;margin-bottom:8px;display:flex;align-items:center;gap:12px;cursor:pointer;transition:box-shadow .2s,border-color .2s;"
          onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,.10)';this.style.borderColor='var(--primary)'"
          onmouseout="this.style.boxShadow='';this.style.borderColor='var(--border-soft)'">
          <div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,${col},${col}88);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;flex-shrink:0;">${init}</div>
          <div style="flex:1;min-width:0;">
            <div style="font-size:13px;font-weight:700;color:var(--text-main);">${escHtml(it.full_name||it.email)}</div>
            <div style="font-size:11px;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escHtml(it.email)}${it.position_name?' · '+escHtml(it.position_name):''}</div>
          </div>
          <i class="bi bi-chevron-right" style="color:var(--text-muted);font-size:13px;flex-shrink:0;"></i>
        </div>`;
      }).join('');
    }

    res.innerHTML = html;
  } catch(e) { res.innerHTML='<div style="color:var(--danger);font-size:13px;text-align:center;padding:16px;">Error en la búsqueda.</div>'; }
}

// ── Perfil de usuario desde búsqueda ─────────────────────────────────────────
async function verPerfilUsuario(email, name, col){
  const res = document.getElementById('buscarResult');
  const init = (name||email)[0].toUpperCase();
  col = col || '#3b82f6';

  res.innerHTML = `
    <div style="margin-bottom:14px;">
      <button onclick="buscarEntidad()" style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:20px;border:1.5px solid var(--border-soft);background:transparent;color:var(--text-muted);font-size:12px;font-weight:700;cursor:pointer;">
        <i class="bi bi-arrow-left"></i> Volver
      </button>
    </div>
    <div style="display:flex;align-items:center;gap:14px;background:var(--bg-main);border:1px solid var(--border-soft);border-radius:14px;padding:16px;margin-bottom:16px;">
      <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,${col},${col}88);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:20px;flex-shrink:0;">${init}</div>
      <div>
        <div style="font-size:15px;font-weight:800;color:var(--text-main);">${escHtml(name)}</div>
        <div style="font-size:12px;color:var(--text-muted);">${escHtml(email)}</div>
      </div>
    </div>
    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.6px;margin-bottom:10px;display:flex;align-items:center;gap:6px;">
      <i class="bi bi-megaphone-fill" style="color:#ea580c;"></i> Publicaciones
    </div>
    <div id="perfilPostsList"><div style="text-align:center;padding:24px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i> Cargando...</div></div>`;

  try {
    const myEmail = localStorage.getItem('portal_user_email') || '';
    const r = await fetch(`/api/portal/announcements?author=${encodeURIComponent(email)}&email=${encodeURIComponent(myEmail)}&limit=20`, {credentials:'include'});
    const d = await r.json();
    const posts = d.data || [];
    const pList = document.getElementById('perfilPostsList');
    if(!pList) return;
    if(!posts.length){
      pList.innerHTML = '<div style="text-align:center;padding:28px;color:var(--text-muted);font-size:13px;"><i class="bi bi-megaphone" style="font-size:24px;opacity:.3;display:block;margin-bottom:8px;"></i>Sin publicaciones aún.</div>';
      return;
    }
    const _RM = [{r:'like',e:'👍'},{r:'love',e:'❤️'},{r:'clap',e:'👏'},{r:'insight',e:'💡'}];
    pList.innerHTML = posts.map(a => {
      const dt = a.created_at ? new Date(a.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}) : '';
      const reactBtns = _RM.map(({r,e}) => {
        const n = a['r_'+r]||0;
        const active = a.my_reaction===r?' active':'';
        return `<button class="ig-react-btn${active}" onclick="reactAnuncioIg(${a.id},'${r}',this)">${e}</button><span class="ig-react-count">${n||''}</span>`;
      }).join('');
      return `<div class="ig-post" id="igpost-${a.id}">
        <div class="ig-post-header">
          <div class="ig-avatar" style="background:linear-gradient(135deg,${col},${col}88);">${init}</div>
          <div style="flex:1;"><div class="ig-author-name">${escHtml(name)}</div><div class="ig-post-date">${dt}</div></div>
          ${a.pinned?'<span style="font-size:11px;font-weight:700;color:#f59e0b;"><i class="bi bi-pin-fill"></i> Fijado</span>':''}
        </div>
        ${a.title?`<div class="ig-post-body"><div class="ig-post-title">${escHtml(a.title)}</div></div>`:''}
        ${a.body?`<div class="ig-post-body" style="padding-top:0;">${escHtml(a.body)}</div>`:''}
        ${a.image_data?`<img class="ig-post-img" src="${a.image_data}" alt="" loading="lazy">`:''}
        <div class="ig-reactions">${reactBtns}
          <button class="ig-comments-toggle" onclick="toggleIgComments(${a.id},this)"><i class="bi bi-chat"></i> ${a.comment_count||'Comentar'}</button>
        </div>
        <div class="ig-comments-section" id="igcomments-${a.id}">
          <div id="igclist-${a.id}"></div>
          <div class="ig-comment-input-row">
            <div class="ig-comment-avatar">${(localStorage.getItem('portal_user_name')||'U')[0].toUpperCase()}</div>
            <input class="ig-comment-input" id="igcinput-${a.id}" placeholder="Escribe un comentario..." onkeydown="if(event.key==='Enter')submitIgComment(${a.id})">
            <button class="ig-comment-send" onclick="submitIgComment(${a.id})"><i class="bi bi-send-fill" style="font-size:12px;"></i></button>
          </div>
        </div>
      </div>`;
    }).join('');
  } catch(e) {
    const pList = document.getElementById('perfilPostsList');
    if(pList) pList.innerHTML = '<div style="color:var(--danger);text-align:center;padding:16px;font-size:13px;">Error al cargar publicaciones.</div>';
  }
}

