      }
      <button onclick="openSWRequest('${sw.id}','permit')" style="flex:1;padding:10px;border-radius:10px;border:1.5px solid #2563eb;background:transparent;color:#2563eb;font-size:13px;font-weight:700;cursor:pointer;"><i class="bi bi-shield-check"></i> Permiso</button>
    </div>`;
  panel.style.display = 'block';
