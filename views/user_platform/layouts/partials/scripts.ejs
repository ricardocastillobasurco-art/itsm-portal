// #2 — Historial localStorage
function _cbSaveHistory() {
  if (!_cbEmail) return;
  try {
    const msgs = Array.from(cbMsgs.querySelectorAll('.msg')).slice(-25).map(function(el) {
      return { w: el.classList.contains('bot') ? 'bot' : 'user', h: el.querySelector('.msg-c')?.innerHTML || '' };
    });
    localStorage.setItem('aria_h_' + _cbEmail, JSON.stringify({ ts: Date.now(), msgs }));
  } catch(_) {}
}

function _cbRestoreHistory() {
  if (!_cbEmail) return false;
  try {
    const raw = localStorage.getItem('aria_h_' + _cbEmail);
    if (!raw) return false;
    const saved = JSON.parse(raw);
    if (!saved.msgs?.length || Date.now() - saved.ts > 8 * 3600 * 1000) {
      localStorage.removeItem('aria_h_' + _cbEmail); return false;
    }
    saved.msgs.forEach(function(m) { cbAddMsg(m.h, m.w); });
    return true;
  } catch(_) { return false; }
}

window.cbNewSession = function() {
  if (_cbEmail) localStorage.removeItem('aria_h_' + _cbEmail);
  cbMsgs.innerHTML = ''; cbGreet();
};

document.getElementById('cbToggle').addEventListener('click', function() {
  cbWin.classList.toggle('active');
