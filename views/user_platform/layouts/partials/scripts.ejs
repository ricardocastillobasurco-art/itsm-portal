function cbProcessImage(file) {
  if (!_cbFlow) _cbFlow = 'incident_desc';
  const reader = new FileReader();
  reader.onload = function(ev) {
    cbAddMsg(`<div style="display:flex;align-items:center;gap:10px;">
      <img src="${ev.target.result}" style="width:56px;height:56px;border-radius:8px;object-fit:cover;border:1.5px solid #e2e8f0;flex-shrink:0;">
      <div><div style="font-size:12px;font-weight:600;color:#475569;">${file.name}</div>
      <div style="font-size:11px;color:#94a3b8;">Analizando imagen…</div></div></div>`, 'user');
    cbInput.disabled = true;
    cbShowTyping();
    const fd = new FormData();
    fd.append('image', file);
    fetch('/api/chatbot/analyze-image', { method: 'POST', body: fd })
      .then(function(r){ return r.json(); })
      .then(function(d) {
        cbHideTyping();
        cbInput.disabled = false;
        if (!d.success || !d.text) {
          cbAddMsg('⚠️ No encontré texto en la imagen. <strong>Describe el error con tus palabras:</strong>', 'bot');
          cbInput.focus();
          return;
        }
        _cbPendingImgToken = d.imageToken || null;
        const snippet = (d.text || '').substring(0, 200).replace(/\n+/g, ' ').trim();
        if (d.faq && d.faq.reply) {
          const _s = JSON.stringify(snippet.substring(0, 180));
          cbAddMsg(`✅ <strong>Encontré información sobre este error:</strong><br><br>${d.faq.reply}<br><br>
            <div class="qopts"><button class="qopt" style="background:#fef2f2;border-color:#fca5a5;color:#dc2626;" onclick="cbHandleIncidentDesc(${_s})">🚨 Registrar de todas formas</button>
            <button class="qopt" onclick="cbCancelFlow()">✓ Ya resolví el problema</button></div>`, 'bot');
          _cbFlow = null;
          return;
        }
        const preview = snippet.length > 140 ? snippet.substring(0, 140) + '…' : snippet;
        cbAddMsg(`🔍 <strong>Texto detectado en la imagen:</strong><br>
          <div style="background:#f8fafc;border-left:3px solid #3b82f6;border-radius:4px;padding:8px 12px;margin:8px 0;font-size:11px;font-family:monospace;color:#334155;white-space:pre-wrap;">${preview}</div>
          Usando esto como descripción de la incidencia…`, 'bot');
        setTimeout(function() { cbHandleIncidentDesc(snippet); }, 700);
      })
      .catch(function() {
        cbHideTyping();
        cbInput.disabled = false;
        cbAddMsg('❌ Error al procesar la imagen. Describe el error con tus palabras:', 'bot');
        cbInput.focus();
      });
  };
  reader.readAsDataURL(file);
}

var _cbSaveDebounce = null;
function cbAddMsg(html, who){
  const d = document.createElement('div');
  d.className = 'msg ' + who;
