async function reactAnuncioIg(id, reaction, btn){
  const email = localStorage.getItem('portal_user_email') || '';
  if(!email){ alert('Identifícate para reaccionar'); return; }
  try {
    const r = await fetch(`/api/portal/announcements/${id}/react`, {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ email, reaction })
    });
    const d = await r.json();
    // Update counts in-place instead of reloading the feed
    const post = document.getElementById('igpost-'+id);
    if(post && d.counts){
      _REACT_MAP.forEach(({r:rk}) => {
        const btns  = post.querySelectorAll(`.ig-react-btn[title="${rk}"]`);
        const spans = post.querySelectorAll('.ig-react-count');
        btns.forEach((b,i) => {
          b.classList.toggle('active', d.my_reaction === rk);
          // span is the next sibling
          const span = b.nextElementSibling;
          if(span) span.textContent = d.counts['r_'+rk] || '';
        });
      });
      // Also update cache entry
      const cached = _anuncioCache.find(a => a.id === id);
      if(cached){
        _REACT_MAP.forEach(({r:rk}) => { cached['r_'+rk] = d.counts['r_'+rk]||0; });
        cached.my_reaction = d.my_reaction;
      }
    } else {
      // fallback: refresh in context
      const inSearch = document.getElementById('buscarQuery')?.value.trim();
      if(inSearch) buscarEntidad(); else loadAnuncios();
    }
  } catch(e) {}
}

