        : '';
      cbAddMsg(`🧑‍💻 <strong>Hablar con especialista</strong><br><br>${_oorNote}Cuéntame brevemente cuál es tu consulta o problema, y te conectaré con un especialista de Workplace IT:<br><span style="font-size:11px;color:#94a3b8;">Ej: "Tengo problemas con mi VPN" o "Necesito ayuda con Teams"</span>`, 'bot');
