    <div style="background:var(--bg-surface,#fff);border-radius:20px;max-width:400px;width:100%;overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.3);animation:tcPop .25s cubic-bezier(.34,1.56,.64,1);">
