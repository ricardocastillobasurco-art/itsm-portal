              style="flex:1;border:1px solid var(--border-soft);border-radius:8px;padding:7px 10px;font-size:12px;background:var(--bg-card,#f8fafc);color:var(--text-main);outline:none;resize:none;font-family:inherit;"></textarea>
            <button onclick="submitPortalComment('${t.id}')" id="cmt-btn-${t.id}"
              style="padding:7px 14px;border:none;border-radius:8px;background:${ac};color:#fff;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;height:38px;">
              <i class="bi bi-send-fill"></i>
            </button>
          </div>` : ''}
        </div>`;
      }).join('');
      _hEl2.style.display = 'block';
    }

    // Render cards
    listEl.innerHTML = sorted.map(t => {
      const cat     = t.categoria ? t.categoria.nombre : '';
      const date    = new Date(t.createdAt).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'2-digit'});
      const isActive= !['resuelto','cerrado'].includes(t.status);
      const cmtAgo  = t.lastCommentAt ? tktTimeAgo(new Date(t.lastCommentAt)) : '';
      const cmtTxt  = t.lastComment ? t.lastComment.replace(/</g,'&lt;').replace(/>/g,'&gt;') : '';
      // Acento de color izquierdo según estado
      const accentColor = {
        abierto:'#3b82f6', asignado:'#8b5cf6', en_progreso:'#f59e0b',
        pendiente:'#f97316', resuelto:'#10b981', cerrado:'#64748b'
      }[t.status] || '#3b82f6';
      const statusIcon = {
        abierto:'bi-folder2-open', asignado:'bi-person-check-fill', en_progreso:'bi-tools',
        pendiente:'bi-hourglass-split', resuelto:'bi-check-circle-fill', cerrado:'bi-lock-fill'
      }[t.status] || 'bi-ticket';
      return `<div class="tkt-card"
          style="border-left:4px solid ${accentColor};padding-left:14px;gap:12px;cursor:default;">
        <div style="width:36px;height:36px;border-radius:10px;background:${accentColor}18;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i class="bi ${statusIcon}" style="font-size:16px;color:${accentColor};"></i>
        </div>
        <div style="flex:1;min-width:0;">
          <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:4px;">
            <span style="font-size:11px;font-weight:800;color:${accentColor};letter-spacing:.3px;">${t.id}</span>
            <span class="tkt-badge ${statusTktClass(t.status)}">${t.jiraStatus || statusTktLabel(t.status)}</span>
            <span class="tkt-badge ${priorityTktClass(t.priority)}">${t.priority||'P3'}</span>
            ${cat?`<span style="font-size:10px;color:var(--text-muted);background:var(--bg-main);padding:1px 6px;border-radius:5px;">${cat}</span>`:''}
          </div>
          <div style="font-size:13px;font-weight:700;color:var(--text-main);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${t.titulo}</div>
          <div style="font-size:11px;color:var(--text-muted);margin-top:2px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <span><i class="bi bi-calendar3"></i> ${date}</span>
            <span style="text-transform:capitalize;"><i class="bi bi-tag"></i> ${t.tipo||'Incidente'}</span>
            ${t.jiraUrl?`<a href="${t.jiraUrl}" target="_blank" onclick="event.stopPropagation()" style="font-size:10px;color:var(--primary);font-weight:700;text-decoration:none;display:flex;align-items:center;gap:3px;"><i class="bi bi-box-arrow-up-right"></i> Ver en Jira</a>`:''}
          </div>
          ${cmtTxt ? `<div style="margin-top:8px;padding:7px 10px;background:var(--bg-main);border-radius:8px;border-left:3px solid ${accentColor}55;">
            <div style="font-size:10px;color:var(--text-muted);font-weight:700;margin-bottom:3px;display:flex;align-items:center;gap:4px;">
              <i class="bi bi-chat-left-dots-fill" style="color:${accentColor};"></i> Último comentario${cmtAgo?' · <span style="font-weight:400;">'+cmtAgo+'</span>':''}
            </div>
            <div style="font-size:11px;color:var(--text-main);line-height:1.5;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">${cmtTxt}</div>
          </div>` : ''}
        </div>
        <div style="flex-shrink:0;display:flex;flex-direction:column;align-items:center;gap:4px;">
          ${isActive?`<span style="width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 3px rgba(34,197,94,.2);" title="Activo"></span>`:''}
        </div>
      </div>`;
    }).join('');

  } catch(e) {
    document.getElementById('allTicketsList').innerHTML =
      '<div style="color:var(--danger);text-align:center;padding:24px;font-size:13px;"><i class="bi bi-exclamation-triangle-fill"></i> Error al cargar tickets.</div>';
  }
}

// ── Comentar ticket desde portal ────────────────────────────────────────────
async function submitPortalComment(key){
  const ta  = document.getElementById('cmt-'+key);
  const btn = document.getElementById('cmt-btn-'+key);
  const txt = ta ? ta.value.trim() : '';
  if(!txt) return;
  const portalEmail = localStorage.getItem('portal_user_email') || _cbPrivEmail || '';
  if(!portalEmail) return;
  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-hourglass-split"></i>';
  try {
    const r = await fetch('/api/jira/my-tickets/'+encodeURIComponent(key)+'/comment', {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ reporter: portalEmail, comment: txt })
    });
    const d = await r.json();
    if(d.success){
      ta.value = '';
      btn.innerHTML = '<i class="bi bi-check-lg"></i>';
      btn.style.background = '#10b981';
      setTimeout(()=>{ btn.disabled=false; btn.innerHTML='<i class="bi bi-send-fill"></i>'; btn.style.background=''; }, 2000);
    } else {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-send-fill"></i>';
      alert(d.error || 'Error al enviar comentario');
    }
  } catch(e) {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-send-fill"></i>';
  }
}

