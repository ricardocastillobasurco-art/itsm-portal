        <div style="font-size:18px;font-weight:700;color:#fff;margin-bottom:4px;">¡${label} registrada!</div>
        <div style="font-size:12px;color:rgba(255,255,255,.78);">Tu solicitud fue enviada a Jira Service Management</div>
      </div>
      <div style="padding:20px 24px;text-align:center;background:var(--bg-surface,#fff);">
        <div style="font-size:11px;color:#5e6c84;margin-bottom:8px;text-transform:uppercase;letter-spacing:.05em;">Número de ticket</div>
        <div style="font-size:28px;font-weight:800;color:${color};font-family:monospace;margin-bottom:16px;letter-spacing:1px;">${key}</div>
        ${url !== '#' ? `<a href="${url}" target="_blank" style="display:inline-flex;align-items:center;gap:6px;padding:7px 16px;border:1.5px solid ${color};color:${color};border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;margin-bottom:16px;"><i class="bi bi-box-arrow-up-right"></i> Ver en Jira</a><br>` : ''}
        <div style="font-size:11px;color:#5e6c84;background:#f4f5f7;border-radius:8px;padding:10px 14px;margin-bottom:16px;">Guarda este número para hacer seguimiento de tu solicitud.</div>
        <button onclick="document.getElementById('_tcOverlay').remove();closePageModal();" style="width:100%;padding:12px;background:${color};color:#fff;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;">
          <i class="bi bi-check2"></i> Aceptar
        </button>
      </div>
    </div>
    <style>@keyframes tcPop{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:scale(1)}}</style>`;
  ov.style.display = 'flex';
});
</script>
