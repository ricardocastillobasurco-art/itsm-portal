async function submitIgComment(id){
  const input = document.getElementById('igcinput-'+id);
  const text = input?.value.trim();
  if(!text) return;
  const email = localStorage.getItem('portal_user_email') || '';
  const name  = localStorage.getItem('portal_user_name') || email;
  if(!email){ alert('Identifícate para comentar'); return; }
  try {
    await fetch(`/api/portal/announcements/${id}/comments`, {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ email, author_name: name, body: text })
    });
    input.value = '';
    const r = await fetch(`/api/portal/announcements/${id}/comments`, {credentials:'include'});
    const d = await r.json();
    renderIgComments(id, d.data||[]);
    const toggle = document.querySelector(`#igpost-${id} .ig-comments-toggle`);
    if(toggle) toggle.innerHTML = `<i class="bi bi-chat"></i> ${d.data.length}`;
  } catch(e) { alert('Error al comentar'); }
}

