      _cbGreeted = true;
      if (_cbRestoreHistory()) {
        cbAddMsg(`<span style="font-size:10px;color:#94a3b8;font-style:italic;">— Conversación anterior restaurada · <button onclick="cbNewSession()" style="background:none;border:none;color:#2563eb;font-size:10px;cursor:pointer;padding:0;text-decoration:underline;">Nueva conversación</button> —</span>`, 'bot');
      } else {
        cbGreet();
      }
    }
    _cbCheckNotifs();
  }
});
