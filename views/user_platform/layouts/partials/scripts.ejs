// ── Flujo: Crear incidencia ───────────────────────────────────────────────
async function cbHandleIncidentDesc(txt) {
  _cbIncidentDesc = txt;
  _cbIncidentPrio = _cbInferPriority(txt);
  _cbFlow = null;
  cbShowTyping();

  // #8 — Enriquecer con CMDB: equipo asignado al usuario
  _cbPendingAssets = '';
  let _assetBadge  = '';
  try {
    const _ar = await fetch('/api/chatbot/my-assets', { credentials: 'include' });
    const _ad = await _ar.json();
    if (_ad.assets?.length) {
      const _a0 = _ad.assets[0];
      _cbPendingAssets = (_ad.assets || []).map(function(a) {
        return `${a.equipment_type||''} ${a.brand||''} ${a.model||''}${a.device_code?' ('+a.device_code+')':''}`.trim();
      }).join(', ');
      _assetBadge = `<div class="cb-cc-img" style="background:#f0fdf4;border-color:#86efac;color:#059669;">💻 ${_a0.equipment_type||'Equipo'}: ${_a0.brand||''} ${_a0.model||''}${_a0.device_code?' ('+_a0.device_code+')':''}</div>`;
    }
  } catch(_) {}

  // Verificar duplicados: buscar tickets abiertos similares
  let _dupeBanner = '';
  try {
    const _kw = txt.split(/\s+/).slice(0, 5).join(' ');
    const _dr = await fetch('/api/chatbot/tickets?q=' + encodeURIComponent(_kw), { credentials: 'include' });
    const _dd = await _dr.json();
    const _open = (_dd.tickets || []).filter(function(t) {
      return !['cerrado', 'resuelto'].includes((t.internal_status || '').toLowerCase());
    }).slice(0, 1);
    if (_open.length) {
      const _ot = _open[0];
      _dupeBanner = `<div style="background:#fffbeb;border:1px solid #fbbf24;border-radius:8px;padding:8px 12px;margin:6px 0 0;font-size:12px;color:#92400e;">
        ⚠️ Ticket similar ya abierto: <strong>${_ot.ticket_key}</strong> — "${(_ot.summary || '').substring(0, 55)}…"<br>
        <span style="font-size:11px;color:#78350f;">¿Es el mismo problema? Puede que ya esté en atención.</span></div>`;
    }
  } catch(_) {}

  await new Promise(function(r) { setTimeout(r, 700); });
  cbHideTyping();
  const prioLabel = _CB_PRIO_LABEL[_cbIncidentPrio] || _cbIncidentPrio;
  const _imgBadge = _cbPendingImgToken ? `<div class="cb-cc-img">📷 Imagen adjunta</div>` : '';
  cbAddMsg(`Entendido, esto es lo que voy a registrar:${_dupeBanner}<div class="cb-confirm-card">
    <div class="cb-cc-label">🎫 Tu incidencia</div>
    <div class="cb-cc-desc">${txt}</div>
    ${_assetBadge}${_imgBadge}
    <div class="cb-cc-prio">📊 Prioridad sugerida: <strong>${prioLabel}</strong></div>
    <div class="cb-cc-actions">
      <button class="cb-cc-btn-ok" onclick="cbConfirmIncident()"><i class="bi bi-check-lg"></i> Registrar ahora</button>
      <button class="cb-cc-btn-cancel" onclick="cbCancelFlow()">✕ Cancelar</button>
    </div>
  </div>`, 'bot');
}

window.cbConfirmIncident = async function() {
  if(!_cbIncidentDesc) return;
  document.querySelectorAll('.cb-cc-btn-ok,.cb-cc-btn-cancel').forEach(function(b){ b.disabled = true; });
  cbShowTyping();
  try {
    const r = await fetch('/api/chatbot/incident', {
      method:'POST', headers:{'Content-Type':'application/json'},
      credentials: 'include',
      body: JSON.stringify({
        summary: _cbIncidentDesc,
        priority: _cbIncidentPrio,
        imageToken: _cbPendingImgToken || undefined,
        outOfHours: _cbOOR || undefined
      })
    });
    if (!r.ok && r.status === 401) throw new Error('no-auth');
    const d = await r.json();
    cbHideTyping();
    if(d.success){
      const _tkUrl  = d.url && d.url.startsWith('http') ? d.url : '/home';
      const _tkLink = d.url && d.url.startsWith('http')
        ? `<a href="${_tkUrl}" target="_blank" class="cb-sc-link"><i class="bi bi-box-arrow-up-right"></i> Ver en Jira</a>`
        : `<a href="/home" class="cb-sc-link"><i class="bi bi-arrow-right-circle-fill"></i> Ver mis tickets</a>`;
      const _oohNote = d.outOfHours
        ? `<div style="margin-top:6px;padding:5px 8px;background:#fef9c3;border:1px solid #fbbf24;border-radius:6px;font-size:11px;color:#78350f;">⏰ Incidencia en estado <strong>Pendiente</strong> — la atenderemos el próximo día hábil a partir de las 8:00 am.</div>`
        : '';
      const _title  = d.isLocal ? '¡Incidencia registrada!' : '¡Incidencia registrada en Jira!';
      const _sub    = d.outOfHours
        ? 'Tu caso fue registrado fuera del horario de atención y se encuentra en espera.'
        : 'El equipo de TI fue notificado y atenderá tu caso según la prioridad asignada.';
      cbAddMsg(`<div class="cb-success-card">
        <div class="cb-sc-icon">${d.outOfHours ? '🕐' : '✅'}</div>
        <div>
          <div class="cb-sc-title">${_title}</div>
          <div><span class="cb-sc-key">${d.key}</span></div>
          <div class="cb-sc-sub">${_sub}</div>
          ${_oohNote}
          ${_tkLink}
        </div>
      </div>`, 'bot');
      _cbIncidentDesc = ''; _cbIncidentPrio = 'P3'; _cbPendingImgToken = null;
      const _csatKey = d.key;
      const _csatId  = _csatKey.replace(/[^A-Z0-9]/g, '');
      setTimeout(function() {
        cbAddMsg(`<div style="background:var(--bg-card,#fff);border:1.5px solid var(--border-soft,#e2e8f0);border-radius:14px;padding:12px 16px;">
          <div style="font-size:12px;font-weight:700;color:var(--text-main,#0f172a);margin-bottom:8px;">¿Cómo fue tu experiencia al reportar?</div>
          <div style="display:flex;gap:6px;justify-content:center;" id="csatS${_csatId}">
            ${[1,2,3,4,5].map(function(n){ return `<button onclick="cbRateCsat(${n},'${_csatKey}')" style="font-size:22px;background:none;border:none;cursor:pointer;padding:2px;" title="${n} estrella${n>1?'s':''}">⭐</button>`; }).join('')}
          </div>
          <div id="csatT${_csatId}" style="display:none;font-size:12px;color:#059669;font-weight:600;text-align:center;">¡Gracias por tu valoración! 🙏</div>
        </div>`, 'bot');
      }, 1200);
      setTimeout(cbShowMenu, 3500);
    } else {
      cbAddMsg('⚠️ No se pudo crear la incidencia. ' + (d.error||'Intenta de nuevo.'), 'bot');
      setTimeout(cbShowMenu, 1500);
    }
  } catch(e){
    cbHideTyping();
    if(e.message === 'no-auth'){
      cbAddMsg('🔒 Tu sesión ha expirado. <a href="/api/auth/login" style="color:#2563eb;font-weight:700;">Inicia sesión de nuevo</a> y vuelve a intentarlo.', 'bot');
    } else {
      cbAddMsg('⚠️ Error de conexión al registrar. Intenta de nuevo.', 'bot');
    }
    setTimeout(cbShowMenu, 1500);
  }
};

// ── Flujo: Buscar ticket ──────────────────────────────────────────────────
async function cbHandleSearch(q) {
  _cbFlow = null;
  cbShowTyping();
  var _isEmail = /^[\w.+%-]+@[\w.-]+\.[a-z]{2,}$/i.test(q.trim());
  try {
    const r = await fetch('/api/chatbot/tickets?q='+encodeURIComponent(q.trim()), { credentials:'include' });
    const d = await r.json();
    cbHideTyping();
    if(d.success && d.tickets && d.tickets.length){
      const cards = d.tickets.map(function(t){
        const sc = ['cerrado','resuelto','closed','resolved'].includes((t.internal_status||'').toLowerCase()) ? 'cerrado' : 'abierto';
        const sl = t.internal_status||'Abierto';
        const dt = t.created_at ? new Date(t.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}) : '—';
        const url = t.jira_url || '/home';
        return `<div class="cb-ticket-card" onclick="window.open('${url}','_blank')" style="cursor:pointer;">
          <div class="cb-tc-top"><span class="cb-tc-key">${t.ticket_key}</span><span class="cb-tc-status ${sc}">${sl}</span></div>
          <div class="cb-tc-title">${t.summary||'(sin título)'}</div>
          <div class="cb-tc-meta"><span>🎯 ${t.priority||'—'}</span><span>📅 ${dt}</span>${t.assigned_to_name?`<span>👤 ${t.assigned_to_name}</span>`:''} ${_isEmail&&t.reporter?`<span style="font-size:10px;color:#64748b;">📧 ${t.reporter}</span>`:''}</div>
        </div>`;
      }).join('');
      var _label = _isEmail ? `tickets de <strong>${q.trim()}</strong>` : `<strong>${d.tickets.length} ticket${d.tickets.length>1?'s':''}</strong>`;
      cbAddMsg(`Encontré ${_label}:${cards}`, 'bot');
      setTimeout(cbShowMenu, 3000);
    } else {
      var _noMsg = _isEmail
        ? `📭 No encontré tickets para <strong>${q.trim()}</strong>.`
        : '🔍 No encontré tickets con esos criterios.';
      cbAddMsg(_noMsg+' <button class="qopt" style="display:inline;padding:4px 10px;font-size:11px;" onclick="cbOptClick(\'search_ticket\')">Buscar de nuevo</button>', 'bot');
      setTimeout(cbShowMenu, 2000);
    }
  } catch(e){
    cbHideTyping();
    cbAddMsg('⚠️ Error al buscar. Puedes ver tus tickets en <a href="/home" style="color:#2563eb;font-weight:700;">Mis Tickets</a>.', 'bot');
    setTimeout(cbShowMenu, 1500);
  }
}

