const _mqIcons = { critical:'bi-exclamation-triangle-fill', warning:'bi-exclamation-circle-fill', info:'bi-info-circle-fill', success:'bi-check-circle-fill' };
const _mqClass = { critical:'mq-critical', warning:'mq-warning', info:'mq-info', success:'mq-success' };

async function loadMarquee(){
  try {
    const r = await fetch('/api/portal/banners');
    const d = await r.json();
    if(!d.success || !d.data?.length) return;
    const wrap = document.getElementById('marqueeWrap');
    const inner = document.getElementById('marqueeInner');
    if(!wrap || !inner) return;
    // Build items (duplicated for seamless loop)
    const items = d.data.map(b => {
      const cls = _mqClass[b.severity] || 'mq-info';
      const ico = _mqIcons[b.severity] || 'bi-info-circle-fill';
      return `<span class="marquee-item ${cls}"><i class="bi ${ico}" style="font-size:16px;flex-shrink:0;"></i>${b.message}</span><span class="marquee-sep ${cls}">◆</span>`;
    }).join('');
    inner.innerHTML = items + items; // duplicate for infinite loop
    wrap.classList.add('has-banners');
    // Adjust animation speed by content length
    const totalLen = d.data.reduce((s,b)=>s+b.message.length,0);
    const dur = Math.max(14, Math.min(40, totalLen * 0.18));
    inner.style.animationDuration = dur + 's';
    // Apply dominant severity class to both wrap (border) and track (background)
    const track = document.getElementById('marqueeTrack');
    const dominant = d.data.find(b=>b.severity==='critical') || d.data.find(b=>b.severity==='warning') || d.data[0];
    const sevCls = _mqClass[dominant.severity] || 'mq-info';
    track.className = 'marquee-track ' + sevCls;
    wrap.className  = 'marquee-wrap has-banners ' + sevCls;
  } catch(e) {}
}
loadMarquee();

