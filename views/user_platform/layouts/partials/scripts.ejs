async function loadComunidades(){
  const list = document.getElementById('comunidadList');
  list.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i> Cargando...</div>';
