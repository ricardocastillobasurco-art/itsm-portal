      const d=await r.json();
      const equips=d.equipment||d.data||[];
      _devEmpId=d.employeeId||null;
      const list=document.getElementById('devEquipList2');
      if(!equips.length){list.innerHTML='<p style="font-size:13px;color:var(--text-muted);text-align:center;padding:16px;">No se encontraron equipos asignados.</p>';return;}
      list.innerHTML=equips.map(eq=>{
        const t=(eq.equipment_type||'').toLowerCase();
        const ico=t.includes('laptop')||t.includes('port')?'bi-laptop':t.includes('cel')||t.includes('móvil')||t.includes('phone')?'bi-phone-fill':t.includes('monitor')?'bi-display-fill':'bi-hdd-fill';
        return `<div class="dev-equip-card sel" id="deq-${eq.id}" onclick="toggleDevEquip(this,${eq.id})">
          <div class="dev-equip-icon"><i class="bi ${ico}"></i></div>
          <div style="flex:1"><div class="dev-equip-name">${escHtml(eq.brand||'')} ${escHtml(eq.model||'')}</div><div class="dev-equip-sub">${escHtml(eq.device_code||'')} · S/N: ${escHtml(eq.serial_number||'—')}</div></div>
          <i class="bi bi-check-circle-fill" id="deqck-${eq.id}" style="color:#10b981;font-size:18px;"></i>
        </div>`;
      }).join('');
      _devEquipIds=equips.map(eq=>eq.id);
    }catch(e){}
  }
}

function toggleDevEquip(el,id){
  const sel=el.classList.contains('sel');
  el.classList.toggle('sel',!sel);
  const ck=document.getElementById('deqck-'+id);
  if(ck) ck.style.color=sel?'var(--border-soft)':'#10b981';
  if(sel) _devEquipIds=_devEquipIds.filter(x=>x!==id);
  else if(!_devEquipIds.includes(id)) _devEquipIds.push(id);
}

function toggleDevCheck(key,el){ _devChecks[key]=!_devChecks[key]; el.classList.toggle('checked',_devChecks[key]); }

function renderDevStep2(){
  document.querySelectorAll('.dev-panel').forEach((p,i)=>p.classList.toggle('active',i===_devStep2));
  [0,1,2,3].forEach(i=>{
    const c=document.getElementById('dsc'+i);
    if(!c) return;
    c.classList.toggle('done',i<_devStep2);
    c.classList.toggle('active',i===_devStep2);
    c.innerHTML=i<_devStep2?'<i class="bi bi-check-lg" style="font-size:10px;"></i>':(i+1).toString();
  });
  [0,1,2].forEach(i=>{ const c=document.getElementById('dcon'+i); if(c) c.classList.toggle('done',i<_devStep2); });
  const back=document.getElementById('devBtnBack2');
  const next=document.getElementById('devBtnNext2');
  if(back) back.style.display=_devStep2>0?'':'none';
  if(next){
    if(_devStep2===3){next.innerHTML='<i class="bi bi-check-lg"></i> Confirmar y enviar';next.onclick=submitDevolucion2;}
    else{next.innerHTML='Continuar <i class="bi bi-arrow-right"></i>';next.onclick=()=>devNav(1);}
  }
  if(_devStep2===3) buildDevSummary();
  if(_devStep2===2) setTimeout(initDevCanvas,120);
}

function devNav(dir){ _devStep2=Math.max(0,Math.min(3,_devStep2+dir)); renderDevStep2(); }

function initDevCanvas(){
  const canvas=document.getElementById('devCanvas');
  if(!canvas) return;
  if(!_devCanvasCtx){
    canvas.width=canvas.offsetWidth||520;
    canvas.height=170;
    _devCanvasCtx=canvas.getContext('2d');
  }
  _devCanvasCtx.strokeStyle='#1e293b';
  _devCanvasCtx.lineWidth=2.5;
  _devCanvasCtx.lineCap='round';
  _devCanvasCtx.lineJoin='round';
  const getPos=e=>{const rect=canvas.getBoundingClientRect();const s=e.touches?e.touches[0]:e;return{x:s.clientX-rect.left,y:s.clientY-rect.top};};
  canvas.onmousedown=e=>{_devCanvasDrawing=true;const p=getPos(e);_devCanvasCtx.beginPath();_devCanvasCtx.moveTo(p.x,p.y);};
  canvas.onmousemove=e=>{if(!_devCanvasDrawing)return;const p=getPos(e);_devCanvasCtx.lineTo(p.x,p.y);_devCanvasCtx.stroke();};
  canvas.onmouseup=canvas.onmouseleave=()=>_devCanvasDrawing=false;
  canvas.ontouchstart=e=>{e.preventDefault();_devCanvasDrawing=true;const p=getPos(e);_devCanvasCtx.beginPath();_devCanvasCtx.moveTo(p.x,p.y);};
  canvas.ontouchmove=e=>{e.preventDefault();if(!_devCanvasDrawing)return;const p=getPos(e);_devCanvasCtx.lineTo(p.x,p.y);_devCanvasCtx.stroke();};
  canvas.ontouchend=()=>_devCanvasDrawing=false;
}

function clearDevCanvas(){
  const canvas=document.getElementById('devCanvas');
  if(!canvas) return;
  const ctx=canvas.getContext('2d');
  ctx.clearRect(0,0,canvas.width,canvas.height);
}

function devPhotoFileChange(e){
  const file=e.target.files[0]; if(!file) return;
  const fr=new FileReader();
  fr.onload=ev=>{_devPhotoData=ev.target.result;const p=document.getElementById('devPhotoPreview');p.src=_devPhotoData;p.style.display='block';};
  fr.readAsDataURL(file);
}

async function openDevCamera(){
  try{
    _devCameraStream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'environment'}});
    const v=document.getElementById('devCameraVideo'); v.srcObject=_devCameraStream;
    document.getElementById('devCameraWrap').style.display='block';
  }catch(e){ alert('No se pudo acceder a la cámara. Usa "Adjuntar foto".'); }
}

function captureDevPhoto(){
  const v=document.getElementById('devCameraVideo');
  const c=document.createElement('canvas'); c.width=v.videoWidth||640; c.height=v.videoHeight||480;
  c.getContext('2d').drawImage(v,0,0);
  _devPhotoData=c.toDataURL('image/jpeg',0.82);
  const p=document.getElementById('devPhotoPreview'); p.src=_devPhotoData; p.style.display='block';
  closeDevCamera();
}

function closeDevCamera(){
  if(_devCameraStream){_devCameraStream.getTracks().forEach(t=>t.stop());_devCameraStream=null;}
  document.getElementById('devCameraWrap').style.display='none';
}

function isCanvasBlank(canvas){
  const d=canvas.getContext('2d').getImageData(0,0,canvas.width,canvas.height).data;
  return !Array.from(d).some(v=>v!==0);
}

function buildDevSummary(){
  const name=localStorage.getItem('portal_user_name')||localStorage.getItem('portal_user_email')||'—';
  const email=localStorage.getItem('portal_user_email')||'—';
  const checks=Object.entries(_devChecks).filter(([,v])=>v).map(([k])=>({celular:'📱 Celular',fotocheck:'🪪 Fotocheck',llaves:'🔑 Llaves',mochila:'🎒 Mochila'}[k]||k)).join(', ')||'Ninguno';
  const canvas=document.getElementById('devCanvas');
  const hasSig=canvas&&!isCanvasBlank(canvas);
  document.getElementById('devSummary2').innerHTML=`
    <div class="dev-summary-row"><span class="dev-summary-label">Empleado</span><span class="dev-summary-val">${escHtml(name)}</span></div>
    <div class="dev-summary-row"><span class="dev-summary-label">Correo</span><span class="dev-summary-val">${escHtml(email)}</span></div>
    <div class="dev-summary-row"><span class="dev-summary-label">Equipos a devolver</span><span class="dev-summary-val">${_devEquipIds.length} equipo(s) seleccionado(s)</span></div>
    <div class="dev-summary-row"><span class="dev-summary-label">Checklist</span><span class="dev-summary-val">${escHtml(checks)}</span></div>
    <div class="dev-summary-row"><span class="dev-summary-label">Firma digital</span><span class="dev-summary-val">${hasSig?'✅ Firmado':'⚠️ Sin firma'}</span></div>
    <div class="dev-summary-row"><span class="dev-summary-label">Foto adjunta</span><span class="dev-summary-val">${_devPhotoData?'✅ Sí':'— No'}</span></div>`;
}

async function submitDevolucion2(){
  const email=localStorage.getItem('portal_user_email')||'';
  const name=localStorage.getItem('portal_user_name')||'';
  if(!email){alert('Identifícate primero');return;}
  const canvas=document.getElementById('devCanvas');
  const firma=(canvas&&!isCanvasBlank(canvas))?canvas.toDataURL('image/png'):'';
  const btn=document.getElementById('devBtnNext2');
  if(btn){btn.disabled=true;btn.innerHTML='<i class="bi bi-hourglass-split"></i> Enviando...';}
  try{
    const r=await fetch('/api/portal/devolucion',{
      method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        portalEmail:email, portalName:name, employeeId:_devEmpId,
        equipmentIds:_devEquipIds,
        devolvio_celular:_devChecks.celular, entrego_fotocheck:_devChecks.fotocheck,
        mantiene_llave:_devChecks.llaves, entrego_mochila:_devChecks.mochila,
        firma_digital:firma, foto_data:_devPhotoData,
        observaciones:document.getElementById('devWrongEquip')?.checked?'Usuario indica equipo incorrecto':''
      })
    });
    const d=await r.json();
    if(d.success){
      closeDevCamera();
      closePModal('devModalOverlay');
      const t=document.createElement('div');
      t.style.cssText='position:fixed;bottom:24px;right:24px;background:linear-gradient(135deg,#be185d,#ec4899);color:#fff;padding:14px 20px;border-radius:14px;font-size:13px;font-weight:700;z-index:99999;box-shadow:0 8px 28px rgba(190,24,93,.4);display:flex;align-items:center;gap:10px;animation:fadeDown .4s ease;';
      t.innerHTML='<i class="bi bi-check-circle-fill" style="font-size:20px;"></i><div><div>¡Solicitud enviada!</div><div style="font-weight:400;font-size:11px;opacity:.9;margin-top:2px;">Pendiente de aprobación por TI</div></div>';
      document.body.appendChild(t);setTimeout(()=>t.remove(),4500);
    }else{alert('Error: '+(d.error||'No se pudo registrar'));}
  }catch(e){alert('Error de conexión');}
  finally{if(btn){btn.disabled=false;btn.innerHTML='<i class="bi bi-check-lg"></i> Confirmar y enviar';btn.onclick=submitDevolucion2;}}
}
