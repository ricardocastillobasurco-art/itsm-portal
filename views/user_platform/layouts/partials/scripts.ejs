async function submitIniciativa(){
  const titulo = document.getElementById('inTitulo').value.trim();
  const desc   = document.getElementById('inDesc').value.trim();
  if(!titulo||!desc){ alert('Completa título y descripción'); return; }
  const email = localStorage.getItem('portal_user_email') || '';
  const name  = localStorage.getItem('portal_user_name')  || '';
  const data = {
    titulo, desc,
    area:    document.getElementById('inArea').value,
    para:    document.getElementById('inParaSirve').value,
    mejora:  document.getElementById('inMejora').value,
    obs:     document.getElementById('inObservacion').value,
    concl:   document.getElementById('inConcl').value,
    visib:   _visibilidad,
    usuarios: document.getElementById('inUsuarios').value,
    email, name
  };
  try {
    await fetch('/api/portal/recommendation', {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ text: JSON.stringify(data), category: 'Iniciativa', type: 'iniciativa' })
    });
  } catch(e) {}
  document.getElementById('iniciativaForm').style.display = 'none';
  ['inTitulo','inDesc','inArea','inParaSirve','inMejora','inObservacion','inConcl','inUsuarios'].forEach(id => { const el=document.getElementById(id); if(el) el.value=''; });
  loadIniciativas();
  alert('✅ ¡Iniciativa publicada! El equipo TI la revisará pronto.');
}

function loadIniciativas(){
  const list = document.getElementById('iniciativasList');
