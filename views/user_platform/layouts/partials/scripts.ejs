  { emoji:'😄', title:'¡Genial, nos alegra mucho!', msg:'Tu satisfacción es nuestra motivación. ¡Gracias!' },
  { emoji:'🤩', title:'¡Muchas gracias!', msg:'¡Nos encanta saber que tu experiencia fue excelente!' }
];
const _starSectionMap = {
  platform: { rowId:'starRow',      labelId:'surveyStarLabel',      store: function(v){ _surveyRating = v; } },
  equip:    { rowId:'starRowEquip', labelId:'surveyStarLabelEquip', store: function(v){ _surveyRatingEquip = v; } },
  app:      { rowId:'starRowApp',   labelId:'surveyStarLabelApp',   store: function(v){ _surveyRatingApp = v; } },
};

function setStar(section, n, btn){
  var cfg = _starSectionMap[section]; if(!cfg) return;
  cfg.store(n);
  document.querySelectorAll('#'+cfg.rowId+' .star-btn').forEach(function(b,i){
    b.classList.toggle('active', i < n);
    b.style.color = i < n ? '#f59e0b' : '#d1d5db';
  });
  btn.classList.remove('pop'); void btn.offsetWidth; btn.classList.add('pop');
  btn.addEventListener('animationend', function(){ btn.classList.remove('pop'); }, {once:true});
  burstStars(btn, n);
  var lbl = document.getElementById(cfg.labelId);
  if(lbl) lbl.textContent = _starLabels[n] || '';
}

function burstStars(el, count){
  const rect = el.getBoundingClientRect();
  const cx = rect.left + rect.width/2;
  const cy = rect.top  + rect.height/2;
  const particles = ['⭐','✨','💫','🌟','⚡'];
  const num = Math.min(4 + count, 10);
  for(let i = 0; i < num; i++){
    const p = document.createElement('span');
    p.className = 'star-particle';
    p.textContent = particles[i % particles.length];
    const angle = (360 / num) * i * (Math.PI / 180);
    const dist  = 40 + Math.random() * 50;
    p.style.setProperty('--tx', Math.cos(angle)*dist + 'px');
    p.style.setProperty('--ty', Math.sin(angle)*dist + 'px');
    p.style.left = cx + 'px';
    p.style.top  = cy + 'px';
    p.style.marginLeft = '-10px';
    p.style.marginTop  = '-10px';
    document.body.appendChild(p);
    p.addEventListener('animationend', () => p.remove());
  }
}

