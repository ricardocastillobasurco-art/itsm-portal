async function cbHandleConsultTopic(txt) {
  _cbFlow = null;
  cbShowTyping();
  try {
    const r = await fetch('/api/chatbot/consult', {
      method:'POST', headers:{'Content-Type':'application/json'}, credentials:'include',
      body: JSON.stringify({
        topic: txt,
        userEmail: localStorage.getItem('portal_user_email') || undefined,
        userName:  localStorage.getItem('portal_user_name')  || undefined
      })
    });
    const d = await r.json();
    cbHideTyping();
    if (d.success) {
      _cbConsultId     = d.id;
      _cbConsultLastId = 0;
      _cbConsultSpec   = '';
      cbAddMsg(`<div class="cci-waiting-card">
        <div class="cci-w-icon">🧑‍💻</div>
        <div class="cci-w-title">Consulta en espera</div>
        <div class="cci-w-sub">Tu solicitud fue registrada. Un especialista<br>de Workplace IT se conectará en breve.</div>
        <div class="cci-w-anim"><span></span><span></span><span></span></div>
      </div>`, 'bot');
      _cbFlow = 'consult_msg';
      cbInput.placeholder = 'Escribe al especialista...';
      _cbConsultPoll = setInterval(_cbPollConsult, 3000);
    } else {
      cbAddMsg('⚠️ No se pudo crear la consulta. ' + (d.error||'Intenta de nuevo.'), 'bot');
      setTimeout(cbShowMenu, 1500);
    }
  } catch(e) {
    cbHideTyping();
    cbAddMsg('⚠️ Error de conexión. Intenta de nuevo.', 'bot');
    setTimeout(cbShowMenu, 1500);
  }
}

async function _cbPollConsult() {
  if (!_cbConsultId) { clearInterval(_cbConsultPoll); return; }
  try {
    const r = await fetch(`/api/chatbot/consult/${_cbConsultId}/messages?since=${_cbConsultLastId}`, {credentials:'include'});
    const d = await r.json();
    if (!d.success) return;
    if (d.session.status === 'active' && d.session.specialist_name && !_cbConsultSpec) {
      _cbConsultSpec = d.session.specialist_name;
      const h4 = document.querySelector('.cb-htitle h4');
      if (h4) h4.innerHTML = `ARIA <span style="font-size:10px;font-weight:600;color:rgba(255,255,255,.75)">· con ${_cbConsultSpec}</span>`;
    }
    if (d.messages && d.messages.length) {
      d.messages.forEach(function(m) {
        if (m.id > _cbConsultLastId) {
          _cbConsultLastId = m.id;
          if (m.sender_role === 'specialist') {
            cbAddMsg(`<div class="cci-spec-msg"><div class="cci-spec-name">${m.sender_name||'Especialista'}</div><div class="cci-spec-text">${m.message}</div></div>`, 'bot');
          } else if (m.sender_role === 'system') {
            cbAddMsg(`<span style="font-size:10px;color:#64748b;font-style:italic;">ℹ️ ${m.message}</span>`, 'bot');
          }
        }
      });
    }
    const st = d.session.status;
    if (st === 'resolved' || st === 'converted') {
      clearInterval(_cbConsultPoll); _cbConsultPoll = null;
      const _closedId = _cbConsultId;
      _cbFlow = null; _cbConsultId = null;
      cbInput.placeholder = 'Escribe tu consulta...';
      const h4 = document.querySelector('.cb-htitle h4');
      if (h4) h4.textContent = 'ARIA';
      if (st === 'converted' && d.session.ticket_key) {
        cbAddMsg(`<div class="cci-resolve-card"><div class="cci-resolve-title">✅ Consulta resuelta · Ticket <strong>${d.session.ticket_key}</strong> creado</div><a href="/home" style="font-size:12px;color:#2563eb;font-weight:700;">Ver mis tickets</a></div>`, 'bot');
      } else {
        cbAddMsg('✅ La consulta fue cerrada por el especialista.', 'bot');
      }
      // Encuesta de satisfacción
      setTimeout(function(){
        cbAddMsg(`<div style="background:var(--bg-card,#fff);border:1.5px solid var(--border-soft,#e2e8f0);border-radius:14px;padding:14px 16px;">
          <div style="font-size:13px;font-weight:700;color:var(--text-main,#0f172a);margin-bottom:8px;">¿Cómo calificarías la atención recibida?</div>
          <div style="display:flex;gap:8px;justify-content:center;margin-bottom:8px;" id="cciSurveyStars">
            ${[1,2,3,4,5].map(n=>`<button onclick="cciRateSurvey(${n},${_closedId})" style="font-size:24px;background:none;border:none;cursor:pointer;padding:2px;" title="${n} estrella${n>1?'s':''}">⭐</button>`).join('')}
          </div>
          <div id="cciSurveyThanks" style="display:none;font-size:12px;color:#059669;font-weight:600;text-align:center;">¡Gracias por tu valoración!</div>
        </div>`, 'bot');
      }, 800);
    }
  } catch(e) { /* ignore */ }
}

