document.getElementById('cbFileInput').addEventListener('change', function(e) {
  const file = e.target.files[0];
  e.target.value = '';
  document.getElementById('cbAttach').classList.remove('active');
  if (file) cbProcessImage(file);
});

// Pegar imagen con Ctrl+V en la ventana del chat
cbWin.addEventListener('paste', function(e) {
  const items = (e.clipboardData || e.originalEvent?.clipboardData)?.items || [];
  for (const item of items) {
    if (item.type.startsWith('image/')) {
      const file = item.getAsFile();
      if (file) { e.preventDefault(); cbProcessImage(file); break; }
    }
  }
});

// Dictado por voz (Web Speech API)
(function() {
  const _SR  = window.SpeechRecognition || window.webkitSpeechRecognition;
  const _mic = document.getElementById('cbMic');
  if (!_SR) { _mic.style.display = 'none'; return; }

  const _rec = new _SR();
  _rec.lang = 'es-ES'; _rec.continuous = false; _rec.interimResults = true;
  let _hadResult = false;

  _mic.addEventListener('click', function() {
    if (_mic.classList.contains('listening')) { _rec.stop(); return; }
    _hadResult = false;
    try {
      _rec.start();
    } catch(e) {
      cbAddMsg('⚠️ No se pudo activar el micrófono. Recarga e intenta de nuevo.', 'bot');
    }
  });

  _rec.onstart = function() {
    _mic.classList.add('listening');
    cbInput.placeholder = '🎤 Escuchando…';
  };

  _rec.onresult = function(e) {
    // Mostrar transcripción parcial en el input mientras habla
    const transcript = Array.from(e.results).map(function(r) { return r[0].transcript; }).join('');
    cbInput.value = transcript;
    _hadResult = e.results[e.results.length - 1].isFinal;
  };

  _rec.onend = function() {
    _mic.classList.remove('listening');
    cbInput.placeholder = 'Pregúntame algo…';
    const txt = cbInput.value.trim();
    if (txt) cbSendMsg();
  };

  _rec.onerror = function(e) {
    _mic.classList.remove('listening');
    cbInput.placeholder = 'Pregúntame algo…';
    cbInput.value = '';
    if (e.error === 'not-allowed') {
      cbAddMsg('🎤 Permisos de micrófono denegados. Habilítalos en la barra del navegador e intenta de nuevo.', 'bot');
    } else if (e.error === 'network') {
      cbAddMsg('⚠️ El dictado por voz requiere HTTPS. Usa el teclado para escribir tu consulta.', 'bot');
    } else if (e.error === 'no-speech') {
      cbAddMsg('🎤 No detecté audio. Habla más cerca del micrófono e intenta de nuevo.', 'bot');
    } else if (e.error !== 'aborted') {
      cbAddMsg('⚠️ Error de micrófono: ' + e.error + '. Intenta de nuevo.', 'bot');
    }
  };
})();

