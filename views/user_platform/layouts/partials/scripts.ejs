                  <i class="bi bi-chat-left-dots-fill" style="color:${ac};"></i> Último comentario${cmtAgo?' · <span style="font-weight:400;">'+cmtAgo+'</span>':''}
                </div>
                <div style="font-size:12px;color:var(--text-main);line-height:1.5;">${cmtTxt}</div>
              </div>`
            : `<div style="font-size:11px;color:var(--text-muted);font-style:italic;margin-bottom:8px;"><i class="bi bi-chat-left"></i> Sin comentarios aún</div>`
          }
          ${!isClosed ? `<div style="display:flex;gap:6px;align-items:flex-end;">
