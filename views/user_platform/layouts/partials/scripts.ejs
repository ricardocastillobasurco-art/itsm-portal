let _devStep2=0, _devChecks={celular:false,fotocheck:false,llaves:false,mochila:false};
let _devEquipIds=[], _devEmpId=null, _devPhotoData='', _devCameraStream=null, _devCanvasCtx=null, _devCanvasDrawing=false;

async function openDevolucionModal(){
  _devStep2=0; _devChecks={celular:false,fotocheck:false,llaves:false,mochila:false};
  _devEquipIds=[]; _devPhotoData=''; _devEmpId=null; _devCanvasCtx=null;
  document.querySelectorAll('.dev-check-item').forEach(i=>i.classList.remove('checked'));
  const prev=document.getElementById('devPhotoPreview'); if(prev){prev.style.display='none';prev.src='';}
