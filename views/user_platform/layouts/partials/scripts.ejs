let _anuncioCache   = [];
let _anuncioPage    = 1;
let _anuncioLoading = false;
let _anuncioHasMore = true;
let _anuncioObserver = null;
const _ANUNCIO_LIMIT = 10;
const _REACT_MAP = [{r:'like',e:'👍'},{r:'love',e:'❤️'},{r:'clap',e:'👏'},{r:'insight',e:'💡'}];

function _renderIgPost(a){
  const dateStr = a.created_at ? new Date(a.created_at).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}) : '';
  const authorInit = (a.author_name||a.author_email||'?')[0].toUpperCase();
  const reactBtns = _REACT_MAP.map(({r,e}) => {
    const n = a['r_'+r]||0;
    const active = a.my_reaction===r ? ' active' : '';
    return `<button class="ig-react-btn${active}" onclick="reactAnuncioIg(${a.id},'${r}',this)" title="${r}">${e}</button><span class="ig-react-count">${n||''}</span>`;
  }).join('');
  const commentLabel = a.comment_count>0 ? `<i class="bi bi-chat"></i> ${a.comment_count}` : `<i class="bi bi-chat"></i> Comentar`;
  return `<div class="ig-post" id="igpost-${a.id}">
    <div class="ig-post-header">
      <div class="ig-avatar">${authorInit}</div>
      <div style="flex:1">
        <div class="ig-author-name">${escHtml(a.author_name||a.author_email||'Soporte TI')}</div>
        <div class="ig-post-date">${dateStr}</div>
      </div>
      ${a.pinned ? '<span style="font-size:11px;font-weight:700;color:#f59e0b;"><i class="bi bi-pin-fill"></i> Fijado</span>' : ''}
    </div>
    ${a.title ? `<div class="ig-post-body"><div class="ig-post-title">${escHtml(a.title)}</div></div>` : ''}
    ${a.body  ? `<div class="ig-post-body" style="padding-top:0">${escHtml(a.body)}</div>` : ''}
    ${a.image_data ? `<img class="ig-post-img" src="${a.image_data}" alt="" loading="lazy">` : ''}
    <div class="ig-reactions">
      ${reactBtns}
      <button class="ig-comments-toggle" onclick="toggleIgComments(${a.id},this)">${commentLabel}</button>
    </div>
    <div class="ig-comments-section" id="igcomments-${a.id}">
      <div id="igclist-${a.id}"></div>
      <div class="ig-comment-input-row">
        <div class="ig-comment-avatar">${(localStorage.getItem('portal_user_name')||'U')[0].toUpperCase()}</div>
        <input class="ig-comment-input" id="igcinput-${a.id}" placeholder="Escribe un comentario..." onkeydown="if(event.key==='Enter')submitIgComment(${a.id})">
        <button class="ig-comment-send" onclick="submitIgComment(${a.id})"><i class="bi bi-send-fill" style="font-size:12px;"></i></button>
      </div>
    </div>
  </div>`;
}

function loadAnuncios(){
  if(_anuncioObserver){ _anuncioObserver.disconnect(); _anuncioObserver = null; }
  _anuncioPage    = 1;
  _anuncioHasMore = true;
  _anuncioLoading = false;
  _anuncioCache   = [];
  const list = document.getElementById('anunciosList');
  list.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i> Cargando...</div>';
  _fetchAnuncios();
}

async function _fetchAnuncios(){
  if(_anuncioLoading || !_anuncioHasMore) return;
  _anuncioLoading = true;
  const email = localStorage.getItem('portal_user_email') || '';
  const list  = document.getElementById('anunciosList');
  try {
    const r = await fetch(`/api/portal/announcements?limit=${_ANUNCIO_LIMIT}&page=${_anuncioPage}&email=${encodeURIComponent(email)}`, {credentials:'include'});
    const d = await r.json();
    const items = d.data || [];
    const isFirst = _anuncioPage === 1;

    if(isFirst) _anuncioCache = items;
    else _anuncioCache = [..._anuncioCache, ...items];

    if(items.length < _ANUNCIO_LIMIT) _anuncioHasMore = false;
    _anuncioPage++;

    // Clear loading placeholder on first page
    if(isFirst) list.innerHTML = '';

    // Remove old sentinel
    const oldSentinel = document.getElementById('_anuncioSentinel');
    if(oldSentinel) oldSentinel.remove();

    if(isFirst && !items.length){
      list.innerHTML = '<div style="text-align:center;padding:28px;color:var(--text-muted);font-size:13px;"><i class="bi bi-megaphone"></i><br>No hay anuncios por ahora.<br><span style="font-size:11px;">¡Sé el primero en publicar algo!</span></div>';
      return;
    }

    // Append new posts with fade-in animation
    items.forEach((a, i) => {
      const wrap = document.createElement('div');
      wrap.innerHTML = _renderIgPost(a);
      const el = wrap.firstElementChild;
      el.style.opacity = '0';
      el.style.transform = 'translateY(8px)';
      el.style.transition = `opacity .25s ${i*40}ms, transform .25s ${i*40}ms`;
      list.appendChild(el);
      requestAnimationFrame(() => { el.style.opacity='1'; el.style.transform='translateY(0)'; });
    });

    if(_anuncioHasMore){
      // Add sentinel for IntersectionObserver
      const sentinel = document.createElement('div');
      sentinel.id = '_anuncioSentinel';
      sentinel.innerHTML = '<div style="text-align:center;padding:14px;color:var(--text-muted);font-size:12px;"><i class="bi bi-three-dots"></i></div>';
      list.appendChild(sentinel);
      _anuncioObserver = new IntersectionObserver(entries => {
        if(entries[0].isIntersecting && !_anuncioLoading) _fetchAnuncios();
      }, { rootMargin: '200px' });
      _anuncioObserver.observe(sentinel);
    } else if(!isFirst || items.length){
      const end = document.createElement('div');
      end.style.cssText = 'text-align:center;padding:16px 0 8px;color:var(--text-muted);font-size:12px;border-top:1px solid var(--border-soft);margin-top:4px;';
      end.innerHTML = '<i class="bi bi-check-all"></i> Viste todas las publicaciones';
      list.appendChild(end);
    }
  } catch(e){
    list.innerHTML = '<div style="color:var(--danger);text-align:center;padding:20px;font-size:13px;">Error al cargar anuncios.</div>';
  } finally {
    _anuncioLoading = false;
  }
}

