            <span class="tkt-badge ${priorityTktClass(t.priority)}">${t.priority||'P3'}</span>
            ${t.categoria?`<span style="font-size:10px;color:var(--text-muted);background:var(--bg-card);padding:1px 7px;border-radius:5px;">${t.categoria.nombre}</span>`:''}
            <span style="font-size:10px;color:var(--text-muted);margin-left:auto;"><i class="bi bi-calendar3"></i> ${dt}</span>
          </div>
          <div style="font-size:13px;font-weight:700;color:var(--text-main);margin-bottom:8px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${t.titulo}</div>
          ${cmtTxt
            ? `<div style="padding:7px 10px;background:var(--bg-card,#f8fafc);border-radius:8px;border-left:3px solid ${ac}55;margin-bottom:8px;">
