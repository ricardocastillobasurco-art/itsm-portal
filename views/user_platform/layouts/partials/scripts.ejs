// ── Estado inline de ticket (INC-XXXX / TK-XXXX) ─────────────────────────
async function cbHandleTicketStatus(key) {
  cbShowTyping();
  try {
    const r = await fetch('/api/chatbot/ticket/' + key, { credentials: 'include' });
    const d = await r.json();
    cbHideTyping();
    if (!d.success || !d.ticket) {
      cbAddMsg(`🔍 No encontré <strong>${key}</strong> en tus tickets.<div class="qopts"><button class="qopt" onclick="cbOptClick('search_ticket')">🔍 Buscar tickets</button></div>`, 'bot');
      return;
    }
    const t  = d.ticket;
    const sc = { abierto:'#f59e0b', asignado:'#3b82f6', en_progreso:'#7c3aed', resuelto:'#059669', cerrado:'#94a3b8', pendiente:'#f97316' };
    const sl = { abierto:'Abierto', asignado:'Asignado', en_progreso:'En progreso', resuelto:'Resuelto', cerrado:'Cerrado', pendiente:'Pendiente' };
    const st  = (t.internal_status || 'abierto').toLowerCase().replace(' ', '_');
    const clr = sc[st] || '#64748b';
    const lbl = sl[st] || t.internal_status || 'Abierto';
    const dt  = t.created_at ? new Date(t.created_at).toLocaleDateString('es-PE', { day:'2-digit', month:'short', year:'numeric' }) : '—';
    cbAddMsg(`<div class="cb-ticket-card" style="cursor:default;">
      <div class="cb-tc-top"><span class="cb-tc-key">${t.ticket_key}</span>
        <span style="background:${clr}22;color:${clr};border:1px solid ${clr}44;border-radius:20px;padding:2px 10px;font-size:11px;font-weight:700;">${lbl}</span>
      </div>
      <div class="cb-tc-title">${t.summary || '—'}</div>
      <div class="cb-tc-meta"><span>🎯 ${t.priority || 'P3'}</span><span>📅 ${dt}</span>${t.assigned_to_name ? `<span>👤 ${t.assigned_to_name}</span>` : ''}</div>
      ${t.jira_url ? `<a href="${t.jira_url}" target="_blank" style="font-size:11px;color:#2563eb;font-weight:700;display:block;margin-top:8px;"><i class="bi bi-box-arrow-up-right"></i> Ver en Jira</a>` : ''}
    </div>`, 'bot');
    setTimeout(cbShowMenu, 2500);
  } catch(_) {
    cbHideTyping();
    cbAddMsg('⚠️ Error al consultar el ticket. Intenta de nuevo.', 'bot');
  }
}

