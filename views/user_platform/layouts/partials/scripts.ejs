// FEATURE 6 — Equipo asignado + Pieza a reemplazar
// ═══════════════════════════════════════════════════════════════════════════
async function loadEquipData(email){
  try {
    const r = await fetch(`/api/portal/devolucion/equipment?email=${encodeURIComponent(email)}`, {credentials:'include'});
    const d = await r.json();
    const equips = d.data || [];
    if(!equips.length) return;
    const eq = equips[0];
    const sec = document.getElementById('equipSection');
    const grid = document.getElementById('equipInfoGrid');
    if(!sec || !grid) return;
    const fields = [
      ['Modelo', eq.brand ? `${eq.brand} ${eq.model||''}`.trim() : (eq.model||'—')],
      ['Nº de Serie', eq.serial_number||'—'],
      ['Área', eq.location_name||eq.area||'—'],
      ['Asignación', eq.assignment_date ? new Date(eq.assignment_date).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}) : '—'],
      ['Estado', eq.status||'—'],
    ];
    grid.innerHTML = fields.map(([lbl,val]) => `
      <div class="equip-info-item">
        <div class="equip-info-label">${lbl}</div>
        <div class="equip-info-value">${val}</div>
      </div>`).join('');
    sec.style.display = 'block';
    // Guardar equipo id para pieza modal
    window._equipId = eq.equipment_id || eq.id;
    window._equipName = `${eq.brand||''} ${eq.model||''}`.trim();
  } catch(e) {}
}

function openPiezaModal(pieza, emoji){
  document.getElementById('piezaTitle').innerHTML = `${emoji} Solicitar reemplazo — ${pieza}`;
  document.getElementById('piezaNombre').value = pieza + (window._equipName ? ` (${window._equipName})` : '');
  document.getElementById('piezaMotivo').value = '';
  document.getElementById('piezaUrgencia').value = 'normal';
  document.getElementById('piezaForm').style.display = 'block';
  document.getElementById('piezaSuccess').style.display = 'none';
  document.getElementById('piezaModalOverlay').classList.add('show');
}

async function submitPieza(){
  const pieza = document.getElementById('piezaNombre').value;
  const motivo = document.getElementById('piezaMotivo').value.trim();
  const urgencia = document.getElementById('piezaUrgencia').value;
  if(!motivo){ alert('Describe el motivo del reemplazo'); return; }
  const email = localStorage.getItem('portal_user_email') || '';
  const name  = localStorage.getItem('portal_user_name')  || '';
  try {
    await fetch('/api/itsm/tickets', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        titulo:      `Reemplazo de pieza: ${pieza}`,
