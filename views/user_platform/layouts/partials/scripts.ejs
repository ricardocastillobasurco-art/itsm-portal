async function loadMisTickets(){
  const listEl = document.getElementById('allTicketsList');
  const _loadingLabel = (_PORTAL_TENANT_ID && _PORTAL_TENANT_ID !== 1) ? 'Cargando tickets…' : 'Consultando Jira…';
  listEl.innerHTML = `<div style="text-align:center;padding:32px;color:var(--text-muted);font-size:13px;"><i class="bi bi-cloud-arrow-down"></i> ${_loadingLabel}</div>`;
  document.getElementById('lastTicketTracking').style.display = 'none';
  const _hEl = document.getElementById('historicoReciente');
  if(_hEl) _hEl.style.display = 'none';

  try {
    const portalEmail = localStorage.getItem('portal_user_email') || _cbPrivEmail || '';
    if(!portalEmail){
      listEl.innerHTML = '<div style="text-align:center;padding:40px 24px;color:var(--text-muted);font-size:13px;"><i class="bi bi-person-x" style="font-size:28px;display:block;margin-bottom:8px;opacity:.4;"></i>Inicia sesión o identifícate en el portal para ver tus tickets.</div>';
      return;
    }

    const days = document.getElementById('tktHistDays')?.value || '90';
    const r = await fetch('/api/jira/my-tickets?reporter='+encodeURIComponent(portalEmail)+'&days='+encodeURIComponent(days), { credentials:'include' });
    const d = await r.json();
    // Solo incidencias en este tab
    const tickets = (d.data || []).filter(t => t.tipo === 'incidente');
    // Actualizar badge del tab incidencias
    const badgeInc = document.getElementById('mtktBadge-inc');
    if(badgeInc){ badgeInc.textContent = tickets.length; badgeInc.style.display = tickets.length ? '' : 'none'; }

    if(!tickets.length){
      listEl.innerHTML = '<div style="text-align:center;padding:40px 24px;color:var(--text-muted);font-size:13px;"><i class="bi bi-inbox" style="font-size:28px;display:block;margin-bottom:8px;opacity:.4;"></i>No tienes incidencias registradas en este período.</div>';
      return;
    }

    const statusOrder = {abierto:0,asignado:1,en_progreso:2,pendiente:3,resuelto:4,cerrado:5};
    const sorted = [...tickets].sort((a,b)=>(statusOrder[a.status]??9)-(statusOrder[b.status]??9));

    // Resumen visual con contadores por estado
    const accentMap = {abierto:'#3b82f6',asignado:'#8b5cf6',en_progreso:'#f59e0b',pendiente:'#f97316',resuelto:'#10b981',cerrado:'#64748b'};
    const counts = sorted.reduce((acc,t)=>{ acc[t.status]=(acc[t.status]||0)+1; return acc; },{});
    
    // KPI Counters (Total, Abiertos, Cerrados)
    const total = tickets.length;
    const openCount = tickets.filter(t => !['resuelto','cerrado'].includes(t.status)).length;
    const closedCount = total - openCount;
    
    const kpiCards = `
      <div style="display:flex;align-items:center;gap:6px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:6px 12px;flex:1;min-width:90px;">
        <span style="font-size:18px;font-weight:900;color:#64748b;line-height:1;">${total}</span>
        <span style="font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.4px;">Total</span>
      </div>
      <div style="display:flex;align-items:center;gap:6px;background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:6px 12px;flex:1;min-width:90px;">
        <span style="font-size:18px;font-weight:900;color:#d97706;line-height:1;">${openCount}</span>
        <span style="font-size:10px;font-weight:700;color:#d97706;text-transform:uppercase;letter-spacing:.4px;">Abiertos</span>
      </div>
      <div style="display:flex;align-items:center;gap:6px;background:#ecfdf5;border:1px solid #a7f3d0;border-radius:10px;padding:6px 12px;flex:1;min-width:90px;">
        <span style="font-size:18px;font-weight:900;color:#059669;line-height:1;">${closedCount}</span>
        <span style="font-size:10px;font-weight:700;color:#059669;text-transform:uppercase;letter-spacing:.4px;">Cerrados</span>
      </div>
    `;

    const summaryCards = Object.entries(counts).map(([s,n])=>{
      const clr = accentMap[s]||'#64748b';
      return `<div style="display:flex;align-items:center;gap:6px;background:${clr}12;border:1px solid ${clr}30;border-radius:10px;padding:6px 12px;">
        <span style="font-size:18px;font-weight:900;color:${clr};line-height:1;">${n}</span>
        <span style="font-size:10px;font-weight:700;color:${clr};text-transform:uppercase;letter-spacing:.4px;">${statusTktLabel(s)}</span>
      </div>`;
    }).join('');

    document.getElementById('lastTicketTracking').innerHTML =
      `<div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;color:var(--text-muted);margin-bottom:10px;"><i class="bi bi-bar-chart-fill"></i> Resumen del Histórico</div>
       <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;">${kpiCards}</div>
       <div style="display:flex;gap:8px;flex-wrap:wrap;">${summaryCards}</div>`;
    document.getElementById('lastTicketTracking').style.display = 'block';

    // Histórico reciente: últimos 3 por fecha de creación
    const _hEl2 = document.getElementById('historicoReciente');
    const _hList = document.getElementById('historicoRecienteList');
    if(_hEl2 && _hList){
      const recent3 = [...tickets].sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt)).slice(0,3);
      _hList.innerHTML = recent3.map(t => {
        const ac = {abierto:'#3b82f6',asignado:'#8b5cf6',en_progreso:'#f59e0b',pendiente:'#f97316',resuelto:'#10b981',cerrado:'#64748b'}[t.status]||'#3b82f6';
        const dt = new Date(t.createdAt).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'2-digit'});
        const cmtTxt = t.lastComment ? t.lastComment.replace(/</g,'&lt;').replace(/>/g,'&gt;') : '';
        const cmtAgo = t.lastCommentAt ? tktTimeAgo(new Date(t.lastCommentAt)) : '';
        const isClosed = ['resuelto','cerrado'].includes(t.status);
        return `<div style="border:1px solid var(--border-soft);border-left:4px solid ${ac};border-radius:10px;padding:12px 14px;background:var(--bg-main);">
          <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;flex-wrap:wrap;">
            <span style="font-size:11px;font-weight:800;color:${ac};">${t.id}</span>
