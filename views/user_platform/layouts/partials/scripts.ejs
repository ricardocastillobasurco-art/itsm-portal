const _starLabels = ['','😞 Muy malo','😕 Malo','😐 Regular','😊 Bueno','🤩 ¡Excelente!'];
const _starThanks = [
  '',
  { emoji:'😞', title:'Lamentamos tu experiencia', msg:'Gracias por contarnos. Usaremos tu feedback para mejorar urgentemente.' },
  { emoji:'😕', title:'Gracias por tu honestidad', msg:'Trabajaremos para superar tus expectativas la próxima vez.' },
