async function cbGreet(){
  const firstName = (_cbName || '').split(' ')[0] || 'usuario';
  const _now = new Date();
  const hr   = _now.getHours();
  const saludo = hr < 12 ? 'Buenos días' : hr < 19 ? 'Buenas tardes' : 'Buenas noches';

  // #10 — Tickets abiertos del usuario
  let _openCtx = '';
  if (_cbEmail) {
    try {
      const _r = await fetch('/api/chatbot/tickets', { credentials: 'include' });
      const _d = await _r.json();
      const _open = (_d.tickets || []).filter(function(t) {
        return !['cerrado','resuelto'].includes((t.internal_status||'').toLowerCase());
      }).slice(0, 3);
      if (_open.length) {
        const _stI = { abierto:'🔵', asignado:'🟡', en_progreso:'🟠', pendiente:'🔴' };
        const _chips = _open.map(function(t) {
          const _ic = _stI[(t.internal_status||'abierto').toLowerCase()] || '🔘';
          return `<button class="qopt" style="font-size:11px;padding:3px 9px;" onclick="cbHandleTicketStatus('${t.ticket_key}')">${_ic} ${t.ticket_key}: ${(t.summary||'').substring(0,32)}…</button>`;
        }).join('');
        _openCtx = `<div style="margin-top:10px;padding:8px 10px;background:#f0f9ff;border-radius:8px;border:1px solid #bae6fd;font-size:12px;color:#0369a1;">
          📋 Tienes <strong>${_open.length}</strong> ticket${_open.length>1?'s':''} abierto${_open.length>1?'s':''}:<div class="qopts" style="margin-top:4px;">${_chips}</div></div>`;
      }
    } catch(_) {}
  }

  cbAddMsg(`${saludo}, <strong>${firstName}</strong> 👋<br>Soy <strong>ARIA</strong>, tu asistente de TI. ¿En qué puedo ayudarte hoy?${_openCtx}<div class="qopts">
    <button class="qopt" style="background:#fef2f2;border-color:#fca5a5;color:#dc2626;" onclick="cbOptClick('create_incident')">🚨 Crear incidencia</button>
    <button class="qopt" style="background:#eff6ff;border-color:#93c5fd;color:#2563eb;" onclick="cbOptClick('search_ticket')">🔍 Buscar mi ticket</button>
    <button class="qopt" style="background:#f0fdf4;border-color:#86efac;color:#059669;" onclick="cbOptClick('create_req')">📋 Nuevo requerimiento</button>
    <button class="qopt" onclick="cbOptClick('net_account')">🔑 Cuenta de red</button>
    <button class="qopt" onclick="cbOptClick('my_licenses')">📦 Mis licencias</button>
    <button class="qopt" style="background:#f0f9ff;border-color:#bae6fd;color:#0284c7;" onclick="cbOptClick('consult_spec')">🧑‍💻 Hablar con especialista</button>
    <button class="qopt" onclick="cbOptClick('know_me')" style="background:linear-gradient(135deg,#fef3c7,#fde68a);color:#92400e;border-color:#fbbf24;">💬 Conócenos más...</button>
  </div>`, 'bot');
}

