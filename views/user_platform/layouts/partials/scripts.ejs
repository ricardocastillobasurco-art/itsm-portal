  if (_PORTAL_TENANT_ID && _PORTAL_TENANT_ID !== 1) {
    el.innerHTML = '<div style="text-align:center;padding:40px 24px;color:var(--text-muted);font-size:13px;"><i class="bi bi-plug" style="font-size:32px;display:block;margin-bottom:10px;opacity:.35;"></i><div style="font-weight:700;margin-bottom:4px;">Integración no disponible</div><div style="font-size:11px;opacity:.7;">El módulo de cola de impresión no está configurado para este cliente.</div></div>';
    return;
  }
  el.innerHTML = '<div style="text-align:center;padding:28px;color:var(--text-muted);font-size:13px;"><i class="bi bi-hourglass-split"></i> Cargando impresiones…</div>';
  const email = localStorage.getItem('portal_user_email') || _cbPrivEmail || '';
  if(!email){
    el.innerHTML = '<div style="text-align:center;padding:32px;color:var(--text-muted);font-size:13px;"><i class="bi bi-person-x" style="font-size:24px;display:block;margin-bottom:8px;opacity:.4;"></i>Identifícate para ver tus impresiones.</div>';
    return;
  }
  try {
    const r = await fetch(`/api/print-queue/data?reporter=${encodeURIComponent(email)}&tab=all&page=1&limit=50&sort=queued_at&dir=desc`, {credentials:'include'});
    const d = await r.json();
    const items = d.data || [];
    const badge = document.getElementById('mtktBadge-imp');
