      +'</div>'
    :'';
  /* helpers */
  const cell=(lbl,val,nd)=>'<div class="meq-data-cell"><div class="meq-data-lbl">'+lbl+'</div><div class="meq-data-val'+(nd?' meq-val-nd':'')+'">'+val+'</div></div>';
