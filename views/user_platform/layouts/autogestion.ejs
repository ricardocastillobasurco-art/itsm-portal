<script>
(function(){

/* ── Theme ── */
function _syncIcon(t){
  const ico=document.getElementById('themeIco');
  if(ico)ico.className=t==='dark'?'bi bi-sun-fill':'bi bi-moon-stars-fill';
}
_syncIcon(document.documentElement.getAttribute('data-theme')||'light');
document.addEventListener('themeChanged',e=>_syncIcon(e.detail||'light'));
window.toggleTheme=function(){
  const n=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark';
  document.documentElement.setAttribute('data-theme',n);
  localStorage.setItem('dashboardTheme',n);
  _syncIcon(n);
  document.dispatchEvent(new CustomEvent('themeChanged',{detail:n}));
  const frame=document.getElementById('pfModalFrame');
  if(frame&&frame.src)try{frame.contentWindow.postMessage({type:'theme',theme:n},'*');}catch(e){}
};

/* ── Sidebar toggle ── */
const sidebar=document.getElementById('sidebar');
const overlay=document.getElementById('sbOverlay');
let _sbCollapsed=localStorage.getItem('sb_collapsed')==='1';
if(_sbCollapsed) sidebar.classList.add('collapsed');

window.toggleSidebar=function(){
  if(window.innerWidth<=768){
    const opening=!sidebar.classList.contains('mobile-open');
    sidebar.classList.toggle('mobile-open',opening);
    overlay.classList.toggle('show',opening);
    document.body.style.overflow=opening?'hidden':'';
  } else {
    _sbCollapsed=!_sbCollapsed;
    sidebar.classList.toggle('collapsed',_sbCollapsed);
    localStorage.setItem('sb_collapsed',_sbCollapsed?'1':'0');
  }
};
window.closeSidebarMobile=function(){
  sidebar.classList.remove('mobile-open');
  overlay.classList.remove('show');
  document.body.style.overflow='';
};

/* Cerrar sidebar al rotar o redimensionar a desktop */
window.addEventListener('resize',function(){
  if(window.innerWidth>768){
    sidebar.classList.remove('mobile-open');
    overlay.classList.remove('show');
    document.body.style.overflow='';
  }
});

/* ── User menu dropdown ── */
window.toggleUserMenu = function(e) {
  e.stopPropagation();
  const dd   = document.getElementById('navUserDd');
  const chev = document.getElementById('navUserChev');
  const open = dd.classList.toggle('open');
  chev.style.transform = open ? 'rotate(180deg)' : '';
};
document.addEventListener('click', function() {
  const dd = document.getElementById('navUserDd');
  if (dd && dd.classList.contains('open')) {
    dd.classList.remove('open');
    const chev = document.getElementById('navUserChev');
    if (chev) chev.style.transform = '';
  }
});

/* ── Helpers ── */
function _allViews(){
  return ['portalCards','impresionView','herramientasView','kbView','faqView','miEquipoView','seguridadView']
    .map(id=>document.getElementById(id)).filter(Boolean);
}
function _showOnly(id){
  _allViews().forEach(el=>el.style.display = el.id===id ? '' : 'none');
}

/* ── Page titles map ── */
const _titles={
  equipo:     {title:'',                      sub:''},
  seguridad:  {title:'',                    sub:''},
  inicio:     {title:'',                    sub:''},
  incidencias:{title:'Incidencias',         sub:'Reporta fallas o interrupciones TI'},
  requerimientos:{title:'Requerimientos',   sub:'Solicita servicios, accesos o equipos'},
  tickets:    {title:'Mis Tickets',         sub:'Estado y seguimiento de tus solicitudes'},
  impresion:  {title:'Cola de Impresión',   sub:'Gestión de trabajos de impresión'},
  herramientas:{title:'Herramientas TI',    sub:'Notas, proyectos, Gantt y más'},
  software:   {title:'Instalación de Software',sub:'Catálogo y solicitudes de software'},
  kb:         {title:'Base de Conocimiento',sub:'Artículos, guías y soluciones'},
  faq:        {title:'Preguntas Frecuentes',sub:'Respuestas a las consultas más comunes'},
  anuncios:   {title:'Anuncios',            sub:'Comunicados y novedades corporativas'},
  wsp:        {title:'WhatsApp Bot',        sub:'Gestiona tickets desde WhatsApp'},
  devoluciones:{title:'Devoluciones',       sub:'Retorno de equipos y activos TI'},
  garantias:  {title:'Garantías',           sub:'Cobertura y soporte de equipos'},
  encuesta:   {title:'Encuesta de Satisfacción',sub:'Comparte tu experiencia con TI'},
  reco:       {title:'Enviar Recomendación',sub:'Sugiere mejoras al equipo TI'},
  marquee:    {title:'Publicar Marquesina', sub:'Gestiona los avisos del banner'},
  'pub-anuncio':{title:'Publicar Anuncio',  sub:'Crea comunicados corporativos'},
  consultas:  {title:'Mis Consultas',       sub:'Historial de conversaciones con especialistas TI'},
};

/* ── Sidebar navigation ── */
function _setHeader(title,sub){
  const chT=document.getElementById('chTitle');
  const chS=document.getElementById('chSub');
  const hdr=document.getElementById('mainContentHeader');
  if(chT) chT.textContent=title||'';
  if(chS) chS.textContent=sub||'';
  if(hdr) hdr.style.display=title?'':'none';
}
function _setActiveSb(el){
  document.querySelectorAll('.sb-item').forEach(i=>i.classList.remove('active'));
  if(el) el.classList.add('active');
}

window.sbNav=function(key,el){
  _setActiveSb(el);
  const t=_titles[key]||{title:key,sub:''};
  _setHeader(t.title,t.sub);
  if(window.innerWidth<=768) closeSidebarMobile();

  // Views that show inline
  if(key==='inicio'){
    _showOnly('portalCards');
    const _wbI=document.getElementById('catWelcome');
    const _atI=document.getElementById('annText');
    const _abI=document.getElementById('annBar');
    if(_wbI) _wbI.style.display='flex';
    if(_abI&&_atI&&_atI.textContent.trim()) _abI.style.display='flex';
    return;
  }
  if(key==='impresion'){
    _showOnly('impresionView');
    const frame=document.getElementById('impresionFrame');
    if(frame&&!frame.getAttribute('data-loaded')){
      const email=localStorage.getItem('portal_user_email')||'';
      const theme=localStorage.getItem('dashboardTheme')||'light';
      frame.src='/print-queue'+(email?'?reporter='+encodeURIComponent(email)+'&theme='+theme:'?theme='+theme);
      frame.setAttribute('data-loaded','1');
    }
    return;
  }
  if(key==='kb'){
    _showOnly('kbView');
    const frame=document.getElementById('kbFrame');
    if(frame&&!frame.getAttribute('data-loaded')){
      const theme=localStorage.getItem('dashboardTheme')||'light';
      frame.src='/knowledge-base?theme='+theme;
      frame.setAttribute('data-loaded','1');
    }
    return;
  }
  if(key==='faq'){
    _showOnly('faqView');
    const frame=document.getElementById('faqFrame');
    if(frame&&!frame.getAttribute('data-loaded')){
      const theme=localStorage.getItem('dashboardTheme')||'light';
      frame.src='/preguntas-frecuentes?theme='+theme;
      frame.setAttribute('data-loaded','1');
    }
    return;
  }
  if(key==='consultas'){
    _setActiveSb(document.getElementById('sb-inicio'));
    _setHeader('','');
    _showOnly('portalCards');
    openConsultasModal();
    return;
  }
  if(key==='equipo'){
    _showOnly('miEquipoView');
    const _wbE=document.getElementById('catWelcome');
    const _abE=document.getElementById('annBar');
    if(_wbE) _wbE.style.display='none';
    if(_abE) _abE.style.display='none';
    _loadEquipo();
    return;
  }
  if(key==='seguridad'){
    _showOnly('seguridadView');
    const _wbS=document.getElementById('catWelcome');
    const _abS=document.getElementById('annBar');
    if(_wbS) _wbS.style.display='none';
    if(_abS) _abS.style.display='none';
    return;
  }

  // Modal-based actions — resetear active a inicio
  const modals={
    incidencias:   ()=>openPageModal('/incidencias?embed=1'),
    requerimientos:()=>openPageModal('/requerimientos?embed=1',{wide:true}),
    tickets:       ()=>openMisTicketsModal(),
    software:      ()=>openSoftwareCatalog(),
    anuncios:      ()=>openAnunciosModal(),
    wsp:           ()=>openWspModal(),
    devoluciones:  ()=>openDevolucionModal(),
    garantias:     ()=>openGarantiasModal(),
    encuesta:      ()=>openSurveyModal(),
    reco:          ()=>openRecoModal(),
    marquee:       ()=>openMarqueeAdmin(),
    'pub-anuncio': ()=>openAnuncioModal(),
  };
  if(modals[key]){
    _setActiveSb(document.getElementById('sb-inicio'));
    _setHeader(_titles.inicio.title,_titles.inicio.sub);
    _showOnly('portalCards');
    modals[key]();
  }
};

/* ── Herramientas expand/collapse ── */
window.sbExpandHer=function(el){
  const menu=document.getElementById('sbHerMenu');
  const isOpen=menu.classList.contains('open');
  menu.classList.toggle('open');
  el.classList.toggle('sb-expanded');
  if(!isOpen){
    // Al abrir: activar el sub-item que esté activo o Reportes por defecto
    const activeSub=menu.querySelector('.sb-sub-item.active');
    if(activeSub){
      _showOnly('herramientasView');
    } else {
      sbNavTool(8,'Reportes',menu.querySelector('.sb-sub-item'));
    }
  }
};

/* ── Navegar a herramienta específica ── */
window.sbNavTool=function(tab,toolName,el){
  document.querySelectorAll('.sb-sub-item').forEach(i=>i.classList.remove('active'));
  if(el) el.classList.add('active');
  // Marcar el padre activo
  _setActiveSb(document.getElementById('sb-herramientas'));
  _setHeader('Herramientas TI — '+toolName,'Herramientas de productividad');
  if(window.innerWidth<=768) closeSidebarMobile();

  _showOnly('herramientasView');
  const frame=document.getElementById('herramientasFrame');
  if(!frame) return;
  if(!frame.getAttribute('data-loaded')){
    const email=localStorage.getItem('portal_user_email')||'';
    const name =localStorage.getItem('portal_user_name')||'';
    const theme=localStorage.getItem('dashboardTheme')||'light';
    frame.src='/herramientas?reporter='+encodeURIComponent(email)+'&name='+encodeURIComponent(name)+'&theme='+theme+'&tab='+tab+'&embed=1';
    frame.setAttribute('data-loaded','1');
  } else {
    try{ frame.contentWindow.postMessage({type:'switchTab',tab:tab},'*'); }catch(e){}
  }
};

/* ── Search (filters cards on inicio) ── */
window._filterCards=function(q){
  const t=q.toLowerCase().trim();
  if(t){
    _showOnly('portalCards');
    _setActiveSb(document.getElementById('sb-inicio'));
    _setHeader(_titles.inicio.title,_titles.inicio.sub);
  }
  document.querySelectorAll('[data-tags]').forEach(el=>{
    const match=!t||(el.dataset.tags||'').toLowerCase().includes(t)||(el.querySelector('[class*="title"]')?.textContent||'').toLowerCase().includes(t);
    el.setAttribute('data-hidden',match?'false':'true');
  });
};

/* ── Auto-identify JWT users ── */
<% if (_email) { %>
(function(){
  const _jwtEmail='<%= _email %>';
  const _jwtName='<%= (_user?.full_name||_user?.nombre||_email).replace(/'/g,"\\'") %>';
  const _overrideEmail=localStorage.getItem('portal_override_email');
  const _overrideName=localStorage.getItem('portal_override_name');
  // Si el override email coincide con el JWT del admin actual, descartarlo (sesión anterior sin limpiar)
  const _sameAsJwt=_overrideEmail&&_overrideEmail.toLowerCase()===_jwtEmail.toLowerCase();
  const activeEmail=(_overrideEmail&&!_sameAsJwt)?_overrideEmail:_jwtEmail;
  const _resolvedName=(_overrideEmail&&!_sameAsJwt)?(_overrideName||_overrideEmail):_jwtName;
  // Si el nombre guardado es un email (contiene @), usar el JWT name como fallback
  const activeName=(_resolvedName&&_resolvedName.includes('@'))?_jwtName:_resolvedName;
  localStorage.setItem('portal_user_email',activeEmail);
  localStorage.setItem('portal_user_name',activeName);
  // Limpiar override si era mismo email o si el nombre era inválido
  if(_sameAsJwt||(_overrideName&&_overrideName.includes('@'))){
    localStorage.removeItem('portal_override_email');
    localStorage.removeItem('portal_override_name');
  }
  const iw=document.getElementById('identifyWrap');
  const ib=document.getElementById('identifyBox');
  const wb=document.getElementById('catWelcome');
  const nm=document.getElementById('catWelcomeName');
  const sb2=document.getElementById('catWelcomeSub');
  const _rawName=activeName.split(' ')[0]||'Usuario';
  const _dispName=_rawName.charAt(0).toUpperCase()+_rawName.slice(1).toLowerCase();
  if(nm) nm.innerHTML=`Hola, <span class="hero-title-name">${_dispName}</span>`;
  if(sb2) sb2.textContent='Bienvenido a tu portal de autogestión.';
  if(ib) ib.style.display='none';
  if(iw) iw.style.display='none';
  if(wb) wb.style.display='flex';
  if(_overrideEmail){
    const _ini=activeName.split(' ').slice(0,2).map(function(w){return w[0]||'';}).join('').toUpperCase()||'U';
    const _fn=activeName.split(' ')[0]||activeName;
    const _el=function(id){return document.getElementById(id);};
    if(_el('navAvatar')) _el('navAvatar').textContent=_ini;
    if(_el('navUsername')) _el('navUsername').textContent=_fn;
    if(_el('nuAvLg')) _el('nuAvLg').textContent=_ini;
    if(_el('nuName')) _el('nuName').textContent=activeName;
    if(_el('nuRole')) _el('nuRole').textContent='Usuario externo';
    if(_el('nuEmailVal')) _el('nuEmailVal').textContent=activeEmail;
  }
})();
<% } %>

window.volverIdentificarse=function(){
  localStorage.removeItem('portal_user_email');
  localStorage.removeItem('portal_user_name');
  localStorage.removeItem('portal_override_email');
  localStorage.removeItem('portal_override_name');
  const wb=document.getElementById('catWelcome');
  if(wb) wb.style.display='none';
  const ib=document.getElementById('identifyBox');
  if(ib) ib.style.display='';
  const iw=document.getElementById('identifyWrap');
  if(iw) iw.style.display='';
  const em=document.getElementById('identEmail');
  if(em){em.value='';setTimeout(()=>em.focus(),50);}
  const st=document.getElementById('identStatus');
  if(st) st.style.display='none';
};

/* ── Activity strip ── */
async function _loadActivity(){
  try{
    const email=localStorage.getItem('portal_user_email')||(typeof _cbPrivEmail!=='undefined'?_cbPrivEmail:'')||'';
    if(!email) return;
    const j=await fetch('/api/jira/my-tickets?reporter='+encodeURIComponent(email)+'&days=30',{credentials:'include'}).then(r=>r.json());
    const list=j.data||j.tickets||[];
    _loadHomeStats(list);
    const total=j.total||list.length;
    if(!total) return;

    const sb=document.getElementById('sbTicketBadge');
    if(sb){sb.textContent=total;sb.classList.add('show');}

    const qc=document.getElementById('qaTicketCount');
    const qn=document.getElementById('qaTicketNum');
    if(qc&&qn){qn.textContent=total;qc.style.display='';}

    const c=document.getElementById('actInner');
    const dot=s=>`<span class="act-kpi-dot" style="background:${s};"></span>`;
    let h=`<div class="act-kpi">${dot('#f59e0b')}<span class="act-kpi-val">${total}</span><span class="act-kpi-lbl">&nbsp;ticket${total!==1?'s':''} activo${total!==1?'s':''}</span></div>`;
    list.slice(0,3).forEach(t=>{
      const st2=t.status||t.jiraStatus||'';
      const clr=t.priority==='P1'||t.priority==='critica'?'#ef4444':t.priority==='P2'||t.priority==='alta'?'#f97316':st2.toLowerCase().includes('resuelto')||st2.toLowerCase().includes('closed')?'#10b981':'#f59e0b';
      const key=t.key||t.id||'';
      const title=(t.summary||t.titulo||t.title||'').substring(0,40);
      h+=`<div class="act-ticket" onclick="typeof openMisTicketsModal==='function'&&openMisTicketsModal()">
        ${dot(clr)}<span class="act-ticket-key">${key}</span>
        <span style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${title}</span>
      </div>`;
    });
    h+=`<span class="act-see-all" onclick="openMisTicketsModal&&openMisTicketsModal()">Ver todos <i class="bi bi-arrow-right" style="font-size:10px;"></i></span>`;
    c.innerHTML=h;
    document.getElementById('actStrip').style.display='';
  }catch(e){}
}

/* ── Announcements ── */
async function _loadAnn(){
  try{
    const j=await fetch('/api/portal/announcements?limit=6',{credentials:'include'}).then(r=>r.json());
    const list=j.data||[];
    if(!list.length) return;
    document.getElementById('annText').textContent=list.map(a=>a.title||a.text||'').join('   ·   ');
    document.getElementById('annBar').style.display='flex';
  }catch(e){}
}

/* ── Toast ── */
window._toast=function(msg,type='inf'){
  if(typeof showToast==='function'){showToast(msg,type);return;}
  const w=document.getElementById('toastWrap');
  const ic={ok:'check-circle-fill',err:'x-circle-fill',inf:'info-circle-fill'};
  const cl={ok:'var(--success)',err:'var(--danger)',inf:'var(--info)'};
  const d=document.createElement('div');
  d.className=`toast-item ti-${type}`;
  d.innerHTML=`<i class="bi bi-${ic[type]}" style="color:${cl[type]};font-size:18px;flex-shrink:0;"></i><span>${msg}</span>`;
  w.appendChild(d);
  setTimeout(()=>{d.style.cssText='opacity:0;transform:translateX(18px);transition:.3s;';setTimeout(()=>d.remove(),300);},4500);
};

