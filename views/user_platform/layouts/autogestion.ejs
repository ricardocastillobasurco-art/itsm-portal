.dev-htitle{font-size:20px;font-weight:900;color:#fff;margin-bottom:3px;}
.dev-hsub{font-size:11px;color:rgba(255,255,255,.8);margin-bottom:16px;}
.dev-steps-bar{display:flex;align-items:flex-start;padding-bottom:18px;}
