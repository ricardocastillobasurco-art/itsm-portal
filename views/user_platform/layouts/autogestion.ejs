.dev-summary-label{color:var(--muted);font-weight:600;}
.dev-summary-val{color:var(--text);font-weight:700;text-align:right;max-width:65%;}
.dev-wrong-check{background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:12px 14px;display:flex;align-items:flex-start;gap:10px;margin-top:14px;}

