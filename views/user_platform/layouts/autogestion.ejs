<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <script>(function(){const t=localStorage.getItem('dashboardTheme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal TI · Autogestión</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;0,9..40,800;0,9..40,900&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<style>
/* ══════════════════════════════════════════════════════════════
   VARIABLES
══════════════════════════════════════════════════════════════ */
:root,[data-theme="light"]{
  --bg:#f1f5f9;
  --bg-subtle:#e9eef5;
  --card:#ffffff;
  --card-hover:#fafcff;
  --border:#e2e8f0;
  --border-strong:#cbd5e1;
  --text:#0f172a;
  --text-2:#1e293b;
  --muted:#64748b;
  --muted-2:#94a3b8;
  --primary:#2563eb;
  --primary-dim:rgba(37,99,235,.1);
  --primary-glow:rgba(37,99,235,.25);
  --success:#059669;
  --warning:#d97706;
  --danger:#dc2626;
  --purple:#7c3aed;
  --info:#0891b2;
  --sh-xs:0 1px 2px rgba(0,0,0,.06);
  --sh-sm:0 1px 3px rgba(0,0,0,.08),0 4px 12px rgba(0,0,0,.04);
  --sh-md:0 4px 16px rgba(0,0,0,.1),0 16px 40px rgba(0,0,0,.07);
  --sh-lg:0 8px 30px rgba(0,0,0,.12),0 30px 60px rgba(0,0,0,.1);
  --nav-bg:rgba(255,255,255,.95);
  --radius-sm:8px;
  --radius:12px;
  --radius-lg:16px;
  --radius-xl:20px;
  --sidebar-w:220px;
  --navbar-h:44px;
  --bg-main:var(--bg);--bg-card:var(--card);--bg-surface:var(--card);
  --border-soft:var(--border);--text-main:var(--text);--text-muted:var(--muted);
  --shadow-card:var(--sh-sm);--shadow-hover:var(--sh-lg);
  --tab-active:var(--card);--tab-inactive:rgba(0,0,0,.04);
  --sidebar-bg:var(--card);--toggle-bg:var(--border);--toggle-icon:var(--muted);
}
[data-theme="dark"]{
  --bg:#080d1c;
  --bg-subtle:#0d1425;
  --card:#111827;
  --card-hover:#141d2f;
  --border:#1e293b;
  --border-strong:#2d3f55;
  --text:#f1f5f9;
  --text-2:#e2e8f0;
  --muted:#94a3b8;
  --muted-2:#64748b;
  --primary:#3b82f6;
  --primary-dim:rgba(59,130,246,.14);
  --primary-glow:rgba(59,130,246,.2);
  --success:#10b981;
  --warning:#f59e0b;
  --danger:#ef4444;
  --purple:#8b5cf6;
  --info:#06b6d4;
  --sh-xs:0 1px 2px rgba(0,0,0,.4);
  --sh-sm:0 1px 3px rgba(0,0,0,.4),0 4px 12px rgba(0,0,0,.3);
  --sh-md:0 4px 16px rgba(0,0,0,.4),0 16px 40px rgba(0,0,0,.3);
  --sh-lg:0 8px 30px rgba(0,0,0,.5),0 30px 60px rgba(0,0,0,.4);
  --nav-bg:rgba(8,13,28,.95);
  --bg-main:var(--bg);--bg-card:var(--card);--bg-surface:var(--card);
  --border-soft:var(--border);--text-main:var(--text);--text-muted:var(--muted);
  --shadow-card:var(--sh-sm);--shadow-hover:var(--sh-lg);
  --tab-active:var(--card);--tab-inactive:rgba(255,255,255,.04);
  --sidebar-bg:var(--bg-subtle);--toggle-bg:var(--primary);--toggle-icon:#fff;
}

/* ══════════════════════════════════════════════════════════════
   RESET
══════════════════════════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;overflow:hidden;}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',-apple-system,'Segoe UI',sans-serif;font-size:14px;line-height:1.6;-webkit-font-smoothing:antialiased;}
a{text-decoration:none;color:inherit;}
button{font-family:inherit;cursor:pointer;border:none;background:none;}
img{max-width:100%;height:auto;}
*::-webkit-scrollbar{width:5px;height:5px;}
*::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:3px;}
*::-webkit-scrollbar-track{background:transparent;}

/* ══════════════════════════════════════════════════════════════
   NAVBAR — barra superior delgada
══════════════════════════════════════════════════════════════ */
.navbar{
  position:fixed;top:0;left:0;right:0;z-index:500;
  height:var(--navbar-h);display:flex;align-items:center;gap:6px;padding:0 16px;
  background:var(--nav-bg);
  backdrop-filter:blur(16px) saturate(160%);
  -webkit-backdrop-filter:blur(16px) saturate(160%);
  border-bottom:1px solid var(--border);
}
.nav-hamburger{
  width:30px;height:30px;border-radius:6px;display:flex;align-items:center;justify-content:center;
  font-size:16px;color:var(--muted);transition:all .15s;cursor:pointer;flex-shrink:0;
}
.nav-hamburger:hover{background:var(--bg-subtle);color:var(--text);}
.nav-brand{display:flex;align-items:center;gap:7px;padding:0 8px;}
.nav-logo{height:18px;width:auto;}
.nav-divider{width:1px;height:16px;background:var(--border);}
.nav-name{font-size:12px;font-weight:700;color:var(--text);}
.nav-badge{font-size:8px;font-weight:800;padding:1px 6px;border-radius:20px;background:linear-gradient(135deg,var(--primary),var(--purple));color:#fff;letter-spacing:.5px;text-transform:uppercase;}
.nav-space{flex:1;}
.nav-search{
  position:relative;flex:1;max-width:320px;
}
.nav-search-icon{position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--muted);pointer-events:none;}
.nav-search-input{
  width:100%;padding:6px 10px 6px 32px;
  border:1px solid var(--border);border-radius:var(--radius-sm);
  background:var(--bg-subtle);color:var(--text);
  font-size:13px;font-family:inherit;outline:none;
  transition:all .2s;
}
.nav-search-input:focus{border-color:var(--primary);background:var(--card);}
.nav-sep{width:1px;height:16px;background:var(--border);margin:0 2px;}
.nav-icon-btn{width:30px;height:30px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--muted);transition:all .15s;}
.nav-icon-btn:hover{background:var(--bg-subtle);color:var(--text);}
.nav-user{display:flex;align-items:center;gap:6px;padding:3px 10px 3px 4px;border-radius:20px;background:var(--bg-subtle);border:1px solid var(--border);cursor:pointer;position:relative;transition:border-color .15s;}
.nav-user:hover{border-color:var(--primary);}
.nav-avatar{width:28px;height:28px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,var(--primary),var(--purple));display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:800;letter-spacing:.5px;box-shadow:0 2px 6px rgba(99,102,241,.35);}
.nav-username{font-size:11px;font-weight:600;color:var(--text-2);max-width:90px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
/* ── User dropdown ── */
.nav-user-dd{display:none;position:absolute;top:calc(100% + 8px);right:0;width:260px;background:var(--card);border:1px solid var(--border);border-radius:14px;box-shadow:0 8px 32px rgba(0,0,0,.16);z-index:600;overflow:hidden;}
.nav-user-dd.open{display:block;}
.nu-header{padding:18px 18px 14px;background:linear-gradient(135deg,var(--primary),var(--purple));position:relative;}
.nu-av-lg{width:48px;height:48px;border-radius:50%;background:rgba(255,255,255,.25);display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px;font-weight:800;letter-spacing:1px;margin-bottom:10px;border:2px solid rgba(255,255,255,.4);}
.nu-name{font-size:14px;font-weight:800;color:#fff;line-height:1.2;}
.nu-role{font-size:10px;font-weight:600;color:rgba(255,255,255,.75);margin-top:2px;text-transform:uppercase;letter-spacing:.5px;}
.nu-body{padding:12px 18px;}
.nu-row{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--border);font-size:12px;}
.nu-row:last-child{border-bottom:none;}
.nu-row-icon{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0;}
.nu-row-label{font-size:10px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.4px;}
.nu-row-val{font-size:12px;color:var(--text);font-weight:600;margin-top:1px;word-break:break-all;}
.nu-footer{padding:10px 14px;border-top:1px solid var(--border);display:flex;gap:8px;}
.nu-btn{flex:1;padding:7px;border-radius:8px;border:1px solid var(--border);background:var(--bg-subtle);font-size:12px;font-weight:600;color:var(--muted);cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;transition:all .15s;}
.nu-btn:hover{color:var(--text);border-color:var(--border-strong);}
.nu-btn-danger{color:var(--danger)!important;border-color:rgba(220,38,38,.2)!important;background:rgba(220,38,38,.04)!important;}
.nu-btn-danger:hover{background:rgba(220,38,38,.1)!important;}
.nav-exit{display:flex;align-items:center;gap:4px;padding:5px 10px;border-radius:5px;font-size:11px;font-weight:600;color:var(--muted);transition:all .15s;}
.nav-exit:hover{color:var(--danger);background:rgba(220,38,38,.06);}

/* ══════════════════════════════════════════════════════════════
   APP SHELL — sidebar + content
══════════════════════════════════════════════════════════════ */
.app-shell{
  display:flex;
  position:fixed;top:var(--navbar-h);left:0;right:0;bottom:0;
  overflow:hidden;
}

/* ══════════════════════════════════════════════════════════════
   SIDEBAR
══════════════════════════════════════════════════════════════ */
.sidebar{
  width:var(--sidebar-w);flex-shrink:0;
  background:var(--card);border-right:1px solid var(--border);
  display:flex;flex-direction:column;
  overflow:hidden;
  transition:width .22s cubic-bezier(.4,0,.2,1);
  position:relative;z-index:200;
}
.sidebar.collapsed{width:52px;}

.sb-header{
  display:flex;align-items:center;gap:8px;
  padding:0 12px;height:46px;
  border-bottom:1px solid var(--border);flex-shrink:0;
  overflow:hidden;
}
.sb-logo{height:16px;width:auto;flex-shrink:0;}
.sb-brand{flex:1;min-width:0;overflow:hidden;}
.sb-brand-name{font-size:12px;font-weight:700;color:var(--text);white-space:nowrap;}
.sb-brand-sub{font-size:9px;font-weight:700;color:var(--primary);text-transform:uppercase;letter-spacing:.4px;}
.sidebar.collapsed .sb-brand{display:none;}

.sb-nav{flex:1;overflow-y:auto;overflow-x:hidden;padding:6px 0;}
.sb-nav::-webkit-scrollbar{width:3px;}

.sb-section{margin-bottom:2px;}
.sb-section-label{
  font-size:9px;font-weight:800;letter-spacing:1.1px;text-transform:uppercase;
  color:var(--muted-2);padding:10px 14px 3px;white-space:nowrap;
  overflow:hidden;display:block;
}
.sidebar.collapsed .sb-section-label{display:none;}

.sb-item{
  display:flex;align-items:center;gap:10px;
  padding:7px 14px;cursor:pointer;
  font-size:12.5px;font-weight:500;color:var(--muted);
  transition:all .15s;white-space:nowrap;overflow:hidden;
  border:none;background:none;width:100%;text-align:left;
  position:relative;
}
.sb-item:hover{background:var(--bg-subtle);color:var(--text);}
.sb-item.active{background:var(--primary-dim);color:var(--primary);font-weight:700;}
.sb-item.active::before{
  content:'';position:absolute;left:0;top:0;bottom:0;
  width:3px;background:var(--primary);border-radius:0 2px 2px 0;
}
.sb-icon{font-size:15px;flex-shrink:0;width:18px;text-align:center;}
.sb-label{flex:1;overflow:hidden;text-overflow:ellipsis;}
.sb-badge{
  font-size:9px;font-weight:800;padding:1px 6px;
  border-radius:10px;background:var(--primary);color:#fff;
  flex-shrink:0;display:none;
}
.sb-badge.show{display:inline;}
.sidebar.collapsed .sb-badge{display:none!important;}
.sidebar.collapsed .sb-item{justify-content:center;padding:9px 0;}
.sidebar.collapsed .sb-label{display:none;}
.sidebar.collapsed .sb-icon{font-size:17px;width:auto;}

.sb-divider{height:1px;background:var(--border);margin:6px 14px;}
.sidebar.collapsed .sb-divider{margin:6px 8px;}

/* sub-menú colapsable */
.sb-sub-menu{overflow:hidden;max-height:0;transition:max-height .25s cubic-bezier(.4,0,.2,1);}
.sb-sub-menu.open{max-height:600px;}
.sidebar.collapsed .sb-sub-menu{display:none;}
.sb-sub-item{
  display:flex;align-items:center;gap:8px;
  padding:6px 14px 6px 38px;
  font-size:12px;font-weight:500;color:var(--muted);
  cursor:pointer;border:none;background:none;width:100%;text-align:left;
  transition:all .14s;white-space:nowrap;overflow:hidden;
}
.sb-sub-item:hover{background:var(--bg-subtle);color:var(--text);}
.sb-sub-item.active{color:var(--primary);font-weight:700;background:var(--primary-dim);}
.sb-sub-icon{font-size:13px;flex-shrink:0;width:16px;text-align:center;}
.sb-expand-icon{margin-left:auto;font-size:10px;transition:transform .22s;flex-shrink:0;color:var(--muted-2);}
.sb-item.sb-expanded .sb-expand-icon{transform:rotate(180deg);}
.sb-badge-new{font-size:8px;font-weight:800;padding:1px 5px;border-radius:4px;background:#059669;color:#fff;flex-shrink:0;}

.sb-footer{
  border-top:1px solid var(--border);
  padding:10px 12px;flex-shrink:0;
  display:flex;align-items:center;gap:8px;
  overflow:hidden;
}
.sb-user-av{
  width:28px;height:28px;border-radius:50%;flex-shrink:0;
  background:linear-gradient(135deg,var(--primary),var(--purple));
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:11px;font-weight:800;
}
.sb-user-info{flex:1;min-width:0;overflow:hidden;}
.sb-user-name{font-size:11px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.sb-user-role{font-size:10px;color:var(--muted);}
.sidebar.collapsed .sb-user-info{display:none;}
.sidebar.collapsed .sb-footer{justify-content:center;padding:10px 0;}
.sb-theme-btn{
  width:26px;height:26px;border-radius:5px;
  display:flex;align-items:center;justify-content:center;
  font-size:13px;color:var(--muted);transition:all .15s;
  flex-shrink:0;
}
.sb-theme-btn:hover{background:var(--bg-subtle);color:var(--text);}
.sidebar.collapsed .sb-theme-btn{display:none;}

/* ══════════════════════════════════════════════════════════════
   CONTENT AREA
══════════════════════════════════════════════════════════════ */
.content-area{
  flex:1;overflow-y:auto;overflow-x:hidden;
  display:flex;flex-direction:column;
  background:var(--bg);
  min-width:0;
}

.content-header{
  background:var(--card);border-bottom:1px solid var(--border);
  padding:12px 24px;
  display:flex;align-items:center;gap:14px;
  flex-shrink:0;position:sticky;top:0;z-index:100;
}
.ch-info{display:flex;flex-direction:column;gap:1px;}
.ch-title{font-size:14px;font-weight:800;color:var(--text);white-space:nowrap;}
.ch-sub{font-size:11px;color:var(--muted);}
.ch-actions{display:flex;align-items:center;gap:8px;margin-left:auto;}

.content-body{padding:24px;flex:1;}

/* ══════════════════════════════════════════════════════════════
   ACTIVITY STRIP
══════════════════════════════════════════════════════════════ */
.act-strip{
  background:var(--card);border-bottom:1px solid var(--border);
  overflow:hidden;display:none;flex-shrink:0;
}
.act-inner{
  display:flex;align-items:center;gap:0;
  height:38px;padding:0 24px;overflow-x:auto;scrollbar-width:none;
}
.act-inner::-webkit-scrollbar{display:none;}
.act-kpi{display:flex;align-items:center;gap:7px;padding:0 16px 0 0;margin-right:16px;border-right:1px solid var(--border);white-space:nowrap;flex-shrink:0;}
.act-kpi:last-of-type{border-right:none;}
.act-kpi-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.act-kpi-val{font-size:13px;font-weight:800;color:var(--text);}
.act-kpi-lbl{font-size:11px;color:var(--muted);}
.act-ticket{display:flex;align-items:center;gap:6px;padding:3px 10px;border-radius:20px;border:1px solid var(--border);font-size:11px;font-weight:600;color:var(--muted);background:var(--bg-subtle);white-space:nowrap;cursor:pointer;margin-right:6px;flex-shrink:0;transition:all .15s;}
.act-ticket:hover{border-color:var(--primary);color:var(--primary);}
.act-ticket-key{font-weight:800;color:var(--primary);font-size:11px;}
.act-see-all{margin-left:auto;flex-shrink:0;display:flex;align-items:center;gap:4px;font-size:11px;font-weight:700;color:var(--primary);white-space:nowrap;cursor:pointer;padding:4px 0;transition:gap .18s;}
.act-see-all:hover{gap:7px;}

/* ══════════════════════════════════════════════════════════════
   WELCOME + IDENTIFY
══════════════════════════════════════════════════════════════ */
.identify-box{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);padding:20px 24px;box-shadow:var(--sh-sm);margin-bottom:20px;}
.identify-title{font-size:14px;font-weight:700;color:var(--text);margin-bottom:3px;}
.identify-sub{font-size:12px;color:var(--muted);margin-bottom:12px;line-height:1.5;}
.id-input-row{display:flex;gap:10px;align-items:flex-start;position:relative;}
.id-ac-wrap{flex:1;position:relative;}
.id-field{width:100%;border:1.5px solid var(--border);border-radius:var(--radius);padding:10px 14px;font-size:13px;background:var(--card);color:var(--text);outline:none;transition:border-color .2s;font-family:inherit;box-sizing:border-box;}
.id-field:focus{border-color:var(--primary);}
.id-btn{padding:10px 20px;background:var(--primary);color:#fff;border:none;border-radius:var(--radius);font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;transition:all .2s;flex-shrink:0;}
.id-btn:hover{opacity:.88;}.id-btn:disabled{opacity:.5;cursor:not-allowed;}
.ac-drop{position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--sh-md);z-index:100;overflow:hidden;display:none;}
.ac-item{padding:10px 14px;cursor:pointer;font-size:13px;color:var(--text);display:flex;flex-direction:column;gap:2px;transition:background .15s;}
.ac-item:hover,.ac-item.active{background:var(--bg-subtle);}
.ac-item small{color:var(--muted);font-size:11px;}
.id-status{margin-top:10px;padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;display:none;}
.id-status.ok{background:rgba(5,150,105,.1);color:var(--success);border:1px solid rgba(5,150,105,.25);}
.id-status.err{background:rgba(220,38,38,.1);color:var(--danger);border:1px solid rgba(220,38,38,.25);}
.id-status.info{background:var(--primary-dim);color:var(--primary);border:1px solid var(--primary-glow);}

.cat-welcome-bar{background:linear-gradient(135deg,var(--primary) 0%,var(--info) 100%);border-radius:var(--radius-lg);padding:12px 18px;margin-bottom:18px;display:flex;align-items:center;gap:14px;position:relative;overflow:hidden;}
.cat-welcome-bar::before{content:'';position:absolute;right:-40px;top:-40px;width:160px;height:160px;border-radius:50%;background:rgba(255,255,255,.08);pointer-events:none;}
.cat-welcome-bar .cwb-avatar{width:36px;height:36px;border-radius:var(--radius-sm);background:rgba(255,255,255,.2);border:2px solid rgba(255,255,255,.35);display:flex;align-items:center;justify-content:center;font-size:16px;color:#fff;flex-shrink:0;}
.cat-welcome-bar .cwb-name{font-size:14px;font-weight:800;color:#fff;line-height:1.3;}
.cat-welcome-bar .cwb-sub{font-size:11px;color:rgba(255,255,255,.8);margin-top:1px;}
.cat-welcome-bar .cwb-action{margin-left:auto;background:rgba(255,255,255,.18);border:1.5px solid rgba(255,255,255,.4);color:#fff;border-radius:20px;padding:5px 12px;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;transition:all .2s;flex-shrink:0;display:inline-flex;align-items:center;gap:5px;}
.cat-welcome-bar .cwb-action:hover{background:rgba(255,255,255,.32);}
.cwb-act-ico{font-size:13px;}

.ann-bar{display:none;align-items:center;gap:10px;background:linear-gradient(90deg,var(--primary-dim),rgba(124,58,237,.07));border:1px solid rgba(37,99,235,.14);border-radius:var(--radius);padding:7px 14px;margin-bottom:10px;overflow:hidden;}
.ann-tag{font-size:9px;font-weight:800;letter-spacing:.9px;text-transform:uppercase;background:var(--primary);color:#fff;padding:2px 9px;border-radius:4px;flex-shrink:0;}
.ann-scroll{flex:1;overflow:hidden;}
.ann-text{display:block;white-space:nowrap;font-size:12px;color:var(--muted);animation:ann-scroll 35s linear infinite;}
@keyframes ann-scroll{0%{transform:translateX(110%)}100%{transform:translateX(-110%)}}

/* ══════════════════════════════════════════════════════════════
   SECTION LABEL
══════════════════════════════════════════════════════════════ */
.sec-label{display:flex;align-items:center;gap:10px;font-size:10px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase;color:var(--muted-2);margin-bottom:14px;}
.sec-label::after{content:'';flex:1;height:1px;background:var(--border);}
.sec-label i{font-size:12px;opacity:.6;}

/* ══════════════════════════════════════════════════════════════
   CARDS
══════════════════════════════════════════════════════════════ */
.grid-primary{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;}
@media(max-width:600px){.grid-primary{grid-template-columns:1fr;}}

.card-xl{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);padding:26px 24px;cursor:pointer;position:relative;overflow:hidden;box-shadow:var(--sh-sm);display:flex;gap:18px;align-items:flex-start;transition:transform .22s cubic-bezier(.4,0,.2,1),box-shadow .22s,border-color .22s;}
.card-xl::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:var(--radius-xl) var(--radius-xl) 0 0;}
.card-xl:hover{transform:translateY(-4px);box-shadow:var(--sh-lg);}
.card-xl-icon{width:52px;height:52px;border-radius:14px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:24px;transition:transform .22s;}
.card-xl:hover .card-xl-icon{transform:scale(1.08);}
.card-xl-body{flex:1;min-width:0;}
.card-xl-title{font-size:17px;font-weight:800;margin-bottom:6px;letter-spacing:-.3px;}
.card-xl-desc{font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:16px;}
.card-xl-cta{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;padding:7px 16px;border-radius:var(--radius-sm);transition:all .18s;}
.card-xl-arrow{margin-left:auto;font-size:20px;color:var(--border-strong);align-self:center;flex-shrink:0;transition:all .2s;}
.card-xl:hover .card-xl-arrow{transform:translateX(4px);color:inherit;}

.cxl-inc::before{background:linear-gradient(90deg,#dc2626,#fca5a5);}
.cxl-inc .card-xl-icon{background:rgba(220,38,38,.09);color:#dc2626;}
.cxl-inc .card-xl-cta{background:rgba(220,38,38,.09);color:#dc2626;}
.cxl-inc .card-xl-cta:hover{background:rgba(220,38,38,.16);}
.cxl-inc:hover{border-color:rgba(220,38,38,.22);box-shadow:var(--sh-lg),0 0 0 1px rgba(220,38,38,.1);}
.cxl-inc .card-xl-arrow{color:rgba(220,38,38,.25);}
.cxl-inc:hover .card-xl-arrow{color:#dc2626;}

.cxl-req::before{background:linear-gradient(90deg,#7c3aed,#c4b5fd);}
.cxl-req .card-xl-icon{background:rgba(124,58,237,.09);color:#7c3aed;}
.cxl-req .card-xl-cta{background:rgba(124,58,237,.09);color:#7c3aed;}
.cxl-req .card-xl-cta:hover{background:rgba(124,58,237,.16);}
.cxl-req:hover{border-color:rgba(124,58,237,.22);box-shadow:var(--sh-lg),0 0 0 1px rgba(124,58,237,.1);}
.cxl-req .card-xl-arrow{color:rgba(124,58,237,.25);}
.cxl-req:hover .card-xl-arrow{color:#7c3aed;}

.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:12px;}
@media(max-width:1080px){.grid-4{grid-template-columns:repeat(2,1fr);}}
@media(max-width:520px){.grid-4{grid-template-columns:1fr 1fr;}}

.card-md{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px;cursor:pointer;position:relative;overflow:hidden;box-shadow:var(--sh-xs);transition:transform .22s cubic-bezier(.4,0,.2,1),box-shadow .22s,border-color .22s,background .22s;}
.card-md:hover{transform:translateY(-3px);box-shadow:var(--sh-md);background:var(--card-hover);}
.card-md-icon{width:42px;height:42px;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-size:19px;margin-bottom:14px;transition:transform .22s;}
.card-md:hover .card-md-icon{transform:scale(1.1);}
.card-md-title{font-size:13px;font-weight:700;margin-bottom:4px;letter-spacing:-.1px;}
.card-md-desc{font-size:11.5px;color:var(--muted);line-height:1.55;}
.card-md-badge{position:absolute;top:14px;right:14px;font-size:10px;font-weight:800;padding:2px 8px;border-radius:20px;color:#fff;line-height:1.4;}

.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px;}
@media(max-width:900px){.grid-3{grid-template-columns:repeat(2,1fr);}}
@media(max-width:520px){.grid-3{grid-template-columns:1fr;}}

.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
@media(max-width:600px){.grid-2{grid-template-columns:1fr;}}

.card-sm{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:18px 20px;cursor:pointer;position:relative;overflow:hidden;box-shadow:var(--sh-xs);display:flex;align-items:center;gap:14px;transition:transform .22s cubic-bezier(.4,0,.2,1),box-shadow .22s,border-color .22s;}
.card-sm:hover{transform:translateY(-2px);box-shadow:var(--sh-md);}
.card-sm-icon{width:42px;height:42px;border-radius:var(--radius);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:19px;}
.card-sm-body{flex:1;min-width:0;}
.card-sm-title{font-size:13px;font-weight:700;margin-bottom:3px;}
.card-sm-desc{font-size:11.5px;color:var(--muted);line-height:1.5;}
.card-sm-arrow{margin-left:auto;font-size:16px;color:var(--border-strong);flex-shrink:0;transition:all .2s;}
.card-sm:hover .card-sm-arrow{transform:translateX(3px);}

/* Color palettes */
.ci-blue .card-md-icon,.cb-blue .card-sm-icon{background:rgba(37,99,235,.09);color:#2563eb;}
.ci-blue:hover{border-color:rgba(37,99,235,.2);}.ci-blue:hover .card-md-icon{color:#1d4ed8;}
.ci-teal .card-md-icon,.cb-teal .card-sm-icon{background:rgba(8,145,178,.09);color:#0891b2;}
.ci-teal:hover{border-color:rgba(8,145,178,.2);}.ci-teal:hover .card-md-icon{color:#0e7490;}
.ci-amber .card-md-icon,.cb-amber .card-sm-icon{background:rgba(217,119,6,.09);color:#d97706;}
.ci-amber:hover{border-color:rgba(217,119,6,.2);}
.ci-green .card-md-icon,.cb-green .card-sm-icon{background:rgba(5,150,105,.09);color:#059669;}
.ci-green:hover{border-color:rgba(5,150,105,.2);}
.ci-yellow .card-md-icon,.cb-yellow .card-sm-icon{background:rgba(202,138,4,.09);color:#ca8a04;}
.ci-yellow:hover{border-color:rgba(202,138,4,.2);}
.ci-purple .card-md-icon,.cb-purple .card-sm-icon{background:rgba(124,58,237,.09);color:#7c3aed;}
.ci-purple:hover{border-color:rgba(124,58,237,.2);}
.ci-wa .card-md-icon{background:rgba(37,211,102,.09);color:#16a34a;}
.ci-wa:hover{border-color:rgba(37,211,102,.2);}
.ci-rose .card-md-icon,.cb-rose .card-sm-icon{background:rgba(225,29,72,.09);color:#e11d48;}
.ci-rose:hover{border-color:rgba(225,29,72,.2);}
.cb-orange .card-sm-icon{background:rgba(234,88,12,.09);color:#ea580c;}
.cb-orange:hover{border-color:rgba(234,88,12,.2);}
.cb-sky .card-sm-icon{background:rgba(2,132,199,.09);color:#0284c7;}
.cb-sky:hover{border-color:rgba(2,132,199,.2);}

[data-hidden="true"]{display:none!important;}

/* ══════════════════════════════════════════════════════════════
   QUICK ACTIONS — 3 acciones principales siempre visibles
══════════════════════════════════════════════════════════════ */
.qa-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px;}
@media(max-width:900px){.qa-grid{grid-template-columns:1fr;}}
@media(max-width:1200px){.qa-grid{grid-template-columns:repeat(3,1fr);}}

.qa-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--radius-lg);padding:12px 16px;
  cursor:pointer;position:relative;overflow:hidden;
  box-shadow:var(--sh-sm);
  display:flex;flex-direction:column;gap:8px;
  transition:transform .2s cubic-bezier(.4,0,.2,1),box-shadow .2s,border-color .2s;
}
.qa-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:var(--radius-lg) var(--radius-lg) 0 0;}
.qa-card:hover{transform:translateY(-3px);box-shadow:var(--sh-md);}
.qa-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;transition:transform .2s;}
.qa-card:hover .qa-icon{transform:scale(1.08);}
.qa-title{font-size:13px;font-weight:800;letter-spacing:-.2px;margin-bottom:3px;}
.qa-desc{font-size:11.5px;color:var(--muted);line-height:1.55;flex:1;}
.qa-btn{
  display:inline-flex;align-items:center;gap:5px;
  font-size:11px;font-weight:700;padding:6px 13px;
  border-radius:var(--radius-sm);align-self:flex-start;
  border:none;cursor:pointer;transition:all .15s;font-family:inherit;
}
/* inc */
.qa-inc::before{background:linear-gradient(90deg,#dc2626,#fca5a5);}
.qa-inc .qa-icon{background:rgba(220,38,38,.09);color:#dc2626;}
.qa-inc .qa-btn{background:rgba(220,38,38,.09);color:#dc2626;}
.qa-inc .qa-btn:hover{background:rgba(220,38,38,.16);}
.qa-inc:hover{border-color:rgba(220,38,38,.22);box-shadow:var(--sh-lg),0 0 0 1px rgba(220,38,38,.08);}
/* req */
.qa-req::before{background:linear-gradient(90deg,#7c3aed,#c4b5fd);}
.qa-req .qa-icon{background:rgba(124,58,237,.09);color:#7c3aed;}
.qa-req .qa-btn{background:rgba(124,58,237,.09);color:#7c3aed;}
.qa-req .qa-btn:hover{background:rgba(124,58,237,.16);}
.qa-req:hover{border-color:rgba(124,58,237,.22);box-shadow:var(--sh-lg),0 0 0 1px rgba(124,58,237,.08);}
/* tkt */
.qa-tkt::before{background:linear-gradient(90deg,#0891b2,#a5f3fc);}
.qa-tkt .qa-icon{background:rgba(8,145,178,.09);color:#0891b2;}
.qa-tkt .qa-btn{background:rgba(8,145,178,.09);color:#0891b2;}
.qa-tkt .qa-btn:hover{background:rgba(8,145,178,.16);}
.qa-tkt:hover{border-color:rgba(8,145,178,.22);box-shadow:var(--sh-lg),0 0 0 1px rgba(8,145,178,.08);}
.qa-tkt-count{font-size:22px;font-weight:900;color:var(--text);letter-spacing:-1px;line-height:1;}
.qa-tkt-sub{font-size:11px;color:var(--muted);}

/* ══ PROMO BANNER ══════════════════════════════════════════════ */
.promo-banner{
  margin-top:20px;
  border-radius:var(--radius-lg);
  overflow:hidden;
  cursor:pointer;
  box-shadow:var(--sh-sm);
  transition:transform .2s cubic-bezier(.4,0,.2,1),box-shadow .2s;
  display:block;line-height:0;
}
.promo-banner:hover{transform:translateY(-2px);box-shadow:var(--sh-md);}
.promo-banner img{width:100%;height:170px;object-fit:cover;object-position:center bottom;display:block;}

/* ══════════════════════════════════════════════════════════════
   TOAST
══════════════════════════════════════════════════════════════ */
#toastWrap{position:fixed;bottom:28px;right:28px;z-index:9999;display:flex;flex-direction:column;gap:8px;pointer-events:none;}
.toast-item{pointer-events:auto;background:var(--card);border:1px solid var(--border);color:var(--text);border-radius:var(--radius);padding:12px 18px;font-size:13px;font-weight:500;box-shadow:var(--sh-md);display:flex;align-items:center;gap:10px;min-width:240px;animation:toastIn .22s ease;}
.ti-ok{border-left:4px solid var(--success);}.ti-err{border-left:4px solid var(--danger);}.ti-inf{border-left:4px solid var(--info);}
@keyframes toastIn{from{opacity:0;transform:translateX(18px)}to{opacity:1;transform:none}}

/* ══════════════════════════════════════════════════════════════
   MODALS
══════════════════════════════════════════════════════════════ */
.portal-modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:9999;align-items:center;justify-content:center;}
.portal-modal-overlay.show{display:flex;}
.portal-modal{background:var(--card);border-radius:16px;padding:28px 28px 24px;width:100%;max-width:480px;box-shadow:var(--sh-lg);position:relative;}
.portal-modal h3{font-size:17px;font-weight:700;margin:0 0 18px;display:flex;align-items:center;gap:8px;}
.portal-modal label{font-size:12px;font-weight:600;color:var(--muted);display:block;margin-bottom:5px;margin-top:12px;}
.portal-modal input,.portal-modal textarea,.portal-modal select{width:100%;border:1.5px solid var(--border);border-radius:8px;padding:9px 12px;font-size:13px;background:var(--bg);color:var(--text);outline:none;transition:border-color .2s;box-sizing:border-box;}
.portal-modal input:focus,.portal-modal textarea:focus,.portal-modal select:focus{border-color:var(--primary);}
.portal-modal .pm-actions{display:flex;gap:10px;margin-top:20px;justify-content:flex-end;}
.portal-modal .pm-btn{padding:9px 22px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:none;transition:opacity .2s;}
.portal-modal .pm-btn-primary{background:var(--primary);color:#fff;}.portal-modal .pm-btn-primary:hover{opacity:.88;}
.portal-modal .pm-btn-secondary{background:var(--bg-subtle);color:var(--muted);}.portal-modal .pm-btn-secondary:hover{background:var(--border);}
.portal-modal .pm-close{position:absolute;top:14px;right:16px;background:none;border:none;font-size:18px;cursor:pointer;color:var(--muted-2);}
.portal-modal .pm-success{display:none;text-align:center;padding:16px 0 8px;}
.portal-modal .pm-success i{font-size:40px;color:var(--success);}
.portal-modal .pm-success p{font-size:14px;margin:10px 0 0;color:var(--text);font-weight:500;}
.portal-modal .star-row{display:flex;gap:10px;margin:10px 0;position:relative;}
.portal-modal .star-btn{font-size:34px;background:none;border:none;cursor:pointer;color:var(--border-strong);transition:color .18s,transform .18s;padding:2px;position:relative;line-height:1;}
.portal-modal .star-btn:hover{transform:scale(1.25);}
.portal-modal .star-btn.active{color:#f59e0b;}
.portal-modal .star-btn.pop{animation:starPop .38s cubic-bezier(.34,1.56,.64,1);}
@keyframes starPop{0%{transform:scale(1)}40%{transform:scale(1.55)}70%{transform:scale(.88)}100%{transform:scale(1)}}
.star-particle{position:fixed;pointer-events:none;font-size:16px;z-index:99999;animation:particleFly .7s ease-out forwards;}
@keyframes particleFly{0%{opacity:1;transform:translate(0,0) scale(1)}100%{opacity:0;transform:translate(var(--tx),var(--ty)) scale(.3)}}
.dev-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9999;display:none;align-items:center;justify-content:center;padding:16px;}
.dev-overlay.show{display:flex;}
/* Mis Consultas modal */
.csl-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9500;display:none;align-items:center;justify-content:center;padding:20px;}
.csl-overlay.show{display:flex;}
.csl-box{background:var(--card);border-radius:18px;width:100%;max-width:900px;max-height:88vh;display:flex;flex-direction:column;box-shadow:var(--sh-lg);overflow:hidden;}
[data-theme="dark"] .csl-box{background:#111827;}
.csl-head{display:flex;align-items:center;gap:12px;padding:16px 22px;border-bottom:1px solid var(--border);flex-shrink:0;}
.csl-head-ico{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#0f766e,#0891b2);display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px;flex-shrink:0;}
.csl-head-title{font-size:15px;font-weight:800;color:var(--text);}
.csl-head-sub{font-size:11.5px;color:var(--muted);margin-top:1px;}
.csl-close{margin-left:auto;background:none;border:none;font-size:20px;color:var(--muted);cursor:pointer;padding:4px 8px;border-radius:8px;line-height:1;font-family:inherit;}
.csl-close:hover{background:var(--border);color:var(--text);}
.csl-search{display:flex;gap:10px;padding:12px 22px;border-bottom:1px solid var(--border);flex-shrink:0;}
.csl-body{flex:1;overflow-y:auto;padding:16px 22px;}
.gar-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9999;display:none;align-items:center;justify-content:center;padding:16px;}
.gar-overlay.show{display:flex;}
.onb-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:10000;display:none;align-items:flex-end;justify-content:center;padding:0 16px 32px;}
.onb-overlay.show{display:flex;}
.tkt-track-overlay{position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:10000;display:none;align-items:center;justify-content:center;padding:16px;}
.tkt-track-overlay.show{display:flex;}
.mtkt-tab{padding:9px 16px;font-size:12px;font-weight:700;border:none;background:none;color:var(--muted);cursor:pointer;border-bottom:2.5px solid transparent;margin-bottom:-2px;border-radius:6px 6px 0 0;transition:all .2s;display:flex;align-items:center;gap:6px;}
.mtkt-tab:hover{color:var(--text);background:var(--bg-subtle);}
.mtkt-tab.active{color:var(--primary);border-bottom-color:var(--primary);background:transparent;}
.mtkt-badge{background:var(--primary);color:#fff;font-size:10px;font-weight:800;padding:1px 6px;border-radius:10px;display:none;}
.mtkt-tab.active .mtkt-badge{display:inline;}
.mtkt-search-wrap{display:flex;gap:8px;align-items:center;background:var(--bg-main);border:1.5px solid var(--border-soft);border-radius:12px;padding:8px 14px;margin-bottom:14px;transition:border-color .2s;}
.mtkt-search-wrap:focus-within{border-color:var(--primary);}
.mtkt-search-icon{color:var(--muted);font-size:16px;flex-shrink:0;}
.mtkt-search-input{flex:1;border:none;background:transparent;font-size:13px;color:var(--text-main);outline:none;font-family:inherit;}
.mtkt-search-input::placeholder{color:var(--muted-2);}
.mtkt-search-btn{background:var(--primary);color:#fff;border:none;border-radius:8px;padding:6px 16px;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:5px;}
.mtkt-search-btn:hover{opacity:.9;}
.mtkt-search-hint{font-size:11px;color:var(--muted-2);margin-bottom:14px;}
.anuncios-tabs{display:flex;gap:4px;border-bottom:2px solid var(--border);margin-bottom:18px;}
.anuncios-tab{padding:8px 14px;font-size:12px;font-weight:700;border:none;background:none;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;border-radius:6px 6px 0 0;transition:all .2s;}
.anuncios-tab.active{color:var(--primary);border-bottom-color:var(--primary);}
.anuncios-tab-panel{display:none;}.anuncios-tab-panel.active{display:block;}

/* chatbot */
#chatFab{display:none;}
.cb-container{position:fixed;bottom:24px;right:24px;z-index:9997;display:none;}
.cb-container.cb-visible{display:block !important;}
.cb-btn{width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#1e3a5f,#2563eb);border:none;box-shadow:0 4px 20px rgba(37,99,235,.45);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .3s;position:relative;}
.cb-btn:hover{transform:scale(1.1);box-shadow:0 6px 28px rgba(37,99,235,.6);}
.cb-btn i{color:#fff;font-size:26px;}
.cb-btn-pulse{position:absolute;inset:0;border-radius:50%;background:rgba(37,99,235,.35);animation:cbPulse 2.2s ease-out infinite;}
@keyframes cbPulse{0%{transform:scale(1);opacity:.7}70%{transform:scale(1.55);opacity:0}100%{opacity:0}}
.cb-window{position:absolute;bottom:74px;right:0;width:380px;height:520px;background:var(--card);border-radius:20px;box-shadow:var(--sh-lg);display:none;flex-direction:column;overflow:hidden;}
[data-theme="dark"] .cb-window{background:#0f1e35;}
.cb-window.active{display:flex;animation:cbUp .3s cubic-bezier(.34,1.56,.64,1);}
@keyframes cbUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.cb-header{background:linear-gradient(135deg,#1e3a5f,#2563eb,#0ea5e9);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.cb-hinfo{display:flex;align-items:center;gap:12px;}
.cb-avatar{width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.15);border:2px solid rgba(255,255,255,.3);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.cb-avatar i{color:#fff;font-size:20px;}
.cb-htitle h4{margin:0;font-size:14px;font-weight:800;color:#fff;}
.cb-htitle p{margin:0;font-size:11px;color:rgba(255,255,255,.8);display:flex;align-items:center;gap:5px;}
.cb-online-dot{width:7px;height:7px;background:#4ade80;border-radius:50%;display:inline-block;animation:cbPulse 2s ease-out infinite;}
.cb-x{background:rgba(255,255,255,.15);border:none;color:#fff;cursor:pointer;font-size:15px;padding:6px;border-radius:50%;width:30px;height:30px;display:flex;align-items:center;justify-content:center;transition:background .2s;}
.cb-x:hover{background:rgba(255,255,255,.28);}
.cb-msgs{flex:1;padding:16px;overflow-y:auto;background:#f4f6fb;display:flex;flex-direction:column;gap:10px;}
[data-theme="dark"] .cb-msgs{background:#0b1120;}
.cb-msgs::-webkit-scrollbar{width:4px;}
.cb-msgs::-webkit-scrollbar-thumb{background:#d1d5db;border-radius:2px;}
.msg{display:flex;animation:msgIn .28s ease;}
@keyframes msgIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.msg.bot{justify-content:flex-start;}.msg.user{justify-content:flex-end;}
.msg-c{max-width:78%;padding:10px 14px;border-radius:15px;font-size:13px;line-height:1.5;}
.msg.bot .msg-c{background:#fff;color:#1e293b;border-bottom-left-radius:3px;box-shadow:0 1px 4px rgba(0,0,0,.07);}
[data-theme="dark"] .msg.bot .msg-c{background:#1e3050;color:#e2e8f0;}
.msg.user .msg-c{background:linear-gradient(135deg,#1e3a5f,#2563eb);color:#fff;border-bottom-right-radius:3px;}
.qopts{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;}
.qopt{background:#fff;border:1.5px solid #2563eb;color:#2563eb;padding:6px 13px;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;}
.qopt:hover{background:#2563eb;color:#fff;}
.dots{display:flex;gap:4px;padding:3px 1px;}
.dots span{width:7px;height:7px;background:#2563eb;border-radius:50%;animation:bounce 1.3s infinite;}
.dots span:nth-child(2){animation-delay:.2s;}.dots span:nth-child(3){animation-delay:.4s;}
@keyframes bounce{0%,60%,100%{transform:translateY(0);opacity:.7}30%{transform:translateY(-7px);opacity:1}}
.cb-input-area{padding:12px;background:#fff;border-top:1px solid #e9ecef;display:flex;gap:9px;flex-shrink:0;}
[data-theme="dark"] .cb-input-area{background:#131f35;border-top:1px solid #1e3050;}
.cb-input{flex:1;border:1px solid #dee2e6;border-radius:22px;padding:8px 16px;font-size:13px;outline:none;font-family:inherit;background:#fff;color:#1e293b;transition:border-color .25s;}
[data-theme="dark"] .cb-input{background:#0b1120;border-color:#1e3050;color:#e2e8f0;}
.cb-input:focus{border-color:#2563eb;}
.cb-send{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#1e3a5f,#2563eb);border:none;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .25s;}
.cb-send:hover{transform:scale(1.07);}
@media(max-width:500px){.cb-window{width:calc(100vw - 28px);right:-8px;}}
/* ── CHATBOT ACTION CARDS ──────────────────────────────────── */
.cb-ticket-card{background:#fff;border:1.5px solid #e2e8f0;border-radius:11px;padding:11px 13px;margin-top:5px;cursor:pointer;transition:border-color .2s;}
[data-theme="dark"] .cb-ticket-card{background:#1a2d4a;border-color:#2d4a7a;}
.cb-ticket-card:hover{border-color:#2563eb;}
.cb-tc-top{display:flex;align-items:center;gap:7px;margin-bottom:5px;}
.cb-tc-key{font-family:monospace;font-size:12px;font-weight:800;color:#2563eb;background:rgba(37,99,235,.1);padding:2px 8px;border-radius:6px;}
.cb-tc-status{font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;text-transform:uppercase;letter-spacing:.3px;}
.cb-tc-status.abierto{background:rgba(245,158,11,.12);color:#d97706;}
.cb-tc-status.resuelto,.cb-tc-status.cerrado{background:rgba(5,150,105,.12);color:#059669;}
.cb-tc-title{font-size:12.5px;font-weight:600;color:#0f172a;margin-bottom:5px;line-height:1.4;}
[data-theme="dark"] .cb-tc-title{color:#e2e8f0;}
.cb-tc-meta{display:flex;gap:10px;flex-wrap:wrap;font-size:10.5px;color:#64748b;}
.cb-confirm-card{background:#f0f9ff;border:1.5px solid #bae6fd;border-radius:11px;padding:12px 13px;margin-top:6px;}
.cb-cc-label{font-size:10px;font-weight:800;text-transform:uppercase;color:#0891b2;letter-spacing:.5px;margin-bottom:6px;}
.cb-cc-desc{font-size:12.5px;color:#0f172a;line-height:1.45;margin-bottom:7px;}
[data-theme="dark"] .cb-cc-desc,[data-theme="dark"] .cb-cc-prio strong{color:#e2e8f0;}
.cb-cc-prio{font-size:11.5px;color:#64748b;margin-bottom:10px;}
.cb-cc-actions{display:flex;gap:7px;}
.cb-cc-btn-ok{flex:1;padding:8px 12px;border-radius:9px;border:none;background:linear-gradient(135deg,#0052cc,#2563eb);color:#fff;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;transition:opacity .2s;}
.cb-cc-btn-ok:hover{opacity:.88;}.cb-cc-btn-ok:disabled{opacity:.5;cursor:not-allowed;}
.cb-cc-btn-cancel{padding:8px 12px;border-radius:9px;border:1.5px solid #e2e8f0;background:transparent;color:#64748b;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;}
.cb-cc-btn-cancel:hover{border-color:#ef4444;color:#ef4444;}
.cb-link-card{background:#f0fdf4;border:1.5px solid #bbf7d0;border-radius:11px;padding:12px 13px;margin-top:6px;display:flex;gap:10px;}
.cb-lc-icon{font-size:22px;flex-shrink:0;line-height:1;}
.cb-lc-title{font-size:12.5px;font-weight:700;color:#065f46;margin-bottom:3px;}
.cb-lc-sub{font-size:11.5px;color:#059669;margin-bottom:7px;line-height:1.4;}
.cb-lc-btn{display:inline-flex;align-items:center;gap:5px;padding:7px 13px;border-radius:8px;background:linear-gradient(135deg,#059669,#10b981);color:#fff;font-size:12px;font-weight:700;text-decoration:none;transition:opacity .2s;}
.cb-lc-btn:hover{opacity:.88;}
.cb-success-card{background:#f0fdf4;border:1.5px solid #86efac;border-radius:11px;padding:13px;display:flex;align-items:flex-start;gap:11px;margin-top:6px;}
.cb-sc-icon{font-size:26px;flex-shrink:0;}
.cb-sc-title{font-size:13px;font-weight:800;color:#065f46;margin-bottom:3px;}
.cb-sc-key{font-family:monospace;font-size:13px;font-weight:800;color:#059669;}
.cb-sc-sub{font-size:11px;color:#059669;margin-top:3px;line-height:1.4;}
.cb-sc-link{display:inline-flex;align-items:center;gap:4px;font-size:11.5px;font-weight:700;color:#059669;text-decoration:none;margin-top:6px;}
.cb-sc-link:hover{text-decoration:underline;}

/* ── Live Specialist Chat ────────────────────────────────── */
.cci-waiting-card{background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:11px;padding:14px;text-align:center;margin-top:6px;}
.cci-w-icon{font-size:26px;margin-bottom:5px;}
.cci-w-title{font-size:12.5px;font-weight:800;color:#1e40af;margin-bottom:3px;}
.cci-w-sub{font-size:11px;color:#3b82f6;line-height:1.5;}
.cci-w-anim{display:flex;justify-content:center;gap:5px;margin-top:10px;}
.cci-w-anim span{width:7px;height:7px;border-radius:50%;background:#3b82f6;animation:cciDot 1.4s ease-in-out infinite;}
.cci-w-anim span:nth-child(2){animation-delay:.22s;}
.cci-w-anim span:nth-child(3){animation-delay:.44s;}
@keyframes cciDot{0%,80%,100%{transform:scale(.55);opacity:.45;}40%{transform:scale(1);opacity:1;}}
.cci-spec-msg{background:linear-gradient(135deg,#f0f9ff,#e0f2fe);border:1.5px solid #bae6fd;border-radius:0 10px 10px 10px;padding:8px 12px;margin-top:2px;max-width:88%;align-self:flex-start;}
.cci-spec-name{font-size:9.5px;font-weight:800;color:#0369a1;margin-bottom:3px;text-transform:uppercase;letter-spacing:.4px;}
.cci-spec-text{font-size:12.5px;color:#0f172a;line-height:1.4;}
.cci-resolve-card{background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:11px;padding:12px;margin-top:6px;text-align:center;}
.cci-resolve-title{font-size:12px;font-weight:700;color:#334155;margin-bottom:8px;}
.cci-resolve-btns{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;}
.cci-btn-ok{background:#059669;color:#fff;border:none;border-radius:8px;padding:7px 14px;font-size:12px;font-weight:700;cursor:pointer;}
.cci-btn-tk{background:#2563eb;color:#fff;border:none;border-radius:8px;padding:7px 14px;font-size:12px;font-weight:700;cursor:pointer;}

/* devolución / garantías */
.dev-box{background:var(--card);border-radius:22px;width:100%;max-width:560px;max-height:93vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 28px 70px rgba(0,0,0,.3);}
.dev-header{background:linear-gradient(135deg,#9d174d,#be185d,#ec4899);padding:22px 22px 0;position:relative;flex-shrink:0;}
.dev-hclose{position:absolute;top:14px;right:14px;background:rgba(255,255,255,.2);border:none;border-radius:50%;width:30px;height:30px;color:#fff;font-size:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;}
.dev-hclose:hover{background:rgba(255,255,255,.35);}
