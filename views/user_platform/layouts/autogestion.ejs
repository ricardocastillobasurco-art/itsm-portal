/* mis tickets / tracking */
.tkt-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px 16px;margin-bottom:8px;cursor:pointer;transition:all .2s;display:flex;align-items:flex-start;gap:12px;}
.tkt-card:hover{border-color:var(--primary);box-shadow:0 2px 12px rgba(59,130,246,.12);}
.tkt-id{font-family:monospace;font-size:11px;color:var(--muted);font-weight:700;}
.tkt-title{font-size:13px;font-weight:700;color:var(--text);margin-bottom:4px;}
.tkt-meta{display:flex;gap:6px;align-items:center;flex-wrap:wrap;}
.tkt-badge{display:inline-flex;align-items:center;padding:2px 8px;border-radius:999px;font-size:10px;font-weight:700;}
.tkt-open{background:#dbeafe;color:#1d4ed8;}.tkt-prog{background:#ede9fe;color:#5b21b6;}
.tkt-pend{background:#fef3c7;color:#92400e;}.tkt-done{background:#d1fae5;color:#065f46;}
.tkt-closed{background:#f1f5f9;color:#475569;}
.tkt-p1{background:#fee2e2;color:#991b1b;}.tkt-p2{background:#ffedd5;color:#9a3412;}
.tkt-p3{background:#fef9c3;color:#854d0e;}.tkt-p4{background:#f1f5f9;color:#475569;}
.tkt-track-box{background:var(--card);border-radius:18px;width:100%;max-width:480px;max-height:88vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 16px 60px rgba(0,0,0,.25);position:relative;}
.tkt-track-head{padding:20px 22px 16px;border-bottom:1px solid var(--border);flex-shrink:0;}
.tkt-track-body{overflow-y:auto;padding:18px 22px;flex:1;}
.tkt-track-foot{padding:12px 22px;border-top:1px solid var(--border);flex-shrink:0;display:flex;justify-content:flex-end;}
.tkt-trk-step{display:flex;gap:12px;padding:10px 0;position:relative;}
.tkt-trk-step:not(:last-child)::after{content:'';position:absolute;left:13px;top:32px;bottom:-6px;width:2px;background:var(--border);}
.tkt-trk-dot{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;font-weight:800;margin-top:1px;}
.trk-done{background:#d1fae5;color:#059669;}.trk-curr{background:#dbeafe;color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.15);}
.trk-pend{background:var(--bg);border:1.5px solid var(--border);color:var(--muted);}
.ig-post{background:var(--card);border:1px solid var(--border);border-radius:14px;margin-bottom:14px;overflow:hidden;}
.ig-post-header{display:flex;align-items:center;gap:10px;padding:12px 14px;}
.ig-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#8b5cf6);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;flex-shrink:0;}
.ig-author-name{font-size:13px;font-weight:700;color:var(--text);}
.ig-post-date{font-size:11px;color:var(--muted);}
.ig-post-body{padding:0 14px 10px;font-size:13px;color:var(--text);line-height:1.6;}
.ig-post-title{font-size:14px;font-weight:800;color:var(--text);margin-bottom:4px;}
.ig-post-img{width:100%;max-height:360px;object-fit:cover;display:block;}
.ig-reactions{display:flex;align-items:center;gap:4px;padding:8px 12px;border-top:1px solid var(--border);}
.ig-react-btn{background:none;border:none;cursor:pointer;font-size:20px;padding:4px 5px;border-radius:8px;transition:transform .15s;line-height:1;}
.ig-react-btn:hover{transform:scale(1.25);}
.ig-react-count{font-size:11px;font-weight:600;color:var(--muted);min-width:12px;margin-right:6px;}
.ig-comments-toggle{margin-left:auto;font-size:11px;font-weight:600;color:var(--primary);cursor:pointer;background:none;border:none;padding:4px 8px;border-radius:6px;}
.ig-comments-section{border-top:1px solid var(--border);padding:10px 14px;display:none;}
.ig-comments-section.open{display:block;}
.anuncio-card{background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 14px;margin-bottom:10px;}
.anuncio-card-title{font-size:13px;font-weight:700;color:var(--text);margin-bottom:4px;}
.anuncio-card-body{font-size:12px;color:var(--muted);line-height:1.6;}
.sol-subtab{padding:6px 18px;border-radius:20px;border:1.5px solid var(--border);background:transparent;color:var(--muted);font-size:12px;font-weight:700;cursor:pointer;transition:all .2s;}
.sol-subtab.active{background:var(--primary);color:#fff;border-color:var(--primary);}
.onb-card{background:var(--card);border-radius:20px;width:100%;max-width:560px;padding:24px 24px 20px;box-shadow:0 -4px 40px rgba(0,0,0,.2);animation:onbUp .4s cubic-bezier(.34,1.56,.64,1);}
@keyframes onbUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
.onb-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px;}
.onb-step{background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:12px 10px;text-align:center;}
.onb-step-icon{font-size:22px;margin-bottom:6px;}
.onb-step-title{font-size:12px;font-weight:700;color:var(--text);margin-bottom:3px;}
.onb-step-desc{font-size:10px;color:var(--muted);line-height:1.4;}
.sw-pill{padding:5px 14px;border-radius:20px;border:1.5px solid var(--border);background:transparent;color:var(--muted);font-size:11px;font-weight:700;cursor:pointer;transition:all .18s;white-space:nowrap;}
.sw-pill.active{background:#65a30d;color:#fff;border-color:#65a30d;}
.sw-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:10px;transition:box-shadow .2s,transform .15s;}
.sw-card:hover{box-shadow:0 6px 20px rgba(0,0,0,.10);transform:translateY(-2px);}
.sw-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;}
.sw-name{font-size:13px;font-weight:800;color:var(--text);}.sw-cat{font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;}
.sw-desc{font-size:11px;color:var(--muted);line-height:1.5;flex:1;}
.sw-btn{width:100%;padding:7px 10px;border-radius:8px;border:none;font-size:11px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;}
.sw-btn-install{background:#65a30d;color:#fff;}
.sw-btn-permit{background:rgba(59,130,246,.12);color:#2563eb;border:1px solid rgba(59,130,246,.25);}
.sw-btn-info{background:var(--bg);color:var(--muted);border:1px solid var(--border);}
.sw-badge-free{display:inline-block;padding:2px 8px;border-radius:10px;font-size:9px;font-weight:800;background:#d1fae5;color:#047857;text-transform:uppercase;}
.sw-badge-license{display:inline-block;padding:2px 8px;border-radius:10px;font-size:9px;font-weight:800;background:#fef3c7;color:#92400e;text-transform:uppercase;}
.sw-badge-restricted{display:inline-block;padding:2px 8px;border-radius:10px;font-size:9px;font-weight:800;background:#fee2e2;color:#b91c1c;text-transform:uppercase;}

/* mobile overlay */
.sb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:299;touch-action:none;}
.sb-overlay.show{display:block;}

/* ══ HOME STATS ROW ════════════════════════════════════════ */
.home-stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:20px 0 0;}
@media(max-width:900px){.home-stats-row{grid-template-columns:repeat(2,1fr);}}
@media(max-width:480px){.home-stats-row{grid-template-columns:1fr 1fr;}}
.stat-chip{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:16px 18px;box-shadow:var(--sh-xs);transition:transform .2s,box-shadow .2s;cursor:default;}
.stat-chip:hover{transform:translateY(-2px);box-shadow:var(--sh-sm);}
.stat-chip-icon{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;margin-bottom:10px;}
.stat-chip-val{font-size:26px;font-weight:900;letter-spacing:-1px;line-height:1;margin-bottom:4px;}
.stat-chip-lbl{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;}

/* ══ DATA ROW — donut + feed ════════════════════════════════ */
.data-row{display:grid;grid-template-columns:200px 1fr;gap:14px;margin-top:14px;}
@media(max-width:768px){.data-row{grid-template-columns:1fr;}}
.donut-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px;box-shadow:var(--sh-xs);}
.donut-card-title{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:16px;}
.donut-wrap{position:relative;width:120px;height:120px;margin:0 auto 14px;}
.donut-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;}
.donut-center-val{font-size:22px;font-weight:900;letter-spacing:-1px;color:var(--text);}
.donut-center-lbl{font-size:10px;color:var(--muted);font-weight:600;}
.donut-legend{display:flex;flex-direction:column;gap:6px;}
.dl-item{display:flex;align-items:center;gap:8px;font-size:12px;}
.dl-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
.dl-label{flex:1;color:var(--muted);}
.dl-val{font-weight:800;color:var(--text);}
.feed-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px;box-shadow:var(--sh-xs);display:flex;flex-direction:column;}
.feed-title{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;}
.feed-see-all{font-size:11px;font-weight:700;color:var(--primary);text-transform:none;letter-spacing:0;cursor:pointer;border:none;background:none;font-family:inherit;}
.feed-item{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--border);}
.feed-item:last-child{border-bottom:none;padding-bottom:0;}
.feed-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.feed-key{font-family:monospace;font-size:11px;font-weight:800;color:var(--primary);min-width:74px;}
.feed-sum{flex:1;font-size:12px;font-weight:600;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.feed-status{font-size:10px;font-weight:700;padding:2px 9px;border-radius:20px;flex-shrink:0;}

/* ══ MI EQUIPO VIEW ═════════════════════════════════════════ */
.equipo-grid{display:flex;flex-direction:column;gap:20px;}
.eq-card{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;box-shadow:var(--sh-xs);}
.eq-card-header{display:flex;align-items:center;gap:14px;padding:20px 22px;background:linear-gradient(135deg,rgba(8,145,178,.07),rgba(124,58,237,.04));border-bottom:1px solid var(--border);}
.eq-device-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0;background:rgba(8,145,178,.12);color:#0891b2;}
.eq-device-name{font-size:15px;font-weight:800;color:var(--text);letter-spacing:-.3px;}
.eq-device-sub{font-size:11.5px;color:var(--muted);margin-top:2px;}
.eq-status-badge{margin-left:auto;font-size:11px;font-weight:700;padding:4px 13px;border-radius:20px;flex-shrink:0;white-space:nowrap;}
.eq-emp-strip{display:flex;align-items:center;gap:12px;padding:13px 22px;background:rgba(124,58,237,.04);border-bottom:1px solid var(--border);}
.eq-emp-avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#7c3aed,#0891b2);color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0;letter-spacing:-.5px;}
.eq-emp-name{font-size:13px;font-weight:700;color:var(--text);}
.eq-emp-meta{font-size:11px;color:var(--muted);margin-top:1px;}
.eq-specs{display:grid;grid-template-columns:1fr 1fr;}
.eq-spec-row{display:flex;align-items:baseline;gap:8px;padding:9px 22px;border-bottom:1px solid var(--border);}
.eq-spec-row:last-child,.eq-spec-row:nth-last-child(2):nth-child(odd){border-bottom:none;}
.eq-spec-label{color:var(--muted);font-size:11px;font-weight:600;min-width:88px;flex-shrink:0;}
.eq-spec-val{color:var(--text);font-size:12px;font-weight:700;word-break:break-word;}
.eq-hw-section{padding:16px 22px;border-top:1px solid var(--border);}
.eq-hw-title{font-size:10.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.9px;margin-bottom:12px;}
.eq-hw-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.eq-hw-row:last-child{margin-bottom:0;}
.eq-hw-label{font-size:11px;color:var(--text);font-weight:600;min-width:110px;flex-shrink:0;}
.eq-hw-bar{flex:1;background:var(--border);border-radius:4px;height:6px;overflow:hidden;}
.eq-hw-fill{height:100%;border-radius:4px;transition:width .5s ease;}
.eq-hw-val{font-size:11px;color:var(--muted);min-width:70px;text-align:right;}
.eq-footer{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;padding:13px 22px;border-top:1px solid var(--border);background:rgba(0,0,0,.015);}
.eq-assign-info{font-size:11.5px;color:var(--muted);}
.eq-assign-info strong{color:var(--text);font-weight:700;}
.eq-btn-copy{background:transparent;border:1px solid var(--border);border-radius:8px;padding:6px 14px;font-size:12px;font-weight:600;color:var(--text);cursor:pointer;display:flex;align-items:center;gap:6px;transition:background .15s,border-color .15s;}
.eq-btn-copy:hover{background:var(--border);}
.eq-empty{text-align:center;padding:56px 20px;color:var(--muted);}
.eq-empty-icon{font-size:42px;margin-bottom:12px;opacity:.45;}

/* ══ MI EQUIPO DASHBOARD ═════════════════════════════════════ */
.meq-profile{display:flex;align-items:center;gap:16px;padding:20px 24px;background:linear-gradient(135deg,#07111f 0%,#0c1d3a 50%,#0a1729 100%);border:1px solid rgba(14,165,233,.18);border-radius:16px;margin-bottom:12px;position:relative;overflow:hidden;}
.meq-avatar{width:52px;height:52px;border-radius:13px;background:linear-gradient(135deg,#0ea5e9,#7c3aed);color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;flex-shrink:0;letter-spacing:-.5px;}
.meq-prof-name{font-size:17px;font-weight:800;color:#f1f5f9;letter-spacing:-.4px;}
.meq-prof-sub{font-size:11.5px;color:#475569;margin-top:3px;}
.meq-badges{margin-left:auto;display:flex;gap:8px;flex-shrink:0;flex-wrap:wrap;justify-content:flex-end;z-index:1;}
.meq-badge{font-size:11px;font-weight:700;padding:5px 12px;border-radius:20px;display:flex;align-items:center;gap:5px;white-space:nowrap;}
.meq-alert{display:flex;align-items:flex-start;gap:12px;padding:13px 18px;background:rgba(239,68,68,.07);border:1px solid rgba(239,68,68,.18);border-radius:12px;margin-bottom:12px;}
.meq-alert-title{font-size:13px;font-weight:700;color:#fca5a5;margin-bottom:2px;}
.meq-alert-sub{font-size:11.5px;color:rgba(248,113,113,.7);}
.meq-card{background:var(--card);border:1px solid var(--border);border-radius:16px;margin-bottom:12px;overflow:hidden;}
.meq-card-body{padding:18px 20px;}
.meq-card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}
.meq-card-title{font-size:13px;font-weight:700;color:var(--text);}
.meq-card-meta{font-size:11px;color:var(--muted);}
.meq-health-body{display:flex;gap:24px;align-items:flex-start;}
.meq-score-wrap{display:flex;flex-direction:column;align-items:center;gap:6px;flex-shrink:0;width:96px;}
.meq-score-label{font-size:11px;font-weight:700;text-align:center;}
.meq-score-sub{font-size:10px;color:var(--muted);text-align:center;}
.meq-checks{display:grid;grid-template-columns:1fr 1fr;flex:1;gap:0 16px;}
.meq-check{display:flex;gap:9px;padding:8px 0;border-bottom:1px solid var(--border);}
.meq-check:nth-last-child(-n+2){border-bottom:none;}
.meq-check-icon{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;font-size:10px;font-weight:700;}
.meq-check-name{font-size:11.5px;font-weight:600;color:var(--text);line-height:1.3;}
.meq-check-sub{font-size:10.5px;color:var(--muted);margin-top:1px;line-height:1.3;}
.meq-two-col{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;}
@media(max-width:700px){.meq-two-col{grid-template-columns:1fr;}.meq-health-body{flex-direction:column;}.meq-checks{grid-template-columns:1fr;}}
.meq-data-grid{display:grid;grid-template-columns:1fr 1fr;}
.meq-data-cell{padding:9px 0;border-bottom:1px solid var(--border);}
.meq-data-cell:nth-last-child(-n+2){border-bottom:none;}
.meq-data-cell:nth-child(odd){padding-right:14px;}
.meq-data-cell:nth-child(even){padding-left:14px;border-left:1px solid var(--border);}
.meq-data-lbl{font-size:9.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;margin-bottom:3px;}
.meq-data-val{font-size:12px;font-weight:700;color:var(--text);word-break:break-word;line-height:1.3;}
.meq-val-nd{color:var(--muted)!important;font-weight:400!important;font-style:italic;}
.meq-bar-row{margin-bottom:13px;}
.meq-bar-row:last-child{margin-bottom:0;}
.meq-bar-meta{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:5px;}
.meq-bar-lbl{font-size:11.5px;color:var(--text);font-weight:600;}
.meq-bar-val{font-size:11px;color:var(--muted);}
.meq-bar-track{height:6px;background:var(--border);border-radius:4px;overflow:hidden;}
.meq-bar-fill{height:100%;border-radius:4px;}
.meq-intune-info{display:flex;align-items:flex-start;gap:8px;margin-top:14px;padding:10px 12px;background:rgba(124,58,237,.07);border:1px solid rgba(124,58,237,.15);border-radius:8px;font-size:11px;color:#a78bfa;line-height:1.4;}
.meq-actions{display:flex;gap:10px;margin-bottom:6px;flex-wrap:wrap;}
.meq-btn-primary{background:#0d9488;color:#fff;border:none;border-radius:10px;padding:9px 18px;font-size:12.5px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:7px;font-family:inherit;transition:background .15s;}
.meq-btn-primary:hover{background:#0f766e;}
.meq-btn-outline{background:transparent;border:1px solid var(--border);border-radius:10px;padding:9px 18px;font-size:12.5px;font-weight:700;color:var(--text);cursor:pointer;display:inline-flex;align-items:center;gap:7px;font-family:inherit;transition:background .15s;}
.meq-btn-outline:hover{background:var(--border);}
.meq-acts-note{font-size:11px;color:var(--muted);margin-bottom:12px;}
.meq-apps-head{display:flex;justify-content:space-between;align-items:center;padding:14px 20px;border-bottom:1px solid var(--border);}
.meq-app-row{display:flex;align-items:center;gap:13px;padding:11px 20px;border-bottom:1px solid var(--border);}
.meq-app-ico{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:800;color:#fff;flex-shrink:0;}
.meq-app-name{font-size:12.5px;font-weight:700;color:var(--text);}
.meq-app-pub{font-size:10.5px;color:var(--muted);}
.meq-app-right{margin-left:auto;display:flex;align-items:center;gap:12px;}
.meq-app-ver{font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums;}
.meq-app-size{font-size:11px;color:var(--muted);min-width:48px;text-align:right;}
.meq-app-upd{font-size:10px;font-weight:700;padding:2px 9px;border-radius:12px;background:#f97316;color:#fff;}
.meq-others{display:flex;flex-direction:column;gap:8px;margin-top:12px;}
.meq-other-row{display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--card);border:1px solid var(--border);border-radius:10px;}

/* ══ HOME EXTRA ROW ══════════════════════════════════════════ */
.home-extra{display:grid;grid-template-columns:196px 1fr 1fr;gap:12px;margin-top:16px;align-items:stretch;}
.he-panel{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;display:flex;flex-direction:column;}
.he-head{display:flex;align-items:center;gap:8px;padding:11px 14px;border-bottom:1px solid var(--border);flex-shrink:0;}
.he-head-icon{width:20px;height:20px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:10px;flex-shrink:0;}
.he-head-title{font-size:11.5px;font-weight:700;color:var(--text);}
.he-head-meta{font-size:10px;color:var(--muted);margin-left:auto;}
.he-sq-grid{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:8px;padding:10px;flex:1;}
.he-sq{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;padding:12px 6px;background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:10px;cursor:pointer;transition:background .14s,border-color .14s,transform .14s;text-align:center;}
.he-sq:hover{background:rgba(255,255,255,.06);border-color:var(--border2);transform:translateY(-1px);}
.he-sq-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:16px;}
.he-sq-lbl{font-size:10.5px;font-weight:700;color:var(--text);line-height:1.3;}
.he-kb-row{display:flex;align-items:flex-start;gap:10px;padding:10px 14px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .12s;}
.he-kb-row:last-child{border-bottom:none;}
.he-kb-row:hover{background:rgba(255,255,255,.025);}
.he-kb-dot{width:5px;height:5px;border-radius:50%;flex-shrink:0;margin-top:5px;}
.he-kb-txt{font-size:11.5px;color:var(--muted2);line-height:1.4;flex:1;}
.he-kb-tag{font-size:9px;font-weight:700;padding:2px 7px;border-radius:10px;flex-shrink:0;margin-top:2px;white-space:nowrap;align-self:flex-start;}
.he-hoy-row{display:flex;align-items:flex-start;gap:10px;padding:10px 14px;border-bottom:1px solid var(--border);}
.he-hoy-row:last-child{border-bottom:none;}
.he-hoy-icon{width:26px;height:26px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0;}
.he-hoy-name{font-size:11.5px;font-weight:700;color:var(--text);margin-bottom:2px;}
.he-hoy-sub{font-size:10.5px;color:var(--muted);line-height:1.35;}
.he-hoy-badge{margin-left:auto;font-size:9.5px;font-weight:700;padding:2px 7px;border-radius:10px;white-space:nowrap;flex-shrink:0;align-self:flex-start;margin-top:1px;}
.he-empty{text-align:center;padding:20px;color:var(--muted);font-size:11.5px;flex:1;display:flex;align-items:center;justify-content:center;}
[data-theme="dark"] .he-panel{background:#111827;border-color:#1e293b;}
[data-theme="dark"] .he-sq{background:rgba(255,255,255,.02);}
[data-theme="dark"] .he-sq:hover{background:rgba(255,255,255,.05);}

/* ══ PORTAL HERO ════════════════════════════════════════════ */
.portal-hero{
  background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);
  padding:14px 22px;margin-bottom:14px;box-shadow:var(--sh-sm);
  display:flex;align-items:center;gap:20px;position:relative;overflow:hidden;
}
[data-theme="dark"] .portal-hero{
  background:linear-gradient(135deg,#0c1827 0%,#0f1d33 100%);
  border-color:rgba(59,130,246,.18);
}
.portal-hero::before{
  content:'';position:absolute;right:-80px;top:-80px;width:260px;height:260px;
  border-radius:50%;background:var(--primary-dim);pointer-events:none;
}
.portal-hero::after{
  content:'';position:absolute;right:300px;bottom:-60px;width:160px;height:160px;
  border-radius:50%;background:rgba(124,58,237,.06);pointer-events:none;
}
.hero-main{flex:1;min-width:0;position:relative;z-index:1;}
.hero-eyebrow{
  display:inline-flex;align-items:center;gap:7px;
  font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1.2px;
  color:var(--primary);margin-bottom:10px;
}
.hero-eyebrow-dot{
  width:7px;height:7px;border-radius:50%;background:#22c55e;
  box-shadow:0 0 7px rgba(34,197,94,.6);flex-shrink:0;
  animation:hDotPulse 2.5s ease-in-out infinite;
}
@keyframes hDotPulse{0%,100%{opacity:1}50%{opacity:.5;transform:scale(.85)}}
.hero-eyebrow{margin-bottom:6px!important;}
.hero-title{
  font-size:22px;font-weight:900;letter-spacing:-.8px;color:var(--text);
  line-height:1.1;margin:0 0 4px;
}
.hero-title-name{color:var(--primary);}
.hero-sub{font-size:13px;color:var(--muted);line-height:1.5;margin:0;}
.hero-right{display:flex;align-items:center;gap:12px;position:relative;z-index:1;flex-shrink:0;}
.hero-stats{
  display:flex;gap:0;border:1px solid var(--border);border-radius:var(--radius-lg);
  overflow:hidden;background:var(--bg-subtle);
}
.hero-stat{
  padding:12px 18px;text-align:right;border-right:1px solid var(--border);min-width:90px;
}
.hero-stat:last-child{border-right:none;}
.hero-stat-val{
  font-size:22px;font-weight:900;letter-spacing:-.8px;line-height:1;margin-bottom:4px;
}
.hero-stat-lbl{font-size:10px;font-weight:600;color:var(--muted);white-space:nowrap;}
.hero-exit{
  width:30px;height:30px;border-radius:8px;background:var(--bg-subtle);border:1px solid var(--border);
  color:var(--muted);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:13px;
  flex-shrink:0;transition:all .15s;
}
.hero-exit:hover{color:var(--danger);border-color:rgba(239,68,68,.3);background:rgba(239,68,68,.06);}

/* ══ TEXT PROMO BAR ═════════════════════════════════════════ */
.text-promo-bar{
  display:flex;align-items:center;gap:12px;
  background:linear-gradient(90deg,var(--primary-dim),rgba(124,58,237,.06));
  border:1px solid rgba(37,99,235,.15);border-radius:var(--radius);
  padding:10px 16px;margin-top:20px;cursor:pointer;transition:border-color .2s;
}
.text-promo-bar:hover{border-color:var(--primary);}
.tpb-tag{
  font-size:9px;font-weight:800;letter-spacing:1px;text-transform:uppercase;
  background:var(--primary);color:#fff;padding:3px 9px;border-radius:5px;flex-shrink:0;
}
.tpb-text{font-size:12px;color:var(--muted);flex:1;}
.tpb-cta{font-size:11px;font-weight:700;color:var(--primary);flex-shrink:0;display:flex;align-items:center;gap:4px;}

/* ══ DARK MODE CARD UPGRADES ════════════════════════════════ */
[data-theme="dark"] .qa-card{background:#111827;border-color:#1e293b;}
[data-theme="dark"] .qa-card:hover{background:#141d2f;}
[data-theme="dark"] .stat-chip{background:#111827;border-color:#1e293b;}
[data-theme="dark"] .donut-card,[data-theme="dark"] .feed-card{background:#111827;border-color:#1e293b;}
[data-theme="dark"] .eq-card{background:#111827;border-color:#1e293b;}
[data-theme="dark"] .eq-emp-strip{background:rgba(124,58,237,.08);}
[data-theme="dark"] .eq-footer{background:rgba(255,255,255,.02);}
[data-theme="dark"] .eq-hw-bar{background:#1e293b;}

/* ══ SEGURIDAD Y ACCESOS ════════════════════════════════════ */
.seg-header{
  background:linear-gradient(135deg,#0c1a2e 0%,#0f2241 100%);
  border:1px solid rgba(37,99,235,.2);border-radius:var(--radius-xl);
  padding:22px 28px;margin-bottom:20px;
  display:flex;align-items:center;gap:20px;position:relative;overflow:hidden;
}
[data-theme="light"] .seg-header{
  background:linear-gradient(135deg,#eff6ff 0%,#e0f2fe 100%);
  border-color:rgba(37,99,235,.2);
}
.seg-header::before{
  content:'';position:absolute;right:-60px;top:-60px;width:200px;height:200px;
  border-radius:50%;background:rgba(37,99,235,.08);pointer-events:none;
}
.seg-av{
  width:52px;height:52px;border-radius:14px;
  background:linear-gradient(135deg,var(--primary),var(--purple));
  color:#fff;display:flex;align-items:center;justify-content:center;
  font-size:20px;font-weight:800;flex-shrink:0;position:relative;z-index:1;
}
.seg-hinfo{flex:1;position:relative;z-index:1;}
.seg-heyebrow{font-size:10px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:rgba(99,179,237,.85);margin-bottom:6px;}
[data-theme="light"] .seg-heyebrow{color:var(--primary);}
.seg-hname{font-size:20px;font-weight:900;color:#f1f5f9;line-height:1.2;}
[data-theme="light"] .seg-hname{color:var(--text);}
.seg-hmeta{font-size:12px;color:rgba(148,163,184,.8);margin-top:3px;}
[data-theme="light"] .seg-hmeta{color:var(--muted);}
.seg-hbadges{display:flex;flex-direction:column;gap:6px;align-items:flex-end;position:relative;z-index:1;}
.seg-hbadge{display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;}
.seg-hb-ok{background:rgba(34,197,94,.15);color:#4ade80;border:1px solid rgba(34,197,94,.3);}
[data-theme="light"] .seg-hb-ok{background:rgba(34,197,94,.1);color:#16a34a;}
.seg-hb-role{background:rgba(59,130,246,.15);color:#93c5fd;border:1px solid rgba(59,130,246,.25);}
[data-theme="light"] .seg-hb-role{background:var(--primary-dim);color:var(--primary);}
.seg-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
@media(max-width:720px){.seg-grid{grid-template-columns:1fr;}}
.seg-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px;box-shadow:var(--sh-xs);}
[data-theme="dark"] .seg-card{background:#111827;border-color:#1e293b;}
.seg-card-t{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--muted);margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;}
.seg-badge-req{font-size:9px;font-weight:700;padding:2px 8px;border-radius:10px;background:rgba(100,116,139,.12);color:var(--muted);}
.seg-row{display:flex;align-items:flex-start;gap:12px;padding:8px 0;border-bottom:1px solid var(--border);}
.seg-row:last-child{border-bottom:none;}
.seg-rl{color:var(--muted);font-weight:600;font-size:10px;text-transform:uppercase;letter-spacing:.4px;min-width:128px;flex-shrink:0;padding-top:2px;}
.seg-rv{color:var(--text);font-weight:700;font-size:12px;}
.seg-pill{display:inline-flex;align-items:center;gap:4px;padding:2px 9px;border-radius:20px;font-size:10.5px;font-weight:700;}
.seg-p-ok{background:rgba(34,197,94,.1);color:#16a34a;}
[data-theme="dark"] .seg-p-ok{background:rgba(34,197,94,.15);color:#4ade80;}
.seg-p-warn{background:rgba(249,115,22,.1);color:#f97316;}
.seg-p-err{background:rgba(239,68,68,.1);color:#ef4444;}
.seg-integration{text-align:center;padding:28px 16px;}
.seg-int-icon{font-size:28px;color:var(--muted);margin-bottom:8px;opacity:.4;}
.seg-int-lbl{font-size:12px;color:var(--muted);font-weight:500;line-height:1.5;}
/* sesiones + licencias */
.seg-session-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);}
.seg-session-row:last-child{border-bottom:none;}
.seg-session-ico{width:32px;height:32px;border-radius:8px;background:var(--bg-subtle);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--muted);flex-shrink:0;}
.seg-session-dev{font-size:12px;font-weight:700;color:var(--text);}
.seg-session-det{font-size:10.5px;color:var(--muted);margin-top:1px;}
.seg-session-right{margin-left:auto;text-align:right;flex-shrink:0;}
.seg-session-time{font-size:10.5px;color:var(--muted);margin-bottom:3px;}
.seg-sst-ok{font-size:10px;font-weight:700;padding:2px 9px;border-radius:10px;background:rgba(16,185,129,.1);color:#10b981;}
.seg-sst-block{font-size:10px;font-weight:700;padding:2px 9px;border-radius:10px;background:rgba(239,68,68,.1);color:#ef4444;}
.seg-lic-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);}
.seg-lic-row:last-child{border-bottom:none;}
.seg-lic-ico{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;color:#fff;flex-shrink:0;}
.seg-lic-name{font-size:12px;font-weight:700;color:var(--text);}
.seg-lic-desc{font-size:10.5px;color:var(--muted);margin-top:1px;}
.seg-lic-badge{margin-left:auto;font-size:10px;font-weight:700;padding:2px 9px;border-radius:10px;white-space:nowrap;flex-shrink:0;}
.seg-lic-ok{background:rgba(16,185,129,.1);color:#10b981;}
.seg-lic-warn{background:rgba(249,115,22,.1);color:#f97316;}
.seg-nd-note{display:flex;align-items:flex-start;gap:8px;margin-top:14px;padding:9px 12px;background:rgba(100,116,139,.06);border:1px solid var(--border);border-radius:8px;font-size:11px;color:var(--muted);line-height:1.4;}
.seg-card-flex{display:flex;flex-direction:column;}
.seg-card-list{flex:1;overflow-y:auto;max-height:220px;}
.seg-card-list::-webkit-scrollbar{width:4px;}.seg-card-list::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:2px;}
.seg-card-placeholder{flex:1;display:flex;align-items:center;justify-content:center;flex-direction:column;}

@media(max-width:768px){
  /* Sidebar: fixed en mobile para estar en el root stacking context */
  .sidebar{
    position:fixed;
    top:var(--navbar-h);
    left:0;
    height:calc(100vh - var(--navbar-h));
    width:var(--sidebar-w)!important;
    z-index:300;
    transform:translateX(-100%);
    transition:transform .25s cubic-bezier(.4,0,.2,1);
    box-shadow:none;
  }
  .sidebar.mobile-open{
    transform:translateX(0);
    box-shadow:4px 0 24px rgba(0,0,0,.18);
  }
  .sidebar.collapsed{transform:translateX(-100%);}

  /* Navbar mobile: ocultar búsqueda y texto largo */
  .nav-search{display:none;}
  .nav-username{display:none;}
  .nav-badge{display:none;}
  .nav-name{display:none;}
  .nav-divider{display:none;}
  .nav-exit span{display:none;}
  .nav-exit{padding:5px 8px;}

  /* Content */
  .content-header{padding:10px 14px;}
  .content-body{padding:14px 12px 60px;}
  .ch-title{font-size:13px;}

  /* Quick actions en columna en pantallas muy pequeñas */
  .qa-grid{grid-template-columns:1fr;}

  /* Welcome bar más compacta */
  .cat-welcome-bar{padding:10px 14px;}
  .cat-welcome-bar .cwb-name{font-size:13px;}
  /* En móvil: mostrar solo el icono, ocultar el texto del botón */
  .cat-welcome-bar .cwb-action{padding:6px 8px !important;border-radius:50% !important;}
  .cat-welcome-bar .cwb-act-lbl{display:none;}
}
</style>
</head>
<body>

<%
  const _user      = locals.user || null;
  const _nameParts = (_user?.full_name || _user?.nombre || _user?.email || 'Usuario').split(' ').filter(Boolean);
  const _rawFirst  = _nameParts[0] || 'Usuario';
  const _firstName = _rawFirst.charAt(0).toUpperCase() + _rawFirst.slice(1).toLowerCase();
  const _initials  = _nameParts.length >= 2
    ? (_nameParts[0][0] + _nameParts[1][0]).toUpperCase()
    : (_nameParts[0] || 'US').substring(0,2).toUpperCase();
  const _isPriv    = _user && ['administrador','especialista','agente','tecnico'].includes(_user.role);
  const _email     = _user?.email || _user?.username || '';
  const _cip       = _user?.employee_cip || null;
  const _roleLabel = { administrador:'Administrador', agente:'Agente', tecnico:'Técnico', especialista:'Especialista', usuario:'Usuario' }[_user?.role] || (_user?.role || 'Usuario');
  const _fullName  = (_user?.full_name || _user?.nombre || _firstName);
  const _tenantDom = locals.tenantDomain || '';
%>

<!-- ══ NAVBAR ═════════════════════════════════════════════════ -->
<nav class="navbar">
  <button class="nav-hamburger" id="sbToggleBtn" onclick="toggleSidebar()" title="Menú">
    <i class="bi bi-layout-sidebar"></i>
  </button>
  <div class="nav-brand">
    <img src="/images/movistar-logo.png" alt="Logo" class="nav-logo" onerror="this.style.display='none'">
    <div class="nav-divider"></div>
    <span class="nav-name">IT Platform</span>
    <span class="nav-badge">ITSM</span>
  </div>
  <div class="nav-space"></div>
  <div class="nav-search">
    <i class="bi bi-search nav-search-icon"></i>
    <input type="text" class="nav-search-input" id="globalSearch"
      placeholder="Buscar servicio, artículo..." autocomplete="off"
      oninput="_filterCards(this.value)">
  </div>
  <div class="nav-sep"></div>
  <div class="nav-user" id="navUserBtn" onclick="toggleUserMenu(event)">
    <div class="nav-avatar" id="navAvatar"><%= _initials %></div>
    <span class="nav-username" id="navUsername"><%= _firstName %></span>
    <i class="bi bi-chevron-down" id="navUserChev" style="font-size:9px;color:var(--muted);transition:transform .2s;"></i>
    <!-- Dropdown -->
    <div class="nav-user-dd" id="navUserDd" onclick="event.stopPropagation()">
      <div class="nu-header">
        <div class="nu-av-lg" id="nuAvLg"><%= _initials %></div>
        <div class="nu-name" id="nuName"><%= _fullName %></div>
        <div class="nu-role" id="nuRole"><%= _roleLabel %></div>
      </div>
      <div class="nu-body">
        <div class="nu-row">
          <div class="nu-row-icon" style="background:rgba(99,102,241,.1);color:var(--primary);"><i class="bi bi-envelope-fill"></i></div>
          <div><div class="nu-row-label">Correo</div><div class="nu-row-val" id="nuEmailVal"><%= _email || '—' %></div></div>
        </div>
        <% if (_cip) { %>
        <div class="nu-row">
          <div class="nu-row-icon" style="background:rgba(217,119,6,.1);color:#d97706;"><i class="bi bi-person-badge-fill"></i></div>
          <div><div class="nu-row-label">CIP / Legajo</div><div class="nu-row-val"><%= _cip %></div></div>
        </div>
        <% } %>
        <% if (_tenantDom) { %>
        <div class="nu-row">
          <div class="nu-row-icon" style="background:rgba(5,150,105,.1);color:#059669;"><i class="bi bi-building-fill"></i></div>
          <div><div class="nu-row-label">Organización</div><div class="nu-row-val"><%= _tenantDom %></div></div>
        </div>
        <% } %>
      </div>
      <div class="nu-footer">
        <% if (_isPriv) { %>
        <button class="nu-btn" onclick="window.location.href='/administracion'"><i class="bi bi-shield-lock-fill" style="color:var(--purple);"></i> Admin</button>
        <% } %>
        <button class="nu-btn nu-btn-danger" onclick="window.location.href='/api/auth/logout'"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
      </div>
    </div>
  </div>
</nav>

<div id="toastWrap"></div>

<!-- ══ APP SHELL ══════════════════════════════════════════════ -->
<div class="app-shell">

  <!-- Overlay inside app-shell so sidebar z-index:300 beats overlay z-index:299 -->
  <div class="sb-overlay" id="sbOverlay" onclick="closeSidebarMobile()"></div>

  <!-- ══ SIDEBAR ══════════════════════════════════════════════ -->
  <aside class="sidebar" id="sidebar">

    <nav class="sb-nav" style="padding-top:10px;">

      <!-- Inicio -->
      <button class="sb-item active" id="sb-inicio" onclick="sbNav('inicio',this)">
        <i class="bi bi-house-fill sb-icon" style="color:#2563eb;"></i>
        <span class="sb-label">Inicio</span>
      </button>

      <!-- MI EQUIPO -->
      <button class="sb-item" id="sb-equipo" onclick="sbNav('equipo',this)">
        <i class="bi bi-laptop-fill sb-icon" style="color:#0891b2;"></i>
        <span class="sb-label">Mi Equipo</span>
      </button>

      <!-- SEGURIDAD Y ACCESOS -->
      <button class="sb-item" id="sb-seguridad" onclick="sbNav('seguridad',this)">
        <i class="bi bi-shield-fill-check sb-icon" style="color:#7c3aed;"></i>
        <span class="sb-label">Accesos</span>
      </button>

      <!-- SERVICIOS -->
      <div class="sb-section">
        <span class="sb-section-label">Servicios</span>
        <button class="sb-item" id="sb-incidencias" onclick="sbNav('incidencias',this)">
          <i class="bi bi-exclamation-triangle-fill sb-icon" style="color:#dc2626;"></i>
          <span class="sb-label">Incidencias</span>
        </button>
        <button class="sb-item" id="sb-requerimientos" onclick="sbNav('requerimientos',this)">
          <i class="bi bi-clipboard2-plus-fill sb-icon" style="color:#7c3aed;"></i>
          <span class="sb-label">Requerimientos</span>
        </button>
        <button class="sb-item" id="sb-tickets" onclick="sbNav('tickets',this)">
          <i class="bi bi-ticket-detailed-fill sb-icon" style="color:#0891b2;"></i>
          <span class="sb-label">Mis Tickets</span>
          <span class="sb-badge" id="sbTicketBadge"></span>
        </button>
        <button class="sb-item" id="sb-consultas" onclick="sbNav('consultas',this)">
          <i class="bi bi-chat-dots-fill sb-icon" style="color:#0f766e;"></i>
          <span class="sb-label">Mis Consultas</span>
          <span class="sb-badge" id="sbConsultasBadge"></span>
        </button>
      </div>

      <!-- HERRAMIENTAS -->
      <div class="sb-section">
        <span class="sb-section-label">Herramientas</span>
        <button class="sb-item" id="sb-impresion" onclick="sbNav('impresion',this)">
          <i class="bi bi-printer-fill sb-icon" style="color:#64748b;"></i>
          <span class="sb-label">Cola de Impresión</span>
        </button>

        <!-- Herramientas TI — colapsable -->
        <button class="sb-item" id="sb-herramientas" onclick="sbExpandHer(this)">
          <i class="bi bi-tools sb-icon" style="color:#059669;"></i>
          <span class="sb-label">Herramientas TI</span>
          <i class="bi bi-chevron-down sb-expand-icon"></i>
        </button>
        <div class="sb-sub-menu" id="sbHerMenu">
          <button class="sb-sub-item" onclick="sbNavTool(8,'Reportes',this)">
            <i class="bi bi-bar-chart-steps sb-sub-icon" style="color:#2563eb;"></i><span class="sb-label">Reportes</span>
          </button>
          <button class="sb-sub-item" onclick="sbNavTool(13,'Anotador',this)">
            <i class="bi bi-pencil-square sb-sub-icon" style="color:#7c3aed;"></i><span class="sb-label">Anotador</span>
          </button>
