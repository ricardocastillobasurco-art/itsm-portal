.dev-equip-card:hover,.dev-equip-card.sel{border-color:#ec4899;background:rgba(236,72,153,.05);}
.dev-equip-icon{width:38px;height:38px;border-radius:10px;background:rgba(236,72,153,.1);color:#ec4899;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
.dev-equip-name{font-size:13px;font-weight:700;color:var(--text);}
.dev-equip-sub{font-size:11px;color:var(--muted);}
.dev-check-item{display:flex;align-items:center;gap:12px;padding:14px;border:2px solid var(--border);border-radius:12px;cursor:pointer;margin-bottom:10px;transition:all .2s;user-select:none;}
.dev-check-item:hover{border-color:#ec4899;background:rgba(236,72,153,.03);}
