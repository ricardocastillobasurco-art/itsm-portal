.dev-step-circle.done{background:#fff;color:#be185d;border-color:#fff;}
.dev-step-circle.active{background:#fff;color:#be185d;border-color:#fff;box-shadow:0 0 0 4px rgba(255,255,255,.3);}
.dev-step-label{font-size:9px;font-weight:700;color:rgba(255,255,255,.8);white-space:nowrap;text-align:center;}
