                <span class="he-sq-lbl">Cambiar contraseña</span>
              </div>
              <div class="he-sq" onclick="openPageModal('/requerimientos?embed=1&tenant=<%- user?.tenant_id||1 %>',{wide:true})">
                <div class="he-sq-icon" style="background:rgba(5,150,105,.12);color:#34d399;"><i class="bi bi-person-check-fill"></i></div>
                <span class="he-sq-lbl">Desbloquear cuenta</span>
