    'Entidad: '+(a.legal_entity||'—'),'Email: '+(a.emp_email||'—'),
    'Fecha asig.: '+aDate,'Score: '+score+'/100 ('+scoreLabel+')',
  ].join('\n');
  /* otros equipos */
  const othersHtml=assets.slice(1).map(b=>{
    const bt=(b.equipment_type||'').toLowerCase();
