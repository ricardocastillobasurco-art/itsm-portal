      +'<div style="font-size:10.5px;color:var(--muted);">'+(b.device_code||'—')+' · '+(b.equipment_type||'—')+'</div></div>'
      +'<div style="margin-left:auto;font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;background:rgba(13,148,136,.12);color:#0d9488;">'+(b.assign_status||b.status||'—')+'</div>'
      +'</div>';
  }).join('');
  /* alerta por campos incompletos */
  const warnChecks=checks.filter(c=>!c.ok);
  const alertHtml=warnChecks.length>0
    ?'<div class="meq-alert"><i class="bi bi-exclamation-triangle-fill" style="font-size:15px;color:#f97316;flex-shrink:0;margin-top:2px;"></i>'
