/* ── Home stats + donut + activity feed ── */
function _loadHomeStats(list){
  const buckets={};
  let urgent=0, inprog=0, resolved=0, active=0;
  list.forEach(t=>{
    const st=(t.status||t.jiraStatus||'').toLowerCase();
    const pr=(t.priority||'').toLowerCase();
    if(pr==='p1'||pr==='critica'||pr==='critical') urgent++;
    const label=st.includes('resuelto')||st.includes('resolved')||st.includes('cerrado')||st.includes('closed')?'Resuelto':
                st.includes('progreso')||st.includes('progress')||st.includes('curso')?'En progreso':
                st.includes('pendiente')||st.includes('pending')?'Pendiente':'Abierto';
    if(label==='En progreso'){ inprog++; active++; }
    else if(label==='Resuelto') resolved++;
    else active++;
    buckets[label]=(buckets[label]||0)+1;
  });
  const total=list.length;
  const el=id=>document.getElementById(id);
  if(el('hs-total')) el('hs-total').textContent=active;
  if(el('hs-urgent')) el('hs-urgent').textContent=urgent;
  if(el('hs-inprogress')) el('hs-inprogress').textContent=inprog;
  if(el('hs-resolved')) el('hs-resolved').textContent=resolved;
  if(el('homeStatsRow')) el('homeStatsRow').style.display='';
  /* hero stats */
  if(el('heroStatTickets')) el('heroStatTickets').textContent=active;
  if(el('heroStatUrgent')) el('heroStatUrgent').textContent=urgent;
  if(el('heroStatResolved')) el('heroStatResolved').textContent=resolved;
  if(el('heroStats')&&total) el('heroStats').style.display='';
  if(active&&el('catWelcomeSub')) el('catWelcomeSub').textContent=`Tienes ${active} ticket${active!==1?'s':''} activo${active!==1?'s':''}${urgent?' · '+urgent+' urgente'+(urgent!==1?'s':''):''}. Usa el panel para gestionarlos.`;

  const COLORS={Abierto:'#0891b2','En progreso':'#7c3aed',Pendiente:'#d97706',Resuelto:'#059669'};
  const keys=Object.keys(buckets);
  const vals=keys.map(k=>buckets[k]);
  if(total){
    _drawDonut('donutSvg',vals,keys.map(k=>COLORS[k]||'#94a3b8'));
    if(el('donutTotal')) el('donutTotal').textContent=total;
    if(el('donutLegend')) el('donutLegend').innerHTML=keys.map(k=>`
      <div class="dl-item">
        <span class="dl-dot" style="background:${COLORS[k]||'#94a3b8'};"></span>
        <span class="dl-label">${k}</span>
        <span class="dl-val">${buckets[k]}</span>
      </div>`).join('');
    if(el('homeDataRow')) el('homeDataRow').style.display='';
  }

  const feed=el('homeFeedList');
  if(feed){
    if(!list.length){
      feed.innerHTML='<div style="text-align:center;padding:24px;color:var(--muted);font-size:12px;">Sin actividad reciente</div>';
    } else {
      const prDot=p=>{const pl=(p||'').toLowerCase();return pl==='p1'||pl==='critica'?'#ef4444':pl==='p2'||pl==='alta'?'#f97316':'#f59e0b';};
      const stBadge=s=>{const sl=s.toLowerCase();
        if(sl.includes('resuelto')||sl.includes('closed')) return 'background:#d1fae5;color:#059669;';
        if(sl.includes('progreso')||sl.includes('progress')) return 'background:#ede9fe;color:#7c3aed;';
        if(sl.includes('pendiente')) return 'background:#fef3c7;color:#92400e;';
        return 'background:#dbeafe;color:#2563eb;';};
      feed.innerHTML=list.slice(0,6).map(t=>`
        <div class="feed-item" onclick="typeof openMisTicketsModal==='function'&&openMisTicketsModal()" style="cursor:pointer;">
          <span class="feed-dot" style="background:${prDot(t.priority)};"></span>
          <span class="feed-key">${t.key||t.id||'—'}</span>
          <span class="feed-sum">${(t.summary||t.titulo||t.title||'—').substring(0,52)}</span>
          <span class="feed-status" style="${stBadge(t.status||t.jiraStatus||'')}">${t.status||t.jiraStatus||'Abierto'}</span>
        </div>`).join('');
    }
  }
}

function _drawDonut(svgId,values,colors){
  const svg=document.getElementById(svgId);
  if(!svg||!values.length) return;
  const total=values.reduce((a,b)=>a+b,0);
  if(!total) return;
  const r=47,cx=60,cy=60,sw=16;
  let a=-Math.PI/2,paths='';
  values.forEach((v,i)=>{
    const angle=(v/total)*2*Math.PI;
    const end=a+angle-0.01;
    const x1=cx+r*Math.cos(a),y1=cy+r*Math.sin(a);
    const x2=cx+r*Math.cos(end),y2=cy+r*Math.sin(end);
    const large=angle>Math.PI?1:0;
    paths+=`<path d="M${x1.toFixed(2)},${y1.toFixed(2)} A${r},${r} 0 ${large},1 ${x2.toFixed(2)},${y2.toFixed(2)}" fill="none" stroke="${colors[i]||'#94a3b8'}" stroke-width="${sw}" stroke-linecap="butt"/>`;
    a+=angle;
  });
  svg.innerHTML=paths;
}

/* ── Mi Equipo ── */
async function _loadEquipo(){
  const el=document.getElementById('miEquipoContent');
  if(!el||el.dataset.loaded) return;
  el.dataset.loaded='1';
  try{
    const r=await fetch('/api/chatbot/my-assets',{credentials:'include'});
    const d=await r.json();
    const assets=Array.isArray(d)?d:(d.data||d.assets||[]);
    if(!assets.length){
      el.innerHTML=`<div class="eq-empty"><div class="eq-empty-icon"><i class="bi bi-laptop" style="color:var(--muted);"></i></div><div style="font-size:14px;font-weight:600;color:var(--text);margin-bottom:6px;">Sin equipos asignados</div><div style="font-size:12px;">No tienes equipos activos asignados en el sistema.</div></div>`;
      return;
    }
    el.innerHTML=_renderEquipoDashboard(assets);
  }catch(e){
    el.innerHTML=`<div class="eq-empty"><div class="eq-empty-icon" style="font-size:32px;">⚠️</div><div style="font-size:13px;color:var(--danger);">Error al cargar: ${e.message}</div></div>`;
  }
}

function _renderEquipoDashboard(assets){
  if(!assets.length) return '<div class="eq-empty"><div class="eq-empty-icon"><i class="bi bi-laptop" style="color:var(--muted);"></i></div><div style="font-size:14px;font-weight:600;color:var(--text);margin-bottom:6px;">Sin equipos asignados</div><div style="font-size:12px;">No tienes equipos activos asignados en el sistema.</div></div>';
  const a=assets[0];
  const _pg=s=>{const m=(s||'').match(/(\d+(?:[.,]\d+)?)/);return m?parseFloat(m[1].replace(',','.')):0;};
  const empName=a.emp_name||'—';
  const initials=empName.split(/\s+/).filter(Boolean).slice(0,2).map(w=>w[0].toUpperCase()).join('')||'?';
  const empMeta=[a.position_name,a.legal_entity,a.branch_office_id].filter(Boolean).join(' · ');
  const aDate=a.assignment_date?new Date(a.assignment_date).toLocaleDateString('es-PE',{day:'2-digit',month:'short',year:'numeric'}):'—';
  const warr=parseInt(a.warranty_months)||0;
  const ram=_pg(a.ram_memory);
  const disk=_pg(a.disk_capacity);
  const et=(a.equipment_type||'').toLowerCase();
  const devIcon=et.includes('laptop')||et.includes('notebook')?'bi-laptop':et.includes('desktop')?'bi-pc-display':et.includes('tablet')?'bi-tablet-fill':'bi-hdd-rack-fill';
  /* health checks (9 ítems desde BD) */
  const checks=[
    {n:'Sistema operativo', s:a.operating_system||'No registrado',      ok:!!a.operating_system},
    {n:'Procesador',        s:a.processor||'No registrado',              ok:!!a.processor},
    {n:'Memoria RAM',       s:a.ram_memory||'No registrado',             ok:!!a.ram_memory},
    {n:'Almacenamiento',    s:a.disk_capacity||'No registrado',          ok:!!a.disk_capacity},
    {n:'Estado del equipo', s:a.status||'—',                            ok:(a.status||'').toLowerCase()==='activo'||(a.assign_status||'').toLowerCase()==='activo'},
    {n:'N° de serie',       s:a.serial_number||'No registrado',         ok:!!a.serial_number},
    {n:'Dominio / Tenant',  s:a.domain||a.legal_entity||'No registrado',ok:!!(a.domain||a.legal_entity)},
    {n:'Tipo de adquisición',s:a.acquisition_type||'No registrado',     ok:!!a.acquisition_type},
    {n:'Garantía',          s:warr?warr+' meses':'No registrada',       ok:warr>0},
  ];
  const okCnt=checks.filter(c=>c.ok).length;
  const score=Math.round(okCnt/checks.length*100);
  const scoreColor=score>=70?'#0d9488':score>=45?'#f97316':'#ef4444';
  const scoreLabel=score>=70?'Bueno':score>=45?'Regular':'Crítico';
  /* SVG ring */
  const R=38,CX=45,CY=45,SW=7,CIRC=2*Math.PI*R,filled=(score/100)*CIRC;
  const ring='<svg width="90" height="90" viewBox="0 0 90 90" style="transform:rotate(-90deg);display:block;">'
    +'<circle cx="'+CX+'" cy="'+CY+'" r="'+R+'" fill="none" stroke="rgba(148,163,184,.1)" stroke-width="'+SW+'"/>'
    +'<circle cx="'+CX+'" cy="'+CY+'" r="'+R+'" fill="none" stroke="'+scoreColor+'" stroke-width="'+SW+'" stroke-dasharray="'+filled.toFixed(1)+' '+CIRC.toFixed(1)+'" stroke-linecap="round"/>'
    +'</svg>';
  /* check icon */
  const cIcon=ok=>'<div class="meq-check-icon" style="background:'+(ok?'rgba(13,148,136,.14)':'rgba(100,116,139,.1)')
    +';color:'+(ok?'#0d9488':'#94a3b8')+';">'+(ok?'✓':'—')+'</div>';
  /* summary global para clipboard */
  window._meqSummary=[
    'RESUMEN TÉCNICO','================',
    'Equipo: '+(a.brand||'')+' '+(a.model||''),
    'Tipo: '+(a.equipment_type||'—'),'Código: '+(a.device_code||'—'),
