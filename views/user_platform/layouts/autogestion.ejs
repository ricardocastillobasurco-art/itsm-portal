        +'<div class="meq-score-wrap">'
          +'<div style="position:relative;width:90px;height:90px;">'+ring
            +'<div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;">'
              +'<div style="font-size:22px;font-weight:800;color:'+scoreColor+';line-height:1;">'+score+'</div>'
