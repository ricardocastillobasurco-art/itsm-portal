    kbEl.innerHTML=list.map(a=>`<div class="he-kb-row" onclick="sbNav('kb',${sbKb?'document.getElementById(\'sb-kb\')':'null'})">
      <div class="he-kb-dot" style="background:${a.c};"></div>
      <span class="he-kb-txt">${a.t}</span>
      <span class="he-kb-tag" style="background:${a.bg};color:${a.c};">${a.cat||a.tag}</span>
    </div>`).join('');
  }
  const hoyEl=document.getElementById('heHoyList');
  if(hoyEl){
    try{
      const d=await fetch('/api/portal/announcements?limit=3',{credentials:'include'}).then(r=>r.ok?r.json():{});
      const list=(d.data||[]).slice(0,3);
      if(list.length){
        hoyEl.innerHTML=list.map(a=>`<div class="he-hoy-row">
          <div class="he-hoy-icon" style="background:rgba(8,145,178,.1);color:#0891b2;"><i class="bi bi-megaphone-fill"></i></div>
          <div>
            <div class="he-hoy-name">${a.title||a.text||'Aviso'}</div>
            ${(a.body||a.description)?`<div class="he-hoy-sub">${(a.body||a.description).substring(0,70)}</div>`:''}
          </div>
          <span class="he-hoy-badge" style="background:rgba(8,145,178,.1);color:#0891b2;">Aviso</span>
        </div>`).join('');
      } else throw 0;
    }catch{
      hoyEl.innerHTML='<div class="he-empty">Sin avisos activos</div>';
    }
  }
}

/* ── Init ── */
_loadActivity();
_loadAnn();
_loadHomeExtra();

})();
</script>

<script>
/* ── Mis Consultas — modal ── */
window.openConsultasModal = function(){
  const m = document.getElementById('consultModal');
  if(!m) return;
  m.classList.add('show');
  document.body.style.overflow = 'hidden';
  loadConsultHist(1);
};
window.closeConsultasModal = function(){
  const m = document.getElementById('consultModal');
  if(m) m.classList.remove('show');
  document.body.style.overflow = '';
  const detail = document.getElementById('consultHistDetail');
  if(detail) detail.style.display = 'none';
};
document.addEventListener('keydown', function(e){
  if(e.key === 'Escape') closeConsultasModal();
});

/* ── Mis Consultas — historial de conversaciones ────────────────────────────── */
(function(){
  let _consultData = [];
  let _consultPage = 1;
  let _consultMeta = {};

  const _statusMap = {
    waiting:   { label:'En espera',    color:'#0891b2', bg:'rgba(8,145,178,.1)' },
    active:    { label:'En atención',  color:'#059669', bg:'rgba(5,150,105,.1)' },
    resolved:  { label:'Resuelta',     color:'#64748b', bg:'rgba(100,116,139,.1)' },
    converted: { label:'Ticket creado',color:'#7c3aed', bg:'rgba(124,58,237,.1)' },
  };

  function _timeAgo(ts) {
    if (!ts) return '—';
    const d = Math.floor((Date.now() - new Date(ts).getTime()) / 1000);
    if (d < 60)   return 'Hace un momento';
    if (d < 3600) return 'Hace ' + Math.floor(d/60) + ' min';
    if (d < 86400)return 'Hace ' + Math.floor(d/3600) + ' h';
    return new Date(ts).toLocaleDateString('es-PE', {day:'2-digit',month:'short',year:'numeric'});
  }

  function _renderList(list) {
    const el = document.getElementById('consultHistList');
    if (!el) return;
    if (!list.length) {
      el.innerHTML = `
        <div style="text-align:center;padding:56px 20px;color:var(--text-3);">
          <div style="font-size:40px;margin-bottom:12px;">💬</div>
          <div style="font-size:14px;font-weight:600;margin-bottom:6px;">Sin consultas registradas</div>
          <div style="font-size:12px;opacity:.7;">Tus conversaciones con especialistas aparecerán aquí</div>
        </div>`;
      return;
    }
    el.innerHTML = list.map(c => {
      const st = _statusMap[c.status] || _statusMap.resolved;
      const topic = (c.topic || 'Sin tema').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      const spec  = c.specialist_name ? `<i class="bi bi-headset"></i> ${c.specialist_name.replace(/</g,'&lt;')}` : '<span style="opacity:.5;">Sin especialista</span>';
      const ticket = c.ticket_key ? `<span style="font-family:monospace;font-size:11px;background:rgba(124,58,237,.1);color:#7c3aed;border-radius:6px;padding:2px 7px;">${c.ticket_key}</span>` : '';
      const stars = c.satisfaction_rating ? '⭐'.repeat(c.satisfaction_rating) : '';
      return `
        <div class="consult-hist-card" data-id="${c.id}" style="background:var(--card);border:1.5px solid var(--border);border-radius:14px;padding:16px 18px;margin-bottom:10px;cursor:pointer;transition:border-color .18s,box-shadow .18s;" onclick="loadConsultHistDetail(${c.id},this)" onmouseenter="this.style.borderColor='#0891b2';this.style.boxShadow='0 2px 12px rgba(8,145,178,.12)'" onmouseleave="this.style.borderColor='var(--border)';this.style.boxShadow='none'">
          <div style="display:flex;align-items:flex-start;gap:12px;">
            <div style="width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,#0f766e,#0891b2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <i class="bi bi-chat-dots-fill" style="color:#fff;font-size:15px;"></i>
            </div>
            <div style="flex:1;min-width:0;">
              <div style="font-size:13.5px;font-weight:700;color:var(--text-1);margin-bottom:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${topic}</div>
              <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:11.5px;color:var(--text-2);">
                <span>${spec}</span>
                ${ticket}
                ${stars ? `<span style="font-size:12px;">${stars}</span>` : ''}
              </div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0;">
              <span style="background:${st.bg};color:${st.color};border-radius:20px;padding:2px 10px;font-size:10.5px;font-weight:700;">${st.label}</span>
              <span style="font-size:10.5px;color:var(--text-3);">${_timeAgo(c.created_at)}</span>
            </div>
          </div>
        </div>`;
    }).join('');
  }

  function _renderPager() {
    const el = document.getElementById('consultHistPager');
    if (!el || !_consultMeta.pages || _consultMeta.pages <= 1) { if(el) el.innerHTML=''; return; }
    let html = '';
    for (let p = 1; p <= _consultMeta.pages; p++) {
      const active = p === _consultPage;
      html += `<button onclick="loadConsultHist(${p})" style="width:32px;height:32px;border-radius:8px;border:1.5px solid ${active?'#0891b2':'var(--border)'};background:${active?'#0891b2':'var(--card)'};color:${active?'#fff':'var(--text-2)'};font-size:13px;cursor:pointer;font-weight:${active?'700':'400'};">${p}</button>`;
    }
    el.innerHTML = html;
  }

  window.loadConsultHist = async function(page) {
    page = page || _consultPage;
    _consultPage = page;
    const icon = document.getElementById('consultHistRefreshIcon');
    if (icon) icon.style.animation = 'spin 1s linear infinite';
    const list = document.getElementById('consultHistList');
    if (list) list.innerHTML = `<div style="text-align:center;padding:40px;color:var(--text-3);font-size:13px;display:flex;align-items:center;justify-content:center;gap:8px;"><span class="spinner-border spinner-border-sm text-primary"></span> Cargando…</div>`;
    try {
      const _activeEmail = localStorage.getItem('portal_override_email') || localStorage.getItem('portal_user_email') || '';
      const _emailParam  = _activeEmail ? `&as_email=${encodeURIComponent(_activeEmail)}` : '';
      const r = await fetch(`/api/chatbot/consults/history?page=${page}&limit=8${_emailParam}`, { credentials:'include' });
      const d = await r.json();
      if (!d.success) throw new Error('Error al cargar');
      _consultData = d.data || [];
      _consultMeta = d.meta || {};
      const badge = document.getElementById('sbConsultasBadge');
      if (badge) { badge.textContent = _consultMeta.total || ''; badge.style.display = _consultMeta.total ? '' : 'none'; }
      _renderList(_consultData);
      _renderPager();
    } catch(e) {
      if (list) list.innerHTML = `<div style="text-align:center;padding:40px;color:#ef4444;font-size:13px;"><i class="bi bi-exclamation-triangle"></i> ${e.message}</div>`;
    } finally {
      if (icon) icon.style.animation = '';
    }
  };

  window.filterConsultHist = function(q) {
    const lq = q.toLowerCase();
    _renderList(lq ? _consultData.filter(c =>
      (c.topic||'').toLowerCase().includes(lq) ||
      (c.specialist_name||'').toLowerCase().includes(lq) ||
      (c.ticket_key||'').toLowerCase().includes(lq)
    ) : _consultData);
  };

  window.loadConsultHistDetail = async function(id, card) {
    const detail   = document.getElementById('consultHistDetail');
    const msgs     = document.getElementById('consultHistMessages');
    const titleEl  = document.getElementById('consultHistDetailTitle');
    const subEl    = document.getElementById('consultHistDetailSub');
    if (!detail || !msgs) return;

    // Toggle si ya está abierta la misma
    if (detail.dataset.openId === String(id) && detail.style.display !== 'none') {
      detail.style.display = 'none'; detail.dataset.openId = ''; return;
    }

    detail.dataset.openId = String(id);
    detail.style.display = 'block';
    msgs.innerHTML = `<div style="text-align:center;padding:24px;color:var(--text-3);font-size:12px;display:flex;align-items:center;gap:6px;justify-content:center;"><span class="spinner-border spinner-border-sm"></span> Cargando mensajes…</div>`;

    // Scroll al detalle
    setTimeout(() => detail.scrollIntoView({ behavior:'smooth', block:'nearest' }), 50);

    try {
      const r = await fetch(`/api/chatbot/consult/${id}/messages?since=0`, { credentials:'include' });
      const d = await r.json();
      if (!d.success) throw new Error('Sin acceso');
      const sess = d.session || {};
      if (titleEl) titleEl.textContent = sess.user_name || sess.user_email || 'Conversación';
      if (subEl) {
        const st = _statusMap[sess.status] || _statusMap.resolved;
        subEl.innerHTML = `<span style="background:rgba(255,255,255,.2);border-radius:20px;padding:1px 8px;font-size:10px;">${st.label}</span>${sess.specialist_name ? ' · ' + sess.specialist_name : ''}${sess.ticket_key ? ' · <span style="font-family:monospace;">' + sess.ticket_key + '</span>' : ''}`;
      }
      const messages = d.messages || [];
      if (!messages.length) {
        msgs.innerHTML = '<div style="text-align:center;padding:24px;font-size:12px;color:var(--text-3);">Sin mensajes registrados</div>';
        return;
      }
      msgs.innerHTML = messages.map(m => {
        const safe = (m.message||'').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        const ts   = m.created_at ? new Date(m.created_at).toLocaleTimeString('es-PE',{hour:'2-digit',minute:'2-digit'}) : '';
        if (m.sender_role === 'system') {
          return `<div style="align-self:center;font-size:10.5px;color:var(--text-3);background:rgba(0,0,0,.06);border-radius:20px;padding:3px 12px;font-style:italic;">${safe}</div>`;
        }
        const isSpec = m.sender_role === 'specialist';
        return `<div style="display:flex;flex-direction:column;align-items:${isSpec?'flex-end':'flex-start'};gap:2px;">
          <div style="font-size:10px;color:var(--text-3);padding:0 4px;">${isSpec ? (m.sender_name||'Especialista') : 'Tú'} · ${ts}</div>
          <div style="max-width:82%;padding:9px 13px;border-radius:${isSpec?'14px 14px 2px 14px':'14px 14px 14px 2px'};font-size:12.5px;line-height:1.5;${isSpec?'background:linear-gradient(135deg,#2563eb,#3b82f6);color:#fff;':'background:var(--card);border:1.5px solid var(--border);color:var(--text-1);'}">${safe}</div>
        </div>`;
      }).join('');
      msgs.scrollTop = msgs.scrollHeight;
    } catch(e) {
      msgs.innerHTML = `<div style="text-align:center;padding:24px;color:#ef4444;font-size:12px;"><i class="bi bi-exclamation-triangle"></i> ${e.message}</div>`;
    }
  };
})();
</script>

</body>
</html>