/* ── Columna izquierda: lista de integraciones con indicadores ─────────────── */
function renderConexList() {
  const integrations = FEATURE_CATALOG.filter(f => !!INTEGRATION_SCHEMAS[f.key]);
  document.getElementById('conexList').innerHTML = integrations.map(f => {
    const s        = _conexState[f.key] || {};
    const enabled  = s.enabled  ?? false;
    const cfgOk    = s.configured ?? false;
    const source   = s.source   || 'global';
    const uri      = s.effectiveUri || '—';
    const modules  = s.modules  || [];
    const isActive = _conexActiveKey === f.key;

    return `<div onclick="selectConex('${f.key}')"
      style="padding:10px 12px;border-radius:10px;cursor:pointer;margin-bottom:4px;transition:all .15s;
             background:${isActive ? f.color + '12' : 'transparent'};
             border:1px solid ${isActive ? f.color + '55' : 'transparent'};"
      onmouseover="if('${f.key}'!==_conexActiveKey)this.style.background='var(--bg-subtle)'"
      onmouseout="if('${f.key}'!==_conexActiveKey)this.style.background='transparent'">
      <div style="display:flex;align-items:center;gap:10px;">
        <div style="width:32px;height:32px;border-radius:8px;background:${f.color}1a;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i class="bi ${f.icon}" style="color:${f.color};font-size:14px;"></i>
        </div>
        <div style="flex:1;min-width:0;">
          <div style="font-size:13px;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${INTEGRATION_SCHEMAS[f.key]?.label || f.label}</div>
          <div style="display:flex;align-items:center;gap:4px;margin-top:2px;flex-wrap:wrap;">
            ${enabled
              ? `<span style="font-size:9px;font-weight:700;color:#059669;background:#d1fae5;padding:1px 5px;border-radius:10px;">● ON</span>`
              : `<span style="font-size:9px;font-weight:600;color:var(--muted);background:var(--bg-subtle);padding:1px 5px;border-radius:10px;">○ OFF</span>`}
            ${cfgOk
              ? `<span style="font-size:9px;font-weight:600;color:#0891b2;background:#e0f2fe;padding:1px 5px;border-radius:10px;">✓ Config</span>`
              : `<span style="font-size:9px;font-weight:600;color:#d97706;background:#fef3c7;padding:1px 5px;border-radius:10px;">! Sin config</span>`}
            ${source === 'global' ? `<span style="font-size:9px;color:var(--muted2);">global</span>` : `<span style="font-size:9px;color:#7c3aed;">tenant</span>`}
          </div>
          ${uri !== '—' ? `<div style="font-size:10px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${uri}</div>` : ''}
        </div>
      </div>
      ${modules.length ? `<div style="margin-top:7px;display:flex;flex-wrap:wrap;gap:3px;">
        ${modules.slice(0,3).map(m => `<span style="font-size:9px;color:${m.color};background:${m.color}18;padding:1px 6px;border-radius:8px;font-weight:600;">
          <i class="bi ${m.icon}" style="font-size:8px;"></i> ${m.name}</span>`).join('')}
      </div>` : ''}
    </div>`;
  }).join('');
}

/* ── Panel derecho: formulario de la integración seleccionada ──────────────── */
function selectConex(key) {
  _conexActiveKey = key;
  renderConexList(); // actualizar selección visual

  const f      = FEATURE_CATALOG.find(f => f.key === key);
  const schema = INTEGRATION_SCHEMAS[key];
  const s      = _conexState[key] || {};
  const enabled = s.enabled ?? false;
  const cfg    = s.config  || {};
  const modules = s.modules || [];
  const source  = s.source || 'global';

  const fieldSource = s.fieldSource || {};

  const fields = schema.fields.map(fld => {
    const raw       = cfg[fld.key] || '';        // valor efectivo (ya viene del servidor)
    const src       = fieldSource[fld.key] || 'empty'; // 'tenant' | 'global' | 'empty'
    const isSecret  = fld.sensitive;
    const inputType = isSecret ? 'password' : (fld.type === 'url' ? 'url' : fld.type === 'email' ? 'email' : 'text');

    // Badge de fuente
    const srcBadge = src === 'tenant'
      ? `<span style="font-size:10px;font-weight:700;color:#7c3aed;background:#f5f3ff;padding:1px 6px;border-radius:10px;margin-left:4px;"><i class="bi bi-person-fill" style="font-size:9px;"></i> Personalizado</span>`
      : src === 'global'
      ? `<span style="font-size:10px;font-weight:600;color:#0891b2;background:#e0f2fe;padding:1px 6px;border-radius:10px;margin-left:4px;"><i class="bi bi-globe" style="font-size:9px;"></i> Global (.env)</span>`
      : `<span style="font-size:10px;font-weight:600;color:#d97706;background:#fef3c7;padding:1px 6px;border-radius:10px;margin-left:4px;">Sin configurar</span>`;

    // Para secretos con valor: mostrar placeholder descriptivo, NO el valor enmascarado en el input
    const inputVal = (isSecret && raw) ? '' : raw;
    const inputPlaceholder = (isSecret && raw)
      ? '••••••• Guardado — escribe para reemplazar'
      : fld.placeholder;

    return `<div style="margin-bottom:14px;">
      <label style="display:flex;align-items:center;flex-wrap:wrap;gap:2px;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px;">
        ${fld.label}${fld.required ? '<span style="color:var(--danger);margin-left:2px;">*</span>' : ''}
        ${srcBadge}
      </label>
      <div style="display:flex;gap:6px;align-items:center;">
        <input id="cx-${key}-${fld.key}" type="${inputType}" class="form-input"
          style="flex:1;${src!=='empty'?'border-color:'+(src==='tenant'?'#7c3aed':'#0891b2')+';':''}"
          placeholder="${escHtml(inputPlaceholder)}"
          value="${escHtml(inputVal)}">
        ${isSecret ? `<button type="button" onclick="cxToggleVis('cx-${key}-${fld.key}',this)"
          style="flex-shrink:0;padding:8px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--muted);font-size:13px;cursor:pointer;"
          title="Mostrar/ocultar"><i class="bi bi-eye"></i></button>` : ''}
      </div>
      ${!isSecret && raw ? `<div style="font-size:11px;color:var(--muted);margin-top:3px;padding:3px 8px;background:var(--bg-subtle);border-radius:6px;font-family:monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${escHtml(raw)}">${escHtml(raw)}</div>` : ''}
    </div>`;
  }).join('');

  document.getElementById('conexForm').innerHTML = `
    <div>
      <!-- Cabecera -->
      <div style="display:flex;align-items:flex-start;gap:14px;margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid var(--border);">
        <div style="width:44px;height:44px;border-radius:11px;background:${f.color}1a;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i class="bi ${f.icon}" style="color:${f.color};font-size:20px;"></i>
        </div>
        <div style="flex:1;">
          <div style="font-size:16px;font-weight:800;color:var(--text);">${schema.label}</div>
          <div style="display:flex;align-items:center;gap:6px;margin-top:5px;flex-wrap:wrap;">
            ${enabled
              ? `<span style="font-size:11px;font-weight:700;color:#059669;background:#d1fae5;padding:2px 8px;border-radius:20px;"><i class="bi bi-check-circle-fill" style="font-size:10px;"></i> Habilitado para este cliente</span>`
              : `<span style="font-size:11px;font-weight:600;color:var(--muted);background:var(--bg-subtle);padding:2px 8px;border-radius:20px;"><i class="bi bi-circle" style="font-size:10px;"></i> Deshabilitado</span>`}
            <span style="font-size:11px;font-weight:600;color:${source==='tenant'?'#7c3aed':'var(--muted)'};background:${source==='tenant'?'#f5f3ff':'var(--bg-subtle)'};padding:2px 8px;border-radius:20px;">
              ${source === 'tenant' ? '🔧 Configuración propia del cliente' : '🌐 Usando configuración global (.env)'}
            </span>
          </div>
        </div>
        <label class="feat-toggle" title="${enabled?'Deshabilitar':'Habilitar'}">
          <input type="checkbox" ${enabled?'checked':''} onchange="conexToggle('${key}',this.checked)">
          <span class="feat-track"><span class="feat-knob"></span></span>
        </label>
      </div>

      <!-- Módulos que usan esta integración -->
      ${modules.length ? `<div style="margin-bottom:20px;">
        <div style="font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;">Módulos del sistema que usan esta integración</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          ${modules.map(m => `<span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;color:${m.color};background:${m.color}18;padding:4px 10px;border-radius:20px;border:1px solid ${m.color}33;">
            <i class="bi ${m.icon}" style="font-size:11px;"></i> ${m.name}
          </span>`).join('')}
        </div>
      </div>` : ''}

      <!-- Campos de configuración -->
      <div style="font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;">Credenciales y URIs</div>
      ${fields}

      <!-- Acciones -->
      <div style="display:flex;gap:8px;margin-top:6px;">
        <button id="cxbtn-${key}" onclick="saveConexConfig('${key}',this)"
          style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:10px 18px;border-radius:9px;background:${f.color};color:#fff;font-size:13px;font-weight:700;border:none;cursor:pointer;transition:opacity .15s;"
          onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
          <i class="bi bi-floppy-fill"></i> ${s.configured ? 'Actualizar credenciales' : 'Guardar credenciales'}
        </button>
        <button onclick="testConexConfig('${key}',this)"
          style="display:flex;align-items:center;gap:5px;padding:10px 16px;border-radius:9px;border:1px solid var(--border);background:var(--bg);color:var(--muted);font-size:12px;font-weight:600;cursor:pointer;"
          title="Probar conexión">
          <i class="bi bi-lightning-charge-fill"></i> Probar conexión
        </button>
      </div>
    </div>`;
}

/* ── renderConexGrid (legacy — ya no se usa directamente) ────────────────── */
function renderConexGrid() {
  const integrations = FEATURE_CATALOG.filter(f => !!INTEGRATION_SCHEMAS[f.key]);
  document.getElementById('conexGrid').innerHTML = integrations.map(f => {
    const schema   = INTEGRATION_SCHEMAS[f.key];
    const rec      = _conexState[f.key];
    const enabled  = rec !== undefined ? rec.enabled : false;
    const cfg      = rec?.config || {};
    const hasCfg   = Object.keys(cfg).length > 0;
    const allReqOk = schema.fields.filter(x => x.required).every(x => cfg[x.key]);

    const statusDot = enabled
      ? `<span style="display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;color:#059669;background:#d1fae5;padding:2px 8px;border-radius:20px;">
           <i class="bi bi-check-circle-fill" style="font-size:10px;"></i> Habilitado
         </span>`
      : `<span style="display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;color:var(--muted);background:var(--bg-subtle);padding:2px 8px;border-radius:20px;">
           <i class="bi bi-circle" style="font-size:10px;"></i> Deshabilitado
         </span>`;

    const cfgBadge = allReqOk
      ? `<span style="font-size:10px;font-weight:700;color:#0891b2;background:#e0f2fe;padding:2px 7px;border-radius:20px;margin-left:6px;"><i class="bi bi-check2" style="margin-right:2px;"></i>Configurado</span>`
      : `<span style="font-size:10px;font-weight:600;color:#d97706;background:#fef3c7;padding:2px 7px;border-radius:20px;margin-left:6px;"><i class="bi bi-exclamation" style="margin-right:2px;"></i>Sin configurar</span>`;

    const fields = schema.fields.map(fld => {
      const raw       = cfg[fld.key] || '';
      const isSecret  = fld.sensitive;
      const hasValue  = !!raw;
      const dispVal   = (isSecret && hasValue) ? '••••••• (guardado)' : raw;
      const inputType = isSecret ? 'password' : (fld.type === 'url' ? 'url' : fld.type === 'email' ? 'email' : 'text');
      const savedBadge = hasValue
        ? `<span style="font-size:10px;font-weight:700;color:#059669;background:#d1fae5;padding:1px 6px;border-radius:10px;margin-left:4px;"><i class="bi bi-check-lg"></i> Guardado</span>`
        : `<span style="font-size:10px;color:var(--muted2);margin-left:4px;">Sin valor</span>`;

      return `<div style="margin-bottom:12px;">
        <label style="display:flex;align-items:center;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px;">
          ${fld.label}${fld.required ? '<span style="color:var(--danger);margin-left:2px;">*</span>' : ''}
          ${savedBadge}
        </label>
        <div style="position:relative;display:flex;align-items:center;gap:6px;">
          <input id="cx-${f.key}-${fld.key}"
            type="${inputType}"
            class="form-input"
            style="flex:1;${hasValue ? 'border-color:#059669;' : ''}"
            placeholder="${hasValue ? (isSecret ? 'Nuevo valor (dejar vacío para mantener)' : fld.placeholder) : fld.placeholder}"
            value="${escHtml(dispVal)}">
          ${isSecret ? `<button type="button" onclick="cxToggleVis('cx-${f.key}-${fld.key}',this)"
            style="flex-shrink:0;padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--muted);font-size:13px;cursor:pointer;"
            title="Mostrar/ocultar"><i class="bi bi-eye"></i></button>` : ''}
        </div>
        ${hasValue && !isSecret ? `<div style="font-size:11px;color:var(--muted);margin-top:3px;font-family:monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(raw)}</div>` : ''}
      </div>`;
    }).join('');

    return `
    <div style="background:var(--card);border:1px solid ${enabled ? f.color + '44' : 'var(--border)'};border-radius:14px;overflow:hidden;transition:border-color .2s;" id="cxcard-${f.key}">
      <div style="display:flex;align-items:center;gap:12px;padding:14px 16px;background:${enabled ? f.color + '08' : 'transparent'};">
        <div style="width:40px;height:40px;border-radius:10px;background:${f.color}1a;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i class="bi ${f.icon}" style="color:${f.color};font-size:18px;"></i>
        </div>
        <div style="flex:1;min-width:0;">
          <div style="font-size:14px;font-weight:800;color:var(--text);display:flex;align-items:center;flex-wrap:wrap;gap:4px;">
            ${schema.label} ${cfgBadge}
          </div>
          <div style="margin-top:4px;">${statusDot}</div>
        </div>
        <label class="feat-toggle" title="${enabled ? 'Deshabilitar' : 'Habilitar'} ${schema.label}">
          <input type="checkbox" ${enabled ? 'checked' : ''} onchange="conexToggle('${f.key}',this.checked)">
          <span class="feat-track"><span class="feat-knob"></span></span>
        </label>
      </div>
      <div style="padding:16px;border-top:1px solid var(--border);">
        ${fields}
        <div style="display:flex;gap:8px;margin-top:6px;">
          <button id="cxbtn-${f.key}" onclick="saveConexConfig('${f.key}',this)"
            style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:9px 16px;border-radius:9px;background:${f.color};color:#fff;font-size:13px;font-weight:700;border:none;cursor:pointer;transition:opacity .15s;"
            onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
            <i class="bi bi-floppy-fill"></i>
            ${hasCfg ? 'Actualizar credenciales' : 'Guardar credenciales'}
          </button>
          <button onclick="testConexConfig('${f.key}',this)"
            style="display:flex;align-items:center;gap:5px;padding:9px 14px;border-radius:9px;border:1px solid var(--border);background:var(--bg);color:var(--muted);font-size:12px;font-weight:600;cursor:pointer;transition:all .15s;"
            title="Probar conexión" onmouseover="this.style.borderColor='${f.color}';this.style.color='${f.color}'" onmouseout="this.style.borderColor='';this.style.color=''">
            <i class="bi bi-lightning-charge-fill"></i> Probar
          </button>
        </div>
      </div>
    </div>`;
  }).join('');
}

function cxToggleVis(inputId, btn) {
  const el = document.getElementById(inputId);
  if (!el) return;
  if (el.type === 'password') {
    el.type = 'text';
    btn.innerHTML = '<i class="bi bi-eye-slash"></i>';
  } else {
    el.type = 'password';
    btn.innerHTML = '<i class="bi bi-eye"></i>';
  }
}

async function conexToggle(key, enabled) {
  try {
    const current = _conexState[key] || {};
    const r = await fetch(`/api/admin/tenants/${_conexTenantId}/features/${key}`, {
      method: 'PUT', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
      body: JSON.stringify({ enabled, config: current.config || {} }),
    });
    const j = await r.json();
    if (!r.ok) throw new Error(j.message || 'Error');
    if (!_conexState[key]) _conexState[key] = {};
    _conexState[key].enabled = enabled;
    const f = FEATURE_CATALOG.find(f => f.key === key);
    toast(`${f?.label || key} ${enabled ? 'habilitado' : 'deshabilitado'}`, 'ok');
    renderConexList();
    selectConex(key);
  } catch (e) {
    toast(e.message, 'err');
    if (_conexActiveKey) selectConex(_conexActiveKey);
  }
}

async function saveConexConfig(key, btn) {
  const schema = INTEGRATION_SCHEMAS[key];
  const config = {};
  for (const fld of schema.fields) {
    const el = document.getElementById(`cx-${key}-${fld.key}`);
    if (el) config[fld.key] = el.value.trim();
  }

  const orig = btn?.innerHTML;
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-arrow-clockwise" style="animation:spin .7s linear infinite;display:inline-block;"></i> Guardando...'; }

  try {
    const current = _conexState[key] || {};
    const r = await fetch(`/api/admin/tenants/${_conexTenantId}/features/${key}`, {
      method: 'PUT', headers: { 'Content-Type': 'application/json' }, credentials: 'include',
      body: JSON.stringify({ enabled: current.enabled ?? false, config }),
    });
    const j = await r.json();
    if (!r.ok) throw new Error(j.message || 'Error guardando');

    // Actualizar estado local — merge preservando sensibles
    if (!_conexState[key]) _conexState[key] = {};
    const current2 = _conexState[key].config || {};
    const PLACEHOLDER = '••••••• (guardado)';
    const merged2 = { ...current2 };
    for (const [k, v] of Object.entries(config)) {
      if (v === PLACEHOLDER || v === '') continue;
      merged2[k] = v;
    }
    _conexState[key].config = merged2;
    _conexState[key].configured = true;
    _conexState[key].source = 'tenant';

    const f = FEATURE_CATALOG.find(f => f.key === key);
    toast(`${f?.label || key}: credenciales guardadas ✓`, 'ok');
    renderConexList();
    selectConex(key); // Re-render formulario con badges actualizados
  } catch (e) {
    toast(e.message, 'err');
    if (btn) { btn.disabled = false; btn.innerHTML = orig; }
  }
}

async function testConexConfig(key, btn) {
  const f = FEATURE_CATALOG.find(f => f.key === key);
  const orig = btn?.innerHTML;
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-arrow-clockwise" style="animation:spin .7s linear infinite;display:inline-block;"></i>'; }
  toast(`Probando conexión con ${f?.label || key}...`, 'ok');
  await new Promise(r => setTimeout(r, 1200));
  if (btn) { btn.disabled = false; btn.innerHTML = orig; }
}

async function toggleFeature(key, enabled) {
  try {
    const r = await fetch(`/api/admin/tenants/${_featTenantId}/features/${key}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ enabled }),
    });
    const j = await r.json();
    if (!r.ok) throw new Error(j.message || 'Error');
    if (!_featState[key]) _featState[key] = {};
    _featState[key].enabled = enabled;
    const f = FEATURE_CATALOG.find(f => f.key === key);
    toast(`${f?.label || key} ${enabled ? 'activado' : 'desactivado'}`, 'ok');
    // Actualizar badge modo Jira/Local en la card del tenant
    if (key === 'jira') {
      const card = document.getElementById(`tc-${_featTenantId}`);
      if (card) {
        const badgesEl = card.querySelector('.tc-badges');
        if (badgesEl) {
          const modeBadge = badgesEl.querySelector('[data-mode-badge]');
          if (modeBadge) modeBadge.outerHTML = enabled
            ? `<span data-mode-badge style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;background:#dbeafe;color:#1d4ed8;border:1px solid #bfdbfe;"><i class="bi bi-kanban-fill"></i> Jira</span>`
            : `<span data-mode-badge style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;background:#f1f5f9;color:#64748b;border:1px solid #e2e8f0;"><i class="bi bi-hdd-fill"></i> Local</span>`;
        }
      }
    }
  } catch (e) {
    toast(e.message, 'err');
    renderFeaturesGrid(); // revertir UI al estado anterior
  }
}

/* ── Usuarios por tenant ───────────────────────────────────────────────── */
let _usuariosTenantId = null;

async function openUsuarios(tenantId, name) {
  _usuariosTenantId = tenantId;
  document.getElementById('usuariosTenantName').textContent = name;
  document.getElementById('uEmail').value = '';
  document.getElementById('uNombre').value = '';
  document.getElementById('uUsername').value = '';
  document.getElementById('uRol').value = 'usuario';
  document.getElementById('uPass').value = '';
  document.getElementById('uResult').style.display = 'none';
  openModal('modalUsuarios');
  await cargarUsuarios();
}

async function cargarUsuarios() {
  const lista = document.getElementById('usuariosList');
  lista.innerHTML = '<div style="text-align:center;padding:20px;color:var(--muted);"><i class="bi bi-arrow-clockwise" style="animation:spin 1s linear infinite;display:inline-block;"></i></div>';
  try {
    const r = await fetch(`/api/admin/tenants/${_usuariosTenantId}/users`, { credentials: 'include' });
    const j = await r.json();
    const users = j.data || [];
    if (!users.length) {
      lista.innerHTML = '<div style="text-align:center;padding:20px;color:var(--muted);font-size:13px;"><i class="bi bi-people" style="font-size:28px;display:block;margin-bottom:8px;opacity:.4;"></i>Sin usuarios aún</div>';
      return;
    }
    const ROLE_COLOR = { administrador:'#dc2626', agente:'#2563eb', especialista:'#7c3aed', tecnico:'#d97706', usuario:'#059669' };
    lista.innerHTML = users.map(u => `
      <div style="display:flex;align-items:center;gap:12px;padding:10px 14px;background:var(--card);border:1px solid var(--border);border-radius:10px;">
        <div style="width:36px;height:36px;border-radius:50%;background:#2563eb1a;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i class="bi bi-person-fill" style="color:#2563eb;font-size:16px;"></i>
        </div>
        <div style="flex:1;min-width:0;">
          <div style="font-size:13px;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${escHtml(u.full_name||u.username)}</div>
          <div style="font-size:11px;color:var(--muted2);">${escHtml(u.email)}</div>
        </div>
        <span style="font-size:10px;font-weight:700;color:${ROLE_COLOR[u.role]||'#64748b'};background:${ROLE_COLOR[u.role]||'#64748b'}1a;padding:2px 8px;border-radius:20px;white-space:nowrap;">${u.role}</span>
        <button onclick="toggleUsuario('${u.id}',${u.is_active?0:1},'${escHtml(u.full_name||u.email)}')"
          style="padding:4px 10px;font-size:11px;border-radius:6px;border:1px solid ${u.is_active?'#dc2626':'#059669'};color:${u.is_active?'#dc2626':'#059669'};background:transparent;cursor:pointer;">
          ${u.is_active ? 'Desactivar' : 'Activar'}
        </button>
      </div>`).join('');
  } catch (e) {
    lista.innerHTML = '<div style="color:#dc2626;padding:12px;font-size:13px;">Error cargando usuarios</div>';
  }
}

async function crearUsuario() {
  const email    = document.getElementById('uEmail').value.trim();
  const nombre   = document.getElementById('uNombre').value.trim();
  const username = document.getElementById('uUsername').value.trim();
  const rol      = document.getElementById('uRol').value;
  const pass     = document.getElementById('uPass').value.trim();
  const res      = document.getElementById('uResult');

  if (!email) { res.style.display='block'; res.style.background='#fee2e2'; res.style.color='#dc2626'; res.innerHTML='<i class="bi bi-exclamation-circle-fill"></i> El email es obligatorio'; return; }

  try {
    const r = await fetch(`/api/admin/tenants/${_usuariosTenantId}/users`, {
      method: 'POST', headers: { 'Content-Type':'application/json' }, credentials: 'include',
      body: JSON.stringify({ email, full_name: nombre, username, role: rol, password: pass }),
    });
    const j = await r.json();
    if (!r.ok) throw new Error(j.message || 'Error');
    res.style.display = 'block';
    res.style.background = '#d1fae5';
    res.style.color = '#065f46';
    const tmp = j.data?.tempPassword;
    res.innerHTML = `<i class="bi bi-check-circle-fill"></i> Usuario creado: <strong>${escHtml(j.data?.email)}</strong>${tmp ? ` — Contraseña temporal: <code style="background:#fff;padding:2px 6px;border-radius:4px;">${escHtml(tmp)}</code>` : ''}`;
    document.getElementById('uEmail').value = '';
    document.getElementById('uNombre').value = '';
    document.getElementById('uUsername').value = '';
    document.getElementById('uPass').value = '';
    toast('Usuario creado exitosamente', 'ok');
    await cargarUsuarios();
    await loadTenants();
  } catch (e) {
    res.style.display = 'block'; res.style.background = '#fee2e2'; res.style.color = '#dc2626';
    res.innerHTML = `<i class="bi bi-exclamation-circle-fill"></i> ${escHtml(e.message)}`;
  }
}

async function toggleUsuario(userId, newActive, nombre) {
  try {
    const r = await fetch(`/api/admin/tenants/${_usuariosTenantId}/users/${userId}`, {
      method: 'PATCH', headers: { 'Content-Type':'application/json' }, credentials: 'include',
      body: JSON.stringify({ is_active: newActive }),
    });
    const j = await r.json();
    if (!r.ok) throw new Error(j.message || 'Error');
    toast(`${nombre}: ${newActive ? 'activado' : 'desactivado'}`, 'ok');
    await cargarUsuarios();
  } catch (e) { toast(e.message, 'err'); }
}

/* ── Health ────────────────────────────────────────────────────────────── */
async function loadHealth() {
  try {
    const r = await fetch('/api/admin/tenants/health', { credentials: 'include' });
    const j = await r.json();
    const h = j.data || j;
    const dot = document.getElementById('hbDbDot');
    dot.className = 'hb-dot ' + (h.db?.ok ? 'hb-ok' : 'hb-err');
    document.getElementById('hbDbTxt').textContent    = h.db?.ok ? `OK ${h.db.latencyMs}ms` : 'ERROR';
    document.getElementById('hbMem').textContent      = `${h.node?.memUsedMb}/${h.node?.memTotalMb} MB`;
    document.getElementById('hbUptime').textContent   = h.node?.uptimeStr || '—';
    document.getElementById('hbTickets').textContent  = h.platform?.tickets_week ?? '—';
    document.getElementById('hbUsers').textContent    = h.platform?.users_active  ?? '—';
  } catch (_) {}
}

/* ── Actividad ─────────────────────────────────────────────────────────── */
let _actOpen = false;

function toggleActivity() {
  _actOpen = !_actOpen;
  document.getElementById('actBody').style.display = _actOpen ? 'block' : 'none';
  document.getElementById('actChevron').style.transform = _actOpen ? 'rotate(180deg)' : '';
  if (_actOpen) loadActivity();
}

async function loadActivity() {
  const tbody = document.getElementById('actTbody');
  try {
    const r = await fetch('/api/admin/tenants/activity', { credentials: 'include' });
    const j = await r.json();
    const rows = j.data || j || [];
    if (!rows.length) { tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:16px;">Sin datos</td></tr>'; return; }
    const maxT7  = Math.max(...rows.map(r => r.tickets_7d  || 0), 1);
    const maxT30 = Math.max(...rows.map(r => r.tickets_30d || 0), 1);
    tbody.innerHTML = rows.map(r => {
      const pBadge = { trial:'#d97706', starter:'#2563eb', professional:'#7c3aed', enterprise:'#059669' };
      const pc = pBadge[r.plan] || '#94a3b8';
      return `<tr>
        <td><strong>${escHtml(r.name)}</strong></td>
        <td><span class="act-badge" style="background:${pc}22;color:${pc};">${r.plan}</span></td>
        <td>
          <div style="font-weight:700;">${r.tickets_7d||0}</div>
          <div class="act-bar"><div class="act-bar-fill" style="width:${Math.round(((r.tickets_7d||0)/maxT7)*100)}%;"></div></div>
        </td>
        <td>
          <div style="font-weight:700;">${r.tickets_30d||0}</div>
          <div class="act-bar"><div class="act-bar-fill" style="width:${Math.round(((r.tickets_30d||0)/maxT30)*100)}%;background:linear-gradient(90deg,#7c3aed,#a78bfa);"></div></div>
        </td>
        <td><span style="color:#059669;font-weight:700;">${r.resolved_30d||0}</span></td>
        <td>${r.new_users_30d||0}</td>
        <td>${r.total_users||0}</td>
      </tr>`;
    }).join('');
  } catch (e) {
    tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:var(--danger);padding:16px;">${e.message}</td></tr>`;
  }
}

/* ── Broadcast ─────────────────────────────────────────────────────────── */
function bcTargetChange() {
  const isOne = document.getElementById('bcTarget').value === 'one';
  document.getElementById('bcTenantWrap').style.display = isOne ? '' : 'none';
}

function openModal_broadcast() {
  const sel = document.getElementById('bcTenantId');
  sel.innerHTML = (_tenants||[]).filter(t => t.is_active).map(t => `<option value="${t.id}">${escHtml(t.name)}</option>`).join('');
  document.getElementById('bcTitle').value = '';
  document.getElementById('bcBody').value  = '';
  document.getElementById('bcTarget').value = 'all';
  document.getElementById('bcTenantWrap').style.display = 'none';
  document.getElementById('bcError').style.display = 'none';
  const btn = document.getElementById('btnBroadcast');
  btn.disabled = false;
  btn.innerHTML = '<i class="bi bi-send-fill"></i> Enviar comunicado';
  document.getElementById('modalBroadcast').classList.add('open');
}

async function sendBroadcast() {
  const title  = document.getElementById('bcTitle').value.trim();
  const body   = document.getElementById('bcBody').value.trim();
  const target = document.getElementById('bcTarget').value;
  const errEl  = document.getElementById('bcError');
  errEl.style.display = 'none';

  if (!title || !body) { errEl.textContent = 'Título y mensaje son requeridos.'; errEl.style.display = 'block'; return; }

  const btn = document.getElementById('btnBroadcast');
  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Enviando...';

  try {
    const payload = { title, body };
    if (target === 'one') {
      payload.tenantIds = [parseInt(document.getElementById('bcTenantId').value)];
    }
    const r = await fetch('/api/admin/tenants/broadcast', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      credentials: 'include', body: JSON.stringify(payload),
    });
    const j = await r.json();
    if (!r.ok) throw new Error(j.message || 'Error');
    closeModal('modalBroadcast');
    toast(j.message || 'Comunicado enviado', 'ok');
  } catch (e) {
    errEl.textContent = e.message; errEl.style.display = 'block';
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-send-fill"></i> Enviar comunicado';
  }
}

/* ── Billing ───────────────────────────────────────────────────────────── */
let _billingTenantId = null;

async function openBilling(tenantId, name) {
  _billingTenantId = tenantId;
  document.getElementById('billingTenantName').textContent = name;
  document.getElementById('bRenewal').value = '';
  document.getElementById('bAmount').value  = '';
  document.getElementById('bStatus').value  = 'pending';
  document.getElementById('bNotes').value   = '';
  document.getElementById('bAddError').style.display = 'none';
  openModal('modalBilling');
  await loadBillingList();
}

async function loadBillingList() {
  const list = document.getElementById('billingList');
  list.innerHTML = '<div style="text-align:center;padding:20px;color:var(--muted);">Cargando...</div>';
  try {
    const r = await fetch(`/api/admin/tenants/${_billingTenantId}/billing`, { credentials: 'include' });
    const j = await r.json();
    const rows = j.data || j || [];
    if (!rows.length) {
      list.innerHTML = '<div style="text-align:center;padding:24px;color:var(--muted);font-size:13px;"><i class="bi bi-inbox" style="font-size:24px;display:block;margin-bottom:8px;"></i>Sin registros de billing</div>';
      return;
    }
    const statusLabel = { paid:'Pagado', pending:'Pendiente', overdue:'Vencido' };
    list.innerHTML = rows.map(b => {
      const cls  = { paid:'bill-paid', pending:'bill-pending', overdue:'bill-overdue' }[b.status] || 'bill-pending';
      const date = b.renewal_date ? new Date(b.renewal_date).toLocaleDateString('es-PE', {year:'numeric',month:'short',day:'numeric'}) : '—';
      const overdueWarn = b.status === 'overdue' ? ' <i class="bi bi-exclamation-triangle-fill" style="color:#dc2626;"></i>' : '';
      return `<div class="bill-row">
        <div style="flex:1;">
          <div style="font-weight:700;color:var(--text);">${date}${overdueWarn}</div>
          ${b.notes ? `<div style="color:var(--muted);font-size:11px;margin-top:1px;">${escHtml(b.notes)}</div>` : ''}
        </div>
        <div style="font-size:14px;font-weight:800;color:var(--text);min-width:80px;text-align:right;">${b.amount != null ? '$'+parseFloat(b.amount).toFixed(2) : '—'}</div>
        <span class="bill-status ${cls}">${statusLabel[b.status]||b.status}</span>
        <select onchange="updateBillingStatus(${b.id}, this.value)" style="font-size:11px;padding:3px 6px;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--text);cursor:pointer;">
          <option value="pending" ${b.status==='pending'?'selected':''}>Pendiente</option>
          <option value="paid"    ${b.status==='paid'   ?'selected':''}>Pagado</option>
          <option value="overdue" ${b.status==='overdue'?'selected':''}>Vencido</option>
        </select>
        <button onclick="deleteBilling(${b.id})" style="border:none;background:none;cursor:pointer;color:var(--muted);padding:4px;" title="Eliminar"><i class="bi bi-trash3"></i></button>
      </div>`;
    }).join('');
  } catch (e) {
    list.innerHTML = `<div style="color:var(--danger);text-align:center;padding:20px;">${e.message}</div>`;
  }
}

async function addBilling() {
  const renewal = document.getElementById('bRenewal').value;
  const amount  = document.getElementById('bAmount').value;
  const status  = document.getElementById('bStatus').value;
  const notes   = document.getElementById('bNotes').value.trim();
  const errEl   = document.getElementById('bAddError');
  errEl.style.display = 'none';

  if (!renewal && !amount) { errEl.textContent = 'Ingresa al menos la fecha de renovación o el monto.'; errEl.style.display = 'block'; return; }

  try {
    const r = await fetch(`/api/admin/tenants/${_billingTenantId}/billing`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ renewal_date: renewal || null, amount: amount || null, status, notes }),
    });
    const j = await r.json();
    if (!r.ok) throw new Error(j.message || 'Error');
    document.getElementById('bRenewal').value = '';
    document.getElementById('bAmount').value  = '';
    document.getElementById('bNotes').value   = '';
    await loadBillingList();
    toast('Registro agregado', 'ok');
  } catch (e) { errEl.textContent = e.message; errEl.style.display = 'block'; }
}

async function updateBillingStatus(billingId, status) {
  try {
    await fetch(`/api/admin/tenants/${_billingTenantId}/billing/${billingId}`, {
      method: 'PATCH', headers: { 'Content-Type': 'application/json' },
      credentials: 'include', body: JSON.stringify({ status }),
    });
    await loadBillingList();
  } catch (e) { toast(e.message, 'err'); }
}

async function deleteBilling(billingId) {
  if (!confirm('¿Eliminar este registro de billing?')) return;
  try {
    await fetch(`/api/admin/tenants/${_billingTenantId}/billing/${billingId}`, {
      method: 'DELETE', credentials: 'include',
    });
    await loadBillingList();
    toast('Registro eliminado', 'ok');
  } catch (e) { toast(e.message, 'err'); }
}

/* ── Init ──────────────────────────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', () => { loadTenants(); loadHealth(); });
</script>
</body>
</html>
