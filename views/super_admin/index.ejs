        <i class="bi bi-plug-fill" style="color:#0891b2;margin-right:6px;"></i>
        Conexiones · <span id="conexTenantName">—</span>
      </span>
      <button class="modal-close" onclick="closeModal('modalConexiones')"><i class="bi bi-x-lg"></i></button>
