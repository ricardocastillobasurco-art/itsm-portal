<!-- ══ MODAL: COMUNICADO GLOBAL ═════════════════════════════════════════ -->
<div id="modalBroadcast" class="modal-bg">
  <div class="modal" style="max-width:520px;">
    <div class="modal-head">
      <span class="modal-title" style="color:#7c3aed;"><i class="bi bi-megaphone-fill" style="margin-right:6px;"></i>Comunicado Global</span>
      <button class="modal-close" onclick="closeModal('modalBroadcast')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Destinatarios</label>
        <select id="bcTarget" class="form-input" onchange="bcTargetChange()">
          <option value="all">Todos los clientes activos</option>
          <option value="one">Un cliente específico</option>
        </select>
      </div>
      <div id="bcTenantWrap" style="display:none;" class="form-group">
        <label class="form-label">Cliente</label>
        <select id="bcTenantId" class="form-input"></select>
      </div>
      <div class="form-group">
        <label class="form-label">Título del comunicado</label>
        <input id="bcTitle" type="text" class="form-input" placeholder="Ej: Mantenimiento programado — Sábado 10pm">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label class="form-label">Mensaje</label>
        <textarea id="bcBody" class="form-input" rows="4" style="resize:vertical;" placeholder="Describe el comunicado para tus clientes..."></textarea>
      </div>
      <div id="bcError" style="font-size:13px;color:var(--danger);margin-top:10px;display:none;"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-outline" onclick="closeModal('modalBroadcast')">Cancelar</button>
      <button id="btnBroadcast" onclick="sendBroadcast()" style="background:#7c3aed;color:#fff;border:none;padding:8px 18px;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;">
        <i class="bi bi-send-fill"></i> Enviar comunicado
      </button>
    </div>
  </div>
</div>

<!-- ══ MODAL: BILLING ════════════════════════════════════════════════════ -->
<div id="modalBilling" class="modal-bg">
  <div class="modal-box" style="max-width:640px;max-height:88vh;display:flex;flex-direction:column;">
    <div class="modal-header">
      <div>
        <div class="modal-title"><i class="bi bi-credit-card-fill" style="color:#059669;"></i> Billing — <span id="billingTenantName"></span></div>
        <div class="modal-sub">Historial de pagos y renovaciones</div>
      </div>
      <button class="modal-close" onclick="closeModal('modalBilling')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div style="padding:18px 20px;border-bottom:1px solid var(--border);background:var(--bg);">
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:8px;align-items:end;">
        <div>
          <label style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:4px;">Renovación</label>
          <input id="bRenewal" type="date" class="form-input" style="padding:6px 8px;font-size:12px;">
        </div>
        <div>
          <label style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:4px;">Monto (USD)</label>
          <input id="bAmount" type="number" step="0.01" class="form-input" style="padding:6px 8px;font-size:12px;" placeholder="0.00">
        </div>
        <div>
          <label style="font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:4px;">Estado</label>
          <select id="bStatus" class="form-input" style="padding:6px 8px;font-size:12px;">
            <option value="pending">Pendiente</option>
            <option value="paid">Pagado</option>
            <option value="overdue">Vencido</option>
          </select>
        </div>
        <button onclick="addBilling()" style="padding:7px 14px;background:#059669;color:#fff;border:none;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;"><i class="bi bi-plus-lg"></i> Agregar</button>
      </div>
      <input id="bNotes" type="text" class="form-input" style="margin-top:8px;padding:6px 8px;font-size:12px;" placeholder="Notas (opcional)">
      <div id="bAddError" style="font-size:12px;color:var(--danger);margin-top:6px;display:none;"></div>
    </div>
    <div style="flex:1;overflow-y:auto;padding:16px 20px;">
      <div id="billingList" style="display:flex;flex-direction:column;gap:8px;">
        <div style="text-align:center;padding:20px;color:var(--muted);">Cargando...</div>
      </div>
    </div>
    <div class="modal-footer" style="flex-shrink:0;border-top:1px solid var(--border);">
      <button class="btn-outline" onclick="closeModal('modalBilling')">Cerrar</button>
    </div>
  </div>
</div>

<!-- ══ MODAL: ELIMINAR CLIENTE ══════════════════════════════════════════ -->
<div id="modalDelete" class="modal-bg">
  <div class="modal" style="max-width:440px;">
    <div class="modal-head">
      <span class="modal-title" style="color:var(--danger);"><i class="bi bi-trash3-fill" style="margin-right:6px;"></i>Eliminar Cliente</span>
      <button class="modal-close" onclick="closeModal('modalDelete')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body">
      <div style="background:rgba(220,38,38,.06);border:1px solid rgba(220,38,38,.2);border-radius:10px;padding:14px 16px;margin-bottom:18px;">
        <div style="font-size:13px;font-weight:700;color:var(--danger);margin-bottom:4px;"><i class="bi bi-exclamation-triangle-fill"></i> Esta acción es irreversible</div>
        <div style="font-size:12px;color:#b91c1c;line-height:1.5;">
          Se eliminará permanentemente el cliente <strong id="delTenantName" style="color:var(--danger);"></strong> y todos sus datos asociados: usuarios, comunidades, anuncios y configuración.
        </div>
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label class="form-label">Contraseña del Super Administrador</label>
        <input id="delPassword" type="password" class="form-input" placeholder="Ingresa tu contraseña para confirmar" autocomplete="current-password" onkeydown="if(event.key==='Enter')confirmDelete()">
      </div>
      <div id="delError" style="font-size:13px;color:var(--danger);margin-top:10px;display:none;padding:8px 12px;background:rgba(220,38,38,.06);border-radius:7px;"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-outline" onclick="closeModal('modalDelete')">Cancelar</button>
      <button id="btnConfirmDelete" onclick="confirmDelete()" style="background:var(--danger);color:#fff;border:none;padding:8px 18px;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:opacity .15s;">
        <i class="bi bi-trash3-fill"></i> Eliminar permanentemente
      </button>
    </div>
  </div>
</div>

<!-- ══ MODAL: CAMBIAR PLAN ═══════════════════════════════════════════════ -->
<div id="modalPlan" class="modal-bg">
  <div class="modal" style="max-width:480px;">
    <div class="modal-head">
      <span class="modal-title"><i class="bi bi-arrow-repeat" style="margin-right:6px;color:var(--primary);"></i>Cambiar Plan</span>
      <button class="modal-close" onclick="closeModal('modalPlan')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body">
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px 16px;margin-bottom:18px;display:flex;align-items:center;gap:10px;">
        <i class="bi bi-building" style="font-size:20px;color:var(--primary);"></i>
        <div>
          <div style="font-size:13px;font-weight:700;color:var(--text);" id="planTenantName"></div>
          <div style="font-size:11px;color:var(--muted2);">Plan actual: <strong id="planCurrentBadge" style="color:var(--primary);"></strong></div>
        </div>
      </div>
      <div class="form-group" style="margin-bottom:16px;">
        <label class="form-label">Nuevo plan</label>
        <select id="planSelect" class="form-input" style="padding:10px 14px;height:auto;cursor:pointer;">
          <option value="trial">Trial — hasta 5 usuarios · 200 tickets</option>
          <option value="starter">Starter — hasta 20 usuarios · 1 000 tickets</option>
          <option value="professional">Professional — hasta 50 usuarios · 5 000 tickets</option>
          <option value="enterprise">Enterprise — usuarios y tickets ilimitados</option>
        </select>
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label class="form-label">Contraseña del Super Administrador</label>
        <input id="planPassword" type="password" class="form-input" placeholder="Confirma con tu contraseña" autocomplete="current-password" onkeydown="if(event.key==='Enter')confirmPlan()">
      </div>
      <div id="planError" style="font-size:13px;color:var(--danger);margin-top:10px;display:none;padding:8px 12px;background:rgba(220,38,38,.06);border-radius:7px;"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-outline" onclick="closeModal('modalPlan')">Cancelar</button>
      <button id="btnConfirmPlan" onclick="confirmPlan()" style="background:var(--primary);color:#fff;border:none;padding:8px 18px;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:opacity .15s;">
        <i class="bi bi-check2-circle"></i> Confirmar cambio
      </button>
    </div>
  </div>
</div>

<!-- ══ TOAST ═════════════════════════════════════════════════════════════ -->
<div id="toast"></div>

<style>@keyframes spin{to{transform:rotate(360deg);}}</style>

<script>
/* ── Estado ────────────────────────────────────────────────────────────── */
let _tenants     = [];
let _importId    = null;
let _csvRows     = [];
let _csvHeaders  = [];

/* ── Tema ──────────────────────────────────────────────────────────────── */
function _syncTheme(t) {
  const dark = t === 'dark';
  const icon = document.getElementById('toggleIcon');
  const track = document.getElementById('themeTrack');
  const knob  = document.getElementById('themeKnob');
  if (icon)  icon.className = dark ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
  if (track) track.style.background = dark ? '#3b82f6' : '#cbd5e1';
  if (knob)  knob.style.transform   = dark ? 'translateX(13px)' : 'translateX(0)';
}
function toggleTheme() {
  const n = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', n);
  localStorage.setItem('dashboardTheme', n);
  _syncTheme(n);
}
document.addEventListener('DOMContentLoaded', () => _syncTheme(localStorage.getItem('dashboardTheme') || 'light'));

/* ── Modales ───────────────────────────────────────────────────────────── */
function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll && document.addEventListener('keydown', e => { if (e.key === 'Escape') document.querySelectorAll('.modal-bg.open').forEach(m => m.classList.remove('open')); });

/* ── Toast ─────────────────────────────────────────────────────────────── */
function toast(msg, type = 'info') {
  const el = document.createElement('div');
  el.className = `toast-item toast-${type}`;
  const icons = { ok: 'bi-check-circle-fill', err: 'bi-x-circle-fill', info: 'bi-info-circle-fill' };
  el.innerHTML = `<i class="bi ${icons[type] || icons.info}"></i>${msg}`;
  document.getElementById('toast').appendChild(el);
  setTimeout(() => el.remove(), 4000);
}

/* ── Cargar tenants ────────────────────────────────────────────────────── */
async function loadTenants() {
  try {
    const r = await fetch('/api/admin/tenants/stats', { credentials: 'include' });
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const j = await r.json();
    _tenants = Array.isArray(j.data) ? j.data : Array.isArray(j) ? j : [];
    renderStats();
    renderGrid();
  } catch (e) {
    console.error('[loadTenants] error:', e);
    document.getElementById('tenantGrid').innerHTML = '<div class="empty-state"><i class="bi bi-exclamation-triangle"></i><p>Error cargando clientes</p><p style="font-size:11px;color:#6b7280;margin-top:4px;">' + e.message + '</p></div>';
  }
}

function renderStats() {
  const total     = _tenants.length;
  const active    = _tenants.filter(t => t.is_active).length;
  const trial     = _tenants.filter(t => t.plan === 'trial').length;
  const suspended = _tenants.filter(t => !t.is_active).length;
  document.getElementById('st-total').textContent     = total;
  document.getElementById('st-active').textContent    = active;
  document.getElementById('st-trial').textContent     = trial;
  document.getElementById('st-suspended').textContent = suspended;
}

function renderGrid() {
  const grid = document.getElementById('tenantGrid');
  if (!_tenants.length) {
    grid.innerHTML = '<div class="empty-state"><i class="bi bi-buildings"></i><p>No hay clientes registrados.<br>Crea el primero con el botón <strong>Nuevo Cliente</strong>.</p></div>';
    return;
  }
  grid.innerHTML = _tenants.map(t => tenantCard(t)).join('');
}

const PLAN_LIMITS = { trial:{users:5,tickets:200}, starter:{users:20,tickets:1000}, professional:{users:50,tickets:5000}, enterprise:{users:null,tickets:null} };

function quotaBar(used, limit, label) {
  if (!limit) return '';
  const pct   = Math.min(100, Math.round((used/limit)*100));
  const cls   = pct >= 90 ? 'quota-over' : pct >= 70 ? 'quota-warn' : 'quota-ok';
  return `<div class="quota-row">
    <span class="quota-lbl">${label}</span>
    <div class="quota-bar"><div class="quota-fill ${cls}" style="width:${pct}%;"></div></div>
    <span class="quota-num">${used}/${limit}</span>
  </div>`;
}

function tenantCard(t) {
  const planBadge  = `<span class="badge badge-${t.plan}">${t.plan.charAt(0).toUpperCase()+t.plan.slice(1)}</span>`;
  const statusBadge = t.is_active
    ? '<span class="badge badge-active"><i class="bi bi-circle-fill" style="font-size:7px;"></i> Activo</span>'
    : '<span class="badge badge-suspended"><i class="bi bi-pause-circle-fill" style="font-size:7px;"></i> Suspendido</span>';
  const domain     = t.domain ? `<div class="tc-domain"><i class="bi bi-at"></i>${t.domain}</div>` : '';
  const created    = new Date(t.created_at).toLocaleDateString('es-PE', {year:'numeric',month:'short',day:'numeric'});
  const suspendBtn = t.is_active
    ? `<button class="btn-outline btn-danger" onclick="toggleStatus(${t.id},'suspend','${escHtml(t.name)}')"><i class="bi bi-pause-fill"></i> Suspender</button>`
    : `<button class="btn-outline btn-success" onclick="toggleStatus(${t.id},'reactivate','${escHtml(t.name)}')"><i class="bi bi-play-fill"></i> Reactivar</button>`;
  const lim    = PLAN_LIMITS[t.plan] || PLAN_LIMITS.trial;
  const quotas = (lim.users || lim.tickets) ? `<div class="quota-wrap">
    ${quotaBar(t.user_count||0, lim.users, 'Usuarios')}
    ${quotaBar(t.ticket_count||0, lim.tickets, 'Tickets')}
  </div>` : `<div style="font-size:10px;color:var(--muted);margin-bottom:12px;"><i class="bi bi-infinity"></i> Sin límites (Enterprise)</div>`;
  return `
  <div class="tenant-card" id="tc-${t.id}">
    <div class="tc-head">
      <div class="tc-icon"><i class="bi bi-building"></i></div>
      <div class="tc-info">
        <div class="tc-name">${escHtml(t.name)}</div>
        <div class="tc-slug">/${escHtml(t.slug)}</div>
        ${domain}
      </div>
    </div>
    <div class="tc-badges">${planBadge}${statusBadge}
    ${t.jira_enabled != 0
      ? `<span data-mode-badge style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;background:#dbeafe;color:#1d4ed8;border:1px solid #bfdbfe;"><i class="bi bi-kanban-fill"></i> Jira</span>`
      : `<span data-mode-badge style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;background:#f1f5f9;color:#64748b;border:1px solid #e2e8f0;"><i class="bi bi-hdd-fill"></i> Local</span>`}
  </div>
    <div class="tc-stats">
      <div class="tc-stat"><i class="bi bi-people-fill"></i><div><div class="tc-stat-val">${t.employee_count||t.user_count||0}</div><div class="tc-stat-lbl">Registrados</div></div></div>
      <div class="tc-stat"><i class="bi bi-ticket-fill"></i><div><div class="tc-stat-val">${t.ticket_count||0}</div><div class="tc-stat-lbl">Tickets</div></div></div>
      <div class="tc-stat"><i class="bi bi-laptop-fill"></i><div><div class="tc-stat-val">${t.equipment_count||0}</div><div class="tc-stat-lbl">Equipos</div></div></div>
    </div>
    <div style="display:flex;gap:8px;margin-bottom:12px;">
      <button onclick="openTenantPortal(${t.id},'autogestion')" style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:7px 10px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;background:rgba(59,130,246,.08);color:#2563eb;border:1px solid rgba(59,130,246,.2);transition:background .15s;" onmouseover="this.style.background='rgba(59,130,246,.16)'" onmouseout="this.style.background='rgba(59,130,246,.08)'">
        <i class="bi bi-person-circle"></i> Portal Usuario
      </button>
      <button onclick="openTenantPortal(${t.id},'administracion')" style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:7px 10px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;background:rgba(124,58,237,.08);color:#7c3aed;border:1px solid rgba(124,58,237,.2);transition:background .15s;" onmouseover="this.style.background='rgba(124,58,237,.16)'" onmouseout="this.style.background='rgba(124,58,237,.08)'">
        <i class="bi bi-shield-lock-fill"></i> Panel Admin
      </button>
    </div>
    ${quotas}
    <div class="tc-date"><i class="bi bi-calendar3"></i> Creado ${created}</div>
    <div class="tc-actions">
      <button class="btn-outline" onclick="openImport(${t.id},'${escHtml(t.name)}')"><i class="bi bi-cloud-upload"></i> Importar</button>
      <button class="btn-outline" style="color:#2563eb;border-color:#2563eb;" onclick="openUsuarios(${t.id},'${escHtml(t.name)}')"><i class="bi bi-people-fill"></i> Usuarios</button>
      <button class="btn-outline" onclick="openFeatures(${t.id},'${escHtml(t.name)}')"><i class="bi bi-toggles"></i> Módulos</button>
      <button class="btn-outline" onclick="openConexiones(${t.id},'${escHtml(t.name)}')" style="color:#0891b2;border-color:#0891b2;" title="Configurar URIs y credenciales de integración"><i class="bi bi-plug-fill"></i> Conexiones</button>
      <button class="btn-outline" onclick="changePlanUI(${t.id},'${escHtml(t.name)}','${t.plan}')"><i class="bi bi-arrow-repeat"></i> Plan</button>
      <div style="position:relative;display:inline-block;">
        <button class="btn-outline" onclick="toggleExportMenu(${t.id},this)"><i class="bi bi-download"></i> Exportar <i class="bi bi-chevron-down" style="font-size:10px;"></i></button>
        <div id="exp-${t.id}" style="display:none;position:absolute;top:calc(100% + 4px);right:0;background:var(--card);border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.15);min-width:200px;z-index:200;overflow:hidden;">
          <div style="padding:6px 0;">
            <div style="font-size:10px;font-weight:700;color:var(--muted2);text-transform:uppercase;letter-spacing:.5px;padding:6px 14px 4px;">Exportar como CSV</div>
            <a href="/api/admin/tenants/${t.id}/export/csv/users"        download style="display:flex;align-items:center;gap:8px;padding:8px 14px;font-size:13px;color:var(--text2);transition:background .12s;text-decoration:none;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background=''"><i class="bi bi-people-fill" style="color:#2563eb;width:16px;text-align:center;"></i> Usuarios</a>
            <a href="/api/admin/tenants/${t.id}/export/csv/config_items" download style="display:flex;align-items:center;gap:8px;padding:8px 14px;font-size:13px;color:var(--text2);transition:background .12s;text-decoration:none;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background=''"><i class="bi bi-laptop-fill" style="color:#d97706;width:16px;text-align:center;"></i> Equipos</a>
            <a href="/api/admin/tenants/${t.id}/export/csv/tickets"      download style="display:flex;align-items:center;gap:8px;padding:8px 14px;font-size:13px;color:var(--text2);transition:background .12s;text-decoration:none;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background=''"><i class="bi bi-ticket-fill" style="color:#dc2626;width:16px;text-align:center;"></i> Incidencias</a>
            <a href="/api/admin/tenants/${t.id}/export/csv/kb_articles"  download style="display:flex;align-items:center;gap:8px;padding:8px 14px;font-size:13px;color:var(--text2);transition:background .12s;text-decoration:none;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background=''"><i class="bi bi-book-fill" style="color:#7c3aed;width:16px;text-align:center;"></i> Artículos KB</a>
            <div style="height:1px;background:var(--border);margin:4px 0;"></div>
            <div style="font-size:10px;font-weight:700;color:var(--muted2);text-transform:uppercase;letter-spacing:.5px;padding:4px 14px 4px;">Copia de seguridad</div>
            <a href="/api/admin/tenants/${t.id}/export" download style="display:flex;align-items:center;gap:8px;padding:8px 14px;font-size:13px;color:var(--text2);transition:background .12s;text-decoration:none;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background=''"><i class="bi bi-archive-fill" style="color:var(--muted);width:16px;text-align:center;"></i> Todo (JSON)</a>
          </div>
        </div>
      </div>
      <button class="btn-outline" onclick="openBilling(${t.id},'${escHtml(t.name)}')" style="color:#059669;border-color:#059669;"><i class="bi bi-credit-card-fill"></i> Billing</button>
      <button class="btn-outline" onclick="regenerateConfig(${t.id},'${escHtml(t.name)}')" style="color:#0891b2;border-color:#0891b2;" title="Regenerar archivos config.js e integrations.js del cliente"><i class="bi bi-file-earmark-code-fill"></i> Config</button>
      ${suspendBtn}
      <button class="btn-outline btn-danger" onclick="openDelete(${t.id},'${escHtml(t.name)}')"><i class="bi bi-trash3-fill"></i> Eliminar</button>
    </div>
  </div>`;
}

function escHtml(s) { return String(s||'').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

function openTenantPortal(tenantId, target) {
  window.open(`/api/admin/tenants/${tenantId}/enter?target=${target}`, '_blank');
}

/* ── Crear tenant ──────────────────────────────────────────────────────── */
function autoSlug() {
  const name = document.getElementById('newName').value;
  document.getElementById('newSlug').value = name.toLowerCase().replace(/[^a-z0-9]/g,'-').replace(/-+/g,'-').replace(/^-|-$/g,'').substring(0,100);
}

async function createTenant() {
  const name         = document.getElementById('newName').value.trim();
  const slug         = document.getElementById('newSlug').value.trim();
  const domain       = document.getElementById('newDomain').value.trim();
  const contactEmail = document.getElementById('newEmail').value.trim();
  const plan         = document.getElementById('newPlan').value;
  const errEl        = document.getElementById('newError');
  const btn          = document.getElementById('btnCreate');

  // Leer features seleccionadas
  const features = {
    jira:           document.getElementById('featJira').checked,
    microsoftTools: document.getElementById('featMicrosoft').checked,
    printQueue:     document.getElementById('featPrint').checked,
    azureAD:        document.getElementById('featAzure').checked,
    localTickets:   true,
  };

  if (!name) { errEl.textContent = 'El nombre es requerido'; errEl.style.display = 'block'; return; }
  errEl.style.display = 'none';
  btn.disabled = true; btn.innerHTML = '<i class="bi bi-arrow-clockwise" style="animation:spin 1s linear infinite;display:inline-block;"></i> Creando...';

  try {
    const r = await fetch('/api/admin/tenants', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ name, slug, plan, domain, contactEmail, settings: { features } }),
    });
    const j = await r.json();
    if (!r.ok) throw new Error(j.message || j.error || 'Error al crear');
    closeModal('modalNew');
    ['newName','newSlug','newDomain','newEmail'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('newPlan').value = 'trial';
    ['featJira','featMicrosoft','featPrint','featAzure'].forEach(id => document.getElementById(id).checked = false);
    // Abrir modal de provisioning y lanzar SSE
    openProvisionModal(j.data.id, j.data.name || name, features);
  } catch (e) {
    errEl.textContent = e.message; errEl.style.display = 'block';
  } finally {
    btn.disabled = false; btn.innerHTML = '<i class="bi bi-plus-lg"></i> Crear Cliente';
  }
}

function openProvisionModal(tenantId, tenantName, features) {
  document.getElementById('provName').textContent = tenantName;
  document.getElementById('provBar').style.width = '0%';
  document.getElementById('provPct').textContent = '0%';
  document.getElementById('provMsg').textContent = 'Iniciando...';
  document.getElementById('provSteps').innerHTML = '';
  document.getElementById('provDoneBtn').style.display = 'none';
  document.getElementById('modalProvision').style.display = 'flex';

  // Pasar features seleccionadas como query params para el provisioning
  const featQ = features ? '?features=' + encodeURIComponent(JSON.stringify(features)) : '';
  const es = new EventSource(`/api/admin/tenants/${tenantId}/provision${featQ}`, { withCredentials: true });
  es.onmessage = (e) => {
    const d = JSON.parse(e.data);
    if (d.pct !== undefined) {
      document.getElementById('provBar').style.width = d.pct + '%';
      document.getElementById('provPct').textContent = d.pct + '%';
    }
    if (d.msg) {
      document.getElementById('provMsg').textContent = d.msg;
      const li = document.createElement('div');
      li.className = 'prov-step' + (d.error ? ' prov-error' : (d.done ? ' prov-done' : ''));
      li.innerHTML = `<i class="bi bi-${d.error ? 'x-circle-fill' : (d.done ? 'check-circle-fill' : 'arrow-right-circle')}"></i> ${d.msg}`;
      document.getElementById('provSteps').appendChild(li);
    }
    if (d.done || d.error) {
      es.close();
      document.getElementById('provDoneBtn').style.display = 'block';
      if (!d.error) loadTenants();
    }
  };
  es.onerror = () => {
    es.close();
    document.getElementById('provMsg').textContent = 'Error de conexión — revisa el servidor';
    document.getElementById('provDoneBtn').style.display = 'block';
  };
}

/* ── Regenerar archivos de config del tenant ─────────────────────────────────── */
async function regenerateConfig(tenantId, name) {
  if (!confirm(`¿Regenerar los archivos de configuración de "${name}"?\nEsto sobreescribirá config.js e integrations.js del cliente.`)) return;
  try {
    const r = await fetch(`/api/admin/tenants/${tenantId}/regenerate-config`, {
      method: 'POST', credentials: 'include',
      headers: { 'Content-Type': 'application/json' }
    });
    const j = await r.json();
    if (!r.ok) throw new Error(j.message || j.error || 'Error');
    toast(`Archivos de config regenerados para "${name}"`, 'ok');
  } catch (e) { toast(e.message, 'err'); }
}

/* ── Suspender / reactivar ─────────────────────────────────────────────── */
async function toggleStatus(tenantId, action, name) {
  const confirmMsg = action === 'suspend'
    ? `¿Suspender el cliente "${name}"? Sus usuarios no podrán acceder.`
    : `¿Reactivar el cliente "${name}"?`;
  if (!confirm(confirmMsg)) return;
  try {
    const r = await fetch(`/api/admin/tenants/${tenantId}/status`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ action }),
    });
    const j = await r.json();
    if (!r.ok) throw new Error(j.message || 'Error');
    toast(action === 'suspend' ? `"${name}" suspendido` : `"${name}" reactivado`, 'ok');
    await loadTenants();
  } catch (e) { toast(e.message, 'err'); }
}

/* ── Eliminar cliente ─────────────────────────────────────────────────── */
let _delTenantId = null;

function openDelete(tenantId, name) {
  _delTenantId = tenantId;
  document.getElementById('delTenantName').textContent = name;
  document.getElementById('delPassword').value = '';
  const errEl = document.getElementById('delError');
  errEl.style.display = 'none'; errEl.textContent = '';
  const btn = document.getElementById('btnConfirmDelete');
  btn.disabled = false;
  btn.innerHTML = '<i class="bi bi-trash3-fill"></i> Eliminar permanentemente';
  openModal('modalDelete');
  setTimeout(() => document.getElementById('delPassword').focus(), 150);
}

async function confirmDelete() {
  const password = document.getElementById('delPassword').value;
  const errEl = document.getElementById('delError');
  errEl.style.display = 'none';

  if (!password) {
    errEl.textContent = 'Ingresa tu contraseña para confirmar.';
    errEl.style.display = 'block';
    return;
  }

  const btn = document.getElementById('btnConfirmDelete');
  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Eliminando...';

  try {
    const r = await fetch(`/api/admin/tenants/${_delTenantId}`, {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ password }),
    });
    const j = await r.json();
    if (!r.ok) throw new Error(j.message || j.error || 'Error al eliminar');
    closeModal('modalDelete');
    toast(j.message || 'Cliente eliminado', 'ok');
    await loadTenants();
  } catch (e) {
    errEl.textContent = e.message;
    errEl.style.display = 'block';
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-trash3-fill"></i> Eliminar permanentemente';
  }
}

