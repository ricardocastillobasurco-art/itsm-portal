          <th>Nuevos usuarios 30d</th><th>Usuarios totales</th>
        </tr></thead>
        <tbody id="actTbody"><tr><td colspan="7" style="text-align:center;padding:20px;color:var(--muted);">Cargando...</td></tr></tbody>
      </table>
