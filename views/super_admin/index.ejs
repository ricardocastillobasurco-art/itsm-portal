          <div><label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">Username</label>
            <input id="uUsername" type="text" placeholder="jgarcia" style="width:100%;box-sizing:border-box;padding:8px 10px;border:1px solid var(--border);border-radius:8px;background:var(--card);color:var(--text);font-size:13px;"></div>
          <div><label style="font-size:11px;font-weight:600;color:var(--text2);display:block;margin-bottom:4px;">Rol</label>
