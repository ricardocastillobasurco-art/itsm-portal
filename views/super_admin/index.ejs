/* ── Descarga CSV — convierte a data:URI para evitar bloqueo de Chrome en HTTPS autofirmado ── */
function downloadTemplate() {
  var sec  = document.getElementById('importSection').value || 'users';
  var csv  = CSV_TEMPLATES[sec];
  if (!csv) { alert('Plantilla no disponible para esta seccion.'); return; }
  var btn  = document.getElementById('templateDownload');
  var file = btn.getAttribute('data-file') || ('plantilla_' + sec + '.csv');
  var uri  = 'data:text/csv;charset=utf-8,%EF%BB%BF' + encodeURIComponent(csv);
  var a    = document.createElement('a');
  a.setAttribute('href', uri);
  a.setAttribute('download', file);
  a.style.display = 'none';
  document.body.appendChild(a);
  a.click();
  setTimeout(function(){ document.body.removeChild(a); }, 100);
}

