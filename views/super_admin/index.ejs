<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<script>(function(){const t=localStorage.getItem('dashboardTheme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Super Admin · IT Platform</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<style>
:root,[data-theme="light"]{
  --bg:#f1f5f9;--card:#fff;--border:#e2e8f0;--border-s:#cbd5e1;
  --text:#0f172a;--text2:#1e293b;--muted:#64748b;--muted2:#94a3b8;
  --primary:#2563eb;--primary-d:rgba(37,99,235,.1);
  --success:#059669;--warn:#d97706;--danger:#dc2626;--purple:#7c3aed;
  --sh:0 1px 3px rgba(0,0,0,.08),0 4px 12px rgba(0,0,0,.04);
  --nav:#fff;--radius:12px;--navbar-h:52px;
}
[data-theme="dark"]{
  --bg:#080d1c;--card:#111827;--border:#1e293b;--border-s:#2d3f55;
  --text:#f1f5f9;--text2:#e2e8f0;--muted:#94a3b8;--muted2:#64748b;
  --primary:#3b82f6;--primary-d:rgba(59,130,246,.14);
  --success:#10b981;--warn:#f59e0b;--danger:#ef4444;--purple:#8b5cf6;
  --sh:0 1px 3px rgba(0,0,0,.4),0 4px 12px rgba(0,0,0,.3);
  --nav:rgba(8,13,28,.97);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',-apple-system,sans-serif;font-size:14px;line-height:1.6;-webkit-font-smoothing:antialiased;}
a{text-decoration:none;color:inherit;}
button{font-family:inherit;cursor:pointer;border:none;background:none;}

/* ── Navbar ─────────────────────────────────────────────────────────── */
.navbar{position:fixed;top:0;left:0;right:0;z-index:500;height:var(--navbar-h);display:flex;align-items:center;gap:10px;padding:0 20px;background:var(--nav);border-bottom:1px solid var(--border);backdrop-filter:blur(12px);}
.nav-logo{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:800;color:var(--primary);}
.nav-logo i{font-size:18px;}
.nav-badge{font-size:9px;font-weight:800;padding:2px 7px;border-radius:20px;background:linear-gradient(135deg,#7c3aed,#e11d48);color:#fff;letter-spacing:.5px;text-transform:uppercase;}
.nav-divider{width:1px;height:18px;background:var(--border);}
.nav-bc{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px;}
.nav-bc a{color:var(--muted);font-weight:500;transition:color .15s;}
.nav-bc a:hover{color:var(--primary);}
.nav-bc .sep{opacity:.4;}
.nav-space{flex:1;}
.nav-theme{display:flex;align-items:center;gap:5px;padding:5px 10px;border-radius:8px;cursor:pointer;transition:background .15s;}
.nav-theme:hover{background:var(--bg);}
.nav-user{display:flex;align-items:center;gap:6px;padding:4px 10px 4px 6px;border-radius:20px;background:var(--bg);border:1px solid var(--border);font-size:12px;font-weight:600;color:var(--text2);}
.nav-av{width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,#7c3aed,#e11d48);display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;font-weight:800;flex-shrink:0;}
.nav-exit{display:flex;align-items:center;gap:5px;padding:5px 12px;border-radius:6px;font-size:12px;font-weight:600;color:var(--muted);transition:all .15s;}
.nav-exit:hover{color:var(--danger);background:rgba(220,38,38,.06);}

/* ── Layout ─────────────────────────────────────────────────────────── */
.page{margin-top:var(--navbar-h);padding:24px;max-width:1280px;margin-left:auto;margin-right:auto;}

/* ── Stats strip ────────────────────────────────────────────────────── */
.stats-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;}
@media(max-width:700px){.stats-strip{grid-template-columns:repeat(2,1fr);}}
.stat-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:16px 20px;box-shadow:var(--sh);position:relative;overflow:hidden;}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;}
.sc-total::before{background:linear-gradient(90deg,#2563eb,#60a5fa);}
.sc-active::before{background:linear-gradient(90deg,#059669,#6ee7b7);}
.sc-trial::before{background:linear-gradient(90deg,#d97706,#fcd34d);}
.sc-suspended::before{background:linear-gradient(90deg,#dc2626,#fca5a5);}
.stat-val{font-size:28px;font-weight:800;color:var(--text);line-height:1;}
.stat-lbl{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);margin-top:3px;}

/* ── Section header ─────────────────────────────────────────────────── */
.sec-head{display:flex;align-items:center;gap:12px;margin-bottom:16px;}
.sec-title{font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--muted2);flex:1;}
.sec-line{flex:1;height:1px;background:var(--border);}
.btn-primary{display:inline-flex;align-items:center;gap:6px;background:var(--primary);color:#fff;font-size:13px;font-weight:700;padding:8px 16px;border-radius:8px;transition:opacity .15s;}
.btn-primary:hover{opacity:.9;}
.btn-outline{display:inline-flex;align-items:center;gap:6px;background:var(--card);color:var(--muted);font-size:12px;font-weight:600;padding:6px 12px;border:1px solid var(--border);border-radius:7px;transition:all .15s;}
.btn-outline:hover{color:var(--text);border-color:var(--border-s);}
.btn-danger{background:rgba(220,38,38,.08);color:var(--danger);border-color:rgba(220,38,38,.2);}
.btn-danger:hover{background:rgba(220,38,38,.15);}
.btn-success{background:rgba(5,150,105,.08);color:var(--success);border-color:rgba(5,150,105,.2);}
.btn-success:hover{background:rgba(5,150,105,.15);}

/* ── Tenant grid ────────────────────────────────────────────────────── */
#tenantGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px;}
.tenant-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;box-shadow:var(--sh);transition:transform .2s,box-shadow .2s;}
.tenant-card:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.1);}
.tc-head{display:flex;align-items:flex-start;gap:12px;margin-bottom:14px;}
.tc-icon{width:42px;height:42px;border-radius:10px;background:var(--primary-d);display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--primary);flex-shrink:0;}
.tc-info{flex:1;min-width:0;}
.tc-name{font-size:15px;font-weight:800;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tc-slug{font-size:11px;color:var(--muted);font-family:monospace;margin-top:1px;}
.tc-domain{font-size:11px;color:var(--muted);margin-top:2px;display:flex;align-items:center;gap:4px;}
.tc-badges{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;}
.badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:700;letter-spacing:.2px;}
.badge-trial{background:rgba(217,119,6,.12);color:#d97706;}
.badge-starter{background:rgba(37,99,235,.1);color:#2563eb;}
.badge-professional{background:rgba(124,58,237,.1);color:#7c3aed;}
.badge-enterprise{background:rgba(5,150,105,.1);color:#059669;}
.badge-active{background:rgba(5,150,105,.1);color:#059669;}
.badge-suspended{background:rgba(220,38,38,.1);color:#dc2626;}
.tc-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;}
.tc-stat{background:var(--bg);border-radius:8px;padding:8px 12px;display:flex;align-items:center;gap:8px;}
.tc-stat i{font-size:14px;color:var(--muted);}
.tc-stat-val{font-size:14px;font-weight:700;color:var(--text);}
.tc-stat-lbl{font-size:10px;color:var(--muted);}
.tc-date{font-size:11px;color:var(--muted2);margin-bottom:14px;}
.tc-actions{display:flex;gap:6px;flex-wrap:wrap;border-top:1px solid var(--border);padding-top:14px;}

/* ── Loading / empty ────────────────────────────────────────────────── */
.skeleton{background:var(--border);border-radius:8px;animation:pulse 1.5s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.4;}}
.empty-state{text-align:center;padding:60px 20px;color:var(--muted);}
.empty-state i{font-size:48px;margin-bottom:12px;display:block;opacity:.3;}

/* ── Modal base ─────────────────────────────────────────────────────── */
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;padding:20px;}
.modal-bg.open{display:flex;}
.modal{background:var(--card);border:1px solid var(--border);border-radius:16px;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.3);}
.modal-head{display:flex;align-items:center;justify-content:space-between;padding:20px 24px 0;}
.modal-title{font-size:16px;font-weight:800;color:var(--text);}
.modal-close{width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;color:var(--muted);transition:all .15s;}
.modal-close:hover{background:var(--bg);color:var(--text);}
.modal-body{padding:20px 24px;}
.modal-footer{padding:0 24px 20px;display:flex;justify-content:flex-end;gap:10px;border-top:1px solid var(--border);padding-top:16px;}
.modal-box{background:var(--card);border:1px solid var(--border);border-radius:16px;width:100%;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.3);}
.modal-header{display:flex;align-items:center;justify-content:space-between;padding:20px 24px 16px;border-bottom:1px solid var(--border);}
.modal-sub{font-size:12px;color:var(--muted);margin-top:2px;}

/* ── Form elements ─────────────────────────────────────────────────── */
.form-group{margin-bottom:16px;}
.form-label{display:block;font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px;}
.form-input{width:100%;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:9px 12px;font-size:14px;color:var(--text);font-family:inherit;transition:border-color .15s;}
.form-input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-d);}
.form-hint{font-size:11px;color:var(--muted2);margin-top:4px;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
select.form-input{cursor:pointer;}

/* ── Import preview ─────────────────────────────────────────────────── */
.preview-table-wrap{overflow-x:auto;border-radius:8px;border:1px solid var(--border);max-height:200px;overflow-y:auto;}
.preview-table{width:100%;border-collapse:collapse;font-size:12px;}
.preview-table th{background:var(--bg);padding:7px 10px;text-align:left;font-weight:700;color:var(--muted);border-bottom:1px solid var(--border);position:sticky;top:0;}
.preview-table td{padding:6px 10px;border-bottom:1px solid var(--border);color:var(--text2);white-space:nowrap;max-width:180px;overflow:hidden;text-overflow:ellipsis;}
.preview-table tr:last-child td{border-bottom:none;}
.import-counter{font-size:13px;color:var(--muted);margin:10px 0;display:flex;align-items:center;gap:6px;}
.import-results{background:var(--bg);border-radius:8px;padding:14px;margin-top:12px;}
.res-row{display:flex;align-items:center;gap:8px;font-size:13px;margin-bottom:4px;}
.res-row:last-child{margin-bottom:0;}
.errors-list{max-height:120px;overflow-y:auto;margin-top:10px;font-size:12px;color:var(--danger);}
.errors-list div{padding:3px 0;border-bottom:1px dashed var(--border);}
.file-drop{border:2px dashed var(--border);border-radius:10px;padding:28px;text-align:center;cursor:pointer;transition:all .2s;color:var(--muted);}
.file-drop:hover,.file-drop.drag{border-color:var(--primary);background:var(--primary-d);}
.file-drop strong{font-size:13px;color:var(--text);}
.section-card{background:var(--bg);border:2px solid var(--border);border-radius:10px;padding:14px 16px;cursor:pointer;transition:all .15s;text-align:left;}
.section-card:hover{border-color:var(--border-s);background:var(--card);}
.section-card.active{border-color:var(--primary);background:var(--primary-d);}
.col-pill{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;margin:2px;}
.col-pill.req{background:rgba(37,99,235,.1);color:#2563eb;}
.col-pill.opt{background:var(--bg);color:var(--muted);border:1px solid var(--border);}
.template-link{display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--primary);font-weight:600;cursor:pointer;}
.template-link:hover{text-decoration:underline;}

/* ── Feature toggle switch ────────────────────────────────────────────── */
.feat-toggle{position:relative;display:inline-block;width:40px;height:22px;flex-shrink:0;cursor:pointer;}
.feat-toggle input{opacity:0;width:0;height:0;position:absolute;}
.feat-track{position:absolute;inset:0;border-radius:11px;background:var(--border-s);transition:background .2s;}
.feat-toggle input:checked ~ .feat-track{background:var(--primary);}
.feat-knob{position:absolute;width:16px;height:16px;border-radius:50%;background:#fff;top:3px;left:3px;transition:transform .2s;box-shadow:0 1px 3px rgba(0,0,0,.2);}
.feat-toggle input:checked ~ .feat-track .feat-knob{transform:translateX(18px);}

/* ── Health bar ─────────────────────────────────────────────────────── */
.health-bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:var(--card);border:1px solid var(--border);border-radius:10px;padding:10px 16px;margin-bottom:20px;box-shadow:var(--sh);}
.hb-chip{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;padding:4px 10px;border-radius:20px;background:var(--bg);border:1px solid var(--border);color:var(--text2);}
.hb-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.hb-ok{background:#10b981;}.hb-warn{background:#f59e0b;}.hb-err{background:#ef4444;}
.hb-divider{width:1px;height:20px;background:var(--border);}
.hb-label{font-size:11px;color:var(--muted);font-weight:500;margin-right:2px;}

/* ── Activity table ─────────────────────────────────────────────────── */
.activity-wrap{background:var(--card);border:1px solid var(--border);border-radius:12px;margin-bottom:20px;box-shadow:var(--sh);overflow:hidden;}
.activity-head{display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-bottom:1px solid var(--border);cursor:pointer;user-select:none;}
.activity-head:hover{background:var(--bg);}
.activity-title{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.7px;color:var(--muted2);display:flex;align-items:center;gap:7px;}
.act-table{width:100%;border-collapse:collapse;font-size:12px;}
.act-table th{padding:8px 14px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted2);border-bottom:1px solid var(--border);background:var(--bg);}
.act-table td{padding:9px 14px;border-bottom:1px solid var(--border);color:var(--text2);}
.act-table tr:last-child td{border-bottom:none;}
.act-table tr:hover td{background:var(--bg);}
.act-bar{height:5px;border-radius:3px;background:var(--border);overflow:hidden;margin-top:3px;min-width:60px;}
.act-bar-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,#2563eb,#60a5fa);transition:width .4s;}
.act-badge{display:inline-flex;align-items:center;padding:2px 7px;border-radius:10px;font-size:10px;font-weight:700;}

/* ── Quota bar en tarjetas ──────────────────────────────────────────── */
.quota-wrap{margin-bottom:12px;display:flex;flex-direction:column;gap:5px;}
.quota-row{display:flex;align-items:center;gap:8px;}
.quota-lbl{font-size:10px;font-weight:600;color:var(--muted);width:56px;flex-shrink:0;}
.quota-bar{flex:1;height:5px;border-radius:3px;background:var(--border);overflow:hidden;}
.quota-fill{height:100%;border-radius:3px;transition:width .4s;}
.quota-ok{background:linear-gradient(90deg,#10b981,#6ee7b7);}
.quota-warn{background:linear-gradient(90deg,#d97706,#fcd34d);}
.quota-over{background:linear-gradient(90deg,#dc2626,#f87171);}
.quota-num{font-size:10px;color:var(--muted);white-space:nowrap;min-width:40px;text-align:right;}

/* ── Billing modal ──────────────────────────────────────────────────── */
.bill-row{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:8px;border:1px solid var(--border);background:var(--bg);font-size:12px;}
.bill-status{padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;}
.bill-paid{background:rgba(5,150,105,.12);color:#059669;}
.bill-pending{background:rgba(217,119,6,.12);color:#d97706;}
.bill-overdue{background:rgba(220,38,38,.12);color:#dc2626;}

/* ── Toast ──────────────────────────────────────────────────────────── */
#toast{position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:8px;pointer-events:none;}
.toast-item{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:12px 16px;box-shadow:0 4px 16px rgba(0,0,0,.2);font-size:13px;font-weight:600;display:flex;align-items:center;gap:8px;pointer-events:auto;animation:slideIn .3s ease;}
@keyframes slideIn{from{transform:translateX(100%);opacity:0;}to{transform:translateX(0);opacity:1;}}
.toast-ok{border-left:3px solid var(--success);color:var(--success);}
.toast-err{border-left:3px solid var(--danger);color:var(--danger);}
.toast-info{border-left:3px solid var(--primary);color:var(--primary);}
</style>
</head>
<body>

<!-- ══ NAVBAR ════════════════════════════════════════════════════════════ -->
<nav class="navbar">
  <div class="nav-logo"><i class="bi bi-shield-lock-fill"></i> IT Platform</div>
  <span class="nav-badge">SUPER ADMIN</span>
  <div class="nav-divider"></div>
  <div class="nav-bc">
    <a href="/administracion"><i class="bi bi-grid-1x2-fill"></i> Admin</a>
    <span class="sep">/</span>
    <span>Clientes SaaS</span>
  </div>
  <div class="nav-space"></div>
  <button class="nav-theme" onclick="toggleTheme()" title="Cambiar tema">
    <div id="themeTrack" style="width:28px;height:16px;border-radius:8px;background:#cbd5e1;position:relative;transition:background .3s;"><div id="themeKnob" style="width:12px;height:12px;border-radius:50%;background:#fff;position:absolute;top:2px;left:2px;transition:transform .3s;"></div></div>
    <i id="toggleIcon" class="bi bi-moon-stars-fill" style="font-size:13px;color:var(--muted);"></i>
  </button>
  <div class="nav-user">
    <div class="nav-av"><%= (user?.full_name||user?.username||'A')[0].toUpperCase() %></div>
    <span><%= user?.full_name || user?.username || 'Admin' %></span>
  </div>
  <a href="/logout" class="nav-exit"><i class="bi bi-box-arrow-right"></i> Salir</a>
</nav>

<!-- ══ CONTENIDO ════════════════════════════════════════════════════════ -->
<div class="page" style="margin-top:calc(var(--navbar-h) + 24px);">

  <!-- Stats -->
  <div class="stats-strip" id="statsStrip">
    <div class="stat-card sc-total"><div class="stat-val" id="st-total">—</div><div class="stat-lbl">Total Clientes</div></div>
    <div class="stat-card sc-active"><div class="stat-val" id="st-active">—</div><div class="stat-lbl">Activos</div></div>
    <div class="stat-card sc-trial"><div class="stat-val" id="st-trial">—</div><div class="stat-lbl">Plan Trial</div></div>
    <div class="stat-card sc-suspended"><div class="stat-val" id="st-suspended">—</div><div class="stat-lbl">Suspendidos</div></div>
  </div>

  <!-- Health bar -->
  <div class="health-bar" id="healthBar">
    <span style="font-size:11px;font-weight:700;color:var(--muted2);text-transform:uppercase;letter-spacing:.5px;">Estado</span>
    <div class="hb-divider"></div>
    <span class="hb-chip"><span class="hb-dot" id="hbDbDot" style="background:#94a3b8;"></span><span class="hb-label">BD</span><span id="hbDbTxt">—</span></span>
    <span class="hb-chip"><i class="bi bi-memory" style="font-size:11px;color:var(--muted);"></i><span class="hb-label">MEM</span><span id="hbMem">—</span></span>
    <span class="hb-chip"><i class="bi bi-clock" style="font-size:11px;color:var(--muted);"></i><span class="hb-label">UPTIME</span><span id="hbUptime">—</span></span>
    <div class="hb-divider"></div>
    <span class="hb-chip"><i class="bi bi-ticket-fill" style="font-size:11px;color:#2563eb;"></i><span class="hb-label">Tickets semana</span><span id="hbTickets">—</span></span>
    <span class="hb-chip"><i class="bi bi-people-fill" style="font-size:11px;color:#059669;"></i><span class="hb-label">Usuarios activos</span><span id="hbUsers">—</span></span>
    <span style="flex:1;"></span>
    <button onclick="loadHealth()" style="border:none;background:none;cursor:pointer;color:var(--muted);font-size:12px;" title="Actualizar"><i class="bi bi-arrow-clockwise"></i></button>
  </div>

  <!-- Activity panel -->
  <div class="activity-wrap" id="activityWrap">
    <div class="activity-head" onclick="toggleActivity()">
      <span class="activity-title"><i class="bi bi-bar-chart-fill"></i> Actividad por cliente <span id="actPeriod" style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--muted);">— últimos 7 / 30 días</span></span>
      <i class="bi bi-chevron-down" id="actChevron" style="color:var(--muted);transition:transform .2s;"></i>
