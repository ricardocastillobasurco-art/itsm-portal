}

function onSectionChange() {}

function resetFileDrop() {
  const fd = document.getElementById('fileDrop');
  if (!fd) return;
  fd.classList.remove('drag');
  fd.innerHTML = `<input type="file" id="csvFile" accept=".csv,.txt" style="display:none" onchange="onFileSelect(event)">
    <i class="bi bi-file-earmark-spreadsheet" style="font-size:32px;margin-bottom:8px;display:block;"></i>
    <strong>Haz clic aquí o arrastra tu archivo CSV</strong>
    <div style="font-size:12px;margin-top:6px;color:var(--muted2);">Formatos aceptados: .csv — Máximo 5000 filas</div>`;
  fd.onclick = () => document.getElementById('csvFile').click();
}

function handleDragOver(e)  { e.preventDefault(); document.getElementById('fileDrop').classList.add('drag'); }
function handleDragLeave()   { document.getElementById('fileDrop').classList.remove('drag'); }

function onFileDrop(e) {
  e.preventDefault();
  document.getElementById('fileDrop').classList.remove('drag');
  const file = e.dataTransfer.files[0];
  if (file) readCSVFile(file);
}

function onFileSelect(e) {
  const file = e.target.files[0];
  if (file) readCSVFile(file);
}

function readCSVFile(file) {
  const reader = new FileReader();
  reader.onload = ev => parseAndPreview(ev.target.result, file.name);
  reader.readAsText(file, 'UTF-8');
}

function parseCSV(text) {
  const lines = text.trim().split(/\r?\n/).filter(l => !l.trim().startsWith('sep='));
  if (lines.length < 2) return { headers: [], rows: [] };
  // Auto-detectar delimitador: si hay más ";" que "," en la primera línea, usar ";"
  const firstLine = lines[0];
  const delim = (firstLine.split(';').length > firstLine.split(',').length) ? ';' : ',';
  const headers = firstLine.split(delim).map(h => h.trim().replace(/^﻿/,'').replace(/^"|"$/g,'').toLowerCase().replace(/\s+/g,'_'));
  const rows = [];
  for (let i = 1; i < lines.length; i++) {
    const line = lines[i].trim();
    if (!line) continue;
    const vals = [];
    let cur = '', inQ = false;
    for (let c = 0; c < line.length; c++) {
      if (line[c] === '"') { inQ = !inQ; continue; }
      if (line[c] === delim && !inQ) { vals.push(cur.trim()); cur = ''; continue; }
      cur += line[c];
    }
    vals.push(cur.trim());
    const row = {};
    headers.forEach((h, idx) => row[h] = vals[idx] || '');
    rows.push(row);
  }
  return { headers, rows };
}

function parseAndPreview(text, filename) {
  const { headers, rows } = parseCSV(text);
  _csvHeaders = headers;
  _csvRows    = rows;

  // Actualizar el file drop
  document.getElementById('fileDrop').innerHTML = `<input type="file" id="csvFile" accept=".csv,.txt" style="display:none" onchange="onFileSelect(event)">
    <i class="bi bi-file-check-fill" style="font-size:32px;color:var(--success);margin-bottom:8px;display:block;"></i>
    <strong style="color:var(--success);">${filename}</strong>
    <div style="font-size:12px;margin-top:6px;color:var(--muted2);">${rows.length} filas detectadas · Haz clic para cambiar el archivo</div>`;
  document.getElementById('fileDrop').onclick = () => document.getElementById('csvFile').click();

  // Preview tabla (primeras 5 filas)
  const preview = rows.slice(0, 5);
  let tableHTML = `<table class="preview-table"><thead><tr>${headers.map(h=>`<th>${escHtml(h)}</th>`).join('')}</tr></thead><tbody>`;
  preview.forEach(row => {
    tableHTML += `<tr>${headers.map(h=>`<td>${escHtml(row[h]||'')}</td>`).join('')}</tr>`;
  });
  tableHTML += '</tbody></table>';
  document.getElementById('previewTableWrap').innerHTML = tableHTML;
  document.getElementById('previewArea').style.display = 'block';
  document.getElementById('importCounter').innerHTML = `<i class="bi bi-table"></i> <strong>${rows.length}</strong> filas listas para importar`;
  document.getElementById('importResultArea').style.display = 'none';

  if (rows.length > 0) {
    const btnImport = document.getElementById('btnImport');
    btnImport.style.display = 'inline-flex';
    document.getElementById('btnImportCount').textContent = rows.length;
  }
}

async function doImport() {
  if (!_importId || !_csvRows.length) return;
  const section = document.getElementById('importSection').value;
  const btn = document.getElementById('btnImport');
  btn.disabled = true;
  btn.innerHTML = '<i class="bi bi-arrow-clockwise" style="animation:spin 1s linear infinite;display:inline-block;"></i> Importando...';

  try {
    const r = await fetch(`/api/admin/tenants/${_importId}/import`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ section, rows: _csvRows }),
    });
    const j = await r.json();
    if (!r.ok) throw new Error(j.message || 'Error en la importación');
    const res = j.data || j;
    const ra = document.getElementById('importResultArea');
    ra.style.display = 'block';
    ra.innerHTML = `
      <div class="import-results">
        <div class="res-row"><i class="bi bi-check-circle-fill" style="color:var(--success);"></i><span><strong>${res.inserted}</strong> registros importados</span></div>
        <div class="res-row"><i class="bi bi-skip-forward-fill" style="color:var(--warn);"></i><span><strong>${res.skipped}</strong> filas omitidas</span></div>
        <div class="res-row"><i class="bi bi-hash" style="color:var(--muted);"></i><span>Total procesado: <strong>${res.total}</strong></span></div>
        ${res.errors?.length ? `<div class="errors-list">${res.errors.slice(0,20).map(e=>`<div>Fila ${e.row}: ${escHtml(e.error)}</div>`).join('')}${res.errors.length>20?`<div>...y ${res.errors.length-20} más</div>`:''}</div>` : ''}
      </div>`;
    toast(`Importación completada: ${res.inserted} registros`, 'ok');
    btn.style.display = 'none';
    await loadTenants();
  } catch (e) {
    toast(e.message, 'err');
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-cloud-upload"></i> Importar <span id="btnImportCount">' + _csvRows.length + '</span> filas';
  }
}

/* ── Export dropdown ───────────────────────────────────────────────────── */
function toggleExportMenu(id, btn) {
  const menu = document.getElementById(`exp-${id}`);
  const allMenus = document.querySelectorAll('[id^="exp-"]');
  allMenus.forEach(m => { if (m !== menu) m.style.display = 'none'; });
  menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
}
document.addEventListener('click', e => {
  if (!e.target.closest('[id^="exp-"]') && !e.target.closest('button')) {
    document.querySelectorAll('[id^="exp-"]').forEach(m => m.style.display = 'none');
  }
});

