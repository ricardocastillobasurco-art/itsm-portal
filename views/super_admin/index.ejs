async function openFeatures(tenantId, name) {
  _featTenantId = tenantId;
  document.getElementById('featuresTenantName').textContent = name;
  document.getElementById('featuresGrid').innerHTML =
    '<div style="text-align:center;padding:20px;color:var(--muted);"><i class="bi bi-arrow-clockwise" style="animation:spin 1s linear infinite;display:inline-block;font-size:20px;"></i></div>';
  openModal('modalFeatures');
  try {
    const r = await fetch(`/api/admin/tenants/${tenantId}/features`, { credentials: 'include' });
    const j = await r.json();
    _featState = j.data || {};
    renderFeaturesGrid();
  } catch (e) {
    document.getElementById('featuresGrid').innerHTML = '<p style="color:var(--danger);">Error cargando módulos</p>';
  }
}

function renderFeaturesGrid() {
  document.getElementById('featuresGrid').innerHTML = FEATURE_CATALOG.map(f => {
    const rec       = _featState[f.key];
    const enabled   = rec !== undefined ? rec.enabled : (FEAT_DEFAULTS[f.key] ?? false);
    const hasSchema = !!INTEGRATION_SCHEMAS[f.key];
    return `
    <div style="background:var(--bg);border-radius:10px;border:1px solid var(--border);overflow:hidden;">
      <div style="display:flex;align-items:center;gap:14px;padding:12px 14px;">
        <div style="width:36px;height:36px;border-radius:8px;background:${f.color}1a;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i class="bi ${f.icon}" style="color:${f.color};font-size:16px;"></i>
        </div>
        <div style="flex:1;min-width:0;">
          <div style="font-size:13px;font-weight:700;color:var(--text);">${f.label}</div>
          <div style="font-size:11px;color:var(--muted);margin-top:1px;">${f.desc}</div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
          ${hasSchema ? `<button onclick="toggleConfigForm('${f.key}')" style="padding:4px 8px;border-radius:6px;border:1px solid var(--border);background:var(--card);color:var(--muted);font-size:11px;font-weight:600;cursor:pointer;transition:all .15s;" title="Configurar URI y credenciales"><i class="bi bi-sliders"></i></button>` : ''}
          <label class="feat-toggle" title="${enabled?'Desactivar':'Activar'} ${f.label}">
            <input type="checkbox" ${enabled?'checked':''} onchange="toggleFeature('${f.key}',this.checked)">
            <span class="feat-track"><span class="feat-knob"></span></span>
          </label>
        </div>
      </div>
      ${hasSchema ? `<div id="fcfg-${f.key}" style="display:none;border-top:1px solid var(--border);padding:14px;background:var(--card);">${renderCfgFields(f.key, rec?.config||{})}</div>` : ''}
    </div>`;
  }).join('');
}

function renderCfgFields(key, config) {
  const schema = INTEGRATION_SCHEMAS[key];
  if (!schema) return '';
  const fields = schema.fields.map(f => {
    const raw = config[f.key] || '';
    const val = (f.sensitive && raw) ? '••••••• (guardado)' : raw;
    return `<div style="margin-bottom:10px;">
      <label style="display:block;font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;">
        ${f.label}${f.required?'<span style="color:var(--danger);margin-left:2px;">*</span>':''}
      </label>
      <input id="sacfg-${key}-${f.key}" type="${f.type==='password'?'password':'text'}"
        class="form-input" placeholder="${f.placeholder}" value="${escHtml(val)}">
    </div>`;
  }).join('');
  return `${fields}<button onclick="saveFeatureConfig('${key}')"
    style="width:100%;padding:8px;border-radius:7px;background:var(--primary);color:#fff;font-size:12px;font-weight:700;border:none;cursor:pointer;margin-top:2px;">
    <i class="bi bi-floppy-fill"></i> Guardar configuración
  </button>`;
}

function toggleConfigForm(key) {
  const el = document.getElementById(`fcfg-${key}`);
  if (el) el.style.display = el.style.display === 'none' ? '' : 'none';
}

async function saveFeatureConfig(key) {
  const schema = INTEGRATION_SCHEMAS[key];
  const config = {};
  for (const f of schema.fields) {
    const el = document.getElementById(`sacfg-${key}-${f.key}`);
    if (el) config[f.key] = el.value;
  }
  try {
    const feat = _featState[key] || {};
    const r = await fetch(`/api/admin/tenants/${_featTenantId}/features/${key}`, {
      method: 'PUT', headers: {'Content-Type':'application/json'}, credentials: 'include',
      body: JSON.stringify({ enabled: feat.enabled ?? false, config }),
    });
    const j = await r.json();
    if (!r.ok) throw new Error(j.message || 'Error');
    if (!_featState[key]) _featState[key] = {};
    _featState[key].config = config;
    document.getElementById(`fcfg-${key}`).style.display = 'none';
    toast(`${schema.label}: configuración guardada`, 'ok');
  } catch (e) { toast(e.message, 'err'); }
}

