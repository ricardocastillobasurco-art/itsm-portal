      <i class="bi bi-megaphone-fill"></i> Comunicado
    </button>
    <button class="btn-primary" onclick="openModal('modalNew')">
      <i class="bi bi-plus-lg"></i> Nuevo Cliente
    </button>
  </div>

  <!-- Grid -->
  <div id="tenantGrid"><div style="text-align:center;padding:40px;color:var(--muted);"><i class="bi bi-arrow-clockwise" style="animation:spin 1s linear infinite;display:inline-block;font-size:24px;"></i></div></div>

</div>

<!-- ══ MODAL: NUEVO CLIENTE ════════════════════════════════════════════ -->
<div class="modal-bg" id="modalNew">
  <div class="modal">
    <div class="modal-head">
      <span class="modal-title"><i class="bi bi-plus-circle-fill" style="color:var(--primary);margin-right:6px;"></i>Nuevo Cliente</span>
      <button class="modal-close" onclick="closeModal('modalNew')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Nombre de la empresa *</label>
          <input id="newName" class="form-input" placeholder="Ej: Petrotal S.A.C." oninput="autoSlug()">
        </div>
        <div class="form-group">
          <label class="form-label">Slug (URL único) *</label>
          <input id="newSlug" class="form-input" placeholder="petrotal" style="font-family:monospace;">
          <div class="form-hint">Solo letras, números y guiones</div>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Dominio de correo</label>
          <input id="newDomain" class="form-input" placeholder="petrotal.com.pe">
          <div class="form-hint">@dominio.com para identificar usuarios</div>
        </div>
        <div class="form-group">
          <label class="form-label">Email de contacto</label>
          <input id="newEmail" class="form-input" type="email" placeholder="admin@petrotal.com.pe">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Plan inicial</label>
        <select id="newPlan" class="form-input">
          <option value="trial">Trial (30 días gratis)</option>
          <option value="starter">Starter</option>
          <option value="professional">Professional</option>
          <option value="enterprise">Enterprise</option>
        </select>
      </div>
      <!-- Módulos del cliente -->
      <div class="form-group" style="margin-bottom:4px;">
        <label class="form-label">Integraciones del cliente</label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
          <label style="display:flex;align-items:center;gap:8px;padding:9px 12px;border:1.5px solid var(--border);border-radius:8px;cursor:pointer;font-size:13px;font-weight:500;color:var(--text2);background:var(--bg);transition:border-color .15s;" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--border)'">
            <input type="checkbox" id="featJira" style="accent-color:var(--primary);width:15px;height:15px;">
            <i class="bi bi-ticket-fill" style="color:#0052cc;"></i> Jira
          </label>
          <label style="display:flex;align-items:center;gap:8px;padding:9px 12px;border:1.5px solid var(--border);border-radius:8px;cursor:pointer;font-size:13px;font-weight:500;color:var(--text2);background:var(--bg);transition:border-color .15s;" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--border)'">
            <input type="checkbox" id="featMicrosoft" style="accent-color:var(--primary);width:15px;height:15px;">
            <i class="bi bi-microsoft" style="color:#0078d4;"></i> Microsoft (Teams/Intune)
          </label>
          <label style="display:flex;align-items:center;gap:8px;padding:9px 12px;border:1.5px solid var(--border);border-radius:8px;cursor:pointer;font-size:13px;font-weight:500;color:var(--text2);background:var(--bg);transition:border-color .15s;" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--border)'">
            <input type="checkbox" id="featPrint" style="accent-color:var(--primary);width:15px;height:15px;">
            <i class="bi bi-printer-fill" style="color:#64748b;"></i> Cola de Impresión
          </label>
          <label style="display:flex;align-items:center;gap:8px;padding:9px 12px;border:1.5px solid var(--border);border-radius:8px;cursor:pointer;font-size:13px;font-weight:500;color:var(--text2);background:var(--bg);transition:border-color .15s;" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--border)'">
            <input type="checkbox" id="featAzure" style="accent-color:var(--primary);width:15px;height:15px;">
            <i class="bi bi-shield-lock-fill" style="color:#7c3aed;"></i> Azure AD (SSO)
          </label>
        </div>
        <div class="form-hint" style="margin-top:6px;"><i class="bi bi-info-circle"></i> Sistema local TK- siempre activo. Integraciones configurables luego.</div>
      </div>
      <div id="newError" style="font-size:13px;color:var(--danger);margin-top:8px;display:none;"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-outline" onclick="closeModal('modalNew')">Cancelar</button>
      <button class="btn-primary" id="btnCreate" onclick="createTenant()">
        <i class="bi bi-plus-lg"></i> Crear Cliente
      </button>
    </div>
  </div>
</div>

<!-- ══ MODAL: PROVISIONING ══════════════════════════════════════════════ -->
<div id="modalProvision" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9999;align-items:center;justify-content:center;">
  <div style="background:var(--card);border-radius:18px;padding:36px 32px;max-width:480px;width:94%;box-shadow:0 20px 60px rgba(0,0,0,.25);">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
      <div style="width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#2563eb,#7c3aed);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="bi bi-cpu-fill" style="color:#fff;font-size:20px;"></i></div>
      <div>
        <div style="font-size:16px;font-weight:800;color:var(--text);">Configurando entorno</div>
        <div style="font-size:12px;color:var(--muted);" id="provName">Nuevo cliente</div>
      </div>
    </div>
    <!-- Barra de progreso -->
    <div style="background:var(--border);border-radius:999px;height:10px;margin-bottom:6px;overflow:hidden;">
      <div id="provBar" style="height:100%;background:linear-gradient(90deg,#2563eb,#7c3aed);border-radius:999px;transition:width .4s ease;width:0%;"></div>
    </div>
    <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-bottom:18px;">
      <span id="provMsg" style="font-weight:600;">Iniciando...</span>
      <span id="provPct" style="font-weight:700;color:var(--primary);">0%</span>
    </div>
    <!-- Log de pasos -->
    <div id="provSteps" style="display:flex;flex-direction:column;gap:6px;max-height:200px;overflow-y:auto;font-size:12px;"></div>
    <button id="provDoneBtn" onclick="document.getElementById('modalProvision').style.display='none'"
      style="display:none;margin-top:22px;width:100%;padding:11px;background:linear-gradient(135deg,#059669,#10b981);color:#fff;border-radius:10px;font-size:14px;font-weight:700;border:none;cursor:pointer;">
      <i class="bi bi-check-circle-fill"></i> ¡Listo! Cerrar
    </button>
  </div>
</div>
<style>
.prov-step{display:flex;align-items:center;gap:7px;padding:5px 8px;border-radius:7px;background:var(--border);color:var(--muted);}
.prov-step i{flex-shrink:0;}
.prov-done{background:#d1fae5;color:#065f46;}
.prov-error{background:#fee2e2;color:#991b1b;}
</style>

<!-- ══ MODAL: IMPORTAR CSV ══════════════════════════════════════════════ -->
<div class="modal-bg" id="modalImport">
  <div class="modal" style="max-width:680px;">
    <div class="modal-head">
      <span class="modal-title"><i class="bi bi-cloud-upload-fill" style="color:var(--purple);margin-right:6px;"></i>Importar datos · <span id="importTenantName">—</span></span>
      <button class="modal-close" onclick="closeImport()"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body">

      <!-- PASO 1: Sección -->
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
        <div style="width:22px;height:22px;border-radius:50%;background:var(--primary);color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;">1</div>
        <span style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;">¿Qué tipo de datos vas a subir?</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:20px;" id="sectionCards">
        <div class="section-card active" onclick="selectSection('users',this)" data-sec="users">
          <i class="bi bi-people-fill" style="color:#2563eb;font-size:20px;margin-bottom:6px;display:block;"></i>
          <div style="font-size:13px;font-weight:700;color:var(--text);">Usuarios</div>
          <div style="font-size:11px;color:var(--muted);margin-top:2px;">Personal de TI del cliente</div>
        </div>
        <div class="section-card" onclick="selectSection('config_items',this)" data-sec="config_items">
          <i class="bi bi-laptop-fill" style="color:#d97706;font-size:20px;margin-bottom:6px;display:block;"></i>
          <div style="font-size:13px;font-weight:700;color:var(--text);">Equipos / Inventario</div>
          <div style="font-size:11px;color:var(--muted);margin-top:2px;">PCs, laptops, servidores</div>
        </div>
        <div class="section-card" onclick="selectSection('tickets',this)" data-sec="tickets">
          <i class="bi bi-ticket-fill" style="color:#dc2626;font-size:20px;margin-bottom:6px;display:block;"></i>
          <div style="font-size:13px;font-weight:700;color:var(--text);">Incidencias históricas</div>
          <div style="font-size:11px;color:var(--muted);margin-top:2px;">Tickets pasados (opcional)</div>
        </div>
        <div class="section-card" onclick="selectSection('kb_articles',this)" data-sec="kb_articles">
          <i class="bi bi-book-fill" style="color:#7c3aed;font-size:20px;margin-bottom:6px;display:block;"></i>
          <div style="font-size:13px;font-weight:700;color:var(--text);">Artículos de KB</div>
          <div style="font-size:11px;color:var(--muted);margin-top:2px;">Base de conocimiento</div>
        </div>
      </div>
      <input type="hidden" id="importSection" value="users">

      <!-- Info de columnas -->
      <div id="colInfo" style="background:var(--bg);border-radius:10px;padding:14px;margin-bottom:16px;border:1px solid var(--border);"></div>

      <!-- PASO 2: Plantilla + archivo -->
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
        <div style="width:22px;height:22px;border-radius:50%;background:var(--primary);color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;">2</div>
        <span style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;">Descarga la plantilla, llénala y súbela</span>
      </div>

      <div style="display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap;align-items:center;">
        <button id="templateDownload" data-href="/api/admin/tenants/template-csv/users" data-file="plantilla_users.csv" onclick="downloadTemplate()"
           style="display:inline-flex;align-items:center;gap:7px;background:var(--success);color:#fff;font-size:13px;font-weight:700;padding:9px 16px;border-radius:8px;border:none;cursor:pointer;transition:opacity .15s;">
          <i class="bi bi-file-earmark-arrow-down-fill"></i> Descargar plantilla CSV
        </button>
        <span style="font-size:12px;color:var(--muted);">→ Ábrela en Excel, llénala y guárdala como .csv</span>
      </div>

      <div class="file-drop" id="fileDrop" onclick="document.getElementById('csvFile').click()" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="onFileDrop(event)">
        <input type="file" id="csvFile" accept=".csv,.txt" style="display:none" onchange="onFileSelect(event)">
        <i class="bi bi-file-earmark-spreadsheet" style="font-size:32px;margin-bottom:8px;display:block;"></i>
        <strong>Haz clic aquí o arrastra tu archivo CSV</strong>
        <div style="font-size:12px;margin-top:6px;color:var(--muted2);">Formatos aceptados: .csv — Máximo 5000 filas</div>
      </div>

      <!-- PASO 3: Vista previa -->
      <div id="previewArea" style="display:none;margin-top:16px;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
          <div style="width:22px;height:22px;border-radius:50%;background:var(--success);color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;">3</div>
          <span style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;">Verifica que los datos se ven bien</span>
        </div>
        <div class="preview-table-wrap" id="previewTableWrap"></div>
        <div class="import-counter" id="importCounter" style="margin-top:10px;"></div>
      </div>

      <div id="importResultArea" style="display:none;margin-top:12px;"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-outline" onclick="closeImport()">Cerrar</button>
      <button class="btn-primary" id="btnImport" onclick="doImport()" style="display:none;">
        <i class="bi bi-cloud-upload"></i> Importar <span id="btnImportCount"></span> registros
      </button>
    </div>
  </div>
</div>

<!-- ══ MODAL: MÓDULOS / FEATURES ════════════════════════════════════════ -->
<div class="modal-bg" id="modalFeatures">
  <div class="modal" style="max-width:560px;">
