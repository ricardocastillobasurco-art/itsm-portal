const QUICK = [
  { name:'Autogestión',       path:'/autogestion',                   icon:'bi-house-heart-fill',        color:'#6366f1' },
  { name:'Mis Tickets',       path:'/portal/tickets',                icon:'bi-ticket-detailed-fill',    color:'#3b82f6' },
  { name:'Incidencias',       path:'/itsm/incidencias/gestion',      icon:'bi-exclamation-triangle-fill', color:'#ef4444' },
  { name:'Dashboard',         path:'/dashboard',                     icon:'bi-speedometer2',            color:'#10b981' },
  { name:'Reportes',          path:'/reports-itsm',                  icon:'bi-bar-chart-fill',          color:'#06b6d4' },
  { name:'Administración',    path:'/administracion',                icon:'bi-shield-lock-fill',        color:'#8b5cf6' },
];

// ── Ruta solicitada ────────────────────────────────────────────────────────
const requestedPath = '<%= (requestedPath || "/").replace(/'/g, "\\'") %>';
document.getElementById('tlPath').textContent = requestedPath;
document.getElementById('tlTime').textContent = new Date().toLocaleString('es-PE',{dateStyle:'medium',timeStyle:'short'});

// ── Terminal animada ───────────────────────────────────────────────────────
const termLines = [
  {delay:0,   html:'<span class="t-gray">$</span> <span class="t-green">itsm-router</span> resolve --path <span class="t-amber">"'+requestedPath+'"</span>'},
  {delay:400, html:'<span class="t-gray">→</span> Buscando en árbol de rutas... <span class="t-amber">⟳</span>'},
  {delay:900, html:'<span class="t-gray">→</span> Revisando alias y redirecciones...'},
  {delay:1400,html:'<span class="t-red">✗</span> <span class="t-white">ERROR 404:</span> <span class="t-red">Route not found</span>'},
  {delay:1800,html:'<span class="t-gray">$</span> <span class="t-blue">incident</span> open --code INC-404 --priority P1 --auto'},
  {delay:2200,html:'<span class="t-green">✓</span> Ticket <span class="t-purple">INC-404</span> creado · Agente asignado: <span class="t-green">Sistema Automático</span>'},
  {delay:2700,html:'<span class="t-gray">$</span> <span class="t-blue">recovery-page</span> render --suggestions --search-enabled <span class="cursor"></span>'},
];

const out = document.getElementById('termOutput');
termLines.forEach(function(l) {
  setTimeout(function() {
    var line = document.createElement('div');
    line.className = 'term-line';
    line.innerHTML = l.html;
    out.appendChild(line);
    // Quitar cursor del anterior
    out.querySelectorAll('.cursor').forEach(function(c,i,arr) { if (i < arr.length-1) c.remove(); });
  }, l.delay);
});

// ── Quick grid ─────────────────────────────────────────────────────────────
var qg = document.getElementById('quickGrid');
QUICK.forEach(function(p) {
  var a = document.createElement('a');
  a.href = p.path;
  a.className = 'quick-card';
  a.innerHTML = '<i class="bi '+p.icon+'" style="color:'+p.color+';"></i> '+p.name;
  qg.appendChild(a);
});

// ── Búsqueda ───────────────────────────────────────────────────────────────
function highlight(text, query) {
  if (!query) return text;
  var re = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + ')', 'gi');
  return text.replace(re, '<mark>$1</mark>');
}

function scoreMatch(p, q) {
  var n = p.name.toLowerCase(), pa = p.path.toLowerCase(), t = (p.tags||'').toLowerCase(), c = (p.cat||'').toLowerCase();
  if (n === q) return 100;
  if (n.startsWith(q)) return 80;
  if (n.includes(q)) return 60;
  if (pa.includes(q)) return 50;
  if (t.split(' ').some(function(w){ return w.startsWith(q); })) return 40;
  if (t.includes(q)) return 30;
  if (c.toLowerCase().includes(q)) return 20;
  return 0;
}

function renderResults(items, query) {
  var container = document.getElementById('searchResults');
  container.innerHTML = '';
  if (!query) return;
  if (!items.length) {
    container.innerHTML = '<div class="search-empty"><i class="bi bi-search" style="font-size:20px;display:block;margin-bottom:6px;opacity:.3;"></i>Sin resultados para "<strong>'+query+'</strong>"<br><span style="font-size:11px;margin-top:4px;display:block;">Prueba: portal · tickets · almacén · itsm · reportes · dashboard</span></div>';
    return;
  }
  items.forEach(function(p) {
    var a = document.createElement('a');
    a.href = p.path;
    a.className = 'search-item';
    a.innerHTML =
      '<div class="search-item-icon" style="background:'+p.bg+';color:'+p.color+';"><i class="bi '+p.icon+'"></i></div>'+
      '<div class="search-item-info">'+
        '<div class="search-item-name">'+highlight(p.name, query)+'<span style="font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;background:rgba(0,0,0,.05);color:var(--muted);margin-left:7px;text-transform:uppercase;letter-spacing:.04em;">'+p.cat+'</span></div>'+
        '<div class="search-item-path">'+highlight(p.path, query)+'</div>'+
      '</div>'+
      '<i class="bi bi-arrow-right search-item-arrow"></i>';
    container.appendChild(a);
  });
}

document.getElementById('searchInput').addEventListener('input', function() {
  var q = this.value.trim().toLowerCase();
  if (!q) { document.getElementById('searchResults').innerHTML = ''; return; }
  var scored = PAGES.map(function(p){ return { p:p, s:scoreMatch(p,q) }; }).filter(function(x){ return x.s > 0; });
  scored.sort(function(a,b){ return b.s - a.s; });
  renderResults(scored.map(function(x){ return x.p; }).slice(0,8), this.value.trim());
});

document.getElementById('searchInput').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') doSearch();
  if (e.key === 'ArrowDown') {
    var first = document.querySelector('.search-item'); if (first) { e.preventDefault(); first.focus(); }
  }
});

document.getElementById('searchResults').addEventListener('keydown', function(e) {
  if (e.key === 'ArrowDown') { var n = document.activeElement.nextElementSibling; if (n) { e.preventDefault(); n.focus(); } }
  if (e.key === 'ArrowUp')   { var p = document.activeElement.previousElementSibling; if (p && p.classList.contains('search-item')) { e.preventDefault(); p.focus(); } else { e.preventDefault(); document.getElementById('searchInput').focus(); } }
  if (e.key === 'Escape')    { document.getElementById('searchInput').focus(); document.getElementById('searchResults').innerHTML = ''; }
});

function doSearch() {
  var q = document.getElementById('searchInput').value.trim().toLowerCase();
  if (!q) return;
  var scored = PAGES.map(function(p){ return { p:p, s:scoreMatch(p,q) }; }).filter(function(x){ return x.s > 0; });
  scored.sort(function(a,b){ return b.s - a.s; });
  var match = scored.length ? scored[0].p : null;
  if (match) { window.location.href = match.path; }
  else {
    var inp = document.getElementById('searchInput');
    inp.style.borderColor = '#ef4444';
    setTimeout(function(){ inp.style.borderColor = ''; }, 1200);
  }
}
</script>
