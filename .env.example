# ============================================================
# .env.example — Copia a .env y rellena los valores
# ============================================================

# SERVIDOR
PORT=3443
NODE_ENV=development
APP_URL=https://localhost:3443
ALLOWED_ORIGINS=https://localhost:3443
API_BASE_URL=https://localhost:3443/api

# BASE DE DATOS (MySQL)
EQUIPMENT_HOST=localhost
EQUIPMENT_USER=root
EQUIPMENT_PASSWORD=
EQUIPMENT_DATABASE=equipment_management
EQUIPMENT_PORT=3306
DB_SSL=false          # true en produccion (Azure MySQL requiere SSL)
DB_POOL_MAX=20        # bajar a 5 en Azure B1ms (limite de conexiones)

# JWT & SESION
JWT_SECRET=genera_con_openssl_rand_hex_32
JWT_REFRESH_SECRET=genera_con_openssl_rand_hex_32
JWT_EXPIRE=999m
SESSION_SECRET=genera_con_openssl_rand_hex_32

# MICROSOFT SSO (opcional — app funciona sin esto con login local)
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
MS_USER_EMAIL=

# JIRA
JIRA_HOST=https://TU_ORG.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=
MAIL_SENDER=
MAIL_READER=

# IA
GROQ_API_KEY=

# MESHCENTRAL RMM (opcional)
MESHCENTRAL_URL=
MESHCENTRAL_PUBLIC_URL=
MESHCENTRAL_USER=
MESHCENTRAL_PASS=

# SUPERADMIN (login local — siempre funciona sin SSO)
SUPERADMIN_EMAIL=superadmin@plataforma.local
SUPERADMIN_PASSWORD=SuperAdmin@2026!
SUPERADMIN_USERNAME=superadmin

# RATE LIMITING
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=1000000
LOGIN_RATE_LIMIT=500
LOGIN_RATE_WINDOW_MS=900000
